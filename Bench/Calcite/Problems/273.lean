import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace Calcite_273

CREATE TABLE EMP («EMPNO» INT, «DEPTNO» INT, «ENAME» STRING, «JOB» STRING, «MGR» INT, «HIREDATE» INT, «SAL» INT, «COMM» INT, «SLACKER» BOOL)
CREATE TABLE DEPT («DEPTNO» INT, «NAME» STRING)
CREATE TABLE BONUS («ENAME» STRING, «JOB» STRING, «SAL» INT, «COMM» INT)
CREATE TABLE EMPNULLABLES («EMPNO» INT, «DEPTNO» INT, «ENAME» STRING, «JOB» STRING, «MGR» INT, «HIREDATE» INT, «SAL» INT, «COMM» INT, «SLACKER» BOOL)
CREATE TABLE EMPNULLABLES_20 («EMPNO» INT, «DEPTNO» INT, «ENAME» STRING, «JOB» STRING, «MGR» INT, «HIREDATE» INT, «SAL» INT, «COMM» INT, «SLACKER» BOOL)
CREATE TABLE EMP_B («EMPNO» INT, «DEPTNO» INT, «ENAME» STRING, «JOB» STRING, «MGR» INT, «HIREDATE» INT, «SAL» INT, «COMM» INT, «SLACKER» BOOL, «BIRTHDATE» INT)

theorem eq :
    sql%([EMP_schema, DEPT_schema, BONUS_schema, EMPNULLABLES_schema, EMPNULLABLES_20_schema, EMP_B_schema]) "SELECT EMP.EMPNO + 1 AS C1, CASE WHEN NOT DEPT.NAME IS NULL THEN CAST(DEPT.NAME AS VARCHAR(10)) WHEN NOT BONUS.JOB IS NULL THEN CAST(BONUS.JOB AS VARCHAR(10)) ELSE '' END AS C2 FROM EMP LEFT JOIN BONUS ON EMP.ENAME = BONUS.ENAME LEFT JOIN DEPT ON EMP.DEPTNO = DEPT.DEPTNO"
  = sql%([EMP_schema, DEPT_schema, BONUS_schema, EMPNULLABLES_schema, EMPNULLABLES_20_schema, EMP_B_schema]) "SELECT t2.C1, CASE WHEN NOT t3.NAME IS NULL THEN CAST(t3.NAME AS VARCHAR(10)) WHEN t2.EXPR$1 THEN CAST(t2.JOB0 AS VARCHAR(10)) ELSE '' END AS C2 FROM (SELECT t0.DEPTNO, t1.JOB AS JOB0, t0.C1, NOT t1.JOB IS NULL AS EXPR$1 FROM (SELECT ENAME, DEPTNO, EMPNO + 1 AS C1 FROM EMP) AS t0 LEFT JOIN (SELECT ENAME, JOB FROM BONUS) AS t1 ON t0.ENAME = t1.ENAME) AS t2 LEFT JOIN (SELECT * FROM DEPT) AS t3 ON t2.DEPTNO = t3.DEPTNO"
  := by first | sql_equiv | sorry

end Calcite_273
