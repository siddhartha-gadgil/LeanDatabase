import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_62_eq

CREATE TABLE COURSE («COURSE_ID» INT, «TITLE» INT, «DEPT_NAME» INT, «CREDITS» INT)
CREATE TABLE DEPARTMENT («DEPT_NAME» INT, «BUILDING» INT, «BUDGET» INT)
CREATE TABLE INSTRUCTOR («ID» INT, «NAME» INT, «SALARY» INT, «DEPT_NAME» INT)
CREATE TABLE TEACHES («ID» INT, «COURSE_ID» INT, «SEC_ID» INT, «YEAR» INT, «SEMESTER» INT, «INSTRUCTOR» INT)
CREATE TABLE SECTION («COURSE_ID» INT, «SEC_ID» INT, «YEAR» INT, «BUILDING» INT, «ROOM_NUMBER» INT, «TIME_SLOT_ID» INT)
CREATE TABLE TAKES («ID» INT, «COURSE_ID» INT, «SEC_ID» INT, «YEAR» INT, «GRADE» INT)
CREATE TABLE STUDENT («ID» INT, «NAME» INT, «DEPT_NAME» INT, «TOT_CRED» INT)

theorem eq :
    sql%([COURSE_schema, DEPARTMENT_schema, INSTRUCTOR_schema, TEACHES_schema, SECTION_schema, TAKES_schema, STUDENT_schema]) "WITH S AS (SELECT ID, TIME_SLOT_ID, YEAR FROM TAKES NATURAL JOIN SECTION GROUP BY ID, TIME_SLOT_ID, YEAR HAVING COUNT(DISTINCT TIME_SLOT_ID) > 4) SELECT DISTINCT ID, NAME FROM S NATURAL JOIN STUDENT"
  = sql%([COURSE_schema, DEPARTMENT_schema, INSTRUCTOR_schema, TEACHES_schema, SECTION_schema, TAKES_schema, STUDENT_schema]) "WITH S AS (SELECT ID, TIME_SLOT_ID, YEAR FROM TAKES NATURAL JOIN SECTION GROUP BY ID, TIME_SLOT_ID, YEAR HAVING COUNT(DISTINCT TIME_SLOT_ID) > 5) SELECT DISTINCT ID, NAME FROM S NATURAL JOIN STUDENT"
  := by first | sql_equiv | sorry

end N_62_eq
