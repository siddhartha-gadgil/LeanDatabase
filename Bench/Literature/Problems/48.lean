import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_48_eq

CREATE TABLE MONTHS («MID» INT, «MONTH» INT)
CREATE TABLE WEEKDAYS («DID» INT, «DAY_OF_WEEK» INT)
CREATE TABLE CARRIERS («CID» INT, «NAME» INT)
CREATE TABLE FLIGHTS («FID» INT, «ORIGIN_CITY» INT, «DEST_CITY» INT, «ACTUAL_TIME» INT)

theorem eq (t0 : TableRel MONTHS_schema) (t1 : TableRel WEEKDAYS_schema) (t2 : TableRel CARRIERS_schema) (t3 : TableRel FLIGHTS_schema) :
    (sql%([MONTHS_schema, WEEKDAYS_schema, CARRIERS_schema, FLIGHTS_schema]) "SELECT DISTINCT F.ORIGIN_CITY, F.DEST_CITY, F.ACTUAL_TIME FROM FLIGHTS AS F JOIN (SELECT A.ORIGIN_CITY, MAX(A.ACTUAL_TIME) AS MAX_TIME FROM FLIGHTS AS A GROUP BY A.ORIGIN_CITY) AS X ON F.ORIGIN_CITY = X.ORIGIN_CITY AND F.ACTUAL_TIME = X.MAX_TIME") t0 t1 t2 t3
  ~= (sql%([MONTHS_schema, WEEKDAYS_schema, CARRIERS_schema, FLIGHTS_schema]) "SELECT S.ORIGIN_CITY, F2.DEST_CITY, MAX(F2.ACTUAL_TIME) FROM (SELECT F1.ORIGIN_CITY, MAX(F1.ACTUAL_TIME) AS MAX_TIME FROM FLIGHTS AS F1 GROUP BY F1.ORIGIN_CITY) AS S JOIN FLIGHTS AS F2 ON S.ORIGIN_CITY = F2.ORIGIN_CITY AND F2.ACTUAL_TIME = S.MAX_TIME GROUP BY S.ORIGIN_CITY, F2.DEST_CITY") t0 t1 t2 t3
  := by first | sql_equiv | sorry

end N_48_eq
