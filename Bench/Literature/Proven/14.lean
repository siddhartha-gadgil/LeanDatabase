namespace N_14_eq

CREATE TABLE A («X» INT, «YA» INT)
CREATE TABLE B («YB» INT)

theorem eq (t0 : TableRel A_schema) (t1 : TableRel B_schema) :
    (sql%([A_schema, B_schema]) "SELECT DISTINCT X.X AS AX FROM A AS X, B AS Y WHERE X.YA = Y.YB") t0 t1
  ~= (sql%([A_schema, B_schema]) "(SELECT X.X AS AX FROM A AS X, A AS Y, B AS Z WHERE X.X = Y.X AND X.YA = Z.YB) UNION ALL (SELECT 1 AS AX FROM A AS X WHERE 1 = 0)") t0 t1
  := by
  apply Finset.ext
  intro x
  simp only [dataEq, List.cons_append, List.nil_append, sql_mem, Finset.mem_image,
    Finset.mem_filter, Finset.mem_product, Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff,
    Prod.exists, decide_eq_true_eq, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true,
    exists_and_left, exists_and_right, exists_eq_left, exists_eq_right, exists_eq_left',
    exists_eq_right']
  aesop
  -- generated by `sql_equiv_llm`

end N_14_eq
