  AND TO_TIMESTAMP(t.\"dropoff_datetime\" / 1000000) > TO_TIMESTAMP(t.\"pickup_datetime\" / 1000000)\n      AND t.\"passenger_count\" > 0\n      AND t.\"trip_distance\" >= 0\n      AND t.\"tip_amount\" >= 0\n      AND t.\"tolls_amount\" >= 0\n      AND t.\"mta_tax\" >= 0\n      AND t.\"fare_amount\" >= 0\n      AND t.\"total_amount\" >= 0\n)\nSELECT\n    z.\"borough\" AS \"pickup_borough\",\n    ROUND(\n        100.0 * SUM(CASE WHEN vt.tip_rate = 0 THEN 1 ELSE 0 END) / COUNT(*),\n        6\n    ) AS \"percentage_no_tip\"\nFROM valid_trips vt\nJOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" z\n    ON vt.\"pickup_location_id\" = z.\"zone_id\"\nGROUP BY z.\"borough\"\nORDER BY \"percentage_no_tip\" DESC;") t := by
