ter pickup\n    AND t.\"dropoff_datetime\" > t.\"pickup_datetime\"\n    -- Passenger count > 0\n    AND t.\"passenger_count\" > 0\n    -- Non-negative amounts and distance\n    AND t.\"trip_distance\" >= 0\n    AND t.\"tip_amount\" >= 0\n    AND t.\"tolls_amount\" >= 0\n    AND t.\"mta_tax\" >= 0\n    AND t.\"fare_amount\" >= 0\n    AND t.\"total_amount\" >= 0\n),\nwith_tip_rate AS (\n  SELECT\n    tr.\"pickup_location_id\",\n    CASE\n      WHEN tr.\"total_amount\" = 0 THEN 0\n      ELSE (tr.\"tip_amount\" * 100.0) / tr.\"total_amount\"\n    END AS tip_rate\n  FROM trips tr\n)\nSELECT\n  z.\"borough\" AS pickup_borough,\n  ROUND(\n    100.0 * SUM(CASE WHEN wt.tip_rate = 0 THEN 1 ELSE 0 END) / COUNT(*),\n    6\n  ) AS percentage_no_tip\nFROM with_tip_rate wt\nJOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" z\n  ON wt.\"pickup_location_id\" = z.\"zone_id\"\nGROUP BY z.\"borough\"\nORDER BY percentage_no_tip DESC;" := by
