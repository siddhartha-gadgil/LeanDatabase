e\" AS DOUBLE PRECISION) / 1000000) > TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) AND t.\"passenger_count\" > 0 AND t.\"trip_distance\" >= 0 AND t.\"tip_amount\" >= 0 AND t.\"tolls_amount\" >= 0 AND t.\"mta_tax\" >= 0 AND t.\"fare_amount\" >= 0 AND t.\"total_amount\" >= 0) SELECT z.\"borough\" AS \"pickup_borough\", ROUND(CAST(CAST(100.0 * SUM(CASE WHEN vt.tip_rate = 0 THEN 1 ELSE 0 END) AS DOUBLE PRECISION) / COUNT(*) AS DECIMAL), 6) AS \"percentage_no_tip\" FROM valid_trips AS vt JOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" AS z ON vt.\"pickup_location_id\" = z.\"zone_id\" GROUP BY z.\"borough\" ORDER BY \"percentage_no_tip\" DESC") t := by
