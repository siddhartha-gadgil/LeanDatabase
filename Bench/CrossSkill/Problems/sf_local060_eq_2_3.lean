CREATE TABLE CUSTOMERS («cust_id» INT, «cust_first_name» STRING, «cust_last_name» STRING, «cust_gender» STRING, «cust_year_of_birth» INT, «cust_marital_status» STRING, «cust_street_address» STRING, «cust_postal_code» STRING, «cust_city» STRING, «cust_city_id» INT, «cust_state_province» STRING, «cust_state_province_id» INT, «country_id» INT, «cust_main_phone_number» STRING, «cust_income_level» STRING, «cust_credit_limit» FLOAT, «cust_email» STRING, «cust_total» STRING, «cust_total_id» INT, «cust_src_id» STRING, «cust_eff_from» STRING, «cust_eff_to» STRING, «cust_valid» STRING)
CREATE TABLE PRODUCTS («prod_id» INT, «prod_name» STRING, «prod_desc» STRING, «prod_subcategory» STRING, «prod_subcategory_id» INT, «prod_subcategory_desc» STRING, «prod_category» STRING, «prod_category_id» INT, «prod_category_desc» STRING, «prod_weight_class» INT, «prod_unit_of_measure» STRING, «prod_pack_size» STRING, «supplier_id» INT, «prod_status» STRING, «prod_list_price» FLOAT, «prod_min_price» FLOAT, «prod_total» STRING, «prod_total_id» INT, «prod_src_id» STRING, «prod_eff_from» STRING, «prod_eff_to» STRING, «prod_valid» STRING)
CREATE TABLE TIMES («time_id» STRING, «day_name» STRING, «day_number_in_week» INT, «day_number_in_month» INT, «calendar_week_number» INT, «fiscal_week_number» INT, «week_ending_day» STRING, «week_ending_day_id» INT, «calendar_month_number» INT, «fiscal_month_number» INT, «calendar_month_desc» STRING, «calendar_month_id» INT, «fiscal_month_desc» STRING, «fiscal_month_id» INT, «days_in_cal_month» INT, «days_in_fis_month» INT, «end_of_cal_month» STRING, «end_of_fis_month» STRING, «calendar_month_name» STRING, «fiscal_month_name» STRING, «calendar_quarter_desc» STRING, «calendar_quarter_id» INT, «fiscal_quarter_desc» STRING, «fiscal_quarter_id» INT, «days_in_cal_quarter» INT, «days_in_fis_quarter» INT, «end_of_cal_quarter» STRING, «end_of_fis_quarter» STRING, «calendar_quarter_number» INT, «fiscal_quarter_number» INT, «calendar_year» INT, «calendar_year_id» INT, «fiscal_year» INT, «fiscal_year_id» INT, «days_in_cal_year» INT, «days_in_fis_year» INT, «end_of_cal_year» STRING, «end_of_fis_year» STRING)
