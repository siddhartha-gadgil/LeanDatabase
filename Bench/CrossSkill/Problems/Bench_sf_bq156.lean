    (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "WITH expr AS (\n  SELECT \n    r.\"ParticipantBarcode\",\n    AVG(LOG(10, r.\"normalized_count\" + 1)) AS log_expr,\n    CASE \n      WHEN r.\"ParticipantBarcode\" IN (\n        SELECT DISTINCT \"ParticipantBarcode\"\n        FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n        WHERE \"Hugo_Symbol\" = 'TP53' AND \"FILTER\" = 'PASS'\n      ) THEN 1 \n      ELSE 0 \n    END AS is_mutant\n  FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" r\n  WHERE r.\"Study\" = 'LGG' AND r.\"Symbol\" = 'DRG2'\n  GROUP BY r.\"ParticipantBarcode\"\n),\ntotals AS (\n  SELECT \n    SUM(log_expr) AS S,\n    SUM(log_expr * log_expr) AS Q,\n    COUNT(*) AS N,\n    SUM(CASE WHEN is_mutant = 1 THEN log_expr ELSE 0 END) AS S_y,\n    SUM(CASE WHEN is_mutant = 1 THEN log_expr * log_expr ELSE 0 END) AS Q_y,\n    SUM(is_mutant) AS N_y\n  FROM expr\n),\nderived AS (\n  SELECT \n    S_y,\n    Q_y,\n    N_y,\n    S - S_y AS S_n,\n    Q - Q_y AS Q_n,\n    N - N_y AS N_n\n  FROM totals\n),\nt_calc AS (\n  SELECT\n    S_y / N_y AS g_y,\n    S_n / N_n AS g_n,\n    (Q_y - S_y * S_y / N_y) / (N_y - 1) AS s2_y,\n    (Q_n - S_n * S_n / N_n) / (N_n - 1) AS s2_n,\n    N_y,\n    N_n\n  FROM derived\n  WHERE N_y >= 10 AND N_n >= 10\n)\nSELECT \n  ROUND((g_y - g_n) / SQRT(s2_y / N_y + s2_n / N_n), 2) AS TSCORE\nFROM t_calc\nWHERE s2_y > 0 AND s2_n > 0;") t ~= (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "WITH drg2_expr AS (\n    -- Get DRG2 gene expression for LGG participants, average LOG10(normalized_count+1) per participant\n    SELECT \n        \"ParticipantBarcode\",\n        AVG(LOG(10, \"normalized_count\" + 1)) AS avg_log_expr\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\"\n    WHERE \"Study\" = 'LGG'\n      AND \"Symbol\" = 'DRG2'\n    GROUP BY \"ParticipantBarcode\"\n),\ntp53_mutants AS (\n    -- Get LGG participants with TP53 PASS mutations\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG'\n      AND \"Hugo_Symbol\" = 'TP53'\n      AND \"FILTER\" = 'PASS'\n),\nclassified AS (\n    -- Classify participants as TP53-mutant or TP53-wildtype\n    SELECT \n        e.\"ParticipantBarcode\",\n        e.avg_log_expr,\n        CASE WHEN m.\"ParticipantBarcode\" IS NOT NULL THEN 'mutant' ELSE 'wildtype' END AS tp53_status\n    FROM drg2_expr e\n    LEFT JOIN tp53_mutants m\n        ON e.\"ParticipantBarcode\" = m.\"ParticipantBarcode\"\n),\ngroup_stats AS (\n    -- Compute group means, variances, and counts\n    SELECT\n        tp53_status,\n        AVG(avg_log_expr) AS mean_val,\n        VARIANCE(avg_log_expr) AS var_val,\n        COUNT(*) AS n\n    FROM classified\n    GROUP BY tp53_status\n    HAVING COUNT(*) >= 10 AND VARIANCE(avg_log_expr) > 0\n)\n-- Compute Welch's t-score: (mean_mutant - mean_wildtype) / sqrt(var_mutant/n_mutant + var_wildtype/n_wildtype)\nSELECT \n    ROUND(\n        (MAX(CASE WHEN tp53_status = 'mutant' THEN mean_val END) - MAX(CASE WHEN tp53_status = 'wildtype' THEN mean_val END))\n        / SQRT(\n            MAX(CASE WHEN tp53_status = 'mutant' THEN var_val / n END)\n            + MAX(CASE WHEN tp53_status = 'wildtype' THEN var_val / n END)\n          ),\n        2\n    ) AS TSCORE\nFROM group_stats;") t := by
