theorem eq_0_1 : ∀ t,
    (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "WITH\n-- Step 1: Get all DRG2 expression values for LGG participants\nexpr AS (\n  SELECT\n    \"ParticipantBarcode\",\n    LOG(10, \"normalized_count\" + 1) AS log_expr\n  FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\"\n  WHERE \"Symbol\" = 'DRG2'\n    AND \"Study\" = 'LGG'\n),\n\n-- Step 2: Get participants with TP53 PASS mutations in LGG\ntp53_mutated AS (\n  SELECT DISTINCT \"ParticipantBarcode\"\n  FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n  WHERE \"Hugo_Symbol\" = 'TP53'\n    AND \"Study\" = 'LGG'\n    AND \"FILTER\" = 'PASS'\n),\n\n-- Step 3: Compute total sums (S_total, Q_total, N_total)\ntotals AS (\n  SELECT\n    COUNT(*) AS N_total,\n    SUM(log_expr) AS S_total,\n    SUM(log_expr * log_expr) AS Q_total\n  FROM expr\n),\n\n-- Step 4: Compute mutated sums (S_y, Q_y, N_y)\nmutated_stats AS (\n  SELECT\n    COUNT(*) AS N_y,\n    SUM(e.log_expr) AS S_y,\n    SUM(e.log_expr * e.log_expr) AS Q_y\n  FROM expr e\n  INNER JOIN tp53_mutated m ON e.\"ParticipantBarcode\" = m.\"ParticipantBarcode\"\n),\n\n-- Step 5: Compute all stats and t-score\nt_calc AS (\n  SELECT\n    ms.N_y,\n    ms.S_y,\n    ms.Q_y,\n    t.N_total - ms.N_y AS N_n,\n    t.S_total - ms.S_y AS S_n,\n    t.Q_total - ms.Q_y AS Q_n,\n    -- Mean for mutated\n    ms.S_y / ms.N_y AS g_y,\n    -- Mean for non-mutated\n    (t.S_total - ms.S_y) / (t.N_total - ms.N_y) AS g_n,\n    -- Variance for mutated: (Q_y - S_y^2/N_y) / (N_y - 1)\n    (ms.Q_y - (ms.S_y * ms.S_y) / ms.N_y) / (ms.N_y - 1) AS var_y,\n    -- Variance for non-mutated: (Q_n - S_n^2/N_n) / (N_n - 1)\n    ((t.Q_total - ms.Q_y) - ((t.S_total - ms.S_y) * (t.S_total - ms.S_y)) / (t.N_total - ms.N_y)) / (t.N_total - ms.N_y - 1) AS var_n\n  FROM mutated_stats ms\n  CROSS JOIN totals t\n)\n\nSELECT\n  CASE\n    WHEN N_y >= 10 AND N_n >= 10 AND var_y > 0 AND var_n > 0\n    THEN ROUND((g_y - g_n) / SQRT(var_y / N_y + var_n / N_n), 2)\n    ELSE NULL\n  END AS TSCORE\nFROM t_calc;") t ~= (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "WITH expr AS (\n  SELECT \n    r.\"ParticipantBarcode\",\n    AVG(LOG(10, r.\"normalized_count\" + 1)) AS log_expr,\n    CASE \n      WHEN r.\"ParticipantBarcode\" IN (\n        SELECT DISTINCT \"ParticipantBarcode\"\n        FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n        WHERE \"Hugo_Symbol\" = 'TP53' AND \"FILTER\" = 'PASS'\n      ) THEN 1 \n      ELSE 0 \n    END AS is_mutant\n  FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" r\n  WHERE r.\"Study\" = 'LGG' AND r.\"Symbol\" = 'DRG2'\n  GROUP BY r.\"ParticipantBarcode\"\n),\ntotals AS (\n  SELECT \n    SUM(log_expr) AS S,\n    SUM(log_expr * log_expr) AS Q,\n    COUNT(*) AS N,\n    SUM(CASE WHEN is_mutant = 1 THEN log_expr ELSE 0 END) AS S_y,\n    SUM(CASE WHEN is_mutant = 1 THEN log_expr * log_expr ELSE 0 END) AS Q_y,\n    SUM(is_mutant) AS N_y\n  FROM expr\n),\nderived AS (\n  SELECT \n    S_y,\n    Q_y,\n    N_y,\n    S - S_y AS S_n,\n    Q - Q_y AS Q_n,\n    N - N_y AS N_n\n  FROM totals\n),\nt_calc AS (\n  SELECT\n    S_y / N_y AS g_y,\n    S_n / N_n AS g_n,\n    (Q_y - S_y * S_y / N_y) / (N_y - 1) AS s2_y,\n    (Q_n - S_n * S_n / N_n) / (N_n - 1) AS s2_n,\n    N_y,\n    N_n\n  FROM derived\n  WHERE N_y >= 10 AND N_n >= 10\n)\nSELECT \n  ROUND((g_y - g_n) / SQRT(s2_y / N_y + s2_n / N_n), 2) AS TSCORE\nFROM t_calc\nWHERE s2_y > 0 AND s2_n > 0;") t := by
