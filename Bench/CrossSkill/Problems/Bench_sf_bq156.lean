theorem eq_2_3 : ∀ t,
    (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "WITH\n-- Step 1: Get DRG2 gene expression for all LGG participants\n-- Expression = average of log10(normalized_count + 1) per participant\nexpr AS (\n    SELECT\n        \"ParticipantBarcode\",\n        AVG(LOG(10, \"normalized_count\" + 1)) AS gene_expr\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\"\n    WHERE \"Symbol\" = 'DRG2'\n      AND \"Study\" = 'LGG'\n    GROUP BY \"ParticipantBarcode\"\n),\n\n-- Step 2: Get TP53-mutated participants in LGG with FILTER = 'PASS'\nmutated AS (\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Hugo_Symbol\" = 'TP53'\n      AND \"Study\" = 'LGG'\n      AND \"FILTER\" = 'PASS'\n),\n\n-- Step 3: Compute sums for mutated group (S_y, Q_y, N_y)\nmutated_stats AS (\n    SELECT\n        SUM(e.gene_expr) AS S_y,\n        SUM(e.gene_expr * e.gene_expr) AS Q_y,\n        COUNT(*) AS N_y\n    FROM expr e\n    INNER JOIN mutated m ON e.\"ParticipantBarcode\" = m.\"ParticipantBarcode\"\n),\n\n-- Step 4: Compute sums for all (S_total, Q_total, N_total)\ntotal_stats AS (\n    SELECT\n        SUM(gene_expr) AS S_total,\n        SUM(gene_expr * gene_expr) AS Q_total,\n        COUNT(*) AS N_total\n    FROM expr\n),\n\n-- Step 5: Combine and compute t-score\ncombined AS (\n    SELECT\n        t.S_total,\n        t.Q_total,\n        t.N_total,\n        m.S_y,\n        m.Q_y,\n        m.N_y,\n        (t.S_total - m.S_y) AS S_n,\n        (t.Q_total - m.Q_y) AS Q_n,\n        (t.N_total - m.N_y) AS N_n,\n        -- Means\n        m.S_y / m.N_y AS g_y,\n        (t.S_total - m.S_y) / (t.N_total - m.N_y) AS g_n,\n        -- Variances\n        (1.0 / (m.N_y - 1)) * (m.Q_y - (m.S_y * m.S_y) / m.N_y) AS var_y,\n        (1.0 / ((t.N_total - m.N_y) - 1)) * ((t.Q_total - m.Q_y) - ((t.S_total - m.S_y) * (t.S_total - m.S_y)) / (t.N_total - m.N_y)) AS var_n\n    FROM total_stats t\n    CROSS JOIN mutated_stats m\n)\n\nSELECT\n    ROUND(\n        (g_y - g_n) / SQRT(var_y / N_y + var_n / N_n),\n        2\n    ) AS \"TSCORE\"\nFROM combined\nWHERE N_y >= 10\n  AND N_n >= 10\n  AND var_y > 0\n  AND var_n > 0;") t ~= (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "WITH drg2_expr AS (\n    -- Get DRG2 gene expression for LGG participants, average LOG10(normalized_count+1) per participant\n    SELECT \n        \"ParticipantBarcode\",\n        AVG(LOG(10, \"normalized_count\" + 1)) AS avg_log_expr\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\"\n    WHERE \"Study\" = 'LGG'\n      AND \"Symbol\" = 'DRG2'\n    GROUP BY \"ParticipantBarcode\"\n),\ntp53_mutants AS (\n    -- Get LGG participants with TP53 PASS mutations\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG'\n      AND \"Hugo_Symbol\" = 'TP53'\n      AND \"FILTER\" = 'PASS'\n),\nclassified AS (\n    -- Classify participants as TP53-mutant or TP53-wildtype\n    SELECT \n        e.\"ParticipantBarcode\",\n        e.avg_log_expr,\n        CASE WHEN m.\"ParticipantBarcode\" IS NOT NULL THEN 'mutant' ELSE 'wildtype' END AS tp53_status\n    FROM drg2_expr e\n    LEFT JOIN tp53_mutants m\n        ON e.\"ParticipantBarcode\" = m.\"ParticipantBarcode\"\n),\ngroup_stats AS (\n    -- Compute group means, variances, and counts\n    SELECT\n        tp53_status,\n        AVG(avg_log_expr) AS mean_val,\n        VARIANCE(avg_log_expr) AS var_val,\n        COUNT(*) AS n\n    FROM classified\n    GROUP BY tp53_status\n    HAVING COUNT(*) >= 10 AND VARIANCE(avg_log_expr) > 0\n)\n-- Compute Welch's t-score: (mean_mutant - mean_wildtype) / sqrt(var_mutant/n_mutant + var_wildtype/n_wildtype)\nSELECT \n    ROUND(\n        (MAX(CASE WHEN tp53_status = 'mutant' THEN mean_val END) - MAX(CASE WHEN tp53_status = 'wildtype' THEN mean_val END))\n        / SQRT(\n            MAX(CASE WHEN tp53_status = 'mutant' THEN var_val / n END)\n            + MAX(CASE WHEN tp53_status = 'wildtype' THEN var_val / n END)\n          ),\n        2\n    ) AS TSCORE\nFROM group_stats;") t := by
