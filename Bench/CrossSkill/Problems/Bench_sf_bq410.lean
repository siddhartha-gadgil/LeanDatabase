    (sql%([CENSUSTRACT_2017_5YR_schema, CENSUSTRACT_2015_5YR_schema, CENSUSTRACT_2018_5YR_schema, STATE_FIPS_schema, STATES_schema]) "WITH tract_data AS (\n  SELECT\n    LEFT(t17.\"geo_id\", 2) AS state_fips,\n    GREATEST(t17.\"unemployed_pop\" + t17.\"not_in_labor_force\" - t17.\"group_quarters\", 0) AS adj_nonlabor,\n    t17.\"total_pop\",\n    (t18.\"median_income\" - t15.\"median_income\") AS income_diff\n  FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2017_5YR\" t17\n  JOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2015_5YR\" t15\n    ON t17.\"geo_id\" = t15.\"geo_id\"\n  JOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2018_5YR\" t18\n    ON t17.\"geo_id\" = t18.\"geo_id\"\n),\nstate_agg AS (\n  SELECT\n    s.\"state\" AS state,\n    SUM(td.income_diff) AS TOTAL_INCOME_CHANGE,\n    SUM(td.adj_nonlabor) AS TOTAL_ADJUSTED_NON_LABOR,\n    AVG(td.adj_nonlabor / NULLIF(td.\"total_pop\", 0)) AS AVG_PROPORTION\n  FROM tract_data td\n  JOIN \"CENSUS_BUREAU_ACS_2\".\"GEO_US_BOUNDARIES\".\"STATES\" s\n    ON td.state_fips = s.\"state_fips_code\"\n  WHERE td.income_diff IS NOT NULL\n  GROUP BY s.\"state\"\n)\nSELECT\n  state,\n  TOTAL_INCOME_CHANGE,\n  TOTAL_ADJUSTED_NON_LABOR,\n  AVG_PROPORTION\nFROM state_agg\nORDER BY TOTAL_ADJUSTED_NON_LABOR ASC\nLIMIT 3;") t ~= (sql%([CENSUSTRACT_2017_5YR_schema, CENSUSTRACT_2015_5YR_schema, CENSUSTRACT_2018_5YR_schema, STATE_FIPS_schema, STATES_schema]) "WITH tract_labor AS (\n    SELECT\n        \"geo_id\",\n        \"total_pop\",\n        \"unemployed_pop\",\n        \"not_in_labor_force\",\n        \"group_quarters\",\n        GREATEST(\"unemployed_pop\" + \"not_in_labor_force\" - \"group_quarters\", 0) AS adjusted_non_labor\n    FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2017_5YR\"\n),\ntract_proportion AS (\n    SELECT\n        \"geo_id\",\n        adjusted_non_labor,\n        CASE WHEN \"total_pop\" > 0 THEN adjusted_non_labor * 1.0 / \"total_pop\" ELSE 0 END AS proportion\n    FROM tract_labor\n),\nincome_change AS (\n    SELECT\n        t18.\"geo_id\",\n        (t18.\"median_income\" - t15.\"median_income\") AS income_diff\n    FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2018_5YR\" t18\n    JOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2015_5YR\" t15\n        ON t18.\"geo_id\" = t15.\"geo_id\"\n    WHERE t18.\"median_income\" IS NOT NULL\n      AND t15.\"median_income\" IS NOT NULL\n),\ncombined AS (\n    SELECT\n        tp.\"geo_id\",\n        tp.adjusted_non_labor,\n        tp.proportion,\n        ic.income_diff,\n        LEFT(tp.\"geo_id\", 2) AS state_fips\n    FROM tract_proportion tp\n    JOIN income_change ic ON tp.\"geo_id\" = ic.\"geo_id\"\n)\nSELECT\n    s.\"state\" AS state,\n    SUM(c.income_diff) AS TOTAL_INCOME_CHANGE,\n    SUM(c.adjusted_non_labor) AS TOTAL_ADJUSTED_NON_LABOR,\n    AVG(c.proportion) AS AVG_PROPORTION\nFROM combined c\nJOIN \"CENSUS_BUREAU_ACS_2\".\"GEO_US_BOUNDARIES\".\"STATES\" s\n    ON c.state_fips = s.\"state_fips_code\"\nGROUP BY s.\"state\"\nORDER BY TOTAL_ADJUSTED_NON_LABOR ASC\nLIMIT 3;") t := by
