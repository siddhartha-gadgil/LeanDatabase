L\n    SELECT '19', 'IA' UNION ALL\n    SELECT '20', 'KS' UNION ALL\n    SELECT '21', 'KY' UNION ALL\n    SELECT '22', 'LA' UNION ALL\n    SELECT '23', 'ME' UNION ALL\n    SELECT '24', 'MD' UNION ALL\n    SELECT '25', 'MA' UNION ALL\n    SELECT '26', 'MI' UNION ALL\n    SELECT '27', 'MN' UNION ALL\n    SELECT '28', 'MS' UNION ALL\n    SELECT '29', 'MO' UNION ALL\n    SELECT '30', 'MT' UNION ALL\n    SELECT '31', 'NE' UNION ALL\n    SELECT '32', 'NV' UNION ALL\n    SELECT '33', 'NH' UNION ALL\n    SELECT '34', 'NJ' UNION ALL\n    SELECT '35', 'NM' UNION ALL\n    SELECT '36', 'NY' UNION ALL\n    SELECT '37', 'NC' UNION ALL\n    SELECT '38', 'ND' UNION ALL\n    SELECT '39', 'OH' UNION ALL\n    SELECT '40', 'OK' UNION ALL\n    SELECT '41', 'OR' UNION ALL\n    SELECT '42', 'PA' UNION ALL\n    SELECT '44', 'RI' UNION ALL\n    SELECT '45', 'SC' UNION ALL\n    SELECT '46', 'SD' UNION ALL\n    SELECT '47', 'TN' UNION ALL\n    SELECT '48', 'TX' UNION ALL\n    SELECT '49', 'UT' UNION ALL\n    SELECT '50', 'VT' UNION ALL\n    SELECT '51', 'VA' UNION ALL\n    SELECT '53', 'WA' UNION ALL\n    SELECT '54', 'WV' UNION ALL\n    SELECT '55', 'WI' UNION ALL\n    SELECT '56', 'WY' UNION ALL\n    SELECT '72', 'PR'\n),\n-- Step 1: Compute adjusted non-labor force per tract in 2017\ntract_2017 AS (\n    SELECT\n        \"geo_id\",\n        SUBSTR(\"geo_id\", 1, 2) AS state_fips,\n        \"total_pop\",\n        \"unemployed_pop\",\n        \"not_in_labor_force\",\n        \"group_quarters\",\n        GREATEST(\"unemployed_pop\" + \"not_in_labor_force\" - \"group_quarters\", 0) AS adjusted_non_labor\n    FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2017_5YR\"\n),\n-- Step 2: Aggregate per state in 2017 and find bottom 3 by total adjusted non-labor\nstate_agg AS (\n    SELECT\n        state_fips,\n        SUM(adjusted_non_labor) AS total_adjusted_non_labor,\n        AVG(CASE WHEN \"total_pop\" > 0 THEN adjusted_non_labor * 1.0 / \"total_pop\" ELSE NULL END) AS avg_proportion\n    FROM tract_2017\n    GROUP BY state_fips\n    ORDER BY total_adjusted_non_labor ASC\n    LIMIT 3\n),\n-- Step 3: Get median_income change between 2018 and 2015 per tract\nincome_2015 AS (\n    SELECT \"geo_id\", \"median_income\"\n    FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2015_5YR\"\n),\nincome_2018 AS (\n    SELECT \"geo_id\", \"median_income\"\n    FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2018_5YR\"\n),\nincome_change AS (\n    SELECT\n        i18.\"geo_id\",\n        SUBSTR(i18.\"geo_id\", 1, 2) AS state_fips,\n        (i18.\"median_income\" - i15.\"median_income\") AS income_diff\n    FROM income_2018 i18\n    INNER JOIN income_2015 i15 ON i18.\"geo_id\" = i15.\"geo_id\"\n    WHERE i18.\"median_income\" IS NOT NULL AND i15.\"median_income\" IS NOT NULL\n),\n-- Step 4: Aggregate income change per state for the bottom 3 states\nstate_income_change AS (\n    SELECT\n        ic.state_fips,\n        SUM(ic.income_diff) AS total_income_change\n    FROM income_change ic\n    INNER JOIN state_agg sa ON ic.state_fips = sa.state_fips\n    GROUP BY ic.state_fips\n)\n-- Final: Join everything together\nSELECT\n    f.state AS \"state\",\n    sic.total_income_change AS \"TOTAL_INCOME_CHANGE\",\n    sa.total_adjusted_non_labor AS \"TOTAL_ADJUSTED_NON_LABOR\",\n    sa.avg_proportion AS \"AVG_PROPORTION\"\nFROM state_agg sa\nINNER JOIN state_income_change sic ON sa.state_fips = sic.state_fips\nINNER JOIN fips_to_state f ON sa.state_fips = f.fips\nORDER BY sa.total_adjusted_non_labor ASC;") t := by
