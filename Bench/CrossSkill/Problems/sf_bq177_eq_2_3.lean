', \"provider_id\", \"provider_name\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2015\"), most_expensive_provider AS (SELECT \"provider_id\" FROM all_inpatient GROUP BY \"provider_id\" ORDER BY SUM(\"average_medicare_payments\" * \"total_discharges\") DESC LIMIT 1), inpatient_yearly AS (SELECT i.year, i.\"provider_id\", i.\"provider_name\", AVG(i.\"average_medicare_payments\" * i.\"total_discharges\") AS avg_inpatient_cost FROM all_inpatient AS i JOIN most_expensive_provider AS m ON i.\"provider_id\" = m.\"provider_id\" GROUP BY i.year, i.\"provider_id\", i.\"provider_name\"), outpatient_yearly AS (SELECT o.year, o.\"provider_id\", o.\"provider_name\", AVG(o.\"average_total_payments\" * o.\"outpatient_services\") AS avg_outpatient_cost FROM all_outpatient AS o JOIN most_expensive_provider AS m ON o.\"provider_id\" = m.\"provider_id\" GROUP BY o.year, o.\"provider_id\", o.\"provider_name\") SELECT i.year, i.\"provider_id\", i.\"provider_name\", ROUND(i.avg_inpatient_cost, 2) AS avg_inpatient_cost, ROUND(o.avg_outpatient_cost, 2) AS avg_outpatient_cost FROM inpatient_yearly AS i JOIN outpatient_yearly AS o ON i.year = o.year AND i.\"provider_id\" = o.\"provider_id\" ORDER BY i.year") t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11
