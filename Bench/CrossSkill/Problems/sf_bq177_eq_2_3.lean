    (sql%([INPATIENT_CHARGES_2011_schema, INPATIENT_CHARGES_2014_schema, OUTPATIENT_CHARGES_2012_schema, OUTPATIENT_CHARGES_2014_schema, INPATIENT_CHARGES_2012_schema, INPATIENT_CHARGES_2013_schema, INPATIENT_CHARGES_2015_schema, OUTPATIENT_CHARGES_2011_schema, OUTPATIENT_CHARGES_2013_schema, OUTPATIENT_CHARGES_2015_schema, COST_schema, PROVIDER_schema]) "WITH inpatient AS (SELECT 2011 AS \"YEAR\", \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"average_total_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2011\" UNION ALL SELECT 2012, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"average_total_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2012\" UNION ALL SELECT 2013, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"average_total_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2013\" UNION ALL SELECT 2014, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"average_total_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2014\" UNION ALL SELECT 2015, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"average_total_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2015\"), outpatient AS (SELECT 2011 AS \"YEAR\", \"provider_id\", \"provider_name\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2011\" UNION ALL SELECT 2012, \"provider_id\", \"provider_name\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2012\" UNION ALL SELECT 2013, \"provider_id\", \"provider_name\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2013\" UNION ALL SELECT 2014, \"provider_id\", \"provider_name\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2014\" UNION ALL SELECT 2015, \"provider_id\", \"provider_name\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2015\"), inpatient_agg AS (SELECT \"YEAR\", \"provider_id\", MAX(\"provider_name\") AS \"provider_name\", AVG(\"average_medicare_payments\" * \"total_discharges\") AS \"AVG_INPATIENT_COST\", SUM(\"average_total_payments\" * \"total_discharges\") AS \"TOTAL_INPATIENT_COST\" FROM inpatient GROUP BY \"YEAR\", \"provider_id\"), outpatient_agg AS (SELECT \"YEAR\", \"provider_id\", AVG(\"average_total_payments\" * \"outpatient_services\") AS \"AVG_OUTPATIENT_COST\", SUM(\"average_total_payments\" * \"outpatient_services\") AS \"TOTAL_OUTPATIENT_COST\" FROM outpatient GROUP BY \"YEAR\", \"provider_id\"), combined AS (SELECT COALESCE(i.\"YEAR\", o.\"YEAR\") AS \"YEAR\", COALESCE(i.\"provider_id\", o.\"provider_id\") AS \"PROVIDER_ID\", i.\"provider_name\" AS \"PROVIDER_NAME\", i.\"AVG_INPATIENT_COST\", o.\"AVG_OUTPATIENT_COST\", COALESCE(i.\"TOTAL_INPATIENT_COST\", 0) + COALESCE(o.\"TOTAL_OUTPATIENT_COST\", 0) AS \"TOTAL_COST\" FROM inpatient_agg AS i FULL OUTER JOIN outpatient_agg AS o ON i.\"YEAR\" = o.\"YEAR\" AND i.\"provider_id\" = o.\"provider_id\"), ranked AS (SELECT \"YEAR\", \"PROVIDER_ID\", \"PROVIDER_NAME\", \"AVG_INPATIENT_COST\", \"AVG_OUTPATIENT_COST\", ROW_NUMBER() OVER (PARTITION BY \"YEAR\" ORDER BY \"TOTAL_COST\" DESC) AS rn FROM combined) SELECT \"YEAR\", \"PROVIDER_ID\", \"PROVIDER_NAME\", \"AVG_INPATIENT_COST\", \"AVG_OUTPATIENT_COST\" FROM ranked WHERE rn = 1 ORDER BY \"YEAR\"") t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11
