import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local031 — crossskill equivalence(s)

Question: What is the highest monthly delivered orders volume in the year with the lowest annual delivered orders volume among 2016, 2017, and 2018?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local031

CREATE TABLE OLIST_ORDERS («order_id» STRING, «customer_id» STRING, «order_status» STRING, «order_purchase_timestamp» STRING, «order_approved_at» STRING, «order_delivered_carrier_date» STRING, «order_delivered_customer_date» STRING, «order_estimated_delivery_date» STRING)

HYPOTHESIS hyp0_1_0 : OLIST_ORDERS "EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) IN (2016, 2017, 2018)"
HYPOTHESIS hyp0_1_1 : OLIST_ORDERS "NOT \"order_delivered_customer_date\" IS NULL"
HYPOTHESIS hyp0_1_2 : OLIST_ORDERS "\"order_delivered_customer_date\" <> ''"
theorem eq_0_1 (t : TableRel OLIST_ORDERS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) :
    (sql%([OLIST_ORDERS_schema]) "WITH yearly_volume AS (SELECT EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) AS yr, COUNT(*) AS annual_orders FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDERS\" WHERE \"order_status\" = 'delivered' AND EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) IN (2016, 2017, 2018) GROUP BY yr), lowest_year AS (SELECT yr FROM yearly_volume ORDER BY annual_orders ASC LIMIT 1), monthly_volume AS (SELECT EXTRACT(MONTH FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) AS mo, COUNT(*) AS monthly_orders FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDERS\" WHERE \"order_status\" = 'delivered' AND EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) = (SELECT yr FROM lowest_year) GROUP BY mo) SELECT MAX(monthly_orders) AS OUTPUT FROM monthly_volume") t = (sql%([OLIST_ORDERS_schema]) "WITH delivered AS (SELECT EXTRACT(YEAR FROM TO_TIMESTAMP(\"order_delivered_customer_date\")) AS yr, EXTRACT(MONTH FROM TO_TIMESTAMP(\"order_delivered_customer_date\")) AS mo FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDERS\" WHERE \"order_status\" = 'delivered' AND NOT \"order_delivered_customer_date\" IS NULL AND \"order_delivered_customer_date\" <> '' AND EXTRACT(YEAR FROM TO_TIMESTAMP(\"order_delivered_customer_date\")) IN (2016, 2017, 2018)), annual_volume AS (SELECT yr, COUNT(*) AS annual_cnt FROM delivered GROUP BY yr), lowest_year AS (SELECT yr FROM annual_volume ORDER BY annual_cnt ASC LIMIT 1), monthly_volume AS (SELECT mo, COUNT(*) AS monthly_cnt FROM delivered WHERE yr = (SELECT yr FROM lowest_year) GROUP BY mo) SELECT MAX(monthly_cnt) AS OUTPUT FROM monthly_volume") t := by
  first | sql_equiv | sorry

