import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq040 — crossskill equivalence(s)

Question: For NYC yellow taxi trips between January 1 and January 7, 2016, excluding any trips picked up in ‘EWR’ or ‘Staten Island,’ determine the proportion of rides that fall into each tip category in each pickup borough. Only include trips where the dropoff time is after the pickup time, the passenger count is greater than zero, and trip_distance, tip_amount, tolls_amount, mta_tax, fare_amount, and total_amount are all non-negative. Classify the tip percentage as follows: 0% (no tip), up to 5%, 5% to 10%, 10% to 15%, 15% to 20%, 20% to 25%, and more than 25%.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq040

CREATE TABLE TRIPS («route_id» STRING, «service_id» STRING, «trip_id» STRING, «trip_headsign» STRING, «direction_id» STRING, «block_id» STRING, «shape_id» STRING)
CREATE TABLE TAXI_ZONE_GEOM («zone_id» STRING, «zone_name» STRING, «borough» STRING, «zone_geom» STRING)
CREATE TABLE TLC_YELLOW_TRIPS_2016 («vendor_id» STRING, «pickup_datetime» INT, «dropoff_datetime» INT, «passenger_count» INT, «trip_distance» INT, «rate_code» STRING, «store_and_fwd_flag» STRING, «payment_type» STRING, «fare_amount» INT, «extra» INT, «mta_tax» INT, «tip_amount» INT, «tolls_amount» INT, «imp_surcharge» INT, «airport_fee» INT, «total_amount» INT, «pickup_location_id» STRING, «dropoff_location_id» STRING, «data_file_year» INT, «data_file_month» INT)

theorem eq_0_1 : ∀ t,
    (sql%([TRIPS_schema, TAXI_ZONE_GEOM_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH filtered_trips AS (SELECT z.\"borough\" AS pickup_borough, t.\"tip_amount\", t.\"total_amount\", CASE WHEN t.\"total_amount\" = 0 THEN 0 ELSE CAST(t.\"tip_amount\" AS DOUBLE PRECISION) / t.\"total_amount\" * 100 END AS tip_rate FROM \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TLC_YELLOW_TRIPS_2016\" AS t JOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" AS z ON t.\"pickup_location_id\" = z.\"zone_id\" WHERE TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) >= '2016-01-01' AND TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) < '2016-01-08' AND NOT z.\"borough\" IN ('EWR', 'Staten Island') AND t.\"dropoff_datetime\" > t.\"pickup_datetime\" AND t.\"passenger_count\" > 0 AND t.\"trip_distance\" >= 0 AND t.\"tip_amount\" >= 0 AND t.\"tolls_amount\" >= 0 AND t.\"mta_tax\" >= 0 AND t.\"fare_amount\" >= 0 AND t.\"total_amount\" >= 0), categorized AS (SELECT pickup_borough, CASE WHEN tip_rate = 0 THEN '0%' WHEN tip_rate > 0 AND tip_rate <= 5 THEN 'up to 5%' WHEN tip_rate > 5 AND tip_rate <= 10 THEN '5% to 10%' WHEN tip_rate > 10 AND tip_rate <= 15 THEN '10% to 15%' WHEN tip_rate > 15 AND tip_rate <= 20 THEN '15% to 20%' WHEN tip_rate > 20 AND tip_rate <= 25 THEN '20% to 25%' WHEN tip_rate > 25 THEN 'more than 25%' END AS tip_category FROM filtered_trips), borough_counts AS (SELECT pickup_borough, COUNT(*) AS total_trips FROM categorized GROUP BY pickup_borough), category_counts AS (SELECT pickup_borough, tip_category, COUNT(*) AS category_trips FROM categorized GROUP BY pickup_borough, tip_category) SELECT cc.pickup_borough AS PICKUP_BOROUGH, cc.tip_category AS TIP_CATEGORY, ROUND(CAST(cc.category_trips AS DOUBLE PRECISION) / bc.total_trips, 6) AS PROPORTION FROM category_counts AS cc JOIN borough_counts AS bc ON cc.pickup_borough = bc.pickup_borough ORDER BY cc.pickup_borough, cc.tip_category") t ~= (sql%([TRIPS_schema, TAXI_ZONE_GEOM_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH filtered_trips AS (SELECT t.\"pickup_location_id\", t.\"tip_amount\", t.\"total_amount\" FROM \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TLC_YELLOW_TRIPS_2016\" AS t WHERE TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) >= '2016-01-01' AND TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) < '2016-01-08' AND t.\"dropoff_datetime\" > t.\"pickup_datetime\" AND t.\"passenger_count\" > 0 AND t.\"trip_distance\" >= 0 AND t.\"tip_amount\" >= 0 AND t.\"tolls_amount\" >= 0 AND t.\"mta_tax\" >= 0 AND t.\"fare_amount\" >= 0 AND t.\"total_amount\" >= 0), with_borough AS (SELECT z.\"borough\" AS PICKUP_BOROUGH, CASE WHEN t.\"tip_amount\" = 0 THEN '0%' WHEN CAST(t.\"tip_amount\" AS DOUBLE PRECISION) / NULLIF(t.\"total_amount\", 0) <= 0.05 THEN 'up to 5%' WHEN CAST(t.\"tip_amount\" AS DOUBLE PRECISION) / NULLIF(t.\"total_amount\", 0) <= 0.10 THEN '5% to 10%' WHEN CAST(t.\"tip_amount\" AS DOUBLE PRECISION) / NULLIF(t.\"total_amount\", 0) <= 0.15 THEN '10% to 15%' WHEN CAST(t.\"tip_amount\" AS DOUBLE PRECISION) / NULLIF(t.\"total_amount\", 0) <= 0.20 THEN '15% to 20%' WHEN CAST(t.\"tip_amount\" AS DOUBLE PRECISION) / NULLIF(t.\"total_amount\", 0) <= 0.25 THEN '20% to 25%' ELSE 'more than 25%' END AS TIP_CATEGORY FROM filtered_trips AS t INNER JOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" AS z ON t.\"pickup_location_id\" = z.\"zone_id\" WHERE NOT z.\"borough\" IN ('EWR', 'Staten Island')), borough_totals AS (SELECT PICKUP_BOROUGH, COUNT(*) AS total_trips FROM with_borough GROUP BY PICKUP_BOROUGH), category_counts AS (SELECT PICKUP_BOROUGH, TIP_CATEGORY, COUNT(*) AS category_trips FROM with_borough GROUP BY PICKUP_BOROUGH, TIP_CATEGORY) SELECT c.PICKUP_BOROUGH, c.TIP_CATEGORY, CAST(c.category_trips AS DOUBLE PRECISION) / b.total_trips AS PROPORTION FROM category_counts AS c JOIN borough_totals AS b ON c.PICKUP_BOROUGH = b.PICKUP_BOROUGH ORDER BY c.PICKUP_BOROUGH, c.TIP_