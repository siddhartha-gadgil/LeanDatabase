gh,\n        tip_category,\n        COUNT(*) AS category_trips\n    FROM categorized\n    GROUP BY pickup_borough, tip_category\n)\nSELECT\n    cc.pickup_borough AS PICKUP_BOROUGH,\n    cc.tip_category AS TIP_CATEGORY,\n    ROUND(cc.category_trips * 1.0 / bc.total_trips, 6) AS PROPORTION\nFROM category_counts cc\nJOIN borough_counts bc ON cc.pickup_borough = bc.pickup_borough\nORDER BY cc.pickup_borough, cc.tip_category;") t := by
