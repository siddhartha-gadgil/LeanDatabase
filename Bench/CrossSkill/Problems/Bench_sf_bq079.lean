ql%([ESTIMATED_TIMBERLAND_ACRES_schema, ESTIMATED_FORESTLAND_ACRES_schema]) "WITH timberland_latest AS (SELECT \"state_code\", \"state_name\", \"evaluation_group\", TOTAL_ACRES FROM (SELECT \"state_code\", \"state_name\", \"evaluation_group\", SUM(\"subplot_acres\") + SUM(COALESCE(\"macroplot_acres\", 0)) AS TOTAL_ACRES, ROW_NUMBER() OVER (PARTITION BY \"state_code\" ORDER BY \"evaluation_group\" DESC) AS _w FROM \"USFS_FIA\".\"USFS_FIA\".\"ESTIMATED_TIMBERLAND_ACRES\" WHERE \"evaluation_type\" = 'EXPCURR' GROUP BY \"state_code\", \"state_name\", \"evaluation_group\") AS _t WHERE _w = 1), timberland_top AS (SELECT 'Timberland' AS CATEGORY, \"state_code\" AS STATE_CODE, \"evaluation_group\" AS EVALUATION_GROUP, \"state_name\" AS STATE_NAME, TOTAL_ACRES FROM timberland_latest ORDER BY TOTAL_ACRES DESC LIMIT 1), forestland_latest AS (SELECT \"state_code\", \"state_name\", \"evaluation_group\", TOTAL_ACRES FROM (SELECT \"state_code\", \"state_name\", \"evaluation_group\", SUM(\"subplot_acres\") + SUM(COALESCE(\"macroplot_acres\", 0)) AS TOTAL_ACRES, ROW_NUMBER() OVER (PARTITION BY \"state_code\" ORDER BY \"evaluation_group\" DESC) AS _w FROM \"USFS_FIA\".\"USFS_FIA\".\"ESTIMATED_FORESTLAND_ACRES\" WHERE \"evaluation_type\" = 'EXPCURR' GROUP BY \"state_code\", \"state_name\", \"evaluation_group\") AS _t WHERE _w = 1), forestland_top AS (SELECT 'Forestland' AS CATEGORY, \"state_code\" AS STATE_CODE, \"evaluation_group\" AS EVALUATION_GROUP, \"state_name\" AS STATE_NAME, TOTAL_ACRES FROM forestland_latest ORDER BY TOTAL_ACRES DESC LIMIT 1) SELECT * FROM timberland_top UNION ALL SELECT * FROM forestland_top ORDER BY CATEGORY DESC") t := by
