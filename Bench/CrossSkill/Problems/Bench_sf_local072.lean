/-!
# sf_local072 — crossskill equivalence(s)

Question: Identify the country with data inserted on nine different days in January 2022. Then, find the longest consecutive period with data insertions for this country during January 2022, and calculate the proportion of entries that are from its capital city within this longest consecutive insertion period.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local072

CREATE TABLE CITIES («city_id» INT, «city_name» STRING, «latitude» FLOAT, «longitude» FLOAT, «country_code_2» STRING, «capital» INT, «population» FLOAT, «insert_date» STRING)
CREATE TABLE CITIES_COUNTRIES («country_id» INT, «country_name» STRING, «country_code_2» STRING, «country_code_3» STRING, «region» STRING, «sub_region» STRING, «intermediate_region» STRING, «created_on» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([CITIES_schema, CITIES_COUNTRIES_schema]) "/* Step 1: Find the country with data inserted on exactly 9 different days in January 2022 */ WITH country_9days AS (SELECT \"country_code_2\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" WHERE \"insert_date\" >= '2022-01-01' AND \"insert_date\" <= '2022-01-31' GROUP BY \"country_code_2\" HAVING COUNT(DISTINCT \"insert_date\") = 9), country_dates /* Step 2: Get distinct insert dates for this country in January 2022 */ AS (SELECT DISTINCT c.\"insert_date\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" AS c INNER JOIN country_9days AS cd ON c.\"country_code_2\" = cd.\"country_code_2\" WHERE c.\"insert_date\" >= '2022-01-01' AND c.\"insert_date\" <= '2022-01-31'), date_groups /* Step 3: Identify consecutive groups using date - row_number trick */ AS (SELECT \"insert_date\", \"insert_date\" + INTERVAL '1 DAY' * -ROW_NUMBER() OVER (ORDER BY \"insert_date\") AS grp FROM country_dates), consecutive_runs /* Step 4: Find the longest consecutive group */ AS (SELECT grp, MIN(\"insert_date\") AS start_date, MAX(\"insert_date\") AS end_date, COUNT(*) AS run_length FROM date_groups GROUP BY grp), longest_run AS (SELECT start_date, end_date FROM consecutive_runs ORDER BY run_length DESC LIMIT 1), entries_in_period /* Step 5: Calculate proportion of capital entries within the longest consecutive period */ AS (SELECT c.\"capital\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" AS c INNER JOIN country_9days AS cd ON c.\"country_code_2\" = cd.\"country_code_2\" CROSS JOIN longest_run AS lr WHERE c.\"insert_date\" >= lr.start_date AND c.\"insert_date\" <= lr.end_date) SELECT CAST(SUM(CASE WHEN \"capital\" = 1 THEN 1 ELSE 0 END) AS DOUBLE PRECISION) / COUNT(*) AS percentage_of_capital FROM entries_in_period" = sql%([CITIES_schema, CITIES_COUNTRIES_schema]) "/* Step 1: Find the country with exactly 9 distinct insert dates in January 2022 */ /* Step 2: Find the longest consecutive period of insertions for that country */ /* Step 3: Calculate the proportion of capital city entries in that period */ WITH target_country AS (SELECT \"country_code_2\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" WHERE \"insert_date\" >= '2022-01-01' AND \"insert_date\" < '2022-02-01' GROUP BY \"country_code_2\" HAVING COUNT(DISTINCT \"insert_date\") = 9), distinct_dates AS (SELECT DISTINCT c.\"insert_date\" AS dt FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" AS c JOIN target_country AS tc ON c.\"country_code_2\" = tc.\"country_code_2\" WHERE c.\"insert_date\" >= '2022-01-01' AND c.\"insert_date\" < '2022-02-01'), consecutive_groups AS (SELECT dt, dt + INTERVAL '1 DAY' * -ROW_NUMBER() OVER (ORDER BY dt) AS grp FROM distinct_dates), consecutive_periods AS (SELECT grp, MIN(dt) AS start_date, MAX(dt) AS end_date, COUNT(*) AS consecutive_days FROM consecutive_groups GROUP BY grp), longest_period AS (SELECT start_date, end_date FROM consecutive_periods ORDER BY consecutive_days DESC LIMIT 1) SELECT ROUND(CAST(CAST(SUM(CASE WHEN c.\"capital\" = 1 THEN 1.0 ELSE 0 END) AS DOUBLE PRECISION) / COUNT(*) AS DECIMAL), 2) AS percentage_of_capital FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" AS c JOIN target_country AS tc ON c.\"country_code_2\" = tc.\"country_code_2\" JOIN longest_period AS lp ON c.\"insert_date\" BETWEEN lp.start_date AND lp.end_date" := by
