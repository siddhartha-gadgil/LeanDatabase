/-!
# sf_local072 — crossskill equivalence(s)

Question: Identify the country with data inserted on nine different days in January 2022. Then, find the longest consecutive period with data insertions for this country during January 2022, and calculate the proportion of entries that are from its capital city within this longest consecutive insertion period.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local072

CREATE TABLE CITIES («city_id» INT, «city_name» STRING, «latitude» FLOAT, «longitude» FLOAT, «country_code_2» STRING, «capital» INT, «population» FLOAT, «insert_date» STRING)
CREATE TABLE CITIES_COUNTRIES («country_id» INT, «country_name» STRING, «country_code_2» STRING, «country_code_3» STRING, «region» STRING, «sub_region» STRING, «intermediate_region» STRING, «created_on» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([CITIES_schema, CITIES_COUNTRIES_schema]) "-- Step 1: Find the country with data inserted on exactly 9 different days in January 2022\nWITH country_9days AS (\n    SELECT \"country_code_2\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\"\n    WHERE \"insert_date\" >= '2022-01-01' AND \"insert_date\" <= '2022-01-31'\n    GROUP BY \"country_code_2\"\n    HAVING COUNT(DISTINCT \"insert_date\") = 9\n),\n\n-- Step 2: Get distinct insert dates for this country in January 2022\ncountry_dates AS (\n    SELECT DISTINCT c.\"insert_date\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" c\n    INNER JOIN country_9days cd ON c.\"country_code_2\" = cd.\"country_code_2\"\n    WHERE c.\"insert_date\" >= '2022-01-01' AND c.\"insert_date\" <= '2022-01-31'\n),\n\n-- Step 3: Identify consecutive groups using date - row_number trick\ndate_groups AS (\n    SELECT \n        \"insert_date\",\n        DATEADD('day', -ROW_NUMBER() OVER (ORDER BY \"insert_date\"), \"insert_date\") AS grp\n    FROM country_dates\n),\n\n-- Step 4: Find the longest consecutive group\nconsecutive_runs AS (\n    SELECT \n        grp,\n        MIN(\"insert_date\") AS start_date,\n        MAX(\"insert_date\") AS end_date,\n        COUNT(*) AS run_length\n    FROM date_groups\n    GROUP BY grp\n),\n\nlongest_run AS (\n    SELECT start_date, end_date\n    FROM consecutive_runs\n    ORDER BY run_length DESC\n    LIMIT 1\n),\n\n-- Step 5: Calculate proportion of capital entries within the longest consecutive period\nentries_in_period AS (\n    SELECT c.\"capital\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" c\n    INNER JOIN country_9days cd ON c.\"country_code_2\" = cd.\"country_code_2\"\n    CROSS JOIN longest_run lr\n    WHERE c.\"insert_date\" >= lr.start_date AND c.\"insert_date\" <= lr.end_date\n)\n\nSELECT \n    SUM(CASE WHEN \"capital\" = 1 THEN 1 ELSE 0 END)::FLOAT / COUNT(*) AS percentage_of_capital\nFROM entries_in_period;" = sql%([CITIES_schema, CITIES_COUNTRIES_schema]) "-- Step 1: Find the country with exactly 9 distinct insert dates in January 2022\n-- Step 2: Find the longest consecutive period of insertions for that country\n-- Step 3: Calculate the proportion of capital city entries in that period\n\nWITH target_country AS (\n    SELECT \"country_code_2\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\"\n    WHERE \"insert_date\" >= '2022-01-01' AND \"insert_date\" < '2022-02-01'\n    GROUP BY \"country_code_2\"\n    HAVING COUNT(DISTINCT \"insert_date\") = 9\n),\ndistinct_dates AS (\n    SELECT DISTINCT c.\"insert_date\" AS dt\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" c\n    JOIN target_country tc ON c.\"country_code_2\" = tc.\"country_code_2\"\n    WHERE c.\"insert_date\" >= '2022-01-01' AND c.\"insert_date\" < '2022-02-01'\n),\nconsecutive_groups AS (\n    SELECT dt,\n           DATEADD('day', -ROW_NUMBER() OVER (ORDER BY dt), dt) AS grp\n    FROM distinct_dates\n),\nconsecutive_periods AS (\n    SELECT grp, MIN(dt) AS start_date, MAX(dt) AS end_date, COUNT(*) AS consecutive_days\n    FROM consecutive_groups\n    GROUP BY grp\n),\nlongest_period AS (\n    SELECT start_date, end_date\n    FROM consecutive_periods\n    ORDER BY consecutive_days DESC\n    LIMIT 1\n)\nSELECT \n    ROUND(SUM(CASE WHEN c.\"capital\" = 1 THEN 1.0 ELSE 0 END) / COUNT(*), 2) AS percentage_of_capital\nFROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" c\nJOIN target_country tc ON c.\"country_code_2\" = tc.\"country_code_2\"\nJOIN longest_period lp ON c.\"insert_date\" BETWEEN lp.start_date AND lp.end_date;" := by
  first | sql_equiv | sorry

