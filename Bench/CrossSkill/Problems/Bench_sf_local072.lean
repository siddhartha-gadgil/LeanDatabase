TY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" WHERE \"insert_date\" >= '2022-01-01' AND \"insert_date\" <= '2022-01-31' GROUP BY \"country_code_2\" HAVING COUNT(DISTINCT \"insert_date\") = 9), insert_days AS (/* Get distinct insert dates for that country in January 2022 */ SELECT DISTINCT CAST(c.\"insert_date\" AS DATE) AS insert_day FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" AS c JOIN target_country AS tc ON c.\"country_code_2\" = tc.\"country_code_2\" WHERE c.\"insert_date\" >= '2022-01-01' AND c.\"insert_date\" <= '2022-01-31'), consecutive_groups AS (/* Use row_number gap technique to identify consecutive groups */ SELECT insert_day, insert_day + INTERVAL '1 DAY' * -ROW_NUMBER() OVER (ORDER BY insert_day) AS grp FROM insert_days), longest_period AS (/* Find the longest consecutive period */ SELECT MIN(insert_day) AS period_start, MAX(insert_day) AS period_end, COUNT(*) AS period_length FROM consecutive_groups GROUP BY grp ORDER BY period_length DESC LIMIT 1), period_entries AS (/* Get all entries for the target country within the longest consecutive period */ SELECT c.\"city_name\", c.\"capital\", c.\"insert_date\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" AS c JOIN target_country AS tc ON c.\"country_code_2\" = tc.\"country_code_2\" JOIN longest_period AS lp ON CAST(c.\"insert_date\" AS DATE) BETWEEN lp.period_start AND lp.period_end) SELECT ROUND(CAST(SUM(CASE WHEN \"capital\" = 1 THEN 1 ELSE 0 END) AS DECIMAL(38, 0)) / COUNT(*), 2) AS \"percentage_of_capital\" FROM period_entries" := by
