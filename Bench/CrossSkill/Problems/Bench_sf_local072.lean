January 2022\n    SELECT cc.\"country_code_2\", cc.\"country_name\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" c\n    JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES_COUNTRIES\" cc\n      ON c.\"country_code_2\" = cc.\"country_code_2\"\n    WHERE c.\"insert_date\" >= '2022-01-01' AND c.\"insert_date\" <= '2022-01-31'\n    GROUP BY cc.\"country_code_2\", cc.\"country_name\"\n    HAVING COUNT(DISTINCT c.\"insert_date\") = 9\n),\ndistinct_days AS (\n    -- Get distinct insert dates for the target country in January 2022\n    SELECT DISTINCT c.\"insert_date\"::DATE AS insert_day\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" c\n    JOIN target_country tc ON c.\"country_code_2\" = tc.\"country_code_2\"\n    WHERE c.\"insert_date\" >= '2022-01-01' AND c.\"insert_date\" <= '2022-01-31'\n),\nday_groups AS (\n    -- Assign a group ID for consecutive days using the gaps-and-islands technique\n    SELECT insert_day,\n           DATEADD('day', -ROW_NUMBER() OVER (ORDER BY insert_day), insert_day) AS grp\n    FROM distinct_days\n),\nconsecutive_periods AS (\n    -- Find consecutive periods and their lengths\n    SELECT grp,\n           MIN(insert_day) AS period_start,\n           MAX(insert_day) AS period_end,\n           COUNT(*) AS period_length\n    FROM day_groups\n    GROUP BY grp\n),\nlongest_period AS (\n    -- Select the longest consecutive period\n    SELECT period_start, period_end, period_length\n    FROM consecutive_periods\n    ORDER BY period_length DESC, period_start\n    LIMIT 1\n),\nentries_in_period AS (\n    -- Get all entries for the target country within the longest consecutive period\n    SELECT c.\"city_name\", c.\"capital\", c.\"insert_date\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"CITIES\" c\n    JOIN target_country tc ON c.\"country_code_2\" = tc.\"country_code_2\"\n    JOIN longest_period lp ON c.\"insert_date\"::DATE BETWEEN lp.period_start AND lp.period_end\n)\nSELECT \n    ROUND(SUM(CASE WHEN \"capital\" = 1 THEN 1 ELSE 0 END)::DECIMAL / COUNT(*), 1) AS percentage_of_capital\nFROM entries_in_period;") t := by
