import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq170 — crossskill equivalence(s)

Question: For breast cancer cases (TCGA-BRCA) from Release 23 of the active GDC archive, identify and categorize copy number variations (CNVs) across all cytobands on every chromosome. For each cytoband and each case, determine the overlap between the cytoband region and the case's copy number segments, and compute the overlap-weighted average copy number for that cytoband in the case, rounding to the nearest whole number. Classify the rounded copy number into CNV types as follows: homozygous deletions (0), heterozygous deletions (1), normal diploid state (2), gains (3), and amplifications (greater than 3). For each cytoband, provide its name and start/end positions, and calculate the frequency of each CNV type across all cases as a percentage of the total number of cases, rounded to two decimal places.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq170

CREATE TABLE CYTOBANDS_HG38 («chromosome» STRING, «cytoband_name» STRING, «hg38_start» INT, «hg38_stop» INT)
CREATE TABLE COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23 («project_short_name» STRING, «case_barcode» STRING, «primary_site» STRING, «sample_barcode» STRING, «aliquot_barcode» STRING, «chromosome» STRING, «start_pos» INT, «end_pos» INT, «copy_number» INT, «major_copy_number» INT, «minor_copy_number» INT, «case_gdc_id» STRING, «sample_gdc_id» STRING, «aliquot_gdc_id» STRING, «file_gdc_id» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([CYTOBANDS_HG38_schema, COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23_schema]) "WITH total_cases AS (\n    SELECT COUNT(DISTINCT \"case_barcode\") AS n_cases\n    FROM \"TCGA_MITELMAN\".\"TCGA_VERSIONED\".\"COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23\"\n    WHERE \"project_short_name\" = 'TCGA-BRCA'\n),\n-- Step 1: Compute overlap between each CNV segment and each cytoband, per case\noverlaps AS (\n    SELECT\n        cn.\"case_barcode\",\n        c.\"cytoband_name\",\n        c.\"hg38_start\",\n        c.\"hg38_stop\",\n        cn.\"copy_number\",\n        (ABS(c.\"hg38_stop\" - c.\"hg38_start\") + ABS(cn.\"end_pos\" - cn.\"start_pos\") \n         - ABS(c.\"hg38_stop\" - cn.\"end_pos\") - ABS(c.\"hg38_start\" - cn.\"start_pos\")) / 2.0 AS overlap_bp\n    FROM \"TCGA_MITELMAN\".\"PROD\".\"CYTOBANDS_HG38\" c\n    JOIN \"TCGA_MITELMAN\".\"TCGA_VERSIONED\".\"COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23\" cn\n        ON c.\"chromosome\" = cn.\"chromosome\"\n        AND cn.\"start_pos\" < c.\"hg38_stop\"\n        AND cn.\"end_pos\" > c.\"hg38_start\"\n    WHERE cn.\"project_short_name\" = 'TCGA-BRCA'\n),\n-- Step 2: Compute overlap-weighted average copy number per case, cytoband\nweighted_avg AS (\n    SELECT\n        \"case_barcode\",\n        \"cytoband_name\",\n        \"hg38_start\",\n        \"hg38_stop\",\n        SUM(overlap_bp * \"copy_number\") / SUM(overlap_bp) AS weighted_avg_cn\n    FROM overlaps\n    WHERE overlap_bp > 0\n    GROUP BY \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\"\n),\n-- Step 3: Round to nearest integer and classify CNV type\nclassified AS (\n    SELECT\n        \"case_barcode\",\n        \"cytoband_name\",\n        \"hg38_start\",\n        \"hg38_stop\",\n        ROUND(weighted_avg_cn, 0) AS rounded_cn,\n        CASE\n            WHEN ROUND(weighted_avg_cn, 0) = 0 THEN 'homodel'\n            WHEN ROUND(weighted_avg_cn, 0) = 1 THEN 'heterodel'\n            WHEN ROUND(weighted_avg_cn, 0) = 2 THEN 'normal'\n            WHEN ROUND(weighted_avg_cn, 0) = 3 THEN 'gain'\n            WHEN ROUND(weighted_avg_cn, 0) >= 4 THEN 'amp'\n        END AS cnv_type\n    FROM weighted_avg\n)\n-- Step 4: Calculate frequency of each CNV type per cytoband\nSELECT\n    cl.\"cytoband_name\",\n    cl.\"hg38_start\",\n    cl.\"hg38_stop\",\n    ROUND(COUNT(CASE WHEN cnv_type = 'homodel' THEN 1 END) * 100.0 / tc.n_cases, 2) AS freq_homodel,\n    ROUND(COUNT(CASE WHEN cnv_type = 'heterodel' THEN 1 END) * 100.0 / tc.n_cases, 2) AS freq_heterodel,\n    ROUND(COUNT(CASE WHEN cnv_type = 'normal' THEN 1 END) * 100.0 / tc.n_cases, 2) AS freq_normal,\n    ROUND(COUNT(CASE WHEN cnv_type = 'gain' THEN 1 END) * 100.0 / tc.n_cases, 2) AS freq_gain,\n    ROUND(COUNT(CASE WHEN cnv_type = 'amp' THEN 1 END) * 100.0 / tc.n_cases, 2) AS freq_amp\nFROM classified cl\nCROSS JOIN total_cases tc\nGROUP BY cl.\"cytoband_name\", cl.\"hg38_start\", cl.\"hg38_stop\", tc.n_cases\nORDER BY cl.\"cytoband_name\";") t ~= (sql%([CYTOBANDS_HG38_schema, COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23_schema]) "WITH\n-- Get all TCGA-BRCA copy number segments\nbrca_segments AS (\n  SELECT\n    \"case_barcode\",\n    \"chromosome\",\n    \"start_pos\",\n    \"end_pos\",\n    \"copy_number\"\n  FROM \"TCGA_MITELMAN\".\"TCGA_VERSIONED\".\"COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23\"\n  WHERE \"project_short_name\" = 'TCGA-BRCA'\n),\n\n-- Get cytobands\ncytobands AS (\n  SELECT\n    \"chromosome\",\n    \"cytoband_name\",\n    \"hg38_start\",\n    \"hg38_stop\"\n  FROM \"TCGA_MITELMAN\".\"PROD\".\"CYTOBANDS_HG38\"\n),\n\n-- Join segments with cytobands on chromosome overlap\nseg_cyto AS (\n  SELECT\n    s.\"case_barcode\",\n    c.\"cytoband_name\",\n    c.\"hg38_start\",\n    c.\"hg38_stop\",\n    s.\"copy_number\",\n    -- Compute overlap length\n    LEAST(s.\"end_pos\", c.\"hg38_stop\") - GREATEST(s.\"start_pos\", c.\"hg38_start\") AS overlap_len\n  FROM brca_segments s\n  JOIN cytobands c\n    ON s.\"chromosome\" = c.\"chromosome\"\n    AND s.\"start_pos\" < c.\"hg38_stop\"\n    AND s.\"end_pos\" > c.\"hg38_start\"\n),\n\n-- Weighted average copy number per case per cytoband\ncase_cyto AS (\n  SELECT\n    \"case_barcode\",\n    \"cytoband_name\",\n    \"hg38_start\",\n    \"hg38_stop\",\n    ROUND(SUM(\"copy_number\" * overlap_len) / SUM(overlap_len), 0) AS avg_cn\n  FROM seg_cyto\n  WHERE overlap_len > 0\n  GROUP BY \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\"\n),\n\n-- Classify copy number\nclassified AS (\n  SELECT\n    \"case_barcode\",\n    \"cytoband_name\",\n    \"hg38_start\",\n    \"hg38_stop\",\n    CASE\n      WHEN avg_cn = 0 THEN 'homodel'\n      WHEN avg_cn = 1 THEN 'heterodel'\n      WHEN avg_cn = 2 THEN 'normal'\n      WHEN avg_cn = 3 THEN 'gain'\n      WHEN avg_cn >= 4 THEN 'amp'\n    END AS cn_class\n  FROM case_cyto\n),\n\n-- Count total distinct cases\ntotal_cases AS (\n  SELECT COUNT(DISTINCT \"case_barcode\") AS total\n  FROM brca_segments\n),\n\n-- Frequency per cytoband\nfreq AS (\n  SELECT\n    c.\"cytoband_name\",\n    c.\"hg38_start\",\n    c.\"hg38_stop\",\n    ROUND(100.0 * COUNT(CASE WHEN c.cn_class = 'homodel' THEN 1 END) / t.total, 2) AS freq_homodel,\n    ROUND(100.0 * COUNT(CASE WHEN c.cn_class = 'heterodel' THEN 1 END) / t.total, 2) AS freq_heterodel,\n    ROUND(100.0 * COUNT(CASE WHEN c.cn_class = 'normal' THEN 1 END) / t.total, 2) AS freq_normal,\n    ROUND(100.0 * COUNT(CASE WHEN c.cn_class = 'gain' THEN 1 END) / t.total, 2) AS freq_gain,\n    ROUND(100.0 * COUNT(CASE WHEN c.cn_class = 'amp' THEN 1 END) / t.total, 2) AS freq_amp\n  FROM classified c\n  CROSS JOIN total_cases t\n  GROUP BY c.\"cytoband_name\", c.\"hg38_start\", c.\"hg38_stop\", t.total\n)\n\nSELECT\n  \"cytoband_name\",\n  \"hg38_start\",\n  \"hg38_stop\",\n  freq_homodel,\n  freq_heterodel,\n  freq_normal,\n  freq_gain,\n  freq_amp\nFROM freq\nORDER BY \"cytoband_name\"") t := by
  intro t; first | sql_equiv | sorry

end Bench_sf_bq170
