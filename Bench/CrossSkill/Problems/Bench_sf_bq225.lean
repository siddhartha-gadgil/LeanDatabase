import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq225 — crossskill equivalence(s)

Question: From the GitHub repository files in 'github_repos.sample_files' joined with 'github_repos.sample_contents', which 10 programming languages occur most frequently (based on recognized file extensions) in files that have non-empty content, ordered by their file counts in descending order?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq225

CREATE TABLE SAMPLE_FILES («repo_name» STRING, «ref» STRING, «path» STRING, «mode» INT, «id» STRING, «symlink_target» STRING)
CREATE TABLE SAMPLE_CONTENTS («id» STRING, «size» INT, «content» STRING, «binary» BOOL, «copies» INT, «sample_repo_name» STRING, «sample_ref» STRING, «sample_path» STRING, «sample_mode» INT, «sample_symlink_target» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([SAMPLE_FILES_schema, SAMPLE_CONTENTS_schema]) "WITH file_extensions AS (SELECT sf.\"id\", sf.\"path\", CASE WHEN POSITION('.' IN sf.\"path\") > 0 THEN LOWER(REVERSE(SPLIT_PART(REVERSE(sf.\"path\"), '.', 1))) ELSE NULL END AS ext, CASE WHEN sf.\"path\" LIKE '%/Dockerfile' OR sf.\"path\" = 'Dockerfile' THEN 'Dockerfile' ELSE NULL END AS dockerfile_match FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_FILES\" AS sf JOIN \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS sc ON sf.\"id\" = sc.\"id\" WHERE NOT sc.\"content\" IS NULL), language_mapping AS (SELECT CASE WHEN dockerfile_match = 'Dockerfile' THEN 'Dockerfile' WHEN ext IN ('asm', 'nasm') THEN 'Assembly' WHEN ext IN ('c', 'h') THEN 'C' WHEN ext = 'cs' THEN 'C#' WHEN ext IN ('c++', 'cpp', 'h++', 'hpp') THEN 'C++' WHEN ext = 'css' THEN 'CSS' WHEN ext = 'clj' THEN 'Clojure' WHEN ext = 'lisp' THEN 'Common Lisp' WHEN ext = 'd' THEN 'D' WHEN ext = 'dart' THEN 'Dart' WHEN ext = 'dockerfile' THEN 'Dockerfile' WHEN ext IN ('ex', 'exs') THEN 'Elixir' WHEN ext = 'erl' THEN 'Erlang' WHEN ext = 'go' THEN 'Go' WHEN ext = 'groovy' THEN 'Groovy' WHEN ext IN ('html', 'htm') THEN 'HTML' WHEN ext = 'hs' THEN 'Haskell' WHEN ext = 'hx' THEN 'Haxe' WHEN ext = 'json' THEN 'JSON' WHEN ext = 'java' THEN 'Java' WHEN ext IN ('js', 'cjs') THEN 'JavaScript' WHEN ext = 'jl' THEN 'Julia' WHEN ext IN ('kt', 'ktm', 'kts') THEN 'Kotlin' WHEN ext = 'lua' THEN 'Lua' WHEN ext IN ('matlab', 'm') THEN 'MATLAB' WHEN ext IN ('md', 'markdown', 'mdown') THEN 'Markdown' WHEN ext = 'php' THEN 'PHP' WHEN ext IN ('ps1', 'psd1', 'psm1') THEN 'PowerShell' WHEN ext = 'py' THEN 'Python' WHEN ext = 'r' THEN 'R' WHEN ext = 'rb' THEN 'Ruby' WHEN ext = 'rs' THEN 'Rust' WHEN ext = 'scss' THEN 'SCSS' WHEN ext = 'sql' THEN 'SQL' WHEN ext = 'sass' THEN 'Sass' WHEN ext = 'scala' THEN 'Scala' WHEN ext IN ('sh', 'bash') THEN 'Shell' WHEN ext = 'swift' THEN 'Swift' WHEN ext = 'ts' THEN 'TypeScript' WHEN ext = 'vue' THEN 'Vue' WHEN ext = 'xml' THEN 'XML' WHEN ext IN ('yml', 'yaml') THEN 'YAML' ELSE NULL END AS language FROM file_extensions) SELECT language FROM language_mapping WHERE NOT language IS NULL GROUP BY language ORDER BY COUNT(*) DESC, language ASC LIMIT 10") t ~= (sql%([SAMPLE_FILES_schema, SAMPLE_CONTENTS_schema]) "SELECT language FROM (SELECT language, COUNT(*) AS num_files FROM (SELECT CASE WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('c', 'h') THEN 'C' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('cpp', 'cc', 'cxx') THEN 'C++' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'java' THEN 'Java' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'js' THEN 'JavaScript' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'py' THEN 'Python' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'rb' THEN 'Ruby' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'php' THEN 'PHP' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('html', 'htm') THEN 'HTML' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'css' THEN 'CSS' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'xml' THEN 'XML' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'json' THEN 'JSON' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'cs' THEN 'C#' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'swift' THEN 'Swift' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'go' THEN 'Go' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'rs' THEN 'Rust' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'ts' THEN 'TypeScript' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'scala' THEN 'Scala' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'pl' THEN 'Perl' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'sh' THEN 'Shell' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'r' THEN 'R' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'lua' THEN 'Lua' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'm' THEN 'MATLAB' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'sql' THEN 'SQL' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('yml', 'yaml') THEN 'YAML' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'md' THEN 'Markdown' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'coffee' THEN 'CoffeeScript' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'kt' THEN 'Kotlin' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'dart' THEN 'Dart' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'groovy' THEN 'Groovy' ELSE NULL END AS language FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_FILES\" AS f INNER JOIN \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS c ON f.\"id\" = c.\"id\" WHERE NOT c.\"content\" IS NULL AND f.\"path\" LIKE '%.%') AS sub WHERE NOT language IS NULL GROUP BY language ORDER BY num_files DESC, language ASC LIMIT 10) AS final") t := by
