path\", '\\\\.[^./]+$')) = '.sass' THEN 'Sass'\n      WHEN LOWER(REGEXP_SUBSTR(f.\"path\", '\\\\.[^./]+$')) = '.scala' THEN 'Scala'\n      WHEN LOWER(REGEXP_SUBSTR(f.\"path\", '\\\\.[^./]+$')) IN ('.sh', '.bash') THEN 'Shell'\n      WHEN LOWER(REGEXP_SUBSTR(f.\"path\", '\\\\.[^./]+$')) = '.swift' THEN 'Swift'\n      WHEN LOWER(REGEXP_SUBSTR(f.\"path\", '\\\\.[^./]+$')) = '.ts' THEN 'TypeScript'\n      WHEN LOWER(REGEXP_SUBSTR(f.\"path\", '\\\\.[^./]+$')) = '.vue' THEN 'Vue'\n      WHEN LOWER(REGEXP_SUBSTR(f.\"path\", '\\\\.[^./]+$')) = '.xml' THEN 'XML'\n      WHEN LOWER(REGEXP_SUBSTR(f.\"path\", '\\\\.[^./]+$')) IN ('.yml', '.yaml') THEN 'YAML'\n      ELSE NULL\n    END AS language\n  FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_FILES\" f\n  INNER JOIN \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" c\n    ON f.\"id\" = c.\"id\"\n  WHERE c.\"content\" IS NOT NULL AND c.\"content\" != ''\n)\nSELECT language\nFROM file_lang\nWHERE language IS NOT NULL\nGROUP BY language\nORDER BY COUNT(*) DESC\nLIMIT 10;") t := by
