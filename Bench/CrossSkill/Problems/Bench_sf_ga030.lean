),\ncohort_retention AS (\n  SELECT\n    cohort_week,\n    COUNT(DISTINCT \"user_pseudo_id\") AS total_users\n  FROM user_cohort\n  GROUP BY cohort_week\n),\nweek4_retained AS (\n  SELECT\n    cohort_week,\n    COUNT(DISTINCT \"user_pseudo_id\") AS retained_users\n  FROM retention_data\n  WHERE day_diff BETWEEN 22 AND 28\n  GROUP BY cohort_week\n),\nretention_rates AS (\n  SELECT\n    cr.cohort_week AS COHORT_WEEK,\n    cr.total_users,\n    COALESCE(w4.retained_users, 0) AS retained_users,\n    COALESCE(w4.retained_users, 0)::FLOAT / cr.total_users AS retention_rate\n  FROM cohort_retention cr\n  LEFT JOIN week4_retained w4 ON cr.cohort_week = w4.cohort_week\n  WHERE cr.total_users > 0\n)\nSELECT TO_CHAR(COHORT_WEEK, 'YYYY-MM-DD') AS COHORT_WEEK\nFROM retention_rates\nORDER BY retention_rate DESC\nLIMIT 1;") t := by
