rst_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180924\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180925\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180926\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180927\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180928\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180929\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180930\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20181001\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20181002\"\n  UNION ALL SELECT \"event_date\", \"event_name\", \"user_pseudo_id\", \"user_first_touch_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20181003\"\n),\n-- Determine each user's cohort week from user_first_touch_timestamp\nuser_cohorts AS (\n  SELECT\n    \"user_pseudo_id\",\n    DATE_TRUNC('WEEK', TO_DATE(TO_TIMESTAMP(MIN(\"user_first_touch_timestamp\") / 1000000))) AS cohort_week\n  FROM all_events\n  GROUP BY \"user_pseudo_id\"\n),\n-- Only include cohorts starting from July 2, 2018\ncohort_filtered AS (\n  SELECT *\n  FROM user_cohorts\n  WHERE cohort_week >= '2018-07-02'\n),\n-- Count users per cohort\ncohort_sizes AS (\n  SELECT\n    cohort_week,\n    COUNT(DISTINCT \"user_pseudo_id\") AS cohort_size\n  FROM cohort_filtered\n  GROUP BY cohort_week\n),\n-- Get all event dates for cohort users\nuser_events AS (\n  SELECT DISTINCT\n    a.\"user_pseudo_id\",\n    a.\"event_date\",\n    c.cohort_week\n  FROM all_events a\n  JOIN cohort_filtered c ON a.\"user_pseudo_id\" = c.\"user_pseudo_id\"\n),\n-- Fourth week retention: days 21-27 from cohort_week\nfourth_week_retention AS (\n  SELECT\n    ue.cohort_week,\n    COUNT(DISTINCT ue.\"user_pseudo_id\") AS returned_users\n  FROM user_events ue\n  WHERE DATEDIFF('day', ue.cohort_week, TO_DATE(ue.\"event_date\", 'YYYYMMDD')) BETWEEN 21 AND 27\n  GROUP BY ue.cohort_week\n),\n-- Calculate retention rates\nretention_rates AS (\n  SELECT\n    cs.cohort_week,\n    cs.cohort_size,\n    COALESCE(fwr.returned_users, 0) AS returned_users,\n    COALESCE(fwr.returned_users, 0) / cs.cohort_size AS retention_rate\n  FROM cohort_sizes cs\n  LEFT JOIN fourth_week_retention fwr ON cs.cohort_week = fwr.cohort_week\n  WHERE cs.cohort_size > 0\n)\nSELECT TO_CHAR(cohort_week, 'YYYY-MM-DD') AS COHORT_WEEK\nFROM retention_rates\nORDER BY retention_rate DESC\nLIMIT 1;" = sql%([EVENTS_20180613_schema, EVENTS_20180616_schema, EVENTS_20180621_schema, EVENTS_20180628_schema, EVENTS_20180714_schema, EVENTS_20180804_schema, EVENTS_20180818_schema, EVENTS_20180827_schema, EVENTS_20180904_schema, EVENTS_20180929_schema, EVENTS_20180726_schema, EVENTS_20180730_schema, EVENTS_20180808_schema, EVENTS_20180809_schema, EVENTS_20180816_schema, EVENTS_20180817_schema, EVENTS_20180820_schema, EVENTS_20180826_schema, EVENTS_20180901_schema, EVENTS_20180915_schema, EVENTS_20180925_schema, EVENTS_20180927_schema, EVENTS_20180815_schema, EVENTS_20180906_schema, EVENTS_20180922_schema, EVENTS_20180830_schema, EVENTS_20180709_schema, EVENTS_20180802_schema, EVENTS_20180715_schema, EVENTS_20180813_schema, EVENTS_20180728_schema, EVE