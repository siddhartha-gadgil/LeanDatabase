rmine each user's cohort week from user_first_touch_timestamp */ AS (SELECT \"user_pseudo_id\", DATE_TRUNC('WEEK', CAST(TO_TIMESTAMP(CAST(MIN(\"user_first_touch_timestamp\") AS DOUBLE PRECISION) / 1000000) AS DATE)) AS cohort_week FROM all_events GROUP BY \"user_pseudo_id\"), cohort_filtered /* Only include cohorts starting from July 2, 2018 */ AS (SELECT * FROM user_cohorts WHERE cohort_week >= '2018-07-02'), cohort_sizes /* Count users per cohort */ AS (SELECT cohort_week, COUNT(DISTINCT \"user_pseudo_id\") AS cohort_size FROM cohort_filtered GROUP BY cohort_week), user_events /* Get all event dates for cohort users */ AS (SELECT DISTINCT a.\"user_pseudo_id\", a.\"event_date\", c.cohort_week FROM all_events AS a JOIN cohort_filtered AS c ON a.\"user_pseudo_id\" = c.\"user_pseudo_id\"), fourth_week_retention /* Fourth week retention: days 21-27 from cohort_week */ AS (SELECT ue.cohort_week, COUNT(DISTINCT ue.\"user_pseudo_id\") AS returned_users FROM user_events AS ue WHERE (CAST(CAST(TO_TIMESTAMP(ue.\"event_date\", 'YYYYMMDD') AS DATE) AS DATE) - CAST(ue.cohort_week AS DATE)) BETWEEN 21 AND 27 GROUP BY ue.cohort_week), retention_rates /* Calculate retention rates */ AS (SELECT cs.cohort_week, cs.cohort_size, COALESCE(fwr.returned_users, 0) AS returned_users, CAST(COALESCE(fwr.returned_users, 0) AS DOUBLE PRECISION) / cs.cohort_size AS retention_rate FROM cohort_sizes AS cs LEFT JOIN fourth_week_retention AS fwr ON cs.cohort_week = fwr.cohort_week WHERE cs.cohort_size > 0) SELECT TO_CHAR(cohort_week, 'YYYY-MM-DD') AS COHORT_WEEK FROM retention_rates ORDER BY retention_rate DESC LIMIT 1") t := by
