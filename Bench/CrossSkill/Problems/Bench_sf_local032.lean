    (sql%([OLIST_ORDERS_schema, OLIST_ORDER_ITEMS_schema, OLIST_ORDER_REVIEWS_schema, OLIST_CUSTOMERS_schema]) "WITH delivered_orders AS (\n    SELECT o.\"order_id\", o.\"customer_id\"\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDERS\" o\n    WHERE o.\"order_status\" = 'delivered'\n),\nmost_customers AS (\n    SELECT \n        'seller with the highest number of distinct customer unique IDs' AS \"ACHIEVEMENT\",\n        oi.\"seller_id\" AS \"SELLER_ID\",\n        COUNT(DISTINCT c.\"customer_unique_id\") AS \"VALUE\"\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDER_ITEMS\" oi\n    JOIN delivered_orders d ON oi.\"order_id\" = d.\"order_id\"\n    JOIN \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_CUSTOMERS\" c ON d.\"customer_id\" = c.\"customer_id\"\n    GROUP BY oi.\"seller_id\"\n    ORDER BY \"VALUE\" DESC\n    LIMIT 1\n),\nhighest_profit AS (\n    SELECT \n        'seller with the highest profit' AS \"ACHIEVEMENT\",\n        oi.\"seller_id\" AS \"SELLER_ID\",\n        SUM(oi.\"price\" - oi.\"freight_value\") AS \"VALUE\"\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDER_ITEMS\" oi\n    JOIN delivered_orders d ON oi.\"order_id\" = d.\"order_id\"\n    GROUP BY oi.\"seller_id\"\n    ORDER BY \"VALUE\" DESC\n    LIMIT 1\n),\nmost_orders AS (\n    SELECT \n        'seller with the highest number of distinct orders' AS \"ACHIEVEMENT\",\n        oi.\"seller_id\" AS \"SELLER_ID\",\n        COUNT(DISTINCT oi.\"order_id\") AS \"VALUE\"\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDER_ITEMS\" oi\n    JOIN delivered_orders d ON oi.\"order_id\" = d.\"order_id\"\n    GROUP BY oi.\"seller_id\"\n    ORDER BY \"VALUE\" DESC\n    LIMIT 1\n),\nmost_5star AS (\n    SELECT \n        'seller with the most 5-star ratings' AS \"ACHIEVEMENT\",\n        oi.\"seller_id\" AS \"SELLER_ID\",\n        COUNT(DISTINCT r.\"review_id\") AS \"VALUE\"\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZ