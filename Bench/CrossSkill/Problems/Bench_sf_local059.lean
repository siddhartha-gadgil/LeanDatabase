import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local059 — crossskill equivalence(s)

Question: For the calendar year 2021, what is the overall average quantity sold of the top three best-selling hardware products (by total quantity sold) in each division?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local059

CREATE TABLE HARDWARE_DIM_PRODUCT («product_code» STRING, «division» STRING, «segment» STRING, «category» STRING, «product» STRING, «variant» STRING)
CREATE TABLE HARDWARE_FACT_SALES_MONTHLY («date» STRING, «product_code» STRING, «customer_code» INT, «sold_quantity» INT, «fiscal_year» INT)

theorem eq_0_1 :
    sql%([HARDWARE_DIM_PRODUCT_schema, HARDWARE_FACT_SALES_MONTHLY_schema]) "WITH product_code_totals AS (SELECT p.\"division\", f.\"product_code\", SUM(f.\"sold_quantity\") AS total_qty FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"HARDWARE_DIM_PRODUCT\" AS p JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"HARDWARE_FACT_SALES_MONTHLY\" AS f ON p.\"product_code\" = f.\"product_code\" WHERE f.\"date\" LIKE '2021%' GROUP BY p.\"division\", f.\"product_code\"), ranked AS (SELECT \"division\", \"product_code\", total_qty, ROW_NUMBER() OVER (PARTITION BY \"division\" ORDER BY total_qty DESC) AS rn FROM product_code_totals) SELECT \"division\", AVG(total_qty) AS avg_top3_sold_quantity FROM ranked WHERE rn <= 3 GROUP BY \"division\" ORDER BY \"division\"" = sql%([HARDWARE_DIM_PRODUCT_schema, HARDWARE_FACT_SALES_MONTHLY_schema]) "WITH product_sales AS (SELECT p.\"division\", p.\"product_code\", SUM(s.\"sold_quantity\") AS total_qty FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"HARDWARE_FACT_SALES_MONTHLY\" AS s JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"HARDWARE_DIM_PRODUCT\" AS p ON s.\"product_code\" = p.\"product_code\" WHERE LEFT(s.\"date\", 4) = '2021' GROUP BY p.\"division\", p.\"product_code\"), ranked AS (SELECT \"division\", \"product_code\", total_qty, ROW_NUMBER() OVER (PARTITION BY \"division\" ORDER BY total_qty DESC) AS rn FROM product_sales) SELECT \"division\", AVG(total_qty) AS AVG_TOP3_SOLD_QUANTITY FROM ranked WHERE rn <= 3 GROUP BY \"division\" ORDER BY \"division\"" := by
  first | sql_equiv | sorry

