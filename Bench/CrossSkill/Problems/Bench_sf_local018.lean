/-!
# sf_local018 — crossskill equivalence(s)

Question: For the primary collision factor violation category that was the most common cause of traffic accidents in 2021, how many percentage points did its share of annual road incidents in 2021 decrease compared to its share in 2011?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local018

CREATE TABLE COLLISIONS («case_id» FLOAT, «jurisdiction» FLOAT, «officer_id» STRING, «reporting_district» STRING, «chp_shift» STRING, «population» STRING, «county_city_location» INT, «county_location» STRING, «special_condition» FLOAT, «beat_type» STRING, «chp_beat_type» STRING, «city_division_lapd» STRING, «chp_beat_class» STRING, «beat_number» STRING, «primary_road» STRING, «secondary_road» STRING, «distance» FLOAT, «direction» STRING, «intersection» FLOAT, «weather_1» STRING, «weather_2» STRING, «state_highway_indicator» FLOAT, «caltrans_county» STRING, «caltrans_district» FLOAT, «state_route» FLOAT, «route_suffix» STRING, «postmile_prefix» STRING, «postmile» FLOAT, «location_type» STRING, «ramp_intersection» STRING, «side_of_highway» STRING, «tow_away» FLOAT, «collision_severity» STRING, «killed_victims» FLOAT, «injured_victims» FLOAT, «party_count» FLOAT, «primary_collision_factor» STRING, «pcf_violation_code» STRING, «pcf_violation_category» STRING, «pcf_violation» FLOAT, «pcf_violation_subsection» STRING, «hit_and_run» STRING, «type_of_collision» STRING, «motor_vehicle_involved_with» STRING, «pedestrian_action» STRING, «road_surface» STRING, «road_condition_1» STRING, «road_condition_2» STRING, «lighting» STRING, «control_device» STRING, «chp_road_type» STRING, «pedestrian_collision» INT, «bicycle_collision» INT, «motorcycle_collision» INT, «truck_collision» INT, «not_private_property» FLOAT, «alcohol_involved» FLOAT, «statewide_vehicle_type_at_fault» STRING, «chp_vehicle_type_at_fault» STRING, «severe_injury_count» INT, «other_visible_injury_count» INT, «complaint_of_pain_injury_count» INT, «pedestrian_killed_count» INT, «pedestrian_injured_count» INT, «bicyclist_killed_count» INT, «bicyclist_injured_count» INT, «motorcyclist_killed_count» INT, «motorcyclist_injured_count» FLOAT, «primary_ramp» STRING, «secondary_ramp» STRING, «latitude» FLOAT, «longitude» FLOAT, «collision_date» STRING, «collision_time» STRING, «process_date» STRING)

HYPOTHESIS hyp0_1_0 : COLLISIONS "LEFT(\"collision_date\", 4) = '2021'"
HYPOTHESIS hyp0_1_1 : COLLISIONS "LEFT(\"collision_date\", 4) IN ('2011', '2021')"
theorem eq_0_1 (t : TableRel COLLISIONS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) :
    (sql%([COLLISIONS_schema]) "WITH most_common_2021 AS (\n  SELECT \"pcf_violation_category\"\n  FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n  WHERE LEFT(\"collision_date\", 4) = '2021'\n  GROUP BY \"pcf_violation_category\"\n  ORDER BY COUNT(*) DESC\n  LIMIT 1\n),\nyearly_shares AS (\n  SELECT \n    CAST(LEFT(\"collision_date\", 4) AS INT) AS COLLISION_YEAR,\n    COUNT(CASE WHEN \"pcf_violation_category\" = (SELECT \"pcf_violation_category\" FROM most_common_2021) THEN 1 END) * 100.0 / COUNT(*) AS PERCENTAGE_SHARE\n  FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n  WHERE LEFT(\"collision_date\", 4) IN ('2011', '2021')\n  GROUP BY LEFT(\"collision_date\", 4)\n)\nSELECT \n  MAX(CASE WHEN COLLISION_YEAR = 2011 THEN PERCENTAGE_SHARE END) - MAX(CASE WHEN COLLISION_YEAR = 2021 THEN PERCENTAGE_SHARE END)\nFROM yearly_shares;") t ~= (sql%([COLLISIONS_schema]) "WITH yearly_counts AS (\n    SELECT\n        LEFT(\"collision_date\", 4) AS COLLISION_YEAR,\n        \"pcf_violation_category\",\n        COUNT(*) AS category_count\n    FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n    WHERE LEFT(\"collision_date\", 4) IN ('2011', '2021')\n    GROUP BY LEFT(\"collision_date\", 4), \"pcf_violation_category\"\n),\nyearly_totals AS (\n    SELECT\n        COLLISION_YEAR,\n        SUM(category_count) AS total_count\n    FROM yearly_counts\n    GROUP BY COLLISION_YEAR\n),\npercentage_shares AS (\n    SELECT\n        yc.COLLISION_YEAR::INT AS COLLISION_YEAR,\n        yc.\"pcf_violation_category\",\n        100.0 * yc.category_count / yt.total_count AS PERCENTAGE_SHARE\n    FROM yearly_counts yc\n    JOIN yearly_totals yt ON yc.COLLISION_YEAR = yt.COLLISION_YEAR\n),\nmost_common_2021 AS (\n    SELECT \"pcf_violation_category\"\n    FROM percentage_shares\n    WHERE COLLISION_YEAR = 2021\n    ORDER BY PERCENTAGE_SHARE DESC\n    LIMIT 1\n)\nSELECT\n    MAX(CASE WHEN COLLISION_YEAR = 2011 THEN PERCENTAGE_SHARE END) -\n    MAX(CASE WHEN COLLISION_YEAR = 2021 THEN PERCENTAGE_SHARE END)\nFROM percentage_shares ps\nJOIN most_common_2021 mc ON ps.\"pcf_violation_category\" = mc.\"pcf_violation_category\"\nWHERE ps.COLLISION_YEAR IN (2011, 2021);") t := by
  first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([COLLISIONS_schema]) "WITH most_common_2021 AS (\n  SELECT \"pcf_violation_category\"\n  FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n  WHERE LEFT(\"collision_date\", 4) = '2021'\n  GROUP BY \"pcf_violation_category\"\n  ORDER BY COUNT(*) DESC\n  LIMIT 1\n),\nyearly_shares AS (\n  SELECT \n    CAST(LEFT(\"collision_date\", 4) AS INT) AS COLLISION_YEAR,\n    COUNT(CASE WHEN \"pcf_violation_category\" = (SELECT \"pcf_violation_category\" FROM most_common_2021) THEN 1 END) * 100.0 / COUNT(*) AS PERCENTAGE_SHARE\n  FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n  WHERE LEFT(\"collision_date\", 4) IN ('2011', '2021')\n  GROUP BY LEFT(\"collision_date\", 4)\n)\nSELECT \n  MAX(CASE WHEN COLLISION_YEAR = 2011 THEN PERCENTAGE_SHARE END) - MAX(CASE WHEN COLLISION_YEAR = 2021 THEN PERCENTAGE_SHARE END)\nFROM yearly_shares;" = sql%([COLLISIONS_schema]) "WITH top_category AS (\n    SELECT \"pcf_violation_category\"\n    FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n    WHERE LEFT(\"collision_date\", 4) = '2021'\n    GROUP BY \"pcf_violation_category\"\n    ORDER BY COUNT(*) DESC\n    LIMIT 1\n),\nyearly_counts AS (\n    SELECT\n        CAST(LEFT(c.\"collision_date\", 4) AS INTEGER) AS COLLISION_YEAR,\n        COUNT(*) AS category_count\n    FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\" c\n    JOIN top_category t ON c.\"pcf_violation_category\" = t.\"pcf_violation_category\"\n    WHERE LEFT(c.\"collision_date\", 4) IN ('2011', '2021')\n    GROUP BY LEFT(c.\"collision_date\", 4)\n),\nyearly_totals AS (\n    SELECT\n        CAST(LEFT(\"collision_date\", 4) AS INTEGER) AS COLLISION_YEAR,\n        COUNT(*) AS total_count\n    FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n    WHERE LEFT(\"collision_date\", 4) IN ('2011', '2021')\n    GROUP BY LEFT(\"collision_date\", 4)\n),\nshares AS (\n    SELECT\n        yc.COLLISION_YEAR,\n        ROUND(yc.category_count * 100.0 / yt.total_count, 2) AS PERCENTAGE_SHARE\n    FROM yearly_counts yc\n    JOIN yearly_totals yt ON yc.COLLISION_YEAR = yt.COLLISION_YEAR\n)\nSELECT\n    MAX(CASE WHEN COLLISION_YEAR = 2011 THEN PERCENTAGE_SHARE END) - MAX(CASE WHEN COLLISION_YEAR = 2021 THEN PERCENTAGE_SHARE END)\nFROM shares;" := by
  first | sql_equiv | sorry

