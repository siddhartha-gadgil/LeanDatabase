    (sql%([GHCND_2016_schema, GHCND_STATIONS_schema, CITIBIKE_TRIPS_schema]) "WITH nearest_station AS (\n  -- Find the nearest GHCN station within 50km of NYC (40.7128, -74.0060)\n  -- that has valid PRCP data in 2016\n  SELECT s.\"id\"\n  FROM \"NEW_YORK_GHCN\".\"GHCN_D\".\"GHCND_STATIONS\" s\n  WHERE s.\"id\" IN (\n    SELECT DISTINCT \"id\"\n    FROM \"NEW_YORK_GHCN\".\"GHCN_D\".\"GHCND_2016\"\n    WHERE \"element\" = 'PRCP'\n      AND (\"qflag\" IS NULL OR \"qflag\" = '')\n  )\n  AND HAVERSINE(40.7128, -74.0060, s.\"latitude\", s.\"longitude\") < 50\n  ORDER BY HAVERSINE(40.7128, -74.0060, s.\"latitude\", s.\"longitude\")\n  LIMIT 1\n),\nweather AS (\n  -- Classify each day as rainy (>5mm) or non-rainy\n  SELECT\n    g.\"date\",\n    CASE\n      WHEN g.\"value\" / 10.0 > 5 THEN 'rainy'\n      ELSE 'non-rainy'\n    END AS RAIN_STATUS\n  FROM \"NEW_YORK_GHCN\".\"GHCN_D\".\"GHCND_2016\" g\n  WHERE g.\"id\" = (SELECT \"id\" FROM nearest_station)\n    AND g.\"element\" = 'PRCP'\n    AND (g.\"qflag\" IS NULL OR g.\"qflag\" = '')\n),\ndaily_trips AS (\n  -- Count daily Citibike trips in 2016\n  SELECT\n    DATE(TO_TIMESTAMP(\"starttime\", 6)) AS trip_date,\n    COUNT(*) AS num_trips\n  FROM \"NEW_YORK_GHCN\".\"NEW_YORK\".\"CITIBIKE_TRIPS\"\n  WHERE YEAR(TO_TIMESTAMP(\"starttime\", 6)) = 2016\n  GROUP BY trip_date\n)\nSELECT\n  w.RAIN_STATUS,\n  AVG(dt.num_trips) AS AVG_DAILY_TRIPS\nFROM weather w\nJOIN daily_trips dt ON w.\"date\" = dt.trip_date\nGROUP BY w.RAIN_STATUS\nORDER BY w.RAIN_STATUS;") t ~= (sql%([GHCND_2016_schema, GHCND_STATIONS_schema, CITIBIKE_TRIPS_schema]) "WITH nearest_station AS (\n  SELECT \"id\",\n    2 * 6371 * ASIN(SQRT(\n      POWER(SIN(RADIANS(\"latitude\" - 40.7128)/2), 2) +\n      COS(RADIANS(40.7128)) * COS(RADIANS(\"latitude\")) *\n      POWER(SIN(RADIANS(\"longitude\" - (-74.0060))/2), 2)\n    )) AS dist_km\n  FROM \"NEW_YORK_GHCN\".\"GHCN_D\".\"GHCND_STATIONS\"\n  HAVING dist_km < 50\n  ORDER BY dist_km ASC\n),\nstations_with_data AS (\n  SELECT ns.\"id\", ns.dist_km\n  FROM nearest_station ns\n  WHERE EXISTS (\n    SELECT 1 FROM \"NEW_YORK_GHCN\".\"GHCN_D\".\"GHCND_2016\" g\n    WHERE g.\"id\" = ns.\"id\"\n      AND g.\"element\" = 'PRCP'\n      AND (g.\"qflag\" IS NULL OR g.\"qflag\" = '')\n  )\n  ORDER BY ns.dist_km ASC\n  LIMIT 1\n),\nweather AS (\n  SELECT g.\"date\", SUM(g.\"value\") / 10.0 AS prcp_mm\n  FROM \"NEW_YORK_GHCN\".\"GHCN_D\".\"GHCND_2016\" g\n  JOIN stations_with_data s ON g.\"id\" = s.\"id\"\n  WHERE g.\"element\" = 'PRCP'\n    AND (g.\"qflag\" IS NULL OR g.\"qflag\" = '')\n  GROUP BY g.\"date\"\n),\ndaily_trips AS (\n  SELECT TO_TIMESTAMP(\"starttime\"/1000000)::DATE AS trip_date,\n         COUNT(*) AS num_trips\n  FROM \"NEW_YORK_GHCN\".\"NEW_YORK\".\"CITIBIKE_TRIPS\"\n  WHERE TO_TIMESTAMP(\"starttime\"/1000000) >= '2016-01-01'\n    AND TO_TIMESTAMP(\"starttime\"/1000000) < '2017-01-01'\n  GROUP BY trip_date\n)\nSELECT \n  CASE WHEN w.prcp_mm > 5 THEN 'rainy' ELSE 'non-rainy' END AS rain_status,\n  ROUND(AVG(dt.num_trips), 6) AS avg_daily_trips\nFROM daily_trips dt\nJOIN weather w ON dt.trip_date = w.\"date\"\nGROUP BY rain_status\nORDER BY rain_status DESC;") t := by
