import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq124_eq_1_3

CREATE TABLE PATIENT («active» BOOL, «animal» STRING, «contact» STRING, «generalPractitioner» STRING, «implicitRules» STRING, «language» STRING, «link» STRING, «managingOrganization» STRING, «photo» STRING, «birthPlace» STRING, «disability_adjusted_life_years» STRING, «patient_mothersMaidenName» STRING, «quality_adjusted_life_years» STRING, «shr_actor_FictionalPerson_extension» STRING, «shr_demographics_SocialSecurityNumber_extension» STRING, «shr_entity_FathersName_extension» STRING, «shr_entity_Person_extension» STRING, «us_core_birthsex» STRING, «us_core_ethnicity» STRING, «us_core_race» STRING, «address» STRING, «birthDate» STRING, «communication» STRING, «deceased» STRING, «gender» STRING, «id» STRING, «identifier» STRING, «maritalStatus» STRING, «meta» STRING, «multipleBirth» STRING, «name» STRING, «telecom» STRING, «text» STRING)
CREATE TABLE CONDITION («asserter» STRING, «bodySite» STRING, «evidence» STRING, «identifier» STRING, «implicitRules» STRING, «language» STRING, «note» STRING, «severity» STRING, «stage» STRING, «text» STRING, «abatement» STRING, «assertedDate» STRING, «category» STRING, «clinicalStatus» STRING, «code» STRING, «context» STRING, «id» STRING, «meta» STRING, «onset» STRING, «subject» STRING, «verificationStatus» STRING)
CREATE TABLE MEDICATION_REQUEST («basedOn» STRING, «category» STRING, «definition» STRING, «detectedIssue» STRING, «dispenseRequest» STRING, «eventHistory» STRING, «groupIdentifier» STRING, «identifier» STRING, «implicitRules» STRING, «language» STRING, «note» STRING, «priorPrescription» STRING, «priority» STRING, «reasonCode» STRING, «recorder» STRING, «substitution» STRING, «supportingInformation» STRING, «text» STRING, «shr_action_RequestedContext_extension» STRING, «shr_base_ActionCode_extension» STRING, «authoredOn» STRING, «context» STRING, «dosageInstruction» STRING, «id» STRING, «intent» STRING, «medication» STRING, «meta» STRING, «reasonReference» STRING, «requester» STRING, «status» STRING, «subject» STRING)

theorem eq (t0 : TableRel PATIENT_schema) (t1 : TableRel CONDITION_schema) (t2 : TableRel MEDICATION_REQUEST_schema) :
    (sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "SELECT COUNT(*) AS OUTPUT FROM (SELECT CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" AS mr JOIN \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" AS p ON p.\"id\" = CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) WHERE JSON_EXTRACT_PATH(p.\"deceased\", 'dateTime') IS NULL AND CAST(mr.\"status\" AS TEXT) = 'active' AND EXISTS(SELECT 1 FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" AS c WHERE CAST(JSON_EXTRACT_PATH(c.\"subject\", 'patientId') AS TEXT) = CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) AND CAST(JSON_EXTRACT_PATH(c.\"code\", 'coding', '0', 'display') AS TEXT) IN ('Diabetes', 'Hypertension')) GROUP BY CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) HAVING COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(mr.\"medication\", 'codeableConcept', 'coding', '0', 'code') AS TEXT)) >= 7)") t0 t1 t2
  = (sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "/* Count alive patients with Diabetes or Hypertension diagnosis */ /* and at least 7 distinct active medications */ SELECT COUNT(*) AS OUTPUT FROM (/* Get patients who are alive, have diabetes/hypertension, and >= 7 distinct active meds */ SELECT CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" AS mr /* Join to patient to check alive status */ INNER JOIN \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" AS p ON CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) = p.\"id\" /* Join to condition to check diabetes/hypertension */ INNER JOIN (SELECT DISTINCT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" WHERE LOWER(CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'display') AS TEXT)) LIKE '%diabetes%' OR LOWER(CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'display') AS TEXT)) LIKE '%hypertension%') AS c ON CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) = c.patient_id WHERE JSON_EXTRACT_PATH(p.\"deceased\", 'dateTime') IS NULL AND mr.\"status\" = 'active' GROUP BY CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) HAVING COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(mr.\"medication\", 'codeableConcept', 'coding', '0', 'display') AS TEXT)) >= 7) AS subq") t0 t1 t2
  := by first | sql_equiv | sorry

end N_sf_bq124_eq_1_3
