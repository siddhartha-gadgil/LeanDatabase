/-!
# sf_bq103 — crossskill equivalence(s)

Question: Generate summary statistics on genetic variants in the region between positions 55039447 and 55064852 on chromosome 1. This includes the number of variants, the total allele count, the total number of alleles, and distinct gene symbols (using Variant Effect Predictor, VEP, for gene annotation). Additionally, compute the density of mutations by dividing the length of the region by the number of variants. Using data from the gnomAD v3 version.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq103

CREATE TABLE V3_GENOMES__CHR1 («reference_name» STRING, «start_position» INT, «end_position» INT, «reference_bases» STRING, «alternate_bases» STRING, «names» STRING, «quality» FLOAT, «filter» STRING, «call» STRING, «AN» INT, «non_par» BOOL, «lcr» BOOL, «variant_type» STRING, «ReadPosRankSum» FLOAT, «MQRankSum» FLOAT, «RAW_MQ» FLOAT, «DP» INT, «MQ_DP» INT, «VarDP» INT, «MQ» FLOAT, «QD» FLOAT, «FS» FLOAT, «SB» STRING, «InbreedingCoeff» FLOAT, «AS_VQSLOD» FLOAT, «NEGATIVE_TRAIN_SITE» BOOL, «POSITIVE_TRAIN_SITE» BOOL, «culprit» STRING, «SOR» FLOAT, «AN_asj_female» INT, «AN_eas_female» INT, «AN_afr_male» INT, «AN_female» INT, «AN_fin_male» INT, «AN_oth_female» INT, «AN_ami» INT, «AN_oth» INT, «AN_male» INT, «AN_ami_female» INT, «AN_afr» INT, «AN_eas_male» INT, «AN_sas» INT, «AN_nfe_female» INT, «AN_asj_male» INT, «AN_raw» INT, «AN_oth_male» INT, «AN_nfe_male» INT, «AN_asj» INT, «AN_amr_male» INT, «AN_amr_female» INT, «AN_sas_female» INT, «AN_fin» INT, «AN_afr_female» INT, «AN_sas_male» INT, «AN_amr» INT, «AN_nfe» INT, «AN_eas» INT, «AN_ami_male» INT, «AN_fin_female» INT, «faf95_adj» FLOAT, «faf99_adj» FLOAT)

theorem eq_0_1 : ∀ t,
    (sql%([V3_GENOMES__CHR1_schema]) "WITH variant_stats AS (\n  SELECT\n    COUNT(*) AS num_variants,\n    SUM(alt.value:\"AC\"::INT) AS sum_ac,\n    SUM(\"AN\"::INT) AS sum_an\n  FROM \"GNOMAD\".\"GNOMAD\".\"V3_GENOMES__CHR1\",\n  LATERAL FLATTEN(input => \"alternate_bases\") alt\n  WHERE \"start_position\" BETWEEN 55039447 AND 55064852\n),\ngene_symbols AS (\n  SELECT DISTINCT vep.value:\"SYMBOL\"::STRING AS gene_symbol\n  FROM \"GNOMAD\".\"GNOMAD\".\"V3_GENOMES__CHR1\",\n  LATERAL FLATTEN(input => \"alternate_bases\") alt,\n  LATERAL FLATTEN(input => alt.value:\"vep\") vep\n  WHERE \"start_position\" BETWEEN 55039447 AND 55064852\n    AND vep.value:\"SYMBOL\"::STRING IS NOT NULL\n    AND vep.value:\"SYMBOL\"::STRING != 'None'\n)\nSELECT\n  ROUND((55064852 - 55039447) / vs.num_variants::FLOAT, 3) AS BURDEN_OF_MUTATION,\n  vs.num_variants AS NUM_VARIANTS,\n  vs.sum_ac AS SUM_AC,\n  vs.sum_an AS SUM_AN,\n  (SELECT LISTAGG(gene_symbol, ', ') WITHIN GROUP (ORDER BY gene_symbol) FROM gene_symbols) AS GENES\nFROM variant_stats vs;") t ~= (sql%([V3_GENOMES__CHR1_schema]) "WITH variant_data AS (\n  SELECT\n    t.\"start_position\",\n    t.\"AN\",\n    f.value:\"AC\"::INTEGER AS \"AC\",\n    f.value:\"vep\" AS vep_array\n  FROM \"GNOMAD\".\"GNOMAD\".\"V3_GENOMES__CHR1\" t,\n  LATERAL FLATTEN(input => t.\"alternate_bases\") f\n  WHERE t.\"start_position\" BETWEEN 55039447 AND 55064852\n),\ngene_symbols AS (\n  SELECT DISTINCT v.value:\"SYMBOL\"::STRING AS gene_symbol\n  FROM variant_data vd,\n  LATERAL FLATTEN(input => vd.vep_array) v\n  WHERE v.value:\"SYMBOL\"::STRING IS NOT NULL\n),\naggregated AS (\n  SELECT\n    COUNT(*) AS \"NUM_VARIANTS\",\n    SUM(\"AC\") AS \"SUM_AC\",\n    SUM(\"AN\") AS \"SUM_AN\"\n  FROM variant_data\n)\nSELECT\n  ROUND((55064852 - 55039447)::FLOAT / a.\"NUM_VARIANTS\", 3) AS \"BURDEN_OF_MUTATION\",\n  a.\"NUM_VARIANTS\",\n  a.\"SUM_AC\",\n  a.\"SUM_AN\",\n  (SELECT LISTAGG(gene_symbol, ', ') WITHIN GROUP (ORDER BY gene_symbol) FROM gene_symbols) AS \"GENES\"\nFROM aggregated a;") t := by
  intro t; first | sql_equiv | sorry

