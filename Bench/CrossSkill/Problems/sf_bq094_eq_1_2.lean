theorem eq (t0 : TableRel COMMITTEE_2016_schema) (t1 : TableRel CANDIDATE_2016_schema) (t2 : TableRel CANDIDATE_COMMITTEE_2016_schema) (t3 : TableRel INDIVIDUALS_2016_schema) :
    (sql%([COMMITTEE_2016_schema, CANDIDATE_2016_schema, CANDIDATE_COMMITTEE_2016_schema, INDIVIDUALS_2016_schema]) "WITH small_donations AS (SELECT T4.\"cmte_id\", SUM(T4.\"transaction_amt\") AS TOTAL_SMALL_DONATIONS FROM \"FEC\".\"FEC\".\"INDIVIDUALS_2016\" AS T4 WHERE T4.\"transaction_amt\" > 0 AND T4.\"transaction_amt\" < 200 GROUP BY T4.\"cmte_id\" HAVING SUM(T4.\"transaction_amt\") > 0 AND SUM(T4.\"transaction_amt\") < 200) SELECT T3.\"cmte_nm\", COUNT(DISTINCT T1.\"cand_id\") AS \"COUNT(DISTINCT T1.\"\"CAND_ID\"\")\", STRING_AGG(DISTINCT T2.\"cand_name\", ', ' ORDER BY T2.\"cand_name\") AS \"LISTAGG(DISTINCT T2.\"\"CAND_NAME\"\", ', ') WITHIN GROUP (ORDER BY T2.\"\"CAND_NAME\"\")\", sd.TOTAL_SMALL_DONATIONS FROM \"FEC\".\"FEC\".\"CANDIDATE_COMMITTEE_2016\" AS T1 LEFT JOIN \"FEC\".\"FEC\".\"CANDIDATE_2016\" AS T2 ON T1.\"cand_id\" = T2.\"cand_id\" INNER JOIN \"FEC\".\"FEC\".\"COMMITTEE_2016\" AS T3 ON T1.\"cmte_id\" = T3.\"cmte_id\" INNER JOIN small_donations AS sd ON T3.\"cmte_id\" = sd.\"cmte_id\" GROUP BY T3.\"cmte_nm\", sd.TOTAL_SMALL_DONATIONS ORDER BY T3.\"cmte_nm\"") t0 t1 t2 t3
