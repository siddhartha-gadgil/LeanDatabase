import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq451 — crossskill equivalence(s)

Question: Extract genotype data for single nucleotide polymorphisms (SNPs) on chromosome X, excluding positions where the `start` value is between 59999 and 2699519 or between 154931042 and 155260559. For each sample, identify genotype calls where the genotype array has at least one allele. Classify each genotype call into one of the following categories: homozygous reference alleles (both alleles are 0), homozygous alternate alleles (both alleles are the same and greater than 0), or heterozygous alleles (alleles are different, or any allele is null, and at least one allele is greater than 0). Compute the total number of callable sites (the sum of all three genotype categories), the number of homozygous reference, homozygous alternate, and heterozygous genotype calls, the total number of single nucleotide variants (SNVs) as the sum of homozygous alternate and heterozygous genotype calls, the percentage of heterozygous genotype calls among all SNVs, and the percentage of homozygous alternate genotype calls among all SNVs. Output the sample ID along with these computed counts and percentages, and order the results by the percentage of heterozygous genotype calls among SNVs in descending order, then by sample ID.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq451

CREATE TABLE VARIANTS («reference_name» STRING, «start» INT, «end» INT, «reference_bases» STRING, «alternate_bases» STRING, «quality» FLOAT, «filter» STRING, «names» STRING, «call» STRING, «AA» STRING, «AC» STRING, «AC1» INT, «AF» FLOAT, «AF1» FLOAT, «AFR_AF» FLOAT, «AMR_AF» FLOAT, «AN» INT, «ASN_AF» FLOAT, «AVGPOST» FLOAT, «CIEND» STRING, «CIPOS» STRING, «DP» INT, «DP4» STRING, «ERATE» FLOAT, «EUR_AF» FLOAT, «FQ» FLOAT, «G3» STRING, «HOMLEN» INT, «HOMSEQ» STRING, «HWE» FLOAT, «LDAF» FLOAT, «MQ» INT, «PV4» STRING, «RSQ» FLOAT, «SNPSOURCE» STRING, «SOURCE» STRING, «SVLEN» INT, «SVTYPE» STRING, «THETA» FLOAT, «VT» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([VARIANTS_schema]) "WITH genotype_calls AS (\n  SELECT\n    c.value['call_set_name']::STRING AS call_set_name,\n    c.value['genotype'][0]::INT AS allele0,\n    c.value['genotype'][1]::INT AS allele1\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  WHERE v.\"reference_name\" = 'X'\n    AND v.\"VT\" = 'SNP'\n    AND NOT (v.\"start\" BETWEEN 59999 AND 2699519)\n    AND NOT (v.\"start\" BETWEEN 154931042 AND 155260559)\n    AND ARRAY_SIZE(c.value['genotype']) >= 2\n),\nclassified AS (\n  SELECT\n    call_set_name,\n    CASE\n      WHEN allele0 = 0 AND allele1 = 0 THEN 'hom_ref'\n      WHEN allele0 = allele1 AND allele0 > 0 THEN 'hom_alt'\n      WHEN allele0 != allele1 AND (allele0 > 0 OR allele1 > 0) THEN 'het'\n      ELSE 'other'\n    END AS genotype_class\n  FROM genotype_calls\n),\naggregated AS (\n  SELECT\n    call_set_name AS CALL_SET_NAME,\n    COUNT(*) AS TOTAL_CALLABLE_SITES,\n    SUM(CASE WHEN genotype_class = 'hom_ref' THEN 1 ELSE 0 END) AS HOMOZYGOUS_REFERENCE_COUNT,\n    SUM(CASE WHEN genotype_class = 'hom_alt' THEN 1 ELSE 0 END) AS HOMOZYGOUS_ALTERNATE_COUNT,\n    SUM(CASE WHEN genotype_class = 'het' THEN 1 ELSE 0 END) AS HETEROZYGOUS_COUNT,\n    SUM(CASE WHEN genotype_class IN ('hom_alt', 'het') THEN 1 ELSE 0 END) AS TOTAL_SNVS,\n    ROUND(\n      SUM(CASE WHEN genotype_class = 'het' THEN 1 ELSE 0 END) * 100.0 /\n      NULLIF(SUM(CASE WHEN genotype_class IN ('hom_alt', 'het') THEN 1 ELSE 0 END), 0),\n      2\n    ) AS PERCENTAGE_HETEROZYGOUS_AMONG_SNVS,\n    ROUND(\n      SUM(CASE WHEN genotype_class = 'hom_alt' THEN 1 ELSE 0 END) * 100.0 /\n      NULLIF(SUM(CASE WHEN genotype_class IN ('hom_alt', 'het') THEN 1 ELSE 0 END), 0),\n      2\n    ) AS PERCENTAGE_HOMOZYGOUS_ALTERNATE_AMONG_SNVS\n  FROM classified\n  GROUP BY call_set_name\n)\nSELECT *\nFROM aggregated\nORDER BY PERCENTAGE_HETEROZYGOUS_AMONG_SNVS DESC, CALL_SET_NAME ASC;") t ~= (sql%([VARIANTS_schema]) "SELECT\n  c.value:call_set_name::STRING AS CALL_SET_NAME,\n  COUNT(*) AS TOTAL_CALLABLE_SITES,\n  SUM(CASE \n    WHEN c.value:genotype[0]::INT = 0 AND c.value:genotype[1]::INT = 0 \n    THEN 1 ELSE 0 \n  END) AS HOMOZYGOUS_REFERENCE_COUNT,\n  SUM(CASE \n    WHEN c.value:genotype[0]::INT > 0 AND c.value:genotype[0]::INT = c.value:genotype[1]::INT \n    THEN 1 ELSE 0 \n  END) AS HOMOZYGOUS_ALTERNATE_COUNT,\n  SUM(CASE \n    WHEN c.value:genotype[0]::INT != c.value:genotype[1]::INT \n    THEN 1 ELSE 0 \n  END) AS HETEROZYGOUS_COUNT,\n  SUM(CASE \n    WHEN c.value:genotype[0]::INT > 0 AND c.value:genotype[0]::INT = c.value:genotype[1]::INT \n    THEN 1 ELSE 0 \n  END) + SUM(CASE \n    WHEN c.value:genotype[0]::INT != c.value:genotype[1]::INT \n    THEN 1 ELSE 0 \n  END) AS TOTAL_SNVS,\n  ROUND(\n    SUM(CASE WHEN c.value:genotype[0]::INT != c.value:genotype[1]::INT THEN 1 ELSE 0 END) * 100.0 /\n    NULLIF(\n      SUM(CASE WHEN c.value:genotype[0]::INT > 0 AND c.value:genotype[0]::INT = c.value:genotype[1]::INT THEN 1 ELSE 0 END) +\n      SUM(CASE WHEN c.value:genotype[0]::INT != c.value:genotype[1]::INT THEN 1 ELSE 0 END),\n      0\n    ),\n    2\n  ) AS PERCENTAGE_HETEROZYGOUS_AMONG_SNVS,\n  ROUND(\n    SUM(CASE WHEN c.value:genotype[0]::INT > 0 AND c.value:genotype[0]::INT = c.value:genotype[1]::INT THEN 1 ELSE 0 END) * 100.0 /\n    NULLIF(\n      SUM(CASE WHEN c.value:genotype[0]::INT > 0 AND c.value:genotype[0]::INT = c.value:genotype[1]::INT THEN 1 ELSE 0 END) +\n      SUM(CASE WHEN c.value:genotype[0]::INT != c.value:genotype[1]::INT THEN 1 ELSE 0 END),\n      0\n    ),\n    2\n  ) AS PERCENTAGE_HOMOZYGOUS_ALTERNATE_AMONG_SNVS\nFROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\nLATERAL FLATTEN(input => v.\"call\") c\nWHERE v.\"reference_name\" = 'X'\n  AND v.\"VT\" = 'SNP'\n  AND NOT (v.\"start\" BETWEEN 59999 AND 2699519)\n  AND NOT (v.\"start\" BETWEEN 154931043 AND 155260559)\n  AND ARRAY_SIZE(c.value:genotype) = 2\nGROUP BY c.value:call_set_name::STRING\nORDER BY PERCENTAGE_HETEROZYGOUS_AMONG_SNVS DESC;") t := by
  intro t; first | sql_equiv | sorry

