theorem eq_0_3 :
    sql%([VARIANTS_schema]) "WITH genotype_calls AS (\n  SELECT\n    c.value['call_set_name']::STRING AS call_set_name,\n    c.value['genotype'][0]::INT AS allele0,\n    c.value['genotype'][1]::INT AS allele1\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  WHERE v.\"reference_name\" = 'X'\n    AND v.\"VT\" = 'SNP'\n    AND NOT (v.\"start\" BETWEEN 59999 AND 2699519)\n    AND NOT (v.\"start\" BETWEEN 154931042 AND 155260559)\n    AND ARRAY_SIZE(c.value['genotype']) >= 2\n),\nclassified AS (\n  SELECT\n    call_set_name,\n    CASE\n      WHEN allele0 = 0 AND allele1 = 0 THEN 'hom_ref'\n      WHEN allele0 = allele1 AND allele0 > 0 THEN 'hom_alt'\n      WHEN allele0 != allele1 AND (allele0 > 0 OR allele1 > 0) THEN 'het'\n      ELSE 'other'\n    END AS genotype_class\n  FROM genotype_calls\n),\naggregated AS (\n  SELECT\n    call_set_name AS CALL_SET_NAME,\n    COUNT(*) AS TOTAL_CALLABLE_SITES,\n    SUM(CASE WHEN genotype_class = 'hom_ref' THEN 1 ELSE 0 END) AS HOMOZYGOUS_REFERENCE_COUNT,\n    SUM(CASE WHEN genotype_class = 'hom_alt' THEN 1 ELSE 0 END) AS HOMOZYGOUS_ALTERNATE_COUNT,\n    SUM(CASE WHEN genotype_class = 'het' THEN 1 ELSE 0 END) AS HETEROZYGOUS_COUNT,\n    SUM(CASE WHEN genotype_class IN ('hom_alt', 'het') THEN 1 ELSE 0 END) AS TOTAL_SNVS,\n    ROUND(\n      SUM(CASE WHEN genotype_class = 'het' THEN 1 ELSE 0 END) * 100.0 /\n      NULLIF(SUM(CASE WHEN genotype_class IN ('hom_alt', 'het') THEN 1 ELSE 0 END), 0),\n      2\n    ) AS PERCENTAGE_HETEROZYGOUS_AMONG_SNVS,\n    ROUND(\n      SUM(CASE WHEN genotype_class = 'hom_alt' THEN 1 ELSE 0 END) * 100.0 /\n      NULLIF(SUM(CASE WHEN genotype_class IN ('hom_alt', 'het') THEN 1 ELSE 0 END), 0),\n      2\n    ) AS PERCENTAGE_HOMOZYGOUS_ALTERNATE_AMONG_SNVS\n  FROM classified\n  GROUP BY call_set_name\n)\nSELECT *\nFROM aggregated\nORDER BY PERCENTAGE_HETEROZYGOUS_AMONG_SNVS DESC, CALL_SET_NAME ASC;" = sql%([VARIANTS_schema]) "WITH variant_calls AS (\n  SELECT\n    f.value:\"call_set_name\"::STRING AS call_set_name,\n    f.value:\"genotype\"[0]::INT AS allele0,\n    f.value:\"genotype\"[1]::INT AS allele1\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") f\n  WHERE v.\"reference_name\" = 'X'\n    AND v.\"VT\" = 'SNP'\n    AND NOT (v.\"start\" BETWEEN 59999 AND 2699519)\n    AND NOT (v.\"start\" BETWEEN 154931042 AND 155260559)\n),\nsample_stats AS (\n  SELECT\n    call_set_name,\n    COUNT(*) AS total_callable_sites,\n    SUM(CASE WHEN allele0 = 0 AND allele1 = 0 THEN 1 ELSE 0 END) AS homozygous_reference_count,\n    SUM(CASE WHEN allele0 > 0 AND allele1 > 0 AND allele0 = allele1 THEN 1 ELSE 0 END) AS homozygous_alternate_count,\n    SUM(CASE WHEN allele0 != allele1 THEN 1 ELSE 0 END) AS heterozygous_count\n  FROM variant_calls\n  GROUP BY call_set_name\n)\nSELECT\n  call_set_name AS CALL_SET_NAME,\n  total_callable_sites AS TOTAL_CALLABLE_SITES,\n  homozygous_reference_count AS HOMOZYGOUS_REFERENCE_COUNT,\n  homozygous_alternate_count AS HOMOZYGOUS_ALTERNATE_COUNT,\n  heterozygous_count AS HETEROZYGOUS_COUNT,\n  (homozygous_alternate_count + heterozygous_count) AS TOTAL_SNVS,\n  ROUND(heterozygous_count * 100.0 / (homozygous_alternate_count + heterozygous_count), 2) AS PERCENTAGE_HETEROZYGOUS_AMONG_SNVS,\n  ROUND(homozygous_alternate_count * 100.0 / (homozygous_alternate_count + heterozygous_count), 2) AS PERCENTAGE_HOMOZYGOUS_ALTERNATE_AMONG_SNVS\nFROM sample_stats\nWHERE (homozygous_alternate_count + heterozygous_count) > 0\nORDER BY PERCENTAGE_HETEROZYGOUS_AMONG_SNVS DESC, CALL_SET_NAME ASC;" := by
  first | sql_equiv | sorry

