 \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180910\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180911\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180912\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180913\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180914\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180915\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180916\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180917\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180918\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180919\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180920\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180921\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180922\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180923\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180924\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180925\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180926\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180927\"\n    UNION ALL\n    SELECT \"event_timestamp\", \"user_pseudo_id\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180928\"\n),\nactivity_with_day AS (\n    SELECT \n        a.\"user_pseudo_id\",\n        DATEDIFF('day', c.first_open_date, \n            TO_DATE(TO_VARCHAR(CONVERT_TIMEZONE('UTC', 'Asia/Shanghai', TO_TIMESTAMP(a.\"event_timestamp\"/1000000)), 'YYYY-MM-DD'))\n        ) AS days_since_first_open\n    FROM all_activity a\n    INNER JOIN cohort c ON a.\"user_pseudo_id\" = c.\"user_pseudo_id\"\n),\nretention_flags AS (\n    SELECT \n        \"user_pseudo_id\",\n        MAX(CASE WHEN days_since_first_open BETWEEN 1 AND 7 THEN 1 ELSE 0 END) AS retained_week1,\n        MAX(CASE WHEN days_since_first_open BETWEEN 8 AND 14 THEN 1 ELSE 0 END) AS retained_week2,\n        MAX(CASE WHEN days_since_first_open BETWEEN 15 AND 21 THEN 1 ELSE 0 END) AS retained_week3\n    FROM activity_with_day\n    GROUP BY \"user_pseudo_id\"\n)\nSELECT \n    (SELECT COUNT(*) FROM cohort) AS COHORT_SIZE,\n    ROUND(SUM(retained_week1) * 1.0 / (SELECT COUNT(*) FROM cohort), 4) AS WEEK1_RETENTION_RATE,\n    ROUND(SUM(retained_week2) * 1.0 / (SELECT COUNT(*) FROM cohort), 4) AS WEEK2_RETENTION_RATE,\n    ROUND(SUM(retained_week3) * 1.0 / (SELECT COUNT(*) FROM cohort), 4) AS WEEK3_RETENTION_RATE\nFROM retention_flags;") t ~= (sql%([EVENTS_20180904_schema, EVENTS_20180929_schema, EVENTS_20180901_schema, EVENTS_20180915_schema, EVENTS_20180925_schema, EVENTS_20180927_schema, EVENTS_20180906_schema, EVENTS_20180922_schema, EVENTS_20180907_schema, EVENTS_20180928_schema, EVENTS_20180909_schema, EVENTS_20180913_schema, EVENTS_20180914_schema, EVENTS_20180926_schema, EVENTS_20180920_schema, EVENTS_20180902_schema, EVENTS_20180908_schema, EVENTS_20180924_schema, EVENTS_20180831_schema, EVENTS_20180903_schema, EVENTS_20180917_schema, EVENTS_20180912_schema, EVENTS_20180923_schema, EVENTS_20180911_schema, EVENTS_20180910_schema, EVENTS_20180918_schema, EVENTS_20180905_schema, EVENTS_20180916_schema, EVENTS_20180921_schema, EVENTS_20180930_schema, EVENTS_20180919_schema]) "WITH all_events AS (\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180831\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180901\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180902\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180903\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180904\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180905\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180906\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180907\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180908\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180909\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180910\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180911\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180912\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180913\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180914\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180915\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180916\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180917\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180918\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180919\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180920\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180921\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180922\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180923\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180924\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180925\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180926\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180927\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180928\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180929\"\n  UNION ALL\n  SELECT \"user_pseudo_id\", \"event_name\", \"event_timestamp\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180930\"\n),\n-- Convert timestamps to Shanghai time (UTC+8)\nevents_shanghai AS (\n  SELECT\n    \"user_pseudo_id\",\n    \"event_name\",\n    CONVERT_TIMEZONE('UTC', 'Asia/Shanghai', TO_TIMESTAMP(\"event_timestamp\" / 1000000)) AS event_ts_shanghai\n  FROM all_events\n),\n-- Cohort: users with first_open in Sept 1-7, 2018 (Shanghai time)\n-- Day 0 is the user's individual first_open date (date part in Shanghai TZ)\ncohort AS (\n  SELECT\n    \"user_pseudo_id\",\n    MIN(event_ts_shanghai) AS first_open_ts,\n    DATE_TRUNC('DAY', MIN(event_ts_shanghai)) AS day0\n  FROM events_shanghai\n  WHERE \"event_name\" = 'first_open'\n  GROUP BY \"user_pseudo_id\"\n  HAVING MIN(event_ts_shanghai) >= '2018-09-01 00:00:00'\n     AND MIN(event_ts_shanghai) < '2018-09-08 00:00:00'\n),\n-- All activity for cohort users (any event counts)\ncohort_activity AS (\n  SELECT\n    e.\"user_pseudo_id\",\n    e.event_ts_shanghai,\n    c.day0,\n    DATEDIFF('day', c.day0, DATE_TRUNC('DAY', e.event_ts_shanghai)) AS days_since_cohort\n  FROM events_shanghai e\n  INNER JOIN cohort c ON e.\"user_pseudo_id\" = c.\"user_pseudo_id\"\n),\n-- N-Day retention: check if user had activity in each week window relative to their day0\nretention AS (\n  SELECT\n    c.\"user_pseudo_id\",\n    MAX(CASE WHEN a.days_since_cohort BETWEEN 1 AND 7 THEN 1 ELSE 0 END) AS retained_week1,\n    MAX(CASE WHEN a.days_since_cohort BETWEEN 8 AND 14 THEN 1 ELSE 0 END) AS retained_week2,\n    MAX(CASE WHEN a.days_since_cohort BETWEEN 15 AND 21 THEN 1 ELSE 0 END) AS retained_week3\n  FROM cohort c\n  LEFT JOIN cohort_activity a ON c.\"user_pseudo_id\" = a.\"user_pseudo_id\"\n  GROUP BY c.\"user_pseudo_id\"\n)\nSELECT\n  COUNT(*) AS COHORT_SIZE,\n  ROUND(SUM(retained_week1) / COUNT(*), 4) AS WEEK1_RETENTION_RATE,\n  ROUND(SUM(retained_week2) / COUNT(*), 4) AS WEEK2_RETENTION_RATE,\n  ROUND(SUM(retained_week3) / COUNT(*), 4) AS WEEK3_RETENTION_RATE\nFROM retention") t := by
