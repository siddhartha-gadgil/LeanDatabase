theorem eq_0_1 : ∀ t,
    (sql%([MBB_GAMES_SR_schema, MBB_PBP_SR_schema]) "WITH scoring_plays AS (\n  SELECT\n    \"game_clock\",\n    \"period\",\n    \"elapsed_time_sec\",\n    \"event_id\",\n    \"event_description\",\n    \"points_scored\",\n    \"team_name\",\n    \"home_name\",\n    \"away_name\"\n  FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_PBP_SR\"\n  WHERE \"season\" = 2014\n    AND \"home_name\" = 'Wildcats'\n    AND \"away_name\" = 'Fighting Irish'\n    AND \"points_scored\" > 0\n),\ncumulative AS (\n  SELECT\n    \"game_clock\",\n    NULLIF(\n      SUM(CASE WHEN \"team_name\" = \"home_name\" THEN \"points_scored\" ELSE 0 END)\n        OVER (ORDER BY \"elapsed_time_sec\", \"points_scored\" DESC, \"event_description\" ROWS UNBOUNDED PRECEDING),\n      0\n    ) AS \"WILDCATS_SCORE\",\n    NULLIF(\n      SUM(CASE WHEN \"team_name\" = \"away_name\" THEN \"points_scored\" ELSE 0 END)\n        OVER (ORDER BY \"elapsed_time_sec\", \"points_scored\" DESC, \"event_description\" ROWS UNBOUNDED PRECEDING),\n      0\n    ) AS \"FIGHTING_IRISH_SCORE\",\n    \"team_name\",\n    \"event_description\",\n    \"elapsed_time_sec\",\n    \"points_scored\"\n  FROM scoring_plays\n)\nSELECT\n  \"game_clock\",\n  \"WILDCATS_SCORE\",\n  \"FIGHTING_IRISH_SCORE\",\n  \"team_name\",\n  \"event_description\"\nFROM cumulative\nORDER BY \"elapsed_time_sec\", \"points_scored\" DESC, \"event_description\";") t ~= (sql%([MBB_GAMES_SR_schema, MBB_PBP_SR_schema]) "WITH game AS (\n    SELECT \"game_id\"\n    FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_GAMES_SR\"\n    WHERE \"h_name\" = 'Wildcats'\n      AND \"a_name\" = 'Fighting Irish'\n      AND \"season\" = 2014\n    LIMIT 1\n),\nscoring_plays AS (\n    SELECT\n        p.\"game_clock\",\n        p.\"team_name\",\n        p.\"event_description\",\n        p.\"points_scored\",\n        p.\"elapsed_time_sec\",\n        p.\"event_id\"\n    FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_PBP_SR\" p\n    JOIN game g ON p.\"game_id\" = g.\"game_id\"\n    WHERE p.\"points_scored\" IS NOT NULL\n      AND p.\"points_scored\" > 0\n)\nSELECT\n    \"game_clock\",\n    SUM(CASE WHEN \"team_name\" = 'Wildcats' THEN \"points_scored\" ELSE 0 END)\n        OVER (ORDER BY \"elapsed_time_sec\" ASC, \"event_id\" ASC\n              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"WILDCATS_SCORE\",\n    SUM(CASE WHEN \"team_name\" = 'Fighting Irish' THEN \"points_scored\" ELSE 0 END)\n        OVER (ORDER BY \"elapsed_time_sec\" ASC, \"event_id\" ASC\n              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"FIGHTING_IRISH_SCORE\",\n    \"team_name\",\n    \"event_description\"\nFROM scoring_plays\nORDER BY \"elapsed_time_sec\" ASC, \"event_id\" ASC;") t := by
  intro t; first | sql_equiv | sorry

