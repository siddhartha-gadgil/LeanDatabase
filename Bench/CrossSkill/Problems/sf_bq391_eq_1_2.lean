namespace N_sf_bq391_eq_1_2

CREATE TABLE PATIENT («active» BOOL, «animal» STRING, «contact» STRING, «generalPractitioner» STRING, «implicitRules» STRING, «language» STRING, «link» STRING, «managingOrganization» STRING, «photo» STRING, «birthPlace» STRING, «disability_adjusted_life_years» STRING, «patient_mothersMaidenName» STRING, «quality_adjusted_life_years» STRING, «shr_actor_FictionalPerson_extension» STRING, «shr_demographics_SocialSecurityNumber_extension» STRING, «shr_entity_FathersName_extension» STRING, «shr_entity_Person_extension» STRING, «us_core_birthsex» STRING, «us_core_ethnicity» STRING, «us_core_race» STRING, «address» STRING, «birthDate» STRING, «communication» STRING, «deceased» STRING, «gender» STRING, «id» STRING, «identifier» STRING, «maritalStatus» STRING, «meta» STRING, «multipleBirth» STRING, «name» STRING, «telecom» STRING, «text» STRING)
CREATE TABLE CONDITION («asserter» STRING, «bodySite» STRING, «evidence» STRING, «identifier» STRING, «implicitRules» STRING, «language» STRING, «note» STRING, «severity» STRING, «stage» STRING, «text» STRING, «abatement» STRING, «assertedDate» STRING, «category» STRING, «clinicalStatus» STRING, «code» STRING, «context» STRING, «id» STRING, «meta» STRING, «onset» STRING, «subject» STRING, «verificationStatus» STRING)
CREATE TABLE MEDICATION_REQUEST («basedOn» STRING, «category» STRING, «definition» STRING, «detectedIssue» STRING, «dispenseRequest» STRING, «eventHistory» STRING, «groupIdentifier» STRING, «identifier» STRING, «implicitRules» STRING, «language» STRING, «note» STRING, «priorPrescription» STRING, «priority» STRING, «reasonCode» STRING, «recorder» STRING, «substitution» STRING, «supportingInformation» STRING, «text» STRING, «shr_action_RequestedContext_extension» STRING, «shr_base_ActionCode_extension» STRING, «authoredOn» STRING, «context» STRING, «dosageInstruction» STRING, «id» STRING, «intent» STRING, «medication» STRING, «meta» STRING, «reasonReference» STRING, «requester» STRING, «status» STRING, «subject» STRING)

theorem eq (t0 : TableRel PATIENT_schema) (t1 : TableRel CONDITION_schema) (t2 : TableRel MEDICATION_REQUEST_schema) :
    (sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "WITH living_a_patients AS (SELECT \"id\" AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" WHERE JSON_EXTRACT_PATH(\"deceased\", 'dateTime') IS NULL AND CAST(JSON_EXTRACT_PATH(\"name\"[1], 'family') AS TEXT) LIKE 'A%'), patients_with_single_condition AS (SELECT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" WHERE CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM living_a_patients) GROUP BY 1 HAVING COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'code') AS TEXT)) = 1), patient_condition AS (SELECT DISTINCT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id, CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'code') AS TEXT) AS cond_code, CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'display') AS TEXT) AS cond_display FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" WHERE CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM patients_with_single_condition)), patient_active_med_count AS (SELECT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id, COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(\"medication\", 'codeableConcept', 'coding', '0', 'code') AS TEXT)) AS num_distinct_meds FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" WHERE \"status\" = 'active' AND CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM patients_with_single_condition) GROUP BY 1), condition_max_meds AS (SELECT pc.cond_display AS CONDITIONS, pc.cond_code AS CODES, MAX(pam.num_distinct_meds) AS max_meds FROM patient_condition AS pc JOIN patient_active_med_count AS pam ON pc.patient_id = pam.patient_id GROUP BY pc.cond_display, pc.cond_code) SELECT CONDITIONS, CODES FROM condition_max_meds ORDER BY max_meds DESC, CODES DESC LIMIT 8") t0 t1 t2
  = (sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "/* Among living patients whose last names begin with \"A\" and who each have exactly */ /* one distinct condition, find the 8 conditions with the highest number of different */ /* active medications prescribed to any single patient, along with their codes. */ WITH living_a_patients AS (SELECT \"id\" AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" WHERE \"deceased\" IS NULL AND CAST(\"name\"[1]['family'] AS TEXT) LIKE 'A%'), patient_conditions AS (SELECT CAST(c.\"subject\"['patientId'] AS TEXT) AS patient_id, CAST(c.\"code\"['coding'][1]['display'] AS TEXT) AS condition_display, CAST(c.\"code\"['coding'][1]['code'] AS TEXT) AS condition_code FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" AS c INNER JOIN living_a_patients AS p ON CAST(c.\"subject\"['patientId'] AS TEXT) = p.patient_id), single_condition_patients /* Patients with exactly one distinct condition */ AS (SELECT patient_id FROM patient_conditions GROUP BY patient_id HAVING COUNT(DISTINCT condition_display) = 1), patient_single_condition /* Get the condition for each single-condition patient */ AS (SELECT DISTINCT pc.patient_id, pc.condition_display, pc.condition_code FROM patient_conditions AS pc INNER JOIN single_condition_patients AS scp ON pc.patient_id = scp.patient_id), patient_med_count /* Count distinct active medications per patient */ AS (SELECT psc.condition_display, psc.condition_code, psc.patient_id, COUNT(DISTINCT CAST(mr.\"medication\"['codeableConcept']['text'] AS TEXT)) AS med_count FROM patient_single_condition AS psc INNER JOIN \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" AS mr ON CAST(mr.\"subject\"['patientId'] AS TEXT) = psc.patient_id WHERE mr.\"status\" = 'active' GROUP BY psc.condition_display, psc.condition_code, psc.patient_id), condition_max_meds /* Get the max med count for any single patient per condition */ AS (SELECT condition_display, condition_code, MAX(med_count) AS max_med_count FROM patient_med_count GROUP BY condition_display, condition_code) SELECT condition_display AS \"CONDITIONS\", condition_code AS \"CODES\" FROM condition_max_meds ORDER BY max_med_count DESC, condition_display ASC LIMIT 8") t0 t1 t2
  := by first | sql_equiv | sorry

end N_sf_bq391_eq_1_2
