/-!
# sf_local253 — crossskill equivalence(s)

Question: Using a Salary Dataset where the salary values need to be cleaned by removing non-numeric characters and converting them to a numeric type, write a detailed SQL query that identifies the top 5 companies by average salary in each of Mumbai, Pune, New Delhi, and Hyderabad, then compares each company’s average salary in those cities to the overall national average salary. The final result should display four columns: Location, Company Name, Average Salary in State, and Average Salary in Country, listing only the top 5 companies in each of the specified locations.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local253

CREATE TABLE SALARYDATASET («index» INT, «CompanyName» STRING, «JobTitle» STRING, «SalariesReported» FLOAT, «Location» STRING, «Salary» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([SALARYDATASET_schema]) "WITH cleaned AS (SELECT \"Location\", \"CompanyName\", CASE WHEN \"Salary\" LIKE '%/yr%' THEN CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '', 'g') AS DOUBLE PRECISION) WHEN \"Salary\" LIKE '%/mo%' THEN CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '', 'g') AS DOUBLE PRECISION) * 12 WHEN \"Salary\" LIKE '%/hr%' THEN CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '', 'g') AS DOUBLE PRECISION) * 2080 END AS salary_num FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"SALARYDATASET\"), national_avg AS (SELECT AVG(salary_num) AS avg_salary_country FROM cleaned), city_company_avg AS (SELECT \"Location\", \"CompanyName\", AVG(salary_num) AS avg_salary_state, ROW_NUMBER() OVER (PARTITION BY \"Location\" ORDER BY AVG(salary_num) DESC) AS rn FROM cleaned WHERE \"Location\" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad') GROUP BY \"Location\", \"CompanyName\") SELECT c.\"Location\" AS \"Location\", c.\"CompanyName\" AS \"Company Name\", c.avg_salary_state AS \"Average Salary in State\", n.avg_salary_country AS \"Average Salary in Country\" FROM city_company_avg AS c CROSS JOIN national_avg AS n WHERE c.rn <= 5 ORDER BY c.\"Location\" ASC, c.avg_salary_state DESC") t ~= (sql%([SALARYDATASET_schema]) "WITH cleaned AS (SELECT \"Location\", \"CompanyName\", CASE WHEN \"Salary\" LIKE '%/mo' THEN CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '', 'g') AS DOUBLE PRECISION) * 12 WHEN \"Salary\" LIKE '%/hr' THEN CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '', 'g') AS DOUBLE PRECISION) * 2080 ELSE CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '', 'g') AS DOUBLE PRECISION) END AS salary_numeric FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"SALARYDATASET\"), country_avg AS (SELECT AVG(salary_numeric) AS avg_country FROM cleaned), company_location_avg AS (SELECT \"Location\", \"CompanyName\", AVG(salary_numeric) AS avg_salary_state, ROW_NUMBER() OVER (PARTITION BY \"Location\" ORDER BY AVG(salary_numeric) DESC, \"CompanyName\" ASC) AS rn FROM cleaned WHERE \"Location\" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad') GROUP BY \"Location\", \"CompanyName\") SELECT c.\"Location\" AS \"Location\", c.\"CompanyName\" AS \"Company Name\", c.avg_salary_state AS \"Average Salary in State\", ca.avg_country AS \"Average Salary in Country\" FROM company_location_avg AS c CROSS JOIN country_avg AS ca WHERE c.rn <= 5 ORDER BY c.\"Location\" ASC, c.avg_salary_state DESC, c.\"CompanyName\" ASC") t := by
  intro t; first | sql_equiv | sorry

