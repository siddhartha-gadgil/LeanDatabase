    (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH imaging_data AS (\n    -- Get all WUSTL imaging records from id_provenance_r5, excluding NULL/Auxiliary/OtherAssay components\n    -- and excluding Level1\n    SELECT \n        p.\"ENTITYID\",\n        p.\"HTAN_DATA_FILE_ID\",\n        p.\"COMPONENT\",\n        p.\"HTAN_CENTER\",\n        p.\"HTAN_PARENT_DATA_FILE_ID\"\n    FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" p\n    WHERE p.\"HTAN_CENTER\" = 'HTAN WUSTL'\n      AND p.\"COMPONENT\" IS NOT NULL\n      AND p.\"COMPONENT\" NOT LIKE '%Auxiliary%'\n      AND p.\"COMPONENT\" NOT LIKE '%OtherAssay%'\n      AND p.\"COMPONENT\" IN ('ImagingLevel2', 'ImagingLevel3Segmentation', 'ImagingLevel4')\n),\n-- Join Level2 records with imaging_level2_metadata to get assay types\nlevel2_assays AS (\n    SELECT DISTINCT\n        m.\"Imaging_Assay_Type\",\n        id.\"HTAN_CENTER\",\n        id.\"HTAN_DATA_FILE_ID\"\n    FROM imaging_data id\n    JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" m\n        ON id.\"ENTITYID\" = m.\"entityId\"\n    WHERE id.\"COMPONENT\" = 'ImagingLevel2'\n      AND m.\"Imaging_Assay_Type\" != 'Electron Microscopy'\n),\n-- Check for Level3 children\nlevel3_exists AS (\n    SELECT DISTINCT l2.\"Imaging_Assay_Type\"\n    FROM level2_assays l2\n    JOIN imaging_data l3 ON l3.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\"\n    WHERE l3.\"COMPONENT\" = 'ImagingLevel3Segmentation'\n),\n-- Check for Level4 children (derived from Level3 or Level2)\nlevel4_exists AS (\n    SELECT DISTINCT l2.\"Imaging_Assay_Type\"\n    FROM level2_assays l2\n    JOIN imaging_data l3 ON l3.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\"\n    JOIN imaging_data l4 ON l4.\"HTAN_PARENT_DATA_FILE_ID\" = l3.\"HTAN_DATA_FILE_ID\"\n    WHERE l3.\"COMPONENT\" = 'ImagingLevel3Segmentation'\n      AND l4.\"COMPONENT\" = 'ImagingLevel4'\n),\n-- Build results\nassay_levels AS (\n    SELECT DISTINCT\n        l2.\"Imaging_Assay_Type\",\n        l2.\"HTAN_CENTER\",\n        'Level2' AS base_level,\n        CASE WHEN l3.\"Imaging_Assay_Type\" IS NOT NULL THEN TRUE ELSE FALSE END AS has_level3,\n        CASE WHEN l4.\"Imaging_Assay_Type\" IS NOT NULL THEN TRUE ELSE FALSE END AS has_level4\n    FROM level2_assays l2\n    LEFT JOIN level3_exists l3 ON l2.\"Imaging_Assay_Type\" = l3.\"Imaging_Assay_Type\"\n    LEFT JOIN level4_exists l4 ON l2.\"Imaging_Assay_Type\" = l4.\"Imaging_Assay_Type\"\n)\nSELECT \n    \"Imaging_Assay_Type\",\n    \"HTAN_CENTER\" AS \"HTAN_Center\",\n    CASE \n        WHEN has_level3 AND has_level4 THEN 'Level2, Level3, Level4'\n        WHEN has_level3 THEN 'Level2, Level3'\n        WHEN has_level4 THEN 'Level2, Level4'\n        ELSE 'Level2'\n    END AS \"AVAILABLE_DATA_LEVELS\"\nFROM assay_levels\nORDER BY \"Imaging_Assay_Type\";") t ~= (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH imaging_level2 AS (\n    -- Get all Level2 imaging data for HTAN WUSTL\n    SELECT DISTINCT \n        i.\"Imaging_Assay_Type\",\n        i.\"HTAN_Center\",\n        'Level2' AS data_level\n    FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" i\n    WHERE i.\"HTAN_Center\" = 'HTAN WUSTL'\n      AND i.\"Component\" IS NOT NULL\n      AND i.\"Component\" NOT LIKE '%Auxiliary%'\n      AND i.\"Component\" NOT LIKE '%OtherAssay%'\n      AND i.\"Imaging_Assay_Type\" != 'Electron Microscopy'\n),\nimaging_level3 AS (\n    -- Check for Level3 data derived from Level2 via entityId / parent relationships\n    SELECT DISTINCT \n        l2.\"Imaging_Assay_Type\",\n        l2.\"HTAN_Center\",\n        'Level3' AS data_level\n    FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" l2\n    JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" p2\n        ON l2.\"HTAN_Data_File_ID\" = p2.\"HTAN_DATA_FILE_ID\"\n    JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" p3\n        ON p3.\"HTAN_PARENT_DATA_FILE_ID\" = p2.\"HTAN_DATA_FILE_ID\"\n    WHERE l2.\"HTAN_Center\" = 'HTAN WUSTL'\n      AND p3.\"COMPONENT\" = 'ImagingLevel3'\n      AND l2.\"Component\" IS NOT NULL\n      AND l2.\"Component\" NOT LIKE '%Auxiliary%'\n      AND l2.\"Component\" NOT LIKE '%OtherAssay%'\n      AND l2.\"Imaging_Assay_Type\" != 'Electron Microscopy'\n),\nimaging_level4 AS (\n    -- Check for Level4 data derived from Level2 via entityId / parent relationships\n    SELECT DISTINCT \n        l2.\"Imaging_Assay_Type\",\n        l2.\"HTAN_Center\",\n        'Level4' AS data_level\n    FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" l2\n    JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" p2\n        ON l2.\"HTAN_Data_File_ID\" = p2.\"HTAN_DATA_FILE_ID\"\n    JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" p3\n        ON p3.\"HTAN_PARENT_DATA_FILE_ID\" = p2.\"HTAN_DATA_FILE_ID\"\n    WHERE l2.\"HTAN_Center\" = 'HTAN WUSTL'\n      AND p3.\"COMPONENT\" = 'ImagingLevel4'\n      AND l2.\"Component\" IS NOT NULL\n      AND l2.\"Component\" NOT LIKE '%Auxiliary%'\n      AND l2.\"Component\" NOT LIKE '%OtherAssay%'\n      AND l2.\"Imaging_Assay_Type\" != 'Electron Microscopy'\n),\nall_levels AS (\n    SELECT * FROM imaging_level2\n    UNION\n    SELECT * FROM imaging_level3\n    UNION\n    SELECT * FROM imaging_level4\n)\nSELECT \n    \"Imaging_Assay_Type\",\n    \"HTAN_Center\" AS \"HTAN_Center\",\n    LISTAGG(DISTINCT data_level, ', ') WITHIN GROUP (ORDER BY data_level) AS \"AVAILABLE_DATA_LEVELS\"\nFROM all_levels\nGROUP BY \"Imaging_Assay_Type\", \"HTAN_Center\"\nORDER BY \"Imaging_Assay_Type\";") t := by
