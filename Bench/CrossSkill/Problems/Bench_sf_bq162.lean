ing_Assay_Type\",\n        l2.\"HTAN_CENTER\",\n        'Level2' AS base_level,\n        CASE WHEN l3.\"Imaging_Assay_Type\" IS NOT NULL THEN TRUE ELSE FALSE END AS has_level3,\n        CASE WHEN l4.\"Imaging_Assay_Type\" IS NOT NULL THEN TRUE ELSE FALSE END AS has_level4\n    FROM level2_assays l2\n    LEFT JOIN level3_exists l3 ON l2.\"Imaging_Assay_Type\" = l3.\"Imaging_Assay_Type\"\n    LEFT JOIN level4_exists l4 ON l2.\"Imaging_Assay_Type\" = l4.\"Imaging_Assay_Type\"\n)\nSELECT \n    \"Imaging_Assay_Type\",\n    \"HTAN_CENTER\" AS \"HTAN_Center\",\n    CASE \n        WHEN has_level3 AND has_level4 THEN 'Level2, Level3, Level4'\n        WHEN has_level3 THEN 'Level2, Level3'\n        WHEN has_level4 THEN 'Level2, Level4'\n        ELSE 'Level2'\n    END AS \"AVAILABLE_DATA_LEVELS\"\nFROM assay_levels\nORDER BY \"Imaging_Assay_Type\";") t ~= (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH level2_files AS (\n    -- Get Level2 imaging data for WUSTL, excluding Electron Microscopy\n    SELECT DISTINCT\n        m.\"Imaging_Assay_Type\",\n        m.\"HTAN_Center\",\n        p.\"HTAN_DATA_FILE_ID\",\n        p.\"COMPONENT\"\n    FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" m\n    INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" p\n        ON m.\"HTAN_Data_File_ID\" = p.\"HTAN_DATA_FILE_ID\"\n    WHERE m.\"HTAN_Center\" = 'HTAN WUSTL'\n      AND m.\"Imaging_Assay_Type\" != 'Electron Microscopy'\n      AND p.\"COMPONENT\" IS NOT NULL\n      AND p.\"COMPONENT\" NOT IN ('Auxiliary', 'OtherAssay')\n),\n-- Find all imaging levels: Level2 from the files themselves, plus Level3/4 derived from them\nall_levels AS (\n    -- Level2 data\n    SELECT DISTINCT\n        l2.\"Imaging_Assay_Type\",\n        l2.\"HTAN_Center\",\n        CASE\n            WHEN l2.\"COMPONENT\" LIKE '%Level2%' THEN 'Level2'\n            WHEN l2.\"COMPONENT\" LIKE '%Level3%' THEN 'Level3'\n            WHEN l2.\"COMPONENT\" LIKE '%Level4%' THEN 'Level4'\n        END AS DATA_LEVEL\n    FROM level2_files l2\n    WHERE l2.\"COMPONENT\" NOT LIKE '%Level1%'\n\n    UNION\n\n    -- Level3/4 data derived from Level2\n    SELECT DISTINCT\n        l2.\"Imaging_Assay_Type\",\n        l2.\"HTAN_Center\",\n        CASE\n            WHEN child.\"COMPONENT\" LIKE '%Level2%' THEN 'Level2'\n            WHEN child.\"COMPONENT\" LIKE '%Level3%' THEN 'Level3'\n            WHEN child.\"COMPONENT\" LIKE '%Level4%' THEN 'Level4'\n        END AS DATA_LEVEL\n    FROM level2_files l2\n    INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" child\n        ON child.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\"\n    WHERE child.\"COMPONENT\" IS NOT NULL\n      AND child.\"COMPONENT\" NOT IN ('Auxiliary', 'OtherAssay')\n      AND child.\"COMPONENT\" NOT LIKE '%Level1%'\n)\nSELECT\n    \"Imaging_Assay_Type\",\n    \"HTAN_Center\",\n    LISTAGG(DISTINCT DATA_LEVEL, ', ') WITHIN GROUP (ORDER BY DATA_LEVEL) AS \"AVAILABLE_DATA_LEVELS\"\nFROM all_levels\nWHERE DATA_LEVEL IS NOT NULL\nGROUP BY \"Imaging_Assay_Type\", \"HTAN_Center\"\nORDER BY \"Imaging_Assay_Type\";") t := by
