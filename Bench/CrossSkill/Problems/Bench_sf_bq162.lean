    (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH imaging_data AS (/* Get all WUSTL imaging records from id_provenance_r5, excluding NULL/Auxiliary/OtherAssay components */ /* and excluding Level1 */ SELECT p.\"ENTITYID\", p.\"HTAN_DATA_FILE_ID\", p.\"COMPONENT\", p.\"HTAN_CENTER\", p.\"HTAN_PARENT_DATA_FILE_ID\" FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS p WHERE p.\"HTAN_CENTER\" = 'HTAN WUSTL' AND NOT p.\"COMPONENT\" IS NULL AND NOT p.\"COMPONENT\" LIKE '%Auxiliary%' AND NOT p.\"COMPONENT\" LIKE '%OtherAssay%' AND p.\"COMPONENT\" IN ('ImagingLevel2', 'ImagingLevel3Segmentation', 'ImagingLevel4')), level2_assays /* Join Level2 records with imaging_level2_metadata to get assay types */ AS (SELECT DISTINCT m.\"Imaging_Assay_Type\", id.\"HTAN_CENTER\", id.\"HTAN_DATA_FILE_ID\" FROM imaging_data AS id JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" AS m ON id.\"ENTITYID\" = m.\"entityId\" WHERE id.\"COMPONENT\" = 'ImagingLevel2' AND m.\"Imaging_Assay_Type\" <> 'Electron Microscopy'), level3_exists /* Check for Level3 children */ AS (SELECT DISTINCT l2.\"Imaging_Assay_Type\" FROM level2_assays AS l2 JOIN imaging_data AS l3 ON l3.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" WHERE l3.\"COMPONENT\" = 'ImagingLevel3Segmentation'), level4_exists /* Check for Level4 children (derived from Level3 or Level2) */ AS (SELECT DISTINCT l2.\"Imaging_Assay_Type\" FROM level2_assays AS l2 JOIN imaging_data AS l3 ON l3.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" JOIN imaging_data AS l4 ON l4.\"HTAN_PARENT_DATA_FILE_ID\" = l3.\"HTAN_DATA_FILE_ID\" WHERE l3.\"COMPONENT\" = 'ImagingLevel3Segmentation' AND l4.\"COMPONENT\" = 'ImagingLevel4'), assay_levels /* Build results */ AS (SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_CENTER\", 'Level2' AS base_level, CASE WHEN NOT l3.\"Imaging_Assay_Type\" IS NULL THEN TRUE ELSE FALSE END AS has_level3, CASE WHEN NOT l4.\"Imaging_Assay_Type\" IS NULL THEN TRUE ELSE FALSE END AS has_level4 FROM level2_assays AS l2 LEFT JOIN level3_exists AS l3 ON l2.\"Imaging_Assay_Type\" = l3.\"Imaging_Assay_Type\" LEFT JOIN level4_exists AS l4 ON l2.\"Imaging_Assay_Type\" = l4.\"Imaging_Assay_Type\") SELECT \"Imaging_Assay_Type\", \"HTAN_CENTER\" AS \"HTAN_Center\", CASE WHEN has_level3 AND has_level4 THEN 'Level2, Level3, Level4' WHEN has_level3 THEN 'Level2, Level3' WHEN has_level4 THEN 'Level2, Level4' ELSE 'Level2' END AS \"AVAILABLE_DATA_LEVELS\" FROM assay_levels ORDER BY \"Imaging_Assay_Type\"") t ~= (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH level2_files AS (/* Get Level2 imaging data for WUSTL, excluding Electron Microscopy */ SELECT DISTINCT m.\"Imaging_Assay_Type\", m.\"HTAN_Center\", p.\"HTAN_DATA_FILE_ID\", p.\"COMPONENT\" FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" AS m INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS p ON m.\"HTAN_Data_File_ID\" = p.\"HTAN_DATA_FILE_ID\" WHERE m.\"HTAN_Center\" = 'HTAN WUSTL' AND m.\"Imaging_Assay_Type\" <> 'Electron Microscopy' AND NOT p.\"COMPONENT\" IS NULL AND NOT p.\"COMPONENT\" IN ('Auxiliary', 'OtherAssay')), all_levels /* Find all imaging levels: Level2 from the files themselves, plus Level3/4 derived from them */ AS (/* Level2 data */ SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_Center\", CASE WHEN l2.\"COMPONENT\" LIKE '%Level2%' THEN 'Level2' WHEN l2.\"COMPONENT\" LIKE '%Level3%' THEN 'Level3' WHEN l2.\"COMPONENT\" LIKE '%Level4%' THEN 'Level4' END AS DATA_LEVEL FROM level2_files AS l2 WHERE NOT l2.\"COMPONENT\" LIKE '%Level1%' UNION /* Level3/4 data derived from Level2 */ SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_Center\", CASE WHEN child.\"COMPONENT\" LIKE '%Level2%' THEN 'Level2' WHEN child.\"COMPONENT\" LIKE '%Level3%' THEN 'Level3' WHEN child.\"COMPONENT\" LIKE '%Level4%' THEN 'Level4' END AS DATA_LEVEL FROM level2_files AS l2 INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS child ON child.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" WHERE NOT child.\"COMPONENT\" IS NULL AND NOT child.\"COMPONENT\" IN ('Auxiliary', 'OtherAssay') AND NOT child.\"COMPONENT\" LIKE '%Level1%') SELECT \"Imaging_Assay_Type\", \"HTAN_Center\", STRING_AGG(DISTINCT DATA_LEVEL, ', ' ORDER BY DATA_LEVEL) AS \"AVAILABLE_DATA_LEVELS\" FROM all_levels WHERE NOT DATA_LEVEL IS NULL GROUP BY \"Imaging_Assay_Type\", \"HTAN_Center\" ORDER BY \"Imaging_Assay_Type\"") t := by
