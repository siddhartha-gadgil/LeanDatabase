NENT\" IN ('Auxiliary', 'OtherAssay') AND NOT child.\"COMPONENT\" LIKE '%Level1%') SELECT \"Imaging_Assay_Type\", \"HTAN_Center\", STRING_AGG(DISTINCT DATA_LEVEL, ', ' ORDER BY DATA_LEVEL) AS \"AVAILABLE_DATA_LEVELS\" FROM all_levels WHERE NOT DATA_LEVEL IS NULL GROUP BY \"Imaging_Assay_Type\", \"HTAN_Center\" ORDER BY \"Imaging_Assay_Type\"") t := by
