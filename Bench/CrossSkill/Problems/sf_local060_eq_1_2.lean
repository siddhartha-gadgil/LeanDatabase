theorem eq (t0 : TableRel CUSTOMERS_schema) (t1 : TableRel PRODUCTS_schema) (t2 : TableRel TIMES_schema) (t3 : TableRel PROMOTIONS_schema) (t4 : TableRel SALES_schema) :
    (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "WITH base_sales AS (SELECT s.\"prod_id\", s.\"cust_id\", s.\"amount_sold\", t.\"calendar_year\", t.\"calendar_quarter_number\", c.\"cust_city\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" WHERE s.\"promo_id\" = 999 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND c.\"country_id\" = (SELECT \"country_id\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" WHERE \"country_iso_code\" = 'US')), city_sales AS (SELECT \"cust_city\", SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS sales_2019, SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS sales_2020 FROM base_sales GROUP BY \"cust_city\"), qualifying_cities AS (SELECT \"cust_city\" FROM city_sales WHERE sales_2019 > 0 AND sales_2020 >= 1.2 * sales_2019), sales_in_qualifying_cities AS (SELECT b.\"prod_id\", b.\"amount_sold\", b.\"calendar_year\" FROM base_sales AS b JOIN qualifying_cities AS qc ON b.\"cust_city\" = qc.\"cust_city\"), product_total_sales AS (SELECT \"prod_id\", SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS sales_2019, SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS sales_2020, SUM(\"amount_sold\") AS total_sales FROM sales_in_qualifying_cities GROUP BY \"prod_id\"), total_all_sales AS (SELECT SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS total_2019, SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS total_2020 FROM sales_in_qualifying_cities), product_ranked AS (SELECT pt.\"prod_id\", pt.sales_2019, pt.sales_2020, pt.total_sales, ROW_NUMBER() OVER (ORDER BY pt.total_sales DESC) AS rnk, COUNT(*) OVER () AS cnt FROM product_total_sales AS pt), top_products AS (SELECT * FROM product_ranked WHERE rnk <= CEIL(0.2 * cnt)) SELECT tp.\"prod_id\", p.\"prod_name\", CAST(tp.sales_2019 AS DOUBLE PRECISION) / tas.total_2019 AS SHARE_2019, CAST(tp.sales_2020 AS DOUBLE PRECISION) / tas.total_2020 AS SHARE_2020, (CAST(tp.sales_2020 AS DOUBLE PRECISION) / tas.total_2020) - (CAST(tp.sales_2019 AS DOUBLE PRECISION) / tas.total_2019) AS SHARE_CHANGE FROM top_products AS tp CROSS JOIN total_all_sales AS tas JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON tp.\"prod_id\" = p.\"prod_id\" ORDER BY SHARE_CHANGE DESC") t0 t1 t2 t3 t4
  ~= (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "WITH us_customers AS (SELECT c.\"cust_id\", c.\"cust_city\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" AS co ON c.\"country_id\" = co.\"country_id\" WHERE co.\"country_name\" = 'United States of America'), q4_times AS (SELECT \"time_id\", \"calendar_quarter_desc\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" WHERE \"calendar_quarter_desc\" IN ('2019-04', '2020-04')), base_sales AS (SELECT s.\"prod_id\", uc.\"cust_city\", t.\"calendar_quarter_desc\", s.\"amount_sold\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN us_customers AS uc ON s.\"cust_id\" = uc.\"cust_id\" JOIN q4_times AS t ON s.\"time_id\" = t.\"time_id\" WHERE s.\"promo_id\" = 999), city_sales /* Step 1: Cities where total sales rose by at least 20% from Q4 2019 to Q4 2020 */ AS (SELECT \"cust_city\", SUM(CASE WHEN \"calendar_quarter_desc\" = '2019-04' THEN \"amount_sold\" ELSE 0 END) AS sales_2019, SUM(CASE WHEN \"calendar_quarter_desc\" = '2020-04' THEN \"amount_sold\" ELSE 0 END) AS sales_2020 FROM base_sales GROUP BY \"cust_city\" HAVING sales_2019 > 0 AND CAST((sales_2020 - sales_2019) AS DOUBLE PRECISION) / sales_2019 >= 0.20), product_sales /* Step 2: Among those cities, rank products by overall sales and take top 20% */ AS (SELECT bs.\"prod_id\", SUM(bs.\"amount_sold\") AS total_sales FROM base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" GROUP BY bs.\"prod_id\"), product_ranked AS (SELECT \"prod_id\", total_sales, NTILE(5) OVER (ORDER BY total_sales DESC) AS tile FROM product_sales), top_products AS (SELECT \"prod_id\" FROM product_ranked WHERE tile = 1), product_quarter_sales /* Step 3: Compute each top product's share of total sales in Q4 2019 and Q4 2020 */ AS (SELECT bs.\"prod_id\", bs.\"calendar_quarter_desc\", SUM(bs.\"amount_sold\") AS prod_q_sales FROM base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" JOIN top_products AS tp ON bs.\"prod_id\" = tp.\"prod_id\" GROUP BY bs.\"prod_id\", bs.\"calendar_quarter_desc\"), total_quarter_sales AS (SELECT bs.\"calendar_quarter_desc\", SUM(bs.\"amount_sold\") AS total_q_sales FROM base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" GROUP BY bs.\"calendar_quarter_desc\"), shares AS (SELECT pqs.\"prod_id\", ROUND(CAST(SUM(CASE WHEN pqs.\"calendar_quarter_desc\" = '2019-04' THEN pqs.prod_q_sales ELSE 0 END) AS DOUBLE PRECISION) / MAX(CASE WHEN tqs.\"calendar_quarter_desc\" = '2019-04' THEN tqs.total_q_sales END), 2) AS \"SHARE_2019\", ROUND(CAST(SUM(CASE WHEN pqs.\"calendar_quarter_desc\" = '2020-04' THEN pqs.prod_q_sales ELSE 0 END) AS DOUBLE PRECISION) / MAX(CASE WHEN tqs.\"calendar_quarter_desc\" = '2020-04' THEN tqs.total_q_sales END), 2) AS \"SHARE_2020\" FROM product_quarter_sales AS pqs JOIN total_quarter_sales AS tqs ON pqs.\"calendar_quarter_desc\" = tqs.\"calendar_quarter_desc\" GROUP BY pqs.\"prod_id\") SELECT s.\"prod_id\" AS \"prod_id\", p.\"prod_name\" AS \"prod_name\", s.\"SHARE_2019\", s.\"SHARE_2020\", ROUND(s.\"SHARE_2020\" - s.\"SHARE_2019\", 2) AS \"SHARE_CHANGE\" FROM shares AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON s.\"prod_id\" = p.\"prod_id\" ORDER BY \"SHARE_CHANGE\" DESC") t0 t1 t2 t3 t4
