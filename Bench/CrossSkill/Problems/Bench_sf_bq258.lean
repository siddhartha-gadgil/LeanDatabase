import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq258 — crossskill equivalence(s)

Question: Generate a monthly report for each product category , where each row corresponds to orders that have a status of 'Complete' and were delivered before the year 2022, grouping by the month and year of delivery. For each category, calculate the total revenue (the sum of sale_price), the total number of completed orders, and compute the month-over-month percentage growth for both revenue and orders by comparing each month’s totals to the previous month’s. Then, for the same orders, aggregate and show the total cost (from product costs), total profit (revenue minus total cost), and finally the profit-to-cost ratio for each month.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq258

CREATE TABLE PRODUCTS («id» INT, «cost» FLOAT, «category» STRING, «name» STRING, «brand» STRING, «retail_price» FLOAT, «department» STRING, «sku» STRING, «distribution_center_id» INT)
CREATE TABLE ORDER_ITEMS («id» INT, «order_id» INT, «user_id» INT, «product_id» INT, «inventory_item_id» INT, «status» STRING, «created_at» INT, «shipped_at» INT, «delivered_at» INT, «returned_at» INT, «sale_price» FLOAT)

theorem eq_0_1 :
    sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_data AS (\n  SELECT\n    p.\"category\" AS CATEGORY,\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))::DATE AS MONTH_START,\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS YEAR,\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS MONTH,\n    SUM(oi.\"sale_price\") AS REVENUE,\n    COUNT(DISTINCT oi.\"order_id\") AS ORDERS_COUNT,\n    SUM(p.\"cost\") AS TOTAL_COST\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p\n    ON oi.\"product_id\" = p.\"id\"\n  WHERE oi.\"status\" = 'Complete'\n    AND EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) < 2022\n  GROUP BY\n    p.\"category\",\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))\n),\nwith_growth AS (\n  SELECT\n    CATEGORY,\n    MONTH_START,\n    YEAR,\n    MONTH,\n    REVENUE,\n    ORDERS_COUNT,\n    ROUND(\n      (REVENUE - LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START))\n      / LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START) * 100,\n      2\n    ) AS REVENUE_MOM_PCT,\n    ROUND(\n      (ORDERS_COUNT - LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START))\n      / LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START) * 100,\n      2\n    ) AS ORDERS_MOM_PCT,\n    TOTAL_COST,\n    REVENUE - TOTAL_COST AS PROFIT,\n    (REVENUE - TOTAL_COST) / TOTAL_COST AS PROFIT_TO_COST_RATIO\n  FROM monthly_data\n)\nSELECT\n  CATEGORY,\n  MONTH_START,\n  YEAR,\n  MONTH,\n  REVENUE,\n  ORDERS_COUNT,\n  REVENUE_MOM_PCT,\n  ORDERS_MOM_PCT,\n  TOTAL_COST,\n  PROFIT,\n  PROFIT_TO_COST_RATIO\nFROM with_growth\nORDER BY CATEGORY, MONTH_START;" = sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_stats AS (\n  SELECT\n    p.\"category\" AS CATEGORY,\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))::DATE AS MONTH_START,\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS YEAR,\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS MONTH,\n    SUM(oi.\"sale_price\") AS REVENUE,\n    COUNT(DISTINCT oi.\"order_id\") AS ORDERS_COUNT,\n    SUM(p.\"cost\") AS TOTAL_COST,\n    SUM(oi.\"sale_price\") - SUM(p.\"cost\") AS PROFIT\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p\n    ON oi.\"product_id\" = p.\"id\"\n  WHERE oi.\"status\" = 'Complete'\n    AND TO_TIMESTAMP(oi.\"delivered_at\" / 1000000) < '2022-01-01'\n  GROUP BY\n    p.\"category\",\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))\n)\nSELECT\n  CATEGORY,\n  MONTH_START,\n  YEAR,\n  MONTH,\n  REVENUE,\n  ORDERS_COUNT,\n  ROUND(\n    (REVENUE - LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH))\n    / NULLIF(LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH), 0) * 100,\n    2\n  ) AS REVENUE_MOM_PCT,\n  ROUND(\n    (ORDERS_COUNT - LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH))\n    / NULLIF(LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH), 0) * 100,\n    2\n  ) AS ORDERS_MOM_PCT,\n  TOTAL_COST,\n  PROFIT,\n  PROFIT / NULLIF(TOTAL_COST, 0) AS PROFIT_TO_COST_RATIO\nFROM monthly_stats\nORDER BY CATEGORY, YEAR, MONTH;" := by
  first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_data AS (\n  SELECT\n    p.\"category\" AS CATEGORY,\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))::DATE AS MONTH_START,\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS YEAR,\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS MONTH,\n    SUM(oi.\"sale_price\") AS REVENUE,\n    COUNT(DISTINCT oi.\"order_id\") AS ORDERS_COUNT,\n    SUM(p.\"cost\") AS TOTAL_COST\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p\n    ON oi.\"product_id\" = p.\"id\"\n  WHERE oi.\"status\" = 'Complete'\n    AND EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) < 2022\n  GROUP BY\n    p.\"category\",\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))\n),\nwith_growth AS (\n  SELECT\n    CATEGORY,\n    MONTH_START,\n    YEAR,\n    MONTH,\n    REVENUE,\n    ORDERS_COUNT,\n    ROUND(\n      (REVENUE - LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START))\n      / LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START) * 100,\n      2\n    ) AS REVENUE_MOM_PCT,\n    ROUND(\n      (ORDERS_COUNT - LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START))\n      / LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START) * 100,\n      2\n    ) AS ORDERS_MOM_PCT,\n    TOTAL_COST,\n    REVENUE - TOTAL_COST AS PROFIT,\n    (REVENUE - TOTAL_COST) / TOTAL_COST AS PROFIT_TO_COST_RATIO\n  FROM monthly_data\n)\nSELECT\n  CATEGORY,\n  MONTH_START,\n  YEAR,\n  MONTH,\n  REVENUE,\n  ORDERS_COUNT,\n  REVENUE_MOM_PCT,\n  ORDERS_MOM_PCT,\n  TOTAL_COST,\n  PROFIT,\n  PROFIT_TO_COST_RATIO\nFROM with_growth\nORDER BY CATEGORY, MONTH_START;") t ~= (sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_metrics AS (\n  SELECT \n    p.\"category\" AS \"CATEGORY\",\n    TO_DATE(DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\"/1000000))) AS \"MONTH_START\",\n    YEAR(TO_TIMESTAMP(oi.\"delivered_at\"/1000000)) AS \"YEAR\",\n    MONTH(TO_TIMESTAMP(oi.\"delivered_at\"/1000000)) AS \"MONTH\",\n    SUM(oi.\"sale_price\") AS \"REVENUE\",\n    COUNT(DISTINCT oi.\"order_id\") AS \"ORDERS_COUNT\",\n    SUM(p.\"cost\") AS \"TOTAL_COST\"\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p \n    ON oi.\"product_id\" = p.\"id\"\n  WHERE oi.\"status\" = 'Complete'\n    AND TO_TIMESTAMP(oi.\"delivered_at\"/1000000) < '2022-01-01'\n  GROUP BY \n    p.\"category\",\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\"/1000000)),\n    YEAR(TO_TIMESTAMP(oi.\"delivered_at\"/1000000)),\n    MONTH(TO_TIMESTAMP(oi.\"delivered_at\"/1000000))\n)\nSELECT\n  \"CATEGORY\",\n  \"MONTH_START\",\n  \"YEAR\",\n  \"MONTH\",\n  \"REVENUE\",\n  \"ORDERS_COUNT\",\n  ROUND((\"REVENUE\" - LAG(\"REVENUE\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\")) \n    / LAG(\"REVENUE\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\") * 100, 2) AS \"REVENUE_MOM_PCT\",\n  ROUND((\"ORDERS_COUNT\" - LAG(\"ORDERS_COUNT\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\"))\n    / LAG(\"ORDERS_COUNT\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\") * 100, 2) AS \"ORDERS_MOM_PCT\",\n  \"TOTAL_COST\",\n  \"REVENUE\" - \"TOTAL_COST\" AS \"PROFIT\",\n  ROUND((\"REVENUE\" - \"TOTAL_COST\") / \"TOTAL_COST\", 2) AS \"PROFIT_TO_COST_RATIO\"\nFROM monthly_metrics\nORDER BY \"CATEGORY\", \"MONTH_START\";") t := by
  intro t; first | sql_equiv | sorry

theorem eq_1_2 : ∀ t,
    (sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_stats AS (\n  SELECT\n    p.\"category\" AS CATEGORY,\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))::DATE AS MONTH_START,\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS YEAR,\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)) AS MONTH,\n    SUM(oi.\"sale_price\") AS REVENUE,\n    COUNT(DISTINCT oi.\"order_id\") AS ORDERS_COUNT,\n    SUM(p.\"cost\") AS TOTAL_COST,\n    SUM(oi.\"sale_price\") - SUM(p.\"cost\") AS PROFIT\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p\n    ON oi.\"product_id\" = p.\"id\"\n  WHERE oi.\"status\" = 'Complete'\n    AND TO_TIMESTAMP(oi.\"delivered_at\" / 1000000) < '2022-01-01'\n  GROUP BY\n    p.\"category\",\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(YEAR FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000)),\n    EXTRACT(MONTH FROM TO_TIMESTAMP(oi.\"delivered_at\" / 1000000))\n)\nSELECT\n  CATEGORY,\n  MONTH_START,\n  YEAR,\n  MONTH,\n  REVENUE,\n  ORDERS_COUNT,\n  ROUND(\n    (REVENUE - LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH))\n    / NULLIF(LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH), 0) * 100,\n    2\n  ) AS REVENUE_MOM_PCT,\n  ROUND(\n    (ORDERS_COUNT - LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH))\n    / NULLIF(LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH), 0) * 100,\n    2\n  ) AS ORDERS_MOM_PCT,\n  TOTAL_COST,\n  PROFIT,\n  PROFIT / NULLIF(TOTAL_COST, 0) AS PROFIT_TO_COST_RATIO\nFROM monthly_stats\nORDER BY CATEGORY, YEAR, MONTH;") t ~= (sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_metrics AS (\n  SELECT \n    p.\"category\" AS \"CATEGORY\",\n    TO_DATE(DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\"/1000000))) AS \"MONTH_START\",\n    YEAR(TO_TIMESTAMP(oi.\"delivered_at\"/1000000)) AS \"YEAR\",\n    MONTH(TO_TIMESTAMP(oi.\"delivered_at\"/1000000)) AS \"MONTH\",\n    SUM(oi.\"sale_price\") AS \"REVENUE\",\n    COUNT(DISTINCT oi.\"order_id\") AS \"ORDERS_COUNT\",\n    SUM(p.\"cost\") AS \"TOTAL_COST\"\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p \n    ON oi.\"product_id\" = p.\"id\"\n  WHERE oi.\"status\" = 'Complete'\n    AND TO_TIMESTAMP(oi.\"delivered_at\"/1000000) < '2022-01-01'\n  GROUP BY \n    p.\"category\",\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(oi.\"delivered_at\"/1000000)),\n    YEAR(TO_TIMESTAMP(oi.\"delivered_at\"/1000000)),\n    MONTH(TO_TIMESTAMP(oi.\"delivered_at\"/1000000))\n)\nSELECT\n  \"CATEGORY\",\n  \"MONTH_START\",\n  \"YEAR\",\n  \"MONTH\",\n  \"REVENUE\",\n  \"ORDERS_COUNT\",\n  ROUND((\"REVENUE\" - LAG(\"REVENUE\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\")) \n    / LAG(\"REVENUE\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\") * 100, 2) AS \"REVENUE_MOM_PCT\",\n  ROUND((\"ORDERS_COUNT\" - LAG(\"ORDERS_COUNT\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\"))\n    / LAG(\"ORDERS_COUNT\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\") * 100, 2) AS \"ORDERS_MOM_PCT\",\n  \"TOTAL_COST\",\n  \"REVENUE\" - \"TOTAL_COST\" AS \"PROFIT\",\n  ROUND((\"REVENUE\" - \"TOTAL_COST\") / \"TOTAL_COST\", 2) AS \"PROFIT_TO_COST_RATIO\"\nFROM monthly_metrics\nORDER BY \"CATEGORY\", \"MONTH_START\";") t := by
