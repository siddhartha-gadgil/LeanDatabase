Y bw.\"bowler\", bw.\"match_id\"), bowler_match_combined AS (SELECT bmr.\"bowler\", bmr.\"match_id\", COALESCE(bmw.match_wickets, 0) AS match_wickets, bmr.match_runs FROM bowler_match_runs AS bmr LEFT JOIN bowler_match_wickets AS bmw ON bmr.\"bowler\" = bmw.\"bowler\" AND bmr.\"match_id\" = bmw.\"match_id\"), best_bowling AS (SELECT bmc.\"bowler\", bmc.match_wickets, bmc.match_runs, ROW_NUMBER() OVER (PARTITION BY bmc.\"bowler\" ORDER BY bmc.match_wickets DESC, bmc.match_runs ASC) AS rn FROM bowler_match_combined AS bmc WHERE bmc.match_wickets > 0) SELECT p.\"player_name\", COALESCE(btw.total_wickets, 0) AS TOTAL_WICKETS, ROUND(CAST(bo.total_runs_conceded * 6.0 AS DOUBLE PRECISION) / bo.legal_balls, 4) AS ECONOMY_RATE, CASE WHEN COALESCE(btw.total_wickets, 0) > 0 THEN ROUND(CAST(bo.legal_balls * 1.0 AS DOUBLE PRECISION) / btw.total_wickets, 4) ELSE NULL END AS STRIKE_RATE, CASE WHEN NOT bb.match_wickets IS NULL THEN bb.match_wickets || '-' || bb.match_runs ELSE NULL END AS BEST_BOWLING FROM bowler_overall AS bo JOIN \"IPL\".\"IPL\".\"PLAYER\" AS p ON bo.\"bowler\" = p.\"player_id\" LEFT JOIN bowler_total_wickets AS btw ON bo.\"bowler\" = btw.\"bowler\" LEFT JOIN best_bowling AS bb ON bo.\"bowler\" = bb.\"bowler\" AND bb.rn = 1 ORDER BY p.\"player_name\"") t0 t1 t2 t3 t4 t5
