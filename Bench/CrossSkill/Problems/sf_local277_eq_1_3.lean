CREATE TABLE MONTHLY_SALES («product_id» INT, «mth» STRING, «qty» INT)

theorem eq (t0 : TableRel MONTHLY_SALES_schema) :
    (sql%([MONTHLY_SALES_schema]) "WITH base AS (SELECT \"product_id\", \"mth\", CAST(\"qty\" AS DOUBLE PRECISION) AS qty, ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t, CAST(SUBSTRING(\"mth\" FROM 6 FOR 2) AS INT) AS cal_month FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790)), cma_calc AS (SELECT b.\"product_id\", b.t, b.qty, b.cal_month, CAST(((SELECT SUM(b2.qty) FROM base AS b2 WHERE b2.\"product_id\" = b.\"product_id\" AND b2.t BETWEEN b.t - 5 AND b.t + 6) + (SELECT SUM(b2.qty) FROM base AS b2 WHERE b2.\"product_id\" = b.\"product_id\" AND b2.t BETWEEN b.t - 6 AND b.t + 5)) AS DOUBLE PRECISION) / 24.0 AS cma FROM base AS b WHERE b.t BETWEEN 7 AND 30), ratios AS (SELECT \"product_id\", t, qty, cal_month, cma, CAST(qty AS DOUBLE PRECISION) / NULLIF(cma, 0) AS ratio FROM cma_calc), seasonal AS (SELECT \"product_id\", cal_month, AVG(ratio) AS si FROM ratios GROUP BY \"product_id\", cal_month), deseasonalized AS (SELECT c.\"product_id\", c.t, c.qty, c.cal_month, s.si, c.cma, CASE WHEN s.si = 0 THEN 0.0 ELSE CAST(c.qty AS DOUBLE PRECISION) / s.si END AS deseas FROM cma_calc AS c JOIN seasonal AS s ON c.\"product_id\" = s.\"product_id\" AND c.cal_month = s.cal_month), wls_parts AS (SELECT \"product_id\", SUM(cma) AS S_w, SUM(cma * CAST(t AS DOUBLE PRECISION)) AS S_wx, SUM(cma * deseas) AS S_wy, SUM(cma * CAST(t AS DOUBLE PRECISION) * deseas) AS S_wxy, SUM(cma * CAST(t AS DOUBLE PRECISION) * CAST(t AS DOUBLE PRECISION)) AS S_wxx FROM deseasonalized GROUP BY \"product_id\"), regression AS (SELECT \"product_id\", CAST((S_w * S_wxy - S_wx * S_wy) AS DOUBLE PRECISION) / NULLIF(S_w * S_wxx - S_wx * S_wx, 0) AS slope, CAST((S_wy - (CAST((S_w * S_wxy - S_wx * S_wy) AS DOUBLE PRECISION) / NULLIF(S_w * S_wxx - S_wx * S_wx, 0)) * S_wx) AS DOUBLE PRECISION) / NULLIF(S_w, 0) AS intercept FROM wls_parts), forecast AS (SELECT b.\"product_id\", b.t, b.cal_month, s.si, (r.intercept + r.slope * CAST(b.t AS DOUBLE PRECISION)) * s.si AS forecasted_sales FROM base AS b JOIN seasonal AS s ON b.\"product_id\" = s.\"product_id\" AND b.cal_month = s.cal_month JOIN regression AS r ON b.\"product_id\" = r.\"product_id\" WHERE b.t BETWEEN 25 AND 36), annual AS (SELECT \"product_id\", SUM(forecasted_sales) AS annual_forecast FROM forecast GROUP BY \"product_id\") SELECT ROUND(CAST(AVG(annual_forecast) AS DECIMAL), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM annual") t0
  ~= (sql%([MONTHLY_SALES_schema]) "WITH base_data AS (SELECT \"product_id\", \"mth\", \"qty\", ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS time_step, EXTRACT(MONTH FROM CAST(TO_TIMESTAMP(\"mth\", 'YYYY-MM-DD') AS DATE)) AS month_num FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790) AND \"mth\" >= '2016-01-01' AND \"mth\" < '2019-01-01'), cma_calc /* Calculate 2x12 Centered Moving Average */ /* MA1 centered at t: average of t-5 to t+6 */ /* MA2 centered at t: average of t-6 to t+5 */ /* CMA = (MA1 + MA2) / 2 */ AS (SELECT a.\"product_id\", a.time_step, a.month_num, a.\"qty\", CAST(((SELECT AVG(b.\"qty\") FROM base_data AS b WHERE b.\"product_id\" = a.\"product_id\" AND b.time_step BETWEEN a.time_step - 5 AND a.time_step + 6) + (SELECT AVG(b.\"qty\") FROM base_data AS b WHERE b.\"product_id\" = a.\"product_id\" AND b.time_step BETWEEN a.time_step - 6 AND a.time_step + 5)) AS DOUBLE PRECISION) / 2.0 AS cma FROM base_data AS a WHERE a.time_step BETWEEN 7 AND 30), ratios /* Sales-to-CMA ratio */ AS (SELECT \"product_id\", time_step, month_num, \"qty\", cma, CASE WHEN cma <> 0 THEN CAST(\"qty\" AS DOUBLE PRECISION) / cma ELSE NULL END AS sales_to_cma FROM cma_calc), seasonal_indices /* Seasonal indices: average of sales-to-CMA ratios by month_num per product */ AS (SELECT \"product_id\", month_num, AVG(sales_to_cma) AS seasonal_index FROM ratios WHERE NOT sales_to_cma IS NULL GROUP BY \"product_id\", month_num), deseasonalized /* Deseasonalize all 36 months */ AS (SELECT b.\"product_id\", b.time_step, b.month_num, b.\"qty\", s.seasonal_index, CASE WHEN s.seasonal_index <> 0 THEN CAST(b.\"qty\" AS DOUBLE PRECISION) / s.seasonal_index ELSE NULL END AS deseas_qty FROM base_data AS b JOIN seasonal_indices AS s ON b.\"product_id\" = s.\"product_id\" AND b.month_num = s.month_num), regression_stats /* Weighted linear regression on deseasonalized data (all 36 months) */ /* Weights = time_step */ /* WLS: minimize sum(w_i * (y_i - a - b*x_i)^2) */ /* Normal equations: */ /* b = (sum(w*x*y) - sum(w*x)*sum(w*y)/sum(w)) / (sum(w*x^2) - (sum(w*x))^2/sum(w)) */ /* a = (sum(w*y) - b*sum(w*x)) / sum(w) */ AS (SELECT \"product_id\", SUM(time_step * deseas_qty * time_step) AS sum_wxy /* sum(w*x*y) where w=x=time_step */, SUM(time_step * time_step) AS sum_wx2 /* sum(w*x^2) */, SUM(time_step * time_step) AS sum_wx /* sum(w*x) -- wait, w=time_step, x=time_step */, SUM(time_step * deseas_qty) AS sum_wy /* sum(w*y) */, SUM(time_step) AS sum_w /* sum(w) */ FROM deseasonalized GROUP BY \"product_id\"), regression_stats2 /* Actually, let me redo this. w_i = time_step_i, x_i = time_step_i, y_i = deseas_qty_i */ /* sum_w = sum(w_i) = sum(time_step) */ /* sum_wx = sum(w_i * x_i) = sum(time_step^2) */ /* sum_wy = sum(w_i * y_i) = sum(time_step * deseas_qty) */ /* sum_wxy = sum(w_i * x_i * y_i) = sum(time_step^2 * deseas_qty) */ /* sum_wx2 = sum(w_i * x_i^2) = sum(time_step^3) */ AS (SELECT \"product_id\", SUM(CAST(time_step AS DOUBLE PRECISION)) AS sum_w, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx, SUM(CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wxy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx2 FROM deseasonalized GROUP BY \"product_id\"), regression_coeffs AS (SELECT \"product_id\", CAST((sum_wxy - CAST(sum_wx * sum_wy AS DOUBLE PRECISION) / sum_w) AS DOUBLE PRECISION) / (sum_wx2 - CAST(sum_wx * sum_wx AS DOUBLE PRECISION) / sum_w) AS slope, CAST((sum_wy - (CAST((sum_wxy - CAST(sum_wx * sum_wy AS DOUBLE PRECISION) / sum_w) AS DOUBLE PRECISION) / (sum_wx2 - CAST(sum_wx * sum_wx AS DOUBLE PRECISION) / sum_w)) * sum_wx) AS DOUBLE PRECISION) / sum_w AS intercept FROM regression_stats2), forecast_months /* Forecast: for each month in 2018 (time steps 25-36), predict deseasonalized value */ /* then re-seasonalize */ AS (SELECT 25 AS time_step, 1 AS month_num UNION ALL SELECT 26, 2 UNION ALL SELECT 27, 3 UNION ALL SELECT 28, 4 UNION ALL SELECT 29, 5 UNION ALL SELECT 30, 6 UNION ALL SELECT 31, 7 UNION ALL SELECT 32, 8 UNION ALL SELECT 33, 9 UNION ALL SELECT 34, 10 UNION ALL SELECT 35, 11 UNION ALL SELECT 36, 12), forecasted AS (SELECT r.\"product_id\", f.time_step, f.month_num, r.intercept + r.slope * f.time_step AS forecast_deseas, s.seasonal_index, (r.intercept + r.slope * f.time_step) * s.seasonal_index AS forecast_seas FROM regression_coeffs AS r CROSS JOIN forecast_months AS f JOIN seasonal_indices AS s ON r.\"product_id\" = s.\"product_id\" AND f.month_num = s.month_num), annual_forecast /* Sum forecasted monthly values to get annual forecast per product */ AS (SELECT \"product_id\", SUM(forecast_seas) AS forecasted_annual_sales FROM forecasted GROUP BY \"product_id\") SELECT ROUND(CAST(AVG(forecasted_annual_sales) AS DECIMAL), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM annual_forecast") t0
