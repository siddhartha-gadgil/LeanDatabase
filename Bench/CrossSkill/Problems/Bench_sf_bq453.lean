/-!
# sf_bq453 — crossskill equivalence(s)

Question: In chromosome 17 between positions 41196311 and 41277499, what are the reference names, start and end positions, reference bases, distinct alternate bases, variant types, and the chi-squared scores (calculated from Hardy-Weinberg equilibrium) along with the total number of genotypes, their observed and expected counts for homozygous reference, heterozygous, and homozygous alternate genotypes, as well as allele frequencies (including those from 1KG), for each variant?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq453

CREATE TABLE VARIANTS («reference_name» STRING, «start» INT, «end» INT, «reference_bases» STRING, «alternate_bases» STRING, «quality» FLOAT, «filter» STRING, «names» STRING, «call» STRING, «AA» STRING, «AC» STRING, «AC1» INT, «AF» FLOAT, «AF1» FLOAT, «AFR_AF» FLOAT, «AMR_AF» FLOAT, «AN» INT, «ASN_AF» FLOAT, «AVGPOST» FLOAT, «CIEND» STRING, «CIPOS» STRING, «DP» INT, «DP4» STRING, «ERATE» FLOAT, «EUR_AF» FLOAT, «FQ» FLOAT, «G3» STRING, «HOMLEN» INT, «HOMSEQ» STRING, «HWE» FLOAT, «LDAF» FLOAT, «MQ» INT, «PV4» STRING, «RSQ» FLOAT, «SNPSOURCE» STRING, «SOURCE» STRING, «SVLEN» INT, «SVTYPE» STRING, «THETA» FLOAT, «VT» STRING)

theorem eq_0_1 :
    sql%([VARIANTS_schema]) "WITH genotype_counts AS (\n  SELECT\n    v.\"reference_name\",\n    v.\"start\",\n    v.\"end\",\n    v.\"reference_bases\",\n    v.\"alternate_bases\" AS DISTINCT_ALTERNATE_BASES,\n    v.\"VT\" AS VARIANT_TYPE,\n    v.\"AF\" AS KG_OVERALL_ALT_ALLELE_FREQ,\n    v.\"AFR_AF\",\n    v.\"EUR_AF\",\n    v.\"AMR_AF\",\n    v.\"ASN_AF\",\n    COUNT(*) AS TOTAL_GENOTYPES,\n    SUM(CASE WHEN f.value:genotype[0]::INT = 0 AND f.value:genotype[1]::INT = 0 THEN 1 ELSE 0 END) AS OBS_HOM_REF,\n    SUM(CASE WHEN (f.value:genotype[0]::INT = 0 AND f.value:genotype[1]::INT = 1)\n              OR (f.value:genotype[0]::INT = 1 AND f.value:genotype[1]::INT = 0) THEN 1 ELSE 0 END) AS OBS_HET,\n    SUM(CASE WHEN f.value:genotype[0]::INT = 1 AND f.value:genotype[1]::INT = 1 THEN 1 ELSE 0 END) AS OBS_HOM_ALT\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") f\n  WHERE v.\"reference_name\" = '17'\n    AND v.\"start\" >= 41196311\n    AND v.\"start\" <= 41277499\n  GROUP BY\n    v.\"reference_name\",\n    v.\"start\",\n    v.\"end\",\n    v.\"reference_bases\",\n    v.\"alternate_bases\",\n    v.\"VT\",\n    v.\"AF\",\n    v.\"AFR_AF\",\n    v.\"EUR_AF\",\n    v.\"AMR_AF\",\n    v.\"ASN_AF\"\n),\nhwe_calc AS (\n  SELECT\n    \"reference_name\",\n    \"start\",\n    \"end\",\n    \"reference_bases\",\n    DISTINCT_ALTERNATE_BASES,\n    VARIANT_TYPE,\n    TOTAL_GENOTYPES,\n    OBS_HOM_REF,\n    OBS_HET,\n    OBS_HOM_ALT,\n    -- Compute allele frequencies from observed genotype counts\n    (2.0 * OBS_HOM_REF + OBS_HET) / (2.0 * TOTAL_GENOTYPES) AS COMPUTED_REF_ALLELE_FREQ,\n    (2.0 * OBS_HOM_ALT + OBS_HET) / (2.0 * TOTAL_GENOTYPES) AS COMPUTED_ALT_ALLELE_FREQ,\n    KG_OVERALL_ALT_ALLELE_FREQ,\n    AFR_AF,\n    EUR_AF,\n    AMR_AF,\n    ASN_AF\n  FROM genotype_counts\n)\nSELECT\n  \"reference_name\",\n  \"start\",\n  \"end\",\n  \"reference_bases\",\n  DISTINCT_ALTERNATE_BASES,\n  VARIANT_TYPE,\n  -- HWE chi-squared: sum of (obs - exp)^2 / exp for the 3 genotype classes\n  POWER(OBS_HOM_REF - (POWER(COMPUTED_REF_ALLELE_FREQ, 2) * TOTAL_GENOTYPES), 2)\n    / (POWER(COMPUTED_REF_ALLELE_FREQ, 2) * TOTAL_GENOTYPES)\n  + POWER(OBS_HET - (2.0 * COMPUTED_REF_ALLELE_FREQ * COMPUTED_ALT_ALLELE_FREQ * TOTAL_GENOTYPES), 2)\n    / (2.0 * COMPUTED_REF_ALLELE_FREQ * COMPUTED_ALT_ALLELE_FREQ * TOTAL_GENOTYPES)\n  + POWER(OBS_HOM_ALT - (POWER(COMPUTED_ALT_ALLELE_FREQ, 2) * TOTAL_GENOTYPES), 2)\n    / (POWER(COMPUTED_ALT_ALLELE_FREQ, 2) * TOTAL_GENOTYPES)\n  AS HWE_CHI_SQUARED,\n  TOTAL_GENOTYPES,\n  OBS_HOM_REF,\n  OBS_HET,\n  OBS_HOM_ALT,\n  POWER(COMPUTED_REF_ALLELE_FREQ, 2) * TOTAL_GENOTYPES AS EXP_HOM_REF,\n  2.0 * COMPUTED_REF_ALLELE_FREQ * COMPUTED_ALT_ALLELE_FREQ * TOTAL_GENOTYPES AS EXP_HET,\n  POWER(COMPUTED_ALT_ALLELE_FREQ, 2) * TOTAL_GENOTYPES AS EXP_HOM_ALT,\n  COMPUTED_REF_ALLELE_FREQ,\n  COMPUTED_ALT_ALLELE_FREQ,\n  KG_OVERALL_ALT_ALLELE_FREQ,\n  AFR_AF,\n  EUR_AF,\n  AMR_AF,\n  ASN_AF\nFROM hwe_calc\nORDER BY \"start\";" = sql%([VARIANTS_schema]) "WITH genotype_counts AS (\n  SELECT\n    v.\"reference_name\",\n    v.\"start\",\n    v.\"end\",\n    v.\"reference_bases\",\n    v.\"alternate_bases\" AS DISTINCT_ALTERNATE_BASES,\n    v.\"VT\" AS VARIANT_TYPE,\n    v.\"AF\" AS KG_OVERALL_ALT_ALLELE_FREQ,\n    v.\"AFR_AF\",\n    v.\"EUR_AF\",\n    v.\"AMR_AF\",\n    v.\"ASN_AF\",\n    COUNT(*) AS TOTAL_GENOTYPES,\n    SUM(CASE WHEN c.value:genotype[0]::INT = 0 AND c.value:genotype[1]::INT = 0 THEN 1 ELSE 0 END) AS OBS_HOM_REF,\n    SUM(CASE WHEN (c.value:genotype[0]::INT + c.value:genotype[1]::INT) = 1 THEN 1 ELSE 0 END) AS OBS_HET,\n    SUM(CASE WHEN c.value:genotype[0]::INT = 1 AND c.value:genotype[1]::INT = 1 THEN 1 ELSE 0 END) AS OBS_HOM_ALT\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n    LATERAL FLATTEN(input => v.\"call\") c\n  WHERE v.\"reference_name\" = '17'\n    AND v.\"start\" >= 41196311\n    AND v.\"start\" <= 41277499\n  GROUP BY\n    v.\"reference_name\",\n    v.\"start\",\n    v.\"end\",\n    v.\"reference_bases\",\n    v.\"alternate_bases\",\n    v.\"VT\",\n    v.\"AF\",\n    v.\"AFR_AF\",\n    v.\"EUR_AF\",\n    v.\"AMR_AF\",\n    v.\"ASN_AF\"\n),\nallele_freqs AS (\n  SELECT\n    *,\n    (2.0 * OBS_HOM_ALT + OBS_HET) / (2.0 * TOTAL_GENOTYPES) AS COMPUTED_ALT_ALLELE_FREQ,\n    1.0 - (2.0 * OBS_HOM_ALT + OBS_HET) / (2.0 * TOTAL_GENOTYPES) AS COMPUTED_REF_ALLELE_FREQ\n  FROM genotype_counts\n),\nexpected_counts AS (\n  SELECT\n    *,\n    POWER(COMPUTED_REF_ALLELE_FREQ, 2) * TOTAL_GENOTYPES AS EXP_HOM_REF,\n    2.0 * COMPUTED_REF_ALLELE_FREQ * COMPUTED_ALT_ALLELE_FREQ * TOTAL_GENOTYPES AS EXP_HET,\n    POWER(COMPUTED_ALT_ALLELE_FREQ, 2) * TOTAL_GENOTYPES AS EXP_HOM_ALT\n  FROM allele_freqs\n)\nSELECT\n  \"reference_name\",\n  \"start\",\n  \"end\",\n  \"reference_bases\",\n  DISTINCT_ALTERNATE_BASES,\n  VARIANT_TYPE,\n  POWER(OBS_HOM_REF - EXP_HOM_REF, 2) / EXP_HOM_REF\n    + POWER(OBS_HET - EXP_HET, 2) / EXP_HET\n    + POWER(OBS_HOM_ALT - EXP_HOM_ALT, 2) / EXP_HOM_ALT AS HWE_CHI_SQUARED,\n  TOTAL_GENOTYPES,\n  OBS_HOM_REF,\n  OBS_HET,\n  OBS_HOM_ALT,\n  EXP_HOM_REF,\n  EXP_HET,\n  EXP_HOM_ALT,\n  COMPUTED_REF_ALLELE_FREQ,\n  COMPUTED_ALT_ALLELE_FREQ,\n  KG_OVERALL_ALT_ALLELE_FREQ,\n  AFR_AF,\n  EUR_AF,\n  AMR_AF,\n  ASN_AF\nFROM expected_counts\nORDER BY \"start\";" := by
  first | sql_equiv | sorry

