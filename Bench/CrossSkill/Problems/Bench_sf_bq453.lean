 v.\"reference_name\" = '17' AND v.\"start\" >= 41196311 AND v.\"start\" <= 41277499 GROUP BY v.\"reference_name\", v.\"start\", v.\"end\", v.\"reference_bases\", v.\"alternate_bases\", v.\"VT\", v.\"AF\", v.\"AFR_AF\", v.\"EUR_AF\", v.\"AMR_AF\", v.\"ASN_AF\"), allele_freqs AS (SELECT *, CAST((2.0 * OBS_HOM_ALT + OBS_HET) AS DOUBLE PRECISION) / (2.0 * TOTAL_GENOTYPES) AS COMPUTED_ALT_ALLELE_FREQ, 1.0 - CAST((2.0 * OBS_HOM_ALT + OBS_HET) AS DOUBLE PRECISION) / (2.0 * TOTAL_GENOTYPES) AS COMPUTED_REF_ALLELE_FREQ FROM genotype_counts), expected_counts AS (SELECT *, POWER(COMPUTED_REF_ALLELE_FREQ, 2) * TOTAL_GENOTYPES AS EXP_HOM_REF, 2.0 * COMPUTED_REF_ALLELE_FREQ * COMPUTED_ALT_ALLELE_FREQ * TOTAL_GENOTYPES AS EXP_HET, POWER(COMPUTED_ALT_ALLELE_FREQ, 2) * TOTAL_GENOTYPES AS EXP_HOM_ALT FROM allele_freqs) SELECT \"reference_name\", \"start\", \"end\", \"reference_bases\", DISTINCT_ALTERNATE_BASES, VARIANT_TYPE, CAST(POWER(OBS_HOM_REF - EXP_HOM_REF, 2) AS DOUBLE PRECISION) / EXP_HOM_REF + CAST(POWER(OBS_HET - EXP_HET, 2) AS DOUBLE PRECISION) / EXP_HET + CAST(POWER(OBS_HOM_ALT - EXP_HOM_ALT, 2) AS DOUBLE PRECISION) / EXP_HOM_ALT AS HWE_CHI_SQUARED, TOTAL_GENOTYPES, OBS_HOM_REF, OBS_HET, OBS_HOM_ALT, EXP_HOM_REF, EXP_HET, EXP_HOM_ALT, COMPUTED_REF_ALLELE_FREQ, COMPUTED_ALT_ALLELE_FREQ, KG_OVERALL_ALT_ALLELE_FREQ, AFR_AF, EUR_AF, AMR_AF, ASN_AF FROM expected_counts ORDER BY \"start\"" := by
