namespace N_sf_local270_eq_1_2

CREATE TABLE PACKAGING_RELATIONS («packaging_id» INT, «contains_id» INT, «qty» INT)
CREATE TABLE PACKAGING («id» INT, «name» STRING)

theorem eq (t0 : TableRel PACKAGING_RELATIONS_schema) (t1 : TableRel PACKAGING_schema) :
    (sql%([PACKAGING_RELATIONS_schema, PACKAGING_schema]) "WITH top_level AS (/* Top-level containers: ids that never appear as contains_id */ SELECT \"id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" WHERE \"id\" <> ALL (SELECT \"contains_id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\")), leaf_items AS (/* Leaf items: ids that never appear as packaging_id */ SELECT \"id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" WHERE \"id\" <> ALL (SELECT \"packaging_id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\")), rec AS (/* Anchor: start from each top-level container, walking into its direct children */ SELECT t.\"id\" AS top_level_id, r.\"contains_id\" AS current_id, r.\"qty\" AS accumulated_qty FROM top_level AS t JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" AS r ON r.\"packaging_id\" = t.\"id\" UNION ALL /* Recursive step: walk further down the hierarchy, multiplying quantities */ SELECT rec.top_level_id, r.\"contains_id\" AS current_id, rec.accumulated_qty * r.\"qty\" AS accumulated_qty FROM rec JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" AS r ON r.\"packaging_id\" = rec.current_id) SELECT p_top.\"name\" AS CONTAINER_NAME, p_leaf.\"name\" AS ITEM_NAME, SUM(rec.accumulated_qty) AS TOTAL_QUANTITY FROM rec JOIN leaf_items AS li ON rec.current_id = li.\"id\" JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" AS p_top ON p_top.\"id\" = rec.top_level_id JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" AS p_leaf ON p_leaf.\"id\" = rec.current_id GROUP BY p_top.\"name\", p_leaf.\"name\" HAVING SUM(rec.accumulated_qty) > 500 ORDER BY TOTAL_QUANTITY DESC") t0 t1
  ~= (sql%([PACKAGING_RELATIONS_schema, PACKAGING_schema]) "WITH RECURSIVE items /* Identify items (leaves): packaging ids that never appear as packaging_id in relations */ AS (SELECT \"id\" AS item_id FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" AS p WHERE NOT EXISTS(SELECT 1 FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" AS r WHERE r.\"packaging_id\" = p.\"id\")), top_level /* Identify top-level containers: packaging ids that never appear as contains_id in relations */ AS (SELECT \"id\" AS container_id FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" AS p WHERE NOT EXISTS(SELECT 1 FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" AS r WHERE r.\"contains_id\" = p.\"id\")), hierarchy /* Recursive traversal from top-level containers down to items */ /* Track: top-level container, current node, cumulative quantity */ AS (/* Base: top-level containers contain themselves with qty 1 */ SELECT t.container_id AS top_container_id, t.container_id AS current_id, 1 AS cumulative_qty FROM top_level AS t UNION ALL /* Recurse: follow packaging_relations */ SELECT h.top_container_id, r.\"contains_id\" AS current_id, h.cumulative_qty * r.\"qty\" AS cumulative_qty FROM hierarchy AS h JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" AS r ON r.\"packaging_id\" = h.current_id) /* Final: for each top-level container, sum up quantities of each item */ SELECT pc.\"name\" AS \"CONTAINER_NAME\", pi.\"name\" AS \"ITEM_NAME\", SUM(h.cumulative_qty) AS \"TOTAL_QUANTITY\" FROM hierarchy AS h JOIN items AS i ON h.current_id = i.item_id JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" AS pc ON pc.\"id\" = h.top_container_id JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" AS pi ON pi.\"id\" = h.current_id GROUP BY pc.\"name\", pi.\"name\" HAVING SUM(h.cumulative_qty) > 500 ORDER BY SUM(h.cumulative_qty) DESC") t0 t1
  := by first | sql_equiv | sorry

