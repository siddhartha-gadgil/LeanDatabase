        tv.\"lead_alt\" AS ALT,\n        tv.\"pval\" AS pval,\n        tv.\"pval_exponent\",\n        tv.\"pval_mantissa\",\n        ROW_NUMBER() OVER (\n            PARTITION BY vg.\"gene_id\", tv.\"study_id\"\n            ORDER BY tv.\"pval_exponent\" ASC, tv.\"pval_mantissa\" ASC\n        ) AS rn\n    FROM top_disease_variants tv\n    JOIN \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_GENE\" vg\n        ON vg.\"chr_id\" = tv.\"tag_chrom\"\n        AND vg.\"position\" = tv.\"tag_pos\"\n        AND vg.\"ref_allele\" = tv.\"tag_ref\"\n        AND vg.\"alt_allele\" = tv.\"tag_alt\"\n)\nSELECT\n    gene_id,\n    study_id,\n    CHROM,\n    POS,\n    REF,\n    ALT,\n    pval\nFROM with_genes\nWHERE rn = 1\nORDER BY \"pval_exponent\" ASC, \"pval_mantissa\" ASC, gene_id ASC\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

