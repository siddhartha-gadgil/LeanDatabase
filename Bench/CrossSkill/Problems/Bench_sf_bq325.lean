theorem eq_0_1 :
    sql%([VARIANT_GENE_schema, DISEASE_VARIANT_GENE_schema, VARIANTS_schema, VARIANT_DISEASE_schema]) "WITH gene_study_min AS (\n  SELECT\n    \"gene_id\",\n    \"study_id\",\n    MIN(\"pval_exponent\") AS min_exp\n  FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"DISEASE_VARIANT_GENE\"\n  GROUP BY \"gene_id\", \"study_id\"\n),\ntop10 AS (\n  SELECT \"gene_id\", \"study_id\", min_exp\n  FROM gene_study_min\n  ORDER BY min_exp ASC, \"gene_id\" ASC\n  LIMIT 10\n),\nget_variant AS (\n  SELECT\n    d.\"gene_id\",\n    d.\"study_id\",\n    d.\"lead_chrom\" AS CHROM,\n    d.\"lead_pos\" AS POS,\n    d.\"lead_ref\" AS REF,\n    d.\"lead_alt\" AS ALT,\n    d.\"pval\",\n    ROW_NUMBER() OVER (\n      PARTITION BY d.\"gene_id\", d.\"study_id\"\n      ORDER BY d.\"pval_exponent\" ASC, d.\"pval_mantissa\" ASC, d.\"lead_chrom\" ASC, d.\"lead_pos\" ASC, d.\"lead_ref\" ASC, d.\"lead_alt\" ASC\n    ) AS rn\n  FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"DISEASE_VARIANT_GENE\" d\n  INNER JOIN top10 t\n    ON d.\"gene_id\" = t.\"gene_id\"\n    AND d.\"study_id\" = t.\"study_id\"\n)\nSELECT \"gene_id\", \"study_id\", CHROM, POS, REF, ALT, \"pval\"\nFROM get_variant\nWHERE rn = 1\nORDER BY \"gene_id\" ASC" = sql%([VARIANT_GENE_schema, DISEASE_VARIANT_GENE_schema, VARIANTS_schema, VARIANT_DISEASE_schema]) "WITH best_per_gene_study AS (\n    SELECT\n        \"gene_id\",\n        \"study_id\",\n        MIN(\"pval_exponent\") AS min_exp\n    FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"DISEASE_VARIANT_GENE\"\n    GROUP BY \"gene_id\", \"study_id\"\n),\nbest_mantissa AS (\n    SELECT\n        d.\"gene_id\",\n        d.\"study_id\",\n        b.min_exp,\n        MIN(d.\"pval_mantissa\") AS min_mantissa\n    FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"DISEASE_VARIANT_GENE\" d\n    JOIN best_per_gene_study b\n        ON d.\"gene_id\" = b.\"gene_id\"\n        AND d.\"study_id\" = b.\"study_id\"\n        AND d.\"pval_exponent\" = b.min_exp\n    GROUP BY d.\"gene_id\", d.\"study_id\", b.min_exp\n),\nglobal_top10 AS (\n    SELECT\n        \"gene_id\",\n        \"study_id\",\n        min_exp,\n        min_mantissa\n    FROM best_mantissa\n    ORDER BY min_exp ASC, min_mantissa ASC\n    LIMIT 10\n),\nwith_variant AS (\n    SELECT\n        t.\"gene_id\",\n        t.\"study_id\",\n        d.\"lead_chrom\" AS \"CHROM\",\n        d.\"lead_pos\" AS \"POS\",\n        d.\"lead_ref\" AS \"REF\",\n        d.\"lead_alt\" AS \"ALT\",\n        d.\"pval\"\n    FROM global_top10 t\n    JOIN \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"DISEASE_VARIANT_GENE\" d\n        ON d.\"gene_id\" = t.\"gene_id\"\n        AND d.\"study_id\" = t.\"study_id\"\n        AND d.\"pval_exponent\" = t.min_exp\n        AND d.\"pval_mantissa\" = t.min_mantissa\n    QUALIFY ROW_NUMBER() OVER (PARTITION BY t.\"gene_id\", t.\"study_id\" ORDER BY d.\"lead_chrom\") = 1\n)\nSELECT\n    \"gene_id\",\n    \"study_id\",\n    \"CHROM\",\n    \"POS\",\n    \"REF\",\n    \"ALT\",\n    \"pval\"\nFROM with_variant\nORDER BY \"gene_id\";" := by
  first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
