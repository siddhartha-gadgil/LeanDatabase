theorem eq_2_3 : ∀ t,
    (sql%([VARIANT_GENE_schema, DISEASE_VARIANT_GENE_schema, VARIANTS_schema, VARIANT_DISEASE_schema]) "WITH top_disease_variants AS (\n    SELECT\n        \"study_id\",\n        \"lead_chrom\",\n        \"lead_pos\",\n        \"lead_ref\",\n        \"lead_alt\",\n        \"tag_chrom\",\n        \"tag_pos\",\n        \"tag_ref\",\n        \"tag_alt\",\n        \"pval\",\n        \"pval_exponent\",\n        \"pval_mantissa\"\n    FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_DISEASE\"\n    WHERE \"pval_exponent\" <= -26677\n),\nwith_genes AS (\n    SELECT\n        vg.\"gene_id\" AS gene_id,\n        tv.\"study_id\" AS study_id,\n        tv.\"lead_chrom\" AS CHROM,\n        tv.\"lead_pos\" AS POS,\n        tv.\"lead_ref\" AS REF,\n        tv.\"lead_alt\" AS ALT,\n        tv.\"pval\" AS pval,\n        tv.\"pval_exponent\",\n        tv.\"pval_mantissa\",\n        ROW_NUMBER() OVER (\n            PARTITION BY vg.\"gene_id\", tv.\"study_id\"\n            ORDER BY tv.\"pval_exponent\" ASC, tv.\"pval_mantissa\" ASC\n        ) AS rn\n    FROM top_disease_variants tv\n    JOIN \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_GENE\" vg\n        ON vg.\"chr_id\" = tv.\"tag_chrom\"\n        AND vg.\"position\" = tv.\"tag_pos\"\n        AND vg.\"ref_allele\" = tv.\"tag_ref\"\n        AND vg.\"alt_allele\" = tv.\"tag_alt\"\n)\nSELECT\n    gene_id,\n    study_id,\n    CHROM,\n    POS,\n    REF,\n    ALT,\n    pval\nFROM with_genes\nWHERE rn = 1\nORDER BY \"pval_exponent\" ASC, \"pval_mantissa\" ASC, gene_id ASC\nLIMIT 10;") t ~= (sql%([VARIANT_GENE_schema, DISEASE_VARIANT_GENE_schema, VARIANTS_schema, VARIANT_DISEASE_schema]) "-- Strategy: First get each study's variant with lowest pval from VARIANT_DISEASE (22.9M rows),\n-- then join with VARIANT_GENE to get gene mappings, then rank per gene-study.\n-- Step 1: For each study, get all variants - but we want per gene-study.\n-- Since gene comes from VARIANT_GENE, we need to join first, then aggregate.\n-- Optimization: first get the top candidate variants from VARIANT_DISEASE,\n-- then join with VARIANT_GENE for gene mapping.\n\nWITH top_variants AS (\n    SELECT\n        \"study_id\",\n        \"tag_chrom\",\n        \"tag_pos\",\n        \"tag_ref\",\n        \"tag_alt\",\n        \"pval\"\n    FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_DISEASE\"\n    WHERE \"pval\" IS NOT NULL\n    ORDER BY \"pval\" ASC\n    LIMIT 1000\n),\ngene_variant_study AS (\n    SELECT\n        vg.\"gene_id\",\n        tv.\"study_id\",\n        tv.\"tag_chrom\" AS \"CHROM\",\n        tv.\"tag_pos\" AS \"POS\",\n        tv.\"tag_ref\" AS \"REF\",\n        tv.\"tag_alt\" AS \"ALT\",\n        tv.\"pval\"\n    FROM top_variants tv\n    JOIN \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_GENE\" vg\n        ON tv.\"tag_chrom\" = vg.\"chr_id\"\n        AND tv.\"tag_pos\" = vg.\"position\"\n        AND tv.\"tag_ref\" = vg.\"ref_allele\"\n        AND tv.\"tag_alt\" = vg.\"alt_allele\"\n)\nSELECT\n    \"gene_id\",\n    \"study_id\",\n    \"CHROM\",\n    \"POS\",\n    \"REF\",\n    \"ALT\",\n    \"pval\"\nFROM gene_variant_study\nQUALIFY ROW_NUMBER() OVER (\n    PARTITION BY \"gene_id\", \"study_id\"\n    ORDER BY \"pval\" ASC\n) = 1\nORDER BY \"pval\" ASC\nLIMIT 10;") t := by
