import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq290 — crossskill equivalence(s)

Question: Can you calculate the difference in maximum temperature, minimum temperature, and average temperature between US and UK weather stations for each day in October 2023, using the date field, and excluding records with missing or invalid temperature values?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq290

CREATE TABLE STATIONS («usaf» STRING, «wban» STRING, «name» STRING, «country» STRING, «state» STRING, «call» STRING, «lat» FLOAT, «lon» FLOAT, «elev» STRING, «begin» STRING, «end» STRING)
CREATE TABLE GSOD2023 («stn» STRING, «wban» STRING, «date» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([STATIONS_schema, GSOD2023_schema]) "WITH us_daily AS (\n  SELECT \n    g.\"date\",\n    AVG(CASE WHEN g.\"max\" != 9999.9 THEN g.\"max\" END) AS avg_max_temp,\n    AVG(CASE WHEN g.\"min\" != 9999.9 THEN g.\"min\" END) AS avg_min_temp,\n    AVG(CASE WHEN g.\"temp\" != 9999.9 THEN g.\"temp\" END) AS avg_temp\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"country\" = 'US'\n    AND g.\"date\" >= '2023-10-01' AND g.\"date\" <= '2023-10-31'\n    AND g.\"max\" != 9999.9\n    AND g.\"min\" != 9999.9\n    AND g.\"temp\" != 9999.9\n  GROUP BY g.\"date\"\n),\nuk_daily AS (\n  SELECT \n    g.\"date\",\n    AVG(CASE WHEN g.\"max\" != 9999.9 THEN g.\"max\" END) AS avg_max_temp,\n    AVG(CASE WHEN g.\"min\" != 9999.9 THEN g.\"min\" END) AS avg_min_temp,\n    AVG(CASE WHEN g.\"temp\" != 9999.9 THEN g.\"temp\" END) AS avg_temp\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"country\" = 'UK'\n    AND g.\"date\" >= '2023-10-01' AND g.\"date\" <= '2023-10-31'\n    AND g.\"max\" != 9999.9\n    AND g.\"min\" != 9999.9\n    AND g.\"temp\" != 9999.9\n  GROUP BY g.\"date\"\n)\nSELECT \n  u.\"date\",\n  u.avg_max_temp - k.avg_max_temp AS DIFF_MAX_TEMP,\n  u.avg_min_temp - k.avg_min_temp AS DIFF_MIN_TEMP,\n  u.avg_temp - k.avg_temp AS DIFF_AVG_TEMP\nFROM us_daily u\nJOIN uk_daily k ON u.\"date\" = k.\"date\"\nORDER BY u.\"date\";") t ~= (sql%([STATIONS_schema, GSOD2023_schema]) "SELECT\n  g.\"date\" AS date,\n  AVG(CASE WHEN s.\"country\" = 'US' THEN g.\"max\" END) - AVG(CASE WHEN s.\"country\" = 'UK' THEN g.\"max\" END) AS DIFF_MAX_TEMP,\n  AVG(CASE WHEN s.\"country\" = 'US' THEN g.\"min\" END) - AVG(CASE WHEN s.\"country\" = 'UK' THEN g.\"min\" END) AS DIFF_MIN_TEMP,\n  AVG(CASE WHEN s.\"country\" = 'US' THEN g.\"temp\" END) - AVG(CASE WHEN s.\"country\" = 'UK' THEN g.\"temp\" END) AS DIFF_AVG_TEMP\nFROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\nJOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s\n  ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\nWHERE s.\"country\" IN ('US', 'UK')\n  AND g.\"date\" >= '2023-10-01'\n  AND g.\"date\" < '2023-11-01'\n  AND g.\"temp\" != 9999.9\n  AND g.\"max\" != 9999.9\n  AND g.\"min\" != 9999.9\nGROUP BY g.\"date\"\nORDER BY g.\"date\";") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([STATIONS_schema, GSOD2023_schema]) "WITH us_daily AS (\n  SELECT \n    g.\"date\",\n    AVG(CASE WHEN g.\"max\" != 9999.9 THEN g.\"max\" END) AS avg_max_temp,\n    AVG(CASE WHEN g.\"min\" != 9999.9 THEN g.\"min\" END) AS avg_min_temp,\n    AVG(CASE WHEN g.\"temp\" != 9999.9 THEN g.\"temp\" END) AS avg_temp\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"country\" = 'US'\n    AND g.\"date\" >= '2023-10-01' AND g.\"date\" <= '2023-10-31'\n    AND g.\"max\" != 9999.9\n    AND g.\"min\" != 9999.9\n    AND g.\"temp\" != 9999.9\n  GROUP BY g.\"date\"\n),\nuk_daily AS (\n  SELECT \n    g.\"date\",\n    AVG(CASE WHEN g.\"max\" != 9999.9 THEN g.\"max\" END) AS avg_max_temp,\n    AVG(CASE WHEN g.\"min\" != 9999.9 THEN g.\"min\" END) AS avg_min_temp,\n    AVG(CASE WHEN g.\"temp\" != 9999.9 THEN g.\"temp\" END) AS avg_temp\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"country\" = 'UK'\n    AND g.\"date\" >= '2023-10-01' AND g.\"date\" <= '2023-10-31'\n    AND g.\"max\" != 9999.9\n    AND g.\"min\" != 9999.9\n    AND g.\"temp\" != 9999.9\n  GROUP BY g.\"date\"\n)\nSELECT \n  u.\"date\",\n  u.avg_max_temp - k.avg_max_temp AS DIFF_MAX_TEMP,\n  u.avg_min_temp - k.avg_min_temp AS DIFF_MIN_TEMP,\n  u.avg_temp - k.avg_temp AS DIFF_AVG_TEMP\nFROM us_daily u\nJOIN uk_daily k ON u.\"date\" = k.\"date\"\nORDER BY u.\"date\";" = sql%([STATIONS_schema, GSOD2023_schema]) "WITH us_data AS (\n    SELECT\n        g.\"date\",\n        AVG(g.\"max\") AS avg_max_temp,\n        AVG(g.\"min\") AS avg_min_temp,\n        AVG(g.\"temp\") AS avg_temp\n    FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n    JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s\n        ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n    WHERE s.\"country\" = 'US'\n      AND g.\"mo\" = '10'\n      AND g.\"temp\" != 9999.9\n      AND g.\"max\" != 9999.9\n      AND g.\"min\" != 9999.9\n    GROUP BY g.\"date\"\n),\nuk_data AS (\n    SELECT\n        g.\"date\",\n        AVG(g.\"max\") AS avg_max_temp,\n        AVG(g.\"min\") AS avg_min_temp,\n        AVG(g.\"temp\") AS avg_temp\n    FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n    JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s\n        ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n    WHERE s.\"country\" = 'UK'\n      AND g.\"mo\" = '10'\n      AND g.\"temp\" != 9999.9\n      AND g.\"max\" != 9999.9\n      AND g.\"min\" != 9999.9\n    GROUP BY g.\"date\"\n)\nSELECT\n    u.\"date\",\n    (u.avg_max_temp - k.avg_max_temp) AS DIFF_MAX_TEMP,\n    (u.avg_min_temp - k.avg_min_temp) AS DIFF_MIN_TEMP,\n    (u.avg_temp - k.avg_temp) AS DIFF_AVG_TEMP\nFROM us_data u\nJOIN uk_data k ON u.\"date\" = k.\"date\"\nORDER BY u.\"date\";" := by
  first | sql_equiv | sorry

