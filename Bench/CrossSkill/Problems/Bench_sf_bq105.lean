\"ACCIDENTS\" * 100000.0 / sp.\"POPULATION_2010\", 1) AS \"ACCIDENTS_PER_100K\",\n    ROW_NUMBER() OVER (PARTITION BY acc.\"YEAR\" ORDER BY acc.\"ACCIDENTS\" * 100000.0 / sp.\"POPULATION_2010\" DESC) AS \"YEAR_RANK\"\n  FROM all_accidents acc\n  JOIN state_pop sp\n    ON acc.\"state_name\" = sp.\"state_name\"\n)\n\nSELECT\n  \"YEAR\",\n  \"state_name\",\n  \"ACCIDENTS\",\n  \"POPULATION_2010\",\n  \"ACCIDENTS_PER_100K\",\n  \"YEAR_RANK\"\nFROM ranked\nWHERE \"YEAR_RANK\" <= 5\nORDER BY \"YEAR\", \"YEAR_RANK\";") t ~= (sql%([POPULATION_BY_ZIP_2000_schema, DISTRACT_2016_schema, ACCIDENT_2015_schema, DISTRACT_2015_schema, ACCIDENT_2016_schema, US_STATES_AREA_schema, ZIPCODE_AREA_schema]) "WITH pop_2010 AS (\n    SELECT state_number, population FROM (VALUES\n        (1, 4447100),    -- Alabama\n        (2, 626932),     -- Alaska\n        (4, 5130632),    -- Arizona\n        (5, 2673400),    -- Arkansas\n        (6, 33871648),   -- California\n        (8, 4301261),    -- Colorado\n        (9, 3405565),    -- Connecticut\n        (10, 783600),    -- Delaware\n        (11, 572059),    -- District of Columbia\n        (12, 15982378),  -- Florida\n        (13, 8186453),   -- Georgia\n        (15, 1211537),   -- Hawaii\n        (16, 1291872),   -- Idaho\n        (17, 12419293),  -- Illinois\n        (18, 6080485),   -- Indiana\n        (19, 2926324),   -- Iowa\n        (20, 2685048),   -- Kansas\n        (21, 4018948),   -- Kentucky\n        (22, 4462089),   -- Louisiana\n        (23, 1274923),   -- Maine\n        (24, 5296486),   -- Maryland\n        (25, 6349097),   -- Massachusetts\n        (26, 9938444),   -- Michigan\n        (27, 4919479),   -- Minnesota\n        (28, 2844658),   -- Mississippi\n        (29, 5595211),   -- Missouri\n        (30, 900366),    -- Montana\n        (31, 1711263),   -- Nebraska\n        (32, 1998257),   -- Nevada\n        (33, 1235786),   -- New Hampshire\n        (34, 8414350),   -- New Jersey\n        (35, 1809823),   -- New Mexico\n        (36, 18976457),  -- New York\n        (37, 8049313),   -- North Carolina\n        (38, 642200),    -- North Dakota\n        (39, 11353140),  -- Ohio\n        (40, 3450654),   -- Oklahoma\n        (41, 3421399),   -- Oregon\n        (42, 12281054),  -- Pennsylvania\n        (44, 1048319),   -- Rhode Island\n        (45, 4012012),   -- South Carolina\n        (46, 754844),    -- South Dakota\n        (47, 5689283),   -- Tennessee\n        (48, 20851820),  -- Texas\n        (49, 2233169),   -- Utah\n        (50, 608827),    -- Vermont\n        (51, 7078515),   -- Virginia\n        (53, 6068996),   -- Washington\n        (54, 1808344),   -- West Virginia\n        (55, 5363675),   -- Wisconsin\n        (56, 490707)     -- Wyoming\n    ) AS t(state_number, population)\n),\n\ndistract_accidents AS (\n    SELECT 2015 AS \"YEAR\", d.\"state_number\", a.\"state_name\",\n           COUNT(DISTINCT a.\"consecutive_number\") AS \"ACCIDENTS\"\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"DISTRACT_2015\" d\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2015\" a\n      ON d.\"state_number\" = a.\"state_number\" AND d.\"consecutive_number\" = a.\"consecutive_number\"\n    WHERE d.\"driver_distracted_by_name\" NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported')\n    GROUP BY d.\"state_number\", a.\"state_name\"\n\n    UNION ALL\n\n    SELECT 2016 AS \"YEAR\", d.\"state_number\", a.\"state_name\",\n           COUNT(DISTINCT a.\"consecutive_number\") AS \"ACCIDENTS\"\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"DISTRACT_2016\" d\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" a\n      ON d.\"state_number\" = a.\"state_number\" AND d.\"consecutive_number\" = a.\"consecutive_number\"\n    WHERE d.\"driver_distracted_by_name\" NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported')\n    GROUP BY d.\"state_number\", a.\"state_name\"\n),\n\nranked AS (\n    SELECT \n        da.\"YEAR\",\n        da.\"state_name\",\n        da.\"ACCIDENTS\",\n        p.population AS \"POPULATION_2010\",\n        ROUND(da.\"ACCIDENTS\" * 100000.0 / p.population, 1) AS \"ACCIDENTS_PER_100K\",\n        ROW_NUMBER() OVER (PARTITION BY da.\"YEAR\" ORDER BY da.\"ACCIDENTS\" * 100000.0 / p.population DESC) AS \"YEAR_RANK\"\n    FROM distract_accidents da\n    JOIN pop_2010 p ON da.\"state_number\" = p.state_number\n)\n\nSELECT \"YEAR\", \"state_name\", \"ACCIDENTS\", \"POPULATION_2010\", \"ACCIDENTS_PER_100K\", \"YEAR_RANK\"\nFROM ranked\nWHERE \"YEAR_RANK\" <= 5\nORDER BY \"YEAR\", \"YEAR_RANK\";") t := by
