theorem eq_0_1 :
    sql%([POPULATION_BY_ZIP_2000_schema, DISTRACT_2016_schema, ACCIDENT_2015_schema, DISTRACT_2015_schema, ACCIDENT_2016_schema, US_STATES_AREA_schema, ZIPCODE_AREA_schema]) "WITH state_population AS (\n    -- Aggregate zip-level population to state level using zipcode_area mapping\n    SELECT \n        za.\"state_name\",\n        SUM(p.\"population\") AS POPULATION_2010\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"CENSUS_BUREAU_USA\".\"POPULATION_BY_ZIP_2000\" p\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"UTILITY_US\".\"ZIPCODE_AREA\" za\n        ON p.\"zipcode\" = za.\"zipcode\"\n    WHERE p.\"minimum_age\" IS NULL\n      AND p.\"maximum_age\" IS NULL\n      AND p.\"gender\" = ''\n      AND za.\"state_name\" NOT LIKE '%,%'\n    GROUP BY za.\"state_name\"\n),\ndistracted_accidents_2015 AS (\n    SELECT \n        2015 AS YEAR,\n        a.\"state_name\",\n        COUNT(DISTINCT a.\"consecutive_number\") AS ACCIDENTS\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2015\" a\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"DISTRACT_2015\" d\n        ON a.\"state_number\" = d.\"state_number\" \n        AND a.\"consecutive_number\" = d.\"consecutive_number\"\n    WHERE d.\"driver_distracted_by_name\" NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported')\n    GROUP BY a.\"state_name\"\n),\ndistracted_accidents_2016 AS (\n    SELECT \n        2016 AS YEAR,\n        a.\"state_name\",\n        COUNT(DISTINCT a.\"consecutive_number\") AS ACCIDENTS\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" a\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"DISTRACT_2016\" d\n        ON a.\"state_number\" = d.\"state_number\" \n        AND a.\"consecutive_number\" = d.\"consecutive_number\"\n    WHERE d.\"driver_distracted_by_name\" NOT IN ('Not Distracted', 'Unknown if Distracted', 'Not Reported')\n    GROUP BY a.\"state_name\"\n),\ncombined AS (\n    SELECT * FROM distracted_accidents_2015\n    UNION ALL\n    SELECT * FROM distracted_accidents_2016\n),\nrated AS (\n    SELECT \n        c.YEAR,\n        c.\"state_name\",\n        c.ACCIDENTS,\n        sp.POPULATION_2010,\n        ROUND(c.ACCIDENTS * 100000.0 / sp.POPULATION_2010, 1) AS ACCIDENTS_PER_100K,\n        ROW_NUMBER() OVER (PARTITION BY c.YEAR ORDER BY c.ACCIDENTS * 100000.0 / sp.POPULATION_2010 DESC) AS YEAR_RANK\n    FROM combined c\n    JOIN state_population sp ON c.\"state_name\" = sp.\"state_name\"\n)\nSELECT \n    YEAR,\n    \"state_name\",\n    ACCIDENTS,\n    POPULATION_2010,\n    ACCIDENTS_PER_100K,\n    YEAR_RANK\nFROM rated\nWHERE YEAR_RANK <= 5\nORDER BY YEAR, YEAR_RANK;" = sql%([POPULATION_BY_ZIP_2000_schema, DISTRACT_2016_schema, ACCIDENT_2015_schema, DISTRACT_2015_schema, ACCIDENT_2016_schema, US_STATES_AREA_schema, ZIPCODE_AREA_schema]) "WITH state_population AS (\n    SELECT\n        z.\"state_name\",\n        SUM(p.\"population\") AS population_2010\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"CENSUS_BUREAU_USA\".\"POPULATION_BY_ZIP_2000\" p\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"UTILITY_US\".\"ZIPCODE_AREA\" z\n        ON p.\"zipcode\" = z.\"zipcode\"\n    WHERE p.\"gender\" = ''\n      AND p.\"minimum_age\" IS NULL\n      AND p.\"maximum_age\" IS NULL\n      AND z.\"state_name\" NOT LIKE '%,%'\n    GROUP BY z.\"state_name\"\n),\ndistracted_accidents AS (\n    SELECT\n        a.\"state_name\",\n        2015 AS year,\n        COUNT(DISTINCT d.\"consecutive_number\") AS accidents\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"DISTRACT_2015\" d\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2015\" a\n        ON d.\"state_number\" = a.\"state_number\"\n        AND d.\"consecutive_number\" = a.\"consecutive_number\"\n    WHERE d.\"driver_distracted_by_name\" NOT IN (\n        'Not Distracted', 'Unknown if Distracted', 'Not Reported'\n    )\n    GROUP BY a.\"state_name\"\n\n    UNION ALL\n\n    SELECT\n        a.\"state_name\",\n        2016 AS year,\n        COUNT(DISTINCT d.\"consecutive_number\") AS accidents\n    FROM \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"DISTRACT_2016\" d\n    JOIN \"NHTSA_TRAFFIC_FATALITIES_PLUS\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" a\n        ON d.\"state_number\" = a.\"state_number\"\n        AND d.\"consecutive_number\" = a.\"consecutive_number\"\n    WHERE d.\"driver_distracted_by_name\" NOT IN (\n        'Not Distracted', 'Unknown if Distracted', 'Not Reported'\n    )\n    GROUP BY a.\"state_name\"\n),\nranked AS (\n    SELECT\n        da.year,\n        da.\"state_name\",\n        da.accidents,\n        sp.population_2010,\n        ROUND(da.accidents / sp.population_2010 * 100000, 1) AS accidents_per_100k,\n        RANK() OVER (PARTITION BY da.year ORDER BY ROUND(da.accidents / sp.population_2010 * 100000, 1) DESC) AS year_rank\n    FROM distracted_accidents da\n    JOIN state_population sp ON da.\"state_name\" = sp.\"state_name\"\n)\nSELECT\n    year,\n    \"state_name\",\n    accidents,\n    population_2010,\n    accidents_per_100k,\n    year_rank\nFROM ranked\nWHERE year_rank <= 5\nORDER BY year, year_rank;" := by
