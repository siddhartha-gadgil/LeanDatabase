 \"ORACLE_SQL\".\"ORACLE_SQL\".\"PICKING_LINE\" AS pl GROUP BY pl.\"product_id\", pl.\"order_id\"), inventory_fifo AS (SELECT i.\"PRODUCTID\" AS product_id, i.\"QUANTITY\" AS available_qty, i.\"PURCHASEDATE\", ROW_NUMBER() OVER (PARTITION BY i.\"PRODUCTID\" ORDER BY i.\"PURCHASEDATE\", i.\"QUANTITY\") AS rn FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"INVENTORY\" AS i), matched AS (SELECT op.product_id, op.order_id, op.order_qty, COALESCE(inv.available_qty, 0) AS available_qty, LEAST(op.order_qty, COALESCE(inv.available_qty, 0)) AS picked_qty FROM order_products AS op LEFT JOIN inventory_fifo AS inv ON op.product_id = inv.product_id), pick_pct AS (SELECT product_id, CASE WHEN order_qty > 0 THEN CAST(picked_qty AS DOUBLE PRECISION) / order_qty ELSE 0 END AS pick_percentage FROM matched) SELECT product_id AS PRODUCT_NAME, AVG(pick_percentage) AS AVG_PICK_PERCENTAGE FROM pick_pct GROUP BY product_id ORDER BY product_id") t := by
