theorem eq_0_1 :
    sql%([INPATIENT_CHARGES_2011_schema, INPATIENT_CHARGES_2014_schema, OUTPATIENT_CHARGES_2012_schema, OUTPATIENT_CHARGES_2014_schema, INPATIENT_CHARGES_2012_schema, INPATIENT_CHARGES_2013_schema, INPATIENT_CHARGES_2015_schema, OUTPATIENT_CHARGES_2011_schema, OUTPATIENT_CHARGES_2013_schema, OUTPATIENT_CHARGES_2015_schema, COST_schema, PROVIDER_schema]) "WITH all_inpatient AS (\n  SELECT 2011 AS year, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2011\"\n  UNION ALL\n  SELECT 2012, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2012\"\n  UNION ALL\n  SELECT 2013, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2013\"\n  UNION ALL\n  SELECT 2014, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2014\"\n  UNION ALL\n  SELECT 2015, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2015\"\n),\nall_outpatient AS (\n  SELECT 2011 AS year, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2011\"\n  UNION ALL\n  SELECT 2012, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2012\"\n  UNION ALL\n  SELECT 2013, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2013\"\n  UNION ALL\n  SELECT 2014, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2014\"\n  UNION ALL\n  SELECT 2015, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2015\"\n),\n-- Find the provider with highest total inpatient Medicare cost\ntop_provider AS (\n  SELECT \"provider_id\"\n  FROM all_inpatient\n  GROUP BY \"provider_id\"\n  ORDER BY SUM(\"average_medicare_payments\" * \"total_discharges\") DESC\n  LIMIT 1\n),\n-- Yearly average inpatient cost for the top provider\ninpatient_yearly AS (\n  SELECT\n    i.year AS YEAR,\n    i.\"provider_id\" AS PROVIDER_ID,\n    i.\"provider_name\" AS PROVIDER_NAME,\n    AVG(i.\"average_medicare_payments\" * i.\"total_discharges\") AS AVG_INPATIENT_COST\n  FROM all_inpatient i\n  JOIN top_provider t ON i.\"provider_id\" = t.\"provider_id\"\n  GROUP BY i.year, i.\"provider_id\", i.\"provider_name\"\n),\n-- Yearly average outpatient cost for the top provider\noutpatient_yearly AS (\n  SELECT\n    o.year AS YEAR,\n    o.\"provider_id\" AS PROVIDER_ID,\n    AVG(o.\"average_total_payments\" * o.\"outpatient_services\") AS AVG_OUTPATIENT_COST\n  FROM all_outpatient o\n  JOIN top_provider t ON o.\"provider_id\" = t.\"provider_id\"\n  GROUP BY o.year, o.\"provider_id\"\n)\nSELECT\n  ip.YEAR,\n  ip.PROVIDER_ID,\n  ip.PROVIDER_NAME,\n  ip.AVG_INPATIENT_COST,\n  op.AVG_OUTPATIENT_COST\nFROM inpatient_yearly ip\nJOIN outpatient_yearly op\n  ON ip.PROVIDER_ID = op.PROVIDER_ID AND ip.YEAR = op.YEAR\nORDER BY ip.YEAR;" = sql%([INPATIENT_CHARGES_2011_schema, INPATIENT_CHARGES_2014_schema, OUTPATIENT_CHARGES_2012_schema, OUTPATIENT_CHARGES_2014_schema, INPATIENT_CHARGES_2012_schema, INPATIENT_CHARGES_2013_schema, INPATIENT_CHARGES_2015_schema, OUTPATIENT_CHARGES_2011_schema, OUTPATIENT_CHARGES_2013_schema, OUTPATIENT_CHARGES_2015_schema, COST_schema, PROVIDER_schema]) "WITH all_inpatient AS (\n  SELECT 2011 AS year, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2011\"\n  UNION ALL\n  SELECT 2012, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2012\"\n  UNION ALL\n  SELECT 2013, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2013\"\n  UNION ALL\n  SELECT 2014, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2014\"\n  UNION ALL\n  SELECT 2015, \"provider_id\", \"provider_name\", \"average_medicare_payments\", \"total_discharges\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"INPATIENT_CHARGES_2015\"\n),\ntop_provider AS (\n  SELECT \"provider_id\"\n  FROM all_inpatient\n  GROUP BY \"provider_id\"\n  ORDER BY SUM(\"average_medicare_payments\" * \"total_discharges\") DESC\n  LIMIT 1\n),\ninpatient_yearly AS (\n  SELECT\n    ai.year AS YEAR,\n    ai.\"provider_id\" AS PROVIDER_ID,\n    ai.\"provider_name\" AS PROVIDER_NAME,\n    AVG(ai.\"average_medicare_payments\" * ai.\"total_discharges\") AS AVG_INPATIENT_COST\n  FROM all_inpatient ai\n  JOIN top_provider tp ON ai.\"provider_id\" = tp.\"provider_id\"\n  GROUP BY ai.year, ai.\"provider_id\", ai.\"provider_name\"\n),\nall_outpatient AS (\n  SELECT 2011 AS year, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2011\"\n  UNION ALL\n  SELECT 2012, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2012\"\n  UNION ALL\n  SELECT 2013, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2013\"\n  UNION ALL\n  SELECT 2014, \"provider_id\", \"average_total_payments\", \"outpatient_services\" FROM \"CMS_DATA\".\"CMS_MEDICARE\".\"OUTPATIENT_CHARGES_2014\"\n  UNION ALL\n  SELECT 2015, \"provider_id\", \"average_total_payments\", \"outpatient_services\" 