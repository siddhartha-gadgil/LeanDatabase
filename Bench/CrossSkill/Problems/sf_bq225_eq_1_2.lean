theorem eq (t0 : TableRel SAMPLE_FILES_schema) (t1 : TableRel SAMPLE_CONTENTS_schema) :
    (sql%([SAMPLE_FILES_schema, SAMPLE_CONTENTS_schema]) "SELECT language FROM (SELECT language, COUNT(*) AS num_files FROM (SELECT CASE WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('c', 'h') THEN 'C' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('cpp', 'cc', 'cxx') THEN 'C++' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'java' THEN 'Java' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'js' THEN 'JavaScript' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'py' THEN 'Python' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'rb' THEN 'Ruby' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'php' THEN 'PHP' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('html', 'htm') THEN 'HTML' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'css' THEN 'CSS' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'xml' THEN 'XML' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'json' THEN 'JSON' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'cs' THEN 'C#' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'swift' THEN 'Swift' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'go' THEN 'Go' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'rs' THEN 'Rust' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'ts' THEN 'TypeScript' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'scala' THEN 'Scala' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'pl' THEN 'Perl' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'sh' THEN 'Shell' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'r' THEN 'R' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'lua' THEN 'Lua' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'm' THEN 'MATLAB' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'sql' THEN 'SQL' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) IN ('yml', 'yaml') THEN 'YAML' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'md' THEN 'Markdown' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'coffee' THEN 'CoffeeScript' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'kt' THEN 'Kotlin' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'dart' THEN 'Dart' WHEN LOWER(REVERSE(SPLIT_PART(REVERSE(f.\"path\"), '.', 1))) = 'groovy' THEN 'Groovy' ELSE NULL END AS language FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_FILES\" AS f INNER JOIN \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS c ON f.\"id\" = c.\"id\" WHERE NOT c.\"content\" IS NULL AND f.\"path\" LIKE '%.%') AS sub WHERE NOT language IS NULL GROUP BY language ORDER BY num_files DESC, language ASC LIMIT 10) AS final") t0 t1
  ~= (sql%([SAMPLE_FILES_schema, SAMPLE_CONTENTS_schema]) "WITH file_extensions AS (SELECT f.\"id\", f.\"path\", LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) AS ext FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_FILES\" AS f INNER JOIN \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS c ON f.\"id\" = c.\"id\" WHERE NOT c.\"content\" IS NULL AND c.\"content\" <> '' AND c.\"binary\" = FALSE), lang_map AS (SELECT ext, language FROM (SELECT '.asm' AS ext, 'Assembly' AS language UNION ALL SELECT '.nasm', 'Assembly' UNION ALL SELECT '.c', 'C' UNION ALL SELECT '.h', 'C' UNION ALL SELECT '.cs', 'C#' UNION ALL SELECT '.c++', 'C++' UNION ALL SELECT '.cpp', 'C++' UNION ALL SELECT '.h++', 'C++' UNION ALL SELECT '.hpp', 'C++' UNION ALL SELECT '.css', 'CSS' UNION ALL SELECT '.clj', 'Clojure' UNION ALL SELECT '.lisp', 'Common Lisp' UNION ALL SELECT '.d', 'D' UNION ALL SELECT '.dart', 'Dart' UNION ALL SELECT '.ex', 'Elixir' UNION ALL SELECT '.exs', 'Elixir' UNION ALL SELECT '.erl', 'Erlang' UNION ALL SELECT '.go', 'Go' UNION ALL SELECT '.groovy', 'Groovy' UNION ALL SELECT '.html', 'HTML' UNION ALL SELECT '.htm', 'HTML' UNION ALL SELECT '.hs', 'Haskell' UNION ALL SELECT '.hx', 'Haxe' UNION ALL SELECT '.json', 'JSON' UNION ALL SELECT '.java', 'Java' UNION ALL SELECT '.js', 'JavaScript' UNION ALL SELECT '.cjs', 'JavaScript' UNION ALL SELECT '.jl', 'Julia' UNION ALL SELECT '.kt', 'Kotlin' UNION ALL SELECT '.ktm', 'Kotlin' UNION ALL SELECT '.kts', 'Kotlin' UNION ALL SELECT '.lua', 'Lua' UNION ALL SELECT '.matlab', 'MATLAB' UNION ALL SELECT '.m', 'MATLAB' UNION ALL SELECT '.md', 'Markdown' UNION ALL SELECT '.markdown', 'Markdown' UNION ALL SELECT '.mdown', 'Markdown' UNION ALL SELECT '.php', 'PHP' UNION ALL SELECT '.ps1', 'PowerShell' UNION ALL SELECT '.psd1', 'PowerShell' UNION ALL SELECT '.psm1', 'PowerShell' UNION ALL SELECT '.py', 'Python' UNION ALL SELECT '.r', 'R' UNION ALL SELECT '.rb', 'Ruby' UNION ALL SELECT '.rs', 'Rust' UNION ALL SELECT '.scss', 'SCSS' UNION ALL 