/-!
# sf_local197 — crossskill equivalence(s)

Question: Among our top 10 paying customers, can you identify the largest change in payment amounts from one month to the immediately following month? Specifically, please determine for which customer and during which month this maximum month-over-month difference occurred, and provide the difference rounded to two decimal places.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local197

CREATE TABLE PAYMENT («payment_id» INT, «customer_id» INT, «staff_id» INT, «rental_id» FLOAT, «amount» FLOAT, «payment_date» STRING, «last_update» STRING)

theorem eq_0_1 :
    sql%([PAYMENT_schema]) "WITH top10_customers AS (\n    SELECT \"customer_id\"\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n    GROUP BY \"customer_id\"\n    ORDER BY SUM(\"amount\") DESC\n    LIMIT 10\n),\nmonthly_payments AS (\n    SELECT \n        p.\"customer_id\",\n        DATE_TRUNC('MONTH', TRY_TO_TIMESTAMP(p.\"payment_date\")) AS payment_month,\n        SUM(p.\"amount\") AS monthly_total\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p\n    JOIN top10_customers t ON p.\"customer_id\" = t.\"customer_id\"\n    GROUP BY p.\"customer_id\", payment_month\n),\nwith_diff AS (\n    SELECT \n        \"customer_id\",\n        payment_month,\n        monthly_total,\n        monthly_total - LAG(monthly_total) OVER (PARTITION BY \"customer_id\" ORDER BY payment_month) AS diff\n    FROM monthly_payments\n)\nSELECT \n    TO_CHAR(payment_month, 'MM') AS month,\n    ROUND(ABS(diff), 2) AS max_diff\nFROM with_diff\nWHERE diff IS NOT NULL\nORDER BY ABS(diff) DESC\nLIMIT 1;" = sql%([PAYMENT_schema]) "WITH top10 AS (\n  SELECT \"customer_id\"\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n  ORDER BY SUM(\"amount\") DESC\n  LIMIT 10\n),\nmonthly AS (\n  SELECT p.\"customer_id\",\n         SUBSTR(p.\"payment_date\", 6, 2) AS month,\n         SUM(p.\"amount\") AS monthly_amount\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p\n  JOIN top10 t ON p.\"customer_id\" = t.\"customer_id\"\n  GROUP BY p.\"customer_id\", SUBSTR(p.\"payment_date\", 6, 2)\n),\nwith_lag AS (\n  SELECT *,\n         LAG(monthly_amount) OVER (PARTITION BY \"customer_id\" ORDER BY month) AS prev_amount\n  FROM monthly\n)\nSELECT month,\n       ROUND(MAX(ABS(monthly_amount - prev_amount)), 2) AS max_diff\nFROM with_lag\nWHERE prev_amount IS NOT NULL\nGROUP BY month\nORDER BY max_diff DESC\nLIMIT 1;" := by
  first | sql_equiv | sorry

