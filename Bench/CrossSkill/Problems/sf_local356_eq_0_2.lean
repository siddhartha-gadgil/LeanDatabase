namespace N_sf_local356_eq_0_2

CREATE TABLE PIT_STOPS («race_id» INT, «driver_id» INT, «stop» INT, «lap» INT, «time» STRING, «duration» STRING, «milliseconds» INT, «seconds» FLOAT)
CREATE TABLE LAP_POSITIONS («race_id» INT, «driver_id» INT, «lap» INT, «position» INT, «lap_type» STRING)
CREATE TABLE RETIREMENTS («race_id» INT, «driver_id» INT, «lap» INT, «position_order» INT, «status_id» INT, «retirement_type» STRING)
CREATE TABLE DRIVERS («driver_id» INT, «driver_ref» STRING, «number» FLOAT, «code» STRING, «forename» STRING, «surname» STRING, «full_name» STRING, «dob» STRING, «nationality» STRING, «url» STRING)

theorem eq (t0 : TableRel PIT_STOPS_schema) (t1 : TableRel LAP_POSITIONS_schema) (t2 : TableRel RETIREMENTS_schema) (t3 : TableRel DRIVERS_schema) :
    (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH position_changes AS (SELECT curr.\"race_id\", curr.\"driver_id\", curr.\"lap\", curr.\"position\" AS curr_position, prev.\"position\" AS prev_position FROM \"F1\".\"F1\".\"LAP_POSITIONS\" AS curr JOIN \"F1\".\"F1\".\"LAP_POSITIONS\" AS prev ON curr.\"race_id\" = prev.\"race_id\" AND curr.\"driver_id\" = prev.\"driver_id\" AND curr.\"lap\" = prev.\"lap\" + 1 WHERE curr.\"lap\" >= 2 AND curr.\"lap_type\" = 'Race' AND prev.\"lap_type\" = 'Race'), overtake_pairs AS (SELECT a.\"race_id\", a.\"lap\", a.\"driver_id\" AS overtaker_id, b.\"driver_id\" AS overtaken_id FROM position_changes AS a JOIN position_changes AS b ON a.\"race_id\" = b.\"race_id\" AND a.\"lap\" = b.\"lap\" AND a.\"driver_id\" <> b.\"driver_id\" WHERE a.prev_position > b.prev_position AND a.curr_position < b.curr_position), on_track_overtakes AS (SELECT op.\"race_id\", op.\"lap\", op.overtaker_id, op.overtaken_id FROM overtake_pairs AS op WHERE NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaken_id AND (ps.\"lap\" = op.\"lap\" OR ps.\"lap\" = op.\"lap\" - 1)) AND NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaker_id AND ps.\"lap\" = op.\"lap\") AND NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" AS r WHERE r.\"race_id\" = op.\"race_id\" AND r.\"driver_id\" = op.overtaken_id AND r.\"lap\" = op.\"lap\")), driver_stats AS (SELECT d.\"driver_id\", d.\"forename\" || ' ' || d.\"surname\" AS \"full_name\", COALESCE(p.cnt, 0) AS overtakes_performed, COALESCE(r.cnt, 0) AS times_overtaken FROM \"F1\".\"F1\".\"DRIVERS\" AS d LEFT JOIN (SELECT overtaker_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaker_id) AS p ON d.\"driver_id\" = p.did LEFT JOIN (SELECT overtaken_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaken_id) AS r ON d.\"driver_id\" = r.did WHERE COALESCE(p.cnt, 0) > 0 OR COALESCE(r.cnt, 0) > 0) SELECT \"full_name\" FROM driver_stats WHERE times_overtaken > overtakes_performed ORDER BY \"full_name\"") t0 t1 t2 t3
  ~= (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH race_laps AS (SELECT \"race_id\", \"driver_id\", \"lap\", \"position\" FROM \"F1\".\"F1\".\"LAP_POSITIONS\" WHERE \"lap_type\" = 'Race'), lap_pairs /* Self-join to get all driver pairs on each lap */ AS (SELECT a.\"race_id\", a.\"lap\", a.\"driver_id\" AS driver_a, b.\"driver_id\" AS driver_b, a.\"position\" AS pos_a, b.\"position\" AS pos_b FROM race_laps AS a JOIN race_laps AS b ON a.\"race_id\" = b.\"race_id\" AND a.\"lap\" = b.\"lap\" AND a.\"driver_id\" < b.\"driver_id\"), overtakes /* Detect position swaps between consecutive laps */ AS (SELECT curr.\"race_id\", curr.\"lap\", curr.driver_a, curr.driver_b, CASE WHEN prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b THEN curr.driver_a /* A was behind, now ahead */ WHEN prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b THEN curr.driver_b /* B was behind, now ahead */ END AS overtaker /* Determine who overtook whom */, CASE WHEN prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b THEN curr.driver_b WHEN prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b THEN curr.driver_a END AS overtaken_driver FROM lap_pairs AS curr JOIN lap_pairs AS prev ON curr.\"race_id\" = prev.\"race_id\" AND curr.driver_a = prev.driver_a AND curr.driver_b = prev.driver_b AND curr.\"lap\" = prev.\"lap\" + 1 WHERE curr.\"lap\" > 1 AND /* Position swap occurred */ ((prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b) OR (prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b)) AND /* Neither driver pitted on current lap (pit entry) */ NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_a AND ps.\"lap\" = curr.\"lap\") AND NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_b AND ps.\"lap\" = curr.\"lap\") AND /* Neither driver pitted on previous lap (pit exit) */ NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_a AND ps.\"lap\" = curr.\"lap\" - 1) AND NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_b AND ps.\"lap\" = curr.\"lap\" - 1) AND /* Neither driver retired on current lap */ NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" AS ret WHERE ret.\"race_id\" = curr.\"race_id\" AND ret.\"driver_id\" = curr.driver_a AND ret.\"lap\" = curr.\"lap\") AND NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" AS ret WHERE ret.\"race_id\" = curr.\"race_id\" AND ret.\"driver_id\" = curr.driver_b AND ret.\"lap\" = curr.\"lap\")), driver_stats /* Count overtakes performed and received per driver */ AS (SELECT d.\"driver_id\", COALESCE(ot.times_overtaking, 0) AS times_overtaking, COALESCE(od.times_overtaken, 0) AS times_overtaken FROM \"F1\".\"F1\".\"DRIVERS\" AS d LEFT JOIN (SELECT overtaker AS \"driver_id\", COUNT(*) AS times_overtaking FROM overtakes GROUP BY overtaker) AS ot ON d.\"driver_id\" = ot.\"driver_id\" LEFT JOIN (SELECT overtaken_driver AS \"driver_id\", COUNT(*) AS times_overtaken FROM overtakes GROUP BY overtaken_driver) AS od ON d.\"driver_id\" = od.\"driver_id\" WHERE COALESCE(ot.times_overtaking, 0) > 0 OR COALESCE(od.times_overtaken, 0) > 0) SELECT d.\"full_name\" FROM driver_stats AS ds JOIN \"F1\".\"F1\".\"DRIVERS\" AS d ON ds.\"driver_id\" = d.\"driver_id\" WHERE ds.times_overtaken > ds.times_overtaking ORDER BY d.\"full_name\"") t0 t1 t2 t3
  := by first | sql_equiv | sorry

