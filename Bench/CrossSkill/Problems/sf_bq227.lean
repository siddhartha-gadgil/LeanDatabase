/-!
# sf_bq227 — crossskill equivalence(s)

Question: Could you provide the annual percentage shares, rounded to two decimal places, of the top 5 minor crime categories from 2008 in London's total crimes, with each year displayed in one row?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq227

CREATE TABLE CRIME_BY_LSOA («lsoa_code» STRING, «borough» STRING, «major_category» STRING, «minor_category» STRING, «value» INT, «year» INT, «month» INT)

theorem eq_0_1 : ∀ t,
    (sql%([CRIME_BY_LSOA_schema]) "WITH top5 AS (SELECT \"minor_category\", SUM(\"value\") AS total_2008 FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" WHERE \"year\" = 2008 GROUP BY \"minor_category\" ORDER BY total_2008 DESC LIMIT 5), top5_ranked AS (SELECT \"minor_category\", total_2008, ROW_NUMBER() OVER (ORDER BY total_2008 DESC) AS rn FROM top5), yearly_total AS (SELECT \"year\", SUM(\"value\") AS total FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" GROUP BY \"year\"), category_yearly AS (SELECT c.\"year\", c.\"minor_category\", SUM(c.\"value\") AS cat_total FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" AS c INNER JOIN top5 AS t ON c.\"minor_category\" = t.\"minor_category\" GROUP BY c.\"year\", c.\"minor_category\") SELECT cy.\"year\", ROUND(SUM(CASE WHEN tr.rn = 1 THEN CAST(cy.cat_total * 100.0 AS DOUBLE PRECISION) / yt.total END), 2) AS \"Category 1\", ROUND(SUM(CASE WHEN tr.rn = 2 THEN CAST(cy.cat_total * 100.0 AS DOUBLE PRECISION) / yt.total END), 2) AS \"Category 2\", ROUND(SUM(CASE WHEN tr.rn = 3 THEN CAST(cy.cat_total * 100.0 AS DOUBLE PRECISION) / yt.total END), 2) AS \"Category 3\", ROUND(SUM(CASE WHEN tr.rn = 4 THEN CAST(cy.cat_total * 100.0 AS DOUBLE PRECISION) / yt.total END), 2) AS \"Category 4\", ROUND(SUM(CASE WHEN tr.rn = 5 THEN CAST(cy.cat_total * 100.0 AS DOUBLE PRECISION) / yt.total END), 2) AS \"Category 5\" FROM category_yearly AS cy JOIN yearly_total AS yt ON cy.\"year\" = yt.\"year\" JOIN top5_ranked AS tr ON cy.\"minor_category\" = tr.\"minor_category\" GROUP BY cy.\"year\" ORDER BY cy.\"year\"") t ~= (sql%([CRIME_BY_LSOA_schema]) "WITH top5 AS (SELECT \"minor_category\", ROW_NUMBER() OVER (ORDER BY SUM(\"value\") DESC) AS rn FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" WHERE \"year\" = 2008 GROUP BY \"minor_category\" ORDER BY SUM(\"value\") DESC LIMIT 5), yearly_total AS (SELECT \"year\", SUM(\"value\") AS total FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" GROUP BY \"year\"), category_yearly AS (SELECT c.\"year\", t.rn, SUM(c.\"value\") AS cat_total FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" AS c INNER JOIN top5 AS t ON c.\"minor_category\" = t.\"minor_category\" GROUP BY c.\"year\", t.rn) SELECT cy.\"year\" AS \"year\", ROUND(CAST(100.0 * MAX(CASE WHEN cy.rn = 1 THEN cy.cat_total END) AS DOUBLE PRECISION) / yt.total, 2) AS \"Category 1\", ROUND(CAST(100.0 * MAX(CASE WHEN cy.rn = 2 THEN cy.cat_total END) AS DOUBLE PRECISION) / yt.total, 2) AS \"Category 2\", ROUND(CAST(100.0 * MAX(CASE WHEN cy.rn = 3 THEN cy.cat_total END) AS DOUBLE PRECISION) / yt.total, 2) AS \"Category 3\", ROUND(CAST(100.0 * MAX(CASE WHEN cy.rn = 4 THEN cy.cat_total END) AS DOUBLE PRECISION) / yt.total, 2) AS \"Category 4\", ROUND(CAST(100.0 * MAX(CASE WHEN cy.rn = 5 THEN cy.cat_total END) AS DOUBLE PRECISION) / yt.total, 2) AS \"Category 5\" FROM category_yearly AS cy JOIN yearly_total AS yt ON cy.\"year\" = yt.\"year\" GROUP BY cy.\"year\", yt.total ORDER BY cy.\"year\"") t := by
