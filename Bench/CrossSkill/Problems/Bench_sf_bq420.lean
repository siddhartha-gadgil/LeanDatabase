import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq420 — crossskill equivalence(s)

Question: Can you identify the top 5 patents that were initially rejected under section 101 with no allowed claims, based on the length of their granted claims? The patents should have been granted in the US between 2010 and 2023. Additionally, ensure to select the first office action date for each application. Please include their first publication numbers, along with their first publication dates, length of the filed claims and grant dates.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq420

CREATE TABLE PUBLICATIONS («publication_number» STRING, «application_number» STRING, «country_code» STRING, «kind_code» STRING, «application_kind» STRING, «application_number_formatted» STRING, «pct_number» STRING, «family_id» STRING, «spif_publication_number» STRING, «spif_application_number» STRING, «title_localized» STRING, «abstract_localized» STRING, «claims_localized» STRING, «claims_localized_html» STRING, «description_localized» STRING, «description_localized_html» STRING, «publication_date» INT, «filing_date» INT, «grant_date» INT, «priority_date» INT, «priority_claim» STRING, «inventor» STRING, «inventor_harmonized» STRING, «assignee» STRING, «assignee_harmonized» STRING, «examiner» STRING, «uspc» STRING, «ipc» STRING, «cpc» STRING, «fi» STRING, «fterm» STRING, «locarno» STRING, «citation» STRING, «parent» STRING, «child» STRING, «entity_status» STRING, «art_unit» STRING)
CREATE TABLE MATCH («pgpub_doc_num» STRING, «grant_doc_num» STRING, «publication_number» STRING)
CREATE TABLE PATENT_CLAIMS_STATS («pat_no» STRING, «claim_no» STRING, «word_ct» STRING, «char_ct» STRING, «or_ct» STRING, «sf_ct» STRING, «cns_ct» STRING, «ind_flg» STRING, «appl_id» STRING)
CREATE TABLE PATENT_DOCUMENT_STATS («pat_no» STRING, «pat_clm_ct» STRING, «pat_wrd_ct» STRING, «pat_wrd_min» STRING, «pat_dep_clm_ct» STRING, «pat_dep_wrd_ct» STRING, «pat_dep_wrd_min» STRING, «pat_wrd_avg» STRING, «pat_dep_wrd_avg» STRING, «appl_id» STRING)
CREATE TABLE PGPUB_DOCUMENT_STATS («pub_no» STRING, «appl_id» STRING, «pub_clm_ct» STRING, «pub_wrd_ct» STRING, «pub_wrd_min» STRING, «pub_dep_clm_ct» STRING, «pub_dep_wrd_ct» STRING, «pub_dep_wrd_min» STRING, «pub_wrd_avg» STRING, «pub_dep_wrd_avg» STRING)
CREATE TABLE PGPUB_CLAIMS_FULLTEXT («pub_no» STRING, «appl_id» STRING, «claim_no» STRING, «claim_txt» STRING, «dependencies» STRING, «ind_flg» STRING)
CREATE TABLE MATCH_APP («app_id» STRING, «application_number» STRING)
CREATE TABLE OFFICE_ACTIONS («app_id» STRING, «ifw_number» STRING, «document_cd» STRING, «mail_dt» STRING, «art_unit» STRING, «uspc_class» STRING, «uspc_subclass» STRING, «header_missing» STRING, «fp_missing» STRING, «rejection_fp_mismatch» STRING, «closing_missing» STRING, «rejection_101» STRING, «rejection_102» STRING, «rejection_103» STRING, «rejection_112» STRING, «rejection_dp» STRING, «objection» STRING, «allowed_claims» STRING, «cite102_gt1» STRING, «cite103_gt3» STRING, «cite103_eq1» STRING, «cite103_max» STRING, «signature_type» STRING)

theorem eq_0_1 :
    sql%([PUBLICATIONS_schema, MATCH_schema, PATENT_CLAIMS_STATS_schema, PATENT_DOCUMENT_STATS_schema, PGPUB_DOCUMENT_STATS_schema, PGPUB_CLAIMS_FULLTEXT_schema, MATCH_APP_schema, OFFICE_ACTIONS_schema]) "WITH rejected_apps AS (SELECT \"app_id\", MIN(\"mail_dt\") AS first_office_action_date FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"OFFICE_ACTIONS\" WHERE \"rejection_101\" = 1 AND \"allowed_claims\" = 0 GROUP BY \"app_id\"), app_link AS (SELECT ma.\"app_id\", ma.\"application_number\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"MATCH_APP\" AS ma WHERE NOT ma.\"application_number\" IS NULL), grant_pubs AS (SELECT p.\"application_number\", p.\"publication_number\" AS grant_publication_number, p.\"grant_date\" FROM \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" AS p WHERE p.\"country_code\" = 'US' AND p.\"grant_date\" BETWEEN 20100101 AND 20231231 AND p.\"kind_code\" IN ('B1', 'B2')), granted_claims /* Granted claims word count: independent claims from PATENT_CLAIMS_STATS */ /* Formula: SUM(word_ct) - COUNT(*) to exclude claim number prefix word */ AS (SELECT CAST(cs.\"appl_id\" AS VARCHAR) AS app_id, CAST(cs.\"pat_no\" AS VARCHAR) AS pat_no, SUM(CAST(cs.\"word_ct\" AS INT)) - COUNT(*) AS granted_claims_length_words FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PATENT_CLAIMS_STATS\" AS cs WHERE cs.\"ind_flg\" = 1 GROUP BY cs.\"appl_id\", cs.\"pat_no\"), filed_claims /* Filed claims: pre-grant publication claims from PGPUB_CLAIMS_FULLTEXT */ /* Also get pub_no for first_publication_number */ AS (SELECT CAST(pcf.\"appl_id\" AS VARCHAR) AS app_id, pcf.\"pub_no\", SUM(ARRAY_LENGTH(SPLIT(TRIM(pcf.\"claim_txt\"), ' '), 1)) - COUNT(*) AS filed_claims_length_words FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PGPUB_CLAIMS_FULLTEXT\" AS pcf WHERE pcf.\"ind_flg\" = '1' GROUP BY pcf.\"appl_id\", pcf.\"pub_no\"), first_pub_a1 /* Get the A1 (pre-grant) publication date from PUBLICATIONS if it exists */ AS (SELECT p.\"application_number\", p.\"publication_number\" AS first_publication_number, p.\"publication_date\" AS first_publication_date FROM \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" AS p WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" IN ('A1', 'A2')) SELECT gp.grant_publication_number, gp.\"grant_date\" AS grant_date, gc.granted_claims_length_words, COALESCE(CASE WHEN NOT fc.\"pub_no\" IS NULL THEN 'US-' || fc.\"pub_no\" || '-A1' END, gp.grant_publication_number) AS first_publication_number, fpa.first_publication_date AS first_publication_date, fc.filed_claims_length_words, ra.first_office_action_date FROM rejected_apps AS ra JOIN app_link AS al ON ra.\"app_id\" = al.\"app_id\" JOIN grant_pubs AS gp ON al.\"application_number\" = gp.\"application_number\" JOIN granted_claims AS gc ON ra.\"app_id\" = gc.app_id LEFT JOIN filed_claims AS fc ON ra.\"app_id\" = fc.app_id LEFT JOIN first_pub_a1 AS fpa ON al.\"application_number\" = fpa.\"application_number\" ORDER BY gc.granted_claims_length_words DESC LIMIT 5" = sql%([PUBLICATIONS_schema, MATCH_schema, PATENT_CLAIMS_STATS_schema, PATENT_DOCUMENT_STATS_schema, PGPUB_DOCUMENT_STATS_schema, PGPUB_CLAIMS_FULLTEXT_schema, MATCH_APP_schema, OFFICE_ACTIONS_schema]) "WITH first_oa AS (SELECT \"app_id\", MIN(\"mail_dt\") AS \"first_office_action_date\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"OFFICE_ACTIONS\" WHERE \"rejection_101\" = '1' AND \"allowed_claims\" = '0' GROUP BY \"app_id\"), granted AS (SELECT pds.\"pat_no\", pds.\"appl_id\", CAST(pds.\"pat_wrd_ct\" AS INT) AS \"granted_claims_length_words\", cm.\"publication_number\" AS \"grant_publication_number\", p.\"grant_date\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PATENT_DOCUMENT_STATS\" AS pds JOIN \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"MATCH\" AS cm ON cm.\"pat_no\" = pds.\"pat_no\" JOIN \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" AS p ON p.\"publication_number\" = cm.\"publication_number\" WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" IN ('B1', 'B2') AND p.\"grant_date\" BETWEEN 20100101 AND 20231231), a1_info AS (SELECT \"appl_id\", 'US-' || CAST(\"pub_no\" AS VARCHAR) || '-A1' AS \"first_publication_number\", \"pub_wrd_ct\" AS \"filed_claims_length_words\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PGPUB_DOCUMENT_STATS\") SELECT g.\"grant_publication_number\", g.\"grant_date\", g.\"granted_claims_length_words\", COALESCE(a1.\"first_publication_number\", g.\"grant_publication_number\") AS \"first_publication_number\", NULL AS \"first_publication_date\", a1.\"filed_claims_length_words\", CAST(foa.\"first_office_action_date\" AS VARCHAR) AS \"first_office_action_date\" FROM granted AS g JOIN first_oa AS foa ON foa.\"app_id\" = g.\"appl_id\" LEFT JOIN a1_info AS a1 ON a1.\"appl_id\" = g.\"appl_id\" ORDER BY g.\"granted_claims_length_words\" DESC LIMIT 5" := by
  first | sql_equiv | sorry

end Bench_sf_bq420
