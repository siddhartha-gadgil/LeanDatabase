import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq420 — crossskill equivalence(s)

Question: Can you identify the top 5 patents that were initially rejected under section 101 with no allowed claims, based on the length of their granted claims? The patents should have been granted in the US between 2010 and 2023. Additionally, ensure to select the first office action date for each application. Please include their first publication numbers, along with their first publication dates, length of the filed claims and grant dates.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq420

CREATE TABLE PUBLICATIONS («publication_number» STRING, «application_number» STRING, «country_code» STRING, «kind_code» STRING, «application_kind» STRING, «application_number_formatted» STRING, «pct_number» STRING, «family_id» STRING, «spif_publication_number» STRING, «spif_application_number» STRING, «title_localized» STRING, «abstract_localized» STRING, «claims_localized» STRING, «claims_localized_html» STRING, «description_localized» STRING, «description_localized_html» STRING, «publication_date» INT, «filing_date» INT, «grant_date» INT, «priority_date» INT, «priority_claim» STRING, «inventor» STRING, «inventor_harmonized» STRING, «assignee» STRING, «assignee_harmonized» STRING, «examiner» STRING, «uspc» STRING, «ipc» STRING, «cpc» STRING, «fi» STRING, «fterm» STRING, «locarno» STRING, «citation» STRING, «parent» STRING, «child» STRING, «entity_status» STRING, «art_unit» STRING)
CREATE TABLE MATCH («pgpub_doc_num» STRING, «grant_doc_num» STRING, «publication_number» STRING)
CREATE TABLE PATENT_CLAIMS_STATS («pat_no» STRING, «claim_no» STRING, «word_ct» STRING, «char_ct» STRING, «or_ct» STRING, «sf_ct» STRING, «cns_ct» STRING, «ind_flg» STRING, «appl_id» STRING)
CREATE TABLE PATENT_DOCUMENT_STATS («pat_no» STRING, «pat_clm_ct» STRING, «pat_wrd_ct» STRING, «pat_wrd_min» STRING, «pat_dep_clm_ct» STRING, «pat_dep_wrd_ct» STRING, «pat_dep_wrd_min» STRING, «pat_wrd_avg» STRING, «pat_dep_wrd_avg» STRING, «appl_id» STRING)
CREATE TABLE PGPUB_DOCUMENT_STATS («pub_no» STRING, «appl_id» STRING, «pub_clm_ct» STRING, «pub_wrd_ct» STRING, «pub_wrd_min» STRING, «pub_dep_clm_ct» STRING, «pub_dep_wrd_ct» STRING, «pub_dep_wrd_min» STRING, «pub_wrd_avg» STRING, «pub_dep_wrd_avg» STRING)
CREATE TABLE PGPUB_CLAIMS_FULLTEXT («pub_no» STRING, «appl_id» STRING, «claim_no» STRING, «claim_txt» STRING, «dependencies» STRING, «ind_flg» STRING)
CREATE TABLE MATCH_APP («app_id» STRING, «application_number» STRING)
CREATE TABLE OFFICE_ACTIONS («app_id» STRING, «ifw_number» STRING, «document_cd» STRING, «mail_dt» STRING, «art_unit» STRING, «uspc_class» STRING, «uspc_subclass» STRING, «header_missing» STRING, «fp_missing» STRING, «rejection_fp_mismatch» STRING, «closing_missing» STRING, «rejection_101» STRING, «rejection_102» STRING, «rejection_103» STRING, «rejection_112» STRING, «rejection_dp» STRING, «objection» STRING, «allowed_claims» STRING, «cite102_gt1» STRING, «cite103_gt3» STRING, «cite103_eq1» STRING, «cite103_max» STRING, «signature_type» STRING)

theorem eq_0_1 :
    sql%([PUBLICATIONS_schema, MATCH_schema, PATENT_CLAIMS_STATS_schema, PATENT_DOCUMENT_STATS_schema, PGPUB_DOCUMENT_STATS_schema, PGPUB_CLAIMS_FULLTEXT_schema, MATCH_APP_schema, OFFICE_ACTIONS_schema]) "WITH rejected_apps AS (\n    SELECT \n        \"app_id\",\n        MIN(\"mail_dt\") AS first_office_action_date\n    FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"OFFICE_ACTIONS\"\n    WHERE \"rejection_101\" = 1 \n      AND \"allowed_claims\" = 0\n    GROUP BY \"app_id\"\n),\n\napp_link AS (\n    SELECT \n        ma.\"app_id\",\n        ma.\"application_number\"\n    FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"MATCH_APP\" ma\n    WHERE ma.\"application_number\" IS NOT NULL\n),\n\ngrant_pubs AS (\n    SELECT \n        p.\"application_number\",\n        p.\"publication_number\" AS grant_publication_number,\n        p.\"grant_date\"\n    FROM \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" p\n    WHERE p.\"country_code\" = 'US'\n      AND p.\"grant_date\" BETWEEN 20100101 AND 20231231\n      AND p.\"kind_code\" IN ('B1', 'B2')\n),\n\n-- Granted claims word count: independent claims from PATENT_CLAIMS_STATS\n-- Formula: SUM(word_ct) - COUNT(*) to exclude claim number prefix word\ngranted_claims AS (\n    SELECT \n        CAST(cs.\"appl_id\" AS VARCHAR) AS app_id,\n        CAST(cs.\"pat_no\" AS VARCHAR) AS pat_no,\n        SUM(CAST(cs.\"word_ct\" AS INT)) - COUNT(*) AS granted_claims_length_words\n    FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PATENT_CLAIMS_STATS\" cs\n    WHERE cs.\"ind_flg\" = 1\n    GROUP BY cs.\"appl_id\", cs.\"pat_no\"\n),\n\n-- Filed claims: pre-grant publication claims from PGPUB_CLAIMS_FULLTEXT\n-- Also get pub_no for first_publication_number\nfiled_claims AS (\n    SELECT \n        CAST(pcf.\"appl_id\" AS VARCHAR) AS app_id,\n        pcf.\"pub_no\",\n        SUM(ARRAY_SIZE(SPLIT(TRIM(pcf.\"claim_txt\"), ' '))) - COUNT(*) AS filed_claims_length_words\n    FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PGPUB_CLAIMS_FULLTEXT\" pcf\n    WHERE pcf.\"ind_flg\" = '1'\n    GROUP BY pcf.\"appl_id\", pcf.\"pub_no\"\n),\n\n-- Get the A1 (pre-grant) publication date from PUBLICATIONS if it exists\nfirst_pub_a1 AS (\n    SELECT \n        p.\"application_number\",\n        p.\"publication_number\" AS first_publication_number,\n        p.\"publication_date\" AS first_publication_date\n    FROM \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" p\n    WHERE p.\"country_code\" = 'US'\n      AND p.\"kind_code\" IN ('A1', 'A2')\n)\n\nSELECT \n    gp.grant_publication_number,\n    gp.\"grant_date\" AS grant_date,\n    gc.granted_claims_length_words,\n    COALESCE(\n        CASE WHEN fc.\"pub_no\" IS NOT NULL THEN 'US-' || fc.\"pub_no\" || '-A1' END,\n        gp.grant_publication_number\n    ) AS first_publication_number,\n    fpa.first_publication_date AS first_publication_date,\n    fc.filed_claims_length_words,\n    ra.first_office_action_date\nFROM rejected_apps ra\nJOIN app_link al ON ra.\"app_id\" = al.\"app_id\"\nJOIN grant_pubs gp ON al.\"application_number\" = gp.\"application_number\"\nJOIN granted_claims gc ON ra.\"app_id\" = gc.app_id\nLEFT JOIN filed_claims fc ON ra.\"app_id\" = fc.app_id\nLEFT JOIN first_pub_a1 fpa ON al.\"application_number\" = fpa.\"application_number\"\nORDER BY gc.granted_claims_length_words DESC\nLIMIT 5;" = sql%([PUBLICATIONS_schema, MATCH_schema, PATENT_CLAIMS_STATS_schema, PATENT_DOCUMENT_STATS_schema, PGPUB_DOCUMENT_STATS_schema, PGPUB_CLAIMS_FULLTEXT_schema, MATCH_APP_schema, OFFICE_ACTIONS_schema]) "WITH first_oa AS (\n    SELECT \"app_id\", MIN(\"mail_dt\") AS \"first_office_action_date\"\n    FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"OFFICE_ACTIONS\"\n    WHERE \"rejection_101\" = '1' AND \"allowed_claims\" = '0'\n    GROUP BY \"app_id\"\n),\ngranted AS (\n    SELECT pds.\"pat_no\", pds.\"appl_id\",\n           CAST(pds.\"pat_wrd_ct\" AS INTEGER) AS \"granted_claims_length_words\",\n           cm.\"publication_number\" AS \"grant_publication_number\",\n           p.\"grant_date\"\n    FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PATENT_DOCUMENT_STATS\" pds\n    JOIN \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"MATCH\" cm ON cm.\"pat_no\" = pds.\"pat_no\"\n    JOIN \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" p ON p.\"publication_number\" = cm.\"publication_number\"\n    WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" IN ('B1', 'B2')\n      AND p.\"grant_date\" BETWEEN 20100101 AND 20231231\n),\na1_info AS (\n    SELECT \"appl_id\",\n           'US-' || \"pub_no\"::VARCHAR || '-A1' AS \"first_publication_number\",\n           \"pub_wrd_ct\" AS \"filed_claims_length_words\"\n    FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PGPUB_DOCUMENT_STATS\"\n)\nSELECT g.\"grant_publication_number\", g.\"grant_date\", g.\"granted_claims_length_words\",\n       COALESCE(a1.\"first_publication_number\", g.\"grant_publication_number\") AS \"first_publication_number\",\n       NULL AS \"first_publication_date\",\n       a1.\"filed_claims_length_words\",\n       CAST(foa.\"first_office_action_date\" AS VARCHAR) AS \"first_office_action_date\"\nFROM granted g\nJOIN first_oa foa ON foa.\"app_id\" = g.\"appl_id\"\nLEFT JOIN a1_info a1 ON a1.\"appl_id\" = g.\"appl_id\"\nORDER BY g.\"granted_claims_length_words\" DESC\nLIMIT 5" := by
  first | sql_equiv | sorry

end Bench_sf_bq420
