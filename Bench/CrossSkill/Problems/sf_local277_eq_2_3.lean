m(w_i * (y_i - a - b*x_i)^2) */ /* Normal equations: */ /* b = (sum(w*x*y) - sum(w*x)*sum(w*y)/sum(w)) / (sum(w*x^2) - (sum(w*x))^2/sum(w)) */ /* a = (sum(w*y) - b*sum(w*x)) / sum(w) */ AS (SELECT \"product_id\", SUM(time_step * deseas_qty * time_step) AS sum_wxy /* sum(w*x*y) where w=x=time_step */, SUM(time_step * time_step) AS sum_wx2 /* sum(w*x^2) */, SUM(time_step * time_step) AS sum_wx /* sum(w*x) -- wait, w=time_step, x=time_step */, SUM(time_step * deseas_qty) AS sum_wy /* sum(w*y) */, SUM(time_step) AS sum_w /* sum(w) */ FROM deseasonalized GROUP BY \"product_id\"), regression_stats2 /* Actually, let me redo this. w_i = time_step_i, x_i = time_step_i, y_i = deseas_qty_i */ /* sum_w = sum(w_i) = sum(time_step) */ /* sum_wx = sum(w_i * x_i) = sum(time_step^2) */ /* sum_wy = sum(w_i * y_i) = sum(time_step * deseas_qty) */ /* sum_wxy = sum(w_i * x_i * y_i) = sum(time_step^2 * deseas_qty) */ /* sum_wx2 = sum(w_i * x_i^2) = sum(time_step^3) */ AS (SELECT \"product_id\", SUM(CAST(time_step AS DOUBLE PRECISION)) AS sum_w, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx, SUM(CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wxy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx2 FROM deseasonalized GROUP BY \"product_id\"), regression_coeffs AS (SELECT \"product_id\", CAST((sum_wxy - CAST(sum_wx * sum_wy AS DOUBLE PRECISION) / sum_w) AS DOUBLE PRECISION) / (sum_wx2 - CAST(sum_wx * sum_wx AS DOUBLE PRECISION) / sum_w) AS slope, CAST((sum_wy - (CAST((sum_wxy - CAST(sum_wx * sum_wy AS DOUBLE PRECISION) / sum_w) AS DOUBLE PRECISION) / (sum_wx2 - CAST(sum_wx * sum_wx AS DOUBLE PRECISION) / sum_w)) * sum_wx) AS DOUBLE PRECISION) / sum_w AS intercept FROM regression_stats2), forecast_months /* Forecast: for each month in 2018 (time steps 25-36), predict deseasonalized value */ /* then re-seasonalize */ AS (SELECT 25 AS time_step, 1 AS month_num UNION ALL SELECT 26, 2 UNION ALL SELECT 27, 3 UNION ALL SELECT 28, 4 UNION ALL SELECT 29, 5 UNION ALL SELECT 30, 6 UNION ALL SELECT 31, 7 UNION ALL SELECT 32, 8 UNION ALL SELECT 33, 9 UNION ALL SELECT 34, 10 UNION ALL SELECT 35, 11 UNION ALL SELECT 36, 12), forecasted AS (SELECT r.\"product_id\", f.time_step, f.month_num, r.intercept + r.slope * f.time_step AS forecast_deseas, s.seasonal_index, (r.intercept + r.slope * f.time_step) * s.seasonal_index AS forecast_seas FROM regression_coeffs AS r CROSS JOIN forecast_months AS f JOIN seasonal_indices AS s ON r.\"product_id\" = s.\"product_id\" AND f.month_num = s.month_num), annual_forecast /* Sum forecasted monthly values to get annual forecast per product */ AS (SELECT \"product_id\", SUM(forecast_seas) AS forecasted_annual_sales FROM forecasted GROUP BY \"product_id\") SELECT ROUND(CAST(AVG(forecasted_annual_sales) AS DECIMAL), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM annual_forecast") t0
