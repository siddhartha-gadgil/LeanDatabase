uct_id\" AND c.month_of_year = sf.month_of_year WHERE c.t BETWEEN 7 AND 30), regression /* Step 5: Weighted linear regression on deseasonalized data (time steps 7-30) */ /* Using REGR functions: y = deseasonalized_qty, x = t, weighted by t */ AS (SELECT \"product_id\", CAST(REGR_SLOPE(deseasonalized_qty * t, t * t) AS DOUBLE PRECISION) / REGR_SLOPE(t, t) AS w_slope, REGR_INTERCEPT(deseasonalized_qty * t, t * t) AS w_intercept_raw, SUM(t * deseasonalized_qty * t) AS sum_wxy /* Standard weighted regression: minimize sum(w_i * (y_i - a - b*x_i)^2) */ /* With weights = time step t */, SUM(t * t) AS sum_wx2, SUM(t * deseasonalized_qty) AS sum_wy, SUM(t) AS sum_w, SUM(t * t * t) AS sum_wx3, COUNT(*) AS n FROM deseasonalized GROUP BY \"product_id\"), weighted_reg /* Weighted regression coefficients */ /* b = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wx3 - sum_wx2 * sum_wx2)  -- wrong */ /* Actually: weight w_i = t_i */ /* sum_w = SUM(w_i), sum_wx = SUM(w_i * x_i), sum_wy = SUM(w_i * y_i) */ /* sum_wxx = SUM(w_i * x_i * x_i), sum_wxy = SUM(w_i * x_i * y_i) */ /* slope = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wxx - sum_wx * sum_wx) */ /* intercept = (sum_wy - slope * sum_wx) / sum_w */ AS (SELECT \"product_id\", SUM(t) AS sum_w, SUM(t * t) AS sum_wx /* sum(w_i * x_i) where w=t, x=t => sum(t^2) */, SUM(t * deseasonalized_qty) AS sum_wy /* sum(w_i * y_i) */, SUM(t * t * t) AS sum_wxx /* sum(w_i * x_i^2) = sum(t^3) */, SUM(t * t * deseasonalized_qty) AS sum_wxy /* sum(w_i * x_i * y_i) = sum(t^2 * y) */ FROM deseasonalized GROUP BY \"product_id\"), reg_coeffs AS (SELECT \"product_id\", CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0) AS slope, CAST((sum_wy - (CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0)) * sum_wx) AS DOUBLE PRECISION) / NULLIF(sum_w, 0) AS intercept FROM weighted_reg), forecast_months /* Step 6: Generate time steps for 2018 (t = 25 to 36) */ AS (SELECT \"product_id\", 25 AS t, 1 AS month_of_year FROM reg_coeffs UNION ALL SELECT \"product_id\", 26, 2 FROM reg_coeffs UNION ALL SELECT \"product_id\", 27, 3 FROM reg_coeffs UNION ALL SELECT \"product_id\", 28, 4 FROM reg_coeffs UNION ALL SELECT \"product_id\", 29, 5 FROM reg_coeffs UNION ALL SELECT \"product_id\", 30, 6 FROM reg_coeffs UNION ALL SELECT \"product_id\", 31, 7 FROM reg_coeffs UNION ALL SELECT \"product_id\", 32, 8 FROM reg_coeffs UNION ALL SELECT \"product_id\", 33, 9 FROM reg_coeffs UNION ALL SELECT \"product_id\", 34, 10 FROM reg_coeffs UNION ALL SELECT \"product_id\", 35, 11 FROM reg_coeffs UNION ALL SELECT \"product_id\", 36, 12 FROM reg_coeffs), forecasted /* Step 7: Forecast = (intercept + slope * t) * seasonal_factor */ AS (SELECT fm.\"product_id\", fm.t, fm.month_of_year, rc.intercept + rc.slope * fm.t AS deseasonalized_forecast, sf.seasonal_factor, (rc.intercept + rc.slope * fm.t) * sf.seasonal_factor AS forecasted_qty FROM forecast_months AS fm JOIN reg_coeffs AS rc ON fm.\"product_id\" = rc.\"product_id\" JOIN seasonal_factors AS sf ON fm.\"product_id\" = sf.\"product_id\" AND fm.month_of_year = sf.month_of_year), annual_forecast /* Step 8: Sum monthly forecasts to get annual 2018 per product */ AS (SELECT \"product_id\", SUM(forecasted_qty) AS annual_sales_2018 FROM forecasted GROUP BY \"product_id\") /* Step 9: Average across both products */ SELECT ROUND(CAST(AVG(annual_sales_2018) AS DECIMAL), 2) AS \"AVG_FORECASTED_ANNUAL_SALES_2018\" FROM annual_forecast") t0
