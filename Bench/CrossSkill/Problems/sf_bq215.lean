ith the highest originality */ /* Originality = 1 - SUM((n_k/N)^2) where n_k = citations in IPC class k, N = total citations */ WITH focal_citations AS (SELECT p.\"publication_number\" AS focal_patent, CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) AS cited_pub FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" AS p, LATERAL UNNEST(input => p.\"citation\") AS c(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" = 'B2' AND p.\"grant_date\" BETWEEN 20150101 AND 20181231 AND NOT CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) IS NULL AND CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) <> ''), cited_ipc AS (SELECT fc.focal_patent, fc.cited_pub, LEFT(CAST(JSON_EXTRACT_PATH(i.value, 'code') AS TEXT), 4) AS ipc_4digit FROM focal_citations AS fc INNER JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" AS p2 ON p2.\"publication_number\" = fc.cited_pub, LATERAL UNNEST(input => p2.\"ipc\") AS i(SEQ, KEY, PATH, INDEX, VALUE, THIS)), cited_ipc_freq AS (SELECT focal_patent, cited_pub, ipc_4digit, COUNT(*) AS freq FROM cited_ipc GROUP BY focal_patent, cited_pub, ipc_4digit), cited_ipc_ranked AS (SELECT focal_patent, cited_pub, ipc_4digit, freq, ROW_NUMBER() OVER (PARTITION BY focal_patent, cited_pub ORDER BY freq DESC, ipc_4digit ASC) AS rn FROM cited_ipc_freq), cited_class AS (SELECT focal_patent, cited_pub, ipc_4digit AS assigned_class FROM cited_ipc_ranked WHERE rn = 1), class_counts AS (SELECT focal_patent, assigned_class, COUNT(*) AS n_k FROM cited_class GROUP BY focal_patent, assigned_class), originality AS (SELECT focal_patent, 1.0 - CAST(SUM(CAST(n_k AS DOUBLE PRECISION) * CAST(n_k AS DOUBLE PRECISION)) AS DOUBLE PRECISION) / (CAST(SUM(n_k) AS DOUBLE PRECISION) * CAST(SUM(n_k) AS DOUBLE PRECISION)) AS originality_score FROM class_counts GROUP BY focal_patent) SELECT focal_patent AS PUBLICATION_NUMBER, ROUND(originality_score, 1) AS ORIGINALITY FROM originality WHERE originality_score > 0 ORDER BY orig