s AS (SELECT focal_patent, assigned_class, COUNT(*) AS n_k FROM cited_class GROUP BY focal_patent, assigned_class), originality AS (SELECT focal_patent, 1.0 - CAST(SUM(CAST(n_k AS DOUBLE PRECISION) * CAST(n_k AS DOUBLE PRECISION)) AS DOUBLE PRECISION) / (CAST(SUM(n_k) AS DOUBLE PRECISION) * CAST(SUM(n_k) AS DOUBLE PRECISION)) AS originality_score FROM class_counts GROUP BY focal_patent) SELECT focal_patent AS PUBLICATION_NUMBER, ROUND(originality_score, 1) AS ORIGINALITY FROM originality WHERE originality_score > 0 ORDER BY originality_score DESC, PUBLICATION_NUMBER ASC LIMIT 1") t := by
