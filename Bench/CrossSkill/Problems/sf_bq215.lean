/-!
# sf_bq215 — crossskill equivalence(s)

Question: Which US patent (with a B2 kind code and a grant date between 2015 and 2018) has the highest originality score calculated as 1 - (the sum of squared occurrences of distinct 4-digit IPC codes in its backward citations divided by the square of the total occurrences of these 4-digit IPC codes)?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq215

CREATE TABLE PUBLICATIONS («publication_number» STRING, «application_number» STRING, «country_code» STRING, «kind_code» STRING, «application_kind» STRING, «application_number_formatted» STRING, «pct_number» STRING, «family_id» STRING, «spif_publication_number» STRING, «spif_application_number» STRING, «title_localized» STRING, «abstract_localized» STRING, «claims_localized» STRING, «claims_localized_html» STRING, «description_localized» STRING, «description_localized_html» STRING, «publication_date» INT, «filing_date» INT, «grant_date» INT, «priority_date» INT, «priority_claim» STRING, «inventor» STRING, «inventor_harmonized» STRING, «assignee» STRING, «assignee_harmonized» STRING, «examiner» STRING, «uspc» STRING, «ipc» STRING, «cpc» STRING, «fi» STRING, «fterm» STRING, «locarno» STRING, «citation» STRING, «parent» STRING, «child» STRING, «entity_status» STRING, «art_unit» STRING)

HYPOTHESIS hyp0_1_0 : PUBLICATIONS "\"country_code\" = 'US'"
HYPOTHESIS hyp0_1_1 : PUBLICATIONS "\"kind_code\" = 'B2'"
HYPOTHESIS hyp0_1_2 : PUBLICATIONS "\"grant_date\" >= 20150101"
HYPOTHESIS hyp0_1_3 : PUBLICATIONS "\"grant_date\" <= 20181231"
HYPOTHESIS hyp0_1_4 : PUBLICATIONS "NOT CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) IS NULL"
theorem eq_0_1 (t : TableRel PUBLICATIONS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) (h3 : hyp0_1_3 t) (h4 : hyp0_1_4 t) :
    (sql%([PUBLICATIONS_schema]) "WITH backward_citations AS (/* Get all backward citations for US B2 patents with grant date 2015-2018 */ SELECT p1.\"publication_number\" AS citing_patent, CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) AS cited_patent FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" AS p1, LATERAL UNNEST(input => p1.\"citation\") AS c(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE p1.\"country_code\" = 'US' AND p1.\"kind_code\" = 'B2' AND p1.\"grant_date\" >= 20150101 AND p1.\"grant_date\" <= 20181231 AND NOT CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) IS NULL AND CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) <> ''), cited_ipc_counts AS (/* For each cited patent, count frequency of each 4-digit IPC code */ SELECT bc.citing_patent, bc.cited_patent, SUBSTRING(CAST(JSON_EXTRACT_PATH(ipc.value, 'code') AS TEXT) FROM 1 FOR 4) AS ipc_4digit, COUNT(*) AS freq FROM backward_citations AS bc JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" AS p2 ON bc.cited_patent = p2.\"publication_number\", LATERAL UNNEST(input => p2.\"ipc\") AS ipc(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY bc.citing_patent, bc.cited_patent, SUBSTRING(CAST(JSON_EXTRACT_PATH(ipc.value, 'code') AS TEXT) FROM 1 FOR 4)), cited_main_class AS (/* Assign each cited patent its main (most frequent) 4-digit IPC class */ SELECT citing_patent, cited_patent, ipc_4digit, ROW_NUMBER() OVER (PARTITION BY citing_patent, cited_patent ORDER BY freq DESC, ipc_4digit ASC) AS rn FROM cited_ipc_counts), cited_with_class AS (SELECT citing_patent, cited_patent, ipc_4digit AS main_class FROM cited_main_class WHERE rn = 1), class_counts AS (/* Count number of cited patents per class per citing patent */ SELECT citing_patent, main_class, COUNT(*) AS ncited_k FROM cited_with_class GROUP BY citing_patent, main_class), total_counts AS (/* Total cited patents per citing patent */ SELECT citing_patent, SUM(ncited_k) AS ncited_i FROM class_counts GROUP BY citing_patent), originality AS (SELECT cc.citing_patent, 1.0 - SUM(POWER(CAST(cc.ncited_k AS DOUBLE PRECISION) / CAST(tc.ncited_i AS DOUBLE PRECISION), 2)) AS originality_score FROM class_counts AS cc JOIN total_counts AS tc ON cc.citing_patent = tc.citing_patent GROUP BY cc.citing_patent, tc.ncited_i) SELECT citing_patent AS PUBLICATION_NUMBER, originality_score AS ORIGINALITY FROM originality ORDER BY originality_score DESC, citing_patent ASC LIMIT 1") t ~= (sql%([PUBLICATIONS_schema]) "WITH us_b2_patents AS (SELECT \"publication_number\" FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" WHERE \"country_code\" = 'US' AND \"kind_code\" = 'B2' AND \"grant_date\" >= 20150101 AND \"grant_date\" <= 20181231), focal_citations AS (SELECT p.\"publication_number\" AS focal_pub, CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) AS cited_pub FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" AS p JOIN us_b2_patents AS ubp ON p.\"publication_number\" = ubp.\"publication_number\", LATERAL UNNEST(input => p.\"citation\") AS c(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) IS NULL), cited_ipc_counts AS (SELECT fc.focal_pub, fc.cited_pub, LEFT(CAST(JSON_EXTRACT_PATH(f2.value, 'code') AS TEXT), 4) AS ipc_4, COUNT(*) AS ipc_cnt FROM focal_citations AS fc JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" AS cited ON cited.\"publication_number\" = fc.cited_pub, LATERAL UNNEST(input => cited.\"ipc\") AS f2(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT CAST(JSON_EXTRACT_PATH(f2.value, 'code') AS TEXT) IS NULL GROUP BY fc.focal_pub, fc.cited_pub, LEFT(CAST(JSON_EXTRACT_PATH(f2.value, 'code') AS TEXT), 4)), ranked AS (SELECT focal_pub, cited_pub, ipc_4, ROW_NUMBER() OVER (PARTITION BY focal_pub, cited_pub ORDER BY ipc_cnt DESC, ipc_4 ASC) AS rn FROM cited_ipc_counts), cited_primary_ipc AS (SELECT focal_pub, cited_pub, ipc_4 FROM ranked WHERE rn = 1), ipc_class_counts AS (SELECT focal_pub, ipc_4, COUNT(*) AS n_k FROM cited_primary_ipc GROUP BY focal_pub, ipc_4), originality AS (SELECT focal_pub AS \"PUBLICATION_NUMBER\", 1.0 - CAST(SUM(POWER(n_k, 2)) AS DOUBLE PRECISION) / POWER(SUM(n_k), 2) AS \"ORIGINALITY\" FROM ipc_class_counts GROUP BY focal_pub) SELECT \"PUBLICATION_NUMBER\", \"ORIGINALITY\" FROM originality ORDER BY \"ORIGINALITY\" DESC, \"PUBLICATION_NUMBER\" ASC LIMIT 1") t := by
  first | sql_equiv | sorry

