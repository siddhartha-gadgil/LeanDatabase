/-!
# sf_bq029 — crossskill equivalence(s)

Question: Get the average number of inventors per patent and the total count of patent publications in Canada (CA) for each 5-year period from 1960 to 2020, based on publication dates. Only include patents that have at least one inventor listed, and group results by 5-year intervals (1960-1964, 1965-1969, etc.).

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq029

CREATE TABLE PUBLICATIONS («publication_number» STRING, «application_number» STRING, «country_code» STRING, «kind_code» STRING, «application_kind» STRING, «application_number_formatted» STRING, «pct_number» STRING, «family_id» STRING, «spif_publication_number» STRING, «spif_application_number» STRING, «title_localized» STRING, «abstract_localized» STRING, «claims_localized» STRING, «claims_localized_html» STRING, «description_localized» STRING, «description_localized_html» STRING, «publication_date» INT, «filing_date» INT, «grant_date» INT, «priority_date» INT, «priority_claim» STRING, «inventor» STRING, «inventor_harmonized» STRING, «assignee» STRING, «assignee_harmonized» STRING, «examiner» STRING, «uspc» STRING, «ipc» STRING, «cpc» STRING, «fi» STRING, «fterm» STRING, «locarno» STRING, «citation» STRING, «parent» STRING, «child» STRING, «entity_status» STRING, «art_unit» STRING)

HYPOTHESIS hyp0_1_0 : PUBLICATIONS "FLOOR(CAST(\"publication_date\" AS DOUBLE PRECISION) / 10000) >= 1960"
HYPOTHESIS hyp0_1_1 : PUBLICATIONS "FLOOR(CAST(\"publication_date\" AS DOUBLE PRECISION) / 10000) <= 2020"
HYPOTHESIS hyp0_1_2 : PUBLICATIONS "ARRAY_LENGTH(\"inventor\", 1) >= 1"
theorem eq_0_1 (t : TableRel PUBLICATIONS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) :
    (sql%([PUBLICATIONS_schema]) "WITH ca_patents AS (SELECT FLOOR(CAST(\"publication_date\" AS DOUBLE PRECISION) / 10000) AS pub_year, ARRAY_LENGTH(\"inventor\", 1) AS num_inventors FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" WHERE \"country_code\" = 'CA' AND FLOOR(CAST(\"publication_date\" AS DOUBLE PRECISION) / 10000) >= 1960 AND FLOOR(CAST(\"publication_date\" AS DOUBLE PRECISION) / 10000) <= 2020 AND ARRAY_LENGTH(\"inventor\", 1) > 0), bucketed AS (SELECT FLOOR(CAST(pub_year AS DOUBLE PRECISION) / 5) * 5 AS period_start, LEAST(FLOOR(CAST(pub_year AS DOUBLE PRECISION) / 5) * 5 + 4, 2020) AS period_end, num_inventors FROM ca_patents) SELECT CAST(period_start AS VARCHAR) || '-' || CAST(period_end AS VARCHAR) AS PERIOD, ROUND(CAST(AVG(num_inventors) AS DECIMAL), 6) AS AVG_INVENTORS_PER_PATENT, COUNT(*) AS TOTAL_PATENT_PUBLICATIONS FROM bucketed GROUP BY period_start, period_end ORDER BY period_start") t ~= (sql%([PUBLICATIONS_schema]) "WITH patent_data AS (SELECT FLOOR(CAST(\"publication_date\" AS DOUBLE PRECISION) / 10000) AS pub_year, ARRAY_LENGTH(\"inventor\", 1) AS inventor_count FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" WHERE \"country_code\" = 'CA' AND ARRAY_LENGTH(\"inventor\", 1) >= 1 AND FLOOR(CAST(\"publication_date\" AS DOUBLE PRECISION) / 10000) BETWEEN 1960 AND 2020), period_data AS (SELECT FLOOR(CAST((pub_year - 1960) AS DOUBLE PRECISION) / 5) * 5 + 1960 AS period_start, LEAST(FLOOR(CAST((pub_year - 1960) AS DOUBLE PRECISION) / 5) * 5 + 1964, 2020) AS period_end, inventor_count FROM patent_data) SELECT CAST(period_start AS VARCHAR) || '-' || CAST(period_end AS VARCHAR) AS PERIOD, ROUND(CAST(AVG(inventor_count) AS DECIMAL), 6) AS AVG_INVENTORS_PER_PATENT, COUNT(*) AS TOTAL_PATENT_PUBLICATIONS FROM period_data GROUP BY period_start, period_end ORDER BY period_start") t := by
  first | sql_equiv | sorry

