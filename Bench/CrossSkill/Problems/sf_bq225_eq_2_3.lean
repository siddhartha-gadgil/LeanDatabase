import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq225_eq_2_3

CREATE TABLE SAMPLE_FILES («repo_name» STRING, «ref» STRING, «path» STRING, «mode» INT, «id» STRING, «symlink_target» STRING)
CREATE TABLE SAMPLE_CONTENTS («id» STRING, «size» INT, «content» STRING, «binary» BOOL, «copies» INT, «sample_repo_name» STRING, «sample_ref» STRING, «sample_path» STRING, «sample_mode» INT, «sample_symlink_target» STRING)

theorem eq (t0 : TableRel SAMPLE_FILES_schema) (t1 : TableRel SAMPLE_CONTENTS_schema) :
    (sql%([SAMPLE_FILES_schema, SAMPLE_CONTENTS_schema]) "WITH file_extensions AS (SELECT f.\"id\", f.\"path\", LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) AS ext FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_FILES\" AS f INNER JOIN \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS c ON f.\"id\" = c.\"id\" WHERE NOT c.\"content\" IS NULL AND c.\"content\" <> '' AND c.\"binary\" = FALSE), lang_map AS (SELECT ext, language FROM (SELECT '.asm' AS ext, 'Assembly' AS language UNION ALL SELECT '.nasm', 'Assembly' UNION ALL SELECT '.c', 'C' UNION ALL SELECT '.h', 'C' UNION ALL SELECT '.cs', 'C#' UNION ALL SELECT '.c++', 'C++' UNION ALL SELECT '.cpp', 'C++' UNION ALL SELECT '.h++', 'C++' UNION ALL SELECT '.hpp', 'C++' UNION ALL SELECT '.css', 'CSS' UNION ALL SELECT '.clj', 'Clojure' UNION ALL SELECT '.lisp', 'Common Lisp' UNION ALL SELECT '.d', 'D' UNION ALL SELECT '.dart', 'Dart' UNION ALL SELECT '.ex', 'Elixir' UNION ALL SELECT '.exs', 'Elixir' UNION ALL SELECT '.erl', 'Erlang' UNION ALL SELECT '.go', 'Go' UNION ALL SELECT '.groovy', 'Groovy' UNION ALL SELECT '.html', 'HTML' UNION ALL SELECT '.htm', 'HTML' UNION ALL SELECT '.hs', 'Haskell' UNION ALL SELECT '.hx', 'Haxe' UNION ALL SELECT '.json', 'JSON' UNION ALL SELECT '.java', 'Java' UNION ALL SELECT '.js', 'JavaScript' UNION ALL SELECT '.cjs', 'JavaScript' UNION ALL SELECT '.jl', 'Julia' UNION ALL SELECT '.kt', 'Kotlin' UNION ALL SELECT '.ktm', 'Kotlin' UNION ALL SELECT '.kts', 'Kotlin' UNION ALL SELECT '.lua', 'Lua' UNION ALL SELECT '.matlab', 'MATLAB' UNION ALL SELECT '.m', 'MATLAB' UNION ALL SELECT '.md', 'Markdown' UNION ALL SELECT '.markdown', 'Markdown' UNION ALL SELECT '.mdown', 'Markdown' UNION ALL SELECT '.php', 'PHP' UNION ALL SELECT '.ps1', 'PowerShell' UNION ALL SELECT '.psd1', 'PowerShell' UNION ALL SELECT '.psm1', 'PowerShell' UNION ALL SELECT '.py', 'Python' UNION ALL SELECT '.r', 'R' UNION ALL SELECT '.rb', 'Ruby' UNION ALL SELECT '.rs', 'Rust' UNION ALL SELECT '.scss', 'SCSS' UNION ALL SELECT '.sql', 'SQL' UNION ALL SELECT '.sass', 'Sass' UNION ALL SELECT '.scala', 'Scala' UNION ALL SELECT '.sh', 'Shell' UNION ALL SELECT '.bash', 'Shell' UNION ALL SELECT '.swift', 'Swift' UNION ALL SELECT '.ts', 'TypeScript' UNION ALL SELECT '.vue', 'Vue' UNION ALL SELECT '.xml', 'XML' UNION ALL SELECT '.yml', 'YAML' UNION ALL SELECT '.yaml', 'YAML')) SELECT lm.language AS \"language\" FROM file_extensions AS fe INNER JOIN lang_map AS lm ON fe.ext = lm.ext GROUP BY lm.language ORDER BY COUNT(*) DESC, lm.language ASC LIMIT 10") t0 t1
  ~= (sql%([SAMPLE_FILES_schema, SAMPLE_CONTENTS_schema]) "WITH file_lang AS (SELECT f.\"id\", f.\"path\", CASE WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.asm', '.nasm') THEN 'Assembly' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.c', '.h') THEN 'C' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.cs' THEN 'C#' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.c++', '.cpp', '.h++', '.hpp') THEN 'C++' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.css' THEN 'CSS' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.clj' THEN 'Clojure' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.lisp' THEN 'Common Lisp' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.d' THEN 'D' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.dart' THEN 'Dart' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '[^/]+$', 0)) = 'dockerfile' OR LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.dockerfile' THEN 'Dockerfile' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.ex', '.exs') THEN 'Elixir' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.erl' THEN 'Erlang' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.go' THEN 'Go' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.groovy' THEN 'Groovy' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.html', '.htm') THEN 'HTML' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.hs' THEN 'Haskell' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.hx' THEN 'Haxe' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.json' THEN 'JSON' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.java' THEN 'Java' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.js', '.cjs') THEN 'JavaScript' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.jl' THEN 'Julia' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.kt', '.ktm', '.kts') THEN 'Kotlin' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.lua' THEN 'Lua' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.matlab', '.m') THEN 'MATLAB' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.md', '.markdown', '.mdown') THEN 'Markdown' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.php' THEN 'PHP' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.ps1', '.psd1', '.psm1') THEN 'PowerShell' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.py' THEN 'Python' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.r' THEN 'R' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.rb' THEN 'Ruby' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.rs' THEN 'Rust' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.scss' THEN 'SCSS' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.sql' THEN 'SQL' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.sass' THEN 'Sass' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.scala' THEN 'Scala' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.sh', '.bash') THEN 'Shell' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.swift' THEN 'Swift' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.ts' THEN 'TypeScript' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.vue' THEN 'Vue' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) = '.xml' THEN 'XML' WHEN LOWER(REGEXP_EXTRACT(f.\"path\", '\\.[^./]+$', 0)) IN ('.yml', '.yaml') THEN 'YAML' ELSE NULL END AS language FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_FILES\" AS f INNER JOIN \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS c ON f.\"id\" = c.\"id\" WHERE NOT c.\"content\" IS NULL AND c.\"content\" <> '') SELECT language FROM file_lang WHERE NOT language IS NULL GROUP BY language ORDER BY COUNT(*) DESC LIMIT 10") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq225_eq_2_3
