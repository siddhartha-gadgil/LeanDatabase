import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq186 — crossskill equivalence(s)

Question: Please find, for each year-month combination (in the format YYYYMM) derived from the start date of bike share trips in San Francisco, the first trip duration in minutes, the last trip duration in minutes, the highest trip duration in minutes, and the lowest trip duration in minutes, where ‘first’ and ‘last’ are determined by the chronological order of the trip start date, then group your results by this year-month and sort them by the same year-month key.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq186

CREATE TABLE BIKESHARE_TRIPS («trip_id» INT, «duration_sec» INT, «start_date» INT, «start_station_name» STRING, «start_station_id» INT, «end_date» INT, «end_station_name» STRING, «end_station_id» INT, «bike_number» INT, «zip_code» STRING, «subscriber_type» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([BIKESHARE_TRIPS_schema]) "WITH trip_data AS (\n  SELECT\n    TO_CHAR(TO_TIMESTAMP(\"start_date\" / 1000000), 'YYYYMM') AS YEAR_MONTH,\n    \"start_date\",\n    \"duration_sec\"\n  FROM \"SAN_FRANCISCO\".\"SAN_FRANCISCO\".\"BIKESHARE_TRIPS\"\n),\nmonth_bounds AS (\n  SELECT \n    YEAR_MONTH,\n    MIN(\"start_date\") AS first_start,\n    MAX(\"start_date\") AS last_start,\n    MAX(\"duration_sec\") AS highest_dur,\n    MIN(\"duration_sec\") AS lowest_dur\n  FROM trip_data\n  GROUP BY YEAR_MONTH\n),\nfirst_trips AS (\n  SELECT t.YEAR_MONTH, MAX(t.\"duration_sec\") AS first_dur\n  FROM trip_data t\n  JOIN month_bounds m ON t.YEAR_MONTH = m.YEAR_MONTH AND t.\"start_date\" = m.first_start\n  GROUP BY t.YEAR_MONTH\n),\nlast_trips AS (\n  SELECT t.YEAR_MONTH, MIN(t.\"duration_sec\") AS last_dur\n  FROM trip_data t\n  JOIN month_bounds m ON t.YEAR_MONTH = m.YEAR_MONTH AND t.\"start_date\" = m.last_start\n  GROUP BY t.YEAR_MONTH\n)\nSELECT \n  ROUND(f.first_dur / 60.0, 6) AS FIRST_TRIP_DURATION_MINUTES,\n  ROUND(l.last_dur / 60.0, 6) AS LAST_TRIP_DURATION_MINUTES,\n  ROUND(m.highest_dur / 60.0, 6) AS HIGHEST_TRIP_DURATION_MINUTES,\n  ROUND(m.lowest_dur / 60.0, 6) AS LOWEST_TRIP_DURATION_MINUTES,\n  m.YEAR_MONTH\nFROM month_bounds m\nJOIN first_trips f ON m.YEAR_MONTH = f.YEAR_MONTH\nJOIN last_trips l ON m.YEAR_MONTH = l.YEAR_MONTH\nORDER BY m.YEAR_MONTH;") t ~= (sql%([BIKESHARE_TRIPS_schema]) "WITH base AS (\n  SELECT\n    TO_CHAR(TO_TIMESTAMP(\"start_date\" / 1000000), 'YYYYMM') AS YEAR_MONTH,\n    \"start_date\",\n    \"duration_sec\" / 60.0 AS duration_minutes\n  FROM \"SAN_FRANCISCO\".\"SAN_FRANCISCO\".\"BIKESHARE_TRIPS\"\n),\nranked AS (\n  SELECT\n    YEAR_MONTH,\n    duration_minutes,\n    ROW_NUMBER() OVER (PARTITION BY YEAR_MONTH ORDER BY \"start_date\" ASC, duration_minutes DESC) AS rn_first,\n    ROW_NUMBER() OVER (PARTITION BY YEAR_MONTH ORDER BY \"start_date\" DESC, duration_minutes ASC) AS rn_last\n  FROM base\n)\nSELECT\n  MAX(CASE WHEN rn_first = 1 THEN duration_minutes END) AS FIRST_TRIP_DURATION_MINUTES,\n  MAX(CASE WHEN rn_last = 1 THEN duration_minutes END) AS LAST_TRIP_DURATION_MINUTES,\n  MAX(duration_minutes) AS HIGHEST_TRIP_DURATION_MINUTES,\n  MIN(duration_minutes) AS LOWEST_TRIP_DURATION_MINUTES,\n  YEAR_MONTH\nFROM ranked\nGROUP BY YEAR_MONTH\nORDER BY YEAR_MONTH;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([BIKESHARE_TRIPS_schema]) "WITH trip_data AS (\n  SELECT\n    TO_CHAR(TO_TIMESTAMP(\"start_date\" / 1000000), 'YYYYMM') AS YEAR_MONTH,\n    \"start_date\",\n    \"duration_sec\"\n  FROM \"SAN_FRANCISCO\".\"SAN_FRANCISCO\".\"BIKESHARE_TRIPS\"\n),\nmonth_bounds AS (\n  SELECT \n    YEAR_MONTH,\n    MIN(\"start_date\") AS first_start,\n    MAX(\"start_date\") AS last_start,\n    MAX(\"duration_sec\") AS highest_dur,\n    MIN(\"duration_sec\") AS lowest_dur\n  FROM trip_data\n  GROUP BY YEAR_MONTH\n),\nfirst_trips AS (\n  SELECT t.YEAR_MONTH, MAX(t.\"duration_sec\") AS first_dur\n  FROM trip_data t\n  JOIN month_bounds m ON t.YEAR_MONTH = m.YEAR_MONTH AND t.\"start_date\" = m.first_start\n  GROUP BY t.YEAR_MONTH\n),\nlast_trips AS (\n  SELECT t.YEAR_MONTH, MIN(t.\"duration_sec\") AS last_dur\n  FROM trip_data t\n  JOIN month_bounds m ON t.YEAR_MONTH = m.YEAR_MONTH AND t.\"start_date\" = m.last_start\n  GROUP BY t.YEAR_MONTH\n)\nSELECT \n  ROUND(f.first_dur / 60.0, 6) AS FIRST_TRIP_DURATION_MINUTES,\n  ROUND(l.last_dur / 60.0, 6) AS LAST_TRIP_DURATION_MINUTES,\n  ROUND(m.highest_dur / 60.0, 6) AS HIGHEST_TRIP_DURATION_MINUTES,\n  ROUND(m.lowest_dur / 60.0, 6) AS LOWEST_TRIP_DURATION_MINUTES,\n  m.YEAR_MONTH\nFROM month_bounds m\nJOIN first_trips f ON m.YEAR_MONTH = f.YEAR_MONTH\nJOIN last_trips l ON m.YEAR_MONTH = l.YEAR_MONTH\nORDER BY m.YEAR_MONTH;") t ~= (sql%([BIKESHARE_TRIPS_schema]) "WITH trips AS (\n  SELECT\n    TO_CHAR(TO_TIMESTAMP(\"start_date\" / 1000000), 'YYYYMM') AS YEAR_MONTH,\n    \"duration_sec\" / 60.0 AS duration_minutes,\n    \"start_date\",\n    \"trip_id\",\n    ROW_NUMBER() OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP(\"start_date\" / 1000000), 'YYYYMM') ORDER BY \"start_date\" ASC, \"trip_id\" ASC) AS rn_asc,\n    ROW_NUMBER() OVER (PARTITION BY TO_CHAR(TO_TIMESTAMP(\"start_date\" / 1000000), 'YYYYMM') ORDER BY \"start_date\" DESC, \"trip_id\" DESC) AS rn_desc\n  FROM \"SAN_FRANCISCO\".\"SAN_FRANCISCO\".\"BIKESHARE_TRIPS\"\n),\nfirst_last AS (\n  SELECT\n    YEAR_MONTH,\n    MAX(CASE WHEN rn_asc = 1 THEN duration_minutes END) AS FIRST_TRIP_DURATION_MINUTES,\n    MAX(CASE WHEN rn_desc = 1 THEN duration_minutes END) AS LAST_TRIP_DURATION_MINUTES,\n    MAX(duration_minutes) AS HIGHEST_TRIP_DURATION_MINUTES,\n    MIN(duration_minutes) AS LOWEST_TRIP_DURATION_MINUTES\n  FROM trips\n  GROUP BY YEAR_MONTH\n)\nSELECT\n  FIRST_TRIP_DURATION_MINUTES,\n  LAST_TRIP_DURATION_MINUTES,\n  HIGHEST_TRIP_DURATION_MINUTES,\n  LOWEST_TRIP_DURATION_MINUTES,\n  YEAR_MONTH\nFROM first_last\nORDER BY YEAR_MONTH;") t := by
  intro t; first | sql_equiv | sorry

