/-!
# sf_bq186 — crossskill equivalence(s)

Question: Please find, for each year-month combination (in the format YYYYMM) derived from the start date of bike share trips in San Francisco, the first trip duration in minutes, the last trip duration in minutes, the highest trip duration in minutes, and the lowest trip duration in minutes, where ‘first’ and ‘last’ are determined by the chronological order of the trip start date, then group your results by this year-month and sort them by the same year-month key.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq186

CREATE TABLE BIKESHARE_TRIPS («trip_id» INT, «duration_sec» INT, «start_date» INT, «start_station_name» STRING, «start_station_id» INT, «end_date» INT, «end_station_name» STRING, «end_station_id» INT, «bike_number» INT, «zip_code» STRING, «subscriber_type» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([BIKESHARE_TRIPS_schema]) "WITH trip_data AS (SELECT TO_CHAR(TO_TIMESTAMP(CAST(\"start_date\" AS DOUBLE PRECISION) / 1000000), 'YYYYMM') AS YEAR_MONTH, \"start_date\", \"duration_sec\" FROM \"SAN_FRANCISCO\".\"SAN_FRANCISCO\".\"BIKESHARE_TRIPS\"), month_bounds AS (SELECT YEAR_MONTH, MIN(\"start_date\") AS first_start, MAX(\"start_date\") AS last_start, MAX(\"duration_sec\") AS highest_dur, MIN(\"duration_sec\") AS lowest_dur FROM trip_data GROUP BY YEAR_MONTH), first_trips AS (SELECT t.YEAR_MONTH, MAX(t.\"duration_sec\") AS first_dur FROM trip_data AS t JOIN month_bounds AS m ON t.YEAR_MONTH = m.YEAR_MONTH AND t.\"start_date\" = m.first_start GROUP BY t.YEAR_MONTH), last_trips AS (SELECT t.YEAR_MONTH, MIN(t.\"duration_sec\") AS last_dur FROM trip_data AS t JOIN month_bounds AS m ON t.YEAR_MONTH = m.YEAR_MONTH AND t.\"start_date\" = m.last_start GROUP BY t.YEAR_MONTH) SELECT ROUND(CAST(CAST(f.first_dur AS DOUBLE PRECISION) / 60.0 AS DECIMAL), 6) AS FIRST_TRIP_DURATION_MINUTES, ROUND(CAST(CAST(l.last_dur AS DOUBLE PRECISION) / 60.0 AS DECIMAL), 6) AS LAST_TRIP_DURATION_MINUTES, ROUND(CAST(CAST(m.highest_dur AS DOUBLE PRECISION) / 60.0 AS DECIMAL), 6) AS HIGHEST_TRIP_DURATION_MINUTES, ROUND(CAST(CAST(m.lowest_dur AS DOUBLE PRECISION) / 60.0 AS DECIMAL), 6) AS LOWEST_TRIP_DURATION_MINUTES, m.YEAR_MONTH FROM month_bounds AS m JOIN first_trips AS f ON m.YEAR_MONTH = f.YEAR_MONTH JOIN last_trips AS l ON m.YEAR_MONTH = l.YEAR_MONTH ORDER BY m.YEAR_MONTH") t ~= (sql%([BIKESHARE_TRIPS_schema]) "WITH base AS (SELECT TO_CHAR(TO_TIMESTAMP(CAST(\"start_date\" AS DOUBLE PRECISION) / 1000000), 'YYYYMM') AS YEAR_MONTH, \"start_date\", CAST(\"duration_sec\" AS DOUBLE PRECISION) / 60.0 AS duration_minutes FROM \"SAN_FRANCISCO\".\"SAN_FRANCISCO\".\"BIKESHARE_TRIPS\"), ranked AS (SELECT YEAR_MONTH, duration_minutes, ROW_NUMBER() OVER (PARTITION BY YEAR_MONTH ORDER BY \"start_date\" ASC, duration_minutes DESC) AS rn_first, ROW_NUMBER() OVER (PARTITION BY YEAR_MONTH ORDER BY \"start_date\" DESC, duration_minutes ASC) AS rn_last FROM base) SELECT MAX(CASE WHEN rn_first = 1 THEN duration_minutes END) AS FIRST_TRIP_DURATION_MINUTES, MAX(CASE WHEN rn_last = 1 THEN duration_minutes END) AS LAST_TRIP_DURATION_MINUTES, MAX(duration_minutes) AS HIGHEST_TRIP_DURATION_MINUTES, MIN(duration_minutes) AS LOWEST_TRIP_DURATION_MINUTES, YEAR_MONTH FROM ranked GROUP BY YEAR_MONTH ORDER BY YEAR_MONTH") t := by
  intro t; first | sql_equiv | sorry

