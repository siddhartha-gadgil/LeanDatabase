CREATE TABLE LEGISLATORS («full_name» STRING, «first_name» STRING, «last_name» STRING, «middle_name» STRING, «nickname» STRING, «suffix» STRING, «other_names_end» STRING, «other_names_middle» STRING, «other_names_last» STRING, «birthday» STRING, «gender» STRING, «id_bioguide» STRING, «id_bioguide_previous_0» STRING, «id_govtrack» INT, «id_icpsr» FLOAT, «id_wikipedia» STRING, «id_wikidata» STRING, «id_google_entity_id» STRING, «id_house_history» FLOAT, «id_house_history_alternate» FLOAT, «id_thomas» FLOAT, «id_cspan» FLOAT, «id_votesmart» FLOAT, «id_lis» STRING, «id_ballotpedia» STRING, «id_opensecrets» STRING, «id_fec_0» STRING, «id_fec_1» STRING, «id_fec_2» STRING)
CREATE TABLE LEGISLATORS_TERMS («id_bioguide» STRING, «term_number» INT, «term_id» STRING, «term_type» STRING, «term_start» STRING, «term_end» STRING, «state» STRING, «district» FLOAT, «class» FLOAT, «party» STRING, «how» STRING, «url» STRING, «address» STRING, «phone» STRING, «fax» STRING, «contact_form» STRING, «office» STRING, «state_rank» STRING, «rss_url» STRING, «caucus» STRING)

theorem eq (t0 : TableRel LEGISLATORS_schema) (t1 : TableRel LEGISLATORS_TERMS_schema) :
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_state AS (/* Get each legislator's first state (from their earliest term) */ SELECT \"id_bioguide\", \"state\" FROM (/* Get each legislator's first state (from their earliest term) */ SELECT \"id_bioguide\", \"state\", ROW_NUMBER() OVER (PARTITION BY \"id_bioguide\" ORDER BY \"term_start\" ASC) AS _w, \"term_start\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\") AS _t WHERE _w = 1), female_with_dec31 AS (/* Female legislators who have at least one term that includes December 31st */ /* A term includes Dec 31 if Dec 31 of the term's start year falls between term_start and term_end */ SELECT DISTINCT l.\"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON l.\"id_bioguide\" = t.\"id_bioguide\" WHERE l.\"gender\" = 'F' AND DATE_FROM_PARTS(EXTRACT(YEAR FROM CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE)), 12, 31) BETWEEN CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE) AND CAST(TO_TIMESTAMP(t.\"term_end\", 'YYYY-MM-DD') AS DATE)) SELECT fs.\"state\", COUNT(*) AS \"NUMBER_OF_LEGISLATORS\" FROM female_with_dec31 AS fd JOIN first_state AS fs ON fd.\"id_bioguide\" = fs.\"id_bioguide\" GROUP BY fs.\"state\" ORDER BY \"NUMBER_OF_LEGISLATORS\" DESC LIMIT 1") t0 t1
  ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH female_legislators AS (SELECT \"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" WHERE \"gender\" = 'F'), first_state /* Get the first state each female legislator represented */ AS (SELECT \"id_bioguide\", \"state\" FROM (SELECT lt.\"id_bioguide\", lt.\"state\", ROW_NUMBER() OVER (PARTITION BY lt.\"id_bioguide\" ORDER BY lt.\"term_start\" ASC) AS _w, lt.\"term_start\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS lt INNER JOIN female_legislators AS fl ON lt.\"id_bioguide\" = fl.\"id_bioguide\") AS _t WHERE _w = 1), dec31_dates /* Generate Dec 31 dates for years 1789-2025 */ AS (SELECT DATE_FROM_PARTS(1789 + SEQ4(), 12, 31) AS dec31_date FROM TABLE(GENERATOR(237))), legislators_with_dec31 /* Find female legislators whose any term included December 31st */ AS (SELECT DISTINCT lt.\"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS lt INNER JOIN female_legislators AS fl ON lt.\"id_bioguide\" = fl.\"id_bioguide\" INNER JOIN dec31_dates AS d ON d.dec31_date BETWEEN lt.\"term_start\" AND lt.\"term_end\"), state_counts /* Count by first state */ AS (SELECT fs.\"state\", COUNT(DISTINCT fs.\"id_bioguide\") AS num_female_legislators FROM first_state AS fs INNER JOIN legislators_with_dec31 AS ld ON fs.\"id_bioguide\" = ld.\"id_bioguide\" GROUP BY fs.\"state\") SELECT \"state\", num_female_legislators FROM state_counts ORDER BY num_female_legislators DESC LIMIT 1") t0 t1
