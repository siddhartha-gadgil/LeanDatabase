import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local201 — crossskill equivalence(s)

Question: Identify the first 10 words, sorted alphabetically, that are 4 to 5 characters long, start with 'r', and have at least one anagram of the same length, considering case-sensitive letters. Provide the count of such anagrams for each word.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local201

CREATE TABLE WORD_LIST («words» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([WORD_LIST_schema]) "WITH all_words AS (\n    SELECT DISTINCT \"words\" AS word,\n           ARRAY_TO_STRING(ARRAY_SORT(REGEXP_SUBSTR_ALL(\"words\", '.')), '') AS sorted_letters\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"WORD_LIST\"\n    WHERE LENGTH(\"words\") BETWEEN 4 AND 5\n),\nr_words AS (\n    SELECT word, sorted_letters\n    FROM all_words\n    WHERE word LIKE 'r%'\n),\nanagram_counts AS (\n    SELECT r.word AS WORD,\n           COUNT(a.word) AS ANAGRAM_COUNT\n    FROM r_words r\n    JOIN all_words a \n      ON r.sorted_letters = a.sorted_letters \n      AND r.word != a.word\n    GROUP BY r.word\n    HAVING COUNT(a.word) >= 1\n)\nSELECT WORD, ANAGRAM_COUNT\nFROM anagram_counts\nORDER BY WORD\nLIMIT 10;") t ~= (sql%([WORD_LIST_schema]) "WITH distinct_words AS (\n    SELECT DISTINCT \"words\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"WORD_LIST\"\n    WHERE LENGTH(\"words\") BETWEEN 4 AND 5\n),\nword_chars AS (\n    SELECT w.\"words\",\n           SUBSTR(w.\"words\", g.pos, 1) AS ch\n    FROM distinct_words w,\n         (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) AS pos\n          FROM TABLE(GENERATOR(ROWCOUNT => 5))) g\n    WHERE g.pos <= LENGTH(w.\"words\")\n),\nsorted_words AS (\n    SELECT \"words\",\n           LISTAGG(ch, '') WITHIN GROUP (ORDER BY ch) AS sorted_chars\n    FROM word_chars\n    GROUP BY \"words\"\n),\nanagram_counts AS (\n    SELECT s1.\"words\" AS WORD,\n           COUNT(*) AS ANAGRAM_COUNT\n    FROM sorted_words s1\n    JOIN sorted_words s2\n      ON s1.sorted_chars = s2.sorted_chars\n      AND LENGTH(s1.\"words\") = LENGTH(s2.\"words\")\n      AND s1.\"words\" != s2.\"words\"\n    WHERE s1.\"words\" LIKE 'r%'\n    GROUP BY s1.\"words\"\n    HAVING COUNT(*) >= 1\n)\nSELECT WORD, ANAGRAM_COUNT\nFROM anagram_counts\nORDER BY WORD\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([WORD_LIST_schema]) "WITH all_words AS (\n    SELECT DISTINCT \"words\" AS word,\n           ARRAY_TO_STRING(ARRAY_SORT(REGEXP_SUBSTR_ALL(\"words\", '.')), '') AS sorted_letters\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"WORD_LIST\"\n    WHERE LENGTH(\"words\") BETWEEN 4 AND 5\n),\nr_words AS (\n    SELECT word, sorted_letters\n    FROM all_words\n    WHERE word LIKE 'r%'\n),\nanagram_counts AS (\n    SELECT r.word AS WORD,\n           COUNT(a.word) AS ANAGRAM_COUNT\n    FROM r_words r\n    JOIN all_words a \n      ON r.sorted_letters = a.sorted_letters \n      AND r.word != a.word\n    GROUP BY r.word\n    HAVING COUNT(a.word) >= 1\n)\nSELECT WORD, ANAGRAM_COUNT\nFROM anagram_counts\nORDER BY WORD\nLIMIT 10;") t ~= (sql%([WORD_LIST_schema]) "WITH word_sigs AS (\n  SELECT\n    \"words\",\n    ARRAY_TO_STRING(ARRAY_SORT(REGEXP_SUBSTR_ALL(\"words\", '.')), '') AS sig\n  FROM \"MODERN_DATA\".\"MODERN_DATA\".\"WORD_LIST\"\n  WHERE LENGTH(\"words\") BETWEEN 4 AND 5\n),\nanagram_counts AS (\n  SELECT\n    sig,\n    COUNT(*) AS total_count\n  FROM word_sigs\n  GROUP BY sig\n  HAVING COUNT(*) > 1\n)\nSELECT\n  w.\"words\" AS \"WORD\",\n  a.total_count - 1 AS \"ANAGRAM_COUNT\"\nFROM word_sigs w\nJOIN anagram_counts a ON w.sig = a.sig\nWHERE w.\"words\" LIKE 'r%'\nORDER BY w.\"words\"\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_3 : ∀ t,
    (sql%([WORD_LIST_schema]) "WITH all_words AS (\n    SELECT DISTINCT \"words\" AS word,\n           ARRAY_TO_STRING(ARRAY_SORT(REGEXP_SUBSTR_ALL(\"words\", '.')), '') AS sorted_letters\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"WORD_LIST\"\n    WHERE LENGTH(\"words\") BETWEEN 4 AND 5\n),\nr_words AS (\n    SELECT word, sorted_letters\n    FROM all_words\n    WHERE word LIKE 'r%'\n),\nanagram_counts AS (\n    SELECT r.word AS WORD,\n           COUNT(a.word) AS ANAGRAM_COUNT\n    FROM r_words r\n    JOIN all_words a \n      ON r.sorted_letters = a.sorted_letters \n      AND r.word != a.word\n    GROUP BY r.word\n    HAVING COUNT(a.word) >= 1\n)\nSELECT WORD, ANAGRAM_COUNT\nFROM anagram_counts\nORDER BY WORD\nLIMIT 10;") t ~= (sql%([WORD_LIST_schema]) "WITH sorted_words AS (\n    SELECT w.\"words\",\n           LENGTH(w.\"words\") AS word_len,\n           LISTAGG(c.value::string, '') WITHIN GROUP (ORDER BY c.value::string) AS sorted_word\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"WORD_LIST\" w,\n    LATERAL FLATTEN(input => REGEXP_SUBSTR_ALL(w.\"words\", '.')) c\n    WHERE LENGTH(w.\"words\") BETWEEN 4 AND 5\n    GROUP BY w.\"words\", LENGTH(w.\"words\")\n)\nSELECT s1.\"words\" AS WORD, COUNT(*) AS ANAGRAM_COUNT\nFROM sorted_words s1\nJOIN sorted_words s2\n  ON s1.sorted_word = s2.sorted_word\n  AND s1.word_len = s2.word_len\n  AND s1.\"words\" != s2.\"words\"\nWHERE LOWER(s1.\"words\") LIKE 'r%'\nGROUP BY s1.\"words\"\nORDER BY s1.\"words\"\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

