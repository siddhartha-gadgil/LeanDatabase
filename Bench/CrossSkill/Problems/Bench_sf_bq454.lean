import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq454 — crossskill equivalence(s)

Question: For the 1000 Genomes dataset, analyze common autosomal variants (those with an allele frequency of at least 0.05) across different super populations. For each super population, count how many variants are shared by each specific number of samples within that super population. Include in your results the total population size of each super population, whether the variant is common (allele frequency ≥ 0.05), the number of samples having each variant, and the total count of variants shared by that many samples. Only include autosomal variants by explicitly excluding sex chromosomes (X, Y) and mitochondrial DNA (MT) from the analysis. Consider only samples that have at least one alternate allele (non-reference) for the variant.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq454

CREATE TABLE SAMPLE_INFO («Sample» STRING, «Family_ID» STRING, «Population» STRING, «Population_Description» STRING, «Gender» STRING, «Relationship» STRING, «Unexpected_Parent_Child» STRING, «Non_Paternity» STRING, «Siblings» STRING, «Grandparents» STRING, «Avuncular» STRING, «Half_Siblings» STRING, «Unknown_Second_Order» STRING, «Third_Order» STRING, «In_Low_Coverage_Pilot» BOOL, «LC_Pilot_Platforms» STRING, «LC_Pilot_Centers» STRING, «In_High_Coverage_Pilot» BOOL, «HC_Pilot_Platforms» STRING, «HC_Pilot_Centers» STRING, «In_Exon_Targetted_Pilot» BOOL, «ET_Pilot_Platforms» STRING, «ET_Pilot_Centers» STRING, «Has_Sequence_in_Phase1» BOOL, «Phase1_LC_Platform» STRING, «Phase1_LC_Centers» STRING, «Phase1_E_Platform» STRING, «Phase1_E_Centers» STRING, «In_Phase1_Integrated_Variant_Set» BOOL, «Has_Phase1_chrY_SNPS» BOOL, «Has_phase1_chrY_Deletions» BOOL, «Has_phase1_chrMT_SNPs» BOOL, «Main_project_LC_Centers» STRING, «Main_project_LC_platform» STRING, «Total_LC_Sequence» FLOAT, «LC_Non_Duplicated_Aligned_Coverage» FLOAT, «Main_Project_E_Centers» STRING, «Main_Project_E_Platform» STRING, «Total_Exome_Sequence» FLOAT, «X_Targets_Covered_to_20x_or_greater» FLOAT, «VerifyBam_E_Omni_Free» FLOAT, «VerifyBam_E_Affy_Free» FLOAT, «VerifyBam_E_Omni_Chip» FLOAT, «VerifyBam_E_Affy_Chip» FLOAT, «VerifyBam_LC_Omni_Free» FLOAT, «VerifyBam_LC_Affy_Free» FLOAT, «VerifyBam_LC_Omni_Chip» FLOAT, «VerifyBam_LC_Affy_Chip» FLOAT, «LC_Indel_Ratio» FLOAT, «E_Indel_Ratio» FLOAT, «LC_Passed_QC» BOOL, «E_Passed_QC» BOOL, «In_Final_Phase_Variant_Calling» BOOL, «Has_Omni_Genotypes» BOOL, «Has_Axiom_Genotypes» BOOL, «Has_Affy_6_0_Genotypes» BOOL, «Has_Exome_LOF_Genotypes» BOOL, «EBV_Coverage» FLOAT, «DNA_Source_from_Coriell» STRING, «Has_Sequence_from_Blood_in_Index» BOOL, «Super_Population» STRING, «Super_Population_Description» STRING)
CREATE TABLE PEDIGREE («Family_ID» STRING, «Individual_ID» STRING, «Paternal_ID» STRING, «Maternal_ID» STRING, «Gender» INT, «Phenotype» INT, «Population» STRING, «Relationship» STRING, «Siblings» STRING, «Second_Order» STRING, «Third_Order» STRING, «Other_Comments» STRING)
CREATE TABLE VARIANTS («reference_name» STRING, «start» INT, «end» INT, «reference_bases» STRING, «alternate_bases» STRING, «quality» FLOAT, «filter» STRING, «names» STRING, «call» STRING, «AA» STRING, «AC» STRING, «AC1» INT, «AF» FLOAT, «AF1» FLOAT, «AFR_AF» FLOAT, «AMR_AF» FLOAT, «AN» INT, «ASN_AF» FLOAT, «AVGPOST» FLOAT, «CIEND» STRING, «CIPOS» STRING, «DP» INT, «DP4» STRING, «ERATE» FLOAT, «EUR_AF» FLOAT, «FQ» FLOAT, «G3» STRING, «HOMLEN» INT, «HOMSEQ» STRING, «HWE» FLOAT, «LDAF» FLOAT, «MQ» INT, «PV4» STRING, «RSQ» FLOAT, «SNPSOURCE» STRING, «SOURCE» STRING, «SVLEN» INT, «SVTYPE» STRING, «THETA» FLOAT, «VT» STRING)

theorem eq_0_1 :
    sql%([SAMPLE_INFO_schema, PEDIGREE_schema, VARIANTS_schema]) "WITH pop_sizes AS (\n  -- Total population size per super population from PEDIGREE\n  SELECT s.\"Super_Population\",\n         s.\"Super_Population_Description\",\n         COUNT(*) AS TOTAL_POPULATION_SIZE\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"PEDIGREE\" p\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" s \n    ON p.\"Individual_ID\" = s.\"Sample\"\n  GROUP BY s.\"Super_Population\", s.\"Super_Population_Description\"\n),\nvariant_sample_superpop AS (\n  -- Flatten call array, join with SAMPLE_INFO, filter autosomal + common + alt allele\n  SELECT v.\"reference_name\",\n         v.\"start\",\n         v.\"end\",\n         s.\"Super_Population\",\n         c.value:call_set_name::STRING AS sample_name\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" s \n    ON c.value:call_set_name::STRING = s.\"Sample\"\n  WHERE v.\"reference_name\" NOT IN ('X', 'Y', 'MT')\n    AND v.\"AF\" >= 0.05\n    AND (c.value:genotype[0]::INT > 0 OR c.value:genotype[1]::INT > 0)\n),\nsamples_per_variant_superpop AS (\n  -- Count how many samples per super pop have each variant\n  SELECT \"Super_Population\",\n         \"reference_name\",\n         \"start\",\n         \"end\",\n         COUNT(*) AS num_samples\n  FROM variant_sample_superpop\n  GROUP BY \"Super_Population\", \"reference_name\", \"start\", \"end\"\n),\nvariant_sharing AS (\n  -- Count how many variants are shared by each number of samples per super pop\n  SELECT \"Super_Population\",\n         num_samples AS SAMPLES_WITH_VARIANT,\n         COUNT(*) AS VARIANT_COUNT\n  FROM samples_per_variant_superpop\n  GROUP BY \"Super_Population\", num_samples\n)\nSELECT vs.\"Super_Population\",\n       ps.\"Super_Population_Description\",\n       ps.TOTAL_POPULATION_SIZE,\n       'Yes' AS IS_COMMON_VARIANT,\n       vs.SAMPLES_WITH_VARIANT,\n       vs.VARIANT_COUNT\nFROM variant_sharing vs\nJOIN pop_sizes ps ON vs.\"Super_Population\" = ps.\"Super_Population\"\nORDER BY vs.\"Super_Population\", vs.SAMPLES_WITH_VARIANT;" = sql%([SAMPLE_INFO_schema, PEDIGREE_schema, VARIANTS_schema]) "-- Step 1: Get population sizes from SAMPLE_INFO\nWITH pop_sizes AS (\n  SELECT \n    \"Super_Population\",\n    \"Super_Population_Description\",\n    COUNT(*) AS \"TOTAL_POPULATION_SIZE\"\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\"\n  GROUP BY \"Super_Population\", \"Super_Population_Description\"\n),\n-- Step 2: For each common autosomal variant, flatten calls and count samples with alt allele per super population\nvariant_sample_counts AS (\n  SELECT \n    v.\"reference_name\",\n    v.\"start\",\n    si.\"Super_Population\",\n    COUNT(*) AS samples_with_variant\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" si \n    ON c.value:\"call_set_name\"::STRING = si.\"Sample\"\n  WHERE v.\"reference_name\" NOT IN ('X', 'Y', 'MT')\n    AND TRY_CAST(v.\"AF\" AS FLOAT) >= 0.05\n    AND (c.value:\"genotype\"[0]::INT > 0 OR c.value:\"genotype\"[1]::INT > 0)\n  GROUP BY v.\"reference_name\", v.\"start\", si.\"Super_Population\"\n)\n-- Step 3: Group by super population and number of samples with variant\nSELECT \n  vsc.\"Super_Population\" AS \"SUPER_POPULATION\",\n  ps.\"Super_Population_Description\" AS \"SUPER_POPULATION_DESCRIPTION\",\n  ps.\"TOTAL_POPULATION_SIZE\",\n  'Yes' AS \"IS_COMMON_VARIANT\",\n  vsc.samples_with_variant AS \"SAMPLES_WITH_VARIANT\",\n  COUNT(*) AS \"VARIANT_COUNT\"\nFROM variant_sample_counts vsc\nJOIN pop_sizes ps ON vsc.\"Super_Population\" = ps.\"Super_Population\"\nGROUP BY \n  vsc.\"Super_Population\",\n  ps.\"Super_Population_Description\",\n  ps.\"TOTAL_POPULATION_SIZE\",\n  vsc.samples_with_variant\nORDER BY \n  vsc.\"Super_Population\",\n  vsc.samples_with_variant;" := by
  first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([SAMPLE_INFO_schema, PEDIGREE_schema, VARIANTS_schema]) "WITH pop_sizes AS (\n  -- Total population size per super population from PEDIGREE\n  SELECT s.\"Super_Population\",\n         s.\"Super_Population_Description\",\n         COUNT(*) AS TOTAL_POPULATION_SIZE\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"PEDIGREE\" p\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" s \n    ON p.\"Individual_ID\" = s.\"Sample\"\n  GROUP BY s.\"Super_Population\", s.\"Super_Population_Description\"\n),\nvariant_sample_superpop AS (\n  -- Flatten call array, join with SAMPLE_INFO, filter autosomal + common + alt allele\n  SELECT v.\"reference_name\",\n         v.\"start\",\n         v.\"end\",\n         s.\"Super_Population\",\n         c.value:call_set_name::STRING AS sample_name\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" s \n    ON c.value:call_set_name::STRING = s.\"Sample\"\n  WHERE v.\"reference_name\" NOT IN ('X', 'Y', 'MT')\n    AND v.\"AF\" >= 0.05\n    AND (c.value:genotype[0]::INT > 0 OR c.value:genotype[1]::INT > 0)\n),\nsamples_per_variant_superpop AS (\n  -- Count how many samples per super pop have each variant\n  SELECT \"Super_Population\",\n         \"reference_name\",\n         \"start\",\n         \"end\",\n         COUNT(*) AS num_samples\n  FROM variant_sample_superpop\n  GROUP BY \"Super_Population\", \"reference_name\", \"start\", \"end\"\n),\nvariant_sharing AS (\n  -- Count how many variants are shared by each number of samples per super pop\n  SELECT \"Super_Population\",\n         num_samples AS SAMPLES_WITH_VARIANT,\n         COUNT(*) AS VARIANT_COUNT\n  FROM samples_per_variant_superpop\n  GROUP BY \"Super_Population\", num_samples\n)\nSELECT vs.\"Super_Population\",\n       ps.\"Super_Population_Description\",\n       ps.TOTAL_POPULATION_SIZE,\n       'Yes' AS IS_COMMON_VARIANT,\n       vs.SAMPLES_WITH_VARIANT,\n       vs.VARIANT_COUNT\nFROM variant_sharing vs\nJOIN pop_sizes ps ON vs.\"Super_Population\" = ps.\"Super_Population\"\nORDER BY vs.\"Super_Population\", vs.SAMPLES_WITH_VARIANT;") t ~= (sql%([SAMPLE_INFO_schema, PEDIGREE_schema, VARIANTS_schema]) "WITH variant_sample AS (\n  SELECT\n    v.\"reference_name\",\n    v.\"start\",\n    v.\"reference_bases\",\n    v.\"AF\",\n    c.value:\"call_set_name\"::STRING AS sample_name\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n    LATERAL FLATTEN(input => v.\"call\") c\n  WHERE v.\"reference_name\" NOT IN ('X', 'Y', 'MT')\n    AND v.\"AF\" >= 0.05\n    AND (c.value:\"genotype\"[0]::INT > 0 OR c.value:\"genotype\"[1]::INT > 0)\n),\npop_sizes AS (\n  SELECT\n    \"Super_Population\",\n    \"Super_Population_Description\",\n    COUNT(*) AS TOTAL_POPULATION_SIZE\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\"\n  GROUP BY \"Super_Population\", \"Super_Population_Description\"\n),\nvariant_pop_counts AS (\n  SELECT\n    vs.\"reference_name\",\n    vs.\"start\",\n    vs.\"reference_bases\",\n    si.\"Super_Population\",\n    COUNT(DISTINCT vs.sample_name) AS SAMPLES_WITH_VARIANT\n  FROM variant_sample vs\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" si\n    ON vs.sample_name = si.\"Sample\"\n  GROUP BY vs.\"reference_name\", vs.\"start\", vs.\"reference_bases\", si.\"Super_Population\"\n)\nSELECT\n  vpc.\"Super_Population\" AS SUPER_POPULATION,\n  ps.\"Super_Population_Description\" AS SUPER_POPULATION_DESCRIPTION,\n  ps.TOTAL_POPULATION_SIZE,\n  'Yes' AS IS_COMMON_VARIANT,\n  vpc.SAMPLES_WITH_VARIANT,\n  COUNT(*) AS VARIANT_COUNT\nFROM variant_pop_counts vpc\nJOIN pop_sizes ps\n  ON vpc.\"Super_Population\" = ps.\"Super_Population\"\nGROUP BY vpc.\"Super_Population\", ps.\"Super_Population_Description\", ps.TOTAL_POPULATION_SIZE, vpc.SAMPLES_WITH_VARIANT\nORDER BY vpc.\"Super_Population\", vpc.SAMPLES_WITH_VARIANT;") t := by
  intro t; first | sql_equiv | sorry

