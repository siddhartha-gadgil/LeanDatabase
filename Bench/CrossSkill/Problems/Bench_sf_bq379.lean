import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq379 — crossskill equivalence(s)

Question: Which target approved symbol has the overall association score closest to the mean score for psoriasis?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq379

CREATE TABLE TARGETS («id» STRING, «approvedSymbol» STRING, «biotype» STRING, «transcriptIds» STRING, «canonicalTranscript» STRING, «canonicalExons» STRING, «genomicLocation» STRING, «alternativeGenes» STRING, «approvedName» STRING, «go» STRING, «hallmarks» STRING, «synonyms» STRING, «symbolSynonyms» STRING, «nameSynonyms» STRING, «functionDescriptions» STRING, «subcellularLocations» STRING, «targetClass» STRING, «obsoleteSymbols» STRING, «obsoleteNames» STRING, «constraint» STRING, «tep» STRING, «proteinIds» STRING, «dbXrefs» STRING, «chemicalProbes» STRING, «homologues» STRING, «tractability» STRING, «safetyLiabilities» STRING, «pathways» STRING)
CREATE TABLE ASSOCIATIONBYOVERALLDIRECT («diseaseId» STRING, «targetId» STRING, «score» FLOAT, «evidenceCount» INT)
CREATE TABLE DISEASES («id» STRING, «code» STRING, «dbXRefs» STRING, «description» STRING, «name» STRING, «directLocationIds» STRING, «obsoleteTerms» STRING, «parents» STRING, «synonyms» STRING, «ancestors» STRING, «descendants» STRING, «children» STRING, «therapeuticAreas» STRING, «indirectLocationIds» STRING, «ontology» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([TARGETS_schema, ASSOCIATIONBYOVERALLDIRECT_schema, DISEASES_schema]) "WITH psoriasis_scores AS (\n    SELECT a.\"targetId\", a.\"score\"\n    FROM \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"ASSOCIATIONBYOVERALLDIRECT\" a\n    JOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"DISEASES\" d\n      ON a.\"diseaseId\" = d.\"id\"\n    WHERE LOWER(d.\"name\") = 'psoriasis'\n),\nmean_calc AS (\n    SELECT AVG(\"score\") AS mean_score\n    FROM psoriasis_scores\n)\nSELECT t.\"approvedSymbol\" AS \"OUTPUT\"\nFROM psoriasis_scores ps\nCROSS JOIN mean_calc mc\nJOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"TARGETS\" t\n  ON ps.\"targetId\" = t.\"id\"\nORDER BY ABS(ps.\"score\" - mc.mean_score) ASC\nLIMIT 1;") t ~= (sql%([TARGETS_schema, ASSOCIATIONBYOVERALLDIRECT_schema, DISEASES_schema]) "WITH mean_cte AS (\n  SELECT AVG(a.\"score\") AS avg_score\n  FROM \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"ASSOCIATIONBYOVERALLDIRECT\" a\n  JOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"DISEASES\" d ON a.\"diseaseId\" = d.\"id\"\n  WHERE LOWER(d.\"name\") = 'psoriasis'\n)\nSELECT t.\"approvedSymbol\" AS OUTPUT\nFROM \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"ASSOCIATIONBYOVERALLDIRECT\" a\nJOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"TARGETS\" t ON a.\"targetId\" = t.\"id\"\nJOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"DISEASES\" d ON a.\"diseaseId\" = d.\"id\"\nCROSS JOIN mean_cte m\nWHERE LOWER(d.\"name\") = 'psoriasis'\nORDER BY ABS(a.\"score\" - m.avg_score) ASC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([TARGETS_schema, ASSOCIATIONBYOVERALLDIRECT_schema, DISEASES_schema]) "WITH psoriasis_scores AS (\n    SELECT a.\"targetId\", a.\"score\"\n    FROM \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"ASSOCIATIONBYOVERALLDIRECT\" a\n    JOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"DISEASES\" d\n      ON a.\"diseaseId\" = d.\"id\"\n    WHERE LOWER(d.\"name\") = 'psoriasis'\n),\nmean_calc AS (\n    SELECT AVG(\"score\") AS mean_score\n    FROM psoriasis_scores\n)\nSELECT t.\"approvedSymbol\" AS \"OUTPUT\"\nFROM psoriasis_scores ps\nCROSS JOIN mean_calc mc\nJOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"TARGETS\" t\n  ON ps.\"targetId\" = t.\"id\"\nORDER BY ABS(ps.\"score\" - mc.mean_score) ASC\nLIMIT 1;" = sql%([TARGETS_schema, ASSOCIATIONBYOVERALLDIRECT_schema, DISEASES_schema]) "WITH psoriasis_assoc AS (\n    SELECT\n        a.\"targetId\",\n        a.\"score\"\n    FROM \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"ASSOCIATIONBYOVERALLDIRECT\" a\n    WHERE a.\"diseaseId\" = 'EFO_0000676'\n),\nmean_score AS (\n    SELECT AVG(\"score\") AS avg_score\n    FROM psoriasis_assoc\n),\nranked AS (\n    SELECT\n        pa.\"targetId\",\n        pa.\"score\",\n        ABS(pa.\"score\" - ms.avg_score) AS diff\n    FROM psoriasis_assoc pa\n    CROSS JOIN mean_score ms\n    ORDER BY diff ASC\n    LIMIT 1\n)\nSELECT\n    t.\"approvedSymbol\" AS \"OUTPUT\"\nFROM ranked r\nJOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"TARGETS\" t\n    ON t.\"id\" = r.\"targetId\";" := by
  first | sql_equiv | sorry

