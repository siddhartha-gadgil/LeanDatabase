/-!
# sf_bq056 — crossskill equivalence(s)

Question: How many different pairs of roads classified as motorway, trunk, primary, secondary, or residential in California overlap each other without sharing nodes and do not have a bridge tag, where these roads are tagged with 'highway', analyzed through planet ways

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq056

CREATE TABLE PLANET_WAYS («id» INT, «version» INT, «username» STRING, «changeset» INT, «visible» BOOL, «osm_timestamp» INT, «geometry» STRING, «all_tags» STRING, «nodes» STRING)
CREATE TABLE STATES («geo_id» STRING, «region_code» STRING, «division_code» STRING, «state_fips_code» STRING, «state_gnis_code» STRING, «state» STRING, «state_name» STRING, «lsad_code» STRING, «mtfcc_feature_class_code» STRING, «functional_status» STRING, «area_land_meters» INT, «area_water_meters» INT, «int_point_lat» FLOAT, «int_point_lon» FLOAT, «int_point_geom» STRING, «state_geom» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([PLANET_WAYS_schema, STATES_schema]) "WITH bridge_ways AS (SELECT DISTINCT w.\"id\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(t.value, 'key') AS TEXT) = 'bridge'), california_highways AS (SELECT DISTINCT w.\"id\", w.\"geometry\", w.\"nodes\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\" AS s, LATERAL UNNEST(input => w.\"all_tags\") AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE s.\"state_name\" = 'California' AND CAST(JSON_EXTRACT_PATH(t.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(t.value, 'value') AS TEXT) IN ('motorway', 'trunk', 'primary', 'secondary', 'residential') AND ST_INTERSECTS(CAST(w.\"geometry\" AS GEOGRAPHY), CAST(s.\"state_geom\" AS GEOGRAPHY)) AND w.\"id\" <> ALL (SELECT \"id\" FROM bridge_ways)) SELECT COUNT(*) AS NUM_OVERLAPPING_WAYS FROM california_highways AS w1 JOIN california_highways AS w2 ON w1.\"id\" < w2.\"id\" AND ST_INTERSECTS(CAST(w1.\"geometry\" AS GEOGRAPHY), CAST(w2.\"geometry\" AS GEOGRAPHY)) AND NOT w1.\"nodes\" && w2.\"nodes\"") t ~= (sql%([PLANET_WAYS_schema, STATES_schema]) "/* Find distinct pairs of highway ways in California that: */ /* 1. Are tagged as highway (motorway, trunk, primary, secondary, residential) */ /* 2. Geometrically overlap (ST_INTERSECTS) */ /* 3. Do NOT share any nodes (NOT ARRAYS_OVERLAP) */ /* 4. Neither way has a bridge tag */ WITH california_geom AS (SELECT TO_GEOGRAPHY(\"state_geom\", TRUE) AS geom FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\" WHERE \"state_name\" = 'California'), bridge_ways AS (SELECT DISTINCT w.\"id\" AS way_id FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS bt(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(bt.value, 'key') AS TEXT) = 'bridge'), california_highways AS (SELECT DISTINCT w.\"id\" AS way_id, w.\"geometry\", w.\"nodes\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS ht(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(ht.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(ht.value, 'value') AS TEXT) IN ('motorway', 'trunk', 'primary', 'secondary', 'residential') AND NOT w.\"geometry\" IS NULL AND ST_INTERSECTS(TO_GEOGRAPHY(w.\"geometry\", TRUE), (SELECT geom FROM california_geom)) AND w.\"id\" <> ALL (SELECT way_id FROM bridge_ways)) SELECT COUNT(*) AS NUM_OVERLAPPING_WAYS FROM california_highways AS a JOIN california_highways AS b ON a.way_id < b.way_id AND ST_INTERSECTS(TO_GEOGRAPHY(a.\"geometry\", TRUE), TO_GEOGRAPHY(b.\"geometry\", TRUE)) AND NOT a.\"nodes\" && b.\"nodes\"") t := by
