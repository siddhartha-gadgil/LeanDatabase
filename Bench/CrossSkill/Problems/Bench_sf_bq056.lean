/-!
# sf_bq056 — crossskill equivalence(s)

Question: How many different pairs of roads classified as motorway, trunk, primary, secondary, or residential in California overlap each other without sharing nodes and do not have a bridge tag, where these roads are tagged with 'highway', analyzed through planet ways

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq056

CREATE TABLE PLANET_WAYS («id» INT, «version» INT, «username» STRING, «changeset» INT, «visible» BOOL, «osm_timestamp» INT, «geometry» STRING, «all_tags» STRING, «nodes» STRING)
CREATE TABLE STATES («geo_id» STRING, «region_code» STRING, «division_code» STRING, «state_fips_code» STRING, «state_gnis_code» STRING, «state» STRING, «state_name» STRING, «lsad_code» STRING, «mtfcc_feature_class_code» STRING, «functional_status» STRING, «area_land_meters» INT, «area_water_meters» INT, «int_point_lat» FLOAT, «int_point_lon» FLOAT, «int_point_geom» STRING, «state_geom» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([PLANET_WAYS_schema, STATES_schema]) "WITH bridge_ways AS (\n  SELECT DISTINCT w.\"id\"\n  FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" w,\n       LATERAL FLATTEN(input => w.\"all_tags\") t\n  WHERE t.value:\"key\"::STRING = 'bridge'\n),\ncalifornia_highways AS (\n  SELECT DISTINCT w.\"id\", w.\"geometry\", w.\"nodes\"\n  FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" w,\n       \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\" s,\n       LATERAL FLATTEN(input => w.\"all_tags\") t\n  WHERE s.\"state_name\" = 'California'\n    AND t.value:\"key\"::STRING = 'highway'\n    AND t.value:\"value\"::STRING IN ('motorway', 'trunk', 'primary', 'secondary', 'residential')\n    AND ST_INTERSECTS(TO_GEOGRAPHY(w.\"geometry\"), TO_GEOGRAPHY(s.\"state_geom\"))\n    AND w.\"id\" NOT IN (SELECT \"id\" FROM bridge_ways)\n)\nSELECT COUNT(*) AS NUM_OVERLAPPING_WAYS\nFROM california_highways w1\nJOIN california_highways w2\n  ON w1.\"id\" < w2.\"id\"\n  AND ST_INTERSECTS(TO_GEOGRAPHY(w1.\"geometry\"), TO_GEOGRAPHY(w2.\"geometry\"))\n  AND NOT ARRAYS_OVERLAP(w1.\"nodes\", w2.\"nodes\");") t ~= (sql%([PLANET_WAYS_schema, STATES_schema]) "-- Find distinct pairs of highway ways in California that:\n-- 1. Are tagged as highway (motorway, trunk, primary, secondary, residential)\n-- 2. Geometrically overlap (ST_INTERSECTS)\n-- 3. Do NOT share any nodes (NOT ARRAYS_OVERLAP)\n-- 4. Neither way has a bridge tag\n\nWITH california_geom AS (\n    SELECT TO_GEOGRAPHY(\"state_geom\", TRUE) AS geom\n    FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\"\n    WHERE \"state_name\" = 'California'\n),\nbridge_ways AS (\n    SELECT DISTINCT w.\"id\" AS way_id\n    FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" w,\n    LATERAL FLATTEN(input => w.\"all_tags\") bt\n    WHERE bt.value:\"key\"::STRING = 'bridge'\n),\ncalifornia_highways AS (\n    SELECT DISTINCT w.\"id\" AS way_id, w.\"geometry\", w.\"nodes\"\n    FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" w,\n    LATERAL FLATTEN(input => w.\"all_tags\") ht\n    WHERE ht.value:\"key\"::STRING = 'highway'\n    AND ht.value:\"value\"::STRING IN ('motorway', 'trunk', 'primary', 'secondary', 'residential')\n    AND w.\"geometry\" IS NOT NULL\n    AND ST_INTERSECTS(\n        TO_GEOGRAPHY(w.\"geometry\", TRUE),\n        (SELECT geom FROM california_geom)\n    )\n    AND w.\"id\" NOT IN (SELECT way_id FROM bridge_ways)\n)\nSELECT COUNT(*) AS NUM_OVERLAPPING_WAYS\nFROM california_highways a\nJOIN california_highways b\n  ON a.way_id < b.way_id\n  AND ST_INTERSECTS(TO_GEOGRAPHY(a.\"geometry\", TRUE), TO_GEOGRAPHY(b.\"geometry\", TRUE))\n  AND NOT ARRAYS_OVERLAP(a.\"nodes\", b.\"nodes\");") t := by
  intro t; first | sql_equiv | sorry

