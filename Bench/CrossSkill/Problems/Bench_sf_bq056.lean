UNNEST(input => CAST(w.\"all_tags\" AS JSON)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) IN ('motorway', 'trunk', 'primary', 'secondary', 'residential')), bridge_tagged /* Get ways with bridge tag */ AS (SELECT DISTINCT w.\"id\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => CAST(w.\"all_tags\" AS JSON)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'bridge'), highway_ways /* Filter: highway ways without bridge tag, in California */ AS (SELECT w.\"id\", w.\"geometry\" AS geom_bin, w.\"nodes\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w JOIN california AS c ON ST_INTERSECTS(CAST(w.\"geometry\" AS GEOGRAPHY), c.geom) JOIN highway_tagged AS ht ON w.\"id\" = ht.\"id\" LEFT JOIN bridge_tagged AS bt ON w.\"id\" = bt.\"id\" WHERE bt.\"id\" IS NULL), highway_ways_with_node_ids /* Extract node IDs into arrays */ AS (SELECT hw.\"id\", hw.geom_bin, ARRAY_AGG(CAST(JSON_EXTRACT_PATH(n.value, 'id') AS DECIMAL(38, 0))) FILTER(WHERE CAST(JSON_EXTRACT_PATH(n.value, 'id') AS DECIMAL(38, 0)) IS NOT NULL) AS node_ids FROM highway_ways AS hw, LATERAL UNNEST(input => CAST(hw.\"nodes\" AS JSON)) AS n(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY hw.\"id\", hw.geom_bin), overlapping_pairs /* Find overlapping pairs without shared nodes */ AS (SELECT a.\"id\" AS id_a, b.\"id\" AS id_b FROM highway_ways_with_node_ids AS a JOIN highway_ways_with_node_ids AS b ON a.\"id\" < b.\"id\" AND ST_INTERSECTS(CAST(a.geom_bin AS GEOGRAPHY), CAST(b.geom_bin AS GEOGRAPHY)) AND NOT a.node_ids && b.node_ids) SELECT COUNT(*) AS NUM_OVERLAPPING_WAYS FROM overlapping_pairs") t := by
  intro t; first | sql_equiv | sorry

