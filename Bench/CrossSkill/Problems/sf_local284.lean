import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local284 — crossskill equivalence(s)

Question: For veg whsle data, can you generate a summary of our items' loss rates? Include the average loss rate, and also break down the count of items that are below, above, and within one standard deviation from this average.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local284

CREATE TABLE VEG_LOSS_RATE_DF («index» INT, «item_code» INT, «item_name» STRING)

theorem eq_0_1 :
    sql%([VEG_LOSS_RATE_DF_schema]) "WITH stats AS (SELECT AVG(\"loss_rate_%\") AS avg_lr, STDDEV(\"loss_rate_%\") AS std_lr FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"VEG_LOSS_RATE_DF\") SELECT s.avg_lr AS \"avg_loss_rate_%\", COUNT(CASE WHEN v.\"loss_rate_%\" >= s.avg_lr - s.std_lr AND v.\"loss_rate_%\" <= s.avg_lr + s.std_lr THEN 1 END) AS \"items_within_stdev\", COUNT(CASE WHEN v.\"loss_rate_%\" > s.avg_lr + s.std_lr THEN 1 END) AS \"above_stdev\", COUNT(CASE WHEN v.\"loss_rate_%\" < s.avg_lr - s.std_lr THEN 1 END) AS \"items_below_stdev\" FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"VEG_LOSS_RATE_DF\" AS v CROSS JOIN stats AS s GROUP BY s.avg_lr" = sql%([VEG_LOSS_RATE_DF_schema]) "WITH stats AS (SELECT AVG(\"loss_rate_%\") AS avg_lr, STDDEV(\"loss_rate_%\") AS std_lr FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"VEG_LOSS_RATE_DF\") SELECT avg_lr AS \"avg_loss_rate_%\", SUM(CASE WHEN \"loss_rate_%\" >= avg_lr - std_lr AND \"loss_rate_%\" <= avg_lr + std_lr THEN 1 ELSE 0 END) AS \"items_within_stdev\", SUM(CASE WHEN \"loss_rate_%\" > avg_lr + std_lr THEN 1 ELSE 0 END) AS \"above_stdev\", SUM(CASE WHEN \"loss_rate_%\" < avg_lr - std_lr THEN 1 ELSE 0 END) AS \"items_below_stdev\" FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"VEG_LOSS_RATE_DF\", stats GROUP BY avg_lr" := by
  first | sql_equiv | sorry

