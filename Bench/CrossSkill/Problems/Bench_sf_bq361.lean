/-!
# sf_bq361 — crossskill equivalence(s)

Question: For the user cohort with a first purchase date in January 2020, what proportion of users returned in the subsequent months of 2020?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq361

CREATE TABLE ORDERS («order_id» INT, «user_id» INT, «status» STRING, «gender» STRING, «created_at» INT, «returned_at» INT, «shipped_at» INT, «delivered_at» INT, «num_of_item» INT)

HYPOTHESIS hyp0_1_0 : ORDERS "YEAR(TO_TIMESTAMP(\"created_at\" / 1000000)) = 2020"
theorem eq_0_1 (t : TableRel ORDERS_schema) (h0 : hyp0_1_0 t) :
    (sql%([ORDERS_schema]) "WITH orders_with_dates AS (\n  SELECT\n    \"user_id\",\n    TO_TIMESTAMP(\"created_at\" / 1000000) AS order_ts\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDERS\"\n),\nfirst_purchase AS (\n  SELECT\n    \"user_id\",\n    MIN(order_ts) AS first_order_ts\n  FROM orders_with_dates\n  GROUP BY \"user_id\"\n  HAVING DATE_TRUNC('MONTH', MIN(order_ts)) = '2020-01-01'\n),\ncohort_size AS (\n  SELECT COUNT(*) AS total_users\n  FROM first_purchase\n),\nreturning_users AS (\n  SELECT\n    DATEDIFF('MONTH', DATE_TRUNC('MONTH', fp.first_order_ts), DATE_TRUNC('MONTH', o.order_ts)) AS month_since_first_order,\n    COUNT(DISTINCT o.\"user_id\") AS new_user\n  FROM orders_with_dates o\n  JOIN first_purchase fp ON o.\"user_id\" = fp.\"user_id\"\n  WHERE DATE_TRUNC('MONTH', o.order_ts) > DATE_TRUNC('MONTH', fp.first_order_ts)\n    AND o.order_ts < '2021-01-01'\n  GROUP BY month_since_first_order\n)\nSELECT\n  DATE('2020-01-01') AS COHORT,\n  r.month_since_first_order AS MONTH_SINCE_FIRST_ORDER,\n  r.new_user AS NEW_USER,\n  cs.total_users AS COHORT_USER,\n  ROUND(r.new_user / cs.total_users::FLOAT, 6) AS COHORT_USERS_PERCENTAGE\nFROM returning_users r\nCROSS JOIN cohort_size cs\nORDER BY r.month_since_first_order;") t ~= (sql%([ORDERS_schema]) "WITH first_purchase AS (\n  SELECT \"user_id\", \n    MIN(TO_TIMESTAMP(\"created_at\" / 1000000)) AS first_purchase_date\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDERS\"\n  GROUP BY \"user_id\"\n),\njan_cohort AS (\n  SELECT \"user_id\"\n  FROM first_purchase\n  WHERE DATE_TRUNC('MONTH', first_purchase_date) = '2020-01-01'\n),\ncohort_size AS (\n  SELECT COUNT(*) AS total FROM jan_cohort\n),\nmonthly_returns AS (\n  SELECT \n    DATEDIFF('MONTH', '2020-01-01', DATE_TRUNC('MONTH', TO_TIMESTAMP(o.\"created_at\" / 1000000))) AS months_since,\n    COUNT(DISTINCT o.\"user_id\") AS new_user\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDERS\" o\n  JOIN jan_cohort c ON o.\"user_id\" = c.\"user_id\"\n  WHERE DATE_TRUNC('MONTH', TO_TIMESTAMP(o.\"created_at\" / 1000000)) > '2020-01-01'\n    AND YEAR(TO_TIMESTAMP(o.\"created_at\" / 1000000)) = 2020\n  GROUP BY months_since\n)\nSELECT \n  '2020-01-01' AS COHORT,\n  mr.months_since AS MONTH_SINCE_FIRST_ORDER,\n  mr.new_user AS NEW_USER,\n  cs.total AS COHORT_USER,\n  ROUND(mr.new_user * 1.0 / cs.total, 6) AS COHORT_USERS_PERCENTAGE\nFROM monthly_returns mr\nCROSS JOIN cohort_size cs\nORDER BY mr.months_since;") t := by
  first | sql_equiv | sorry

