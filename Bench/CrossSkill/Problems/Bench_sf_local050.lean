import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local050 — crossskill equivalence(s)

Question: What is the median of the average monthly projected sales in USD for France in 2021, calculated by using the monthly sales data from 2019 and 2020 (filtered by promo_total_id=1 and channel_total_id=1), applying the growth rate from 2019 to 2020 to project 2021, converting to USD based on the currency table, and then determining the monthly averages before finding their median?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local050

CREATE TABLE COUNTRIES («country_id» INT, «country_iso_code» STRING, «country_name» STRING, «country_subregion» STRING, «country_subregion_id» INT, «country_region» STRING, «country_region_id» INT, «country_total» STRING, «country_total_id» INT)
CREATE TABLE CURRENCY («country» STRING, «year» INT, «month» INT, «to_us» FLOAT)
CREATE TABLE CUSTOMERS («cust_id» INT, «cust_first_name» STRING, «cust_last_name» STRING, «cust_gender» STRING, «cust_year_of_birth» INT, «cust_marital_status» STRING, «cust_street_address» STRING, «cust_postal_code» STRING, «cust_city» STRING, «cust_city_id» INT, «cust_state_province» STRING, «cust_state_province_id» INT, «country_id» INT, «cust_main_phone_number» STRING, «cust_income_level» STRING, «cust_credit_limit» FLOAT, «cust_email» STRING, «cust_total» STRING, «cust_total_id» INT, «cust_src_id» STRING, «cust_eff_from» STRING, «cust_eff_to» STRING, «cust_valid» STRING)
CREATE TABLE PRODUCTS («prod_id» INT, «prod_name» STRING, «prod_desc» STRING, «prod_subcategory» STRING, «prod_subcategory_id» INT, «prod_subcategory_desc» STRING, «prod_category» STRING, «prod_category_id» INT, «prod_category_desc» STRING, «prod_weight_class» INT, «prod_unit_of_measure» STRING, «prod_pack_size» STRING, «supplier_id» INT, «prod_status» STRING, «prod_list_price» FLOAT, «prod_min_price» FLOAT, «prod_total» STRING, «prod_total_id» INT, «prod_src_id» STRING, «prod_eff_from» STRING, «prod_eff_to» STRING, «prod_valid» STRING)
CREATE TABLE TIMES («time_id» STRING, «day_name» STRING, «day_number_in_week» INT, «day_number_in_month» INT, «calendar_week_number» INT, «fiscal_week_number» INT, «week_ending_day» STRING, «week_ending_day_id» INT, «calendar_month_number» INT, «fiscal_month_number» INT, «calendar_month_desc» STRING, «calendar_month_id» INT, «fiscal_month_desc» STRING, «fiscal_month_id» INT, «days_in_cal_month» INT, «days_in_fis_month» INT, «end_of_cal_month» STRING, «end_of_fis_month» STRING, «calendar_month_name» STRING, «fiscal_month_name» STRING, «calendar_quarter_desc» STRING, «calendar_quarter_id» INT, «fiscal_quarter_desc» STRING, «fiscal_quarter_id» INT, «days_in_cal_quarter» INT, «days_in_fis_quarter» INT, «end_of_cal_quarter» STRING, «end_of_fis_quarter» STRING, «calendar_quarter_number» INT, «fiscal_quarter_number» INT, «calendar_year» INT, «calendar_year_id» INT, «fiscal_year» INT, «fiscal_year_id» INT, «days_in_cal_year» INT, «days_in_fis_year» INT, «end_of_cal_year» STRING, «end_of_fis_year» STRING)
CREATE TABLE CHANNELS («channel_id» INT, «channel_desc» STRING, «channel_class» STRING, «channel_class_id» INT, «channel_total» STRING, «channel_total_id» INT)
CREATE TABLE PROMOTIONS («promo_id» INT, «promo_name» STRING, «promo_subcategory» STRING, «promo_subcategory_id» INT, «promo_category» STRING, «promo_category_id» INT, «promo_cost» FLOAT, «promo_begin_date» STRING, «promo_end_date» STRING, «promo_total» STRING, «promo_total_id» INT)
CREATE TABLE SALES («prod_id» INT, «cust_id» INT, «time_id» STRING, «channel_id» INT, «promo_id» INT, «quantity_sold» INT, «amount_sold» FLOAT)

theorem eq_0_1 : ∀ t,
    (sql%([COUNTRIES_schema, CURRENCY_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, CHANNELS_schema, PROMOTIONS_schema, SALES_schema]) "WITH monthly_product_sales AS (\n    -- Step 1: Sum sales amounts for each product, month, and year\n    SELECT \n        t.\"calendar_year\" AS yr,\n        t.\"calendar_month_number\" AS month_num,\n        s.\"prod_id\",\n        SUM(s.\"amount_sold\") AS total_sales\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t \n        ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu \n        ON s.\"cust_id\" = cu.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co \n        ON cu.\"country_id\" = co.\"country_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" p \n        ON s.\"promo_id\" = p.\"promo_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" ch \n        ON s.\"channel_id\" = ch.\"channel_id\"\n    WHERE co.\"country_name\" = 'France'\n      AND t.\"calendar_year\" IN (2019, 2020)\n      AND p.\"promo_total_id\" = 1\n      AND ch.\"channel_total_id\" = 1\n    GROUP BY t.\"calendar_year\", t.\"calendar_month_number\", s.\"prod_id\"\n),\npivoted AS (\n    -- Step 2: Pivot to get 2019 and 2020 values for each product-month\n    -- Only include products with BOTH years of data and non-zero 2019 sales\n    SELECT \n        month_num,\n        \"prod_id\",\n        MAX(CASE WHEN yr = 2019 THEN total_sales END) AS sales_2019,\n        MAX(CASE WHEN yr = 2020 THEN total_sales END) AS sales_2020\n    FROM monthly_product_sales\n    GROUP BY month_num, \"prod_id\"\n    HAVING MAX(CASE WHEN yr = 2019 THEN total_sales END) IS NOT NULL\n       AND MAX(CASE WHEN yr = 2020 THEN total_sales END) IS NOT NULL\n       AND MAX(CASE WHEN yr = 2019 THEN total_sales END) > 0\n),\nprojected AS (\n    -- Step 3: Apply growth rate to project 2021\n    -- Projected Sales 2021 = Monthly Sales 2020 * (1 + Growth Rate)\n    -- Growth Rate = (Monthly Sales 2020 - Monthly Sales 2019) / Monthly Sales 2019\n    SELECT \n        month_num,\n        \"prod_id\",\n        sales_2020 * (1 + (sales_2020 - sales_2019) / sales_2019) AS projected_2021\n    FROM pivoted\n),\nprojected_usd AS (\n    -- Step 4: Convert to USD using currency table\n    SELECT \n        p.month_num,\n        p.\"prod_id\",\n        p.projected_2021 * c.\"to_us\" AS projected_2021_usd\n    FROM projected p\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\" c \n        ON c.\"country\" = 'France' \n        AND c.\"year\" = 2021 \n        AND c.\"month\" = p.month_num\n),\nmonthly_avg AS (\n    -- Step 5: Compute average projected sales for each month across products\n    SELECT \n        month_num,\n        AVG(projected_2021_usd) AS avg_projected_sales\n    FROM projected_usd\n    GROUP BY month_num\n)\n-- Step 6: Find the median of the 12 monthly average projected sales\nSELECT MEDIAN(avg_projected_sales) AS median_avg_monthly_projected_sales_usd\nFROM monthly_avg;") t ~= (sql%([COUNTRIES_schema, CURRENCY_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, CHANNELS_schema, PROMOTIONS_schema, SALES_schema]) "WITH sales_by_prod_month_year AS (\n    -- Step 1: Aggregate sales per product, month, year for France with filters\n    SELECT \n        s.\"prod_id\",\n        t.\"calendar_month_number\" AS month_num,\n        t.\"calendar_year\" AS year_val,\n        SUM(s.\"amount_sold\") AS total_sales\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t \n        ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu \n        ON s.\"cust_id\" = cu.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co \n        ON cu.\"country_id\" = co.\"country_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" p \n        ON s.\"promo_id\" = p.\"promo_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" ch \n        ON s.\"channel_id\" = ch.\"channel_id\"\n    WHERE co.\"country_name\" = 'France'\n      AND p.\"promo_total_id\" = 1\n      AND ch.\"channel_total_id\" = 1\n      AND t.\"calendar_year\" IN (2019, 2020)\n    GROUP BY s.\"prod_id\", t.\"calendar_month_number\", t.\"calendar_year\"\n),\n-- Step 2: Pivot to get 2019 and 2020 sales side by side\npivot_sales AS (\n    SELECT \n        \"prod_id\",\n        month_num,\n        SUM(CASE WHEN year_val = 2019 THEN total_sales ELSE 0 END) AS sales_2019,\n        SUM(CASE WHEN year_val = 2020 THEN total_sales ELSE 0 END) AS sales_2020\n    FROM sales_by_prod_month_year\n    GROUP BY \"prod_id\", month_num\n),\n-- Step 3: Project 2021 sales using growth rate formula\nprojected AS (\n    SELECT \n        \"prod_id\",\n        month_num,\n        sales_2019,\n        sales_2020,\n        CASE \n            WHEN sales_2019 > 0 THEN \n                (((sales_2020 - sales_2019) / sales_2019) * sales_2020) + sales_2020\n            ELSE sales_2020\n        END AS projected_2021\n    FROM pivot_sales\n    WHERE sales_2019 > 0 AND sales_2020 > 0\n),\n-- Step 4: Convert to USD using currency table\nprojected_usd AS (\n    SELECT \n        p.\"prod_id\",\n        p.month_num,\n        p.projected_2021 * COALESCE(c.\"to_us\", 1) AS projected_2021_usd\n    FROM projected p\n    LEFT JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\" c\n        ON c.\"country\" = 'France'\n        AND c.\"year\" = 2021\n        AND c.\"month\" = p.month_num\n),\n-- Step 5: Calculate monthly averages across products\nmonthly_avg AS (\n    SELECT \n        month_num,\n        ROUND(AVG(projected_2021_usd), 2) AS avg_projected_sales\n    FROM projected_usd\n    GROUP BY month_num\n)\n-- Step 6: Find the median of the monthly averages\nSELECT \n    MEDIAN(avg_projected_sales) AS \"OUTPUT\"\nFROM monthly_avg;") t := by
  intro t; first | sql_equiv | sorry

end Bench_sf_local050
