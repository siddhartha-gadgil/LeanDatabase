/-!
# sf_local050 — crossskill equivalence(s)

Question: What is the median of the average monthly projected sales in USD for France in 2021, calculated by using the monthly sales data from 2019 and 2020 (filtered by promo_total_id=1 and channel_total_id=1), applying the growth rate from 2019 to 2020 to project 2021, converting to USD based on the currency table, and then determining the monthly averages before finding their median?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local050

CREATE TABLE COUNTRIES («country_id» INT, «country_iso_code» STRING, «country_name» STRING, «country_subregion» STRING, «country_subregion_id» INT, «country_region» STRING, «country_region_id» INT, «country_total» STRING, «country_total_id» INT)
CREATE TABLE CURRENCY («country» STRING, «year» INT, «month» INT, «to_us» FLOAT)
CREATE TABLE CUSTOMERS («cust_id» INT, «cust_first_name» STRING, «cust_last_name» STRING, «cust_gender» STRING, «cust_year_of_birth» INT, «cust_marital_status» STRING, «cust_street_address» STRING, «cust_postal_code» STRING, «cust_city» STRING, «cust_city_id» INT, «cust_state_province» STRING, «cust_state_province_id» INT, «country_id» INT, «cust_main_phone_number» STRING, «cust_income_level» STRING, «cust_credit_limit» FLOAT, «cust_email» STRING, «cust_total» STRING, «cust_total_id» INT, «cust_src_id» STRING, «cust_eff_from» STRING, «cust_eff_to» STRING, «cust_valid» STRING)
CREATE TABLE PRODUCTS («prod_id» INT, «prod_name» STRING, «prod_desc» STRING, «prod_subcategory» STRING, «prod_subcategory_id» INT, «prod_subcategory_desc» STRING, «prod_category» STRING, «prod_category_id» INT, «prod_category_desc» STRING, «prod_weight_class» INT, «prod_unit_of_measure» STRING, «prod_pack_size» STRING, «supplier_id» INT, «prod_status» STRING, «prod_list_price» FLOAT, «prod_min_price» FLOAT, «prod_total» STRING, «prod_total_id» INT, «prod_src_id» STRING, «prod_eff_from» STRING, «prod_eff_to» STRING, «prod_valid» STRING)
CREATE TABLE TIMES («time_id» STRING, «day_name» STRING, «day_number_in_week» INT, «day_number_in_month» INT, «calendar_week_number» INT, «fiscal_week_number» INT, «week_ending_day» STRING, «week_ending_day_id» INT, «calendar_month_number» INT, «fiscal_month_number» INT, «calendar_month_desc» STRING, «calendar_month_id» INT, «fiscal_month_desc» STRING, «fiscal_month_id» INT, «days_in_cal_month» INT, «days_in_fis_month» INT, «end_of_cal_month» STRING, «end_of_fis_month» STRING, «calendar_month_name» STRING, «fiscal_month_name» STRING, «calendar_quarter_desc» STRING, «calendar_quarter_id» INT, «fiscal_quarter_desc» STRING, «fiscal_quarter_id» INT, «days_in_cal_quarter» INT, «days_in_fis_quarter» INT, «end_of_cal_quarter» STRING, «end_of_fis_quarter» STRING, «calendar_quarter_number» INT, «fiscal_quarter_number» INT, «calendar_year» INT, «calendar_year_id» INT, «fiscal_year» INT, «fiscal_year_id» INT, «days_in_cal_year» INT, «days_in_fis_year» INT, «end_of_cal_year» STRING, «end_of_fis_year» STRING)
CREATE TABLE CHANNELS («channel_id» INT, «channel_desc» STRING, «channel_class» STRING, «channel_class_id» INT, «channel_total» STRING, «channel_total_id» INT)
CREATE TABLE PROMOTIONS («promo_id» INT, «promo_name» STRING, «promo_subcategory» STRING, «promo_subcategory_id» INT, «promo_category» STRING, «promo_category_id» INT, «promo_cost» FLOAT, «promo_begin_date» STRING, «promo_end_date» STRING, «promo_total» STRING, «promo_total_id» INT)
CREATE TABLE SALES («prod_id» INT, «cust_id» INT, «time_id» STRING, «channel_id» INT, «promo_id» INT, «quantity_sold» INT, «amount_sold» FLOAT)

theorem eq_0_1 : ∀ t,
    (sql%([COUNTRIES_schema, CURRENCY_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, CHANNELS_schema, PROMOTIONS_schema, SALES_schema]) "WITH monthly_product_sales AS (/* Step 1: Sum sales amounts for each product, month, and year */ SELECT t.\"calendar_year\" AS yr, t.\"calendar_month_number\" AS month_num, s.\"prod_id\", SUM(s.\"amount_sold\") AS total_sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS cu ON s.\"cust_id\" = cu.\"cust_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" AS co ON cu.\"country_id\" = co.\"country_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" AS p ON s.\"promo_id\" = p.\"promo_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" AS ch ON s.\"channel_id\" = ch.\"channel_id\" WHERE co.\"country_name\" = 'France' AND t.\"calendar_year\" IN (2019, 2020) AND p.\"promo_total_id\" = 1 AND ch.\"channel_total_id\" = 1 GROUP BY t.\"calendar_year\", t.\"calendar_month_number\", s.\"prod_id\"), pivoted AS (/* Step 2: Pivot to get 2019 and 2020 values for each product-month */ /* Only include products with BOTH years of data and non-zero 2019 sales */ SELECT month_num, \"prod_id\", MAX(CASE WHEN yr = 2019 THEN total_sales END) AS sales_2019, MAX(CASE WHEN yr = 2020 THEN total_sales END) AS sales_2020 FROM monthly_product_sales GROUP BY month_num, \"prod_id\" HAVING NOT MAX(CASE WHEN yr = 2019 THEN total_sales END) IS NULL AND NOT MAX(CASE WHEN yr = 2020 THEN total_sales END) IS NULL AND MAX(CASE WHEN yr = 2019 THEN total_sales END) > 0), projected AS (/* Step 3: Apply growth rate to project 2021 */ /* Projected Sales 2021 = Monthly Sales 2020 * (1 + Growth Rate) */ /* Growth Rate = (Monthly Sales 2020 - Monthly Sales 2019) / Monthly Sales 2019 */ SELECT month_num, \"prod_id\", sales_2020 * (1 + CAST((sales_2020 - sales_2019) AS DOUBLE PRECISION) / sales_2019) AS projected_2021 FROM pivoted), projected_usd AS (/* Step 4: Convert to USD using currency table */ SELECT p.month_num, p.\"prod_id\", p.projected_2021 * c.\"to_us\" AS projected_2021_usd FROM projected AS p JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\" AS c ON c.\"country\" = 'France' AND c.\"year\" = 2021 AND c.\"month\" = p.month_num), monthly_avg AS (/* Step 5: Compute average projected sales for each month across products */ SELECT month_num, AVG(projected_2021_usd) AS avg_projected_sales FROM projected_usd GROUP BY month_num) /* Step 6: Find the median of the 12 monthly average projected sales */ SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY avg_projected_sales) AS median_avg_monthly_projected_sales_usd FROM monthly_avg") t ~= (sql%([COUNTRIES_schema, CURRENCY_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, CHANNELS_schema, PROMOTIONS_schema, SALES_schema]) "WITH sales_by_prod_month_year AS (/* Step 1: Aggregate sales per product, month, year for France with filters */ SELECT s.\"prod_id\", t.\"calendar_month_number\" AS month_num, t.\"calendar_year\" AS year_val, SUM(s.\"amount_sold\") AS total_sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS cu ON s.\"cust_id\" = cu.\"cust_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" AS co ON cu.\"country_id\" = co.\"country_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" AS p ON s.\"promo_id\" = p.\"promo_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" AS ch ON s.\"channel_id\" = ch.\"channel_id\" WHERE co.\"country_name\" = 'France' AND p.\"promo_total_id\" = 1 AND ch.\"channel_total_id\" = 1 AND t.\"calendar_year\" IN (2019, 2020) GROUP BY s.\"prod_id\", t.\"calendar_month_number\", t.\"calendar_year\"), pivot_sales /* Step 2: Pivot to get 2019 and 2020 sales side by side */ AS (SELECT \"prod_id\", month_num, SUM(CASE WHEN year_val = 2019 THEN total_sales ELSE 0 END) AS sales_2019, SUM(CASE WHEN year_val = 2020 THEN total_sales ELSE 0 END) AS sales_2020 FROM sales_by_prod_month_year GROUP BY \"prod_id\", month_num), projected /* Step 3: Project 2021 sales using growth rate formula */ AS (SELECT \"prod_id\", month_num, sales_2019, sales_2020, CASE WHEN sales_2019 > 0 THEN ((CAST((sales_2020 - sales_2019) AS DOUBLE PRECISION) / sales_2019) * sales_2020) + sales_2020 ELSE sales_2020 END AS projected_2021 FROM pivot_sales WHERE sales_2019 > 0 AND sales_2020 > 0), projected_usd /* Step 4: Convert to USD using currency table */ AS (SELECT p.\"prod_id\", p.month_num, p.projected_2021 * COALESCE(c.\"to_us\", 1) AS projected_2021_usd FROM projected AS p LEFT JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\" AS c ON c.\"country\" = 'France' AND c.\"year\" = 2021 AND c.\"month\" = p.month_num), monthly_avg /* Step 5: Calculate monthly averages across products */ AS (SELECT month_num, ROUND(CAST(AVG(projected_2021_usd) AS DECIMAL), 2) AS avg_projected_sales FROM projected_usd GROUP BY month_num) /* Step 6: Find the median of the monthly averages */ SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY avg_projected_sales) AS \"OUTPUT\" FROM monthly_avg") t := by
