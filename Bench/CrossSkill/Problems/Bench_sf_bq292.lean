ransactions since July 2023\n-- CoinJoin: >2 outputs, output_value <= input_value, multiple identical-value outputs\n-- Metrics: tx_percent, utxos_percent, value_percent per month\n\nWITH dup_outputs AS (\n    SELECT t.\"hash\"\n    FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" t,\n    LATERAL FLATTEN(input => t.\"outputs\") f\n    WHERE t.\"block_timestamp_month\" >= '2023-07-01'\n      AND t.\"output_count\" > 2\n      AND t.\"output_value\" <= t.\"input_value\"\n    GROUP BY t.\"hash\", f.value:value::NUMBER\n    HAVING COUNT(*) > 1\n),\ncoinjoin_hashes AS (\n    SELECT DISTINCT \"hash\" FROM dup_outputs\n),\nmonthly_totals AS (\n    SELECT \"block_timestamp_month\",\n           COUNT(*) as total_txns,\n           SUM(\"input_count\") as total_inputs,\n           SUM(\"output_count\") as total_outputs,\n           SUM(\"input_value\") as total_input_value\n    FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\"\n    WHERE \"block_timestamp_month\" >= '2023-07-01'\n    GROUP BY \"block_timestamp_month\"\n),\nmonthly_coinjoin AS (\n    SELECT t.\"block_timestamp_month\",\n           COUNT(*) as cj_txns,\n           SUM(t.\"input_count\") as cj_inputs,\n           SUM(t.\"output_count\") as cj_outputs,\n           SUM(t.\"input_value\") as cj_input_value\n    FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" t\n    INNER JOIN coinjoin_hashes c ON t.\"hash\" = c.\"hash\"\n    GROUP BY t.\"block_timestamp_month\"\n)\nSELECT\n    ROUND(mc.cj_txns * 100.0 / mt.total_txns, 4) AS \"tx_percent\",\n    ROUND(((mc.cj_inputs * 100.0 / mt.total_inputs) + (mc.cj_outputs * 100.0 / mt.total_outputs)) / 2.0, 2) AS \"utxos_percent\",\n    ROUND(mc.cj_input_value * 100.0 / mt.total_input_value, 4) AS \"value_percent\"\nFROM monthly_coinjoin mc\nJOIN monthly_totals mt ON mc.\"block_timestamp_month\" = mt.\"block_timestamp_month\"\nORDER BY mc.\"block_timestamp_month\" DESC;") t := by
