S_schema, OUTPUTS_schema]) "WITH coinjoin_txs AS (\n  -- Identify CoinJoin transactions: >2 outputs, output_value <= input_value,\n  -- and at least two outputs with the same value (excluding 0)\n  SELECT DISTINCT t.\"hash\"\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" t,\n    LATERAL FLATTEN(input => t.\"outputs\") o\n  WHERE t.\"output_count\" > 2\n    AND t.\"is_coinbase\" = FALSE\n    AND t.\"output_value\" <= t.\"input_value\"\n    AND t.\"block_timestamp_month\" >= '2023-07-01'\n    AND o.value:value::NUMBER > 0\n  GROUP BY t.\"hash\", o.value:value::NUMBER\n  HAVING COUNT(*) > 1\n),\n\nall_txs AS (\n  SELECT\n    t.\"block_timestamp_month\",\n    t.\"hash\",\n    t.\"input_count\",\n    t.\"output_count\",\n    t.\"input_value\",\n    CASE WHEN cj.\"hash\" IS NOT NULL THEN 1 ELSE 0 END AS is_coinjoin\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" t\n  LEFT JOIN coinjoin_txs cj ON t.\"hash\" = cj.\"hash\"\n  WHERE t.\"block_timestamp_month\" >= '2023-07-01'\n)\n\nSELECT\n  100.0 * SUM(is_coinjoin) / COUNT(*) AS tx_percent,\n  100.0 * (\n    (SUM(CASE WHEN is_coinjoin = 1 THEN \"input_count\" ELSE 0 END) * 1.0 / SUM(\"input_count\"))\n    + (SUM(CASE WHEN is_coinjoin = 1 THEN \"output_count\" ELSE 0 END) * 1.0 / SUM(\"output_count\"))\n  ) / 2.0 AS utxos_percent,\n  100.0 * SUM(CASE WHEN is_coinjoin = 1 THEN \"input_value\" ELSE 0 END) / SUM(\"input_value\") AS value_percent\nFROM all_txs\nGROUP BY \"block_timestamp_month\"\nORDER BY \"block_timestamp_month\" DESC;" := by
