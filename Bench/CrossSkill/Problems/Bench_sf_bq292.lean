/-!
# sf_bq292 — crossskill equivalence(s)

Question: Analyze Bitcoin transactions since July 2023 to determine monthly percentages of: (1)Transactions classified as CoinJoins (defined by >2 outputs, output value ≤ input value, and multiple identical-value outputs), (2) UTXOs involved in CoinJoins (calculated as the average of CoinJoin input/output ratios against total network UTXOs), (3) Transaction volume (based on input value) attributed to CoinJoins. Provide results in a table with monthly metrics for transactions, UTXOs, and volume.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq292

CREATE TABLE TRANSACTIONS («block_height» INT, «block_timestamp» STRING, «block_timestamp_truncated» INT, «txhash» STRING, «transaction_type» STRING, «gas_wanted» INT, «gas_used» INT, «sender» STRING, «fee» STRING, «memo» STRING)
CREATE TABLE OUTPUTS («transaction_hash» STRING, «block_hash» STRING, «block_number» INT, «block_timestamp» INT, «index» INT, «script_asm» STRING, «script_hex» STRING, «required_signatures» INT, «type» STRING, «addresses» STRING, «value» INT)

theorem eq_0_1 : ∀ t,
    (sql%([TRANSACTIONS_schema, OUTPUTS_schema]) "WITH coinjoin_txns AS (\n  SELECT DISTINCT\n    t.\"hash\",\n    t.\"block_timestamp_month\",\n    t.\"input_count\",\n    t.\"output_count\",\n    t.\"input_value\",\n    t.\"output_value\"\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" t,\n    LATERAL FLATTEN(input => t.\"outputs\") f\n  WHERE t.\"block_timestamp_month\" >= '2023-07-01'\n    AND t.\"is_coinbase\" = FALSE\n    AND t.\"output_count\" > 2\n    AND t.\"output_value\" <= t.\"input_value\"\n    AND f.value:value::NUMBER > 0\n  GROUP BY t.\"hash\", t.\"block_timestamp_month\", t.\"input_count\", t.\"output_count\", t.\"input_value\", t.\"output_value\", f.value:value::NUMBER\n  HAVING COUNT(*) >= 2\n),\n\nmonthly_coinjoin AS (\n  SELECT\n    \"block_timestamp_month\",\n    COUNT(DISTINCT \"hash\") AS coinjoin_tx_count,\n    SUM(\"input_count\") AS coinjoin_input_count,\n    SUM(\"output_count\") AS coinjoin_output_count,\n    SUM(\"input_value\") AS coinjoin_input_value\n  FROM coinjoin_txns\n  GROUP BY \"block_timestamp_month\"\n),\n\nmonthly_totals AS (\n  SELECT\n    \"block_timestamp_month\",\n    COUNT(*) AS total_tx_count,\n    SUM(\"input_count\") AS total_input_count,\n    SUM(\"output_count\") AS total_output_count,\n    SUM(\"input_value\") AS total_input_value\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\"\n  WHERE \"block_timestamp_month\" >= '2023-07-01'\n  GROUP BY \"block_timestamp_month\"\n)\n\nSELECT\n  c.coinjoin_tx_count * 100.0 / t.total_tx_count AS \"tx_percent\",\n  (c.coinjoin_input_count * 1.0 / t.total_input_count + c.coinjoin_output_count * 1.0 / t.total_output_count) / 2 * 100 AS \"utxos_percent\",\n  c.coinjoin_input_value * 100.0 / t.total_input_value AS \"value_percent\"\nFROM monthly_coinjoin c\nJOIN monthly_totals t\n  ON c.\"block_timestamp_month\" = t.\"block_timestamp_month\"\nORDER BY c.\"block_timestamp_month\" DESC;") t ~= (sql%([TRANSACTIONS_schema, OUTPUTS_schema]) "WITH coinjoin_tx AS (\n  SELECT t.\"hash\", t.\"block_timestamp_month\"\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" t,\n  LATERAL FLATTEN(input => t.\"outputs\") f\n  WHERE t.\"block_timestamp_month\" >= '2023-07-01'\n  AND t.\"output_count\" > 2\n  AND t.\"output_value\" <= t.\"input_value\"\n  GROUP BY t.\"hash\", t.\"block_timestamp_month\"\n  HAVING COUNT(*) > COUNT(DISTINCT f.value:value::NUMBER)\n)\nSELECT \n  100.0 * COUNT(CASE WHEN cj.\"hash\" IS NOT NULL THEN 1 END) / COUNT(*) AS tx_percent,\n  100.0 * (\n    SUM(CASE WHEN cj.\"hash\" IS NOT NULL THEN t.\"input_count\" ELSE 0 END) * 1.0 / SUM(t.\"input_count\")\n    + SUM(CASE WHEN cj.\"hash\" IS NOT NULL THEN t.\"output_count\" ELSE 0 END) * 1.0 / SUM(t.\"output_count\")\n  ) / 2 AS utxos_percent,\n  100.0 * SUM(CASE WHEN cj.\"hash\" IS NOT NULL THEN t.\"input_value\" ELSE 0 END) / SUM(t.\"input_value\") AS value_percent\nFROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" t\nLEFT JOIN coinjoin_tx cj ON t.\"hash\" = cj.\"hash\"\nWHERE t.\"block_timestamp_month\" >= '2023-07-01'\nGROUP BY t.\"block_timestamp_month\"\nORDER BY t.\"block_timestamp_month\" DESC;") t := by
  intro t; first | sql_equiv | sorry

