    (sql%([ALIEN_DATA_schema]) "WITH top_states AS (SELECT \"state\", COUNT(*) AS total_pop FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"ALIEN_DATA\" GROUP BY \"state\" ORDER BY total_pop DESC LIMIT 10), state_stats AS (SELECT ts.\"state\", ts.total_pop, SUM(CASE WHEN ad.\"aggressive\" = 0 THEN 1 ELSE 0 END) AS friendly_count, SUM(CASE WHEN ad.\"aggressive\" = 1 THEN 1 ELSE 0 END) AS hostile_count, AVG(ad.\"age\") AS avg_age FROM top_states AS ts JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"ALIEN_DATA\" AS ad ON ts.\"state\" = ad.\"state\" GROUP BY ts.\"state\", ts.total_pop) SELECT COUNT(*) AS \"NUMBER_OF_STATES\" FROM state_stats WHERE CAST(friendly_count * 1.0 AS DOUBLE PRECISION) / total_pop > CAST(hostile_count * 1.0 AS DOUBLE PRECISION) / total_pop AND avg_age > 200") t ~= (sql%([ALIEN_DATA_schema]) "WITH state_stats AS (SELECT \"state\", COUNT(*) AS alien_population, CAST(SUM(CASE WHEN \"aggressive\" = 0 THEN 1 ELSE 0 END) * 100.0 AS DOUBLE PRECISION) / COUNT(*) AS pct_friendly, CAST(SUM(CASE WHEN \"aggressive\" = 1 THEN 1 ELSE 0 END) * 100.0 AS DOUBLE PRECISION) / COUNT(*) AS pct_hostile, AVG(\"age\") AS avg_age FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"ALIEN_DATA\" GROUP BY \"state\" ORDER BY alien_population DESC LIMIT 10) SELECT COUNT(*) AS \"NUMBER_OF_STATES\" FROM state_stats WHERE pct_friendly > pct_hostile AND avg_age > 200") t := by
  intro t; first | sql_equiv | sorry

