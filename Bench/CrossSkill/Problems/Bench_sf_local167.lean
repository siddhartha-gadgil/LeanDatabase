/-!
# sf_local167 — crossskill equivalence(s)

Question: Based on the state each female legislator first represented, which state has the highest number of female legislators whose terms included December 31st at any point, and what is that count? Please provide the state's abbreviation.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local167

CREATE TABLE LEGISLATORS («full_name» STRING, «first_name» STRING, «last_name» STRING, «middle_name» STRING, «nickname» STRING, «suffix» STRING, «other_names_end» STRING, «other_names_middle» STRING, «other_names_last» STRING, «birthday» STRING, «gender» STRING, «id_bioguide» STRING, «id_bioguide_previous_0» STRING, «id_govtrack» INT, «id_icpsr» FLOAT, «id_wikipedia» STRING, «id_wikidata» STRING, «id_google_entity_id» STRING, «id_house_history» FLOAT, «id_house_history_alternate» FLOAT, «id_thomas» FLOAT, «id_cspan» FLOAT, «id_votesmart» FLOAT, «id_lis» STRING, «id_ballotpedia» STRING, «id_opensecrets» STRING, «id_fec_0» STRING, «id_fec_1» STRING, «id_fec_2» STRING)
CREATE TABLE LEGISLATORS_TERMS («id_bioguide» STRING, «term_number» INT, «term_id» STRING, «term_type» STRING, «term_start» STRING, «term_end» STRING, «state» STRING, «district» FLOAT, «class» FLOAT, «party» STRING, «how» STRING, «url» STRING, «address» STRING, «phone» STRING, «fax» STRING, «contact_form» STRING, «office» STRING, «state_rank» STRING, «rss_url» STRING, «caucus» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH female_terms AS (\n    SELECT \n        lt.\"id_bioguide\",\n        lt.\"term_number\",\n        lt.\"state\",\n        TRY_TO_DATE(lt.\"term_start\", 'YYYY-MM-DD') AS start_dt,\n        TRY_TO_DATE(lt.\"term_end\", 'YYYY-MM-DD') AS end_dt\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" lt\n    JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l \n        ON lt.\"id_bioguide\" = l.\"id_bioguide\"\n    WHERE l.\"gender\" = 'F'\n),\nfirst_state AS (\n    SELECT \"id_bioguide\", \"state\"\n    FROM female_terms\n    QUALIFY ROW_NUMBER() OVER (PARTITION BY \"id_bioguide\" ORDER BY \"term_number\") = 1\n),\ndec31_legislators AS (\n    SELECT DISTINCT \"id_bioguide\"\n    FROM female_terms\n    WHERE \n        DATE_FROM_PARTS(YEAR(start_dt), 12, 31) BETWEEN start_dt AND end_dt\n        OR DATE_FROM_PARTS(YEAR(end_dt), 12, 31) BETWEEN start_dt AND end_dt\n)\nSELECT \n    fs.\"state\",\n    COUNT(*) AS \"NUMBER_OF_LEGISLATORS\"\nFROM first_state fs\nJOIN dec31_legislators d ON fs.\"id_bioguide\" = d.\"id_bioguide\"\nGROUP BY fs.\"state\"\nORDER BY \"NUMBER_OF_LEGISLATORS\" DESC\nLIMIT 1;") t ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_state AS (\n    -- Get each legislator's first state (from their earliest term)\n    SELECT \"id_bioguide\", \"state\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\"\n    QUALIFY ROW_NUMBER() OVER (PARTITION BY \"id_bioguide\" ORDER BY \"term_start\" ASC) = 1\n),\nfemale_with_dec31 AS (\n    -- Female legislators who have at least one term that includes December 31st\n    -- A term includes Dec 31 if Dec 31 of the term's start year falls between term_start and term_end\n    SELECT DISTINCT l.\"id_bioguide\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l\n    JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t \n        ON l.\"id_bioguide\" = t.\"id_bioguide\"\n    WHERE l.\"gender\" = 'F'\n      AND DATE_FROM_PARTS(YEAR(TO_DATE(t.\"term_start\", 'YYYY-MM-DD')), 12, 31)\n          BETWEEN TO_DATE(t.\"term_start\", 'YYYY-MM-DD') \n              AND TO_DATE(t.\"term_end\", 'YYYY-MM-DD')\n)\nSELECT \n    fs.\"state\",\n    COUNT(*) AS \"NUMBER_OF_LEGISLATORS\"\nFROM female_with_dec31 fd\nJOIN first_state fs ON fd.\"id_bioguide\" = fs.\"id_bioguide\"\nGROUP BY fs.\"state\"\nORDER BY \"NUMBER_OF_LEGISLATORS\" DESC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

