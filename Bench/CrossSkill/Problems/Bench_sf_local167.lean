/-!
# sf_local167 — crossskill equivalence(s)

Question: Based on the state each female legislator first represented, which state has the highest number of female legislators whose terms included December 31st at any point, and what is that count? Please provide the state's abbreviation.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local167

CREATE TABLE LEGISLATORS («full_name» STRING, «first_name» STRING, «last_name» STRING, «middle_name» STRING, «nickname» STRING, «suffix» STRING, «other_names_end» STRING, «other_names_middle» STRING, «other_names_last» STRING, «birthday» STRING, «gender» STRING, «id_bioguide» STRING, «id_bioguide_previous_0» STRING, «id_govtrack» INT, «id_icpsr» FLOAT, «id_wikipedia» STRING, «id_wikidata» STRING, «id_google_entity_id» STRING, «id_house_history» FLOAT, «id_house_history_alternate» FLOAT, «id_thomas» FLOAT, «id_cspan» FLOAT, «id_votesmart» FLOAT, «id_lis» STRING, «id_ballotpedia» STRING, «id_opensecrets» STRING, «id_fec_0» STRING, «id_fec_1» STRING, «id_fec_2» STRING)
CREATE TABLE LEGISLATORS_TERMS («id_bioguide» STRING, «term_number» INT, «term_id» STRING, «term_type» STRING, «term_start» STRING, «term_end» STRING, «state» STRING, «district» FLOAT, «class» FLOAT, «party» STRING, «how» STRING, «url» STRING, «address» STRING, «phone» STRING, «fax» STRING, «contact_form» STRING, «office» STRING, «state_rank» STRING, «rss_url» STRING, «caucus» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH female_terms AS (SELECT lt.\"id_bioguide\", lt.\"term_number\", lt.\"state\", CAST(TO_TIMESTAMP(lt.\"term_start\", 'YYYY-MM-DD') AS DATE) AS start_dt, CAST(TO_TIMESTAMP(lt.\"term_end\", 'YYYY-MM-DD') AS DATE) AS end_dt FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS lt JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON lt.\"id_bioguide\" = l.\"id_bioguide\" WHERE l.\"gender\" = 'F'), first_state AS (SELECT \"id_bioguide\", \"state\" FROM (SELECT \"id_bioguide\", \"state\", ROW_NUMBER() OVER (PARTITION BY \"id_bioguide\" ORDER BY \"term_number\") AS _w, \"term_number\" FROM female_terms) AS _t WHERE _w = 1), dec31_legislators AS (SELECT DISTINCT \"id_bioguide\" FROM female_terms WHERE DATE_FROM_PARTS(EXTRACT(YEAR FROM start_dt), 12, 31) BETWEEN start_dt AND end_dt OR DATE_FROM_PARTS(EXTRACT(YEAR FROM end_dt), 12, 31) BETWEEN start_dt AND end_dt) SELECT fs.\"state\", COUNT(*) AS \"NUMBER_OF_LEGISLATORS\" FROM first_state AS fs JOIN dec31_legislators AS d ON fs.\"id_bioguide\" = d.\"id_bioguide\" GROUP BY fs.\"state\" ORDER BY \"NUMBER_OF_LEGISLATORS\" DESC LIMIT 1") t ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_state AS (/* Get each legislator's first state (from their earliest term) */ SELECT \"id_bioguide\", \"state\" FROM (/* Get each legislator's first state (from their earliest term) */ SELECT \"id_bioguide\", \"state\", ROW_NUMBER() OVER (PARTITION BY \"id_bioguide\" ORDER BY \"term_start\" ASC) AS _w, \"term_start\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\") AS _t WHERE _w = 1), female_with_dec31 AS (/* Female legislators who have at least one term that includes December 31st */ /* A term includes Dec 31 if Dec 31 of the term's start year falls between term_start and term_end */ SELECT DISTINCT l.\"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON l.\"id_bioguide\" = t.\"id_bioguide\" WHERE l.\"gender\" = 'F' AND DATE_FROM_PARTS(EXTRACT(YEAR FROM CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE)), 12, 31) BETWEEN CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE) AND CAST(TO_TIMESTAMP(t.\"term_end\", 'YYYY-MM-DD') AS DATE)) SELECT fs.\"state\", COUNT(*) AS \"NUMBER_OF_LEGISLATORS\" FROM female_with_dec31 AS fd JOIN first_state AS fs ON fd.\"id_bioguide\" = fs.\"id_bioguide\" GROUP BY fs.\"state\" ORDER BY \"NUMBER_OF_LEGISLATORS\" DESC LIMIT 1") t := by
