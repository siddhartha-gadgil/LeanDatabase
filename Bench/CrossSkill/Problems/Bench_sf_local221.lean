CREATE TABLE TEAM («id» INT, «team_api_id» INT, «team_fifa_api_id» FLOAT, «team_long_name» STRING, «team_short_name» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([MATCH_schema, TEAM_schema]) "WITH wins AS (\n  -- Home wins: team won as home team\n  SELECT \"home_team_api_id\" AS team_api_id\n  FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n  WHERE \"home_team_goal\" > \"away_team_goal\"\n  UNION ALL\n  -- Away wins: team won as away team\n  SELECT \"away_team_api_id\" AS team_api_id\n  FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n  WHERE \"away_team_goal\" > \"home_team_goal\"\n)\nSELECT \n  t.\"team_long_name\",\n  COUNT(*) AS TOTAL_WINS\nFROM wins w\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" t \n  ON w.team_api_id = t.\"team_api_id\"\nGROUP BY t.\"team_long_name\"\nORDER BY TOTAL_WINS DESC\nLIMIT 10;") t ~= (sql%([MATCH_schema, TEAM_schema]) "WITH wins AS (\n    -- Home wins\n    SELECT m.\"home_team_api_id\" AS team_api_id, COUNT(*) AS wins\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" m\n    WHERE m.\"home_team_goal\" > m.\"away_team_goal\"\n    GROUP BY m.\"home_team_api_id\"\n\n    UNION ALL\n\n    -- Away wins\n    SELECT m.\"away_team_api_id\" AS team_api_id, COUNT(*) AS wins\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" m\n    WHERE m.\"away_team_goal\" > m.\"home_team_goal\"\n    GROUP BY m.\"away_team_api_id\"\n)\nSELECT\n    t.\"team_long_name\",\n    SUM(w.wins) AS TOTAL_WINS\nFROM wins w\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" t\n    ON t.\"team_api_id\" = w.team_api_id\nGROUP BY t.\"team_long_name\"\nORDER BY TOTAL_WINS DESC\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

