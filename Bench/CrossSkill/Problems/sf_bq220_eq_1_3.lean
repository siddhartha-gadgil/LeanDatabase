theorem eq (t0 : TableRel POPULATION_schema) (t1 : TableRel CONDITION_schema) :
    (sql%([POPULATION_schema, CONDITION_schema]) "WITH base AS (SELECT c.\"inventory_year\", c.\"state_code\", c.\"state_code_name\", c.\"condition_proportion_unadjusted\", c.\"proportion_basis\", ps.\"expansion_factor\", ps.\"adjustment_factor_for_the_subplot\", ps.\"adjustment_factor_for_the_macroplot\" FROM \"USFS_FIA\".\"USFS_FIA\".\"CONDITION\" AS c JOIN \"USFS_FIA\".\"USFS_FIA\".\"POPULATION_STRATUM_ASSIGN\" AS psa ON c.\"state_code\" = psa.\"state_code\" AND c.\"plot_sequence_number\" = psa.\"plot_sequence_number\" AND c.\"inventory_year\" = psa.\"inventory_year\" AND c.\"county_code\" = psa.\"county_code\" JOIN \"USFS_FIA\".\"USFS_FIA\".\"POPULATION_STRATUM\" AS ps ON psa.\"state_code\" = ps.\"state_code\" AND psa.\"stratum_sequence_number\" = ps.\"stratum_sequence_number\" AND psa.\"evaluation_identifier\" = ps.\"evaluation_identifier\" JOIN \"USFS_FIA\".\"USFS_FIA\".\"POPULATION_EVALUATION\" AS pe ON ps.\"evaluation_identifier\" = pe.\"evaluation_identifier\" AND ps.\"state_code\" = pe.\"state_code\" JOIN \"USFS_FIA\".\"USFS_FIA\".\"POPULATION_EVALUATION_TYPE\" AS pet ON pe.\"evaluation_sequence_number\" = pet.\"evaluation_sequence_number\" AND pe.\"evaluation_group_sequence_number\" = pet.\"evaluation_group_sequence_number\" WHERE pet.\"evaluation_type\" = 'EXPCURR' AND c.\"condition_status_code\" = 1 AND c.\"inventory_year\" IN (2015, 2016, 2017)), subplot_avg AS (SELECT \"inventory_year\", \"state_code\", \"state_code_name\", AVG(\"expansion_factor\" * \"condition_proportion_unadjusted\" * \"adjustment_factor_for_the_subplot\") AS AVG_SIZE FROM base WHERE \"proportion_basis\" = 'SUBP' AND \"adjustment_factor_for_the_subplot\" > 0 GROUP BY \"inventory_year\", \"state_code\", \"state_code_name\"), macroplot_avg AS (SELECT \"inventory_year\", \"state_code\", \"state_code_name\", AVG(\"expansion_factor\" * \"condition_proportion_unadjusted\" * \"adjustment_factor_for_the_macroplot\") AS AVG_SIZE FROM base WHERE \"proportion_basis\" = 'MACR' AND \"adjustment_factor_for_the_macroplot\" > 0 GROUP BY \"inventory_year\", \"state_code\", \"state_code_name\"), subplot_ranked AS (SELECT 'SUBPLOT' AS PLOT_TYPE, \"inventory_year\" AS INVENTORY_YEAR, \"state_code\", \"state_code_name\", AVG_SIZE, ROW_NUMBER() OVER (PARTITION BY \"inventory_year\" ORDER BY AVG_SIZE DESC) AS rn FROM subplot_avg), macroplot_ranked AS (SELECT 'MACROPLOT' AS PLOT_TYPE, \"inventory_year\" AS INVENTORY_YEAR, \"state_code\", \"state_code_name\", AVG_SIZE, ROW_NUMBER() OVER (PARTITION BY \"inventory_year\" ORDER BY AVG_SIZE DESC) AS rn FROM macroplot_avg) SELECT PLOT_TYPE, INVENTORY_YEAR, \"state_code\", \"state_code_name\", AVG_SIZE FROM (SELECT PLOT_TYPE, INVENTORY_YEAR, \"state_code\", \"state_code_name\", AVG_SIZE FROM subplot_ranked WHERE rn = 1 UNION ALL SELECT PLOT_TYPE, INVENTORY_YEAR, \"state_code\", \"state_code_name\", AVG_SIZE FROM macroplot_ranked WHERE rn = 1) ORDER BY PLOT_TYPE, INVENTORY_YEAR") t0 t1
  ~= (sql%([POPULATION_schema, CONDITION_schema]) "WITH forest_area AS (SELECT CASE WHEN c.\"proportion_basis\" = 'MACR' THEN 'MACROPLOT' WHEN c.\"proportion_basis\" = 'SUBP' THEN 'SUBPLOT' END AS PLOT_TYPE, c.\"inventory_year\" AS INVENTORY_YEAR, c.\"state_code\" AS state_code, c.\"state_code_name\" AS state_code_name, p.\"expansion_factor\" * c.\"condition_proportion_unadjusted\" * CASE WHEN c.\"proportion_basis\" = 'MACR' THEN p.\"adjustment_factor_for_the_macroplot\" WHEN c.\"proportion_basis\" = 'SUBP' THEN p.\"adjustment_factor_for_the_subplot\" END AS estimated_area FROM \"USFS_FIA\".\"USFS_FIA\".\"CONDITION\" AS c JOIN \"USFS_FIA\".\"USFS_FIA\".\"POPULATION\" AS p ON c.\"state_code\" = p.\"state_code\" AND c.\"county_code\" = p.\"county_code\" AND c.\"phase_2_plot_number\" = p.\"phase_2_plot_number\" AND c.\"inventory_year\" = p.\"inventory_year\" WHERE p.\"evaluation_type\" = 'EXPCURR' AND c.\"condition_status_code\" = 1 AND c.\"proportion_basis\" IN ('MACR', 'SUBP') AND ((c.\"proportion_basis\" = 'MACR' AND p.\"adjustment_factor_for_the_macroplot\" > 0) OR (c.\"proportion_basis\" = 'SUBP' AND p.\"adjustment_factor_for_the_subplot\" > 0)) AND c.\"inventory_year\" IN (2015, 2016, 2017)), avg_by_state AS (SELECT PLOT_TYPE, INVENTORY_YEAR, state_code, state_code_name, AVG(estimated_area) AS AVG_SIZE FROM forest_area GROUP BY PLOT_TYPE, INVENTORY_YEAR, state_code, state_code_name), ranked AS (SELECT PLOT_TYPE, INVENTORY_YEAR, state_code, state_code_name, AVG_SIZE, ROW_NUMBER() OVER (PARTITION BY PLOT_TYPE, INVENTORY_YEAR ORDER BY AVG_SIZE DESC) AS rn FROM avg_by_state) SELECT PLOT_TYPE, INVENTORY_YEAR, state_code, state_code_name, AVG_SIZE FROM ranked WHERE rn = 1 ORDER BY PLOT_TYPE, INVENTORY_YEAR") t0 t1
