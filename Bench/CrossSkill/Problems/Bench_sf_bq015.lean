import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq015 — crossskill equivalence(s)

Question: Identify and rank the top 10 tags from Stack Overflow questions that were referenced in Hacker News comments on or after 2014 by counting how many times each question was mentioned, then splitting the questions’ tag strings by the '|' delimiter, grouping by tag

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq015

CREATE TABLE COMMENTS («id» INT, «by» STRING, «author» STRING, «time» INT, «time_ts» INT, «text» STRING, «parent» INT, «deleted» BOOL, «dead» BOOL, «ranking» INT)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)
CREATE TABLE TAGS («id» INT, «tag_name» STRING, «count» INT, «excerpt_post_id» INT, «wiki_post_id» INT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([COMMENTS_schema, POSTS_QUESTIONS_schema, TAGS_schema]) "WITH mentions AS (\n  SELECT \n    CAST(REGEXP_SUBSTR(\"text\", 'stackoverflow\\\\.com/questions/([0-9]+)', 1, 1, 'e', 1) AS INTEGER) AS question_id\n  FROM \"STACKOVERFLOW_PLUS\".\"HACKERNEWS\".\"COMMENTS\"\n  WHERE \"text\" LIKE '%stackoverflow.com/questions/%'\n    AND EXTRACT(YEAR FROM TO_TIMESTAMP(\"time\")) >= 2014\n)\nSELECT \n  t.VALUE AS TAG, \n  COUNT(*) AS COUNT\nFROM mentions m\nJOIN \"STACKOVERFLOW_PLUS\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q \n  ON m.question_id = q.\"id\"\n, LATERAL SPLIT_TO_TABLE(q.\"tags\", '|') t\nGROUP BY t.VALUE\nORDER BY COUNT DESC\nLIMIT 10;") t ~= (sql%([COMMENTS_schema, POSTS_QUESTIONS_schema, TAGS_schema]) "WITH question_mentions AS (\n  SELECT \n    TRY_CAST(REGEXP_SUBSTR(\"text\", 'stackoverflow\\\\.com/questions/([0-9]+)', 1, 1, 'e', 1) AS NUMBER) AS so_id,\n    COUNT(*) AS mention_count\n  FROM \"STACKOVERFLOW_PLUS\".\"HACKERNEWS\".\"COMMENTS\"\n  WHERE \"text\" LIKE '%stackoverflow.com/questions/%'\n    AND EXTRACT(YEAR FROM TO_TIMESTAMP(\"time\")) >= 2014\n  GROUP BY so_id\n)\nSELECT \n  t.VALUE::STRING AS TAG, \n  SUM(qm.mention_count) AS COUNT\nFROM question_mentions qm\nJOIN \"STACKOVERFLOW_PLUS\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n  ON qm.so_id = q.\"id\",\nLATERAL FLATTEN(input => SPLIT(q.\"tags\", '|')) t\nGROUP BY t.VALUE::STRING\nORDER BY COUNT DESC\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

-- eq_0_2: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_2 : ∀ t,
    (sql%([COMMENTS_schema, POSTS_QUESTIONS_schema, TAGS_schema]) "WITH mentions AS (\n  SELECT \n    CAST(REGEXP_SUBSTR(\"text\", 'stackoverflow\\\\.com/questions/([0-9]+)', 1, 1, 'e', 1) AS INTEGER) AS question_id\n  FROM \"STACKOVERFLOW_PLUS\".\"HACKERNEWS\".\"COMMENTS\"\n  WHERE \"text\" LIKE '%stackoverflow.com/questions/%'\n    AND EXTRACT(YEAR FROM TO_TIMESTAMP(\"time\")) >= 2014\n)\nSELECT \n  t.VALUE AS TAG, \n  COUNT(*) AS COUNT\nFROM mentions m\nJOIN \"STACKOVERFLOW_PLUS\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q \n  ON m.question_id = q.\"id\"\n, LATERAL SPLIT_TO_TABLE(q.\"tags\", '|') t\nGROUP BY t.VALUE\nORDER BY COUNT DESC\nLIMIT 10;") t ~= (sql%([COMMENTS_schema, POSTS_QUESTIONS_schema, TAGS_schema]) "WITH hn_so_refs AS (\n  SELECT \n    REGEXP_SUBSTR(\"text\", 'stackoverflow\\\\.com/questions/([0-9]+)', 1, 1, 'i', 1) AS question_id,\n    COUNT(*) AS mention_count\n  FROM \"STACKOVERFLOW_PLUS\".\"HACKERNEWS\".\"COMMENTS\"\n  WHERE LOWER(\"text\") LIKE '%stackoverflow.com/questions/%'\n    AND \"time_ts\" >= 1388534400000000\n  GROUP BY question_id\n),\nquestion_tags AS (\n  SELECT \n    r.question_id,\n    r.mention_count,\n    q.\"tags\"\n  FROM hn_so_refs r\n  INNER JOIN \"STACKOVERFLOW_PLUS\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    ON q.\"id\" = TRY_CAST(r.question_id AS NUMBER)\n  WHERE r.question_id IS NOT NULL\n    AND q.\"tags\" IS NOT NULL\n),\nsplit_tags AS (\n  SELECT \n    TRIM(t.VALUE::STRING) AS tag,\n    mention_count\n  FROM question_tags,\n    LATERAL FLATTEN(INPUT => SPLIT(\"tags\", '|')) t\n)\nSELECT \n  tag AS \"TAG\",\n  SUM(mention_count) AS \"COUNT\"\nFROM split_tags\nGROUP BY tag\nORDER BY \"COUNT\" DESC\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

