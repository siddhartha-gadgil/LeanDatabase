h TAS evidence */ AS (SELECT DISTINCT pe.\"uniprot_id\", ptp.\"pathway_stable_id\" FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" AS pe JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" AS ptp ON pe.\"stable_id\" = ptp.\"pe_stable_id\" JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" AS p ON ptp.\"pathway_stable_id\" = p.\"stable_id\" WHERE ptp.\"evidence_code\" = 'TAS' AND p.\"lowest_level\" = TRUE AND p.\"species\" = 'Homo sapiens'), total_universe /* Step 3: Get the total universe of unique proteins across all TAS lowest-level pathways */ AS (SELECT COUNT(DISTINCT \"uniprot_id\") AS total_genes FROM all_pathway_genes), total_targets /* Step 4: Count total sorafenib targets (that are in the universe) */ AS (SELECT COUNT(DISTINCT st.uniprot_id) AS total_target_count FROM sorafenib_targets AS st WHERE EXISTS(SELECT 1 FROM all_pathway_genes AS apg WHERE apg.\"uniprot_id\" = st.uniprot_id)), lowest_level_pathways /* Step 5: Get lowest-level pathways */ AS (SELECT p.\"stable_id\", p.\"name\" FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" AS p WHERE p.\"lowest_level\" = TRUE AND p.\"species\" = 'Homo sapiens'), pathway_stats /* Step 6: For each pathway, count genes in pathway and targets in pathway */ AS (SELECT llp.\"stable_id\" AS pathway_id, llp.\"name\" AS pathway_name, COUNT(DISTINCT apg.\"uniprot_id\") AS genes_in_pathway, COUNT(DISTINCT CASE WHEN NOT st.uniprot_id IS NULL THEN apg.\"uniprot_id\" END) AS targets_in_pathway FROM lowest_level_pathways AS llp JOIN all_pathway_genes AS apg ON apg.\"pathway_stable_id\" = llp.\"stable_id\" LEFT JOIN sorafenib_targets AS st ON apg.\"uniprot_id\" = st.uniprot_id GROUP BY llp.\"stable_id\", llp.\"name\"), chi_sq /* Step 7: Build 2x2 contingency table and compute chi-squared */ AS (SELECT ps.pathway_id, ps.pathway_name, ps.targets_in_pathway AS a, tt.total_target_count - ps.targets_in_pathway AS b, ps.genes_in_pathway - ps.targets_in_pathway AS c, (tu.total_genes - ps.genes_in_pathway) - (tt.total_target_count - ps.targets_in_pathway) AS d, tu.total_genes AS n FROM pathway_stats AS ps CROSS JOIN total_universe AS tu CROSS JOIN total_targets AS tt) SELECT pathway_id AS \"PATHWAY_ID\", pathway_name AS \"PATHWAY_NAME\", a AS \"TARGETS_IN_PATHWAY\", b AS \"TARGETS_OUTSIDE_PATHWAY\", c AS \"NONTARGETS_IN_PATHWAY\", d AS \"NONTARGETS_OUTSIDE_PATHWAY\", ROUND(CAST(CAST((n * POWER((a * d) - (b * c), 2)) AS DOUBLE PRECISION) / CAST((NULLIF((a + b) * (c + d) * (a + c) * (b + d), 0)) AS DOUBLE PRECISION) AS DECIMAL), 4) AS \"CHI_SQUARED\" FROM chi_sq WHERE a > 0 /* only pathways that have at least one target */ ORDER BY \"CHI_SQUARED\" DESC LIMIT 3") t := by
