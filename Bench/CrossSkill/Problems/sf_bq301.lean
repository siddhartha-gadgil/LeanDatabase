/-!
# sf_bq301 — crossskill equivalence(s)

Question: Retrieve details of accepted answers to Stack Overflow questions posted in January 2016 that have tags including "javascript" and at least one of "xss", "cross-site", "exploit", or "cybersecurity"; the answers themselves must also have been posted in January 2016. For each accepted answer, include the answer's ID, the answerer's reputation, score, and comment count, along with the associated question's tags, score, answer count, the asker's reputation, view count, and comment count.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq301

CREATE TABLE TAGS («id» INT, «tag_name» STRING, «count» INT, «excerpt_post_id» INT, «wiki_post_id» INT)
CREATE TABLE USERS («id» INT, «display_name» STRING, «about_me» STRING, «age» STRING, «creation_date» INT, «last_access_date» INT, «location» STRING, «reputation» INT, «up_votes» INT, «down_votes» INT, «views» INT, «profile_image_url» STRING, «website_url» STRING)
CREATE TABLE POSTS_ANSWERS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» STRING, «answer_count» STRING, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» STRING, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» INT, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» STRING)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

theorem eq_0_1 :
    sql%([TAGS_schema, USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "SELECT a.\"id\" AS A_ID, u_a.\"reputation\" AS A_USER_REPUTATION, a.\"score\" AS A_SCORE, a.\"comment_count\" AS ANSWER_COMMENT_COUNT, q.\"tags\" AS Q_TAGS, q.\"score\" AS Q_SCORE, q.\"answer_count\" AS ANSWER_COUNT, u_q.\"reputation\" AS Q_USER_REPUTATION, q.\"view_count\" AS Q_VIEW_COUNT, q.\"comment_count\" AS Q_COMMENT_COUNT FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" AS a ON q.\"accepted_answer_id\" = a.\"id\" JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" AS u_a ON a.\"owner_user_id\" = u_a.\"id\" JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" AS u_q ON q.\"owner_user_id\" = u_q.\"id\" WHERE q.\"creation_date\" >= 1451606400000000 AND q.\"creation_date\" < 1454284800000000 AND a.\"creation_date\" >= 1451606400000000 AND a.\"creation_date\" < 1454284800000000 AND q.\"tags\" LIKE '%javascript%' AND (q.\"tags\" LIKE '%xss%' OR q.\"tags\" LIKE '%cross-site%' OR q.\"tags\" LIKE '%exploit%' OR q.\"tags\" LIKE '%cybersecurity%') ORDER BY A_ID DESC" = sql%([TAGS_schema, USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "SELECT a.\"id\" AS A_ID, u_a.\"reputation\" AS A_USER_REPUTATION, a.\"score\" AS A_SCORE, a.\"comment_count\" AS ANSWER_COMMENT_COUNT, q.\"tags\" AS Q_TAGS, q.\"score\" AS Q_SCORE, q.\"answer_count\" AS ANSWER_COUNT, u_q.\"reputation\" AS Q_USER_REPUTATION, q.\"view_count\" AS Q_VIEW_COUNT, q.\"comment_count\" AS Q_COMMENT_COUNT FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q INNER JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" AS a ON q.\"accepted_answer_id\" = a.\"id\" INNER JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" AS u_q ON q.\"owner_user_id\" = u_q.\"id\" INNER JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" AS u_a ON a.\"owner_user_id\" = u_a.\"id\" WHERE q.\"tags\" LIKE '%javascript%' AND (q.\"tags\" LIKE '%xss%' OR q.\"tags\" LIKE '%cross-site%' OR q.\"tags\" LIKE '%exploit%' OR q.\"tags\" LIKE '%cybersecurity%') AND TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) >= '2016-01-01' AND TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) < '2016-02-01' ORDER BY a.\"id\" DESC" := by
