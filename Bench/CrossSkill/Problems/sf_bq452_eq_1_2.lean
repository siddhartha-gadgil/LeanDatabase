CREATE TABLE VARIANTS («reference_name» STRING, «start» INT, «end» INT, «reference_bases» STRING, «alternate_bases» STRING, «quality» FLOAT, «filter» STRING, «names» STRING, «call» STRING, «AA» STRING, «AC» STRING, «AC1» INT, «AF» FLOAT, «AF1» FLOAT, «AFR_AF» FLOAT, «AMR_AF» FLOAT, «AN» INT, «ASN_AF» FLOAT, «AVGPOST» FLOAT, «CIEND» STRING, «CIPOS» STRING, «DP» INT, «DP4» STRING, «ERATE» FLOAT, «EUR_AF» FLOAT, «FQ» FLOAT, «G3» STRING, «HOMLEN» INT, «HOMSEQ» STRING, «HWE» FLOAT, «LDAF» FLOAT, «MQ» INT, «PV4» STRING, «RSQ» FLOAT, «SNPSOURCE» STRING, «SOURCE» STRING, «SVLEN» INT, «SVTYPE» STRING, «THETA» FLOAT, «VT» STRING)

theorem eq (t0 : TableRel SAMPLE_INFO_schema) (t1 : TableRel VARIANTS_schema) :
    (sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH allele_counts AS (SELECT v.\"start\" AS start_pos, v.\"end\" AS end_pos, SUM(CASE WHEN si.\"Super_Population\" = 'EAS' THEN CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '0') AS INT) + CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '1') AS INT) ELSE 0 END) AS a /* EAS alt alleles (case alt = a) */, SUM(CASE WHEN si.\"Super_Population\" = 'EAS' THEN 2 - (CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '0') AS INT) + CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '1') AS INT)) ELSE 0 END) AS b /* EAS ref alleles (case ref = b) */, SUM(CASE WHEN si.\"Super_Population\" <> 'EAS' THEN CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '0') AS INT) + CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '1') AS INT) ELSE 0 END) AS cc /* non-EAS alt alleles (control alt = c) */, SUM(CASE WHEN si.\"Super_Population\" <> 'EAS' THEN 2 - (CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '0') AS INT) + CAST(JSON_EXTRACT_PATH(c.value, 'genotype', '1') AS INT)) ELSE 0 END) AS d /* non-EAS ref alleles (control ref = d) */ FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" AS v, LATERAL UNNEST(input => v.\"call\") AS c(SEQ, KEY, PATH, INDEX, VALUE, THIS) JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" AS si ON CAST(JSON_EXTRACT_PATH(c.value, 'call_set_name') AS TEXT) = si.\"Sample\" WHERE v.\"reference_name\" = '12' GROUP BY v.\"start\", v.\"end\"), chi2_calc AS (SELECT start_pos, end_pos, a, b, cc, d, (a + b + cc + d) AS N, (a + b) AS R1, (cc + d) AS R2, (a + cc) AS C1, (b + d) AS C2, CAST((a + b) /* Expected counts */ * (a + cc) * 1.0 AS DOUBLE PRECISION) / (a + b + cc + d) AS E_a, CAST((a + b) * (b + d) * 1.0 AS DOUBLE PRECISION) / (a + b + cc + d) AS E_b, CAST((cc + d) * (a + cc) * 1.0 AS DOUBLE PRECISION) / (a + b + cc + d) AS E_c, CAST((cc + d) * (b + d) * 1.0 AS DOUBLE PRECISION) / (a + b + cc + d) AS E_d, CASE WHEN (a + b) * (cc + d) * (a + cc) * (b + d) = 0 THEN 0 ELSE CAST(POWER(GREATEST(ABS(a * d - b * cc) - CAST((a + b + cc + d) AS DOUBLE PRECISION) / 2.0, 0), 2) * (a + b + cc + d) AS DOUBLE PRECISION) / ((a + b) * (cc + d) * (a + cc) * (b + d)) END AS CHI2 /* Chi-squared with Yates' correction */ FROM allele_counts) SELECT start_pos AS \"start\", end_pos AS \"end\", CHI2 AS \"CHI2\" FROM chi2_calc WHERE E_a >= 5 AND E_b >= 5 AND E_c >= 5 AND E_d >= 5 AND CHI2 >= 29.71679 ORDER BY CHI2 DESC") t0 t1
  ~= (sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH allele_counts AS (SELECT v.\"start\" AS start_pos, v.\"end\" AS end_pos, SUM(CASE WHEN si.\"Super_Population\" = 'EAS' THEN (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '0') AS INT) = 0 THEN 1 ELSE 0 END) + (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '1') AS INT) = 0 THEN 1 ELSE 0 END) ELSE 0 END) AS case_ref, SUM(CASE WHEN si.\"Super_Population\" = 'EAS' THEN (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '0') AS INT) > 0 THEN 1 ELSE 0 END) + (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '1') AS INT) > 0 THEN 1 ELSE 0 END) ELSE 0 END) AS case_alt, SUM(CASE WHEN si.\"Super_Population\" <> 'EAS' THEN (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '0') AS INT) = 0 THEN 1 ELSE 0 END) + (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '1') AS INT) = 0 THEN 1 ELSE 0 END) ELSE 0 END) AS ctrl_ref, SUM(CASE WHEN si.\"Super_Population\" <> 'EAS' THEN (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '0') AS INT) > 0 THEN 1 ELSE 0 END) + (CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'genotype', '1') AS INT) > 0 THEN 1 ELSE 0 END) ELSE 0 END) AS ctrl_alt FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" AS v, LATERAL UNNEST(input => v.\"call\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" AS si ON CAST(JSON_EXTRACT_PATH(f.value, 'call_set_name') AS TEXT) = si.\"Sample\" WHERE v.\"reference_name\" = '12' GROUP BY v.\"start\", v.\"end\"), chi2_calc AS (SELECT start_pos, end_pos, case_ref, case_alt, ctrl_ref, ctrl_alt, (case_ref + case_alt + ctrl_ref + ctrl_alt) AS N, (case_ref + case_alt) AS R1, (ctrl_ref + ctrl_alt) AS R2, (case_ref + ctrl_ref) AS C1, (case_alt + ctrl_alt) AS C2, CAST(((case_ref + case_alt) * (case_ref + ctrl_ref)) /* Expected values */ AS DOUBLE PRECISION) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E11, CAST(((case_ref + case_alt) * (case_alt + ctrl_alt)) AS DOUBLE PRECISION) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E12, CAST(((ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref)) AS DOUBLE PRECISION) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E21, CAST(((ctrl_ref + ctrl_alt) * (case_alt + ctrl_alt)) AS DOUBLE PRECISION) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E22, CAST(CAST((case_ref + case_alt + ctrl_ref + ctrl_alt) /* Chi-squared with Yates correction */ AS DOUBLE PRECISION) * POWER(GREATEST(ABS(CAST(case_ref AS DOUBLE PRECISION) * CAST(ctrl_alt AS DOUBLE PRECISION) - CAST(case_alt AS DOUBLE PRECISION) * CAST(ctrl_ref AS DOUBLE PRECISION)) - CAST((case_ref + case_alt + ctrl_ref + ctrl_alt) AS DOUBLE PRECISION) / 2.0, 0), 2) AS DOUBLE PRECISION) / NULLIF(CAST((case_ref + case_alt) AS DOUBLE PRECISION) * CAST((ctrl_ref + ctrl_alt) AS DOUBLE PRECISION) * CAST((case_ref + ctrl_ref) AS DOUBLE PRECISION) * CAST((case_alt + ctrl_alt) AS DOUBLE PRECISION), 0) AS CHI2 FROM allele_counts) SELECT start_pos AS \"start\", end_pos AS \"end\", CHI2 AS \"CHI2\" FROM chi2_calc WHERE E11 >= 5 AND E12 >= 5 AND E21 >= 5 AND E22 >= 5 AND CHI2 >= 29.71679 ORDER BY CHI2 DESC") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq452_eq_1_2
