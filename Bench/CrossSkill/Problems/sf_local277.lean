theorem eq_2_3 : ∀ t,
    (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base AS (/* Assign time steps 1-36 per product starting Jan 2016 */ SELECT \"product_id\", \"mth\", \"qty\", ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t, EXTRACT(MONTH FROM CAST(TO_TIMESTAMP(\"mth\", 'YYYY-MM-DD') AS DATE)) AS month_of_year FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790) AND \"mth\" >= '2016-01-01' AND \"mth\" < '2019-01-01'), cma_calc /* Step 1: Compute Centered Moving Average (CMA) using two overlapping 12-month windows */ AS (SELECT b.\"product_id\", b.t, b.\"mth\", b.\"qty\", b.month_of_year, AVG(b2.\"qty\") AS ma1 /* Window 1: t-5 to t+6 */, AVG(b3.\"qty\") AS ma2 /* Window 2: t-6 to t+5 */ FROM base AS b LEFT JOIN base AS b2 ON b.\"product_id\" = b2.\"product_id\" AND b2.t BETWEEN b.t - 5 AND b.t + 6 LEFT JOIN base AS b3 ON b.\"product_id\" = b3.\"product_id\" AND b3.t BETWEEN b.t - 6 AND b.t + 5 GROUP BY b.\"product_id\", b.t, b.\"mth\", b.\"qty\", b.month_of_year), cma AS (SELECT \"product_id\", t, \"mth\", \"qty\", month_of_year, CASE WHEN t >= 7 AND t <= 30 THEN CAST((ma1 + ma2) AS DOUBLE PRECISION) / 2.0 ELSE NULL END AS cma_value FROM cma_calc), ratios /* Step 2: Compute sales-to-CMA ratio for time steps 7-30 */ AS (SELECT \"product_id\", t, month_of_year, \"qty\", cma_value, CAST(\"qty\" AS DOUBLE PRECISION) / NULLIF(cma_value, 0) AS ratio FROM cma WHERE t BETWEEN 7 AND 30 AND NOT cma_value IS NULL), seasonal_factors /* Step 3: Compute seasonal factors (average ratio per month-of-year per product) */ AS (SELECT \"product_id\", month_of_year, AVG(ratio) AS seasonal_factor FROM ratios GROUP BY \"product_id\", month_of_year), deseasonalized /* Step 4: Deseasonalize data for time steps 7-30 */ AS (SELECT c.\"product_id\", c.t, c.\"qty\", c.month_of_year, sf.seasonal_factor, CAST(c.\"qty\" AS DOUBLE PRECISION) / NULLIF(sf.seasonal_factor, 0) AS deseasonalized_qty FROM cma AS c JOIN seasonal_factors AS sf ON c.\"product_id\" = sf.\"product_id\" AND c.month_of_year = sf.month_of_year WHERE c.t BETWEEN 7 AND 30), regression /* Step 5: Weighted linear regression on deseasonalized data (time steps 7-30) */ /* Using REGR functions: y = deseasonalized_qty, x = t, weighted by t */ AS (SELECT \"product_id\", CAST(REGR_SLOPE(deseasonalized_qty * t, t * t) AS DOUBLE PRECISION) / REGR_SLOPE(t, t) AS w_slope, REGR_INTERCEPT(deseasonalized_qty * t, t * t) AS w_intercept_raw, SUM(t * deseasonalized_qty * t) AS sum_wxy /* Standard weighted regression: minimize sum(w_i * (y_i - a - b*x_i)^2) */ /* With weights = time step t */, SUM(t * t) AS sum_wx2, SUM(t * deseasonalized_qty) AS sum_wy, SUM(t) AS sum_w, SUM(t * t * t) AS sum_wx3, COUNT(*) AS n FROM deseasonalized GROUP BY \"product_id\"), weighted_reg /* Weighted regression coefficients */ /* b = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wx3 - sum_wx2 * sum_wx2)  -- wrong */ /* Actually: weight w_i = t_i */ /* sum_w = SUM(w_i), sum_wx = SUM(w_i * x_i), sum_wy = SUM(w_i * y_i) */ /* sum_wxx = SUM(w_i * x_i * x_i), sum_wxy = SUM(w_i * x_i * y_i) */ /* slope = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wxx - sum_wx * sum_wx) */ /* intercept = (sum_wy - slope * sum_wx) / sum_w */ AS (SELECT \"product_id\", SUM(t) AS sum_w, SUM(t * t) AS sum_wx /* sum(w_i * x_i) where w=t, x=t => sum(t^2) */, SUM(t * deseasonalized_qty) AS sum_wy /* sum(w_i * y_i) */, SUM(t * t * t) AS sum_wxx /* sum(w_i * x_i^2) = sum(t^3) */, SUM(t * t * deseasonalized_qty) AS sum_wxy /* sum(w_i * x_i * y_i) = sum(t^2 * y) */ FROM deseasonalized GROUP BY \"product_id\"), reg_coeffs AS (SELECT \"product_id\", CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0) AS slope, CAST((sum_wy - (CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0)) * sum_wx) AS DOUBLE PRECISION) / NULLIF(sum_w, 0) AS intercept FROM weighted_reg), forecast_months /* Step 6: Generate time steps for 2018 (t = 25 to 36) */ AS (SELECT \"product_id\", 25 AS t, 1 AS month_of_year FROM reg_coeffs UNION ALL SELECT \"product_id\", 26, 2 FROM reg_coeffs UNION ALL SELECT \"product_id\", 27, 3 FROM reg_coeffs UNION ALL SELECT \"product_id\", 28, 4 FROM reg_coeffs UNION ALL SELECT \"product_id\", 29, 5 FROM reg_coeffs UNION ALL SELECT \"product_id\", 30, 6 FROM reg_coeffs UNION ALL SELECT \"product_id\", 31, 7 FROM reg_coeffs UNION ALL SELECT \"product_id\", 32, 8 FROM reg_coeffs UNION ALL SELECT \"product_id\", 33, 9 FROM reg_coeffs UNION ALL SELECT \"product_id\", 34, 10 FROM reg_coeffs UNION ALL SELECT \"product_id\", 35, 11 FROM reg_coeffs UNION ALL SELECT \"product_id\", 36, 12 FROM reg_coeffs), forecasted /* Step 7: Forecast = (intercept + slope * t) * seasonal_factor */ AS (SELECT fm.\"product_id\", fm.t, fm.month_of_year, rc.intercept + rc.slope * fm.t AS deseasonalized_forecast, sf.seasonal_factor, (rc.intercept + rc.slope * fm.t) * sf.seasonal_factor AS forecasted_qty FROM forecast_months AS fm JOIN reg_coeffs AS rc ON fm.\"product_id\" = rc.\"product_id\" JOIN seasonal_factors AS sf ON fm.\"product_id\" = sf.\"product_id\" AND fm.month_of_year = sf.month_of_year), annual_forecast /* Step 8: Sum monthly forecasts to get annual 2018 per product */ AS (SELECT \"product_id\", SUM(forecasted_qty) AS annual_sales_2018 FROM forecasted GROUP BY \"product_id\") /* Step 9: Average across both products */ SELECT ROUND(CAST(AVG(annual_sales_2018) AS DECIMAL), 2) AS \"AVG_FORECASTED_ANNUAL_SALES_2018\" FROM annual_forecast") t ~= (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base_data AS (SELECT \"product_id\", \"mth\", \"qty\", ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS time_step, EXTRACT(MONTH FROM CAST(TO_TIMESTAMP(\"mth\", 'YYYY-MM-DD') AS DATE)) AS month_num FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790) AND \"mth\" >= '2016-01-01' AND \"mth\" < '2019-01-01'), cma_calc /* Calculate 2x12 Centered Moving Average */ /* MA1 centered at t: average of t-5 to t+6 */ /* MA2 centered at t: average of t-6 to t+5 */ /* CMA = (MA1 + MA2) / 2 */ AS (SELECT a.\"product_id\", a.time_step, a.month_num, a.\"qty\", CAST(((SELECT AVG(b.\"qty\") FROM base_data AS b WHERE b.\"product_id\" = a.\"product_id\" AND b.time_step BETWEEN a.time_step - 5 AND a.time_step + 6) + (SELECT AVG(b.\"qty\") FROM base_data AS b WHERE b.\"product_id\" = a.\"product_id\" AND b.time_step BETWEEN a.time_step - 6 AND a.time_step + 5)) AS DOUBLE PRECISION) / 2.0 AS cma FROM base_data AS a WHERE a.time_step BETWEEN 7 AND 30), ratios /* Sales-to-CMA ratio */ AS (SELECT \"product_id\", time_step, month_num, \"qty\", cma, CASE WHEN cma <> 0 THEN CAST(\"qty\" AS DOUBLE PRECISION) / cma ELSE NULL END AS sales_to_cma FROM cma_calc), seasonal_indices /* Seasonal indices: average of sales-to-CMA ratios by month_num per product */ AS (SELECT \"product_id\", month_num, AVG(sales_to_cma) AS seasonal_index FROM ratios WHERE NOT sales_to_cma IS NULL GROUP BY \"product_id\", month_num), deseasonalized /* Deseasonalize all 36 months */ AS (SELECT b.\"product_id\", b.time_step, b.month_num, b.\"qty\", s.seasonal_index, CASE WHEN s.seasonal_index <> 0 THEN CAST(b.\"qty\" AS DOUBLE PRECISION) / s.seasonal_index ELSE NULL END AS deseas_qty FROM base_data AS b JOIN seasonal_indices AS s ON b.\"product_id\" = s.\"product_id\" AND b.month_num = s.month_num), regression_stats /* Weighted linear regression on deseasonalized data (all 36 months) */ /* Weights = time_step */ /* WLS: minimize sum(w_i * (y_i - a - b*x_i)^2) */ /* Normal equations: */ /* b = (sum(w*x*y) - sum(w*x)*sum(w*y)/sum(w)) / (sum(w*x^2) - (sum(w*x))^2/sum(w)) */ /* a = (sum(w*y) - b*sum(w*x)) / sum(w) */ AS (SELECT \"product_id\", SUM(time_step * deseas_qty * time_step) AS sum_wxy /* sum(w*x*y) where w=x=time_step */, SUM(time_step * time_step) AS sum_wx2 /* sum(w*x^2) */, SUM(time_step * time_step) AS sum_wx /* sum(w*x) -- wait, w=time_step, x=time_step */, SUM(time_step * deseas_qty) AS sum_wy /* sum(w*y) */, SUM(time_step) AS sum_w /* sum(w) */ FROM deseasonalized GROUP BY \"product_id\"), regression_stats2 /* Actually, let me redo this. w_i = time_step_i, x_i = time_step_i, y_i = deseas_qty_i */ /* sum_w = sum(w_i) = sum(time_step) */ /* sum_wx = sum(w_i * x_i) = sum(time_step^2) */ /* sum_wy = sum(w_i * y_i) = sum(time_step * deseas_qty) */ /* sum_wxy = sum(w_i * x_i * y_i) = sum(time_step^2 * deseas_qty) */ /* sum_wx2 = sum(w_i * x_i^2) = sum(time_step^3) */ AS (SELECT \"product_id\", SUM(CAST(time_step AS DOUBLE PRECISION)) AS sum_w, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx, SUM(CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wxy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx2 FROM deseasonalized GROUP BY \"product_id\"), regression_coeffs AS (SELECT \"product_id\", CAST((sum_wxy - CAST(sum_wx * sum_wy AS DOUBLE PRECISION) / sum_w) AS DOUBLE PRECISION) / (sum_wx2 - CAST(sum_wx * sum_wx AS DOUBLE PRECISION) / sum_w) AS slope, CAST((sum_wy - (CAST((sum_wxy - CAST(sum_wx * sum_wy AS DOUBLE PRECISION) / sum_w) AS DOUBLE PRECISION) / (sum_wx2 - CAST(sum_wx * sum_wx AS DOUBLE PRECISION) / sum_w)) * sum_wx) AS DOUBLE PRECISION) / sum_w AS intercept FROM regression_stats2), forecast_months /* Forecast: for each month in 2018 (time steps 25-36), predict deseasonalized value */ /* then re-seasonalize */ AS (SELECT 25 AS time_step, 1 AS month_num UNION ALL SELECT 26, 2 UNION ALL SELECT 27, 3 UNION ALL SELECT 28, 4 UNION ALL SELECT 29, 5 UNION ALL SELECT 30, 6 UNION ALL SELECT 31, 7 UNION ALL SELECT 32, 8 UNION ALL SELECT 33, 9 UNION ALL SELECT 34, 10 UNION ALL SELECT 35, 11 UNION ALL SELECT 36, 12), forecasted AS (SELECT r.\"product_id\", f.time_step, f.month_num, r.intercept + r.slope * f.time_step AS forecast_deseas, s.seasonal_index, (r.intercept + r.slope * f.time_step) * s.seasonal_index AS forecast_seas FROM regression_coeffs AS r CROSS JOIN forecast_months AS f JOIN seasonal_indices AS s ON r.\"product_id\" = s.\"product_id\" AND f.month_num = s.month_num), annual_forecast /* Sum forecasted monthly values to get annual forecast per product */ AS (SELECT \"product_id\", SUM(forecast_seas) AS forecasted_annual_sales FROM forecasted GROUP BY \"product_id\") SELECT ROUND(CAST(AVG(forecasted_annual_sales) AS DECIMAL), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM annual_forecast") t := by
  intro t; first | sql_equiv | sorry

end Bench_sf_local277
