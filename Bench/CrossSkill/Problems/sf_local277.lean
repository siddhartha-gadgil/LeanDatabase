theorem eq_0_3 : ∀ t,
    (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base AS (SELECT \"product_id\", \"mth\", \"qty\", ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790)), cma AS (SELECT a.\"product_id\", a.t, a.\"qty\", CAST((CAST(SUM(CASE WHEN b.t BETWEEN a.t - 5 AND a.t + 6 THEN b.\"qty\" END) AS DOUBLE PRECISION) / 12.0 + CAST(SUM(CASE WHEN b.t BETWEEN a.t - 6 AND a.t + 5 THEN b.\"qty\" END) AS DOUBLE PRECISION) / 12.0) AS DOUBLE PRECISION) / 2.0 AS cma_value, ((a.t - 1) % 12) + 1 AS month_num FROM base AS a JOIN base AS b ON a.\"product_id\" = b.\"product_id\" WHERE a.t BETWEEN 7 AND 30 GROUP BY a.\"product_id\", a.t, a.\"qty\"), ratios AS (SELECT \"product_id\", t, \"qty\", cma_value, CAST(\"qty\" AS DOUBLE PRECISION) / NULLIF(cma_value, 0) AS ratio, month_num FROM cma), seasonal_indices AS (SELECT \"product_id\", month_num, AVG(ratio) AS seasonal_index FROM ratios GROUP BY \"product_id\", month_num), deseas AS (SELECT r.\"product_id\", r.t, r.cma_value, r.month_num, si.seasonal_index, CAST(r.\"qty\" AS DOUBLE PRECISION) / NULLIF(si.seasonal_index, 0) AS deseasonalized FROM ratios AS r JOIN seasonal_indices AS si ON r.\"product_id\" = si.\"product_id\" AND r.month_num = si.month_num), wls_regression AS (SELECT \"product_id\", SUM(cma_value) AS sum_w, SUM(cma_value * CAST(t AS DOUBLE PRECISION)) AS sum_wx, SUM(cma_value * CAST(t AS DOUBLE PRECISION) * CAST(t AS DOUBLE PRECISION)) AS sum_wx2, SUM(cma_value * deseasonalized) AS sum_wy, SUM(cma_value * CAST(t AS DOUBLE PRECISION) * deseasonalized) AS sum_wxy FROM deseas GROUP BY \"product_id\"), regression_coeffs AS (SELECT \"product_id\", CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0) AS slope, CAST((sum_wy - (CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0)) * sum_wx) AS DOUBLE PRECISION) / NULLIF