num), deseasonalized /* Deseasonalize all 36 months */ AS (SELECT b.\"product_id\", b.time_step, b.month_num, b.\"qty\", s.seasonal_index, CASE WHEN s.seasonal_index <> 0 THEN CAST(b.\"qty\" AS DOUBLE PRECISION) / s.seasonal_index ELSE NULL END AS deseas_qty FROM base_data AS b JOIN seasonal_indices AS s ON b.\"product_id\" = s.\"product_id\" AND b.month_num = s.month_num), regression_stats /* Weighted linear regression on deseasonalized data (all 36 months) */ /* Weights = time_step */ /* WLS: minimize sum(w_i * (y_i - a - b*x_i)^2) */ /* Normal equations: */ /* b = (sum(w*x*y) - sum(w*x)*sum(w*y)/sum(w)) / (sum(w*x^2) - (sum(w*x))^2/sum(w)) */ /* a = (sum(w*y) - b*sum(w*x)) / sum(w) */ AS (SELECT \"product_id\", SUM(time_step * deseas_qty * time_step) AS sum_wxy /* sum(w*x*y) where w=x=time_step */, SUM(time_step * time_step) AS sum_wx2 /* sum(w*x^2) */, SUM(time_step * time_step) AS sum_wx /* sum(w*x) -- wait, w=time_step, x=time_step */, SUM(time_step * deseas_qty) AS sum_wy /* sum(w*y) */, SUM(time_step) AS sum_w /* sum(w) */ FROM deseasonalized GROUP BY \"product_id\"), regression_stats2 /* Actually, let me redo this. w_i = time_step_i, x_i = time_step_i, y_i = deseas_qty_i */ /* sum_w = sum(w_i) = sum(time_step) */ /* sum_wx = sum(w_i * x_i) = sum(time_step^2) */ /* sum_wy = sum(w_i * y_i) = sum(time_step * deseas_qty) */ /* sum_wxy = sum(w_i * x_i * y_i) = sum(time_step^2 * deseas_qty) */ /* sum_wx2 = sum(w_i * x_i^2) = sum(time_step^3) */ AS (SELECT \"product_id\", SUM(CAST(time_step AS DOUBLE PRECISION)) AS sum_w, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx, SUM(CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * deseas_qty) AS sum_wxy, SUM(CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION) * CAST(time_step AS DOUBLE PRECISION)) AS sum_wx2 FROM deseasonalized GROUP BY \"product_id\"), regression_coeffs