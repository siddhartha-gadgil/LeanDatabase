    (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base AS (SELECT \"product_id\", \"mth\", \"qty\", ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790)), cma AS (SELECT a.\"product_id\", a.t, a.\"qty\", CAST((CAST(SUM(CASE WHEN b.t BETWEEN a.t - 5 AND a.t + 6 THEN b.\"qty\" END) AS DOUBLE PRECISION) / 12.0 + CAST(SUM(CASE WHEN b.t BETWEEN a.t - 6 AND a.t + 5 THEN b.\"qty\" END) AS DOUBLE PRECISION) / 12.0) AS DOUBLE PRECISION) / 2.0 AS cma_value, ((a.t - 1) % 12) + 1 AS month_num FROM base AS a JOIN base AS b ON a.\"product_id\" = b.\"product_id\" WHERE a.t BETWEEN 7 AND 30 GROUP BY a.\"product_id\", a.t, a.\"qty\"), ratios AS (SELECT \"product_id\", t, \"qty\", cma_value, CAST(\"qty\" AS DOUBLE PRECISION) / NULLIF(cma_value, 0) AS ratio, month_num FROM cma), seasonal_indices AS (SELECT \"product_id\", month_num, AVG(ratio) AS seasonal_index FROM ratios GROUP BY \"product_id\", month_num), deseas AS (SELECT r.\"product_id\", r.t, r.cma_value, r.month_num, si.seasonal_index, CAST(r.\"qty\" AS DOUBLE PRECISION) / NULLIF(si.seasonal_index, 0) AS deseasonalized FROM ratios AS r JOIN seasonal_indices AS si ON r.\"product_id\" = si.\"product_id\" AND r.month_num = si.month_num), wls_regression AS (SELECT \"product_id\", SUM(cma_value) AS sum_w, SUM(cma_value * CAST(t AS DOUBLE PRECISION)) AS sum_wx, SUM(cma_value * CAST(t AS DOUBLE PRECISION) * CAST(t AS DOUBLE PRECISION)) AS sum_wx2, SUM(cma_value * deseasonalized) AS sum_wy, SUM(cma_value * CAST(t AS DOUBLE PRECISION) * deseasonalized) AS sum_wxy FROM deseas GROUP BY \"product_id\"), regression_coeffs AS (SELECT \"product_id\", CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0) AS slope, CAST((sum_wy - (CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0)) * sum_wx) AS DOUBLE PRECISION) / NULLIF(sum_w, 0) AS intercept FROM wls_regression), forecast_2018 AS (SELECT rc.\"product_id\", si.month_num, (rc.intercept + rc.slope * (24.0 + si.month_num)) * si.seasonal_index AS forecasted_sales FROM regression_coeffs AS rc JOIN seasonal_indices AS si ON rc.\"product_id\" = si.\"product_id\") SELECT ROUND(CAST(AVG(annual_sales) AS DECIMAL), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM (SELECT \"product_id\", SUM(forecasted_sales) AS annual_sales FROM forecast_2018 GROUP BY \"product_id\")") t ~= (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base AS (SELECT \"product_id\", \"mth\", CAST(\"qty\" AS DOUBLE PRECISION) AS qty, ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t, CAST(SUBSTRING(\"mth\" FROM 6 FOR 2) AS INT) AS cal_month FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790)), cma_calc AS (SELECT b.\"product_id\", b.t, b.qty, b.cal_month, CAST(((SELECT SUM(b2.qty) FROM base AS b2 WHERE b2.\"product_id\" = b.\"product_id\" AND b2.t BETWEEN b.t - 5 AND b.t + 6) + (SELECT SUM(b2.qty) FROM base AS b2 WHERE b2.\"product_id\" = b.\"product_id\" AND b2.t BETWEEN b.t - 6 AND b.t + 5)) AS DOUBLE PRECISION) / 24.0 AS cma FROM base AS b WHERE b.t BETWEEN 7 AND 30), ratios AS (SELECT \"product_id\", t, qty, cal_month, cma, CAST(qty AS DOUBLE PRECISION) / NULLIF(cma, 0) AS ratio FROM cma_calc), seasonal AS (SELECT \"product_id\", cal_month, AVG(ratio) AS si FROM ratios GROUP BY \"product_id\", cal_month), deseasonalized AS (SELECT c.\"product_id\", c.t, c.qty, c.cal_month, s.si, c.cma, CASE WHEN s.si = 0 THEN 0.0 ELSE CAST(c.qty AS DOUBLE PRECISION) / s.si END AS deseas FROM cma_calc AS c JOIN seasonal AS s ON c.\"product_id\" = s.\"product_id\" AND c.cal_month = s.cal_month), wls_parts AS (SELECT \"product_id\", SUM(cma) AS S_w, SUM(cma * CAST(t AS DOUBLE PRECISION)) AS S_wx, SUM(cma * deseas) AS S_wy, SUM(cma * CAST(t AS DOUBLE PRECISION) * deseas) AS S_wxy, SUM(cma * CAST(t AS DOUBLE PRECISION) * CAST(t AS DOUBLE PRECISION)) AS S_wxx FROM deseasonalized GROUP BY \"product_id\"), regression AS (SELECT \"product_id\", CAST((S_w * S_wxy - S_wx * S_wy) AS DOUBLE PRECISION) / NULLIF(S_w * S_wxx - S_wx * S_wx, 0) AS slope, CAST((S_wy - (CAST((S_w * S_wxy - S_wx * S_wy) AS DOUBLE PRECISION) / NULLIF(S_w * S_wxx - S_wx * S_wx, 0)) * S_wx) AS DOUBLE PRECISION) / NULLIF(S_w, 0) AS intercept FROM wls_parts), forecast AS (SELECT b.\"product_id\", b.t, b.cal_month, s.si, (r.intercept + r.slope * CAST(b.t AS DOUBLE PRECISION)) * s.si AS forecasted_sales FROM base AS b JOIN seasonal AS s ON b.\"product_id\" = s.\"product_id\" AND b.cal_month = s.cal_month JOIN regression AS r ON b.\"product_id\" = r.\"product_id\" WHERE b.t BETWEEN 25 AND 36), annual AS (SELECT \"product_id\", SUM(forecasted_sales) AS annual_forecast FROM forecast GROUP BY \"product_id\") SELECT ROUND(CAST(AVG(annual_forecast) AS DECIMAL), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM annual") t := by
