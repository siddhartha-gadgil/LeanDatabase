import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq045 — crossskill equivalence(s)

Question: Which weather stations in Washington State recorded more than 150 rainy days in 2023 but fewer rainy days compared to 2022? Defining a “rainy day” as one having precipitation greater than zero millimeters and not equal to 99.99. Only include stations with valid precipitation data.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq045

CREATE TABLE STATIONS («usaf» STRING, «wban» STRING, «name» STRING, «country» STRING, «state» STRING, «call» STRING, «lat» FLOAT, «lon» FLOAT, «elev» STRING, «begin» STRING, «end» STRING)
CREATE TABLE GSOD2023 («stn» STRING, «wban» STRING, «date» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)
CREATE TABLE GSOD2022 («stn» STRING, «wban» STRING, «date» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([STATIONS_schema, GSOD2023_schema, GSOD2022_schema]) "WITH wa_2023 AS (\n  SELECT \n    g.\"stn\" AS STATION_ID,\n    g.\"wban\" AS WBAN_ID,\n    s.\"name\" AS STATION_NAME,\n    COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" != 99.99 THEN 1 END) AS RAINY_DAYS_2023\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"state\" = 'WA'\n  GROUP BY g.\"stn\", g.\"wban\", s.\"name\"\n  HAVING RAINY_DAYS_2023 > 150\n),\nwa_2022 AS (\n  SELECT \n    g.\"stn\" AS STATION_ID,\n    g.\"wban\" AS WBAN_ID,\n    COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" != 99.99 THEN 1 END) AS RAINY_DAYS_2022\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2022\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"state\" = 'WA'\n  GROUP BY g.\"stn\", g.\"wban\"\n)\nSELECT \n  t23.STATION_ID,\n  t23.STATION_NAME,\n  t23.RAINY_DAYS_2023,\n  t22.RAINY_DAYS_2022\nFROM wa_2023 t23\nJOIN wa_2022 t22 ON t23.STATION_ID = t22.STATION_ID AND t23.WBAN_ID = t22.WBAN_ID\nWHERE t23.RAINY_DAYS_2023 < t22.RAINY_DAYS_2022\nORDER BY t23.RAINY_DAYS_2023 DESC;") t ~= (sql%([STATIONS_schema, GSOD2023_schema, GSOD2022_schema]) "WITH rainy_2023 AS (\n  SELECT \n    g.\"stn\" AS STATION_ID,\n    g.\"wban\" AS WBAN,\n    s.\"name\" AS STATION_NAME,\n    COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" != 99.99 THEN 1 END) AS RAINY_DAYS_2023\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"state\" = 'WA'\n  GROUP BY g.\"stn\", g.\"wban\", s.\"name\"\n  HAVING COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" != 99.99 THEN 1 END) > 150\n),\nrainy_2022 AS (\n  SELECT \n    g.\"stn\" AS STATION_ID,\n    g.\"wban\" AS WBAN,\n    COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" != 99.99 THEN 1 END) AS RAINY_DAYS_2022\n  FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2022\" g\n  JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" s \n    ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\"\n  WHERE s.\"state\" = 'WA'\n  GROUP BY g.\"stn\", g.\"wban\"\n)\nSELECT \n  r23.STATION_ID,\n  r23.STATION_NAME,\n  r23.RAINY_DAYS_2023,\n  r22.RAINY_DAYS_2022\nFROM rainy_2023 r23\nJOIN rainy_2022 r22 \n  ON r23.STATION_ID = r22.STATION_ID AND r23.WBAN = r22.WBAN\nWHERE r23.RAINY_DAYS_2023 < r22.RAINY_DAYS_2022\nORDER BY r23.RAINY_DAYS_2023 DESC;") t := by
  intro t; first | sql_equiv | sorry

