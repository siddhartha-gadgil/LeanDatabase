in Q1095 that are also within the relation\nrelation_scores AS (\n  SELECT cr.\"osm_id\",\n         cr.relation_name,\n         COUNT(DISTINCT fq.\"osm_id\") AS feature_count,\n         COUNT(DISTINCT fw.\"osm_id\") AS wikidata_feature_count\n  FROM candidate_relations cr\n  JOIN features_in_q1095 fq\n    ON ST_DWITHIN(TO_GEOGRAPHY(fq.\"geometry\"), TO_GEOGRAPHY(cr.rel_geometry), 0)\n    AND fq.\"osm_id\" != cr.\"osm_id\"\n  LEFT JOIN features_with_wikidata fw\n    ON fq.\"osm_id\" = fw.\"osm_id\"\n  GROUP BY cr.\"osm_id\", cr.relation_name\n)\n\nSELECT relation_name AS name\nFROM relation_scores\nWHERE wikidata_feature_count >= 1\nORDER BY feature_count DESC\nLIMIT 1;") t ~= (sql%([PLANET_FEATURES_schema]) "WITH q1095_geom AS (\n    -- Get the geometry of the multipolygon tagged with wikidata Q1095\n    SELECT TO_GEOGRAPHY(\"geometry\") AS geog\n    FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" pf,\n         LATERAL FLATTEN(input => pf.\"all_tags\") t\n    WHERE pf.\"feature_type\" = 'multipolygons'\n      AND t.value:\"key\"::STRING = 'wikidata'\n      AND t.value:\"value\"::STRING = 'Q1095'\n    LIMIT 1\n),\n-- Find multipolygon relations intersecting Q1095 area that have a name but no wikidata tag\ncandidate_relations AS (\n    SELECT \n        pf.\"osm_id\",\n        pf.\"geometry\",\n        MAX(CASE WHEN t.value:\"key\"::STRING = 'name' THEN t.value:\"value\"::STRING END) AS rel_name\n    FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" pf,\n         LATERAL FLATTEN(input => pf.\"all_tags\") t,\n         q1095_geom q\n    WHERE pf.\"feature_type\" = 'multipolygons'\n      AND pf.\"osm_id\" != 53142\n      AND ST_INTERSECTS(TO_GEOGRAPHY(pf.\"geometry\"), q.geog)\n    GROUP BY pf.\"osm_id\", pf.\"geometry\"\n    HAVING rel_name IS NOT NULL\n       AND MAX(CASE WHEN t.value:\"key\"::STRING = 'wikidata' THEN 1 ELSE 0 END) = 0\n),\n-- Get all features within Q1095 with wikidata flag\nfeatures_in_q1095 AS (\n    SELECT \n        f.\"osm_id\", \n        f.\"feature_type\", \n        f.\"geometry\",\n        MAX(CASE WHEN t.value:\"key\"::STRING = 'wikidata' THEN 1 ELSE 0 END) AS has_wikidata\n    FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" f,\n         LATERAL FLATTEN(input => f.\"all_tags\") t,\n         q1095_geom q\n    WHERE ST_DWITHIN(TO_GEOGRAPHY(f.\"geometry\"), q.geog, 0)\n      AND f.\"osm_id\" != 53142\n    GROUP BY f.\"osm_id\", f.\"feature_type\", f.\"geometry\"\n),\n-- Count features within each candidate relation's geometry that are also in Q1095\nfeature_counts AS (\n    SELECT\n        cr.\"osm_id\" AS rel_osm_id,\n        cr.rel_name,\n        COUNT(DISTINCT CONCAT(fi.\"feature_type\", ':', fi.\"osm_id\"::STRING)) AS feature_count,\n        SUM(fi.has_wikidata) AS wikidata_feature_count\n    FROM candidate_relations cr\n    JOIN features_in_q1095 fi\n        ON ST_DWITHIN(TO_GEOGRAPHY(fi.\"geometry\"), TO_GEOGRAPHY(cr.\"geometry\"), 0)\n    GROUP BY cr.\"osm_id\", cr.rel_name\n    HAVING wikidata_feature_count > 0\n)\nSELECT rel_name AS \"NAME\"\nFROM feature_counts\nORDER BY feature_count DESC\nLIMIT 1;") t := by
