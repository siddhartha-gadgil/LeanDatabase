/-!
# sf_bq253 — crossskill equivalence(s)

Question: Find the name of the OpenStreetMap relation that encompasses the most features within the same geographic area as the multipolygon tagged with the Wikidata item 'Q1095'. The relation should have a specified name and no 'wikidata' tag, and at least one of its included features must have a 'wikidata' tag. The analysis should be conducted using the planet_features table. Return the name of this relation.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq253

CREATE TABLE PLANET_FEATURES («feature_type» STRING, «osm_id» INT, «osm_way_id» INT, «osm_version» INT, «osm_timestamp» INT, «all_tags» STRING, «geometry» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([PLANET_FEATURES_schema]) "-- Step 1: Get Q1095 geometry\nWITH q1095 AS (\n  SELECT TO_GEOGRAPHY(p.\"geometry\") AS geom\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" p,\n       LATERAL FLATTEN(INPUT => p.\"all_tags\") f\n  WHERE p.\"feature_type\" = 'multipolygons'\n    AND f.value:\"key\"::STRING = 'wikidata'\n    AND f.value:\"value\"::STRING = 'Q1095'\n  LIMIT 1\n),\n\n-- Step 2: All features within Q1095 area\nfeatures_in_q1095 AS (\n  SELECT feat.\"osm_id\",\n         feat.\"feature_type\",\n         feat.\"geometry\"\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" feat,\n       q1095 q\n  WHERE ST_DWITHIN(TO_GEOGRAPHY(feat.\"geometry\"), q.geom, 0)\n),\n\n-- Step 3: Which features in Q1095 have a wikidata tag?\nfeatures_with_wikidata AS (\n  SELECT DISTINCT fq.\"osm_id\"\n  FROM features_in_q1095 fq\n  JOIN \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" p\n    ON fq.\"osm_id\" = p.\"osm_id\"\n       AND fq.\"feature_type\" = p.\"feature_type\",\n       LATERAL FLATTEN(INPUT => p.\"all_tags\") f\n  WHERE f.value:\"key\"::STRING = 'wikidata'\n),\n\n-- Step 4: Candidate relations - only multipolygons (can encompass/contain features)\n-- Must have name, no wikidata tag\ncandidate_relations AS (\n  SELECT fq.\"osm_id\",\n         fq.\"geometry\" AS rel_geometry,\n         MAX(CASE WHEN f.value:\"key\"::STRING = 'name' THEN f.value:\"value\"::STRING END) AS relation_name\n  FROM features_in_q1095 fq\n  JOIN \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" p\n    ON fq.\"osm_id\" = p.\"osm_id\"\n       AND fq.\"feature_type\" = p.\"feature_type\",\n       LATERAL FLATTEN(INPUT => p.\"all_tags\") f\n  WHERE fq.\"feature_type\" = 'multipolygons'\n  GROUP BY fq.\"osm_id\", fq.\"geometry\"\n  HAVING relation_name IS NOT NULL\n    AND MAX(CASE WHEN f.value:\"key\"::STRING = 'wikidata' THEN f.value:\"value\"::STRING END) IS NULL\n),\n\n-- Step 5: For each candidate, count features in Q1095 that are also within the relation\nrelation_scores AS (\n  SELECT cr.\"osm_id\",\n         cr.relation_name,\n         COUNT(DISTINCT fq.\"osm_id\") AS feature_count,\n         COUNT(DISTINCT fw.\"osm_id\") AS wikidata_feature_count\n  FROM candidate_relations cr\n  JOIN features_in_q1095 fq\n    ON ST_DWITHIN(TO_GEOGRAPHY(fq.\"geometry\"), TO_GEOGRAPHY(cr.rel_geometry), 0)\n    AND fq.\"osm_id\" != cr.\"osm_id\"\n  LEFT JOIN features_with_wikidata fw\n    ON fq.\"osm_id\" = fw.\"osm_id\"\n  GROUP BY cr.\"osm_id\", cr.relation_name\n)\n\nSELECT relation_name AS name\nFROM relation_scores\nWHERE wikidata_feature_count >= 1\nORDER BY feature_count DESC\nLIMIT 1;") t ~= (sql%([PLANET_FEATURES_schema]) "-- Step 1: Get Q1095 geometry\n-- Step 2: Find all features in Q1095 area \n-- Step 3: Identify candidate relations (name, no wikidata) among them\n-- Step 4: For each candidate, count nearby features and check wikidata presence\n-- Step 5: Return the name of the one with the most features\n\nWITH q1095 AS (\n  SELECT p.\"osm_id\" AS q_osm_id, TO_GEOGRAPHY(p.\"geometry\") AS geo\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" p,\n    LATERAL FLATTEN(input => p.\"all_tags\") f\n  WHERE p.\"feature_type\" = 'multipolygons'\n    AND f.value:key::STRING = 'wikidata'\n    AND f.value:value::STRING = 'Q1095'\n),\n-- All features in Q1095 area with their geometry stored as text for joining\nfeatures_in_area AS (\n  SELECT feat.\"feature_type\", feat.\"osm_id\", feat.\"all_tags\", feat.\"geometry\"\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" feat, q1095\n  WHERE ST_DWITHIN(TO_GEOGRAPHY(feat.\"geometry\"), q1095.geo, 0)\n),\n-- Candidate relations: have name tag, no wikidata tag\ncandidate_relations AS (\n  SELECT \n    fia.\"feature_type\",\n    fia.\"osm_id\",\n    fia.\"geometry\",\n    MAX(CASE WHEN f.value:key::STRING = 'name' THEN f.value:value::STRING END) AS name,\n    MAX(CASE WHEN f.value:key::STRING = 'wikidata' THEN f.value:value::STRING END) AS wikidata\n  FROM features_in_area fia,\n    LATERAL FLATTEN(input => fia.\"all_tags\") f\n  WHERE fia.\"feature_type\" IN ('multipolygons', 'other_relations')\n    AND fia.\"osm_id\" != (SELECT q_osm_id FROM q1095)\n  GROUP BY fia.\"feature_type\", fia.\"osm_id\", fia.\"geometry\"\n  HAVING name IS NOT NULL AND wikidata IS NULL\n),\n-- For each feature in area, flag if it has wikidata\nfeatures_wikidata AS (\n  SELECT \n    fia.\"feature_type\",\n    fia.\"osm_id\",\n    fia.\"geometry\",\n    MAX(CASE WHEN f.value:key::STRING = 'wikidata' THEN 1 ELSE 0 END) AS has_wikidata\n  FROM features_in_area fia,\n    LATERAL FLATTEN(input => fia.\"all_tags\") f\n  GROUP BY fia.\"feature_type\", fia.\"osm_id\", fia.\"geometry\"\n),\n-- Join candidates to features and count\nrelation_stats AS (\n  SELECT \n    cr.\"osm_id\" AS cr_id,\n    cr.name,\n    COUNT(*) AS feature_count,\n    SUM(fw.has_wikidata) AS wikidata_features\n  FROM candidate_relations cr\n  JOIN features_wikidata fw\n    ON ST_DWITHIN(TO_GEOGRAPHY(fw.\"geometry\"), TO_GEOGRAPHY(cr.\"geometry\"), 0)\n    AND NOT (fw.\"osm_id\" = cr.\"osm_id\" AND fw.\"feature_type\" = cr.\"feature_type\")\n  GROUP BY cr.\"osm_id\", cr.name\n  HAVING wikidata_features > 0\n)\nSELECT name\nFROM relation_stats\nORDER BY feature_count DESC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

