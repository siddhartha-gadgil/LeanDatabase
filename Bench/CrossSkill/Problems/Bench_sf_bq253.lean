.value, 'key') AS TEXT) = 'wikidata' THEN 1 ELSE 0 END) = 0), features_in_q1095 /* Get all features within Q1095 with wikidata flag */ AS (SELECT f.\"osm_id\", f.\"feature_type\", f.\"geometry\", MAX(CASE WHEN CAST(JSON_EXTRACT_PATH(t.value, 'key') AS TEXT) = 'wikidata' THEN 1 ELSE 0 END) AS has_wikidata FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS f, LATERAL UNNEST(input => f.\"all_tags\") AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS), q1095_geom AS q WHERE ST_DWITHIN(CAST(f.\"geometry\" AS GEOGRAPHY), q.geog, 0) AND f.\"osm_id\" <> 53142 GROUP BY f.\"osm_id\", f.\"feature_type\", f.\"geometry\"), feature_counts /* Count features within each candidate relation's geometry that are also in Q1095 */ AS (SELECT cr.\"osm_id\" AS rel_osm_id, cr.rel_name, COUNT(DISTINCT fi.\"feature_type\" || ':' || CAST(fi.\"osm_id\" AS TEXT)) AS feature_count, SUM(fi.has_wikidata) AS wikidata_feature_count FROM candidate_relations AS cr JOIN features_in_q1095 AS fi ON ST_DWITHIN(CAST(fi.\"geometry\" AS GEOGRAPHY), CAST(cr.\"geometry\" AS GEOGRAPHY), 0) GROUP BY cr.\"osm_id\", cr.rel_name HAVING wikidata_feature_count > 0) SELECT rel_name AS \"NAME\" FROM feature_counts ORDER BY feature_count DESC LIMIT 1") t := by
