/-!
# sf_bq253 — crossskill equivalence(s)

Question: Find the name of the OpenStreetMap relation that encompasses the most features within the same geographic area as the multipolygon tagged with the Wikidata item 'Q1095'. The relation should have a specified name and no 'wikidata' tag, and at least one of its included features must have a 'wikidata' tag. The analysis should be conducted using the planet_features table. Return the name of this relation.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq253

CREATE TABLE PLANET_FEATURES («feature_type» STRING, «osm_id» INT, «osm_way_id» INT, «osm_version» INT, «osm_timestamp» INT, «all_tags» STRING, «geometry» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([PLANET_FEATURES_schema]) "/* Step 1: Get Q1095 geometry */ WITH q1095 AS (SELECT CAST(p.\"geometry\" AS GEOGRAPHY) AS geom FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS p, LATERAL UNNEST(INPUT => p.\"all_tags\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE p.\"feature_type\" = 'multipolygons' AND CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'wikidata' AND CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) = 'Q1095' LIMIT 1), features_in_q1095 /* Step 2: All features within Q1095 area */ AS (SELECT feat.\"osm_id\", feat.\"feature_type\", feat.\"geometry\" FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS feat, q1095 AS q WHERE ST_DWITHIN(CAST(feat.\"geometry\" AS GEOGRAPHY), q.geom, 0)), features_with_wikidata /* Step 3: Which features in Q1095 have a wikidata tag? */ AS (SELECT DISTINCT fq.\"osm_id\" FROM features_in_q1095 AS fq JOIN \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS p ON fq.\"osm_id\" = p.\"osm_id\" AND fq.\"feature_type\" = p.\"feature_type\", LATERAL UNNEST(INPUT => p.\"all_tags\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'wikidata'), candidate_relations /* Step 4: Candidate relations - only multipolygons (can encompass/contain features) */ /* Must have name, no wikidata tag */ AS (SELECT fq.\"osm_id\", fq.\"geometry\" AS rel_geometry, MAX(CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'name' THEN CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) END) AS relation_name FROM features_in_q1095 AS fq JOIN \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS p ON fq.\"osm_id\" = p.\"osm_id\" AND fq.\"feature_type\" = p.\"feature_type\", LATERAL UNNEST(INPUT => p.\"all_tags\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE fq.\"feature_type\" = 'multipolygons' GROUP BY fq.\"osm_id\", fq.\"geometry\" HAVING NOT relation_name IS NULL AND MAX(CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'wikidata' THEN CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) END) IS NULL), relation_scores /* Step 5: For each candidate, count features in Q1095 that are also within the relation */ AS (SELECT cr.\"osm_id\", cr.relation_name, COUNT(DISTINCT fq.\"osm_id\") AS feature_count, COUNT(DISTINCT fw.\"osm_id\") AS wikidata_feature_count FROM candidate_relations AS cr JOIN features_in_q1095 AS fq ON ST_DWITHIN(CAST(fq.\"geometry\" AS GEOGRAPHY), CAST(cr.rel_geometry AS GEOGRAPHY), 0) AND fq.\"osm_id\" <> cr.\"osm_id\" LEFT JOIN features_with_wikidata AS fw ON fq.\"osm_id\" = fw.\"osm_id\" GROUP BY cr.\"osm_id\", cr.relation_name) SELECT relation_name AS name FROM relation_scores WHERE wikidata_feature_count >= 1 ORDER BY feature_count DESC LIMIT 1") t ~= (sql%([PLANET_FEATURES_schema]) "/* Step 1: Get Q1095 geometry */ /* Step 2: Find all features in Q1095 area */ /* Step 3: Identify candidate relations (name, no wikidata) among them */ /* Step 4: For each candidate, count nearby features and check wikidata presence */ /* Step 5: Return the name of the one with the most features */ WITH q1095 AS (SELECT p.\"osm_id\" AS q_osm_id, CAST(p.\"geometry\" AS GEOGRAPHY) AS geo FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS p, LATERAL UNNEST(input => p.\"all_tags\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE p.\"feature_type\" = 'multipolygons' AND CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'wikidata' AND CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) = 'Q1095'), features_in_area /* All features in Q1095 area with their geometry stored as text for joining */ AS (SELECT feat.\"feature_type\", feat.\"osm_id\", feat.\"all_tags\", feat.\"geometry\" FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS feat, q1095 WHERE ST_DWITHIN(CAST(feat.\"geometry\" AS GEOGRAPHY), q1095.geo, 0)), candidate_relations /* Candidate relations: have name tag, no wikidata tag */ AS (SELECT fia.\"feature_type\", fia.\"osm_id\", fia.\"geometry\", MAX(CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'name' THEN CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) END) AS name, MAX(CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'wikidata' THEN CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) END) AS wikidata FROM features_in_area AS fia, LATERAL UNNEST(input => fia.\"all_tags\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE fia.\"feature_type\" IN ('multipolygons', 'other_relations') AND fia.\"osm_id\" <> (SELECT q_osm_id FROM q1095) GROUP BY fia.\"feature_type\", fia.\"osm_id\", fia.\"geometry\" HAVING NOT name IS NULL AND wikidata IS NULL), features_wikidata /* For each feature in area, flag if it has wikidata */ AS (SELECT fia.\"feature_type\", fia.\"osm_id\", fia.\"geometry\", MAX(CASE WHEN CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'wikidata' THEN 1 ELSE 0 END) AS has_wikidata FROM features_in_area AS fia, LATERAL UNNEST(input => fia.\"all_tags\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY fia.\"feature_type\", fia.\"osm_id\", fia.\"geometry\"), relation_stats /* Join candidates to features and count */ AS (SELECT cr.\"osm_id\" AS cr_id, cr.name, COUNT(*) AS feature_count, SUM(fw.has_wikidata) AS wikidata_features FROM candidate_relations AS cr JOIN features_wikidata AS fw ON ST_DWITHIN(CAST(fw.\"geometry\" AS GEOGRAPHY), CAST(cr.\"geometry\" AS GEOGRAPHY), 0) AND NOT (fw.\"osm_id\" = cr.\"osm_id\" AND fw.\"feature_type\" = cr.\"feature_type\") GROUP BY cr.\"osm_id\", cr.name HAVING wikidata_features > 0) SELECT name FROM relation_stats ORDER BY feature_count DESC LIMIT 1") t := by
  intro t; first | sql_equiv | sorry

