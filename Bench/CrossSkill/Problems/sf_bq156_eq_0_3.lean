D N_n >= 10 AND var_y > 0 AND var_n > 0 THEN ROUND(CAST(CAST((g_y - g_n) AS DOUBLE PRECISION) / SQRT(CAST(var_y AS DOUBLE PRECISION) / N_y + CAST(var_n AS DOUBLE PRECISION) / N_n) AS DECIMAL), 2) ELSE NULL END AS TSCORE FROM t_calc") t0 t1
