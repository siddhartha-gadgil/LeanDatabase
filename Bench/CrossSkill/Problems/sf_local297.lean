/-!
# sf_local297 — crossskill equivalence(s)

Question: For each customer, group all deposits and withdrawals by the first day of each month to obtain a monthly net amount, then calculate each month’s closing balance by cumulatively summing these monthly nets. Next, determine the most recent month’s growth rate by comparing its closing balance to the prior month’s balance, treating deposits as positive and withdrawals as negative, and if the previous month’s balance is zero, the growth rate should be the current month’s balance multiplied by 100. Finally, compute the percentage of customers whose most recent month shows a growth rate of more than 5%.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local297

CREATE TABLE CUSTOMER_TRANSACTIONS («customer_id» INT, «txn_date» STRING, «txn_type» STRING, «txn_amount» INT)

HYPOTHESIS hyp0_1_0 : CUSTOMER_TRANSACTIONS "DATE_TRUNC('MONTH', CAST(TO_TIMESTAMP(\"txn_date\", 'YYYY-MM-DD') AS DATE)) = CAST(DATE_TRUNC('MONTH', CAST(\"txn_date\" AS DATE)) AS DATE)"
theorem eq_0_1 (t : TableRel CUSTOMER_TRANSACTIONS_schema) (h0 : hyp0_1_0 t) :
    (sql%([CUSTOMER_TRANSACTIONS_schema]) "WITH monthly_net AS (SELECT \"customer_id\", DATE_TRUNC('MONTH', CAST(TO_TIMESTAMP(\"txn_date\", 'YYYY-MM-DD') AS DATE)) AS month_start, SUM(CASE WHEN \"txn_type\" = 'deposit' THEN \"txn_amount\" WHEN \"txn_type\" = 'withdrawal' THEN -\"txn_amount\" ELSE 0 END) AS net_amount FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\" GROUP BY \"customer_id\", month_start), closing_balance AS (SELECT \"customer_id\", month_start, SUM(net_amount) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS closing_bal FROM monthly_net), with_prev AS (SELECT \"customer_id\", month_start, closing_bal, LAG(closing_bal) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS prev_closing_bal, ROW_NUMBER() OVER (PARTITION BY \"customer_id\" ORDER BY month_start DESC) AS rn_desc FROM closing_balance), most_recent AS (SELECT \"customer_id\", closing_bal, prev_closing_bal, CASE WHEN prev_closing_bal = 0 THEN closing_bal * 100 ELSE CAST((closing_bal - prev_closing_bal) AS DOUBLE PRECISION) / prev_closing_bal * 100 END AS growth_rate FROM with_prev WHERE rn_desc = 1 AND NOT prev_closing_bal IS NULL) SELECT CAST(100.0 * SUM(CASE WHEN growth_rate > 5 THEN 1 ELSE 0 END) AS DOUBLE PRECISION) / COUNT(*) AS PCT_CUSTOMERS_GROWTH_GT_5 FROM most_recent") t = (sql%([CUSTOMER_TRANSACTIONS_schema]) "WITH monthly_net AS (SELECT \"customer_id\", CAST(DATE_TRUNC('MONTH', CAST(\"txn_date\" AS DATE)) AS DATE) AS month_start, SUM(CASE WHEN \"txn_type\" = 'deposit' THEN \"txn_amount\" WHEN \"txn_type\" = 'withdrawal' THEN -\"txn_amount\" ELSE 0 END) AS net_amount FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\" GROUP BY \"customer_id\", month_start), closing_balance AS (SELECT \"customer_id\", month_start, SUM(net_amount) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS closing_bal FROM monthly_net), with_lag AS (SELECT \"customer_id\", month_start, closing_bal, LAG(closing_bal) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS prev_bal, ROW_NUMBER() OVER (PARTITION BY \"customer_id\" ORDER BY month_start DESC) AS rn FROM closing_balance), most_recent AS (SELECT \"customer_id\", month_start, closing_bal, prev_bal, CASE WHEN prev_bal = 0 THEN closing_bal * 100 ELSE CAST((closing_bal - prev_bal) AS DOUBLE PRECISION) / prev_bal * 100 END AS growth_rate FROM with_lag WHERE rn = 1 AND NOT prev_bal IS NULL) SELECT ROUND(CAST(CAST(100.0 * SUM(CASE WHEN growth_rate > 5 THEN 1 ELSE 0 END) AS DOUBLE PRECISION) / COUNT(*) AS DECIMAL), 2) AS \"PCT_CUSTOMERS_GROWTH_GT_5\" FROM most_recent") t := by
