TE(\"insert_date\", 'YYYY-MM-DD')) IN (4, 5, 6)\n      AND YEAR(TO_DATE(\"insert_date\", 'YYYY-MM-DD')) BETWEEN 2021 AND 2023\n    GROUP BY \"YEAR\", month_num, \"MONTH_NAME\"\n),\nwith_running AS (\n    SELECT\n        \"YEAR\",\n        month_num,\n        \"MONTH_NAME\",\n        \"CITIES_INSERTED\",\n        SUM(\"CITIES_INSERTED\") OVER (\n            PARTITION BY month_num\n            ORDER BY \"YEAR\"\n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        ) AS \"RUNNING_TOTAL\"\n    FROM monthly_counts\n),\nwith_lags AS (\n    SELECT\n        \"YEAR\",\n        month_num,\n        \"MONTH_NAME\",\n        \"CITIES_INSERTED\",\n        \"RUNNING_TOTAL\",\n        LAG(\"CITIES_INSERTED\") OVER (\n            PARTITION BY month_num ORDER BY \"YEAR\"\n        ) AS prev_year_count,\n        LAG(\"RUNNING_TOTAL\") OVER (\n            PARTITION BY month_num ORDER BY \"YEAR\"\n        ) AS prev_year_running_total\n    FROM with_running\n)\nSELECT\n    \"YEAR\",\n    \"MONTH_NAME\",\n    \"CITIES_INSERTED\",\n    \"RUNNING_TOTAL\",\n    (\"CITIES_INSERTED\" - prev_year_count) * 100.0 / prev_year_count AS \"YEAR_OVER_YEAR\",\n    (\"RUNNING_TOTAL\" - prev_year_running_total) * 100.0 / prev_year_running_total AS \"TOTAL_YEAR_OVER_YEAR\"\nFROM with_lags\nWHERE prev_year_count IS NOT NULL\nORDER BY \"YEAR\", month_num;") t := by
