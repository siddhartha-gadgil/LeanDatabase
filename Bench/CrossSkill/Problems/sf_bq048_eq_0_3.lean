theorem eq (t0 : TableRel _311_SERVICE_REQUESTS_schema) (t1 : TableRel GSOD2019_schema) (t2 : TableRel GSOD2013_schema) (t3 : TableRel GSOD2011_schema) (t4 : TableRel GSOD2015_schema) (t5 : TableRel GSOD2012_schema) (t6 : TableRel GSOD2020_schema) (t7 : TableRel GSOD2014_schema) (t8 : TableRel GSOD2016_schema) (t9 : TableRel GSOD2017_schema) (t10 : TableRel GSOD2018_schema) :
    (sql%([_311_SERVICE_REQUESTS_schema, GSOD2019_schema, GSOD2013_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2020_schema, GSOD2014_schema, GSOD2016_schema, GSOD2017_schema, GSOD2018_schema]) "WITH wind_data AS (SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE) AS dt, CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2018\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2019\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2020\" WHERE \"stn\" = '744860'), complaints_raw AS (SELECT CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) AS dt, \"complaint_type\" FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\" WHERE CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) BETWEEN '2011-01-01' AND '2020-12-31'), qualifying_types /* Filter to complaint types with > 3000 total requests */ AS (SELECT \"complaint_type\" FROM complaints_raw GROUP BY \"complaint_type\" HAVING COUNT(*) > 3000), daily_totals /* Daily total complaints */ AS (SELECT dt, COUNT(*) AS total_complaints FROM complaints_raw GROUP BY dt), daily_type_counts /* Daily complaint counts per qualifying type */ AS (SELECT c.dt, c.\"complaint_type\", COUNT(*) AS type_count FROM complaints_raw AS c INNER JOIN qualifying_types AS q ON c.\"complaint_type\" = q.\"complaint_type\" GROUP BY c.dt, c.\"complaint_type\"), daily_proportions /* Daily complaint proportions */ AS (SELECT dtc.dt, dtc.\"complaint_type\", CAST(dtc.type_count AS DOUBLE PRECISION) / CAST(dt.total_complaints AS DOUBLE PRECISION) AS proportion FROM daily_type_counts AS dtc INNER JOIN daily_totals AS dt ON dtc.dt = dt.dt), correlations /* Join with wind data and compute correlations */ AS (SELECT dp.\"complaint_type\", ROUND(CORR(dp.proportion, w.wdsp), 4) AS CORRELATION FROM daily_proportions AS dp INNER JOIN wind_data AS w ON dp.dt = w.dt GROUP BY dp.\"complaint_type\") /* Get the strongest positive and negative correlations */ SELECT \"complaint_type\", CORRELATION FROM (SELECT \"complaint_type\", CORRELATION FROM correlations ORDER BY CORRELATION DESC LIMIT 1) UNION ALL SELECT \"complaint_type\", CORRELATION FROM (SELECT \"complaint_type\", CORRELATION FROM correlations ORDER BY CORRELATION ASC LIMIT 1)") t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 t10
  ~= (sql%([_311_SERVICE_REQUESTS_schema, GSOD2019_schema, GSOD2013_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2020_schema, GSOD2014_schema, GSOD2016_schema, GSOD2017_schema, GSOD2018_schema]) "WITH gsod_all AS (SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2018\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2019\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9' UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS DOUBLE PRECISION) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2020\" WHERE \"stn\" = '744860' AND \"wdsp\" <> '999.9'), weather AS (SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE) AS dt, AVG(wdsp) AS avg_wdsp FROM gsod_all GROUP BY dt), complaints_raw AS (SELECT CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) AS dt, \"complaint_type\" FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\" WHERE TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) >= '2011-01-01' AND TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) < '2021-01-01'), daily_total AS (SELECT dt, COUNT(*) AS total_complaints FROM complaints_raw GROUP BY dt), daily_type AS (SELECT dt, \"complaint_type\", COUNT(*) AS type_complaints FROM complaints_raw GROUP BY dt, \"complaint_type\"), complaint_types_filtered AS (SELECT \"complaint_type\" FROM complaints_raw GROUP BY \"complaint_type\" HAVING COUNT(*) > 3000), daily_proportions AS (SELECT dt2.\"complaint_type\", dt2.dt, CAST(dt2.type_complaints AS DOUBLE PRECISION) / CAST(dtot.total_complaints AS DOUBLE PRECISION) AS proportion FROM daily_type AS dt2 JOIN daily_total AS dtot ON dt2.dt = dtot.dt WHERE dt2.\"complaint_type\" IN (SELECT \"complaint_type\" FROM complaint_types_filtered)), corr_data AS (SELECT dp.\"complaint_type\", CORR(w.avg_wdsp, dp.proportion) AS correlation FROM daily_proportions AS dp JOIN weather AS w ON dp.dt = w.dt GROUP BY dp.\"complaint_type\"), ranked AS (SELECT \"complaint_type\", ROUND(correlation, 4) AS CORRELATION, ROW_NUMBER() OVER (ORDER BY correlation DESC) AS rn_pos, ROW_NUMBER() OVER (ORDER BY correlation ASC) AS rn_neg FROM corr_data) SELECT \"complaint_type\", CORRELATION FROM ranked WHERE rn_pos = 1 OR rn_neg = 1 ORDER BY CORRELATION DESC") t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 t10
