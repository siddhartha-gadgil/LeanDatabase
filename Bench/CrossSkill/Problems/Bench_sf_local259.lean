theorem eq_2_3 : ∀ t,
    (sql%([PLAYER_MATCH_schema, PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, MATCH_schema]) "WITH batting_per_match AS (\n    SELECT \n        b.\"striker\" AS player_id,\n        b.\"match_id\",\n        SUM(bs.\"runs_scored\") AS match_runs,\n        COUNT(*) AS balls_faced\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n      ON bs.\"match_id\" = b.\"match_id\" \n     AND bs.\"over_id\" = b.\"over_id\" \n     AND bs.\"ball_id\" = b.\"ball_id\" \n     AND bs.\"innings_no\" = b.\"innings_no\"\n    GROUP BY b.\"striker\", b.\"match_id\"\n),\nbatting_agg AS (\n    SELECT \n        player_id,\n        SUM(match_runs) AS total_runs,\n        SUM(balls_faced) AS total_balls_faced,\n        MAX(match_runs) AS highest_score,\n        SUM(CASE WHEN match_runs >= 30 THEN 1 ELSE 0 END) AS matches_30_plus,\n        SUM(CASE WHEN match_runs >= 50 THEN 1 ELSE 0 END) AS matches_50_plus,\n        SUM(CASE WHEN match_runs >= 100 THEN 1 ELSE 0 END) AS matches_100_plus\n    FROM batting_per_match\n    GROUP BY player_id\n),\ndismissals AS (\n    SELECT \n        \"player_out\" AS player_id,\n        COUNT(*) AS total_times_dismissed\n    FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\"\n    GROUP BY \"player_out\"\n),\nmatches_played AS (\n    SELECT \n        \"player_id\" AS player_id,\n        COUNT(DISTINCT \"match_id\") AS total_matches_played\n    FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\"\n    GROUP BY \"player_id\"\n),\nmost_freq_role AS (\n    SELECT player_id, role AS most_frequent_role\n    FROM (\n        SELECT \n            \"player_id\" AS player_id,\n            \"role\" AS role,\n            COUNT(*) AS cnt,\n            ROW_NUMBER() OVER (PARTITION BY \"player_id\" ORDER BY COUNT(*) DESC, \"role\") AS rn\n        FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\"\n        GROUP BY \"player_id\", \"role\"\n    )\n    WHERE rn = 1\n),\nbowling_wickets AS (\n    SELECT \n        b.\"bowler\" AS player_id,\n        COUNT(*) AS total_wickets_taken\n    FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n    JOIN \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n      ON w.\"match_id\" = b.\"match_id\" \n     AND w.\"over_id\" = b.\"over_id\" \n     AND w.\"ball_id\" = b.\"ball_id\" \n     AND w.\"innings_no\" = b.\"innings_no\"\n    WHERE w.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n    GROUP BY b.\"bowler\"\n),\nbowling_economy AS (\n    SELECT \n        b.\"bowler\" AS player_id,\n        ROUND(SUM(bs.\"runs_scored\")::FLOAT * 6 / COUNT(*), 6) AS economy_rate\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n      ON bs.\"match_id\" = b.\"match_id\" \n     AND bs.\"over_id\" = b.\"over_id\" \n     AND bs.\"ball_id\" = b.\"ball_id\" \n     AND bs.\"innings_no\" = b.\"innings_no\"\n    GROUP BY b.\"bowler\"\n),\nbowling_wickets_per_match AS (\n    SELECT \n        b.\"bowler\" AS player_id,\n        b.\"match_id\",\n        COUNT(CASE WHEN w.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field') THEN 1 END) AS wickets\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    LEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n      ON w.\"match_id\" = b.\"match_id\" \n     AND w.\"over_id\" = b.\"over_id\" \n     AND w.\"ball_id\" = b.\"ball_id\" \n     AND w.\"innings_no\" = b.\"innings_no\"\n    GROUP BY b.\"bowler\", b.\"match_id\"\n),\nbowling_runs_per_match AS (\n    SELECT \n        b.\"bowler\" AS player_id,\n        b.\"match_id\",\n        SUM(bs.\"runs_scored\") AS runs_conceded\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n      ON bs.\"match_id\" = b.\"match_id\" \n     AND bs.\"over_id\" = b.\"over_id\" \n     AND bs.\"ball_id\" = b.\"ball_id\" \n     AND bs.\"innings_no\" = b.\"innings_no\"\n    GROUP BY b.\"bowler\", b.\"match_id\"\n),\nbest_bowling AS (\n    SELECT player_id, wickets || '-' || runs_conceded AS best_bowling_performance\n    FROM (\n        SELECT \n            wpm.player_id,\n            wpm.wickets,\n            rpm.runs_conceded,\n            ROW_NUMBER() OVER (PARTITION BY wpm.player_id ORDER BY wpm.wickets DESC, rpm.runs_conceded ASC) AS rn\n        FROM bowling_wickets_per_match wpm\n        JOIN bowling_runs_per_match rpm \n          ON wpm.player_id = rpm.player_id AND wpm.\"match_id\" = rpm.\"match_id\"\n    )\n    WHERE rn = 1\n)\nSELECT \n    p.\"player_id\",\n    p.\"player_name\",\n    COALESCE(mfr.most_frequent_role, NULL) AS most_frequent_role,\n    p.\"batting_hand\",\n    p.\"bowling_skill\",\n    COALESCE(ba.total_runs, 0) AS total_runs,\n    COALESCE(mp.total_matches_played, 0) AS total_matches_played,\n    COALESCE(d.total_times_dismissed, 0) AS total_times_dismissed,\n    CASE WHEN COALESCE(d.total_times_dismissed, 0) > 0 \n         THEN ROUND(COALESCE(ba.total_runs, 0)::FLOAT / d.total_times_dismissed, 6) \n         ELSE NULL END AS batting_average,\n    COALESCE(ba.highest_score, 0) AS highest_score,\n    COALESCE(ba.matches_30_plus, 0) AS matches_30_plus,\n    COALESCE(ba.matches_50_plus, 0) AS matches_50_plus,\n    COALESCE(ba.matches_100_plus, 0) AS matches_100_plus,\n    COALESCE(ba.total_balls_faced, 0) AS total_balls_faced,\n    CASE WHEN COALESCE(ba.total_balls_faced, 0) > 0 \n         THEN ROUND(COALESCE(ba.total_runs, 0)::FLOAT / ba.total_balls_faced * 100, 6) \n         ELSE NULL END AS strike_rate,\n    COALESCE(bw.total_wickets_taken, 0) AS total_wickets_taken,\n    be.economy_rate,\n    bb.best_bowling_performance\nFROM \"IPL\".\"IPL\".\"PLAYER\" p\nLEFT JOIN most_freq_role mfr ON p.\"player_id\" = mfr.player_id\nLEFT JOIN batting_agg ba ON p.\"player_id\" = ba.player_id\nLEFT JOIN matches_played mp ON p.\"player_id\" = mp.player_id\nLEFT JOIN dismissals d ON p.\"player_id\" = d.player_id\nLEFT JOIN bowling_wickets bw ON p.\"player_id\" = bw.player_id\nLEFT JOIN bowling_economy be ON p.\"player_id\" = be.player_id\nLEFT JOIN best_bowling bb ON p.\"player_id\" = bb.player_id\nORDER BY p.\"player_id\";") t ~= (sql%([PLAYER_MATCH_schema, PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, MATCH_schema]) "WITH batting_stats AS (\n    SELECT \n        b.\"striker\" AS player_id,\n        SUM(bs.\"runs_scored\") AS total_runs,\n        COUNT(*) AS total_balls_faced\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\" \n        AND b.\"over_id\" = bs.\"over_id\" \n        AND b.\"ball_id\" = bs.\"ball_id\" \n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"striker\"\n),\nmatch_batting AS (\n    SELECT \n        b.\"striker\" AS player_id,\n        b.\"match_id\",\n        SUM(bs.\"runs_scored\") AS match_runs\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\" \n        AND b.\"over_id\" = bs.\"over_id\" \n        AND b.\"ball_id\" = bs.\"ball_id\" \n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"striker\", b.\"match_id\"\n),\nbatting_milestones AS (\n    SELECT \n        player_id,\n        MAX(match_runs) AS highest_score,\n        SUM(CASE WHEN match_runs >= 30 THEN 1 ELSE 0 END) AS matches_30_plus,\n        SUM(CASE WHEN match_runs >= 50 THEN 1 ELSE 0 END) AS matches_50_plus,\n        SUM(CASE WHEN match_runs >= 100 THEN 1 ELSE 0 END) AS matches_100_plus\n    FROM match_batting\n    GROUP BY player_id\n),\ndismissals AS (\n    SELECT \n        wt.\"player_out\" AS player_id,\n        COUNT(*) AS total_times_dismissed\n    FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n    GROUP BY wt.\"player_out\"\n),\nmatches_played AS (\n    SELECT \n        pm.\"player_id\" AS player_id,\n        COUNT(DISTINCT pm.\"match_id\") AS total_matches_played\n    FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\" pm\n    GROUP BY pm.\"player_id\"\n),\nmost_freq_role AS (\n    SELECT \n        player_id,\n        most_frequent_role\n    FROM (\n        SELECT \n            pm2.\"player_id\" AS player_id,\n            pm2.\"role\" AS most_frequent_role,\n            COUNT(*) AS role_count,\n            ROW_NUMBER() OVER (PARTITION BY pm2.\"player_id\" ORDER BY COUNT(*) DESC, pm2.\"role\") AS rn\n        FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\" pm2\n        GROUP BY pm2.\"player_id\", pm2.\"role\"\n    )\n    WHERE rn = 1\n),\nbowling_wickets AS (\n    SELECT \n        b.\"bowler\" AS player_id,\n        COUNT(*) AS total_wickets_taken\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n        ON b.\"match_id\" = wt.\"match_id\" \n        AND b.\"over_id\" = wt.\"over_id\" \n        AND b.\"ball_id\" = wt.\"ball_id\" \n        AND b.\"innings_no\" = wt.\"innings_no\"\n    WHERE wt.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n    GROUP BY b.\"bowler\"\n),\nbowling_runs AS (\n    SELECT \n        b.\"bowler\" AS player_id,\n        SUM(bs.\"runs_scored\") AS total_runs_conceded,\n        COUNT(*) AS total_balls_bowled\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\" \n        AND b.\"over_id\" = bs.\"over_id\" \n        AND b.\"ball_id\" = bs.\"ball_id\" \n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"bowler\"\n),\nmatch_bowling AS (\n    SELECT \n        b.\"bowler\" AS player_id,\n        b.\"match_id\",\n        COUNT(CASE WHEN wt.\"kind_out\" IS NOT NULL AND wt.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field') THEN 1 END) AS wickets_in_match,\n        SUM(bs.\"runs_scored\") AS runs_in_match\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\" \n        AND b.\"over_id\" = bs.\"over_id\" \n        AND b.\"ball_id\" = bs.\"ball_id\" \n        AND b.\"innings_no\" = bs.\"innings_no\"\n    LEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n        ON b.\"match_id\" = wt.\"match_id\" \n        AND b.\"over_id\" = wt.\"over_id\" \n        AND b.\"ball_id\" = wt.\"ball_id\" \n        AND b.\"innings_no\" = wt.\"innings_no\"\n    GROUP BY b.\"bowler\", b.\"match_id\"\n),\nbest_bowling AS (\n    SELECT \n        player_id,\n        wickets_in_match || '-' || runs_in_match AS best_bowling_performance\n    FROM (\n        SELECT \n            player_id,\n            wickets_in_match,\n            runs_in_match,\n            ROW_NUMBER() OVER (PARTITION BY player_id ORDER BY wickets_in_match DESC, runs_in_match ASC) AS rn\n        FROM match_bowling\n    )\n    WHERE rn = 1\n)\nSELECT \n    p.\"player_id\" AS player_id,\n    p.\"player_name\" AS player_name,\n    mfr.most_frequent_role,\n    p.\"batting_hand\" AS batting_hand,\n    p.\"bowling_skill\" AS bowling_skill,\n    COALESCE(bat.total_runs, 0) AS total_runs,\n    COALESCE(mp.total_matches_played, 0) AS total_matches_played,\n    COALESCE(d.total_times_dismissed, 0) AS total_times_dismissed,\n    CASE WHEN COALESCE(d.total_times_dismissed, 0) > 0 \n         THEN ROUND(bat.total_runs::DECIMAL / d.total_times_dismissed, 6)\n         ELSE NULL END AS batting_average,\n    COALESCE(bm.highest_score, 0) AS highest_score,\n    COALESCE(bm.matches_30_plus, 0) AS matches_30_plus,\n    COALESCE(bm.matches_50_plus, 0) AS matches_50_plus,\n    COALESCE(bm.matches_100_plus, 0) AS matches_100_plus,\n    COALESCE(bat.total_balls_faced, 0) AS total_balls_faced,\n    CASE WHEN COALESCE(bat.total_balls_faced, 0) > 0 \n         THEN ROUND(bat.total_runs::DECIMAL / bat.total_balls_faced * 100, 6)\n         ELSE NULL END AS strike_rate,\n    COALESCE(bw.total_wickets_taken, 0) AS total_wickets_taken,\n    CASE WHEN COALESCE(br.total_balls_bowled, 0) > 0 \n         THEN ROUND(br.total_runs_conceded::DECIMAL / (br.total_balls_bowled::DECIMAL / 6), 6)\n         ELSE NULL END AS economy_rate,\n    bb.best_bowling_performance\nFROM \"IPL\".\"IPL\".\"PLAYER\" p\nLEFT JOIN most_freq_role mfr ON p.\"player_id\" = mfr.player_id\nLEFT JOIN batting_stats bat ON p.\"player_id\" = bat.player_id\nLEFT JOIN batting_milestones bm ON p.\"player_id\" = bm.player_id\nLEFT JOIN dismissals d ON p.\"player_id\" = d.player_id\nLEFT JOIN matches_played mp ON p.\"player_id\" = mp.player_id\nLEFT JOIN bowling_wickets bw ON p.\"player_id\" = bw.player_id\nLEFT JOIN bowling_runs br ON p.\"player_id\" = br.player_id\nLEFT JOIN best_bowling bb ON p.\"player_id\" = bb.player_id\nORDER BY p.\"player_id\";") t := by
