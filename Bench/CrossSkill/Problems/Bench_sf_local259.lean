    (sql%([PLAYER_MATCH_schema, PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, MATCH_schema]) "WITH most_frequent_role AS (\n    SELECT \"player_id\", \"role\"\n    FROM (\n        SELECT \"player_id\", \"role\",\n               ROW_NUMBER() OVER (PARTITION BY \"player_id\" ORDER BY COUNT(*) DESC, \"role\") AS rn\n        FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\"\n        GROUP BY \"player_id\", \"role\"\n    )\n    WHERE rn = 1\n),\n\ntotal_matches AS (\n    SELECT \"player_id\", COUNT(DISTINCT \"match_id\") AS total_matches\n    FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\"\n    GROUP BY \"player_id\"\n),\n\nbatting_balls AS (\n    SELECT b.\"match_id\", b.\"striker\" AS player_id, bs.\"runs_scored\"\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    INNER JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n),\n\nbatting_stats AS (\n    SELECT player_id,\n           SUM(\"runs_scored\") AS total_runs_scored,\n           COUNT(*) AS total_balls_faced\n    FROM batting_balls\n    GROUP BY player_id\n),\n\nper_match_batting AS (\n    SELECT player_id, \"match_id\", SUM(\"runs_scored\") AS match_runs\n    FROM batting_balls\n    GROUP BY player_id, \"match_id\"\n),\n\nbatting_milestones AS (\n    SELECT player_id,\n           MAX(match_runs) AS highest_score,\n           SUM(CASE WHEN match_runs >= 30 THEN 1 ELSE 0 END) AS thirties,\n           SUM(CASE WHEN match_runs >= 50 THEN 1 ELSE 0 END) AS fifties,\n           SUM(CASE WHEN match_runs >= 100 THEN 1 ELSE 0 END) AS hundreds\n    FROM per_match_batting\n    GROUP BY player_id\n),\n\ndismissals AS (\n    SELECT \"player_out\" AS player_id, COUNT(*) AS total_times_dismissed\n    FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\"\n    GROUP BY \"player_out\"\n),\n\nbowling_stats AS (\n    SELECT b.\"bowler\" AS player_id,\n           SUM(bs.\"runs_scored\") AS total_runs_conceded,\n           COUNT(*) AS total_balls_bowled\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    INNER JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"bowler\"\n),\n\nbowling_wickets AS (\n    SELECT b.\"bowler\" AS player_id, COUNT(*) AS total_wickets_taken\n    FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n    JOIN \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n        ON w.\"match_id\" = b.\"match_id\"\n        AND w.\"over_id\" = b.\"over_id\"\n        AND w.\"ball_id\" = b.\"ball_id\"\n        AND w.\"innings_no\" = b.\"innings_no\"\n    WHERE w.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n    GROUP BY b.\"bowler\"\n),\n\nbest_bowling_base AS (\n    SELECT b.\"bowler\" AS player_id, b.\"match_id\",\n           COUNT(CASE WHEN w.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field') THEN 1 END) AS match_wickets,\n           SUM(bs.\"runs_scored\") AS match_runs_conceded\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    INNER JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n    LEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n        ON b.\"match_id\" = w.\"match_id\"\n        AND b.\"over_id\" = w.\"over_id\"\n        AND b.\"ball_id\" = w.\"ball_id\"\n        AND b.\"innings_no\" = w.\"innings_no\"\n    GROUP BY b.\"bowler\", b.\"match_id\"\n),\n\nbest_bowling AS (\n    SELECT player_id, match_wickets, match_runs_conceded,\n           ROW_NUMBER() OVER (PARTITION BY player_id ORDER BY match_wickets DESC, match_runs_conceded ASC) AS rn\n    FROM best_bowling_base\n)\n\nSELECT \n    p.\"player_id\" AS \"player_id\",\n    p.\"player_name\" AS \"player_name\",\n    mfr.\"role\" AS \"most_frequent_role\",\n    p.\"batting_hand\" AS \"batting_hand\",\n    p.\"bowling_skill\" AS \"bowling_skill\",\n    COALESCE(bat.total_runs_scored, 0) AS \"total_runs_scored\",\n    COALESCE(tm.total_matches, 0) AS \"total_matches\",\n    COALESCE(d.total_times_dismissed, 0) AS \"total_times_dismissed\",\n    CASE WHEN COALESCE(d.total_times_dismissed, 0) > 0 \n         THEN COALESCE(bat.total_runs_scored, 0)::FLOAT / d.total_times_dismissed \n         ELSE NULL END AS \"batting_average\",\n    COALESCE(bm.highest_score, 0) AS \"highest_score\",\n    COALESCE(bm.thirties, 0) AS \"30s\",\n    COALESCE(bm.fifties, 0) AS \"50s\",\n    COALESCE(bm.hundreds, 0) AS \"100s\",\n    COALESCE(bat.total_balls_faced, 0) AS \"total_balls_faced\",\n    CASE WHEN COALESCE(bat.total_balls_faced, 0) > 0 \n         THEN COALESCE(bat.total_runs_scored, 0)::FLOAT / bat.total_balls_faced * 100 \n         ELSE NULL END AS \"strike_rate\",\n    COALESCE(bw.total_wickets_taken, 0) AS \"total_wickets_taken\",\n    CASE WHEN bwl.total_balls_bowled IS NOT NULL AND bwl.total_balls_bowled > 0 \n         THEN bwl.total_runs_conceded::FLOAT / bwl.total_balls_bowled * 6 \n         ELSE NULL END AS \"economy_rate\",\n    CASE WHEN bb.player_id IS NOT NULL \n         THEN bb.match_wickets || '-' || bb.match_runs_conceded \n         ELSE NULL END AS \"best_bowling_performance\"\nFROM \"IPL\".\"IPL\".\"PLAYER\" p\nLEFT JOIN most_frequent_role mfr ON p.\"player_id\" = mfr.\"player_id\"\nLEFT JOIN total_matches tm ON p.\"player_id\" = tm.\"player_id\"\nLEFT JOIN batting_stats bat ON p.\"player_id\" = bat.player_id\nLEFT JOIN batting_milestones bm ON p.\"player_id\" = bm.player_id\nLEFT JOIN dismissals d ON p.\"player_id\" = d.player_id\nLEFT JOIN bowling_stats bwl ON p.\"player_id\" = bwl.player_id\nLEFT JOIN bowling_wickets bw ON p.\"player_id\" = bw.player_id\nLEFT JOIN best_bowling bb ON p.\"player_id\" = bb.player_id AND bb.rn = 1\nORDER BY p.\"player_id\";") t ~= (sql%([PLAYER_MATCH_schema, PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, MATCH_schema]) "WITH batting_innings AS (\n    -- Per match+innings batting stats for each striker\n    SELECT \n        bb.\"striker\" AS player_id,\n        bb.\"match_id\",\n        bb.\"innings_no\",\n        SUM(bs.\"runs_scored\") AS innings_runs,\n        COUNT(*) AS innings_balls\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" bb\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs \n        ON bb.\"match_id\" = bs.\"match_id\" \n        AND bb.\"over_id\" = bs.\"over_id\" \n        AND bb.\"ball_id\" = bs.\"ball_id\" \n        AND bb.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY bb.\"striker\", bb.\"match_id\", bb.\"innings_no\"\n),\nbatting_agg AS (\n    -- Aggregate batting stats per player\n    SELECT \n        player_id,\n        SUM(innings_runs) AS total_runs,\n        SUM(innings_balls) AS total_balls_faced,\n        MAX(innings_runs) AS highest_score,\n        SUM(CASE WHEN innings_runs >= 30 THEN 1 ELSE 0 END) AS matches_30_plus,\n        SUM(CASE WHEN innings_runs >= 50 THEN 1 ELSE 0 END) AS matches_50_plus,\n        SUM(CASE WHEN innings_runs >= 100 THEN 1 ELSE 0 END) AS matches_100_plus\n    FROM batting_innings\n    GROUP BY player_id\n),\ndismissals AS (\n    -- Total times dismissed (all kinds)\n    SELECT \n        \"player_out\" AS player_id,\n        COUNT(*) AS total_times_dismissed\n    FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\"\n    GROUP BY \"player_out\"\n),\nmatches_played AS (\n    -- Total matches from PLAYER_MATCH\n    SELECT \n        \"player_id\" AS player_id,\n        COUNT(DISTINCT \"match_id\") AS total_matches_played\n    FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\"\n    GROUP BY \"player_id\"\n),\nmost_freq_role AS (\n    -- Most frequent role per player\n    SELECT player_id, role AS most_frequent_role\n    FROM (\n        SELECT \n            \"player_id\" AS player_id,\n            \"role\" AS role,\n            COUNT(*) AS role_count,\n            ROW_NUMBER() OVER (PARTITION BY \"player_id\" ORDER BY COUNT(*) DESC, \"role\" ASC) AS rn\n        FROM \"IPL\".\"IPL\".\"PLAYER_MATCH\"\n        GROUP BY \"player_id\", \"role\"\n    )\n    WHERE rn = 1\n),\nbowling_wickets_per_match AS (\n    -- Per match bowling wickets (excluding run out, retired hurt, obstructing the field)\n    SELECT \n        bb.\"bowler\" AS player_id,\n        bb.\"match_id\",\n        bb.\"innings_no\",\n        COUNT(CASE WHEN wt.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field') THEN 1 END) AS wickets\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" bb\n    LEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n        ON bb.\"match_id\" = wt.\"match_id\" \n        AND bb.\"over_id\" = wt.\"over_id\" \n        AND bb.\"ball_id\" = wt.\"ball_id\" \n        AND bb.\"innings_no\" = wt.\"innings_no\"\n    GROUP BY bb.\"bowler\", bb.\"match_id\", bb.\"innings_no\"\n),\nbowling_runs_per_match AS (\n    -- Per match bowling runs conceded (from BATSMAN_SCORED)\n    SELECT \n        bb.\"bowler\" AS player_id,\n        bb.\"match_id\",\n        bb.\"innings_no\",\n        SUM(bs.\"runs_scored\") AS runs_conceded,\n        COUNT(*) AS balls_bowled\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" bb\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs \n        ON bb.\"match_id\" = bs.\"match_id\" \n        AND bb.\"over_id\" = bs.\"over_id\" \n        AND bb.\"ball_id\" = bs.\"ball_id\" \n        AND bb.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY bb.\"bowler\", bb.\"match_id\", bb.\"innings_no\"\n),\nbowling_match_combined AS (\n    SELECT \n        bw.player_id,\n        bw.\"match_id\",\n        bw.\"innings_no\",\n        bw.wickets,\n        br.runs_conceded,\n        br.balls_bowled\n    FROM bowling_wickets_per_match bw\n    JOIN bowling_runs_per_match br \n        ON bw.player_id = br.player_id \n        AND bw.\"match_id\" = br.\"match_id\" \n        AND bw.\"innings_no\" = br.\"innings_no\"\n),\nbowling_agg AS (\n    -- Aggregate bowling stats per player\n    SELECT \n        player_id,\n        SUM(wickets) AS total_wickets_taken,\n        SUM(runs_conceded) AS total_runs_conceded,\n        SUM(balls_bowled) AS total_balls_bowled\n    FROM bowling_match_combined\n    GROUP BY player_id\n),\nbest_bowling AS (\n    -- Best bowling performance: most wickets, then fewest runs\n    -- Include 0-wicket performances too\n    SELECT player_id, \n           CAST(wickets AS VARCHAR) || '-' || CAST(runs_conceded AS VARCHAR) AS best_bowling_performance\n    FROM (\n        SELECT \n            player_id,\n            wickets,\n            runs_conceded,\n            ROW_NUMBER() OVER (PARTITION BY player_id ORDER BY wickets DESC, runs_conceded ASC) AS rn\n        FROM bowling_match_combined\n    )\n    WHERE rn = 1\n)\nSELECT \n    p.\"player_id\",\n    p.\"player_name\",\n    mfr.most_frequent_role,\n    p.\"batting_hand\",\n    p.\"bowling_skill\",\n    COALESCE(ba.total_runs, 0) AS total_runs,\n    COALESCE(mp.total_matches_played, 0) AS total_matches_played,\n    COALESCE(d.total_times_dismissed, 0) AS total_times_dismissed,\n    CASE WHEN COALESCE(d.total_times_dismissed, 0) = 0 THEN NULL \n         ELSE CAST(COALESCE(ba.total_runs, 0) AS FLOAT) / d.total_times_dismissed \n    END AS batting_average,\n    COALESCE(ba.highest_score, 0) AS highest_score,\n    COALESCE(ba.matches_30_plus, 0) AS matches_30_plus,\n    COALESCE(ba.matches_50_plus, 0) AS matches_50_plus,\n    COALESCE(ba.matches_100_plus, 0) AS matches_100_plus,\n    COALESCE(ba.total_balls_faced, 0) AS total_balls_faced,\n    CASE WHEN COALESCE(ba.total_balls_faced, 0) = 0 THEN NULL \n         ELSE CAST(COALESCE(ba.total_runs, 0) AS FLOAT) / ba.total_balls_faced * 100 \n    END AS strike_rate,\n    COALESCE(bow.total_wickets_taken, 0) AS total_wickets_taken,\n    CASE WHEN COALESCE(bow.total_balls_bowled, 0) = 0 THEN NULL \n         ELSE CAST(bow.total_runs_conceded AS FLOAT) * 6 / bow.total_balls_bowled \n    END AS economy_rate,\n    bb.best_bowling_performance\nFROM \"IPL\".\"IPL\".\"PLAYER\" p\nLEFT JOIN most_freq_role mfr ON p.\"player_id\" = mfr.player_id\nLEFT JOIN batting_agg ba ON p.\"player_id\" = ba.player_id\nLEFT JOIN dismissals d ON p.\"player_id\" = d.player_id\nLEFT JOIN matches_played mp ON p.\"player_id\" = mp.player_id\nLEFT JOIN bowling_agg bow ON p.\"player_id\" = bow.player_id\nLEFT JOIN best_bowling bb ON p.\"player_id\" = bb.player_id\nORDER BY p.\"player_id\";") t := by
