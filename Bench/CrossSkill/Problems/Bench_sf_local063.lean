-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, SALES_schema]) "WITH growing_cities AS (\n    -- Cities in the US with promo_id=999 that had >=20% sales increase Q4 2019 to Q4 2020\n    SELECT q4_19.\"cust_city\"\n    FROM (\n        SELECT cu.\"cust_city\", SUM(s.\"amount_sold\") AS sales\n        FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n        JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n        JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu ON s.\"cust_id\" = cu.\"cust_id\"\n        WHERE s.\"promo_id\" = 999\n          AND t.\"calendar_quarter_id\" = 1772\n          AND cu.\"country_id\" = 52790\n        GROUP BY cu.\"cust_city\"\n    ) q4_19\n    JOIN (\n        SELECT cu.\"cust_city\", SUM(s.\"amount_sold\") AS sales\n        FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n        JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n        JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu ON s.\"cust_id\" = cu.\"cust_id\"\n        WHERE s.\"promo_id\" = 999\n          AND t.\"calendar_quarter_id\" = 1776\n          AND cu.\"country_id\" = 52790\n        GROUP BY cu.\"cust_city\"\n    ) q4_20 ON q4_19.\"cust_city\" = q4_20.\"cust_city\"\n    WHERE (q4_20.sales - q4_19.sales) / q4_19.sales >= 0.20\n),\n-- Product sales per quarter within qualifying cities\nproduct_quarter_sales AS (\n    SELECT s.\"prod_id\", t.\"calendar_quarter_id\",\n           SUM(s.\"amount_sold\") AS prod_sales\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu ON s.\"cust_id\" = cu.\"cust_id\"\n    WHERE s.\"promo_id\" = 999\n      AND t.\"calendar_quarter_id\" IN (1772, 1776)\n      AND cu.\"country_id\" = 52790\n      AND cu.\"cust_city\" IN (SELECT \"cust_city\" FROM growing_cities)\n    GROUP BY s.\"prod_id\", t.\"calendar_quarter_id\"\n),\n-- Total sales per quarter (denominator for share)\nquarter_totals AS (\n    SELECT \"calendar_quarter_id\", SUM(prod_sales) AS total_sales\n    FROM product_quarter_sales\n    GROUP BY \"calendar_quarter_id\"\n),\n-- Product share in each quarter (as proportion 0-1)\nproduct_shares AS (\n    SELECT pq.\"prod_id\",\n           MAX(CASE WHEN pq.\"calendar_quarter_id\" = 1772 THEN pq.prod_sales / qt.total_sales END) AS SHARE_2019Q4,\n           MAX(CASE WHEN pq.\"calendar_quarter_id\" = 1776 THEN pq.prod_sales / qt.total_sales END) AS SHARE_2020Q4\n    FROM product_quarter_sales pq\n    JOIN quarter_totals qt ON pq.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\"\n    GROUP BY pq.\"prod_id\"\n),\n-- Product total sales for ranking (combined both quarters)\nproduct_ranked AS (\n    SELECT pq.\"prod_id\",\n           SUM(pq.prod_sales) AS total_sales,\n           NTILE(5) OVER (ORDER BY SUM(pq.prod_sales) DESC) AS ntile_rank\n    FROM product_quarter_sales pq\n    GROUP BY pq.\"prod_id\"\n)\nSELECT pr.\"prod_id\",\n       p.\"prod_name\",\n       ABS(ps.SHARE_2020Q4 - ps.SHARE_2019Q4) AS PP_CHANGE,\n       ps.SHARE_2019Q4,\n       ps.SHARE_2020Q4\nFROM product_ranked pr\nJOIN product_shares ps ON pr.\"prod_id\" = ps.\"prod_id\"\nJOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p ON pr.\"prod_id\" = p.\"prod_id\"\nWHERE pr.ntile_rank = 1\n  AND ps.SHARE_2019Q4 IS NOT NULL\n  AND ps.SHARE_2020Q4 IS NOT NULL\nORDER BY PP_CHANGE ASC\nLIMIT 1;") t ~= (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, SALES_schema]) "WITH city_quarter AS (\n  SELECT c.\"cust_city\", t.\"calendar_quarter_id\", SUM(s.\"amount_sold\") AS city_sales\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co ON c.\"country_id\" = co.\"country_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  WHERE co.\"country_name\" = 'United States of America'\n    AND s.\"promo_id\" = 999\n    AND t.\"calendar_quarter_id\" IN (1772, 1776)\n  GROUP BY c.\"cust_city\", t.\"calendar_quarter_id\"\n),\nqualifying_cities AS (\n  SELECT q19.\"cust_city\"\n  FROM city_quarter q19\n  JOIN city_quarter q20 ON q19.\"cust_city\" = q20.\"cust_city\"\n  WHERE q19.\"calendar_quarter_id\" = 1772\n    AND q20.\"calendar_quarter_id\" = 1776\n    AND (q20.city_sales - q19.city_sales) / q19.city_sales >= 0.20\n),\nbase_sales AS (\n  SELECT s.\"prod_id\", t.\"calendar_quarter_id\", SUM(s.\"amount_sold\") AS prod_sales\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co ON c.\"country_id\" = co.\"country_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  WHERE co.\"country_name\" = 'United States of America'\n    AND s.\"promo_id\" = 999\n    AND t.\"calendar_quarter_id\" IN (1772, 1776)\n    AND c.\"cust_city\" IN (SELECT \"cust_city\" FROM qualifying_cities)\n  GROUP BY s.\"prod_id\", t.\"calendar_quarter_id\"\n),\nquarter_totals AS (\n  SELECT \"calendar_quarter_id\", SUM(prod_sales) AS total_quarter_sales\n  FROM base_sales\n  GROUP BY \"calendar_quarter_id\"\n),\nprod_shares AS (\n  SELECT b.\"prod_id\",\n    MAX(CASE WHEN b.\"calendar_quarter_id\" = 1772 THEN b.prod_sales / qt.total_quarter_sales END) AS SHARE_2019Q4,\n    MAX(CASE WHEN b.\"calendar_quarter_id\" = 1776 THEN b.prod_sales / qt.total_quarter_sales END) AS SHARE_2020Q4,\n    SUM(b.prod_sales) AS total_sales\n  FROM base_sales b\n  JOIN quarter_totals qt ON b.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\"\n  GROUP BY b.\"prod_id\"\n  HAVING SHARE_2019Q4 IS NOT NULL AND SHARE_2020Q4 IS NOT NULL\n),\nranked AS (\n  SELECT ps.\"prod_id\",\n    p.\"prod_name\",\n    ABS(ps.SHARE_2020Q4 - ps.SHARE_2019Q4) AS PP_CHANGE,\n    ps.SHARE_2019Q4,\n    ps.SHARE_2020Q4,\n    PERCENT_RANK() OVER (ORDER BY ps.total_sales DESC) AS pct_rank\n  FROM prod_shares ps\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p ON ps.\"prod_id\" = p.\"prod_id\"\n)\nSELECT \"prod_id\", \"prod_name\", PP_CHANGE, SHARE_2019Q4, SHARE_2020Q4\nFROM ranked\nWHERE pct_rank < 0.20\nORDER BY PP_CHANGE ASC\nLIMIT 1;") t := by
