theorem eq_1_2 : ∀ t,
    (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, SALES_schema]) "WITH city_quarter AS (\n  SELECT c.\"cust_city\", t.\"calendar_quarter_id\", SUM(s.\"amount_sold\") AS city_sales\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co ON c.\"country_id\" = co.\"country_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  WHERE co.\"country_name\" = 'United States of America'\n    AND s.\"promo_id\" = 999\n    AND t.\"calendar_quarter_id\" IN (1772, 1776)\n  GROUP BY c.\"cust_city\", t.\"calendar_quarter_id\"\n),\nqualifying_cities AS (\n  SELECT q19.\"cust_city\"\n  FROM city_quarter q19\n  JOIN city_quarter q20 ON q19.\"cust_city\" = q20.\"cust_city\"\n  WHERE q19.\"calendar_quarter_id\" = 1772\n    AND q20.\"calendar_quarter_id\" = 1776\n    AND (q20.city_sales - q19.city_sales) / q19.city_sales >= 0.20\n),\nbase_sales AS (\n  SELECT s.\"prod_id\", t.\"calendar_quarter_id\", SUM(s.\"amount_sold\") AS prod_sales\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co ON c.\"country_id\" = co.\"country_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  WHERE co.\"country_name\" = 'United States of America'\n    AND s.\"promo_id\" = 999\n    AND t.\"calendar_quarter_id\" IN (1772, 1776)\n    AND c.\"cust_city\" IN (SELECT \"cust_city\" FROM qualifying_cities)\n  GROUP BY s.\"prod_id\", t.\"calendar_quarter_id\"\n),\nquarter_totals AS (\n  SELECT \"calendar_quarter_id\", SUM(prod_sales) AS total_quarter_sales\n  FROM base_sales\n  GROUP BY \"calendar_quarter_id\"\n),\nprod_shares AS (\n  SELECT b.\"prod_id\",\n    MAX(CASE WHEN b.\"calendar_quarter_id\" = 1772 THEN b.prod_sales / qt.total_quarter_sales END) AS SHARE_2019Q4,\n    MAX(CASE WHEN b.\"calendar_quarter_id\" = 1776 THEN b.prod_sales / qt.total_quarter_sales END) AS SHARE_2020Q4,\n    SUM(b.prod_sales) AS total_sales\n  FROM base_sales b\n  JOIN quarter_totals qt ON b.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\"\n  GROUP BY b.\"prod_id\"\n  HAVING SHARE_2019Q4 IS NOT NULL AND SHARE_2020Q4 IS NOT NULL\n),\nranked AS (\n  SELECT ps.\"prod_id\",\n    p.\"prod_name\",\n    ABS(ps.SHARE_2020Q4 - ps.SHARE_2019Q4) AS PP_CHANGE,\n    ps.SHARE_2019Q4,\n    ps.SHARE_2020Q4,\n    PERCENT_RANK() OVER (ORDER BY ps.total_sales DESC) AS pct_rank\n  FROM prod_shares ps\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p ON ps.\"prod_id\" = p.\"prod_id\"\n)\nSELECT \"prod_id\", \"prod_name\", PP_CHANGE, SHARE_2019Q4, SHARE_2020Q4\nFROM ranked\nWHERE pct_rank < 0.20\nORDER BY PP_CHANGE ASC\nLIMIT 1;") t ~= (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, SALES_schema]) "WITH us_sales AS (\n    -- All sales in the United States with promo_id=999 in Q4 2019 or Q4 2020\n    SELECT \n        s.\"prod_id\",\n        s.\"cust_id\",\n        s.\"time_id\",\n        s.\"amount_sold\",\n        s.\"quantity_sold\",\n        t.\"calendar_quarter_id\",\n        cu.\"cust_city\"\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu ON s.\"cust_id\" = cu.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co ON cu.\"country_id\" = co.\"country_id\"\n    WHERE co.\"country_name\" = 'United States of America'\n      AND s.\"promo_id\" = 999\n      AND t.\"calendar_quarter_id\" IN (1772, 1776)\n),\n-- Identify cities whose total sales increased by at least 20% from Q4 2019 to Q4 2020\ncity_sales AS (\n    SELECT \n        \"cust_city\",\n        SUM(CASE WHEN \"calendar_quarter_id\" = 1772 THEN \"amount_sold\" ELSE 0 END) AS sales_2019q4,\n        SUM(CASE WHEN \"calendar_quarter_id\" = 1776 THEN \"amount_sold\" ELSE 0 END) AS sales_2020q4\n    FROM us_sales\n    GROUP BY \"cust_city\"\n    HAVING sales_2019q4 > 0\n       AND (sales_2020q4 - sales_2019q4) / sales_2019q4 >= 0.20\n),\n-- Filter to only sales in qualifying cities\nqualifying_sales AS (\n    SELECT us.*\n    FROM us_sales us\n    JOIN city_sales cs ON us.\"cust_city\" = cs.\"cust_city\"\n),\n-- Total sales per product across both quarters (for ranking)\nproduct_total_sales AS (\n    SELECT \n        \"prod_id\",\n        SUM(\"amount_sold\") AS total_sales\n    FROM qualifying_sales\n    GROUP BY \"prod_id\"\n),\n-- Rank products and find top 20%\nproduct_ranked AS (\n    SELECT \n        \"prod_id\",\n        total_sales,\n        NTILE(5) OVER (ORDER BY total_sales DESC) AS ntile_rank\n    FROM product_total_sales\n),\n-- Top 20% products (ntile_rank = 1 means top 20%)\ntop_products AS (\n    SELECT \"prod_id\", total_sales\n    FROM product_ranked\n    WHERE ntile_rank = 1\n),\n-- Calculate share of total sales per quarter for top products\nquarter_totals AS (\n    SELECT \n        \"calendar_quarter_id\",\n        SUM(\"amount_sold\") AS quarter_total\n    FROM qualifying_sales\n    WHERE \"prod_id\" IN (SELECT \"prod_id\" FROM top_products)\n    GROUP BY \"calendar_quarter_id\"\n),\nproduct_quarter_sales AS (\n    SELECT \n        qs.\"prod_id\",\n        qs.\"calendar_quarter_id\",\n        SUM(qs.\"amount_sold\") AS prod_quarter_sales\n    FROM qualifying_sales qs\n    WHERE qs.\"prod_id\" IN (SELECT \"prod_id\" FROM top_products)\n    GROUP BY qs.\"prod_id\", qs.\"calendar_quarter_id\"\n),\nproduct_shares AS (\n    SELECT \n        pqs.\"prod_id\",\n        SUM(CASE WHEN pqs.\"calendar_quarter_id\" = 1772 \n            THEN pqs.prod_quarter_sales / qt.quarter_total ELSE 0 END) AS share_2019q4,\n        SUM(CASE WHEN pqs.\"calendar_quarter_id\" = 1776 \n            THEN pqs.prod_quarter_sales / qt.quarter_total ELSE 0 END) AS share_2020q4\n    FROM product_quarter_sales pqs\n    JOIN quarter_totals qt ON pqs.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\"\n    GROUP BY pqs.\"prod_id\"\n)\nSELECT \n    ps.\"prod_id\" AS \"prod_id\",\n    p.\"prod_name\" AS \"prod_name\",\n    ROUND(ABS(ps.share_2020q4 - ps.share_2019q4) * 100, 2) AS \"PP_CHANGE\",\n    ROUND(ps.share_2019q4 * 100, 2) AS \"SHARE_2019Q4\",\n    ROUND(ps.share_2020q4 * 100, 2) AS \"SHARE_2020Q4\"\nFROM product_shares ps\nJOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p ON ps.\"prod_id\" = p.\"prod_id\"\nORDER BY ABS(ps.share_2020q4 - ps.share_2019q4) ASC\nLIMIT 1;") t := by
