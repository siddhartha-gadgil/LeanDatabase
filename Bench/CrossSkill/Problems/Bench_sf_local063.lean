 growing_cities)\n    GROUP BY s.\"prod_id\", t.\"calendar_quarter_id\"\n),\n-- Total sales per quarter (denominator for share)\nquarter_totals AS (\n    SELECT \"calendar_quarter_id\", SUM(prod_sales) AS total_sales\n    FROM product_quarter_sales\n    GROUP BY \"calendar_quarter_id\"\n),\n-- Product share in each quarter (as proportion 0-1)\nproduct_shares AS (\n    SELECT pq.\"prod_id\",\n           MAX(CASE WHEN pq.\"calendar_quarter_id\" = 1772 THEN pq.prod_sales / qt.total_sales END) AS SHARE_2019Q4,\n           MAX(CASE WHEN pq.\"calendar_quarter_id\" = 1776 THEN pq.prod_sales / qt.total_sales END) AS SHARE_2020Q4\n    FROM product_quarter_sales pq\n    JOIN quarter_totals qt ON pq.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\"\n    GROUP BY pq.\"prod_id\"\n),\n-- Product total sales for ranking (combined both quarters)\nproduct_ranked AS (\n    SELECT pq.\"prod_id\",\n           SUM(pq.prod_sales) AS total_sales,\n           NTILE(5) OVER (ORDER BY SUM(pq.prod_sales) DESC) AS ntile_rank\n    FROM product_quarter_sales pq\n    GROUP BY pq.\"prod_id\"\n)\nSELECT pr.\"prod_id\",\n       p.\"prod_name\",\n       ABS(ps.SHARE_2020Q4 - ps.SHARE_2019Q4) AS PP_CHANGE,\n       ps.SHARE_2019Q4,\n       ps.SHARE_2020Q4\nFROM product_ranked pr\nJOIN product_shares ps ON pr.\"prod_id\" = ps.\"prod_id\"\nJOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p ON pr.\"prod_id\" = p.\"prod_id\"\nWHERE pr.ntile_rank = 1\n  AND ps.SHARE_2019Q4 IS NOT NULL\n  AND ps.SHARE_2020Q4 IS NOT NULL\nORDER BY PP_CHANGE ASC\nLIMIT 1;") t ~= (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, SALES_schema]) "WITH base_sales AS (\n    -- All US sales with promo_id=999 in Q4 2019 or Q4 2020\n    SELECT\n        s.\"prod_id\",\n        c.\"cust_city\",\n        t.\"calendar_quarter_id\",\n        s.\"amount_sold\"\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c\n        ON s.\"cust_id\" = c.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co\n        ON c.\"country_id\" = co.\"country_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t\n        ON s.\"time_id\" = t.\"time_id\"\n    WHERE co.\"country_name\" = 'United States of America'\n      AND s.\"promo_id\" = 999\n      AND t.\"calendar_quarter_id\" IN (1772, 1776)\n),\ncity_quarter_sales AS (\n    -- Total sales per city per quarter\n    SELECT\n        \"cust_city\",\n        \"calendar_quarter_id\",\n        SUM(\"amount_sold\") AS total_sales\n    FROM base_sales\n    GROUP BY \"cust_city\", \"calendar_quarter_id\"\n),\nqualifying_cities AS (\n    -- Cities with >=20% increase from Q4 2019 to Q4 2020\n    SELECT q4_2019.\"cust_city\"\n    FROM (SELECT \"cust_city\", total_sales FROM city_quarter_sales WHERE \"calendar_quarter_id\" = 1772) q4_2019\n    JOIN (SELECT \"cust_city\", total_sales FROM city_quarter_sales WHERE \"calendar_quarter_id\" = 1776) q4_2020\n        ON q4_2019.\"cust_city\" = q4_2020.\"cust_city\"\n    WHERE (q4_2020.total_sales - q4_2019.total_sales) / q4_2019.total_sales >= 0.20\n),\nfiltered_sales AS (\n    -- Sales only from qualifying cities\n    SELECT *\n    FROM base_sales\n    WHERE \"cust_city\" IN (SELECT \"cust_city\" FROM qualifying_cities)\n),\nproduct_total_sales AS (\n    -- Total sales per product across both quarters (for ranking)\n    SELECT\n        \"prod_id\",\n        SUM(\"amount_sold\") AS total_product_sales\n    FROM filtered_sales\n    GROUP BY \"prod_id\"\n),\nproduct_ranked AS (\n    -- Rank products and identify top 20%\n    SELECT\n        \"prod_id\",\n        total_product_sales,\n        NTILE(5) OVER (ORDER BY total_product_sales DESC) AS quintile\n    FROM product_total_sales\n),\ntop_products AS (\n    -- Top 20% of products by total sales\n    SELECT \"prod_id\"\n    FROM product_ranked\n    WHERE quintile = 1\n),\nquarter_totals AS (\n    -- Total sales per quarter (across all products in qualifying cities)\n    SELECT\n        \"calendar_quarter_id\",\n        SUM(\"amount_sold\") AS quarter_total\n    FROM filtered_sales\n    GROUP BY \"calendar_quarter_id\"\n),\nproduct_quarter_sales AS (\n    -- Sales per product per quarter\n    SELECT\n        \"prod_id\",\n        \"calendar_quarter_id\",\n        SUM(\"amount_sold\") AS prod_quarter_sales\n    FROM filtered_sales\n    GROUP BY \"prod_id\", \"calendar_quarter_id\"\n),\nproduct_shares AS (\n    -- Calculate share of total sales per quarter for each top product\n    SELECT\n        pqs.\"prod_id\",\n        pqs.\"calendar_quarter_id\",\n        pqs.prod_quarter_sales / qt.quarter_total AS share\n    FROM product_quarter_sales pqs\n    JOIN quarter_totals qt ON pqs.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\"\n    WHERE pqs.\"prod_id\" IN (SELECT \"prod_id\" FROM top_products)\n),\nproduct_share_change AS (\n    SELECT\n        s2019.\"prod_id\",\n        s2019.share AS share_2019q4,\n        s2020.share AS share_2020q4,\n        ABS(s2020.share - s2019.share) AS pp_change\n    FROM (SELECT \"prod_id\", share FROM product_shares WHERE \"calendar_quarter_id\" = 1772) s2019\n    JOIN (SELECT \"prod_id\", share FROM product_shares WHERE \"calendar_quarter_id\" = 1776) s2020\n        ON s2019.\"prod_id\" = s2020.\"prod_id\"\n)\nSELECT\n    psc.\"prod_id\",\n    p.\"prod_name\",\n    psc.pp_change AS \"PP_CHANGE\",\n    psc.share_2019q4 AS \"SHARE_2019Q4\",\n    psc.share_2020q4 AS \"SHARE_2020Q4\"\nFROM product_share_change psc\nJOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p\n    ON psc.\"prod_id\" = p.\"prod_id\"\nORDER BY psc.pp_change ASC\nLIMIT 1;") t := by
