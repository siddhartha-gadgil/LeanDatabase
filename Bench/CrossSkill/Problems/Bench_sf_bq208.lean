theorem eq_0_1 : ∀ t,
    (sql%([GSOD2019_schema, GSOD2013_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2020_schema, GSOD2014_schema, GSOD2016_schema, GSOD2017_schema, GSOD2018_schema, STATIONS_schema]) "WITH nearby_stations AS (\n  SELECT \"usaf\", \"wban\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"STATIONS\"\n  WHERE \"lat\" IS NOT NULL AND \"lon\" IS NOT NULL\n    AND HAVERSINE(41.197, -73.764, \"lat\", \"lon\") <= 32.187\n),\nall_observations AS (\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2018\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2019\"\n  UNION ALL\n  SELECT \"stn\", \"wban\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2020\"\n)\nSELECT COUNT(*) AS \"Data_Points\"\nFROM all_observations o\nINNER JOIN nearby_stations s\n  ON o.\"stn\" = s.\"usaf\" AND o.\"wban\" = s.\"wban\"\nWHERE o.\"temp\" != 9999.9 AND o.\"temp\" IS NOT NULL\nGROUP BY o.\"stn\", o.\"wban\"\nORDER BY \"Data_Points\" DESC;") t ~= (sql%([GSOD2019_schema, GSOD2013_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2020_schema, GSOD2014_schema, GSOD2016_schema, GSOD2017_schema, GSOD2018_schema, STATIONS_schema]) "WITH nearby_stations AS (\n  SELECT \"usaf\", \"wban\", \"name\"\n  FROM \"NEW