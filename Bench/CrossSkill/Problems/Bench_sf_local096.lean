import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local096 — crossskill equivalence(s)

Question: For each year, calculate the percentage of films that had exclusively female actors (meaning no male actors and no actors with unknown/unspecified gender). Consider actors with gender marked as 'Male' or 'None' as non-female. For the results, display the year, the total number of movies in that year, and the percentage of movies with exclusively female actors. Extract the year from the Movie.year field by taking the last 4 characters and converting to a number.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local096

CREATE TABLE MOVIE («index» INT, «MID» STRING, «title» STRING, «year» STRING, «rating» FLOAT, «num_votes» INT)
CREATE TABLE PERSON («index» INT, «PID» STRING, «Name» STRING, «Gender» STRING)
CREATE TABLE M_CAST («index» INT, «MID» STRING, «PID» STRING, «ID» INT)

theorem eq_0_1 :
    sql%([MOVIE_schema, PERSON_schema, M_CAST_schema]) "WITH movie_years AS (\n    SELECT\n        \"MID\",\n        TRY_TO_NUMBER(RIGHT(\"year\", 4)) AS year\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"MOVIE\"\n),\nexclusively_female AS (\n    SELECT mc.\"MID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"PERSON\" p ON TRIM(mc.\"PID\") = TRIM(p.\"PID\")\n    GROUP BY mc.\"MID\"\n    HAVING SUM(CASE WHEN p.\"Gender\" != 'Female' THEN 1 ELSE 0 END) = 0\n)\nSELECT\n    my.year AS YEAR,\n    COUNT(DISTINCT my.\"MID\") AS TOTAL_MOVIES,\n    ROUND(\n        COUNT(DISTINCT ef.\"MID\") * 100.0 / COUNT(DISTINCT my.\"MID\"),\n        2\n    ) AS PERCENTAGE_EXCLUSIVELY_FEMALE\nFROM movie_years my\nLEFT JOIN exclusively_female ef ON my.\"MID\" = ef.\"MID\"\nGROUP BY my.year\nORDER BY my.year;" = sql%([MOVIE_schema, PERSON_schema, M_CAST_schema]) "WITH movie_years AS (\n    SELECT\n        m.\"MID\",\n        TRY_TO_NUMBER(RIGHT(m.\"year\", 4)) AS \"YEAR\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"MOVIE\" m\n    WHERE TRY_TO_NUMBER(RIGHT(m.\"year\", 4)) IS NOT NULL\n),\nexclusively_female AS (\n    SELECT\n        my.\"MID\"\n    FROM movie_years my\n    WHERE NOT EXISTS (\n        SELECT 1\n        FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c\n        JOIN \"DB_IMDB\".\"DB_IMDB\".\"PERSON\" p ON TRIM(c.\"PID\") = p.\"PID\"\n        WHERE c.\"MID\" = my.\"MID\"\n          AND p.\"Gender\" != 'Female'\n    )\n)\nSELECT\n    my.\"YEAR\",\n    COUNT(*) AS \"TOTAL_MOVIES\",\n    ROUND(\n        100.0 * SUM(CASE WHEN ef.\"MID\" IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*),\n        2\n    ) AS \"PERCENTAGE_EXCLUSIVELY_FEMALE\"\nFROM movie_years my\nLEFT JOIN exclusively_female ef ON my.\"MID\" = ef.\"MID\"\nGROUP BY my.\"YEAR\"\nORDER BY my.\"YEAR\";" := by
  first | sql_equiv | sorry

