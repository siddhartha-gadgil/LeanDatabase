import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq075 — crossskill equivalence(s)

Question: Could you provide a combined 2021 report comparing racial (Asian, Black, Hispanic/Latinx, White) and gender (U.S. Women, U.S. Men) distributions across Google’s overall workforce hiring, Google’s overall workforce representation, and the BLS data specifically for the technology sectors defined as Internet publishing and broadcasting and web search portals or Computer systems design and related services?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq075

CREATE TABLE CPSAAT18 («year» INT, «sector» STRING, «subsector» STRING, «industry_group» STRING, «industry» STRING, «total_employed_in_thousands» INT, «percent_women» FLOAT, «percent_white» FLOAT, «percent_black_or_african_american» FLOAT, «percent_asian» FLOAT, «percent_hispanic_or_latino» FLOAT)
CREATE TABLE DAR_NON_INTERSECTIONAL_REPRESENTATION («workforce» STRING, «report_year» INT, «race_asian» FLOAT, «race_black» FLOAT, «race_hispanic_latinx» FLOAT, «race_native_american» FLOAT, «race_white» FLOAT, «gender_us_women» FLOAT, «gender_us_men» FLOAT, «gender_global_women» FLOAT, «gender_global_men» FLOAT)
CREATE TABLE DAR_NON_INTERSECTIONAL_HIRING («workforce» STRING, «report_year» INT, «race_asian» FLOAT, «race_black» FLOAT, «race_hispanic_latinx» FLOAT, «race_native_american» FLOAT, «race_white» FLOAT, «gender_us_women» FLOAT, «gender_us_men» FLOAT, «gender_global_women» FLOAT, «gender_global_men» FLOAT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([CPSAAT18_schema, DAR_NON_INTERSECTIONAL_REPRESENTATION_schema, DAR_NON_INTERSECTIONAL_HIRING_schema]) "WITH representation AS (SELECT '2021 Google Workforce Representation' AS data_source, \"race_asian\", \"race_black\", \"race_hispanic_latinx\", \"race_white\", \"gender_us_women\", \"gender_us_men\" FROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_REPRESENTATION\" WHERE \"report_year\" = 2021 AND \"workforce\" = 'overall'), hiring AS (SELECT '2021 Google Hiring' AS data_source, \"race_asian\", \"race_black\", \"race_hispanic_latinx\", \"race_white\", \"gender_us_women\", \"gender_us_men\" FROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_HIRING\" WHERE \"report_year\" = 2021 AND \"workforce\" = 'overall'), bls AS (SELECT CASE WHEN \"subsector\" = 'Internet publishing and broadcasting and web search portals' THEN '2021 BLS Industry - Internet publishing and broadcasting and web search portals' WHEN \"industry_group\" = 'Computer systems design and related services' THEN '2021 BLS Industry - Computer systems design and related services' END AS data_source, \"percent_asian\" AS race_asian, \"percent_black_or_african_american\" AS race_black, \"percent_hispanic_or_latino\" AS race_hispanic_latinx, \"percent_white\" AS race_white, \"percent_women\" AS gender_us_women, 1 - \"percent_women\" AS gender_us_men FROM \"GOOGLE_DEI\".\"BLS\".\"CPSAAT18\" WHERE \"year\" = 2021 AND (\"subsector\" = 'Internet publishing and broadcasting and web search portals' OR \"industry_group\" = 'Computer systems design and related services')) SELECT * FROM representation UNION ALL SELECT * FROM hiring UNION ALL SELECT * FROM bls ORDER BY CASE data_source WHEN '2021 Google Workforce Representation' THEN 1 WHEN '2021 Google Hiring' THEN 2 WHEN '2021 BLS Industry - Internet publishing and broadcasting and web search portals' THEN 3 WHEN '2021 BLS Industry - Computer systems design and related services' THEN 4 END" = sql%([CPSAAT18_schema, DAR_NON_INTERSECTIONAL_REPRESENTATION_schema, DAR_NON_INTERSECTIONAL_HIRING_schema]) "/* Google overall workforce representation (2021) */ SELECT '2021 Google Workforce Representation' AS data_source, \"race_asian\", \"race_black\", \"race_hispanic_latinx\", \"race_white\", \"gender_us_women\", \"gender_us_men\" FROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_REPRESENTATION\" WHERE \"report_year\" = 2021 AND \"workforce\" = 'overall' UNION ALL /* Google overall workforce hiring (2021) */ SELECT '2021 Google Hiring' AS data_source, \"race_asian\", \"race_black\", \"race_hispanic_latinx\", \"race_white\", \"gender_us_women\", \"gender_us_men\" FROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_HIRING\" WHERE \"report_year\" = 2021 AND \"workforce\" = 'overall' UNION ALL /* BLS: Internet publishing and broadcasting and web search portals (2021) */ SELECT '2021 BLS Industry - Internet publishing and broadcasting and web search portals' AS data_source, \"percent_asian\" AS race_asian, \"percent_black_or_african_american\" AS race_black, \"percent_hispanic_or_latino\" AS race_hispanic_latinx, \"percent_white\" AS race_white, \"percent_women\" AS gender_us_women, ROUND(1 - \"percent_women\", 3) AS gender_us_men FROM \"GOOGLE_DEI\".\"BLS\".\"CPSAAT18\" WHERE \"year\" = 2021 AND \"subsector\" = 'Internet publishing and broadcasting and web search portals' UNION ALL /* BLS: Computer systems design and related services (2021) */ SELECT '2021 BLS Industry - Computer systems design and related services' AS data_source, \"percent_asian\" AS race_asian, \"percent_black_or_african_american\" AS race_black, \"percent_hispanic_or_latino\" AS race_hispanic_latinx, \"percent_white\" AS race_white, \"percent_women\" AS gender_us_women, ROUND(1 - \"percent_women\", 3) AS gender_us_men FROM \"GOOGLE_DEI\".\"BLS\".\"CPSAAT18\" WHERE \"year\" = 2021 AND \"industry_group\" = 'Computer systems design and related services'" := by
  first | sql_equiv | sorry

