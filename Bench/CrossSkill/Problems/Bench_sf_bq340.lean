/-!
# sf_bq340 — crossskill equivalence(s)

Question: Which six Ethereum addresses, excluding '0x0000000000000000000000000000000000000000', have the largest absolute differences between their previous and current balances from the tokens at addresses '0x0d8775f648430679a709e98d2b0cb6250d2887ef0' and '0x1e15c05cbad367f044cbfbafda3d9a1510db5513'?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq340

CREATE TABLE TOKEN_TRANSFERS («token_address» STRING, «from_address» STRING, «to_address» STRING, «value» STRING, «transaction_hash» STRING, «log_index» INT, «block_timestamp» INT, «block_number» INT, «block_hash» STRING)

HYPOTHESIS hyp0_1_0 : TOKEN_TRANSFERS "\"token_address\" IN (\n    '0x0d8775f648430679a709e98d2b0cb6250d2887ef0',\n    '0x1e15c05cbad367f044cbfbafda3d9a1510db5513'\n  )"
theorem eq_0_1 (t : TableRel TOKEN_TRANSFERS_schema) (h0 : hyp0_1_0 t) :
    (sql%([TOKEN_TRANSFERS_schema]) "WITH all_transfers AS (\n  SELECT \"to_address\" AS addr,\n         CAST(\"value\" AS NUMBER(38,0)) AS val,\n         \"block_number\",\n         \"log_index\"\n  FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\"\n  WHERE \"token_address\" IN (\n    '0x0d8775f648430679a709e98d2b0cb6250d2887ef0',\n    '0x1e15c05cbad367f044cbfbafda3d9a1510db5513'\n  )\n  UNION ALL\n  SELECT \"from_address\" AS addr,\n         CAST(\"value\" AS NUMBER(38,0)) AS val,\n         \"block_number\",\n         \"log_index\"\n  FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\"\n  WHERE \"token_address\" IN (\n    '0x0d8775f648430679a709e98d2b0cb6250d2887ef0',\n    '0x1e15c05cbad367f044cbfbafda3d9a1510db5513'\n  )\n),\nranked AS (\n  SELECT addr,\n         val,\n         ROW_NUMBER() OVER (\n           PARTITION BY addr\n           ORDER BY \"block_number\" DESC, \"log_index\" DESC\n         ) AS rn\n  FROM all_transfers\n  WHERE addr != '0x0000000000000000000000000000000000000000'\n)\nSELECT addr AS ADDRESS\nFROM ranked\nWHERE rn = 1\nORDER BY val DESC\nLIMIT 6;") t ~= (sql%([TOKEN_TRANSFERS_schema]) "-- For each transfer, unpack into per-address balance events\n-- Compute running balance (previous and current) for each address per token\n-- Take the LAST event per address, rank by absolute difference, return top 6\nWITH events AS (\n  -- Receiver gains value\n  SELECT \"to_address\" AS address, \"token_address\", \"block_number\", \"log_index\",\n         CAST(\"value\" AS NUMBER(38,0)) AS delta\n  FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\"\n  WHERE \"token_address\" IN (\n    '0x0d8775f648430679a709e98d2b0cb6250d2887ef0',\n    '0x1e15c05cbad367f044cbfbafda3d9a1510db5513'\n  )\n  AND \"to_address\" != '0x0000000000000000000000000000000000000000'\n  UNION ALL\n  -- Sender loses value\n  SELECT \"from_address\" AS address, \"token_address\", \"block_number\", \"log_index\",\n         -CAST(\"value\" AS NUMBER(38,0)) AS delta\n  FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\"\n  WHERE \"token_address\" IN (\n    '0x0d8775f648430679a709e98d2b0cb6250d2887ef0',\n    '0x1e15c05cbad367f044cbfbafda3d9a1510db5513'\n  )\n  AND \"from_address\" != '0x0000000000000000000000000000000000000000'\n),\nrunning AS (\n  SELECT address, \"token_address\", \"block_number\", \"log_index\", delta,\n         SUM(delta) OVER (\n           PARTITION BY address, \"token_address\"\n           ORDER BY \"block_number\", \"log_index\"\n         ) AS current_balance,\n         SUM(delta) OVER (\n           PARTITION BY address, \"token_address\"\n           ORDER BY \"block_number\", \"log_index\"\n         ) - delta AS previous_balance,\n         ROW_NUMBER() OVER (\n           PARTITION BY address, \"token_address\"\n           ORDER BY \"block_number\" DESC, \"log_index\" DESC\n         ) AS rn\n  FROM events\n),\nlast_event AS (\n  SELECT address,\n         previous_balance,\n         current_balance,\n         ABS(current_balance - previous_balance) AS abs_diff\n  FROM running\n  WHERE rn = 1\n)\nSELECT address AS ADDRESS\nFROM last_event\nORDER BY abs_diff DESC\nLIMIT 6;") t := by
  first | sql_equiv | sorry

