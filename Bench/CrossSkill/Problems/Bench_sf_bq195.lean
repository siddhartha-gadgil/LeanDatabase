import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq195 — crossskill equivalence(s)

Question: What are the top 10 Ethereum addresses by balance, considering both value transactions and gas fees, before September 1, 2021? Only keep successful transactions with no call type or where the call type is 'call'.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq195

CREATE TABLE TRANSACTIONS («block_height» INT, «block_timestamp» STRING, «block_timestamp_truncated» INT, «txhash» STRING, «transaction_type» STRING, «gas_wanted» INT, «gas_used» INT, «sender» STRING, «fee» STRING, «memo» STRING)
CREATE TABLE TRACES («transaction_hash» STRING, «transaction_index» INT, «from_address» STRING, «to_address» STRING, «value» INT, «input» STRING, «output» STRING, «trace_type» STRING, «call_type» STRING, «reward_type» STRING, «gas» INT, «gas_used» INT, «subtraces» INT, «trace_address» STRING, «error» STRING, «status» INT, «block_timestamp» INT, «block_number» INT, «block_hash» STRING, «trace_id» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_values AS (\n    -- Get value flows from successful traces with call_type IS NULL or 'call'\n    -- before Sept 1, 2021\n    SELECT \n        \"to_address\" AS address,\n        CAST(\"value\" AS DECIMAL(38,0)) AS value_in,\n        0 AS value_out\n    FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n    WHERE \"status\" = 1\n      AND (\"call_type\" IS NULL OR \"call_type\" = 'call')\n      AND \"block_timestamp\" < 1630454400000000\n      AND \"to_address\" IS NOT NULL\n      AND \"value\" > 0\n    \n    UNION ALL\n    \n    SELECT \n        \"from_address\" AS address,\n        0 AS value_in,\n        CAST(\"value\" AS DECIMAL(38,0)) AS value_out\n    FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n    WHERE \"status\" = 1\n      AND (\"call_type\" IS NULL OR \"call_type\" = 'call')\n      AND \"block_timestamp\" < 1630454400000000\n      AND \"from_address\" IS NOT NULL\n      AND \"value\" > 0\n),\ngas_fees AS (\n    -- Gas fees are charged to the transaction sender (from_address)\n    SELECT \n        \"from_address\" AS address,\n        CAST(\"gas_price\" AS DECIMAL(38,0)) * CAST(\"receipt_gas_used\" AS DECIMAL(38,0)) AS gas_fee\n    FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\"\n    WHERE \"block_timestamp\" < 1630454400000000\n      AND \"receipt_status\" = 1\n),\nbalance_calc AS (\n    SELECT \n        address,\n        SUM(value_in) - SUM(value_out) AS net_value\n    FROM trace_values\n    GROUP BY address\n),\ngas_calc AS (\n    SELECT \n        address,\n        SUM(gas_fee) AS total_gas\n    FROM gas_fees\n    GROUP BY address\n),\nfinal_balance AS (\n    SELECT \n        COALESCE(b.address, g.address) AS ADDRESS,\n        COALESCE(b.net_value, 0) - COALESCE(g.total_gas, 0) AS BALANCE\n    FROM balance_calc b\n    FULL OUTER JOIN gas_calc g ON b.address = g.address\n)\nSELECT ADDRESS, CAST(BALANCE AS DECIMAL(38,9)) AS BALANCE\nFROM final_balance\nORDER BY BALANCE DESC\nLIMIT 10;") t ~= (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_values AS (\n    SELECT\n        \"to_address\" AS address,\n        CAST(\"value\" AS NUMBER(38,9)) AS value_change\n    FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n    WHERE \"block_timestamp\" < 1630454400000000\n      AND \"status\" = 1\n      AND (\"call_type\" IS NULL OR \"call_type\" = 'call')\n      AND \"to_address\" IS NOT NULL\n\n    UNION ALL\n\n    SELECT\n        \"from_address\" AS address,\n        -CAST(\"value\" AS NUMBER(38,9)) AS value_change\n    FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n    WHERE \"block_timestamp\" < 1630454400000000\n      AND \"status\" = 1\n      AND (\"call_type\" IS NULL OR \"call_type\" = 'call')\n      AND \"from_address\" IS NOT NULL\n\n    UNION ALL\n\n    SELECT\n        \"from_address\" AS address,\n        -CAST(\"gas_price\" AS NUMBER(38,9)) * CAST(\"receipt_gas_used\" AS NUMBER(38,9)) AS value_change\n    FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\"\n    WHERE \"block_timestamp\" < 1630454400000000\n      AND \"receipt_status\" = 1\n      AND \"from_address\" IS NOT NULL\n)\nSELECT\n    address AS ADDRESS,\n    CAST(SUM(value_change) AS NUMBER(38,9)) AS BALANCE\nFROM trace_values\nGROUP BY address\nORDER BY BALANCE DESC\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

