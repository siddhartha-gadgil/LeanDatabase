import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq195 — crossskill equivalence(s)

Question: What are the top 10 Ethereum addresses by balance, considering both value transactions and gas fees, before September 1, 2021? Only keep successful transactions with no call type or where the call type is 'call'.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq195

CREATE TABLE TRANSACTIONS («block_height» INT, «block_timestamp» STRING, «block_timestamp_truncated» INT, «txhash» STRING, «transaction_type» STRING, «gas_wanted» INT, «gas_used» INT, «sender» STRING, «fee» STRING, «memo» STRING)
CREATE TABLE TRACES («transaction_hash» STRING, «transaction_index» INT, «from_address» STRING, «to_address» STRING, «value» INT, «input» STRING, «output» STRING, «trace_type» STRING, «call_type» STRING, «reward_type» STRING, «gas» INT, «gas_used» INT, «subtraces» INT, «trace_address» STRING, «error» STRING, «status» INT, «block_timestamp» INT, «block_number» INT, «block_hash» STRING, «trace_id» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_values AS (/* Get value flows from successful traces with call_type IS NULL or 'call' */ /* before Sept 1, 2021 */ SELECT \"to_address\" AS address, CAST(\"value\" AS DECIMAL(38, 0)) AS value_in, 0 AS value_out FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"to_address\" IS NULL AND \"value\" > 0 UNION ALL SELECT \"from_address\" AS address, 0 AS value_in, CAST(\"value\" AS DECIMAL(38, 0)) AS value_out FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"from_address\" IS NULL AND \"value\" > 0), gas_fees AS (/* Gas fees are charged to the transaction sender (from_address) */ SELECT \"from_address\" AS address, CAST(\"gas_price\" AS DECIMAL(38, 0)) * CAST(\"receipt_gas_used\" AS DECIMAL(38, 0)) AS gas_fee FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\" WHERE \"block_timestamp\" < 1630454400000000 AND \"receipt_status\" = 1), balance_calc AS (SELECT address, SUM(value_in) - SUM(value_out) AS net_value FROM trace_values GROUP BY address), gas_calc AS (SELECT address, SUM(gas_fee) AS total_gas FROM gas_fees GROUP BY address), final_balance AS (SELECT COALESCE(b.address, g.address) AS ADDRESS, COALESCE(b.net_value, 0) - COALESCE(g.total_gas, 0) AS BALANCE FROM balance_calc AS b FULL OUTER JOIN gas_calc AS g ON b.address = g.address) SELECT ADDRESS, CAST(BALANCE AS DECIMAL(38, 9)) AS BALANCE FROM final_balance ORDER BY BALANCE DESC LIMIT 10") t ~= (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_values AS (SELECT \"to_address\" AS address, CAST(\"value\" AS DECIMAL(38, 9)) AS value_change FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"block_timestamp\" < 1630454400000000 AND \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND NOT \"to_address\" IS NULL UNION ALL SELECT \"from_address\" AS address, -CAST(\"value\" AS DECIMAL(38, 9)) AS value_change FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"block_timestamp\" < 1630454400000000 AND \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND NOT \"from_address\" IS NULL UNION ALL SELECT \"from_address\" AS address, -CAST(\"gas_price\" AS DECIMAL(38, 9)) * CAST(\"receipt_gas_used\" AS DECIMAL(38, 9)) AS value_change FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\" WHERE \"block_timestamp\" < 1630454400000000 AND \"receipt_status\" = 1 AND NOT \"from_address\" IS NULL) SELECT address AS ADDRESS, CAST(SUM(value_change) AS DECIMAL(38, 9)) AS BALANCE FROM trace_values GROUP BY address ORDER BY BALANCE DESC LIMIT 10") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_values AS (/* Get value flows from successful traces with call_type IS NULL or 'call' */ /* before Sept 1, 2021 */ SELECT \"to_address\" AS address, CAST(\"value\" AS DECIMAL(38, 0)) AS value_in, 0 AS value_out FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"to_address\" IS NULL AND \"value\" > 0 UNION ALL SELECT \"from_address\" AS address, 0 AS value_in, CAST(\"value\" AS DECIMAL(38, 0)) AS value_out FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"from_address\" IS NULL AND \"value\" > 0), gas_fees AS (/* Gas fees are charged to the transaction sender (from_address) */ SELECT \"from_address\" AS address, CAST(\"gas_price\" AS DECIMAL(38, 0)) * CAST(\"receipt_gas_used\" AS DECIMAL(38, 0)) AS gas_fee FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\" WHERE \"block_timestamp\" < 1630454400000000 AND \"receipt_status\" = 1), balance_calc AS (SELECT address, SUM(value_in) - SUM(value_out) AS net_value FROM trace_values GROUP BY address), gas_calc AS (SELECT address, SUM(gas_fee) AS total_gas FROM gas_fees GROUP BY address), final_balance AS (SELECT COALESCE(b.address, g.address) AS ADDRESS, COALESCE(b.net_value, 0) - COALESCE(g.total_gas, 0) AS BALANCE FROM balance_calc AS b FULL OUTER JOIN gas_calc AS g ON b.address = g.address) SELECT ADDRESS, CAST(BALANCE AS DECIMAL(38, 9)) AS BALANCE FROM final_balance ORDER BY BALANCE DESC LIMIT 10") t ~= (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_values AS (/* Value received by to_address */ SELECT \"to_address\" AS address, SUM(\"value\") AS net_value FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"to_address\" IS NULL GROUP BY \"to_address\" UNION ALL /* Value sent by from_address (negative) */ SELECT \"from_address\" AS address, -SUM(\"value\") AS net_value FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"from_address\" IS NULL GROUP BY \"from_address\"), gas_fees AS (/* Gas fees paid by from_address (negative impact on balance) */ SELECT \"from_address\" AS address, -SUM(CAST(\"gas_price\" AS DECIMAL(38, 0)) * CAST(\"receipt_gas_used\" AS DECIMAL(38, 0))) AS gas_cost FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\" WHERE \"receipt_status\" = 1 AND \"block_timestamp\" < 1630454400000000 AND NOT \"from_address\" IS NULL GROUP BY \"from_address\"), combined AS (SELECT address, net_value AS amount FROM trace_values UNION ALL SELECT address, gas_cost AS amount FROM gas_fees) SELECT address AS ADDRESS, SUM(amount) AS BALANCE FROM combined GROUP BY address ORDER BY BALANCE DESC LIMIT 10") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_3 : ∀ t,
    (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_values AS (/* Get value flows from successful traces with call_type IS NULL or 'call' */ /* before Sept 1, 2021 */ SELECT \"to_address\" AS address, CAST(\"value\" AS DECIMAL(38, 0)) AS value_in, 0 AS value_out FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"to_address\" IS NULL AND \"value\" > 0 UNION ALL SELECT \"from_address\" AS address, 0 AS value_in, CAST(\"value\" AS DECIMAL(38, 0)) AS value_out FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"from_address\" IS NULL AND \"value\" > 0), gas_fees AS (/* Gas fees are charged to the transaction sender (from_address) */ SELECT \"from_address\" AS address, CAST(\"gas_price\" AS DECIMAL(38, 0)) * CAST(\"receipt_gas_used\" AS DECIMAL(38, 0)) AS gas_fee FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\" WHERE \"block_timestamp\" < 1630454400000000 AND \"receipt_status\" = 1), balance_calc AS (SELECT address, SUM(value_in) - SUM(value_out) AS net_value FROM trace_values GROUP BY address), gas_calc AS (SELECT address, SUM(gas_fee) AS total_gas FROM gas_fees GROUP BY address), final_balance AS (SELECT COALESCE(b.address, g.address) AS ADDRESS, COALESCE(b.net_value, 0) - COALESCE(g.total_gas, 0) AS BALANCE FROM balance_calc AS b FULL OUTER JOIN gas_calc AS g ON b.address = g.address) SELECT ADDRESS, CAST(BALANCE AS DECIMAL(38, 9)) AS BALANCE FROM final_balance ORDER BY BALANCE DESC LIMIT 10") t ~= (sql%([TRANSACTIONS_schema, TRACES_schema]) "WITH trace_balances AS (SELECT \"address\", SUM(\"value\") AS \"balance\" FROM (/* Value received via traces (to_address) */ SELECT \"to_address\" AS \"address\", \"value\" FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"to_address\" IS NULL UNION ALL /* Value sent via traces (from_address) - negative */ SELECT \"from_address\" AS \"address\", -\"value\" FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\" WHERE \"status\" = 1 AND (\"call_type\" IS NULL OR \"call_type\" = 'call') AND \"block_timestamp\" < 1630454400000000 AND NOT \"from_address\" IS NULL) AS t GROUP BY \"address\"), gas_fees AS (/* Gas fees paid by from_address in transactions */ SELECT \"from_address\" AS \"address\", -SUM(\"gas_price\" * \"receipt_gas_used\") AS \"gas_balance\" FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRANSACTIONS\" WHERE \"receipt_status\" = 1 AND \"block_timestamp\" < 1630454400000000 AND NOT \"from_address\" IS NULL GROUP BY \"from_address\"), combined AS (SELECT COALESCE(tb.\"address\", gf.\"address\") AS \"ADDRESS\", COALESCE(tb.\"balance\", 0) + COALESCE(gf.\"gas_balance\", 0) AS \"BALANCE\" FROM trace_balances AS tb FULL OUTER JOIN gas_fees AS gf ON tb.\"address\" = gf.\"address\") SELECT \"ADDRESS\", \"BALANCE\" FROM combined ORDER BY \"BALANCE\" DESC LIMIT 10") t := by
  intro t; first | sql_equiv | sorry

