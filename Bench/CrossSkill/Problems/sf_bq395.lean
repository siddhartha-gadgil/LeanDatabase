theorem eq_0_1 : ∀ t,
    (sql%([HUD_PIT_BY_COC_schema]) "WITH state_totals AS (SELECT LEFT(\"CoC_Number\", 2) AS \"State_Abbr\", SUM(CASE WHEN \"Count_Year\" = 2015 THEN COALESCE(\"Unsheltered_Homeless\", 0) ELSE 0 END) AS unsheltered_2015, SUM(CASE WHEN \"Count_Year\" = 2018 THEN COALESCE(\"Unsheltered_Homeless\", 0) ELSE 0 END) AS unsheltered_2018 FROM \"SDOH\".\"SDOH_HUD_PIT_HOMELESSNESS\".\"HUD_PIT_BY_COC\" WHERE \"Count_Year\" IN (2015, 2018) GROUP BY LEFT(\"CoC_Number\", 2) HAVING SUM(CASE WHEN \"Count_Year\" = 2015 THEN 1 ELSE 0 END) > 0 AND SUM(CASE WHEN \"Count_Year\" = 2018 THEN 1 ELSE 0 END) > 0), pct_changes AS (SELECT \"State_Abbr\", CAST((unsheltered_2018 - unsheltered_2015) * 100.0 AS DOUBLE PRECISION) / unsheltered_2015 AS pct_change FROM state_totals WHERE unsheltered_2015 > 0), national_avg AS (SELECT AVG(pct_change) AS avg_pct_change FROM pct_changes) SELECT p.\"State_Abbr\" FROM pct_changes AS p CROSS JOIN national_avg AS n ORDER BY ABS(p.pct_change - n.avg_pct_change) ASC LIMIT 5") t ~= (sql%([HUD_PIT_BY_COC_schema]) "WITH state_year AS (SELECT LEFT(\"CoC_Number\", 2) AS state, \"Count_Year\", SUM(\"Unsheltered_Homeless\") AS total_unsheltered FROM \"SDOH\".\"SDOH_HUD_PIT_HOMELESSNESS\".\"HUD_PIT_BY_COC\" WHERE \"Count_Year\" IN (2015, 2018) GROUP BY LEFT(\"CoC_Number\", 2), \"Count_Year\"), pivoted AS (SELECT state, MAX(CASE WHEN \"Count_Year\" = 2015 THEN total_unsheltered END) AS unsheltered_2015, MAX(CASE WHEN \"Count_Year\" = 2018 THEN total_unsheltered END) AS unsheltered_2018 FROM state_year GROUP BY state), pct_change AS (SELECT state, CAST((unsheltered_2018 - unsheltered_2015) * 100.0 AS DOUBLE PRECISION) / unsheltered_2015 AS pct_change FROM pivoted WHERE unsheltered_2015 > 0 AND NOT unsheltered_2015 IS NULL AND NOT unsheltered_2018 IS NULL), national_avg AS (SELECT AVG(pct_change) AS avg_pct_change FROM pct_change) SELECT p.state AS \"State_Abbr\" FROM pct_change AS p CROSS JOIN national_avg AS n ORDER BY ABS(p.pct_change - n.avg_pct_change) ASC LIMIT 5") t := by
