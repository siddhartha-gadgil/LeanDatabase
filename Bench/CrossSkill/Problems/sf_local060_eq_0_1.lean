ALESCE(ps.total_product_sales, 0) DESC) AS rn FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p LEFT JOIN product_overall_sales AS ps ON p.\"prod_id\" = ps.\"prod_id\"), top_products AS (/* Step 5: Take top 20% = FLOOR(total_products * 0.2) */ SELECT \"prod_id\", \"prod_name\" FROM all_products_ranked WHERE rn <= FLOOR((SELECT COUNT(*) FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\") * 0.2)), product_quarterly_sales AS (/* Step 6: Compute each top product's sales per quarter in qualifying cities */ SELECT tp.\"prod_id\", tp.\"prod_name\", t.\"calendar_year\", SUM(s.\"amount_sold\") AS product_quarter_sales FROM top_products AS tp JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s ON tp.\"prod_id\" = s.\"prod_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN cities_with_growth AS cg ON c.\"cust_city\" = cg.\"cust_city\" WHERE c.\"country_id\" = 52790 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND s.\"promo_id\" = 999 GROUP BY tp.\"prod_id\", tp.\"prod_name\", t.\"calendar_year\"), total_quarterly_sales AS (/* Step 7: Total sales per quarter in qualifying cities (denominator for share) */ SELECT t.\"calendar_year\", SUM(s.\"amount_sold\") AS total_quarter_sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN cities_with_growth AS cg ON c.\"cust_city\" = cg.\"cust_city\" WHERE c.\"country_id\" = 52790 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND s.\"promo_id\" = 999 GROUP BY t.\"calendar_year\"), shares AS (/* Step 8: Compute share per product per quarter */ SELECT pqs.\"prod_id\", pqs.\"prod_name\", pqs.\"calendar_year\", CAST(pqs.product_quarter_sales AS DOUBLE PRECISION) / tqs.total_quarter_sales AS share FROM product_quarterly_sales AS pqs JOIN total_quarterly_sales AS tqs ON pqs.\"calendar_year\" = tqs.\"calendar_year\") /* Step 9: Pivot and compute share change */ SELECT s2019.\"prod_id\", s2019.\"prod_name\", s2019.share AS SHARE_2019, s2020.share AS SHARE_2020, (s2020.share - s2019.share) AS SHARE_CHANGE FROM shares AS s2019 JOIN shares AS s2020 ON s2019.\"prod_id\" = s2020.\"prod_id\" WHERE s2019.\"calendar_year\" = 2019 AND s2020.\"calendar_year\" = 2020 ORDER BY SHARE_CHANGE DESC") t0 t1 t2 t3 t4
