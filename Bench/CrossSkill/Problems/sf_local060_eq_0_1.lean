uct_total_sales AS pt), top_products AS (SELECT * FROM product_ranked WHERE rnk <= CEIL(0.2 * cnt)) SELECT tp.\"prod_id\", p.\"prod_name\", CAST(tp.sales_2019 AS DOUBLE PRECISION) / tas.total_2019 AS SHARE_2019, CAST(tp.sales_2020 AS DOUBLE PRECISION) / tas.total_2020 AS SHARE_2020, (CAST(tp.sales_2020 AS DOUBLE PRECISION) / tas.total_2020) - (CAST(tp.sales_2019 AS DOUBLE PRECISION) / tas.total_2019) AS SHARE_CHANGE FROM top_products AS tp CROSS JOIN total_all_sales AS tas JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON tp.\"prod_id\" = p.\"prod_id\" ORDER BY SHARE_CHANGE DESC") t0 t1 t2 t3 t4
