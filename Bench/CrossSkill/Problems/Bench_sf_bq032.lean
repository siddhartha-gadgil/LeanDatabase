HYPOTHESIS hyp0_1_0 : HURRICANES "\"basin\" = 'NA'"
theorem eq_0_1 (t : TableRel HURRICANES_schema) (h0 : hyp0_1_0 t) :
    (sql%([HURRICANES_schema]) "-- Find the latitude of the final coordinates for the hurricane that traveled\n-- the second longest distance in the North Atlantic during 2020\nWITH hurricane_sids AS (\n  -- Identify storms that reached hurricane status (usa_status = 'HU') in NA basin, 2020\n  SELECT DISTINCT \"sid\"\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"basin\" = 'NA'\n    AND \"season\" = '2020'\n    AND \"usa_status\" = 'HU'\n),\ntrack_with_prev AS (\n  -- Get entire track for each hurricane storm, with previous point coordinates\n  SELECT\n    h.\"sid\",\n    h.\"name\",\n    h.\"latitude\",\n    h.\"longitude\",\n    h.\"iso_time\",\n    LAG(h.\"longitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lon,\n    LAG(h.\"latitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lat\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" h\n  INNER JOIN hurricane_sids hs ON h.\"sid\" = hs.\"sid\"\n),\nsegment_distances AS (\n  -- Calculate distance between consecutive track points\n  SELECT\n    \"sid\",\n    \"name\",\n    CASE\n      WHEN prev_lat IS NOT NULL\n      THEN ST_DISTANCE(\n        ST_MAKEPOINT(\"longitude\", \"latitude\"),\n        ST_MAKEPOINT(prev_lon, prev_lat)\n      )\n      ELSE 0\n    END AS segment_dist\n  FROM track_with_prev\n),\ntotal_distances AS (\n  -- Sum distances per storm\n  SELECT\n    \"sid\",\n    \"name\",\n    SUM(segment_dist) AS total_distance\n  FROM segment_distances\n  GROUP BY \"sid\", \"name\"\n),\nranked AS (\n  -- Rank by total distance descending\n  SELECT\n    \"sid\",\n    \"name\",\n    total_distance,\n    ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rn\n  FROM total_distances\n),\nsecond_longest AS (\n  -- Get the storm with the second longest distance\n  SELECT \"sid\"\n  FROM ranked\n  WHERE rn = 2\n),\nfinal_point AS (\n  -- Get the final coordinates (last record by iso_time) for that storm\n  SELECT\n    h.\"latitude\",\n    ROW_NUMBER() OVER (ORDER BY h.\"iso_time\" DESC) AS rn\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" h\n  INNER JOIN second_longest sl ON h.\"sid\" = sl.\"sid\"\n)\nSELECT \"latitude\" AS \"OUTPUT\"\nFROM final_point\nWHERE rn = 1;") t ~= (sql%([HURRICANES_schema]) "-- Find the latitude of the final coordinates for the hurricane that traveled\n-- the second longest distance in the North Atlantic during 2020.\n-- Distance is computed as total path distance (sum of consecutive segment distances).\n\nWITH ordered_points AS (\n  SELECT\n    \"sid\",\n    \"iso_time\",\n    \"latitude\",\n    \"longitude\",\n    LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat,\n    LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"season\" = '2020' AND \"basin\" = 'NA'\n),\nhurricane_distances AS (\n  SELECT\n    \"sid\",\n    SUM(ST_DISTANCE(\n      ST_MAKEPOINT(\"longitude\", \"latitude\"),\n      ST_MAKEPOINT(prev_lon, prev_lat)\n    )) AS total_distance\n  FROM ordered_points\n  WHERE prev_lat IS NOT NULL\n  GROUP BY \"sid\"\n  ORDER BY total_distance DESC\n  LIMIT 2\n),\nsecond_longest AS (\n  SELECT \"sid\"\n  FROM (\n    SELECT \"sid\", total_distance,\n      ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rn\n    FROM hurricane_distances\n  )\n  WHERE rn = 2\n),\nfinal_point AS (\n  SELECT\n    h.\"latitude\" AS OUTPUT,\n    ROW_NUMBER() OVER (ORDER BY h.\"iso_time\" DESC) AS rn\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" h\n  JOIN second_longest s ON h.\"sid\" = s.\"sid\"\n)\nSELECT OUTPUT\nFROM final_point\nWHERE rn = 1;") t := by
  first | sql_equiv | sorry

