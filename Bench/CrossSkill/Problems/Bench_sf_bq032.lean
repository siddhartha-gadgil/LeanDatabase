HYPOTHESIS hyp0_1_0 : HURRICANES "\"basin\" = 'NA'"
theorem eq_0_1 (t : TableRel HURRICANES_schema) (h0 : hyp0_1_0 t) :
    (sql%([HURRICANES_schema]) "/* Find the latitude of the final coordinates for the hurricane that traveled */ /* the second longest distance in the North Atlantic during 2020 */ WITH hurricane_sids AS (/* Identify storms that reached hurricane status (usa_status = 'HU') in NA basin, 2020 */ SELECT DISTINCT \"sid\" FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" WHERE \"basin\" = 'NA' AND \"season\" = '2020' AND \"usa_status\" = 'HU'), track_with_prev AS (/* Get entire track for each hurricane storm, with previous point coordinates */ SELECT h.\"sid\", h.\"name\", h.\"latitude\", h.\"longitude\", h.\"iso_time\", LAG(h.\"longitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lon, LAG(h.\"latitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lat FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" AS h INNER JOIN hurricane_sids AS hs ON h.\"sid\" = hs.\"sid\"), segment_distances AS (/* Calculate distance between consecutive track points */ SELECT \"sid\", \"name\", CASE WHEN NOT prev_lat IS NULL THEN ST_DISTANCE(ST_POINT(\"longitude\", \"latitude\"), ST_POINT(prev_lon, prev_lat)) ELSE 0 END AS segment_dist FROM track_with_prev), total_distances AS (/* Sum distances per storm */ SELECT \"sid\", \"name\", SUM(segment_dist) AS total_distance FROM segment_distances GROUP BY \"sid\", \"name\"), ranked AS (/* Rank by total distance descending */ SELECT \"sid\", \"name\", total_distance, ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rn FROM total_distances), second_longest AS (/* Get the storm with the second longest distance */ SELECT \"sid\" FROM ranked WHERE rn = 2), final_point AS (/* Get the final coordinates (last record by iso_time) for that storm */ SELECT h.\"latitude\", ROW_NUMBER() OVER (ORDER BY h.\"iso_time\" DESC) AS rn FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" AS h INNER JOIN second_longest AS sl ON h.\"sid\" = sl.\"sid\") SELECT \"latitude\" AS \"OUTPUT\" FROM final_point WHERE rn = 1") t ~= (sql%([HURRICANES_schema]) "/* Find the latitude of the final coordinates for the hurricane that traveled */ /* the second longest distance in the North Atlantic during 2020. */ /* Distance is computed as total path distance (sum of consecutive segment distances). */ WITH ordered_points AS (SELECT \"sid\", \"iso_time\", \"latitude\", \"longitude\", LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat, LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" WHERE \"season\" = '2020' AND \"basin\" = 'NA'), hurricane_distances AS (SELECT \"sid\", SUM(ST_DISTANCE(ST_POINT(\"longitude\", \"latitude\"), ST_POINT(prev_lon, prev_lat))) AS total_distance FROM ordered_points WHERE NOT prev_lat IS NULL GROUP BY \"sid\" ORDER BY total_distance DESC LIMIT 2), second_longest AS (SELECT \"sid\" FROM (SELECT \"sid\", total_distance, ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rn FROM hurricane_distances) WHERE rn = 2), final_point AS (SELECT h.\"latitude\" AS OUTPUT, ROW_NUMBER() OVER (ORDER BY h.\"iso_time\" DESC) AS rn FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" AS h JOIN second_longest AS s ON h.\"sid\" = s.\"sid\") SELECT OUTPUT FROM final_point WHERE rn = 1") t := by
  first | sql_equiv | sorry

