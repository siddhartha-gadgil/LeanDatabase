/-!
# sf_local100 — crossskill equivalence(s)

Question: Find out how many actors have a 'Shahrukh number' of 2? This means they acted in a film with someone who acted with Shahrukh Khan, but not directly with him.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local100

CREATE TABLE MOVIE («index» INT, «MID» STRING, «title» STRING, «year» STRING, «rating» FLOAT, «num_votes» INT)
CREATE TABLE PERSON («index» INT, «PID» STRING, «Name» STRING, «Gender» STRING)
CREATE TABLE M_CAST («index» INT, «MID» STRING, «PID» STRING, «ID» INT)

theorem eq_0_1 :
    sql%([MOVIE_schema, PERSON_schema, M_CAST_schema]) "WITH srk_movies AS (\n    -- Movies that Shah Rukh Khan acted in\n    SELECT \"MID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\"\n    WHERE \"PID\" = ' nm0451321'\n),\nsrk_coactors AS (\n    -- Shahrukh number 1: actors who directly acted with SRK\n    SELECT DISTINCT mc.\"PID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc\n    JOIN srk_movies sm ON mc.\"MID\" = sm.\"MID\"\n    WHERE mc.\"PID\" != ' nm0451321'\n),\nsrk_number_2 AS (\n    -- Shahrukh number 2: actors who acted with SRK's co-actors\n    -- but NOT directly with SRK himself\n    SELECT DISTINCT mc2.\"PID\"\n    FROM srk_coactors sc\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc1 ON sc.\"PID\" = mc1.\"PID\"\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc2 ON mc1.\"MID\" = mc2.\"MID\"\n    WHERE mc2.\"PID\" NOT IN (SELECT \"PID\" FROM srk_coactors)\n      AND mc2.\"PID\" != ' nm0451321'\n)\nSELECT COUNT(*) AS SHAHRUKH_NUMBER_2_COUNT\nFROM srk_number_2;" = sql%([MOVIE_schema, PERSON_schema, M_CAST_schema]) "-- Find actors with Shahrukh number 2:\n-- Actors who co-acted with someone who co-acted with Shah Rukh Khan,\n-- but did NOT co-act directly with Shah Rukh Khan themselves.\n\nWITH srk_movies AS (\n    -- Movies Shah Rukh Khan appeared in\n    SELECT DISTINCT \"MID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\"\n    WHERE \"PID\" = ' nm0451321'\n),\nsrk_coactors AS (\n    -- Shahrukh number 1: actors who share a movie with SRK\n    SELECT DISTINCT c.\"PID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c\n    JOIN srk_movies m ON c.\"MID\" = m.\"MID\"\n    WHERE c.\"PID\" != ' nm0451321'\n),\nsrk_num2_candidates AS (\n    -- Actors who share a movie with any Shahrukh number 1 actor\n    SELECT DISTINCT c2.\"PID\"\n    FROM srk_coactors s1\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c1 ON s1.\"PID\" = c1.\"PID\"\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c2 ON c1.\"MID\" = c2.\"MID\"\n    WHERE c2.\"PID\" != c1.\"PID\"\n)\nSELECT COUNT(*) AS SHAHRUKH_NUMBER_2_COUNT\nFROM srk_num2_candidates\nWHERE \"PID\" NOT IN (SELECT \"PID\" FROM srk_coactors)\n  AND \"PID\" != ' nm0451321';" := by
  first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([MOVIE_schema, PERSON_schema, M_CAST_schema]) "WITH srk_movies AS (\n    -- Movies that Shah Rukh Khan acted in\n    SELECT \"MID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\"\n    WHERE \"PID\" = ' nm0451321'\n),\nsrk_coactors AS (\n    -- Shahrukh number 1: actors who directly acted with SRK\n    SELECT DISTINCT mc.\"PID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc\n    JOIN srk_movies sm ON mc.\"MID\" = sm.\"MID\"\n    WHERE mc.\"PID\" != ' nm0451321'\n),\nsrk_number_2 AS (\n    -- Shahrukh number 2: actors who acted with SRK's co-actors\n    -- but NOT directly with SRK himself\n    SELECT DISTINCT mc2.\"PID\"\n    FROM srk_coactors sc\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc1 ON sc.\"PID\" = mc1.\"PID\"\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc2 ON mc1.\"MID\" = mc2.\"MID\"\n    WHERE mc2.\"PID\" NOT IN (SELECT \"PID\" FROM srk_coactors)\n      AND mc2.\"PID\" != ' nm0451321'\n)\nSELECT COUNT(*) AS SHAHRUKH_NUMBER_2_COUNT\nFROM srk_number_2;" = sql%([MOVIE_schema, PERSON_schema, M_CAST_schema]) "-- Shahrukh Khan's PID in PERSON table: 'nm0451321'\n-- M_CAST PID has leading space, so we TRIM when joining to PERSON\n\nWITH shahrukh_movies AS (\n    -- Movies Shahrukh Khan appeared in\n    SELECT DISTINCT \"MID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\"\n    WHERE TRIM(\"PID\") = 'nm0451321'\n),\nshahrukh_number_1 AS (\n    -- Actors who co-starred with Shahrukh Khan (Shahrukh number 1)\n    -- Exclude Shahrukh Khan himself\n    SELECT DISTINCT TRIM(c.\"PID\") AS \"PID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c\n    INNER JOIN shahrukh_movies sm ON c.\"MID\" = sm.\"MID\"\n    WHERE TRIM(c.\"PID\") != 'nm0451321'\n),\nsn1_movies AS (\n    -- Movies that Shahrukh number 1 actors appeared in\n    SELECT DISTINCT c.\"MID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c\n    INNER JOIN shahrukh_number_1 sn1 ON TRIM(c.\"PID\") = sn1.\"PID\"\n),\nshahrukh_number_2_candidates AS (\n    -- Actors who co-starred with Shahrukh number 1 actors\n    -- Exclude Shahrukh Khan himself and Shahrukh number 1 actors\n    SELECT DISTINCT TRIM(c.\"PID\") AS \"PID\"\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c\n    INNER JOIN sn1_movies sm ON c.\"MID\" = sm.\"MID\"\n    WHERE TRIM(c.\"PID\") != 'nm0451321'\n      AND TRIM(c.\"PID\") NOT IN (SELECT \"PID\" FROM shahrukh_number_1)\n)\nSELECT COUNT(*) AS \"SHAHRUKH_NUMBER_2_COUNT\"\nFROM shahrukh_number_2_candidates;" := by
  first | sql_equiv | sorry

