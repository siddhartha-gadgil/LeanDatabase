-number-1 actor */ SELECT DISTINCT TRIM(c.\"PID\") AS PID FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" AS c INNER JOIN shahrukh_number_1_movies AS s1m ON TRIM(c.\"MID\") = s1m.MID WHERE TRIM(c.\"PID\") <> 'nm0451321' AND TRIM(c.\"PID\") <> ALL (SELECT PID FROM shahrukh_number_1)) SELECT COUNT(*) AS SHAHRUKH_NUMBER_2_COUNT FROM shahrukh_number_2" := by
