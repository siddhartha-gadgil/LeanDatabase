e page or not?\nhits_with_group AS (\n  SELECT *,\n    CASE WHEN pagePath LIKE '/home%' THEN 1 ELSE 0 END AS is_home,\n    -- For each /home hit, find the time of the next non-home hit\n    LEAD(pagePath) OVER (PARTITION BY \"fullVisitorId\", \"visitId\" ORDER BY hitNumber) AS next_page,\n    LEAD(hit_time) OVER (PARTITION BY \"fullVisitorId\", \"visitId\" ORDER BY hitNumber) AS next_hit_time\n  FROM hits_flat\n),\n-- For the most common next page: get transitions from /home to non-home\nhome_to_nonhome AS (\n  SELECT \n    next_page,\n    (next_hit_time - hit_time) / 1000 AS time_on_page_seconds\n  FROM hits_with_group\n  WHERE is_home = 1\n    AND next_page IS NOT NULL\n    AND next_page NOT LIKE '/home%'\n),\n-- For max duration: find first /home in a streak and calculate time to first non-home\n-- Use a different approach: for each /home hit, find the FIRST subsequent non-home hit\nhome_hits_with_next_nonhome AS (\n  SELECT \n    hf1.\"fullVisitorId\",\n    hf1.\"visitId\",\n    hf1.hitNumber,\n    hf1.hit_time AS home_time,\n    MIN(CASE WHEN hf2.pagePath NOT LIKE '/home%' THEN hf2.hit_time END) AS next_nonhome_time,\n    MIN(CASE WHEN hf2.pagePath NOT LIKE '/home%' THEN hf2.pagePath END) AS next_nonhome_page\n  FROM hits_flat hf1\n  JOIN hits_flat hf2 \n    ON hf1.\"fullVisitorId\" = hf2.\"fullVisitorId\"\n    AND hf1.\"visitId\" = hf2.\"visitId\"\n    AND hf2.hitNumber > hf1.hitNumber\n  WHERE hf1.pagePath LIKE '/home%'\n  GROUP BY hf1.\"fullVisitorId\", hf1.\"visitId\", hf1.hitNumber, hf1.hit_time\n),\nhome_durations AS (\n  SELECT \n    (next_nonhome_time - home_time) / 1000 AS time_on_home_seconds\n  FROM home_hits_with_next_nonhome\n  WHERE next_nonhome_time IS NOT NULL\n),\nmost_common AS (\n  SELECT next_page, COUNT(*) AS cnt\n  FROM home_to_nonhome\n  GROUP BY next_page\n  ORDER BY cnt DESC\n  LIMIT 1\n),\nmax_time AS (\n  SELECT MAX(time_on_home_seconds) AS max_duration\n  FROM home_durations\n)\nSELECT \n  mc.next_page AS NEXT_PAGE,\n  mt.max_duratio