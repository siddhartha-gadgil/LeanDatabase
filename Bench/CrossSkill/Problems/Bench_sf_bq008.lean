\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170127\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170128\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170129\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170130\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170131\"\n),\npage_hits AS (\n  SELECT\n    s.\"fullVisitorId\",\n    s.\"visitId\",\n    h.value:\"hitNumber\"::INT AS hitNumber,\n    h.value:\"page\":\"pagePath\"::STRING AS pagePath,\n    h.value:\"time\"::INT AS hit_time\n  FROM all_sessions s,\n  LATERAL FLATTEN(input => s.\"hits\") h\n  WHERE s.\"trafficSource\":\"campaign\"::STRING ILIKE '%Data Share%'\n    AND h.value:\"type\"::STRING = 'PAGE'\n),\n-- Mark whether each page is /home or not, and assign groups for consecutive /home sequences\nwith_flags AS (\n  SELECT *,\n    CASE WHEN pagePath = '/home' THEN 0 ELSE 1 END AS is_not_home,\n    SUM(CASE WHEN pagePath != '/home' THEN 1 ELSE 0 END) OVER (\n      PARTITION BY \"fullVisitorId\", \"visitId\" ORDER BY hitNumber\n      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS grp\n  FROM page_hits\n),\n-- For each group of consecutive /home pages, find the first /home time\nhome_groups AS (\n  SELECT\n    \"fullVisitorId\",\n    \"visitId\",\n    grp,\n    MIN(hit_time) AS first_home_time,\n    MAX(hitNumber) AS last_home_hitNumber\n  FROM with_flags\n  WHERE pagePath = '/home'\n  GROUP BY \"fullVisitorId\", \"visitId\", grp\n),\n-- Find the first non-/home page after each home group\nnext_pages AS (\n  SELECT\n    hg.\"fullVisitorId\",\n    hg.\"visitId\",\n    hg.grp,\n