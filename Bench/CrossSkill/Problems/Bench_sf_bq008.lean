ts\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170121\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170122\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170123\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170124\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170125\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170126\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170127\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170128\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170129\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170130\"\nUNION ALL\nSELECT \"fullVisitorId\", \"visitId\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170131\"\n),\npage_hits AS (\n  SELECT\n    s.\"fullVisitorId\",\n    s.\"visitId\",\n    h.value:\"hitNumber\"::INT AS hitNumber,\n    h.value:\"page\":\"pagePath\"::STRING AS pagePath,\n    h.value:\"time\"::INT AS hit_time\n  FROM all_sessions s,\n  LATERAL FLATTEN(input => s.\"hits\") h\n  WHERE s.\"trafficSource\":\"campaign\"::STRING ILIKE '%Data Share%'\n    AND h.value:\"type\"::STRING = 'PAGE'\n),\n-- Mark whether each page is /home or not, and assign groups for consecutive /home sequences\nwith_flags AS (\n  SELECT *,\n    CASE WHEN pagePath = '/home' THEN 0 ELSE 1 END AS is_not_home,\n    SUM(CASE WHEN pagePath != '/home' THEN 1 ELSE 0 END) OVER (\n      PARTITION BY \"fullVisitorId\", \"visitId\" ORDER BY hitNumber\n      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS grp\n  FROM page_hits\n),\n-- For each group of consecutive /home pages, find the first /home time\nhome_groups AS (\n  SELECT\n    \"fullVisitorId\",\n    \"visitId\",\n    grp,\n    MIN(hit_time) AS first_home_time,\n    MAX(hitNumber) AS last_home_hitNumber\n  FROM with_flags\n  WHERE pagePath = '/home'\n  GROUP BY \"fullVisitorId\", \"visitId\", grp\n),\n-- Find the first non-/home page after each home group\nnext_pages AS (\n  SELECT\n    hg.\"fullVisitorId\",\n    hg.\"visitId\",\n    hg.grp,\n    hg.first_home_time,\n    ph.pagePath AS next_page,\n    ph.hit_time AS next_page_time,\n    ROW_NUMBER() OVER (PARTITION BY hg.\"fullVisitorId\", hg.\"visitId\", hg.grp ORDER BY ph.hitNumber) AS rn\n  FROM home_groups hg\n  JOIN page_hits ph\n    ON ph.\"fullVisitorId\" = hg.\"fullVisitorId\"\n    AND ph.\"visitId\" = hg.\"visitId\"\n    AND ph.hitNumber > hg.last_home_hitNumber\n    AND ph.pagePath != '/home'\n),\nhome_to_next AS (\n  SELECT\n    next_page,\n    (next_page_time - first_home_time) / 1000.0 AS duration_seconds\n  FROM next_pages\n  WHERE rn = 1\n),\nmost_common AS (\n  SELECT next_page\n  FROM home_to_next\n  GROUP BY next_page\n  ORDER BY COUNT(*) DESC\n  LIMIT 1\n),\nmax_dur AS (\n  SELECT MAX(duration_seconds) AS max_duration\n  FROM home_to_next\n)\nSELECT\n  (SELECT next_page FROM most_common) AS \"NEXT_PAGE\",\n  (SELECT max_duration FROM max_dur) AS \"MAX_DURATION\";" := by
