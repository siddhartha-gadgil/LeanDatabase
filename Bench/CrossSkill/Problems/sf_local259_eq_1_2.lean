h_id\", bb.\"innings_no\", COUNT(CASE WHEN NOT wt.\"kind_out\" IN ('run out', 'retired hurt', 'obstructing the field') THEN 1 END) AS wickets FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS bb LEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" AS wt ON bb.\"match_id\" = wt.\"match_id\" AND bb.\"over_id\" = wt.\"over_id\" AND bb.\"ball_id\" = wt.\"ball_id\" AND bb.\"innings_no\" = wt.\"innings_no\" GROUP BY bb.\"bowler\", bb.\"match_id\", bb.\"innings_no\"), bowling_runs_per_match AS (/* Per match bowling runs conceded (from BATSMAN_SCORED) */ SELECT bb.\"bowler\" AS player_id, bb.\"match_id\", bb.\"innings_no\", SUM(bs.\"runs_scored\") AS runs_conceded, COUNT(*) AS balls_bowled FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS bb JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" AS bs ON bb.\"match_id\" = bs.\"match_id\" AND bb.\"over_id\" = bs.\"over_id\" AND bb.\"ball_id\" = bs.\"ball_id\" AND bb.\"innings_no\" = bs.\"innings_no\" GROUP BY bb.\"bowler\", bb.\"match_id\", bb.\"innings_no\"), bowling_match_combined AS (SELECT bw.player_id, bw.\"match_id\", bw.\"innings_no\", bw.wickets, br.runs_conceded, br.balls_bowled FROM bowling_wickets_per_match AS bw JOIN bowling_runs_per_match AS br ON bw.player_id = br.player_id AND bw.\"match_id\" = br.\"match_id\" AND bw.\"innings_no\" = br.\"innings_no\"), bowling_agg AS (/* Aggregate bowling stats per player */ SELECT player_id, SUM(wickets) AS total_wickets_taken, SUM(runs_conceded) AS total_runs_conceded, SUM(balls_bowled) AS total_balls_bowled FROM bowling_match_combined GROUP BY player_id), best_bowling AS (/* Best bowling performance: most wickets, then fewest runs */ /* Include 0-wicket performances too */ SELECT player_id, CAST(wickets AS VARCHAR) || '-' || CAST(runs_conceded AS VARCHAR) AS best_bowling_performance FROM (SELECT player_id, wickets, runs_conceded, ROW_NUMBER() OVER (PARTITION BY player_id ORDER BY wickets DESC, runs_conceded ASC) AS rn FROM bowling_match_combined) WHERE rn = 1) SELECT p.\"player_id\", p.\"player_name\", mfr.most_fre