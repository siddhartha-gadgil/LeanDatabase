CREATE TABLE DISEASE_VARIANT_GENE («study_id» STRING, «source» STRING, «pmid» STRING, «pub_date» STRING, «pub_journal» STRING, «pub_title» STRING, «pub_author» STRING, «has_sumstats» BOOL, «trait_reported» STRING, «trait_efos» STRING, «ancestry_initial» STRING, «ancestry_replication» STRING, «n_initial» INT, «n_replication» INT, «n_cases» INT, «trait_category» STRING, «num_assoc_loci» INT, «lead_chrom» STRING, «lead_pos» INT, «lead_ref» STRING, «lead_alt» STRING, «tag_chrom» STRING, «tag_pos» INT, «tag_ref» STRING, «tag_alt» STRING, «overall_r2» FLOAT, «AFR_1000G_prop» FLOAT, «AMR_1000G_prop» FLOAT, «EAS_1000G_prop» FLOAT, «EUR_1000G_prop» FLOAT, «SAS_1000G_prop» FLOAT, «log10_ABF» FLOAT, «posterior_prob» FLOAT, «odds_ratio» FLOAT, «oddsr_ci_lower» FLOAT, «oddsr_ci_upper» FLOAT, «direction» STRING, «beta» FLOAT, «beta_ci_lower» FLOAT, «beta_ci_upper» FLOAT, «pval_mantissa» FLOAT, «pval_exponent» INT, «pval» FLOAT, «gene_id» STRING, «feature» STRING, «type_id» STRING, «source_id» STRING, «fpred_labels» STRING, «fpred_scores» STRING, «fpred_max_label» STRING, «fpred_max_score» FLOAT, «qtl_beta» FLOAT, «qtl_se» FLOAT, «qtl_pval» FLOAT, «qtl_score» FLOAT, «interval_score» FLOAT, «qtl_score_q» FLOAT, «interval_score_q» FLOAT, «d» INT, «distance_score» FLOAT, «distance_score_q» FLOAT)

theorem eq (t0 : TableRel DISEASE_VARIANT_GENE_schema) :
    (sql%([DISEASE_VARIANT_GENE_schema]) "WITH top_disease_variants AS (SELECT \"study_id\", \"lead_chrom\", \"lead_pos\", \"lead_ref\", \"lead_alt\", \"tag_chrom\", \"tag_pos\", \"tag_ref\", \"tag_alt\", \"pval\", \"pval_exponent\", \"pval_mantissa\" FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_DISEASE\" WHERE \"pval_exponent\" <= -26677), with_genes AS (SELECT vg.\"gene_id\" AS gene_id, tv.\"study_id\" AS study_id, tv.\"lead_chrom\" AS CHROM, tv.\"lead_pos\" AS POS, tv.\"lead_ref\" AS REF, tv.\"lead_alt\" AS ALT, tv.\"pval\" AS pval, tv.\"pval_exponent\", tv.\"pval_mantissa\", ROW_NUMBER() OVER (PARTITION BY vg.\"gene_id\", tv.\"study_id\" ORDER BY tv.\"pval_exponent\" ASC, tv.\"pval_mantissa\" ASC) AS rn FROM top_disease_variants AS tv JOIN \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_GENE\" AS vg ON vg.\"chr_id\" = tv.\"tag_chrom\" AND vg.\"position\" = tv.\"tag_pos\" AND vg.\"ref_allele\" = tv.\"tag_ref\" AND vg.\"alt_allele\" = tv.\"tag_alt\") SELECT gene_id, study_id, CHROM, POS, REF, ALT, pval FROM with_genes WHERE rn = 1 ORDER BY \"pval_exponent\" ASC, \"pval_mantissa\" ASC, gene_id ASC LIMIT 10") t0
  ~= (sql%([DISEASE_VARIANT_GENE_schema]) "SELECT \"gene_id\", \"study_id\", \"CHROM\", \"POS\", \"REF\", \"ALT\", \"pval\" FROM (/* Strategy: First get each study's variant with lowest pval from VARIANT_DISEASE (22.9M rows), */ /* then join with VARIANT_GENE to get gene mappings, then rank per gene-study. */ /* Step 1: For each study, get all variants - but we want per gene-study. */ /* Since gene comes from VARIANT_GENE, we need to join first, then aggregate. */ /* Optimization: first get the top candidate variants from VARIANT_DISEASE, */ /* then join with VARIANT_GENE for gene mapping. */ WITH top_variants AS (SELECT \"study_id\", \"tag_chrom\", \"tag_pos\", \"tag_ref\", \"tag_alt\", \"pval\" FROM \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_DISEASE\" WHERE NOT \"pval\" IS NULL ORDER BY \"pval\" ASC LIMIT 1000), gene_variant_study AS (SELECT vg.\"gene_id\", tv.\"study_id\", tv.\"tag_chrom\" AS \"CHROM\", tv.\"tag_pos\" AS \"POS\", tv.\"tag_ref\" AS \"REF\", tv.\"tag_alt\" AS \"ALT\", tv.\"pval\" FROM top_variants AS tv JOIN \"OPEN_TARGETS_GENETICS_2\".\"OPEN_TARGETS_GENETICS\".\"VARIANT_GENE\" AS vg ON tv.\"tag_chrom\" = vg.\"chr_id\" AND tv.\"tag_pos\" = vg.\"position\" AND tv.\"tag_ref\" = vg.\"ref_allele\" AND tv.\"tag_alt\" = vg.\"alt_allele\") SELECT \"gene_id\", \"study_id\", \"CHROM\", \"POS\", \"REF\", \"ALT\", \"pval\", ROW_NUMBER() OVER (PARTITION BY \"gene_id\", \"study_id\" ORDER BY \"pval\" ASC) AS _w FROM gene_variant_study ORDER BY \"pval\" ASC LIMIT 10) AS _t WHERE _w = 1") t0
  := by first | sql_equiv | sorry

end N_sf_bq325_eq_2_3
