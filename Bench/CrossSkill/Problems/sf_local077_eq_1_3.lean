import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_local077_eq_1_3

CREATE TABLE INTEREST_MAP («id» INT, «interest_name» STRING, «interest_summary» STRING, «created_at» STRING, «last_modified» STRING)
CREATE TABLE INTEREST_METRICS («_month» FLOAT, «_year» FLOAT, «month_year» STRING, «interest_id» FLOAT, «composition» FLOAT, «index_value» FLOAT, «ranking» INT, «percentile_ranking» FLOAT)

theorem eq (t0 : TableRel INTEREST_MAP_schema) (t1 : TableRel INTEREST_METRICS_schema) :
    (sql%([INTEREST_MAP_schema, INTEREST_METRICS_schema]) "WITH avg_comp AS (/* Calculate avg composition = composition / index_value for each interest per month */ SELECT im.\"_month\", im.\"_year\", im.\"month_year\", im.\"interest_id\", m.\"interest_name\", CAST(im.\"composition\" AS DOUBLE PRECISION) / NULLIF(im.\"index_value\", 0) AS avg_composition FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_METRICS\" AS im JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_MAP\" AS m ON im.\"interest_id\" = m.\"id\" WHERE NOT im.\"_month\" IS NULL), max_per_month AS (/* For each month, find the interest with the highest avg composition */ SELECT \"_month\", \"_year\", \"month_year\", \"interest_name\", avg_composition AS max_index_composition, ROW_NUMBER() OVER (PARTITION BY \"_month\", \"_year\" ORDER BY avg_composition DESC) AS rn FROM avg_comp), filtered AS (/* Keep only the top interest per month and filter to Sep 2018 - Aug 2019 */ SELECT DATE_FROM_PARTS(\"_year\", \"_month\", 1) AS MONTH_DATE, \"interest_name\", max_index_composition FROM max_per_month WHERE rn = 1 AND ((\"_year\" = 2018 AND \"_month\" >= 9) OR (\"_year\" = 2019 AND \"_month\" <= 8))), with_rolling AS (SELECT MONTH_DATE, \"interest_name\", max_index_composition AS MAX_INDEX_COMPOSITION, AVG(max_index_composition) OVER (ORDER BY MONTH_DATE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS ROLLING_AVG_3MONTH, LAG(\"interest_name\", 1) OVER (ORDER BY MONTH_DATE) AS PREV_MONTH_INTEREST_NAME, LAG(max_index_composition, 1) OVER (ORDER BY MONTH_DATE) AS PREV_MONTH_MAX_COMPOSITION, LAG(\"interest_name\", 2) OVER (ORDER BY MONTH_DATE) AS PREV_2MONTH_INTEREST_NAME, LAG(max_index_composition, 2) OVER (ORDER BY MONTH_DATE) AS PREV_2MONTH_MAX_COMPOSITION FROM filtered) SELECT MONTH_DATE, \"interest_name\", MAX_INDEX_COMPOSITION, ROLLING_AVG_3MONTH, PREV_MONTH_INTEREST_NAME, PREV_MONTH_MAX_COMPOSITION, PREV_2MONTH_INTEREST_NAME, PREV_2MONTH_MAX_COMPOSITION FROM with_rolling ORDER BY MONTH_DATE") t0 t1
  ~= (sql%([INTEREST_MAP_schema, INTEREST_METRICS_schema]) "WITH index_composition AS (SELECT DATE_FROM_PARTS(CAST(m.\"_year\" AS INT), CAST(m.\"_month\" AS INT), 1) AS \"MONTH_DATE\", mp.\"interest_name\" AS \"interest_name\", CAST(m.\"composition\" AS DOUBLE PRECISION) / m.\"index_value\" AS \"index_composition\" FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_METRICS\" AS m JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_MAP\" AS mp ON CAST(m.\"interest_id\" AS INT) = mp.\"id\" WHERE NOT m.\"month_year\" IS NULL AND NOT m.\"interest_id\" IS NULL AND NOT m.\"index_value\" IS NULL AND m.\"index_value\" > 0), max_per_month AS (SELECT \"MONTH_DATE\", \"interest_name\", \"index_composition\" AS \"MAX_INDEX_COMPOSITION\" FROM (SELECT \"MONTH_DATE\", \"interest_name\", \"index_composition\", ROW_NUMBER() OVER (PARTITION BY \"MONTH_DATE\" ORDER BY \"index_composition\" DESC) AS rn FROM index_composition) WHERE rn = 1), filtered AS (SELECT * FROM max_per_month WHERE \"MONTH_DATE\" BETWEEN '2018-09-01' AND '2019-08-01') SELECT \"MONTH_DATE\", \"interest_name\", \"MAX_INDEX_COMPOSITION\", AVG(\"MAX_INDEX_COMPOSITION\") OVER (ORDER BY \"MONTH_DATE\" ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS \"ROLLING_AVG_3MONTH\", LAG(\"interest_name\", 1) OVER (ORDER BY \"MONTH_DATE\") AS \"PREV_MONTH_INTEREST_NAME\", LAG(\"MAX_INDEX_COMPOSITION\", 1) OVER (ORDER BY \"MONTH_DATE\") AS \"PREV_MONTH_MAX_COMPOSITION\", LAG(\"interest_name\", 2) OVER (ORDER BY \"MONTH_DATE\") AS \"PREV_2MONTH_INTEREST_NAME\", LAG(\"MAX_INDEX_COMPOSITION\", 2) OVER (ORDER BY \"MONTH_DATE\") AS \"PREV_2MONTH_MAX_COMPOSITION\" FROM filtered ORDER BY \"MONTH_DATE\"") t0 t1
  := by first | sql_equiv | sorry

end N_sf_local077_eq_1_3
