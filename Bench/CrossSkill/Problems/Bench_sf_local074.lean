/-!
# sf_local074 — crossskill equivalence(s)

Question: Please generate a summary of the closing balances at the end of each month for each customer transactions, show the monthly changes and monthly cumulative bank account balances. Ensure that even if a customer has no account activity in a given month, the balance for that month is still included in the output.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local074

CREATE TABLE CUSTOMER_TRANSACTIONS («customer_id» INT, «txn_date» STRING, «txn_type» STRING, «txn_amount» INT)

theorem eq_0_1 :
    sql%([CUSTOMER_TRANSACTIONS_schema]) "WITH all_months AS (\n    SELECT DISTINCT DATE_TRUNC('MONTH', TO_DATE(\"txn_date\", 'YYYY-MM-DD')) AS \"GENERATED_MONTH\"\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n),\nall_customers AS (\n    SELECT DISTINCT \"customer_id\"\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n),\ncustomer_months AS (\n    SELECT c.\"customer_id\", m.\"GENERATED_MONTH\"\n    FROM all_customers c\n    CROSS JOIN all_months m\n),\nmonthly_activity AS (\n    SELECT\n        \"customer_id\",\n        DATE_TRUNC('MONTH', TO_DATE(\"txn_date\", 'YYYY-MM-DD')) AS \"GENERATED_MONTH\",\n        SUM(CASE WHEN \"txn_type\" = 'deposit' THEN \"txn_amount\" ELSE -\"txn_amount\" END) AS \"BALANCE_ACTIVITY\"\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n    GROUP BY \"customer_id\", DATE_TRUNC('MONTH', TO_DATE(\"txn_date\", 'YYYY-MM-DD'))\n),\nfilled AS (\n    SELECT\n        cm.\"customer_id\",\n        cm.\"GENERATED_MONTH\",\n        COALESCE(ma.\"BALANCE_ACTIVITY\", 0) AS \"BALANCE_ACTIVITY\"\n    FROM customer_months cm\n    LEFT JOIN monthly_activity ma\n        ON cm.\"customer_id\" = ma.\"customer_id\"\n        AND cm.\"GENERATED_MONTH\" = ma.\"GENERATED_MONTH\"\n)\nSELECT\n    \"customer_id\",\n    \"GENERATED_MONTH\",\n    \"BALANCE_ACTIVITY\",\n    SUM(\"BALANCE_ACTIVITY\") OVER (\n        PARTITION BY \"customer_id\"\n        ORDER BY \"GENERATED_MONTH\"\n        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS \"MONTH_END_BALANCE\"\nFROM filled\nORDER BY \"customer_id\", \"GENERATED_MONTH\";" = sql%([CUSTOMER_TRANSACTIONS_schema]) "WITH months AS (\n    SELECT DATE_TRUNC('MONTH', \"txn_date\"::DATE) AS \"GENERATED_MONTH\"\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n    GROUP BY 1\n),\ncustomers AS (\n    SELECT DISTINCT \"customer_id\"\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n),\n-- Cross join to get all customer-month combinations\ncustomer_months AS (\n    SELECT c.\"customer_id\", m.\"GENERATED_MONTH\"\n    FROM customers c\n    CROSS JOIN months m\n),\n-- Monthly balance activity per customer\nmonthly_activity AS (\n    SELECT\n        \"customer_id\",\n        DATE_TRUNC('MONTH', \"txn_date\"::DATE) AS \"GENERATED_MONTH\",\n        SUM(CASE WHEN \"txn_type\" = 'deposit' THEN \"txn_amount\" ELSE 0 END)\n        - SUM(CASE WHEN \"txn_type\" = 'purchase' THEN \"txn_amount\" ELSE 0 END)\n        - SUM(CASE WHEN \"txn_type\" = 'withdrawal' THEN \"txn_amount\" ELSE 0 END) AS \"BALANCE_ACTIVITY\"\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n    GROUP BY \"customer_id\", DATE_TRUNC('MONTH', \"txn_date\"::DATE)\n),\n-- Join to fill gaps with 0\nfilled AS (\n    SELECT\n        cm.\"customer_id\",\n        cm.\"GENERATED_MONTH\",\n        COALESCE(ma.\"BALANCE_ACTIVITY\", 0) AS \"BALANCE_ACTIVITY\"\n    FROM customer_months cm\n    LEFT JOIN monthly_activity ma\n        ON cm.\"customer_id\" = ma.\"customer_id\"\n        AND cm.\"GENERATED_MONTH\" = ma.\"GENERATED_MONTH\"\n)\nSELECT\n    \"customer_id\",\n    \"GENERATED_MONTH\",\n    \"BALANCE_ACTIVITY\",\n    SUM(\"BALANCE_ACTIVITY\") OVER (\n        PARTITION BY \"customer_id\"\n        ORDER BY \"GENERATED_MONTH\"\n        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS \"MONTH_END_BALANCE\"\nFROM filled\nORDER BY \"customer_id\", \"GENERATED_MONTH\";" := by
  first | sql_equiv | sorry

