 \"eff_rating_diff\" FROM combined AS c LEFT JOIN \"NCAA_INSIGHTS\".\"NCAA\".\"FEATURE_ENGINEERING\" AS ft ON c.\"school_ncaa\" = ft.\"team\" AND c.\"season\" = ft.\"season\" LEFT JOIN \"NCAA_INSIGHTS\".\"NCAA\".\"FEATURE_ENGINEERING\" AS fo ON c.\"opponent_school_ncaa\" = fo.\"team\" AND c.\"season\" = fo.\"season\"") t0 t1 t2
