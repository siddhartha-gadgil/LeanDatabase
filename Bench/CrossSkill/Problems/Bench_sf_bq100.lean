    (sql%([SAMPLE_CONTENTS_schema]) "-- sf_bq100: Top 10 most frequently used packages from Go import statements\n-- Approach: Extract import blocks enclosed in parentheses, split by newlines,\n-- extract double-quoted package names, count frequency, remove quotes\nSELECT \n  REPLACE(REGEXP_SUBSTR(line.VALUE::STRING, '\"[^\"]+\"'), '\"', '') AS package,\n  COUNT(*) AS f0_\nFROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\",\n  LATERAL FLATTEN(input => SPLIT(\n    REGEXP_SUBSTR(\"content\", 'import\\\\s*\\\\([^)]+\\\\)', 1, 1, 's'), \n    '\\n'\n  )) AS line\nWHERE (\"content\" LIKE '%import (%' OR \"content\" LIKE '%import(%')\n  AND REGEXP_SUBSTR(\"content\", 'import\\\\s*\\\\([^)]+\\\\)', 1, 1, 's') IS NOT NULL\n  AND REPLACE(REGEXP_SUBSTR(line.VALUE::STRING, '\"[^\"]+\"'), '\"', '') IS NOT NULL\nGROUP BY package\nORDER BY f0_ DESC, package ASC\nLIMIT 10;") t ~= (sql%([SAMPLE_CONTENTS_schema]) "WITH import_blocks AS (\n    SELECT REGEXP_SUBSTR(\"content\", 'import \\\\(([^)]+)\\\\)', 1, 1, 'es', 1) AS import_block\n    FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\"\n    WHERE \"content\" LIKE '%import (%'\n),\nlines AS (\n    SELECT TRIM(f.value::STRING) AS line\n    FROM import_blocks, \n    LATERAL FLATTEN(input => SPLIT(import_block, '\\n')) f\n    WHERE TRIM(f.value::STRING) <> ''\n),\npackages AS (\n    SELECT REGEXP_SUBSTR(line, '\"([^\"]+)\"', 1, 1, 'e', 1) AS package\n    FROM lines\n    WHERE line LIKE '%\"%'\n)\nSELECT package, COUNT(*) AS f0_\nFROM packages\nWHERE package IS NOT NULL\nGROUP BY package\nORDER BY f0_ DESC, package ASC\nLIMIT 10;") t := by
