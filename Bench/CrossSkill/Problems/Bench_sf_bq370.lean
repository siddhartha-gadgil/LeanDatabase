S_INVOICELINES\" AS il ON i.\"InvoiceID\" = il.\"InvoiceID\" GROUP BY i.\"CustomerID\") AS T2 ON T1.\"CustomerID\" = T2.\"CustomerID\" WHERE T1.order_count = T2.invoice_count AND T1.order_total = T2.invoice_total") t := by
  intro t; first | sql_equiv | sorry

