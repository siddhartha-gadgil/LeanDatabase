import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq370 — crossskill equivalence(s)

Question: How many customers have orders and invoices that match at the line-item level and, when aggregated, result in each customer having an equal count of orders and invoices as well as an identical total value for the orders and invoices?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq370

CREATE TABLE SALES_ORDERLINES («OrderLineID» INT, «OrderID» INT, «StockItemID» INT, «Description» STRING, «PackageTypeID» INT, «Quantity» INT, «UnitPrice» FLOAT, «TaxRate» FLOAT, «PickedQuantity» INT, «PickingCompletedWhen» STRING, «LastEditedBy» INT, «LastEditedWhen» INT)
CREATE TABLE SALES_INVOICES («InvoiceID» INT, «CustomerID» INT, «BillToCustomerID» INT, «OrderID» INT, «DeliveryMethodID» INT, «ContactPersonID» INT, «AccountsPersonID» INT, «SalespersonPersonID» INT, «PackedByPersonID» INT, «InvoiceDate» STRING, «CustomerPurchaseOrderNumber» INT, «IsCreditNote» INT, «CreditNoteReason» FLOAT, «Comments» FLOAT, «DeliveryInstructions» STRING, «InternalComments» FLOAT, «TotalDryItems» INT, «TotalChillerItems» INT, «DeliveryRun» FLOAT, «RunPosition» FLOAT, «ReturnedDeliveryData» STRING, «ConfirmedDeliveryTime» STRING, «ConfirmedReceivedBy» STRING, «LastEditedBy» INT, «LastEditedWhen» STRING)
CREATE TABLE SALES_ORDERS («OrderID» INT, «CustomerID» INT, «SalespersonPersonID» INT, «PickedByPersonID» STRING, «ContactPersonID» INT, «BackorderOrderID» STRING, «OrderDate» STRING, «ExpectedDeliveryDate» STRING, «CustomerPurchaseOrderNumber» INT, «IsUndersupplyBackordered» INT, «Comments» STRING, «DeliveryInstructions» STRING, «InternalComments» STRING, «PickingCompletedWhen» STRING, «LastEditedBy» INT, «LastEditedWhen» INT)
CREATE TABLE SALES_INVOICELINES («InvoiceLineID» INT, «InvoiceID» INT, «StockItemID» INT, «Description» STRING, «PackageTypeID» INT, «Quantity» INT, «UnitPrice» FLOAT, «TaxRate» FLOAT, «TaxAmount» FLOAT, «LineProfit» FLOAT, «ExtendedPrice» FLOAT, «LastEditedBy» INT, «LastEditedWhen» INT)

theorem eq_0_1 : ∀ t,
    (sql%([SALES_ORDERLINES_schema, SALES_INVOICES_schema, SALES_ORDERS_schema, SALES_INVOICELINES_schema]) "WITH order_agg AS (\n  SELECT \n    T1.\"CustomerID\",\n    COUNT(DISTINCT T1.\"OrderID\") AS order_count,\n    SUM(ol.\"Quantity\" * ol.\"UnitPrice\" * (1 + ol.\"TaxRate\" / 100)) AS order_total_value\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" T1\n  JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol\n    ON T1.\"OrderID\" = ol.\"OrderID\"\n  GROUP BY T1.\"CustomerID\"\n),\ninvoice_agg AS (\n  SELECT \n    i.\"CustomerID\",\n    COUNT(DISTINCT i.\"InvoiceID\") AS invoice_count,\n    SUM(il.\"ExtendedPrice\") AS invoice_total_value\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n  JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICELINES\" il\n    ON i.\"InvoiceID\" = il.\"InvoiceID\"\n  GROUP BY i.\"CustomerID\"\n)\nSELECT COUNT(DISTINCT T1.\"CustomerID\") AS \"COUNT(DISTINCT T1.\"\"CUSTOMERID\"\")\"\nFROM order_agg T1\nJOIN invoice_agg T2\n  ON T1.\"CustomerID\" = T2.\"CustomerID\"\nWHERE T1.order_count = T2.invoice_count\n  AND T1.order_total_value = T2.invoice_total_value;") t ~= (sql%([SALES_ORDERLINES_schema, SALES_INVOICES_schema, SALES_ORDERS_schema, SALES_INVOICELINES_schema]) "WITH order_agg AS (\n    SELECT o.\"CustomerID\",\n           COUNT(DISTINCT o.\"OrderID\") AS order_count,\n           SUM(ol.\"Quantity\" * ol.\"UnitPrice\" * (1 + ol.\"TaxRate\"/100)) AS order_value\n    FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" o\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol ON o.\"OrderID\" = ol.\"OrderID\"\n    GROUP BY o.\"CustomerID\"\n),\ninvoice_agg AS (\n    SELECT i.\"CustomerID\",\n           COUNT(DISTINCT i.\"InvoiceID\") AS invoice_count,\n           SUM(il.\"ExtendedPrice\") AS invoice_value\n    FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICELINES\" il ON i.\"InvoiceID\" = il.\"InvoiceID\"\n    GROUP BY i.\"CustomerID\"\n)\nSELECT COUNT(DISTINCT oa.\"CustomerID\") AS \"COUNT(DISTINCT T1.\"\"CUSTOMERID\"\")\"\nFROM order_agg oa\nJOIN invoice_agg ia ON oa.\"CustomerID\" = ia.\"CustomerID\"\nWHERE oa.order_count = ia.invoice_count\n  AND oa.order_value = ia.invoice_value") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([SALES_ORDERLINES_schema, SALES_INVOICES_schema, SALES_ORDERS_schema, SALES_INVOICELINES_schema]) "WITH order_agg AS (\n  SELECT \n    T1.\"CustomerID\",\n    COUNT(DISTINCT T1.\"OrderID\") AS order_count,\n    SUM(ol.\"Quantity\" * ol.\"UnitPrice\" * (1 + ol.\"TaxRate\" / 100)) AS order_total_value\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" T1\n  JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol\n    ON T1.\"OrderID\" = ol.\"OrderID\"\n  GROUP BY T1.\"CustomerID\"\n),\ninvoice_agg AS (\n  SELECT \n    i.\"CustomerID\",\n    COUNT(DISTINCT i.\"InvoiceID\") AS invoice_count,\n    SUM(il.\"ExtendedPrice\") AS invoice_total_value\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n  JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICELINES\" il\n    ON i.\"InvoiceID\" = il.\"InvoiceID\"\n  GROUP BY i.\"CustomerID\"\n)\nSELECT COUNT(DISTINCT T1.\"CustomerID\") AS \"COUNT(DISTINCT T1.\"\"CUSTOMERID\"\")\"\nFROM order_agg T1\nJOIN invoice_agg T2\n  ON T1.\"CustomerID\" = T2.\"CustomerID\"\nWHERE T1.order_count = T2.invoice_count\n  AND T1.order_total_value = T2.invoice_total_value;") t ~= (sql%([SALES_ORDERLINES_schema, SALES_INVOICES_schema, SALES_ORDERS_schema, SALES_INVOICELINES_schema]) "SELECT COUNT(DISTINCT T1.\"CustomerID\")\nFROM (\n  SELECT \n    o.\"CustomerID\",\n    COUNT(DISTINCT o.\"OrderID\") AS order_count,\n    SUM(ol.\"Quantity\" * ol.\"UnitPrice\" * (1 + ol.\"TaxRate\" / 100)) AS order_total\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" o\n  JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol\n    ON o.\"OrderID\" = ol.\"OrderID\"\n  GROUP BY o.\"CustomerID\"\n) T1\nJOIN (\n  SELECT \n    i.\"CustomerID\",\n    COUNT(DISTINCT i.\"InvoiceID\") AS invoice_count,\n    SUM(il.\"ExtendedPrice\") AS invoice_total\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n  JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICELINES\" il\n    ON i.\"InvoiceID\" = il.\"InvoiceID\"\n  GROUP BY i.\"CustomerID\"\n) T2\nON T1.\"CustomerID\" = T2.\"CustomerID\"\nWHERE T1.order_count = T2.invoice_count\n  AND T1.order_total = T2.invoice_total;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_1_2 : ∀ t,
    (sql%([SALES_ORDERLINES_schema, SALES_INVOICES_schema, SALES_ORDERS_schema, SALES_INVOICELINES_schema]) "WITH order_agg AS (\n    SELECT o.\"CustomerID\",\n           COUNT(DISTINCT o.\"OrderID\") AS order_count,\n           SUM(ol.\"Quantity\" * ol.\"UnitPrice\" * (1 + ol.\"TaxRate\"/100)) AS order_value\n    FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" o\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol ON o.\"OrderID\" = ol.\"OrderID\"\n    GROUP BY o.\"CustomerID\"\n),\ninvoice_agg AS (\n    SELECT i.\"CustomerID\",\n           COUNT(DISTINCT i.\"InvoiceID\") AS invoice_count,\n           SUM(il.\"ExtendedPrice\") AS invoice_value\n    FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICELINES\" il ON i.\"InvoiceID\" = il.\"InvoiceID\"\n    GROUP BY i.\"CustomerID\"\n)\nSELECT COUNT(DISTINCT oa.\"CustomerID\") AS \"COUNT(DISTINCT T1.\"\"CUSTOMERID\"\")\"\nFROM order_agg oa\nJOIN invoice_agg ia ON oa.\"CustomerID\" = ia.\"CustomerID\"\nWHERE oa.order_count = ia.invoice_count\n  AND oa.order_value = ia.invoice_value") t ~= (sql%([SALES_ORDERLINES_schema, SALES_INVOICES_schema, SALES_ORDERS_schema, SALES_INVOICELINES_schema]) "SELECT COUNT(DISTINCT T1.\"CustomerID\")\nFROM (\n  SELECT \n    o.\"CustomerID\",\n    COUNT(DISTINCT o.\"OrderID\") AS order_count,\n    SUM(ol.\"Quantity\" * ol.\"UnitPrice\" * (1 + ol.\"TaxRate\" / 100)) AS order_total\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" o\n  JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol\n    ON o.\"OrderID\" = ol.\"OrderID\"\n  GROUP BY o.\"CustomerID\"\n) T1\nJOIN (\n  SELECT \n    i.\"CustomerID\",\n    COUNT(DISTINCT i.\"InvoiceID\") AS invoice_count,\n    SUM(il.\"ExtendedPrice\") AS invoice_total\n  FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n  JOIN \"W