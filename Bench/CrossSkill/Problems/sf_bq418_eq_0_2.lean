import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq418_eq_0_2

CREATE TABLE PE_TO_PATHWAY_V77 («pe_stable_id» STRING, «pathway_stable_id» STRING, «evidence_code» STRING)
CREATE TABLE PATHWAY_V77 («stable_id» STRING, «url» STRING, «name» STRING, «species» STRING, «lowest_level» BOOL)
CREATE TABLE PHYSICAL_ENTITY_V77 («ensembl_id» STRING, «uniprot_id» STRING, «stable_id» STRING, «name» STRING, «location» STRING)
CREATE TABLE EXPERIMENTS_V1 («expID» INT, «exp_assayType» STRING, «exp_assayValueLow» FLOAT, «exp_assayValueMedian» FLOAT, «exp_assayValueHigh» FLOAT, «exp_assayUnits» STRING, «exp_assayRelation» STRING, «exp_assayDescription» STRING, «exp_assaySpecies» STRING, «exp_parentSource» STRING, «sourceID» INT, «PubMedID» STRING, «databaseName» STRING, «db_version» STRING, «db_downloadURL» STRING, «db_downloadDate» STRING)
CREATE TABLE INTERACTIONS_V1 («interactionID» INT, «drugID» INT, «targetID» INT, «interactionType» STRING, «drugName» STRING, «drug_approvalDate» STRING, «drug_atcClassID» STRING, «drug_atcClassName» STRING, «drug_atcClassStatus» STRING, «drug_epcClassID» STRING, «drug_epcClassName» STRING, «targetName» STRING, «targetType» STRING, «target_uniprotID» STRING, «targetSpecies» STRING, «sourceID» INT, «expID» INT)

theorem eq (t0 : TableRel PE_TO_PATHWAY_V77_schema) (t1 : TableRel PATHWAY_V77_schema) (t2 : TableRel PHYSICAL_ENTITY_V77_schema) (t3 : TableRel EXPERIMENTS_V1_schema) (t4 : TableRel INTERACTIONS_V1_schema) :
    (sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH sorafenib_targets AS (SELECT DISTINCT i.\"target_uniprotID\" AS \"uniprot_id\" FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" AS i JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" AS e ON i.\"expID\" = e.\"expID\" WHERE LOWER(i.\"drugName\") LIKE '%sorafenib%' AND i.\"targetSpecies\" = 'Homo sapiens' AND e.\"exp_assayValueMedian\" <= 100 AND (e.\"exp_assayValueLow\" <= 100 OR e.\"exp_assayValueLow\" IS NULL) AND (e.\"exp_assayValueHigh\" <= 100 OR e.\"exp_assayValueHigh\" IS NULL)), universe /* Universe: all distinct non-null uniprot_ids in lowest-level TAS pathways */ AS (SELECT DISTINCT pe.\"uniprot_id\" FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" AS pp JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" AS pw ON pp.\"pathway_stable_id\" = pw.\"stable_id\" JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" AS pe ON pp.\"pe_stable_id\" = pe.\"stable_id\" WHERE pp.\"evidence_code\" = 'TAS' AND pw.\"lowest_level\" = 'True' AND NOT pe.\"uniprot_id\" IS NULL), pathway_genes /* For each lowest-level TAS pathway, get distinct non-null uniprot_ids */ AS (SELECT DISTINCT pp.\"pathway_stable_id\", pe.\"uniprot_id\" FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" AS pp JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" AS pw ON pp.\"pathway_stable_id\" = pw.\"stable_id\" JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" AS pe ON pp.\"pe_stable_id\" = pe.\"stable_id\" WHERE pp.\"evidence_code\" = 'TAS' AND pw.\"lowest_level\" = 'True' AND NOT pe.\"uniprot_id\" IS NULL), pathway_counts /* Count per pathway: n (total genes in pathway), k (target genes in pathway) */ AS (SELECT pg.\"pathway_stable_id\", COUNT(DISTINCT pg.\"uniprot_id\") AS n, COUNT(DISTINCT CASE WHEN NOT st.\"uniprot_id\" IS NULL THEN pg.\"uniprot_id\" END) AS k FROM pathway_genes AS pg LEFT JOIN sorafenib_targets AS st ON pg.\"uniprot_id\" = st.\"uniprot_id\" GROUP BY pg.\"pathway_stable_id\"), params /* Global parameters */ AS (SELECT (SELECT COUNT(*) FROM universe) AS N_val, (SELECT COUNT(*) FROM universe AS u INNER JOIN sorafenib_targets AS st ON u.\"uniprot_id\" = st.\"uniprot_id\") AS K_val) SELECT pc.\"pathway_stable_id\" AS PATHWAY_ID, pw.\"name\" AS PATHWAY_NAME, pc.k AS TARGETS_IN_PATHWAY, p.K_val - pc.k AS TARGETS_OUTSIDE_PATHWAY, pc.n - pc.k AS NONTARGETS_IN_PATHWAY, p.N_val - p.K_val - pc.n + pc.k AS NONTARGETS_OUTSIDE_PATHWAY, ROUND(CAST(CAST(CAST(p.N_val AS DOUBLE PRECISION) * POWER(CAST(pc.k AS DOUBLE PRECISION) * CAST(p.N_val - p.K_val - pc.n + pc.k AS DOUBLE PRECISION) - CAST(p.K_val - pc.k AS DOUBLE PRECISION) * CAST(pc.n - pc.k AS DOUBLE PRECISION), 2) AS DOUBLE PRECISION) / NULLIF(CAST(p.K_val AS DOUBLE PRECISION) * CAST(p.N_val - p.K_val AS DOUBLE PRECISION) * CAST(pc.n AS DOUBLE PRECISION) * CAST(p.N_val - pc.n AS DOUBLE PRECISION), 0) AS DECIMAL), 2) AS CHI_SQUARED FROM pathway_counts AS pc CROSS JOIN params AS p JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" AS pw ON pc.\"pathway_stable_id\" = pw.\"stable_id\" WHERE pc.k > 0 ORDER BY CHI_SQUARED DESC LIMIT 3") t0 t1 t2 t3 t4
  = (sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH sorafenib_targets /* Step 1: Get sorafenib targets (Homo sapiens) that pass assay filters */ AS (SELECT DISTINCT i.\"target_uniprotID\" AS uniprot_id FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" AS i JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" AS e ON i.\"expID\" = e.\"expID\" WHERE LOWER(i.\"drugName\") LIKE '%sorafenib%' AND i.\"targetSpecies\" = 'Homo sapiens' AND e.\"exp_assayValueMedian\" <= 100 AND (e.\"exp_assayValueLow\" <= 100 OR e.\"exp_assayValueLow\" IS NULL) AND (e.\"exp_assayValueHigh\" <= 100 OR e.\"exp_assayValueHigh\" IS NULL)), all_pathway_genes /* Step 2: Get all unique proteins (uniprot_id) that appear in lowest-level Homo sapiens pathways with TAS evidence */ AS (SELECT DISTINCT pe.\"uniprot_id\", ptp.\"pathway_stable_id\" FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" AS pe JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" AS ptp ON pe.\"stable_id\" = ptp.\"pe_stable_id\" JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" AS p ON ptp.\"pathway_stable_id\" = p.\"stable_id\" WHERE ptp.\"evidence_code\" = 'TAS' AND p.\"lowest_level\" = TRUE AND p.\"species\" = 'Homo sapiens'), total_universe /* Step 3: Get the total universe of unique proteins across all TAS lowest-level pathways */ AS (SELECT COUNT(DISTINCT \"uniprot_id\") AS total_genes FROM all_pathway_genes), total_targets /* Step 4: Count total sorafenib targets (that are in the universe) */ AS (SELECT COUNT(DISTINCT st.uniprot_id) AS total_target_count FROM sorafenib_targets AS st WHERE EXISTS(SELECT 1 FROM all_pathway_genes AS apg WHERE apg.\"uniprot_id\" = st.uniprot_id)), lowest_level_pathways /* Step 5: Get lowest-level pathways */ AS (SELECT p.\"stable_id\", p.\"name\" FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" AS p WHERE p.\"lowest_level\" = TRUE AND p.\"species\" = 'Homo sapiens'), pathway_stats /* Step 6: For each pathway, count genes in pathway and targets in pathway */ AS (SELECT llp.\"stable_id\" AS pathway_id, llp.\"name\" AS pathway_name, COUNT(DISTINCT apg.\"uniprot_id\") AS genes_in_pathway, COUNT(DISTINCT CASE WHEN NOT st.uniprot_id IS NULL THEN apg.\"uniprot_id\" END) AS targets_in_pathway FROM lowest_level_pathways AS llp JOIN all_pathway_genes AS apg ON apg.\"pathway_stable_id\" = llp.\"stable_id\" LEFT JOIN sorafenib_targets AS st ON apg.\"uniprot_id\" = st.uniprot_id GROUP BY llp.\"stable_id\", llp.\"name\"), chi_sq /* Step 7: Build 2x2 contingency table and compute chi-squared */ AS (SELECT ps.pathway_id, ps.pathway_name, ps.targets_in_pathway AS a, tt.total_target_count - ps.targets_in_pathway AS b, ps.genes_in_pathway - ps.targets_in_pathway AS c, (tu.total_genes - ps.genes_in_pathway) - (tt.total_target_count - ps.targets_in_pathway) AS d, tu.total_genes AS n FROM pathway_stats AS ps CROSS JOIN total_universe AS tu CROSS JOIN total_targets AS tt) SELECT pathway_id AS \"PATHWAY_ID\", pathway_name AS \"PATHWAY_NAME\", a AS \"TARGETS_IN_PATHWAY\", b AS \"TARGETS_OUTSIDE_PATHWAY\", c AS \"NONTARGETS_IN_PATHWAY\", d AS \"NONTARGETS_OUTSIDE_PATHWAY\", ROUND(CAST(CAST((n * POWER((a * d) - (b * c), 2)) AS DOUBLE PRECISION) / CAST((NULLIF((a + b) * (c + d) * (a + c) * (b + d), 0)) AS DOUBLE PRECISION) AS DECIMAL), 4) AS \"CHI_SQUARED\" FROM chi_sq WHERE a > 0 /* only pathways that have at least one target */ ORDER BY \"CHI_SQUARED\" DESC LIMIT 3") t0 t1 t2 t3 t4
  := by first | sql_equiv | sorry

end N_sf_bq418_eq_0_2
