import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq094 — crossskill equivalence(s)

Question: Please provide a list of all 2016 committees that supported at least one candidate and received a total amount of individual contributions between $0 and $200 (inclusive of more than $0 and less than $200) where these small-dollar contributions sum to more than $0 overall. For each qualifying committee, include its name, the number of unique candidates it supported, the candidates’ names in alphabetical order (separated by commas), and the total sum of these small-dollar donations received by the committee.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq094

CREATE TABLE COMMITTEE_2016 («cmte_id» STRING, «cmte_nm» STRING, «tres_nm» STRING, «cmte_st1» STRING, «cmte_st2» STRING, «cmte_city» STRING, «cmte_st» STRING, «cmte_zip» STRING, «cmte_dsgn» STRING, «cmte_tp» STRING, «cmte_pty_affiliation» STRING, «cmte_filing_freq» STRING, «org_tp» STRING, «connected_org_nm» STRING, «cand_id» STRING)
CREATE TABLE CANDIDATE_2016 («cand_id» STRING, «cand_name» STRING, «cand_pty_affiliation» STRING, «cand_election_yr» INT, «cand_office_st» STRING, «cand_office» STRING, «cand_office_district» STRING, «cand_ici» STRING, «cand_status» STRING, «cand_pcc» STRING, «cand_st1» STRING, «cand_st2» STRING, «cand_city» STRING, «cand_st» STRING, «cand_zip» STRING)
CREATE TABLE CCL16 («cand_id» STRING, «cand_election_yr» INT, «fec_election_yr» INT, «cmte_id» STRING, «cmte_tp» STRING, «cmte_design» STRING, «linkage_id» INT)
CREATE TABLE CANDIDATE_COMMITTEE_2016 («cand_id» STRING, «cand_election_yr» INT, «fec_election_yr» INT, «cmte_id» STRING, «cmte_tp» STRING, «cmte_design» STRING, «linkage_id» INT)
CREATE TABLE CN16 («cand_id» STRING, «cand_name» STRING, «cand_pty_affiliation» STRING, «cand_election_yr» INT, «cand_office_st» STRING, «cand_office» STRING, «cand_office_district» STRING, «cand_ici» STRING, «cand_status» STRING, «cand_pcc» STRING, «cand_st1» STRING, «cand_st2» STRING, «cand_city» STRING, «cand_st» STRING, «cand_zip» STRING)
CREATE TABLE INDIV16 («cmte_id» STRING, «amndt_ind» STRING, «rpt_tp» STRING, «transaction_pgi» STRING, «image_num» INT, «transaction_tp» STRING, «entity_tp» STRING, «name» STRING, «city» STRING, «state» STRING, «zip_code» STRING, «employer» STRING, «occupation» STRING, «transaction_dt» STRING, «transaction_amt» FLOAT, «other_id» STRING, «tran_id» STRING, «file_num» INT, «memo_cd» STRING, «memo_text» STRING, «sub_id» INT)
CREATE TABLE INDIVIDUALS_2016 («cmte_id» STRING, «amndt_ind» STRING, «rpt_tp» STRING, «transaction_pgi» STRING, «image_num» INT, «transaction_tp» STRING, «entity_tp» STRING, «name» STRING, «city» STRING, «state» STRING, «zip_code» STRING, «employer» STRING, «occupation» STRING, «transaction_dt» STRING, «transaction_amt» FLOAT, «other_id» STRING, «tran_id» STRING, «file_num» INT, «memo_cd» STRING, «memo_text» STRING, «sub_id» INT)
CREATE TABLE CM16 («cmte_id» STRING, «cmte_nm» STRING, «tres_nm» STRING, «cmte_st1» STRING, «cmte_st2» STRING, «cmte_city» STRING, «cmte_st» STRING, «cmte_zip» STRING, «cmte_dsgn» STRING, «cmte_tp» STRING, «cmte_pty_affiliation» STRING, «cmte_filing_freq» STRING, «org_tp» STRING, «connected_org_nm» STRING, «cand_id» STRING)

theorem eq_0_1 :
    sql%([COMMITTEE_2016_schema, CANDIDATE_2016_schema, CCL16_schema, CANDIDATE_COMMITTEE_2016_schema, CN16_schema, INDIV16_schema, INDIVIDUALS_2016_schema, CM16_schema]) "WITH small_dollar AS (\n  SELECT i.\"cmte_id\", SUM(i.\"transaction_amt\") AS TOTAL_SMALL_DONATIONS\n  FROM \"FEC\".\"FEC\".\"INDIVIDUALS_2016\" i\n  WHERE i.\"transaction_amt\" > 0 AND i.\"transaction_amt\" < 200\n  GROUP BY i.\"cmte_id\"\n  HAVING SUM(i.\"transaction_amt\") > 0 AND SUM(i.\"transaction_amt\") < 200\n),\ncommittee_candidates AS (\n  SELECT cc.\"cmte_id\",\n    COUNT(DISTINCT cc.\"cand_id\") AS num_candidates,\n    LISTAGG(DISTINCT ca.\"cand_name\", ', ') WITHIN GROUP (ORDER BY ca.\"cand_name\") AS candidate_names\n  FROM \"FEC\".\"FEC\".\"CANDIDATE_COMMITTEE_2016\" cc\n  JOIN \"FEC\".\"FEC\".\"CANDIDATE_2016\" ca ON cc.\"cand_id\" = ca.\"cand_id\"\n  GROUP BY cc.\"cmte_id\"\n)\nSELECT\n  c.\"cmte_nm\",\n  ccand.num_candidates,\n  ccand.candidate_names,\n  sd.TOTAL_SMALL_DONATIONS\nFROM small_dollar sd\nJOIN \"FEC\".\"FEC\".\"COMMITTEE_2016\" c ON sd.\"cmte_id\" = c.\"cmte_id\"\nJOIN committee_candidates ccand ON sd.\"cmte_id\" = ccand.\"cmte_id\"\nORDER BY c.\"cmte_nm\"" = sql%([COMMITTEE_2016_schema, CANDIDATE_2016_schema, CCL16_schema, CANDIDATE_COMMITTEE_2016_schema, CN16_schema, INDIV16_schema, INDIVIDUALS_2016_schema, CM16_schema]) "WITH small_donations AS (\n    SELECT\n        T4.\"cmte_id\",\n        SUM(T4.\"transaction_amt\") AS TOTAL_SMALL_DONATIONS\n    FROM \"FEC\".\"FEC\".\"INDIVIDUALS_2016\" AS T4\n    WHERE T4.\"transaction_amt\" > 0\n      AND T4.\"transaction_amt\" < 200\n    GROUP BY T4.\"cmte_id\"\n    HAVING SUM(T4.\"transaction_amt\") > 0\n       AND SUM(T4.\"transaction_amt\") < 200\n)\nSELECT\n    T3.\"cmte_nm\",\n    COUNT(DISTINCT T1.\"cand_id\") AS \"COUNT(DISTINCT T1.\"\"CAND_ID\"\")\",\n    LISTAGG(DISTINCT T2.\"cand_name\", ', ') WITHIN GROUP (ORDER BY T2.\"cand_name\") AS \"LISTAGG(DISTINCT T2.\"\"CAND_NAME\"\", ', ') WITHIN GROUP (ORDER BY T2.\"\"CAND_NAME\"\")\",\n    sd.TOTAL_SMALL_DONATIONS\nFROM \"FEC\".\"FEC\".\"CANDIDATE_COMMITTEE_2016\" AS T1\nLEFT JOIN \"FEC\".\"FEC\".\"CANDIDATE_2016\" AS T2\n    ON T1.\"cand_id\" = T2.\"cand_id\"\nINNER JOIN \"FEC\".\"FEC\".\"COMMITTEE_2016\" AS T3\n    ON T1.\"cmte_id\" = T3.\"cmte_id\"\nINNER JOIN small_donations sd\n    ON T3.\"cmte_id\" = sd.\"cmte_id\"\nGROUP BY T3.\"cmte_nm\", sd.TOTAL_SMALL_DONATIONS\nORDER BY T3.\"cmte_nm\"" := by
  first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([COMMITTEE_2016_schema, CANDIDATE_2016_schema, CCL16_schema, CANDIDATE_COMMITTEE_2016_schema, CN16_schema, INDIV16_schema, INDIVIDUALS_2016_schema, CM16_schema]) "WITH small_dollar AS (\n  SELECT i.\"cmte_id\", SUM(i.\"transaction_amt\") AS TOTAL_SMALL_DONATIONS\n  FROM \"FEC\".\"FEC\".\"INDIVIDUALS_2016\" i\n  WHERE i.\"transaction_amt\" > 0 AND i.\"transaction_amt\" < 200\n  GROUP BY i.\"cmte_id\"\n  HAVING SUM(i.\"transaction_amt\") > 0 AND SUM(i.\"transaction_amt\") < 200\n),\ncommittee_candidates AS (\n  SELECT cc.\"cmte_id\",\n    COUNT(DISTINCT cc.\"cand_id\") AS num_candidates,\n    LISTAGG(DISTINCT ca.\"cand_name\", ', ') WITHIN GROUP (ORDER BY ca.\"cand_name\") AS candidate_names\n  FROM \"FEC\".\"FEC\".\"CANDIDATE_COMMITTEE_2016\" cc\n  JOIN \"FEC\".\"FEC\".\"CANDIDATE_2016\" ca ON cc.\"cand_id\" = ca.\"cand_id\"\n  GROUP BY cc.\"cmte_id\"\n)\nSELECT\n  c.\"cmte_nm\",\n  ccand.num_candidates,\n  ccand.candidate_names,\n  sd.TOTAL_SMALL_DONATIONS\nFROM small_dollar sd\nJOIN \"FEC\".\"FEC\".\"COMMITTEE_2016\" c ON sd.\"cmte_id\" = c.\"cmte_id\"\nJOIN committee_candidates ccand ON sd.\"cmte_id\" = ccand.\"cmte_id\"\nORDER BY c.\"cmte_nm\"" = sql%([COMMITTEE_2016_schema, CANDIDATE_2016_schema, CCL16_schema, CANDIDATE_COMMITTEE_2016_schema, CN16_schema, INDIV16_schema, INDIVIDUALS_2016_schema, CM16_schema]) "WITH small_donations AS (\n    SELECT\n        \"cmte_id\",\n        SUM(\"transaction_amt\") AS total_small_donations\n    FROM \"FEC\".\"FEC\".\"INDIV16\"\n    WHERE \"transaction_amt\" > 0\n      AND \"transaction_amt\" < 200\n    GROUP BY \"cmte_id\"\n    HAVING SUM(\"transaction_amt\") > 0\n       AND SUM(\"transaction_amt\") < 200\n),\ncommittee_candidates AS (\n    SELECT DISTINCT\n        T1.\"cmte_id\",\n        T1.\"cand_id\",\n        T2.\"cand_name\"\n    FROM \"FEC\".\"FEC\".\"CCL16\" T1\n    JOIN \"FEC\".\"FEC\".\"CN16\" T2\n        ON T1.\"cand_id\" = T2.\"cand_id\"\n)\nSELECT\n    T0.\"cmte_nm\" AS \"cmte_nm\",\n    COUNT(DISTINCT cc.\"cand_id\") AS \"COUNT(DISTINCT T1.\"\"CAND_ID\"\")\",\n    LISTAGG(DISTINCT cc.\"cand_name\", ', ') WITHIN GROUP (ORDER BY cc.\"cand_name\") AS \"LISTAGG(DISTINCT T2.\"\"CAND_NAME\"\", ', ') WITHIN GROUP (ORDER BY T2.\"\"CAND_NAME\"\")\",\n    sd.total_small_donations AS \"TOTAL_SMALL_DONATIONS\"\nFROM \"FEC\".\"FEC\".\"CM16\" T0\nJOIN small_donations sd\n    ON T0.\"cmte_id\" = sd.\"cmte_id\"\nJOIN committee_candidates cc\n    ON T0.\"cmte_id\" = cc.\"cmte_id\"\nGROUP BY T0.\"cmte_nm\", sd.total_small_donations\nORDER BY T0.\"cmte_nm\";" := by
  first | sql_equiv | sorry

