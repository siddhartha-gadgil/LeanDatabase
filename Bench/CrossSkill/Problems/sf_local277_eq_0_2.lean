CREATE TABLE MONTHLY_SALES («product_id» INT, «mth» STRING, «qty» INT)

theorem eq (t0 : TableRel MONTHLY_SALES_schema) :
    (sql%([MONTHLY_SALES_schema]) "WITH base AS (SELECT \"product_id\", \"mth\", \"qty\", ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790)), cma AS (SELECT a.\"product_id\", a.t, a.\"qty\", CAST((CAST(SUM(CASE WHEN b.t BETWEEN a.t - 5 AND a.t + 6 THEN b.\"qty\" END) AS DOUBLE PRECISION) / 12.0 + CAST(SUM(CASE WHEN b.t BETWEEN a.t - 6 AND a.t + 5 THEN b.\"qty\" END) AS DOUBLE PRECISION) / 12.0) AS DOUBLE PRECISION) / 2.0 AS cma_value, ((a.t - 1) % 12) + 1 AS month_num FROM base AS a JOIN base AS b ON a.\"product_id\" = b.\"product_id\" WHERE a.t BETWEEN 7 AND 30 GROUP BY a.\"product_id\", a.t, a.\"qty\"), ratios AS (SELECT \"product_id\", t, \"qty\", cma_value, CAST(\"qty\" AS DOUBLE PRECISION) / NULLIF(cma_value, 0) AS ratio, month_num FROM cma), seasonal_indices AS (SELECT \"product_id\", month_num, AVG(ratio) AS seasonal_index FROM ratios GROUP BY \"product_id\", month_num), deseas AS (SELECT r.\"product_id\", r.t, r.cma_value, r.month_num, si.seasonal_index, CAST(r.\"qty\" AS DOUBLE PRECISION) / NULLIF(si.seasonal_index, 0) AS deseasonalized FROM ratios AS r JOIN seasonal_indices AS si ON r.\"product_id\" = si.\"product_id\" AND r.month_num = si.month_num), wls_regression AS (SELECT \"product_id\", SUM(cma_value) AS sum_w, SUM(cma_value * CAST(t AS DOUBLE PRECISION)) AS sum_wx, SUM(cma_value * CAST(t AS DOUBLE PRECISION) * CAST(t AS DOUBLE PRECISION)) AS sum_wx2, SUM(cma_value * deseasonalized) AS sum_wy, SUM(cma_value * CAST(t AS DOUBLE PRECISION) * deseasonalized) AS sum_wxy FROM deseas GROUP BY \"product_id\"), regression_coeffs AS (SELECT \"product_id\", CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0) AS slope, CAST((sum_wy - (CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0)) * sum_wx) AS DOUBLE PRECISION) / NULLIF(sum_w, 0) AS intercept FROM wls_regression), forecast_2018 AS (SELECT rc.\"product_id\", si.month_num, (rc.intercept + rc.slope * (24.0 + si.month_num)) * si.seasonal_index AS forecasted_sales FROM regression_coeffs AS rc JOIN seasonal_indices AS si ON rc.\"product_id\" = si.\"product_id\") SELECT ROUND(CAST(AVG(annual_sales) AS DECIMAL), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM (SELECT \"product_id\", SUM(forecasted_sales) AS annual_sales FROM forecast_2018 GROUP BY \"product_id\")") t0
  ~= (sql%([MONTHLY_SALES_schema]) "WITH base AS (/* Assign time steps 1-36 per product starting Jan 2016 */ SELECT \"product_id\", \"mth\", \"qty\", ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t, EXTRACT(MONTH FROM CAST(TO_TIMESTAMP(\"mth\", 'YYYY-MM-DD') AS DATE)) AS month_of_year FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\" WHERE \"product_id\" IN (4160, 7790) AND \"mth\" >= '2016-01-01' AND \"mth\" < '2019-01-01'), cma_calc /* Step 1: Compute Centered Moving Average (CMA) using two overlapping 12-month windows */ AS (SELECT b.\"product_id\", b.t, b.\"mth\", b.\"qty\", b.month_of_year, AVG(b2.\"qty\") AS ma1 /* Window 1: t-5 to t+6 */, AVG(b3.\"qty\") AS ma2 /* Window 2: t-6 to t+5 */ FROM base AS b LEFT JOIN base AS b2 ON b.\"product_id\" = b2.\"product_id\" AND b2.t BETWEEN b.t - 5 AND b.t + 6 LEFT JOIN base AS b3 ON b.\"product_id\" = b3.\"product_id\" AND b3.t BETWEEN b.t - 6 AND b.t + 5 GROUP BY b.\"product_id\", b.t, b.\"mth\", b.\"qty\", b.month_of_year), cma AS (SELECT \"product_id\", t, \"mth\", \"qty\", month_of_year, CASE WHEN t >= 7 AND t <= 30 THEN CAST((ma1 + ma2) AS DOUBLE PRECISION) / 2.0 ELSE NULL END AS cma_value FROM cma_calc), ratios /* Step 2: Compute sales-to-CMA ratio for time steps 7-30 */ AS (SELECT \"product_id\", t, month_of_year, \"qty\", cma_value, CAST(\"qty\" AS DOUBLE PRECISION) / NULLIF(cma_value, 0) AS ratio FROM cma WHERE t BETWEEN 7 AND 30 AND NOT cma_value IS NULL), seasonal_factors /* Step 3: Compute seasonal factors (average ratio per month-of-year per product) */ AS (SELECT \"product_id\", month_of_year, AVG(ratio) AS seasonal_factor FROM ratios GROUP BY \"product_id\", month_of_year), deseasonalized /* Step 4: Deseasonalize data for time steps 7-30 */ AS (SELECT c.\"product_id\", c.t, c.\"qty\", c.month_of_year, sf.seasonal_factor, CAST(c.\"qty\" AS DOUBLE PRECISION) / NULLIF(sf.seasonal_factor, 0) AS deseasonalized_qty FROM cma AS c JOIN seasonal_factors AS sf ON c.\"product_id\" = sf.\"product_id\" AND c.month_of_year = sf.month_of_year WHERE c.t BETWEEN 7 AND 30), regression /* Step 5: Weighted linear regression on deseasonalized data (time steps 7-30) */ /* Using REGR functions: y = deseasonalized_qty, x = t, weighted by t */ AS (SELECT \"product_id\", CAST(REGR_SLOPE(deseasonalized_qty * t, t * t) AS DOUBLE PRECISION) / REGR_SLOPE(t, t) AS w_slope, REGR_INTERCEPT(deseasonalized_qty * t, t * t) AS w_intercept_raw, SUM(t * deseasonalized_qty * t) AS sum_wxy /* Standard weighted regression: minimize sum(w_i * (y_i - a - b*x_i)^2) */ /* With weights = time step t */, SUM(t * t) AS sum_wx2, SUM(t * deseasonalized_qty) AS sum_wy, SUM(t) AS sum_w, SUM(t * t * t) AS sum_wx3, COUNT(*) AS n FROM deseasonalized GROUP BY \"product_id\"), weighted_reg /* Weighted regression coefficients */ /* b = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wx3 - sum_wx2 * sum_wx2)  -- wrong */ /* Actually: weight w_i = t_i */ /* sum_w = SUM(w_i), sum_wx = SUM(w_i * x_i), sum_wy = SUM(w_i * y_i) */ /* sum_wxx = SUM(w_i * x_i * x_i), sum_wxy = SUM(w_i * x_i * y_i) */ /* slope = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wxx - sum_wx * sum_wx) */ /* intercept = (sum_wy - slope * sum_wx) / sum_w */ AS (SELECT \"product_id\", SUM(t) AS sum_w, SUM(t * t) AS sum_wx /* sum(w_i * x_i) where w=t, x=t => sum(t^2) */, SUM(t * deseasonalized_qty) AS sum_wy /* sum(w_i * y_i) */, SUM(t * t * t) AS sum_wxx /* sum(w_i * x_i^2) = sum(t^3) */, SUM(t * t * deseasonalized_qty) AS sum_wxy /* sum(w_i * x_i * y_i) = sum(t^2 * y) */ FROM deseasonalized GROUP BY \"product_id\"), reg_coeffs AS (SELECT \"product_id\", CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0) AS slope, CAST((sum_wy - (CAST((sum_w * sum_wxy - sum_wx * sum_wy) AS DOUBLE PRECISION) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0)) * sum_wx) AS DOUBLE PRECISION) / NULLIF(sum_w, 0) AS intercept FROM weighted_reg), forecast_months /* Step 6: Generate time steps for 2018 (t = 25 to 36) */ AS (SELECT \"product_id\", 25 AS t, 1 AS month_of_year FROM reg_coeffs UNION ALL SELECT \"product_id\", 26, 2 FROM reg_coeffs UNION ALL SELECT \"product_id\", 27, 3 FROM reg_coeffs UNION ALL SELECT \"product_id\", 28, 4 FROM reg_coeffs UNION ALL SELECT \"product_id\", 29, 5 FROM reg_coeffs UNION ALL SELECT \"product_id\", 30, 6 FROM reg_coeffs UNION ALL SELECT \"product_id\", 31, 7 FROM reg_coeffs UNION ALL SELECT \"product_id\", 32, 8 FROM reg_coeffs UNION ALL SELECT \"product_id\", 33, 9 FROM reg_coeffs UNION ALL SELECT \"product_id\", 34, 10 FROM reg_coeffs UNION ALL SELECT \"product_id\", 35, 11 FROM reg_coeffs UNION ALL SELECT \"product_id\", 36, 12 FROM reg_coeffs), forecasted /* Step 7: Forecast = (intercept + slope * t) * seasonal_factor */ AS (SELECT fm.\"product_id\", fm.t, fm.month_of_year, rc.intercept + rc.slope * fm.t AS deseasonalized_forecast, sf.seasonal_factor, (rc.intercept + rc.slope * fm.t) * sf.seasonal_factor AS forecasted_qty FROM forecast_months AS fm JOIN reg_coeffs AS rc ON fm.\"product_id\" = rc.\"product_id\" JOIN seasonal_factors AS sf ON fm.\"product_id\" = sf.\"product_id\" AND fm.month_of_year = sf.month_of_year), annual_forecast /* Step 8: Sum monthly forecasts to get annual 2018 per product */ AS (SELECT \"product_id\", SUM(forecasted_qty) AS annual_sales_2018 FROM forecasted GROUP BY \"product_id\") /* Step 9: Average across both products */ SELECT ROUND(CAST(AVG(annual_sales_2018) AS DECIMAL), 2) AS \"AVG_FORECASTED_ANNUAL_SALES_2018\" FROM annual_forecast") t0
