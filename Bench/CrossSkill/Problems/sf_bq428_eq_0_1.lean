in_rows UNION ALL SELECT * FROM lose_rows) SELECT g.\"season\", g.\"round\", g.\"days_from_epoch\", g.\"game_date\", g.\"day\", g.\"label\", g.\"seed\", g.\"market\", g.\"name\", g.\"alias\", g.\"school_ncaa\", g.\"opponent_seed\", g.\"opponent_market\", g.\"opponent_name\", g.\"opponent_alias\", g.\"opponent_school_ncaa\" FROM all_games AS g INNER JOIN top_markets AS tm ON g.\"market\" = tm.\"team_market\" ORDER BY g.\"market\", g.\"season\", g.\"round\" DESC") t0 t1
