theorem eq (t0 : TableRel TAXI_TRIPS_schema) :
    (sql%([TAXI_TRIPS_schema]) "WITH agg_by_seconds AS (SELECT \"trip_seconds\", COUNT(*) AS row_cnt, SUM(\"fare\") AS fare_sum, COUNT(\"fare\") AS fare_cnt FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" WHERE NOT \"trip_seconds\" IS NULL AND \"trip_seconds\" >= 0 AND \"trip_seconds\" <= 3600 GROUP BY \"trip_seconds\"), with_cumulative AS (SELECT \"trip_seconds\", row_cnt, fare_sum, fare_cnt, SUM(row_cnt) OVER (ORDER BY \"trip_seconds\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_end, SUM(row_cnt) OVER (ORDER BY \"trip_seconds\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) - row_cnt + 1 AS cum_start FROM agg_by_seconds), total AS (SELECT SUM(row_cnt) AS n, SUM(row_cnt) % 6 AS remainder FROM agg_by_seconds), groups /* NTILE boundary: group g contains rows from boundary(g-1)+1 to boundary(g) */ /* where boundary(g) = FLOOR(n/6)*g + LEAST(g, n%6) */ /* boundary(0) = 0 */ AS (SELECT 1 AS grp UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6), group_boundaries AS (SELECT g.grp, FLOOR(CAST(t.n AS DOUBLE PRECISION) / 6.0) * (g.grp - 1) + LEAST(g.grp - 1, t.remainder) + 1 AS grp_start, FLOOR(CAST(t.n AS DOUBLE PRECISION) / 6.0) * g.grp + LEAST(g.grp, t.remainder) AS grp_end FROM groups AS g CROSS JOIN total AS t), expanded AS (SELECT c.\"trip_seconds\", c.row_cnt, c.fare_sum, c.fare_cnt, c.cum_start, c.cum_end, gb.grp AS quantile_group, GREATEST(c.cum_start, gb.grp_start) AS overlap_start, LEAST(c.cum_end, gb.grp_end) AS overlap_end FROM with_cumulative AS c CROSS JOIN group_boundaries AS gb WHERE c.cum_start <= gb.grp_end AND c.cum_end >= gb.grp_start) SELECT ROUND(CAST(MIN(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) AS DECIMAL), 1) AS min_minutes, ROUND(CAST(MAX(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) AS DECIMAL), 1) AS max_minutes, SUM(overlap_end - overlap_start + 1) AS total_trips, CAST(SUM(CASE WHEN fare_cnt > 0 THEN CAST(fare_sum * (overlap_end - overlap_start + 1) AS DOUBLE PRECISION) / row_cnt ELSE 0 END) AS DOUBLE PRECISION) / SUM(overlap_end - overlap_start + 1) AS average_fare FROM expanded GROUP BY quantile_group ORDER BY quantile_group") t0
