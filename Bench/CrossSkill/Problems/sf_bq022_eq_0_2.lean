start, LEAST(a.cum_cnt, b.grp_end) AS overlap_end FROM assigned AS a JOIN grp_boundaries AS b ON a.cum_cnt >= b.grp_start AND a.prev_cum < b.grp_end), with_rows AS (SELECT ts, cnt, total_fare, grp, (overlap_end - overlap_start + 1) AS grp_rows FROM ts_grp WHERE overlap_end >= overlap_start) SELECT ROUND(CAST(CAST(MIN(ts) AS DOUBLE PRECISION) / 60.0 AS DECIMAL), 1) AS min_minutes, ROUND(CAST(CAST(MAX(ts) AS DOUBLE PRECISION) / 60.0 AS DECIMAL), 1) AS max_minutes, CAST(SUM(grp_rows) AS INT) AS total_trips, CAST(SUM(CAST(total_fare * CAST(grp_rows AS DOUBLE PRECISION) AS DOUBLE PRECISION) / cnt) AS DOUBLE PRECISION) / SUM(grp_rows) AS average_fare FROM with_rows GROUP BY grp ORDER BY grp") t0
