theorem eq_0_1 : ∀ t,
    (sql%([LEAGUE_schema, MATCH_schema, TEAM_schema]) "WITH team_match_wins AS (\n    -- Home wins\n    SELECT\n        \"league_id\",\n        \"home_team_api_id\" AS team_api_id,\n        CASE WHEN \"home_team_goal\" > \"away_team_goal\" THEN 1 ELSE 0 END AS win\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n    UNION ALL\n    -- Away wins\n    SELECT\n        \"league_id\",\n        \"away_team_api_id\" AS team_api_id,\n        CASE WHEN \"away_team_goal\" > \"home_team_goal\" THEN 1 ELSE 0 END AS win\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n),\nteam_league_wins AS (\n    SELECT\n        \"league_id\",\n        team_api_id,\n        SUM(win) AS total_wins\n    FROM team_match_wins\n    GROUP BY \"league_id\", team_api_id\n),\nranked AS (\n    SELECT\n        l.\"name\" AS LEAGUE_NAME,\n        t.\"team_long_name\" AS TEAM_NAME,\n        tw.total_wins AS TOTAL_WINS,\n        ROW_NUMBER() OVER (\n            PARTITION BY tw.\"league_id\"\n            ORDER BY tw.total_wins ASC, t.\"team_api_id\" ASC\n        ) AS rn\n    FROM team_league_wins tw\n    JOIN \"EU_SOCCER\".\"EU_SOCCER\".\"LEAGUE\" l ON tw.\"league_id\" = l.\"id\"\n    JOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" t ON tw.team_api_id = t.\"team_api_id\"\n)\nSELECT\n    LEAGUE_NAME,\n    TEAM_NAME,\n    TOTAL_WINS\nFROM ranked\nWHERE rn = 1\nORDER BY LEAGUE_NAME;") t ~= (sql%([LEAGUE_schema, MATCH_schema, TEAM_schema]) "WITH home_wins AS (\n  SELECT \"league_id\", \"home_team_api_id\" AS team_id, COUNT(*) AS wins\n  FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n  WHERE \"home_team_goal\" > \"away_team_goal\"\n  GROUP BY \"league_id\", \"home_team_api_id\"\n),\naway_wins AS (\n  SELECT \"league_id\", \"away_team_api_id\" AS team_id, COUNT(*) AS wins\n  FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n  WHERE \"away_team_goal\" > \"home_team_goal\"\n  GROUP BY \"league_id\", \"away_team_api_id\"\n),\nall_teams AS (\n  SELECT DISTINCT \"league_id\", \"home_team_api_id\" AS team_id FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n  UNION\n  SELECT DISTINCT \"league_id\", \"away_team_api_id\" AS team_id FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n),\ntotal_wins AS (\n  SELECT a.\"league_id\", a.team_id,\n    COALESCE(hw.wins, 0) + COALESCE(aw.wins, 0) AS total_wins\n  FROM all_teams a\n  LEFT JOIN home_wins hw ON a.\"league_id\" = hw.\"league_id\" AND a.team_id = hw.team_id\n  LEFT JOIN away_wins aw ON a.\"league_id\" = aw.\"league_id\" AND a.team_id = aw.team_id\n),\nranked AS (\n  SELECT tw.\"league_id\", tw.team_id, tw.total_wins,\n    ROW_NUMBER() OVER (PARTITION BY tw.\"league_id\" ORDER BY tw.total_wins ASC, tw.team_id ASC) AS rn\n  FROM total_wins tw\n)\nSELECT\n  l.\"name\" AS LEAGUE_NAME,\n  t.\"team_long_name\" AS TEAM_NAME,\n  r.total_wins AS TOTAL_WINS\nFROM ranked r\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"LEAGUE\" l ON r.\"league_id\" = l.\"id\"\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" t ON r.team_id = t.\"team_api_id\"\nWHERE r.rn = 1\nORDER BY l.\"name\";") t := by
