    sql%([LEAGUE_schema, MATCH_schema, TEAM_schema]) "WITH all_teams_leagues AS (\n    -- Get all distinct team/league combinations from MATCH (both home and away)\n    SELECT DISTINCT \"league_id\", \"home_team_api_id\" AS \"team_api_id\"\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n    UNION\n    SELECT DISTINCT \"league_id\", \"away_team_api_id\" AS \"team_api_id\"\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n),\nhome_wins AS (\n    SELECT \"league_id\", \"home_team_api_id\" AS \"team_api_id\", COUNT(*) AS \"wins\"\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n    WHERE \"home_team_goal\" > \"away_team_goal\"\n    GROUP BY \"league_id\", \"home_team_api_id\"\n),\naway_wins AS (\n    SELECT \"league_id\", \"away_team_api_id\" AS \"team_api_id\", COUNT(*) AS \"wins\"\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n    WHERE \"away_team_goal\" > \"home_team_goal\"\n    GROUP BY \"league_id\", \"away_team_api_id\"\n),\ntotal_wins AS (\n    SELECT\n        atl.\"league_id\",\n        atl.\"team_api_id\",\n        COALESCE(hw.\"wins\", 0) + COALESCE(aw.\"wins\", 0) AS \"TOTAL_WINS\"\n    FROM all_teams_leagues atl\n    LEFT JOIN home_wins hw ON atl.\"league_id\" = hw.\"league_id\" AND atl.\"team_api_id\" = hw.\"team_api_id\"\n    LEFT JOIN away_wins aw ON atl.\"league_id\" = aw.\"league_id\" AND atl.\"team_api_id\" = aw.\"team_api_id\"\n),\nranked AS (\n    SELECT\n        tw.\"league_id\",\n        tw.\"team_api_id\",\n        tw.\"TOTAL_WINS\",\n        ROW_NUMBER() OVER (PARTITION BY tw.\"league_id\" ORDER BY tw.\"TOTAL_WINS\" ASC, tw.\"team_api_id\" ASC) AS rn\n    FROM total_wins tw\n)\nSELECT\n    l.\"name\" AS \"LEAGUE_NAME\",\n    t.\"team_long_name\" AS \"TEAM_NAME\",\n    r.\"TOTAL_WINS\"\nFROM ranked r\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"LEAGUE\" l ON r.\"league_id\" = l.\"id\"\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" t ON r.\"team_api_id\" = t.\"team_api_id\"\nWHERE r.rn = 1\nORDER BY l.\"name\";" = sql%([LEAGUE_schema, MATCH_schema, TEAM_schema]) "WITH all_teams_in_leagues AS (\n    -- Get all distinct team-league combinations from matches\n    SELECT DISTINCT m.\"league_id\", m.\"home_team_api_id\" AS \"team_api_id\"\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" m\n    UNION\n    SELECT DISTINCT m.\"league_id\", m.\"away_team_api_id\" AS \"team_api_id\"\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" m\n),\nhome_wins AS (\n    SELECT \"league_id\", \"home_team_api_id\" AS \"team_api_id\", COUNT(*) AS wins\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n    WHERE \"home_team_goal\" > \"away_team_goal\"\n    GROUP BY \"league_id\", \"home_team_api_id\"\n),\naway_wins AS (\n    SELECT \"league_id\", \"away_team_api_id\" AS \"team_api_id\", COUNT(*) AS wins\n    FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"\n    WHERE \"away_team_goal\" > \"home_team_goal\"\n    GROUP BY \"league_id\", \"away_team_api_id\"\n),\ntotal_wins AS (\n    SELECT\n        atl.\"league_id\",\n        atl.\"team_api_id\",\n        COALESCE(hw.wins, 0) + COALESCE(aw.wins, 0) AS \"TOTAL_WINS\"\n    FROM all_teams_in_leagues atl\n    LEFT JOIN home_wins hw\n        ON atl.\"league_id\" = hw.\"league_id\" AND atl.\"team_api_id\" = hw.\"team_api_id\"\n    LEFT JOIN away_wins aw\n        ON atl.\"league_id\" = aw.\"league_id\" AND atl.\"team_api_id\" = aw.\"team_api_id\"\n),\nranked AS (\n    SELECT\n        tw.\"league_id\",\n        tw.\"team_api_id\",\n        tw.\"TOTAL_WINS\",\n        ROW_NUMBER() OVER (PARTITION BY tw.\"league_id\" ORDER BY tw.\"TOTAL_WINS\" ASC, tw.\"team_api_id\" ASC) AS rn\n    FROM total_wins tw\n)\nSELECT\n    l.\"name\" AS \"LEAGUE_NAME\",\n    t.\"team_long_name\" AS \"TEAM_NAME\",\n    r.\"TOTAL_WINS\"\nFROM ranked r\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"LEAGUE\" l ON r.\"league_id\" = l.\"id\"\nJOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" t ON r.\"team_api_id\" = t.\"team_api_id\"\nWHERE r.rn = 1\nORDER BY l.\"name\";" := by
