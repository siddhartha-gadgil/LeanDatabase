intent' UNION ALL SELECT 'android-fragments' UNION ALL SELECT 'android-actionbar' UNION ALL SELECT 'android-recyclerview' UNION ALL SELECT 'android-edittext' UNION ALL SELECT 'android-asynctask' UNION ALL SELECT 'google-maps' UNION ALL SELECT 'listview'), split_tags AS (SELECT q.\"id\", q.\"title\", q.\"body\", q.\"view_count\", TRIM(CAST(t.value AS TEXT)) AS tag FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q, LATERAL UNNEST(INPUT => SPLIT(q.\"tags\", '|')) AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT q.\"tags\" IS NULL), filtered AS (SELECT s.tag, s.\"title\", s.\"view_count\" FROM split_tags AS s INNER JOIN android_tags AS a ON s.tag = a.tag WHERE (LOWER(s.\"title\") LIKE '%how%' OR LOWER(s.\"body\") LIKE '%how%') AND NOT (LOWER(s.\"title\") LIKE '%fail%' OR LOWER(s.\"body\") LIKE '%fail%' OR LOWER(s.\"title\") LIKE '%problem%' OR LOWER(s.\"body\") LIKE '%problem%' OR LOWER(s.\"title\") LIKE '%error%' OR LOWER(s.\"body\") LIKE '%error%' OR LOWER(s.\"title\") LIKE '%wrong%' OR LOWER(s.\"body\") LIKE '%wrong%' OR LOWER(s.\"title\") LIKE '%fix%' OR LOWER(s.\"body\") LIKE '%fix%' OR LOWER(s.\"title\") LIKE '%bug%' OR LOWER(s.\"body\") LIKE '%bug%' OR LOWER(s.\"title\") LIKE '%issue%' OR LOWER(s.\"body\") LIKE '%issue%' OR LOWER(s.\"title\") LIKE '%solve%' OR LOWER(s.\"body\") LIKE '%solve%' OR LOWER(s.\"title\") LIKE '%trouble%' OR LOWER(s.\"body\") LIKE '%trouble%')), tag_counts AS (SELECT tag, COUNT(*) AS cnt FROM filtered GROUP BY tag HAVING COUNT(*) >= 50), ranked AS (SELECT f.tag AS TAG, f.\"title\" AS TITLE, f.\"view_count\" AS VIEW_COUNT, ROW_NUMBER() OVER (PARTITION BY f.tag ORDER BY f.\"view_count\" DESC) AS rn FROM filtered AS f INNER JOIN tag_counts AS tc ON f.tag = tc.tag) SELECT TAG, TITLE, VIEW_COUNT FROM ranked WHERE rn <= 50 ORDER BY TAG, VIEW_COUNT DESC") t := by
