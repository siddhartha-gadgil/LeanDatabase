/-!
# sf_bq304 — crossskill equivalence(s)

Question: Retrieve the top 50 most viewed questions for each of the following Android-related tags on StackOverflow: 'android-layout', 'android-activity', 'android-intent', 'android-edittext', 'android-fragments', 'android-recyclerview', 'listview', 'android-actionbar', 'google-maps', and 'android-asynctask'. Each question must contain the word 'how' in either its title or body and must not contain any of the following troubleshooting terms in either its title or body: 'fail', 'problem', 'error', 'wrong', 'fix', 'bug', 'issue', 'solve', or 'trouble'. Only include tags that have at least 50 questions meeting these criteria, and for each such tag, select the top 50 questions ranked by view count.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq304

CREATE TABLE TAGS («id» INT, «tag_name» STRING, «count» INT, «excerpt_post_id» INT, «wiki_post_id» INT)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

theorem eq_0_1 : ∀ t,
    (sql%([TAGS_schema, POSTS_QUESTIONS_schema]) "WITH tagged_questions AS (\n  SELECT \n    q.\"id\",\n    q.\"title\" AS TITLE,\n    q.\"view_count\" AS VIEW_COUNT,\n    t.value::STRING AS TAG\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q,\n    LATERAL SPLIT_TO_TABLE(q.\"tags\", '|') t\n  WHERE t.value::STRING IN (\n    'android-layout', 'android-activity', 'android-intent', \n    'android-edittext', 'android-fragments', 'android-recyclerview', \n    'listview', 'android-actionbar', 'google-maps', 'android-asynctask'\n  )\n    AND (LOWER(q.\"title\") LIKE '%how%' OR LOWER(q.\"body\") LIKE '%how%')\n    AND NOT (LOWER(q.\"title\") LIKE '%fail%' OR LOWER(q.\"body\") LIKE '%fail%')\n    AND NOT (LOWER(q.\"title\") LIKE '%problem%' OR LOWER(q.\"body\") LIKE '%problem%')\n    AND NOT (LOWER(q.\"title\") LIKE '%error%' OR LOWER(q.\"body\") LIKE '%error%')\n    AND NOT (LOWER(q.\"title\") LIKE '%wrong%' OR LOWER(q.\"body\") LIKE '%wrong%')\n    AND NOT (LOWER(q.\"title\") LIKE '%fix%' OR LOWER(q.\"body\") LIKE '%fix%')\n    AND NOT (LOWER(q.\"title\") LIKE '%bug%' OR LOWER(q.\"body\") LIKE '%bug%')\n    AND NOT (LOWER(q.\"title\") LIKE '%issue%' OR LOWER(q.\"body\") LIKE '%issue%')\n    AND NOT (LOWER(q.\"title\") LIKE '%solve%' OR LOWER(q.\"body\") LIKE '%solve%')\n    AND NOT (LOWER(q.\"title\") LIKE '%trouble%' OR LOWER(q.\"body\") LIKE '%trouble%')\n),\nqualified_tags AS (\n  SELECT TAG\n  FROM tagged_questions\n  GROUP BY TAG\n  HAVING COUNT(*) >= 50\n),\nranked AS (\n  SELECT \n    tq.TAG,\n    tq.TITLE,\n    tq.VIEW_COUNT,\n    ROW_NUMBER() OVER (PARTITION BY tq.TAG ORDER BY tq.VIEW_COUNT DESC) AS rn\n  FROM tagged_questions tq\n  INNER JOIN qualified_tags qt ON tq.TAG = qt.TAG\n)\nSELECT TAG, TITLE, VIEW_COUNT\nFROM ranked\nWHERE rn <= 50\nORDER BY TAG, VIEW_COUNT DESC") t ~= (sql%([TAGS_schema, POSTS_QUESTIONS_schema]) "WITH filtered AS (\n  SELECT \n    \"id\", \"tags\", \"view_count\", \"title\"\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\"\n  WHERE (LOWER(\"title\") LIKE '%how%' OR LOWER(\"body\") LIKE '%how%')\n    AND NOT (LOWER(\"title\") LIKE '%fail%' OR LOWER(\"body\") LIKE '%fail%')\n    AND NOT (LOWER(\"title\") LIKE '%problem%' OR LOWER(\"body\") LIKE '%problem%')\n    AND NOT (LOWER(\"title\") LIKE '%error%' OR LOWER(\"body\") LIKE '%error%')\n    AND NOT (LOWER(\"title\") LIKE '%wrong%' OR LOWER(\"body\") LIKE '%wrong%')\n    AND NOT (LOWER(\"title\") LIKE '%fix%' OR LOWER(\"body\") LIKE '%fix%')\n    AND NOT (LOWER(\"title\") LIKE '%bug%' OR LOWER(\"body\") LIKE '%bug%')\n    AND NOT (LOWER(\"title\") LIKE '%issue%' OR LOWER(\"body\") LIKE '%issue%')\n    AND NOT (LOWER(\"title\") LIKE '%solve%' OR LOWER(\"body\") LIKE '%solve%')\n    AND NOT (LOWER(\"title\") LIKE '%trouble%' OR LOWER(\"body\") LIKE '%trouble%')\n),\ntagged AS (\n  SELECT f.\"id\", f.\"title\", f.\"view_count\", tag.value::STRING AS \"TAG\"\n  FROM filtered f,\n  LATERAL FLATTEN(input => SPLIT(f.\"tags\", '|')) tag\n  WHERE tag.value::STRING IN (\n    'android-layout', 'android-activity', 'android-intent', 'android-edittext',\n    'android-fragments', 'android-recyclerview', 'listview', 'android-actionbar',\n    'google-maps', 'android-asynctask'\n  )\n),\nranked AS (\n  SELECT *,\n    ROW_NUMBER() OVER (PARTITION BY \"TAG\" ORDER BY \"view_count\" DESC) AS rn\n  FROM tagged\n)\nSELECT \"TAG\" AS \"TAG\", \"title\" AS \"TITLE\", \"view_count\" AS \"VIEW_COUNT\"\nFROM ranked\nWHERE rn <= 50\nORDER BY \"TAG\", \"view_count\" DESC;") t := by
