theorem eq (t0 : TableRel GRID_schema) (t1 : TableRel PUBLICATIONS_schema) :
    (sql%([GRID_schema, PUBLICATIONS_schema]) "SELECT COALESCE(CAST(JSON_EXTRACT_PATH(p.\"journal\", 'title') AS TEXT), CAST(JSON_EXTRACT_PATH(p.\"proceedings_title\", 'preferred') AS TEXT), CAST(JSON_EXTRACT_PATH(p.\"book_title\", 'preferred') AS TEXT), CAST(JSON_EXTRACT_PATH(p.\"book_series_title\", 'preferred') AS TEXT)) AS VENUE FROM \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"PUBLICATIONS\" AS p, LATERAL UNNEST(input => p.\"research_orgs\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) INNER JOIN \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"GRID\" AS g ON CAST(f.value AS TEXT) = g.\"id\" WHERE CAST(JSON_EXTRACT_PATH(g.\"address\", 'city') AS TEXT) = 'Qianjiang' AND EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(p.\"date_inserted\" AS DOUBLE PRECISION) / 1000000)) >= 2021") t0 t1
