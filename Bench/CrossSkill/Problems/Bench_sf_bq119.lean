HYPOTHESIS hyp0_1_0 : HURRICANES "\"season\" = '2020'"
theorem eq_0_1 (t : TableRel HURRICANES_schema) (h0 : hyp0_1_0 t) :
    (sql%([HURRICANES_schema]) "WITH hurricane_sids AS (\n    -- Identify storms that reached hurricane status (usa_status = 'HU') in 2020 North Atlantic\n    SELECT DISTINCT \"sid\"\n    FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n    WHERE \"season\" = '2020'\n      AND \"basin\" = 'NA'\n      AND \"usa_status\" = 'HU'\n),\ntrack_with_segments AS (\n    -- Get all track points for those hurricanes with segment distances\n    SELECT \n        h.\"sid\",\n        h.\"iso_time\",\n        h.\"latitude\",\n        h.\"longitude\",\n        h.\"usa_wind\",\n        LAG(h.\"latitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lat,\n        LAG(h.\"longitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lon\n    FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" h\n    INNER JOIN hurricane_sids hs ON h.\"sid\" = hs.\"sid\"\n),\ntrack_with_distance AS (\n    SELECT\n        \"sid\",\n        \"iso_time\",\n        \"latitude\",\n        \"longitude\",\n        \"usa_wind\",\n        CASE \n            WHEN prev_lat IS NOT NULL THEN \n                ST_DISTANCE(\n                    ST_MAKEPOINT(\"longitude\", \"latitude\"),\n                    ST_MAKEPOINT(prev_lon, prev_lat)\n                ) / 1000.0\n            ELSE NULL\n        END AS segment_km\n    FROM track_with_segments\n),\ntotal_distances AS (\n    -- Total travel distance per storm\n    SELECT \"sid\", SUM(COALESCE(segment_km, 0)) AS total_distance_km\n    FROM track_with_distance\n    GROUP BY \"sid\"\n),\nranked AS (\n    -- Rank storms by total distance descending\n    SELECT \"sid\", total_distance_km,\n           ROW_NUMBER() OVER (ORDER BY total_distance_km DESC) AS rn\n    FROM total_distances\n),\nthird_longest AS (\n    -- Get the third longest\n    SELECT \"sid\" FROM ranked WHERE rn = 3\n)\n-- Output the track with cumulative distance and wind for the third longest hurricane\nSELECT\n    ST_ASTEXT(ST_MAKEPOINT(td.\"longitude\", td.\"latitude\")) AS \"GEOM\",\n    CASE \n        WHEN td.segment_km IS NULL THEN NULL\n        ELSE SUM(COALESCE(td.segment_km, 0)) OVER (\n            PARTITION BY td.\"sid\" \n            ORDER BY td.\"iso_time\" \n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        )\n    END AS \"CUMULATIVE_DISTANCE\",\n    td.\"usa_wind\"\nFROM track_with_distance td\nINNER JOIN third_longest tl ON td.\"sid\" = tl.\"sid\"\nORDER BY td.\"iso_time\";") t ~= (sql%([HURRICANES_schema]) "WITH storm_distances AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat,\n    LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"basin\" = 'NA' AND \"season\" = '2020'\n),\nstorm_segments AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    CASE WHEN prev_lat IS NOT NULL THEN\n      ST_DISTANCE(ST_MAKEPOINT(\"longitude\", \"latitude\"), ST_MAKEPOINT(prev_lon, prev_lat)) / 1000\n    ELSE 0 END AS segment_km\n  FROM storm_distances\n),\nstorm_totals AS (\n  SELECT \"sid\", \"name\", SUM(segment_km) AS total_distance_km\n  FROM storm_segments\n  GROUP BY \"sid\", \"name\"\n),\nranked AS (\n  SELECT \"sid\", \"name\", total_distance_km,\n    ROW_NUMBER() OVER (ORDER BY total_distance_km DESC) AS rnk\n  FROM storm_totals\n),\nthird_storm AS (\n  SELECT \"sid\" FROM ranked WHERE rnk = 3\n),\nthird_storm_data AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    LAG(\"latitude\") OVER (ORDER BY \"iso_time\") AS prev_lat,\n    LAG(\"longitude\") OVER (ORDER BY \"iso_time\") AS prev_lon\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"sid\" = (SELECT \"sid\" FROM third_storm)\n),\nthird_storm_segments AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    CASE WHEN prev_lat IS NOT NULL THEN\n      ST_DISTANCE(ST_MAKEPOINT(\"longitude\", \"latitude\"), ST_MAKEPOINT(prev_lon, prev_lat)) / 1000\n    ELSE NULL END AS segment_km\n  FROM third_storm_data\n)\nSELECT \n  ST_MAKEPOINT(\"longitude\", \"latitude\") AS GEOM,\n  SUM(segment_km) OVER (ORDER BY \"iso_time\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CUMULATIVE_DISTANCE,\n  \"usa_wind\"\nFROM third_storm_segments\nORDER BY \"iso_time\";") t := by
  first | sql_equiv | sorry

