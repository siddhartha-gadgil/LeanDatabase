    (sql%([HURRICANES_schema]) "WITH storm_distances AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat,\n    LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"basin\" = 'NA' AND \"season\" = '2020'\n),\nstorm_segments AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    CASE WHEN prev_lat IS NOT NULL THEN\n      ST_DISTANCE(ST_MAKEPOINT(\"longitude\", \"latitude\"), ST_MAKEPOINT(prev_lon, prev_lat)) / 1000\n    ELSE 0 END AS segment_km\n  FROM storm_distances\n),\nstorm_totals AS (\n  SELECT \"sid\", \"name\", SUM(segment_km) AS total_distance_km\n  FROM storm_segments\n  GROUP BY \"sid\", \"name\"\n),\nranked AS (\n  SELECT \"sid\", \"name\", total_distance_km,\n    ROW_NUMBER() OVER (ORDER BY total_distance_km DESC) AS rnk\n  FROM storm_totals\n),\nthird_storm AS (\n  SELECT \"sid\" FROM ranked WHERE rnk = 3\n),\nthird_storm_data AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    LAG(\"latitude\") OVER (ORDER BY \"iso_time\") AS prev_lat,\n    LAG(\"longitude\") OVER (ORDER BY \"iso_time\") AS prev_lon\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"sid\" = (SELECT \"sid\" FROM third_storm)\n),\nthird_storm_segments AS (\n  SELECT \n    \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\",\n    CASE WHEN prev_lat IS NOT NULL THEN\n      ST_DISTANCE(ST_MAKEPOINT(\"longitude\", \"latitude\"), ST_MAKEPOINT(prev_lon, prev_lat)) / 1000\n    ELSE NULL END AS segment_km\n  FROM third_storm_data\n)\nSELECT \n  ST_MAKEPOINT(\"longitude\", \"latitude\") AS GEOM,\n  SUM(segment_km) OVER (ORDER BY \"iso_time\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CUMULATIVE_DISTANCE,\n  \"usa_wind\"\nFROM third_storm_segments\nORDER BY \"iso_time\";") t ~= (sql%([HURRICANES_schema]) "WITH ordered AS (\n  SELECT\n    \"sid\",\n    \"latitude\",\n    \"longitude\",\n    \"usa_wind\",\n    \"iso_time\",\n    ROW_NUMBER() OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS rn\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"basin\" = 'NA' AND \"season\" = '2020'\n),\nsegment_distances AS (\n  SELECT\n    a.\"sid\",\n    a.\"latitude\",\n    a.\"longitude\",\n    a.\"usa_wind\",\n    a.\"iso_time\",\n    a.rn,\n    CASE\n      WHEN a.rn = 1 THEN NULL\n      ELSE ST_DISTANCE(\n        ST_MAKEPOINT(b.\"longitude\", b.\"latitude\"),\n        ST_MAKEPOINT(a.\"longitude\", a.\"latitude\")\n      ) / 1000.0\n    END AS segment_km\n  FROM ordered a\n  LEFT JOIN ordered b ON a.\"sid\" = b.\"sid\" AND a.rn = b.rn + 1\n),\ntotal_per_storm AS (\n  SELECT \"sid\", SUM(segment_km) AS total_distance\n  FROM segment_distances\n  GROUP BY \"sid\"\n),\nranked AS (\n  SELECT \"sid\", total_distance,\n    ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rnk\n  FROM total_per_storm\n),\nthird_longest_sid AS (\n  SELECT \"sid\" FROM ranked WHERE rnk = 3\n),\ncumulative AS (\n  SELECT\n    sd.\"latitude\",\n    sd.\"longitude\",\n    sd.\"usa_wind\",\n    sd.rn,\n    SUM(sd.segment_km) OVER (ORDER BY sd.rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"CUMULATIVE_DISTANCE\"\n  FROM segment_distances sd\n  WHERE sd.\"sid\" = (SELECT \"sid\" FROM third_longest_sid)\n)\nSELECT\n  'POINT(' || \"longitude\" || ' ' || \"latitude\" || ')' AS \"GEOM\",\n  CASE WHEN rn = 1 THEN NULL ELSE \"CUMULATIVE_DISTANCE\" END AS \"CUMULATIVE_DISTANCE\",\n  \"usa_wind\"\nFROM cumulative\nORDER BY rn;") t := by
