    (sql%([HURRICANES_schema]) "-- Find the hurricane with the 3rd longest total travel distance in North Atlantic during 2020\n-- Show travel coordinates (GEOM), cumulative distance (km), and max sustained wind speed (usa_wind)\n\nWITH ordered_points AS (\n    SELECT \n        \"sid\",\n        \"latitude\",\n        \"longitude\",\n        \"usa_wind\",\n        \"iso_time\",\n        LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat,\n        LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon\n    FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n    WHERE \"basin\" = 'NA' AND \"season\" = 2020\n),\nsegment_distances AS (\n    SELECT \n        \"sid\",\n        \"latitude\",\n        \"longitude\",\n        \"usa_wind\",\n        \"iso_time\",\n        CASE \n            WHEN prev_lat IS NOT NULL \n            THEN ST_DISTANCE(ST_MAKEPOINT(prev_lon, prev_lat), ST_MAKEPOINT(\"longitude\", \"latitude\")) / 1000.0\n            ELSE NULL \n        END AS segment_dist\n    FROM ordered_points\n),\ntotal_distances AS (\n    SELECT \n        \"sid\",\n        SUM(segment_dist) AS total_distance\n    FROM segment_distances\n    GROUP BY \"sid\"\n),\nranked AS (\n    SELECT \n        \"sid\",\n        total_distance,\n        ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rank\n    FROM total_distances\n),\nthird_longest AS (\n    SELECT \"sid\"\n    FROM ranked\n    WHERE rank = 3\n),\nresult AS (\n    SELECT \n        sd.\"latitude\",\n        sd.\"longitude\",\n        sd.\"usa_wind\",\n        sd.\"iso_time\",\n        sd.segment_dist\n    FROM segment_distances sd\n    JOIN third_longest tl ON sd.\"sid\" = tl.\"sid\"\n)\nSELECT \n    'POINT(' || \"longitude\" || ' ' || \"latitude\" || ')' AS \"GEOM\",\n    SUM(segment_dist) OVER (ORDER BY \"iso_time\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"CUMULATIVE_DISTANCE\",\n    \"usa_wind\"\nFROM result\nORDER BY \"iso_time\";") t ~= (sql%([HURRICANES_schema]) "WITH ordered AS (\n  SELECT\n    \"sid\",\n    \"latitude\",\n    \"longitude\",\n    \"usa_wind\",\n    \"iso_time\",\n    ROW_NUMBER() OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS rn\n  FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n  WHERE \"basin\" = 'NA' AND \"season\" = '2020'\n),\nsegment_distances AS (\n  SELECT\n    a.\"sid\",\n    a.\"latitude\",\n    a.\"longitude\",\n    a.\"usa_wind\",\n    a.\"iso_time\",\n    a.rn,\n    CASE\n      WHEN a.rn = 1 THEN NULL\n      ELSE ST_DISTANCE(\n        ST_MAKEPOINT(b.\"longitude\", b.\"latitude\"),\n        ST_MAKEPOINT(a.\"longitude\", a.\"latitude\")\n      ) / 1000.0\n    END AS segment_km\n  FROM ordered a\n  LEFT JOIN ordered b ON a.\"sid\" = b.\"sid\" AND a.rn = b.rn + 1\n),\ntotal_per_storm AS (\n  SELECT \"sid\", SUM(segment_km) AS total_distance\n  FROM segment_distances\n  GROUP BY \"sid\"\n),\nranked AS (\n  SELECT \"sid\", total_distance,\n    ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rnk\n  FROM total_per_storm\n),\nthird_longest_sid AS (\n  SELECT \"sid\" FROM ranked WHERE rnk = 3\n),\ncumulative AS (\n  SELECT\n    sd.\"latitude\",\n    sd.\"longitude\",\n    sd.\"usa_wind\",\n    sd.rn,\n    SUM(sd.segment_km) OVER (ORDER BY sd.rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"CUMULATIVE_DISTANCE\"\n  FROM segment_distances sd\n  WHERE sd.\"sid\" = (SELECT \"sid\" FROM third_longest_sid)\n)\nSELECT\n  'POINT(' || \"longitude\" || ' ' || \"latitude\" || ')' AS \"GEOM\",\n  CASE WHEN rn = 1 THEN NULL ELSE \"CUMULATIVE_DISTANCE\" END AS \"CUMULATIVE_DISTANCE\",\n  \"usa_wind\"\nFROM cumulative\nORDER BY rn;") t := by
