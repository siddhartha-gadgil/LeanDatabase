\")) AS \"GEOM\",\n    CASE \n        WHEN td.segment_km IS NULL THEN NULL\n        ELSE SUM(COALESCE(td.segment_km, 0)) OVER (\n            PARTITION BY td.\"sid\" \n            ORDER BY td.\"iso_time\" \n            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n        )\n    END AS \"CUMULATIVE_DISTANCE\",\n    td.\"usa_wind\"\nFROM track_with_distance td\nINNER JOIN third_longest tl ON td.\"sid\" = tl.\"sid\"\nORDER BY td.\"iso_time\";") t ~= (sql%([HURRICANES_schema]) "-- Find the hurricane with the 3rd longest total travel distance in North Atlantic during 2020\n-- Show travel coordinates (GEOM), cumulative distance (km), and max sustained wind speed (usa_wind)\n\nWITH ordered_points AS (\n    SELECT \n        \"sid\",\n        \"latitude\",\n        \"longitude\",\n        \"usa_wind\",\n        \"iso_time\",\n        LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat,\n        LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon\n    FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\"\n    WHERE \"basin\" = 'NA' AND \"season\" = 2020\n),\nsegment_distances AS (\n    SELECT \n        \"sid\",\n        \"latitude\",\n        \"longitude\",\n        \"usa_wind\",\n        \"iso_time\",\n        CASE \n            WHEN prev_lat IS NOT NULL \n            THEN ST_DISTANCE(ST_MAKEPOINT(prev_lon, prev_lat), ST_MAKEPOINT(\"longitude\", \"latitude\")) / 1000.0\n            ELSE NULL \n        END AS segment_dist\n    FROM ordered_points\n),\ntotal_distances AS (\n    SELECT \n        \"sid\",\n        SUM(segment_dist) AS total_distance\n    FROM segment_distances\n    GROUP BY \"sid\"\n),\nranked AS (\n    SELECT \n        \"sid\",\n        total_distance,\n        ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rank\n    FROM total_distances\n),\nthird_longest AS (\n    SELECT \"sid\"\n    FROM ranked\n    WHERE rank = 3\n),\nresult AS (\n    SELECT \n        sd.\"latitude\",\n        sd.\"longitude\",\n        sd.\"usa_wind\",\n        sd.\"iso_time\",\n        sd.segment_dist\n    FROM segment_distances sd\n    JOIN third_longest tl ON sd.\"sid\" = tl.\"sid\"\n)\nSELECT \n    'POINT(' || \"longitude\" || ' ' || \"latitude\" || ')' AS \"GEOM\",\n    SUM(segment_dist) OVER (ORDER BY \"iso_time\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"CUMULATIVE_DISTANCE\",\n    \"usa_wind\"\nFROM result\nORDER BY \"iso_time\";") t := by
