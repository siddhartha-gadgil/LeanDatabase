import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local098 — crossskill equivalence(s)

Question: From the first year each actor appeared in a film to the last, how many actors in the database never had a gap longer than three consecutive years without at least one new movie appearance, meaning there is no four-year span anywhere in their active career without at least a single film credit?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local098

CREATE TABLE MOVIE («index» INT, «MID» STRING, «title» STRING, «year» STRING, «rating» FLOAT, «num_votes» INT)
CREATE TABLE M_CAST («index» INT, «MID» STRING, «PID» STRING, «ID» INT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([MOVIE_schema, M_CAST_schema]) "WITH actor_years AS (\n    SELECT c.\"PID\", \n           TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER) AS yr\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"MOVIE\" m ON c.\"MID\" = m.\"MID\"\n    WHERE TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER) IS NOT NULL\n    GROUP BY c.\"PID\", TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER)\n),\ngaps AS (\n    SELECT \"PID\", yr,\n           yr - LAG(yr) OVER (PARTITION BY \"PID\" ORDER BY yr) AS diff\n    FROM actor_years\n),\nmax_gaps AS (\n    SELECT \"PID\", MAX(diff) AS max_diff\n    FROM gaps\n    GROUP BY \"PID\"\n)\nSELECT COUNT(*) AS ACTOR_COUNT_NO_4YR_GAP\nFROM max_gaps\nWHERE max_diff <= 4 OR max_diff IS NULL;" = sql%([MOVIE_schema, M_CAST_schema]) "WITH actor_years AS (\n  SELECT \n    TRIM(mc.\"PID\") AS pid,\n    CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INT) AS yr\n  FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc\n  JOIN \"DB_IMDB\".\"DB_IMDB\".\"MOVIE\" m ON mc.\"MID\" = m.\"MID\"\n  WHERE REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') IS NOT NULL\n  GROUP BY TRIM(mc.\"PID\"), CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INT)\n),\nactor_gaps AS (\n  SELECT \n    pid,\n    yr,\n    yr - LAG(yr) OVER (PARTITION BY pid ORDER BY yr) AS gap\n  FROM actor_years\n),\nactor_max_gap AS (\n  SELECT \n    pid,\n    MAX(gap) AS max_gap\n  FROM actor_gaps\n  GROUP BY pid\n)\nSELECT COUNT(*) AS \"ACTOR_COUNT_NO_4YR_GAP\"\nFROM actor_max_gap\nWHERE max_gap <= 4 OR max_gap IS NULL;" := by
  first | sql_equiv | sorry

-- eq_0_2: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_2 :
    sql%([MOVIE_schema, M_CAST_schema]) "WITH actor_years AS (\n    SELECT c.\"PID\", \n           TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER) AS yr\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" c\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"MOVIE\" m ON c.\"MID\" = m.\"MID\"\n    WHERE TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER) IS NOT NULL\n    GROUP BY c.\"PID\", TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER)\n),\ngaps AS (\n    SELECT \"PID\", yr,\n           yr - LAG(yr) OVER (PARTITION BY \"PID\" ORDER BY yr) AS diff\n    FROM actor_years\n),\nmax_gaps AS (\n    SELECT \"PID\", MAX(diff) AS max_diff\n    FROM gaps\n    GROUP BY \"PID\"\n)\nSELECT COUNT(*) AS ACTOR_COUNT_NO_4YR_GAP\nFROM max_gaps\nWHERE max_diff <= 4 OR max_diff IS NULL;" = sql%([MOVIE_schema, M_CAST_schema]) "WITH actor_years AS (\n    -- Get distinct years for each actor, extracting numeric year from text\n    SELECT DISTINCT\n        mc.\"PID\",\n        TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER) AS yr\n    FROM \"DB_IMDB\".\"DB_IMDB\".\"M_CAST\" mc\n    JOIN \"DB_IMDB\".\"DB_IMDB\".\"MOVIE\" m ON mc.\"MID\" = m.\"MID\"\n    WHERE TRY_CAST(REGEXP_SUBSTR(m.\"year\", '\\\\d{4}') AS INTEGER) IS NOT NULL\n),\nactor_year_gaps AS (\n    -- For each actor, compute gap between consecutive active years\n    SELECT\n        \"PID\",\n        yr,\n        yr - LAG(yr) OVER (PARTITION BY \"PID\" ORDER BY yr) AS gap\n    FROM actor_years\n),\nactors_with_large_gap AS (\n    -- Find actors who have at least one gap > 4 years (a 4-year span without a film)\n    SELECT DISTINCT \"PID\"\n    FROM actor_year_gaps\n    WHERE gap > 4\n),\nall_actors AS (\n    SELECT DISTINCT \"PID\"\n    FROM actor_years\n)\nSELECT COUNT(*) AS \"ACTOR_COUNT_NO_4YR_GAP\"\nFROM all_actors a\nWHERE a.\"PID\" NOT IN (SELECT \"PID\" FROM actors_with_large_gap);" := by
  first | sql_equiv | sorry

