theorem eq (t0 : TableRel LEGISLATORS_schema) (t1 : TableRel LEGISLATORS_TERMS_schema) :
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH female_terms AS (SELECT lt.\"id_bioguide\", lt.\"term_number\", lt.\"state\", CAST(TO_TIMESTAMP(lt.\"term_start\", 'YYYY-MM-DD') AS DATE) AS start_dt, CAST(TO_TIMESTAMP(lt.\"term_end\", 'YYYY-MM-DD') AS DATE) AS end_dt FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS lt JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON lt.\"id_bioguide\" = l.\"id_bioguide\" WHERE l.\"gender\" = 'F'), first_state AS (SELECT \"id_bioguide\", \"state\" FROM (SELECT \"id_bioguide\", \"state\", ROW_NUMBER() OVER (PARTITION BY \"id_bioguide\" ORDER BY \"term_number\") AS _w, \"term_number\" FROM female_terms) AS _t WHERE _w = 1), dec31_legislators AS (SELECT DISTINCT \"id_bioguide\" FROM female_terms WHERE DATE_FROM_PARTS(EXTRACT(YEAR FROM start_dt), 12, 31) BETWEEN start_dt AND end_dt OR DATE_FROM_PARTS(EXTRACT(YEAR FROM end_dt), 12, 31) BETWEEN start_dt AND end_dt) SELECT fs.\"state\", COUNT(*) AS \"NUMBER_OF_LEGISLATORS\" FROM first_state AS fs JOIN dec31_legislators AS d ON fs.\"id_bioguide\" = d.\"id_bioguide\" GROUP BY fs.\"state\" ORDER BY \"NUMBER_OF_LEGISLATORS\" DESC LIMIT 1") t0 t1
  ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_state AS (/* Get the first state each female legislator represented */ SELECT \"id_bioguide\", \"state\" FROM (/* Get the first state each female legislator represented */ SELECT l.\"id_bioguide\", t.\"state\", ROW_NUMBER() OVER (PARTITION BY l.\"id_bioguide\" ORDER BY t.\"term_number\") AS _w, t.\"term_number\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON l.\"id_bioguide\" = t.\"id_bioguide\" WHERE l.\"gender\" = 'F') AS _t WHERE _w = 1), dec31_legislators AS (/* Find female legislators who have at least one term that includes a December 31st */ /* A term includes Dec 31 if: */ /*   1) It spans across 2+ calendar years (guaranteed to include Dec 31 of start year), OR */ /*   2) Same year but term_end >= Dec 31 of that year (i.e., ends on Dec 31) */ SELECT DISTINCT t.\"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON l.\"id_bioguide\" = t.\"id_bioguide\" WHERE l.\"gender\" = 'F' AND (SUBSTRING(t.\"term_end\" FROM 1 FOR 4) > SUBSTRING(t.\"term_start\" FROM 1 FOR 4) OR SUBSTRING(t.\"term_end\" FROM 6 FOR 5) >= '12-31')) SELECT fs.\"state\", COUNT(*) AS \"NUMBER_OF_LEGISLATORS\" FROM first_state AS fs JOIN dec31_legislators AS dl ON fs.\"id_bioguide\" = dl.\"id_bioguide\" GROUP BY fs.\"state\" ORDER BY \"NUMBER_OF_LEGISLATORS\" DESC LIMIT 1") t0 t1
