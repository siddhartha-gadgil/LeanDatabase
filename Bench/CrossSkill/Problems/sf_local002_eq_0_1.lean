CREATE TABLE ORDER_ITEMS («order_id» STRING, «order_item_id» INT, «product_id» STRING, «seller_id» STRING, «shipping_limit_date» STRING, «price» FLOAT, «freight_value» FLOAT)
CREATE TABLE PRODUCTS («product_id» STRING, «product_category_name» STRING, «product_name_lenght» FLOAT, «product_description_lenght» FLOAT, «product_photos_qty» FLOAT, «product_weight_g» FLOAT, «product_length_cm» FLOAT, «product_height_cm» FLOAT, «product_width_cm» FLOAT)
CREATE TABLE ORDERS («order_id» STRING, «customer_id» STRING, «order_status» STRING, «order_purchase_timestamp» STRING, «order_approved_at» STRING, «order_delivered_carrier_date» STRING, «order_delivered_customer_date» STRING, «order_estimated_delivery_date» STRING)

theorem eq (t0 : TableRel ORDER_ITEMS_schema) (t1 : TableRel PRODUCTS_schema) (t2 : TableRel ORDERS_schema) :
    (sql%([ORDER_ITEMS_schema, PRODUCTS_schema, ORDERS_schema]) "/* sf_local002: 5-day symmetric moving average of predicted toy sales (price) */ /* Using simple linear regression on daily toy sales from 2017-01-01 to 2018-08-29 */ /* Predictions for Dec 5-8, 2018, then sum the 4 moving averages */ WITH daily_sales AS (SELECT CAST(o.\"order_purchase_timestamp\" AS DATE) AS sale_date, SUM(CAST(oi.\"price\" AS DOUBLE PRECISION)) AS sum_price FROM \"E_COMMERCE\".\"E_COMMERCE\".\"ORDERS\" AS o JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"ORDER_ITEMS\" AS oi ON o.\"order_id\" = oi.\"order_id\" JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"product_id\" WHERE p.\"product_category_name\" = 'brinquedos' AND CAST(o.\"order_purchase_timestamp\" AS DATE) BETWEEN '2017-01-01' AND '2018-08-29' GROUP BY CAST(o.\"order_purchase_timestamp\" AS DATE)), all_dates AS (SELECT CAST('2017-01-01' + INTERVAL '1 DAY' * SEQ4() AS DATE) AS sale_date FROM TABLE(GENERATOR(606))), full_data AS (SELECT a.sale_date, (CAST(a.sale_date AS DATE) - CAST('2017-01-01' AS DATE)) + 1 AS day_num, COALESCE(d.sum_price, 0) AS y FROM all_dates AS a LEFT JOIN daily_sales AS d ON a.sale_date = d.sale_date), regression AS (SELECT REGR_SLOPE(y, day_num) AS slope, REGR_INTERCEPT(y, day_num) AS intercept FROM full_data), pred_dates AS (SELECT CAST('2017-01-01' + INTERVAL '1 DAY' * (SEQ4() + (CAST('2018-12-03' AS DATE) - CAST('2017-01-01' AS DATE))) AS DATE) AS pred_date, (CAST('2017-01-01' + INTERVAL '1 DAY' * (SEQ4() + (CAST('2018-12-03' AS DATE) - CAST('2017-01-01' AS DATE))) AS DATE) - CAST('2017-01-01' AS DATE)) + 1 AS day_num FROM TABLE(GENERATOR(8))), predictions AS (SELECT pd.pred_date, pd.day_num, r.slope * pd.day_num + r.intercept AS pred_price FROM pred_dates AS pd, regression AS r), moving_avg AS (SELECT p.pred_date, AVG(p2.pred_price) AS ma_price FROM predictions AS p JOIN predictions AS p2 ON p2.day_num BETWEEN p.day_num - 2 AND p.day_num + 2 WHERE p.pred_date BETWEEN '2018-12-05' AND '2018-12-08' GROUP BY p.pred_date) SELECT SUM(ma_price) AS TOTAL FROM moving_avg") t0 t1 t2
  ~= (sql%([ORDER_ITEMS_schema, PRODUCTS_schema, ORDERS_schema]) "/* sf_local002: Calculate 5-day symmetric moving average of predicted toy sales (revenue) */ /* for Dec 5-8 2018, using linear regression on daily data from Jan 1 2017 to Aug 29 2018. */ /* Since 5-day symmetric MA of a linear function = the function value itself, */ /* the sum of four MAs = sum of four predicted values. */ WITH date_spine AS (/* Generate all dates from Jan 1 2017 to Aug 29 2018 */ SELECT '2017-01-01' + INTERVAL '1 DAY' * SEQ4() AS sale_date FROM TABLE(GENERATOR(606))), daily_sales AS (/* Aggregate daily toy revenue */ SELECT CAST(TO_TIMESTAMP(o.\"order_purchase_timestamp\") AS DATE) AS sale_date, SUM(oi.\"price\") AS daily_revenue FROM \"E_COMMERCE\".\"E_COMMERCE\".\"ORDERS\" AS o JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"ORDER_ITEMS\" AS oi ON o.\"order_id\" = oi.\"order_id\" JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"product_id\" WHERE p.\"product_category_name\" = 'brinquedos' AND CAST(TO_TIMESTAMP(o.\"order_purchase_timestamp\") AS DATE) >= '2017-01-01' AND CAST(TO_TIMESTAMP(o.\"order_purchase_timestamp\") AS DATE) <= '2018-08-29' GROUP BY sale_date), all_days AS (/* Fill in zero-revenue days */ SELECT ds.sale_date, COALESCE(d.daily_revenue, 0) AS daily_revenue, (CAST(ds.sale_date AS DATE) - CAST('2017-01-01' AS DATE)) AS day_num FROM date_spine AS ds LEFT JOIN daily_sales AS d ON ds.sale_date = d.sale_date WHERE ds.sale_date <= '2018-08-29'), regression AS (/* Compute linear regression parameters */ SELECT REGR_SLOPE(daily_revenue, day_num) AS slope, REGR_INTERCEPT(daily_revenue, day_num) AS intercept FROM all_days), predictions AS (/* Predict revenue for Dec 3-10, 2018 (needed for 5-day symmetric MA of Dec 5-8) */ SELECT '2018-12-03' + INTERVAL '1 DAY' * SEQ4() AS pred_date, (CAST('2018-12-03' + INTERVAL '1 DAY' * SEQ4() AS DATE) - CAST('2017-01-01' AS DATE)) AS day_num FROM TABLE(GENERATOR(8))), predicted_values AS (SELECT p.pred_date, r.intercept + r.slope * p.day_num AS predicted_revenue FROM predictions AS p CROSS JOIN regression AS r), moving_avg AS (/* 5-day symmetric moving average for Dec 5-8 */ SELECT pv.pred_date, AVG(pv2.predicted_revenue) AS ma_5day FROM predicted_values AS pv JOIN predicted_values AS pv2 ON pv2.pred_date BETWEEN pv.pred_date + INTERVAL '-2 DAY' AND pv.pred_date + INTERVAL '2 DAY' WHERE pv.pred_date BETWEEN '2018-12-05' AND '2018-12-08' GROUP BY pv.pred_date) SELECT SUM(ma_5day) AS \"TOTAL\" FROM moving_avg") t0 t1 t2
