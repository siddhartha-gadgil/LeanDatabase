theorem eq_1_2 (t : TableRel PUBLICATIONS_schema) (h0 : hyp1_2_0 t) (h1 : hyp1_2_1 t) (h2 : hyp1_2_2 t) :
    (sql%([PUBLICATIONS_schema]) "WITH us_b2_patents AS (\n  SELECT \"publication_number\"\n  FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\"\n  WHERE \"country_code\" = 'US'\n    AND \"kind_code\" = 'B2'\n    AND \"grant_date\" >= 20150101\n    AND \"grant_date\" <= 20181231\n),\nfocal_citations AS (\n  SELECT p.\"publication_number\" as focal_pub,\n         c.value:\"publication_number\"::STRING as cited_pub\n  FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p\n  JOIN us_b2_patents ubp ON p.\"publication_number\" = ubp.\"publication_number\",\n    LATERAL FLATTEN(input => p.\"citation\") c\n  WHERE c.value:\"publication_number\"::STRING IS NOT NULL\n),\ncited_ipc_counts AS (\n  SELECT fc.focal_pub, fc.cited_pub,\n         LEFT(f2.value:\"code\"::STRING, 4) as ipc_4,\n         COUNT(*) as ipc_cnt\n  FROM focal_citations fc\n  JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" cited ON cited.\"publication_number\" = fc.cited_pub,\n    LATERAL FLATTEN(input => cited.\"ipc\") f2\n  WHERE f2.value:\"code\"::STRING IS NOT NULL\n  GROUP BY fc.focal_pub, fc.cited_pub, LEFT(f2.value:\"code\"::STRING, 4)\n),\nranked AS (\n  SELECT focal_pub, cited_pub, ipc_4,\n         ROW_NUMBER() OVER (PARTITION BY focal_pub, cited_pub ORDER BY ipc_cnt DESC, ipc_4 ASC) as rn\n  FROM cited_ipc_counts\n),\ncited_primary_ipc AS (\n  SELECT focal_pub, cited_pub, ipc_4 FROM ranked WHERE rn = 1\n),\nipc_class_counts AS (\n  SELECT focal_pub, ipc_4, COUNT(*) as n_k\n  FROM cited_primary_ipc\n  GROUP BY focal_pub, ipc_4\n),\noriginality AS (\n  SELECT focal_pub as \"PUBLICATION_NUMBER\",\n         1.0 - SUM(POWER(n_k, 2)) / POWER(SUM(n_k), 2) as \"ORIGINALITY\"\n  FROM ipc_class_counts\n  GROUP BY focal_pub\n)\nSELECT \"PUBLICATION_NUMBER\", \"ORIGINALITY\"\nFROM originality\nORDER BY \"ORIGINALITY\" DESC, \"PUBLICATION_NUMBER\" ASC\nLIMIT 1;") t ~= (sql%([PUBLICATIONS_schema]) "-- Patent originality score: find the US B2 patent (2015-2018) with the highest originality\n-- Originality = 1 - SUM((n_k/N)^2) where n_k = citations in IPC class k, N = total citations\n\nWITH focal_citations AS (\n    SELECT \n        p.\"publication_number\" AS focal_patent,\n        c.value:publication_number::string AS cited_pub\n    FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p,\n    LATERAL FLATTEN(input => p.\"citation\") c\n    WHERE p.\"country_code\" = 'US' \n      AND p.\"kind_code\" = 'B2'\n      AND p.\"grant_date\" BETWEEN 20150101 AND 20181231\n      AND c.value:publication_number::string IS NOT NULL\n      AND c.value:publication_number::string != ''\n),\ncited_ipc AS (\n    SELECT \n        fc.focal_patent,\n        fc.cited_pub,\n        LEFT(i.value:code::string, 4) AS ipc_4digit\n    FROM focal_citations fc\n    INNER JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p2 \n        ON p2.\"publication_number\" = fc.cited_pub,\n    LATERAL FLATTEN(input => p2.\"ipc\") i\n),\ncited_ipc_freq AS (\n    SELECT \n        focal_patent,\n        cited_pub,\n        ipc_4digit,\n        COUNT(*) AS freq\n    FROM cited_ipc\n    GROUP BY focal_patent, cited_pub, ipc_4digit\n),\ncited_ipc_ranked AS (\n    SELECT \n        focal_patent,\n        cited_pub,\n        ipc_4digit,\n        freq,\n        ROW_NUMBER() OVER (PARTITION BY focal_patent, cited_pub ORDER BY freq DESC, ipc_4digit ASC) AS rn\n    FROM cited_ipc_freq\n),\ncited_class AS (\n    SELECT \n        focal_patent,\n        cited_pub,\n        ipc_4digit AS assigned_class\n    FROM cited_ipc_ranked\n    WHERE rn = 1\n),\nclass_counts AS (\n    SELECT \n        focal_patent,\n        assigned_class,\n        COUNT(*) AS n_k\n    FROM cited_class\n    GROUP BY focal_patent, assigned_class\n),\noriginality AS (\n    SELECT \n        focal_patent,\n        1.0 - SUM(CAST(n_k AS FLOAT) * CAST(n_k AS FLOAT)) / (CAST(SUM(n_k) AS FLOAT) * CAST(SUM(n_k) AS FLOAT)) AS originality_score\n    FROM class_counts\n    GROUP BY focal_patent\n)\nSELECT \n    focal_patent AS PUBLICATION_NUMBER,\n    ROUND(originality_score, 1) AS ORIGINALITY\nFROM originality\nWHERE originality_score > 0\nORDER BY originality_score DESC, PUBLICATION_NUMBER ASC\nLIMIT 1;") t := by
