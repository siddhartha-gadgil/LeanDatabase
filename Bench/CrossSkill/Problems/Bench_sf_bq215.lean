theorem eq_0_2 (t : TableRel PUBLICATIONS_schema) (h0 : hyp0_2_0 t) (h1 : hyp0_2_1 t) (h2 : hyp0_2_2 t) (h3 : hyp0_2_3 t) :
    (sql%([PUBLICATIONS_schema]) "WITH backward_citations AS (\n  -- Get all backward citations for US B2 patents with grant date 2015-2018\n  SELECT \n    p1.\"publication_number\" AS citing_patent,\n    c.value:\"publication_number\"::STRING AS cited_patent\n  FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p1,\n  LATERAL FLATTEN(input => p1.\"citation\") c\n  WHERE p1.\"country_code\" = 'US' \n    AND p1.\"kind_code\" = 'B2'\n    AND p1.\"grant_date\" >= 20150101\n    AND p1.\"grant_date\" <= 20181231\n    AND c.value:\"publication_number\"::STRING IS NOT NULL\n    AND c.value:\"publication_number\"::STRING != ''\n),\ncited_ipc_counts AS (\n  -- For each cited patent, count frequency of each 4-digit IPC code\n  SELECT \n    bc.citing_patent,\n    bc.cited_patent,\n    SUBSTR(ipc.value:\"code\"::STRING, 1, 4) AS ipc_4digit,\n    COUNT(*) AS freq\n  FROM backward_citations bc\n  JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p2 \n    ON bc.cited_patent = p2.\"publication_number\",\n  LATERAL FLATTEN(input => p2.\"ipc\") ipc\n  GROUP BY bc.citing_patent, bc.cited_patent, SUBSTR(ipc.value:\"code\"::STRING, 1, 4)\n),\ncited_main_class AS (\n  -- Assign each cited patent its main (most frequent) 4-digit IPC class\n  SELECT \n    citing_patent,\n    cited_patent,\n    ipc_4digit,\n    ROW_NUMBER() OVER (\n      PARTITION BY citing_patent, cited_patent \n      ORDER BY freq DESC, ipc_4digit ASC\n    ) AS rn\n  FROM cited_ipc_counts\n),\ncited_with_class AS (\n  SELECT citing_patent, cited_patent, ipc_4digit AS main_class\n  FROM cited_main_class\n  WHERE rn = 1\n),\nclass_counts AS (\n  -- Count number of cited patents per class per citing patent\n  SELECT citing_patent, main_class, COUNT(*) AS ncited_k\n  FROM cited_with_class\n  GROUP BY citing_patent, main_class\n),\ntotal_counts AS (\n  -- Total cited patents per citing patent\n  SELECT citing_patent, SUM(ncited_k) AS ncited_i\n  FROM class_counts\n  GROUP BY citing_patent\n),\noriginality AS (\n  SELECT \n    cc.citing_patent,\n    1.0 - SUM(POWER(CAST(cc.ncited_k AS FLOAT) / CAST(tc.ncited_i AS FLOAT), 2)) AS originality_score\n  FROM class_counts cc\n  JOIN total_counts tc ON cc.citing_patent = tc.citing_patent\n  GROUP BY cc.citing_patent, tc.ncited_i\n)\nSELECT \n  citing_patent AS PUBLICATION_NUMBER,\n  originality_score AS ORIGINALITY\nFROM originality\nORDER BY originality_score DESC, citing_patent ASC\nLIMIT 1;") t ~= (sql%([PUBLICATIONS_schema]) "-- Patent originality score: find the US B2 patent (2015-2018) with the highest originality\n-- Originality = 1 - SUM((n_k/N)^2) where n_k = citations in IPC class k, N = total citations\n\nWITH focal_citations AS (\n    SELECT \n        p.\"publication_number\" AS focal_patent,\n        c.value:publication_number::string AS cited_pub\n    FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p,\n    LATERAL FLATTEN(input => p.\"citation\") c\n    WHERE p.\"country_code\" = 'US' \n      AND p.\"kind_code\" = 'B2'\n      AND p.\"grant_date\" BETWEEN 20150101 AND 20181231\n      AND c.value:publication_number::string IS NOT NULL\n      AND c.value:publication_number::string != ''\n),\ncited_ipc AS (\n    SELECT \n        fc.focal_patent,\n        fc.cited_pub,\n        LEFT(i.value:code::string, 4) AS ipc_4digit\n    FROM focal_citations fc\n    INNER JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p2 \n        ON p2.\"publication_number\" = fc.cited_pub,\n    LATERAL FLATTEN(input => p2.\"ipc\") i\n),\ncited_ipc_freq AS (\n    SELECT \n        focal_patent,\n        cited_pub,\n        ipc_4digit,\n        COUNT(*) AS freq\n    FROM cited_ipc\n    GROUP BY focal_patent, cited_pub, ipc_4digit\n),\ncited_ipc_ranked AS (\n    SELECT \n        focal_patent,\n        cited_pub,\n        ipc_4digit,\n        freq,\n        ROW_NUMBER() OVER (PARTITION BY focal_patent, cited_pub ORDER BY freq DESC, ipc_4digit ASC) AS rn\n    FROM cited_ipc_freq\n),\ncited_class AS (\n    SELECT \n        focal_patent,\n        cited_pub,\n        ipc_4digit AS assigned_class\n    FROM cited_ipc_ranked\n    WHERE rn = 1\n),\nclass_counts AS (\n    SELECT \n        focal_patent,\n        assigned_class,\n        COUNT(*) AS n_k\n    FROM cited_class\n    GROUP BY focal_patent, assigned_class\n),\noriginality AS (\n    SELECT \n        focal_patent,\n        1.0 - SUM(CAST(n_k AS FLOAT) * CAST(n_k AS FLOAT)) / (CAST(SUM(n_k) AS FLOAT) * CAST(SUM(n_k) AS FLOAT)) AS originality_score\n    FROM class_counts\n    GROUP BY focal_patent\n)\nSELECT \n    focal_patent AS PUBLICATION_NUMBER,\n    ROUND(originality_score, 1) AS ORIGINALITY\nFROM originality\nWHERE originality_score > 0\nORDER BY originality_score DESC, PUBLICATION_NUMBER ASC\nLIMIT 1;") t := by
  first | sql_equiv | sorry

HYPOTHESIS hyp1_2_0 : PUBLICATIONS "\"country_code\" = 'US'"
