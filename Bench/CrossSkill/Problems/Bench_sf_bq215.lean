/-!
# sf_bq215 — crossskill equivalence(s)

Question: Which US patent (with a B2 kind code and a grant date between 2015 and 2018) has the highest originality score calculated as 1 - (the sum of squared occurrences of distinct 4-digit IPC codes in its backward citations divided by the square of the total occurrences of these 4-digit IPC codes)?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq215

CREATE TABLE PUBLICATIONS («publication_number» STRING, «application_number» STRING, «country_code» STRING, «kind_code» STRING, «application_kind» STRING, «application_number_formatted» STRING, «pct_number» STRING, «family_id» STRING, «spif_publication_number» STRING, «spif_application_number» STRING, «title_localized» STRING, «abstract_localized» STRING, «claims_localized» STRING, «claims_localized_html» STRING, «description_localized» STRING, «description_localized_html» STRING, «publication_date» INT, «filing_date» INT, «grant_date» INT, «priority_date» INT, «priority_claim» STRING, «inventor» STRING, «inventor_harmonized» STRING, «assignee» STRING, «assignee_harmonized» STRING, «examiner» STRING, «uspc» STRING, «ipc» STRING, «cpc» STRING, «fi» STRING, «fterm» STRING, «locarno» STRING, «citation» STRING, «parent» STRING, «child» STRING, «entity_status» STRING, «art_unit» STRING)

HYPOTHESIS hyp0_1_0 : PUBLICATIONS "\"country_code\" = 'US'"
HYPOTHESIS hyp0_1_1 : PUBLICATIONS "\"kind_code\" = 'B2'"
HYPOTHESIS hyp0_1_2 : PUBLICATIONS "\"grant_date\" >= 20150101"
HYPOTHESIS hyp0_1_3 : PUBLICATIONS "\"grant_date\" <= 20181231"
theorem eq_0_1 (t : TableRel PUBLICATIONS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) (h3 : hyp0_1_3 t) :
    (sql%([PUBLICATIONS_schema]) "WITH backward_citations AS (\n  -- Get all backward citations for US B2 patents with grant date 2015-2018\n  SELECT \n    p1.\"publication_number\" AS citing_patent,\n    c.value:\"publication_number\"::STRING AS cited_patent\n  FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p1,\n  LATERAL FLATTEN(input => p1.\"citation\") c\n  WHERE p1.\"country_code\" = 'US' \n    AND p1.\"kind_code\" = 'B2'\n    AND p1.\"grant_date\" >= 20150101\n    AND p1.\"grant_date\" <= 20181231\n    AND c.value:\"publication_number\"::STRING IS NOT NULL\n    AND c.value:\"publication_number\"::STRING != ''\n),\ncited_ipc_counts AS (\n  -- For each cited patent, count frequency of each 4-digit IPC code\n  SELECT \n    bc.citing_patent,\n    bc.cited_patent,\n    SUBSTR(ipc.value:\"code\"::STRING, 1, 4) AS ipc_4digit,\n    COUNT(*) AS freq\n  FROM backward_citations bc\n  JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p2 \n    ON bc.cited_patent = p2.\"publication_number\",\n  LATERAL FLATTEN(input => p2.\"ipc\") ipc\n  GROUP BY bc.citing_patent, bc.cited_patent, SUBSTR(ipc.value:\"code\"::STRING, 1, 4)\n),\ncited_main_class AS (\n  -- Assign each cited patent its main (most frequent) 4-digit IPC class\n  SELECT \n    citing_patent,\n    cited_patent,\n    ipc_4digit,\n    ROW_NUMBER() OVER (\n      PARTITION BY citing_patent, cited_patent \n      ORDER BY freq DESC, ipc_4digit ASC\n    ) AS rn\n  FROM cited_ipc_counts\n),\ncited_with_class AS (\n  SELECT citing_patent, cited_patent, ipc_4digit AS main_class\n  FROM cited_main_class\n  WHERE rn = 1\n),\nclass_counts AS (\n  -- Count number of cited patents per class per citing patent\n  SELECT citing_patent, main_class, COUNT(*) AS ncited_k\n  FROM cited_with_class\n  GROUP BY citing_patent, main_class\n),\ntotal_counts AS (\n  -- Total cited patents per citing patent\n  SELECT citing_patent, SUM(ncited_k) AS ncited_i\n  FROM class_counts\n  GROUP BY citing_patent\n),\noriginality AS (\n  SELECT \n    cc.citing_patent,\n    1.0 - SUM(POWER(CAST(cc.ncited_k AS FLOAT) / CAST(tc.ncited_i AS FLOAT), 2)) AS originality_score\n  FROM class_counts cc\n  JOIN total_counts tc ON cc.citing_patent = tc.citing_patent\n  GROUP BY cc.citing_patent, tc.ncited_i\n)\nSELECT \n  citing_patent AS PUBLICATION_NUMBER,\n  originality_score AS ORIGINALITY\nFROM originality\nORDER BY originality_score DESC, citing_patent ASC\nLIMIT 1;") t ~= (sql%([PUBLICATIONS_schema]) "WITH us_b2_patents AS (\n  SELECT \"publication_number\"\n  FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\"\n  WHERE \"country_code\" = 'US'\n    AND \"kind_code\" = 'B2'\n    AND \"grant_date\" >= 20150101\n    AND \"grant_date\" <= 20181231\n),\nfocal_citations AS (\n  SELECT p.\"publication_number\" as focal_pub,\n         c.value:\"publication_number\"::STRING as cited_pub\n  FROM \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" p\n  JOIN us_b2_patents ubp ON p.\"publication_number\" = ubp.\"publication_number\",\n    LATERAL FLATTEN(input => p.\"citation\") c\n  WHERE c.value:\"publication_number\"::STRING IS NOT NULL\n),\ncited_ipc_counts AS (\n  SELECT fc.focal_pub, fc.cited_pub,\n         LEFT(f2.value:\"code\"::STRING, 4) as ipc_4,\n         COUNT(*) as ipc_cnt\n  FROM focal_citations fc\n  JOIN \"PATENTS\".\"PATENTS\".\"PUBLICATIONS\" cited ON cited.\"publication_number\" = fc.cited_pub,\n    LATERAL FLATTEN(input => cited.\"ipc\") f2\n  WHERE f2.value:\"code\"::STRING IS NOT NULL\n  GROUP BY fc.focal_pub, fc.cited_pub, LEFT(f2.value:\"code\"::STRING, 4)\n),\nranked AS (\n  SELECT focal_pub, cited_pub, ipc_4,\n         ROW_NUMBER() OVER (PARTITION BY focal_pub, cited_pub ORDER BY ipc_cnt DESC, ipc_4 ASC) as rn\n  FROM cited_ipc_counts\n),\ncited_primary_ipc AS (\n  SELECT focal_pub, cited_pub, ipc_4 FROM ranked WHERE rn = 1\n),\nipc_class_counts AS (\n  SELECT focal_pub, ipc_4, COUNT(*) as n_k\n  FROM cited_primary_ipc\n  GROUP BY focal_pub, ipc_4\n),\noriginality AS (\n  SELECT focal_pub as \"PUBLICATION_NUMBER\",\n         1.0 - SUM(POWER(n_k, 2)) / POWER(SUM(n_k), 2) as \"ORIGINALITY\"\n  FROM ipc_class_counts\n  GROUP BY focal_pub\n)\nSELECT \"PUBLICATION_NUMBER\", \"ORIGINALITY\"\nFROM originality\nORDER BY \"ORIGINALITY\" DESC, \"PUBLICATION_NUMBER\" ASC\nLIMIT 1;") t := by
  first | sql_equiv | sorry

HYPOTHESIS hyp0_2_0 : PUBLICATIONS "\"country_code\" = 'US'"
HYPOTHESIS hyp0_2_1 : PUBLICATIONS "\"kind_code\" = 'B2'"
HYPOTHESIS hyp0_2_2 : PUBLICATIONS "\"grant_date\" >= 20150101"
