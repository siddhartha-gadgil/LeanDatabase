namespace N_sf_local066_eq_1_2

CREATE TABLE PIZZA_CLEAN_RUNNER_ORDERS («order_id» INT, «runner_id» INT, «pickup_time» STRING, «distance» FLOAT, «duration» FLOAT, «cancellation» STRING)
CREATE TABLE PIZZA_RECIPES («pizza_id» INT, «toppings» STRING)
CREATE TABLE PIZZA_CLEAN_CUSTOMER_ORDERS («order_id» INT, «customer_id» INT, «pizza_id» INT, «exclusions» STRING, «extras» STRING, «order_time» STRING)
CREATE TABLE PIZZA_TOPPINGS («topping_id» INT, «topping_name» STRING)

theorem eq (t0 : TableRel PIZZA_CLEAN_RUNNER_ORDERS_schema) (t1 : TableRel PIZZA_RECIPES_schema) (t2 : TableRel PIZZA_CLEAN_CUSTOMER_ORDERS_schema) (t3 : TableRel PIZZA_TOPPINGS_schema) :
    (sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "/* For delivered pizzas, summarize total quantity of each ingredient used */ /* Using exclusions/extras columns from PIZZA_CLEAN_CUSTOMER_ORDERS directly */ WITH delivered_orders AS (SELECT \"order_id\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\" WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''), delivered_pizzas /* Customer orders for delivered pizzas with a unique row number */ AS (SELECT c.\"order_id\", c.\"pizza_id\", c.\"exclusions\", c.\"extras\", ROW_NUMBER() OVER (ORDER BY c.\"order_id\", c.\"pizza_id\") AS pizza_row FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" AS c INNER JOIN delivered_orders AS d ON c.\"order_id\" = d.\"order_id\"), base_toppings /* Expand base recipe toppings for each delivered pizza */ AS (SELECT dp.pizza_row, dp.\"order_id\", dp.\"exclusions\", CAST(TRIM(rt.VALUE) AS INT) AS topping_id FROM delivered_pizzas AS dp JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" AS r ON dp.\"pizza_id\" = r.\"pizza_id\", LATERAL SPLIT_TO_TABLE(r.\"toppings\", ',') AS rt), pizza_exclusions /* Expand exclusions per pizza (split comma-separated exclusions) */ AS (SELECT dp.pizza_row, CAST(TRIM(ex.VALUE) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL SPLIT_TO_TABLE(dp.\"exclusions\", ',') AS ex WHERE NOT dp.\"exclusions\" IS NULL AND dp.\"exclusions\" <> ''), pizza_extras /* Expand extras per pizza (split comma-separated extras) */ AS (SELECT dp.pizza_row, CAST(TRIM(ext.VALUE) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL SPLIT_TO_TABLE(dp.\"extras\", ',') AS ext WHERE NOT dp.\"extras\" IS NULL AND dp.\"extras\" <> ''), all_toppings /* All toppings = base (minus exclusions) + extras */ AS (/* Base toppings minus exclusions */ SELECT b.topping_id FROM base_toppings AS b WHERE NOT EXISTS(SELECT 1 FROM pizza_exclusions AS pe WHERE pe.pizza_row = b.pizza_row AND pe.topping_id = b.topping_id) UNION ALL /* Extra toppings */ SELECT pe.topping_id FROM pizza_extras AS pe) /* Final aggregation */ SELECT t.\"topping_name\" AS \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\" FROM all_toppings AS a JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON a.topping_id = t.\"topping_id\" GROUP BY t.\"topping_name\" ORDER BY t.\"topping_name\"") t0 t1 t2 t3
  = (sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "/* Total quantity of each ingredient used in delivered pizzas */ /* Base recipe toppings + extras - exclusions for non-cancelled orders */ WITH delivered_orders AS (/* Get only delivered orders (not cancelled) */ SELECT \"order_id\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\" WHERE \"cancellation\" IS NULL OR TRIM(\"cancellation\") = ''), customer_pizzas AS (/* Get customer orders that were delivered */ SELECT co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" AS co INNER JOIN delivered_orders AS d ON co.\"order_id\" = d.\"order_id\"), recipe_toppings /* Split recipe toppings for each pizza type */ AS (SELECT \"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS DECIMAL(38, 0)) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\", LATERAL UNNEST(input => SPLIT(\"toppings\", ',')) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS)), base_toppings /* Base toppings: one row per topping per delivered pizza */ AS (SELECT cp.\"order_id\", cp.\"pizza_id\", rt.topping_id, 1 AS qty FROM customer_pizzas AS cp INNER JOIN recipe_toppings AS rt ON cp.\"pizza_id\" = rt.\"pizza_id\"), exclusion_toppings /* Exclusions: parse from clean customer orders for delivered orders */ AS (SELECT cp.\"order_id\", cp.\"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS DECIMAL(38, 0)) AS topping_id, -1 AS qty FROM customer_pizzas AS cp, LATERAL UNNEST(input => SPLIT(cp.\"exclusions\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT cp.\"exclusions\" IS NULL AND TRIM(cp.\"exclusions\") <> ''), extra_toppings /* Extras: parse from clean customer orders for delivered orders */ AS (SELECT cp.\"order_id\", cp.\"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS DECIMAL(38, 0)) AS topping_id, 1 AS qty FROM customer_pizzas AS cp, LATERAL UNNEST(input => SPLIT(cp.\"extras\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT cp.\"extras\" IS NULL AND TRIM(cp.\"extras\") <> ''), all_toppings /* Combine all */ AS (SELECT topping_id, qty FROM base_toppings UNION ALL SELECT topping_id, qty FROM exclusion_toppings UNION ALL SELECT topping_id, qty FROM extra_toppings) SELECT t.\"topping_name\" AS \"TOPPING_NAME\", SUM(a.qty) AS \"TOTAL_QUANTITY\" FROM all_toppings AS a INNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON a.topping_id = t.\"topping_id\" GROUP BY t.\"topping_name\" ORDER BY \"TOPPING_NAME\"") t0 t1 t2 t3
