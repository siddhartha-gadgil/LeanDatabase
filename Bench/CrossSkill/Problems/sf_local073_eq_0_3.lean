_exclusions /* Remove excluded toppings from standard */ AS (SELECT st.row_id, st.\"order_id\", st.\"customer_id\", st.pizza_id, st.\"pizza_name\", st.\"order_time\", st.topping_id, st.source FROM order_standard_toppings AS st LEFT JOIN order_exclusions AS ex ON st.row_id = ex.row_id AND st.topping_id = ex.excluded_topping_id WHERE ex.excluded_topping_id IS NULL), all_toppings /* Add extras as separate rows */ AS (SELECT row_id, \"order_id\", \"customer_id\", pizza_id, \"pizza_name\", \"order_time\", topping_id, source FROM standard_minus_exclusions UNION ALL SELECT o.row_id, o.\"order_id\", o.\"customer_id\", o.pizza_id, o.\"pizza_name\", o.\"order_time\", ext.extra_topping_id AS topping_id, 'extra' AS source FROM orders_with_names AS o JOIN order_extras AS ext ON o.row_id = ext.row_id), topping_counts /* Count each topping per order row */ AS (SELECT at.row_id, at.\"order_id\", at.\"customer_id\", at.pizza_id, at.\"pizza_name\", at.\"order_time\", at.topping_id, t.\"topping_name\", COUNT(*) AS cnt FROM all_toppings AS at JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON at.topping_id = t.\"topping_id\" GROUP BY at.row_id, at.\"order_id\", at.\"customer_id\", at.pizza_id, at.\"pizza_name\", at.\"order_time\", at.topping_id, t.\"topping_name\"), formatted_toppings /* Format topping names with 2x prefix where needed */ AS (SELECT row_id, \"order_id\", \"customer_id\", pizza_id, \"pizza_name\", \"order_time\", topping_id, \"topping_name\", cnt, CASE WHEN cnt >= 2 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name, CASE WHEN cnt >= 2 THEN 0 ELSE 1 END AS sort_group FROM topping_counts), ingredient_strings /* Aggregate into ingredient string: 2x items first (alphabetical), then single items (alphabetical) */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_name\", \"order_time\", \"pizza_name\" || ': ' || STRING_AGG(formatted_name, ', ' ORDER BY sort_group, \"topping_name\") AS ingredients FROM formatted_toppings GROUP BY r