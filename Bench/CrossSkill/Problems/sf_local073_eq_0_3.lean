zza_id\", topping_id FROM after_exclusions UNION ALL SELECT oe.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", oe.topping_id FROM order_extras AS oe JOIN numbered_orders AS o ON oe.row_id = o.row_id), topping_counts /* Count toppings per order row */ AS (SELECT at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.topping_id, pt.\"topping_name\", COUNT(*) AS cnt FROM all_toppings AS at2 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS pt ON at2.topping_id = pt.\"topping_id\" GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.topping_id, pt.\"topping_name\"), formatted_toppings /* Format topping names with 2x prefix if needed, and sort: 2x first (alphabetically), then 1x (alphabetically) */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", CASE WHEN cnt > 1 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name, CASE WHEN cnt > 1 THEN 0 ELSE 1 END AS sort_group, \"topping_name\" FROM topping_counts), agg_toppings /* Aggregate toppings into comma-separated string per order row */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", STRING_AGG(formatted_name, ', ' ORDER BY sort_group, \"topping_name\") AS ingredients_list FROM formatted_toppings GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\") SELECT at3.row_id AS \"ROW_ID\", at3.\"order_id\" AS \"ORDER_ID\", at3.\"customer_id\" AS \"CUSTOMER_ID\", pn.\"pizza_name\" AS \"PIZZA_NAME\", pn.\"pizza_name\" || ': ' || at3.ingredients_list AS \"FINAL_INGREDIENTS\" FROM agg_toppings AS at3 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" AS pn ON at3.\"pizza_id\" = pn.\"pizza_id\" ORDER BY at3.row_id") t0 t1 t2 t3
