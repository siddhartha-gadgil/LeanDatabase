S \"RUNS1\",\n    CASE \n        WHEN runs_high > runs_low THEN runs_low\n        WHEN runs_low > runs_high THEN runs_high\n        ELSE runs_low  -- equal\n    END AS \"RUNS2\",\n    pship_runs AS \"PSHIP_RUNS\"\nFROM best_partnerships\nORDER BY pship_runs DESC, \"match_id\"") t ~= (sql%([PLAYER_schema, BATSMAN_SCORED_schema, BALL_BY_BALL_schema, MATCH_schema]) "WITH ball_runs AS (\n  SELECT \n    b.\"match_id\",\n    LEAST(b.\"striker\", b.\"non_striker\") AS p_low,\n    GREATEST(b.\"striker\", b.\"non_striker\") AS p_high,\n    b.\"striker\",\n    bs.\"runs_scored\"\n  FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n  JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs \n    ON b.\"match_id\" = bs.\"match_id\" \n    AND b.\"over_id\" = bs.\"over_id\" \n    AND b.\"ball_id\" = bs.\"ball_id\" \n    AND b.\"innings_no\" = bs.\"innings_no\"\n),\npartnership_totals AS (\n  SELECT \n    \"match_id\",\n    p_low,\n    p_high,\n    SUM(CASE WHEN \"striker\" = p_low THEN \"runs_scored\" ELSE 0 END) AS runs_low,\n    SUM(CASE WHEN \"striker\" = p_high THEN \"runs_scored\" ELSE 0 END) AS runs_high,\n    SUM(\"runs_scored\") AS pship_runs\n  FROM ball_runs\n  GROUP BY \"match_id\", p_low, p_high\n),\npartnership_with_player_order AS (\n  SELECT\n    \"match_id\",\n    CASE WHEN runs_high >= runs_low THEN p_high ELSE p_low END AS player1_id,\n    CASE WHEN runs_high >= runs_low THEN p_low ELSE p_high END AS player2_id,\n    CASE WHEN runs_high >= runs_low THEN runs_high ELSE runs_low END AS runs1,\n    CASE WHEN runs_high >= runs_low THEN runs_low ELSE runs_high END AS runs2,\n    pship_runs\n  FROM partnership_totals\n),\nmax_per_match AS (\n  SELECT \"match_id\", MAX(pship_runs) AS max_pship\n  FROM partnership_with_player_order\n  GROUP BY \"match_id\"\n)\nSELECT \n  p.\"match_id\",\n  p.player1_id AS \"PLAYER1_ID\",\n  p.player2_id AS \"PLAYER2_ID\",\n  p.runs1 AS \"RUNS1\",\n  p.runs2 AS \"RUNS2\",\n  p.pship_runs AS \"PSHIP_RUNS\"\nFROM partnership_with_player_order p\nJOIN max_per_mat