import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local229 — crossskill equivalence(s)

Question: Find the IDs of players who scored the highest number of partnership runs for each match. The output should include the IDs of two players, each with their individual scores and the total partnership score. For each pair, the player with the higher individual score should be listed as player 1, and the player with the lower score as player 2. In cases where both players have the same score, the player with the higher ID should be player 1, and the player with the lower ID should be player 2. There can be multiple rows for a single match.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local229

CREATE TABLE PLAYER («player_id» INT, «player_name» STRING, «dob» STRING, «batting_hand» STRING, «bowling_skill» STRING, «country_name» STRING)
CREATE TABLE BATSMAN_SCORED («match_id» INT, «over_id» INT, «ball_id» INT, «runs_scored» INT, «innings_no» INT)
CREATE TABLE BALL_BY_BALL («match_id» INT, «over_id» INT, «ball_id» INT, «innings_no» INT, «team_batting» INT, «team_bowling» INT, «striker_batting_position» INT, «striker» INT, «non_striker» INT, «bowler» INT)
CREATE TABLE MATCH («match_id» INT, «team_1» INT, «team_2» INT, «match_date» STRING, «season_id» INT, «venue» STRING, «toss_winner» INT, «toss_decision» STRING, «win_type» STRING, «win_margin» INT, «outcome_type» STRING, «match_winner» INT, «man_of_the_match» INT)

theorem eq_0_1 : ∀ t,
    (sql%([PLAYER_schema, BATSMAN_SCORED_schema, BALL_BY_BALL_schema, MATCH_schema]) "WITH partnership_runs AS (\n    -- Calculate total partnership runs for each pair of batsmen in each match\n    SELECT \n        b.\"match_id\",\n        LEAST(b.\"striker\", b.\"non_striker\") AS player_low,\n        GREATEST(b.\"striker\", b.\"non_striker\") AS player_high,\n        SUM(CASE WHEN b.\"striker\" = LEAST(b.\"striker\", b.\"non_striker\") THEN bs.\"runs_scored\" ELSE 0 END) AS runs_player_low,\n        SUM(CASE WHEN b.\"striker\" = GREATEST(b.\"striker\", b.\"non_striker\") THEN bs.\"runs_scored\" ELSE 0 END) AS runs_player_high,\n        SUM(bs.\"runs_scored\") AS pship_runs\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\" \n        AND b.\"over_id\" = bs.\"over_id\" \n        AND b.\"ball_id\" = bs.\"ball_id\" \n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"match_id\", player_low, player_high\n),\nmax_partnership AS (\n    -- Find the maximum partnership runs for each match\n    SELECT \"match_id\", MAX(pship_runs) AS max_pship_runs\n    FROM partnership_runs\n    GROUP BY \"match_id\"\n),\nbest_partnerships AS (\n    -- Get all partnerships that tie for the max in each match\n    SELECT \n        p.\"match_id\",\n        p.player_low,\n        p.player_high,\n        p.runs_player_low,\n        p.runs_player_high,\n        p.pship_runs\n    FROM partnership_runs p\n    JOIN max_partnership m\n        ON p.\"match_id\" = m.\"match_id\"\n        AND p.pship_runs = m.max_pship_runs\n),\nfinal AS (\n    -- Assign player 1 (higher individual score) and player 2 (lower individual score)\n    -- If tied individual scores, higher ID is player 1\n    SELECT \n        \"match_id\",\n        CASE \n            WHEN runs_player_high > runs_player_low THEN player_high\n            WHEN runs_player_low > runs_player_high THEN player_low\n            ELSE player_high  -- tied scores: higher ID is player 1 (player_high is GREATEST)\n        END AS PLAYER1_ID,\n        CASE \n            WHEN runs_player_high > runs_player_low THEN player_low\n            WHEN runs_player_low > runs_player_high THEN player_high\n            ELSE player_low  -- tied scores: lower ID is player 2 (player_low is LEAST)\n        END AS PLAYER2_ID,\n        CASE \n            WHEN runs_player_high > runs_player_low THEN runs_player_high\n            WHEN runs_player_low > runs_player_high THEN runs_player_low\n            ELSE runs_player_high  -- tied: higher ID's runs\n        END AS RUNS1,\n        CASE \n            WHEN runs_player_high > runs_player_low THEN runs_player_low\n            WHEN runs_player_low > runs_player_high THEN runs_player_high\n            ELSE runs_player_low  -- tied: lower ID's runs\n        END AS RUNS2,\n        pship_runs AS PSHIP_RUNS\n    FROM best_partnerships\n)\nSELECT \"match_id\", PLAYER1_ID, PLAYER2_ID, RUNS1, RUNS2, PSHIP_RUNS\nFROM final\nORDER BY PSHIP_RUNS DESC, \"match_id\", PLAYER1_ID DESC;") t ~= (sql%([PLAYER_schema, BATSMAN_SCORED_schema, BALL_BY_BALL_schema, MATCH_schema]) "WITH partnerships AS (\n    SELECT \n        b.\"match_id\",\n        LEAST(b.\"striker\", b.\"non_striker\") AS low_player,\n        GREATEST(b.\"striker\", b.\"non_striker\") AS high_player,\n        SUM(CASE WHEN b.\"striker\" = LEAST(b.\"striker\", b.\"non_striker\") THEN bs.\"runs_scored\" ELSE 0 END) AS runs_low,\n        SUM(CASE WHEN b.\"striker\" = GREATEST(b.\"striker\", b.\"non_striker\") THEN bs.\"runs_scored\" ELSE 0 END) AS runs_high,\n        SUM(bs.\"runs_scored\") AS pship_runs\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs \n        ON b.\"match_id\" = bs.\"match_id\" \n        AND b.\"over_id\" = bs.\"over_id\" \n        AND b.\"ball_id\" = bs.\"ball_id\" \n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"match_id\", LEAST(b.\"striker\", b.\"non_striker\"), GREATEST(b.\"striker\", b.\"non_striker\")\n),\nmax_pship AS (\n    SELECT \"match_id\", MAX(pship_runs) AS max_runs\n    FROM partnerships\n    GROUP BY \"match_id\"\n),\nbest_partnerships AS (\n    SELECT \n        p.\"match_id\",\n        p.low_player,\n        p.high_player,\n        p.runs_low,\n        p.runs_high,\n        p.pship_runs\n    FROM partnerships p\n    JOIN max_pship m\n        ON p.\"match_id\" = m.\"match_id\" AND p.pship_runs = m.max_runs\n)\nSELECT \n    \"match_id\",\n    CASE \n        WHEN runs_high > runs_low THEN high_player\n        WHEN runs_low > runs_high THEN low_player\n        ELSE high_player  -- equal scores: higher ID is player1\n    END AS \"PLAYER1_ID\",\n    CASE \n        WHEN runs_high > runs_low THEN low_player\n        WHEN runs_low > runs_high THEN high_player\n        ELSE low_player  -- equal scores: lower ID is player2\n    END AS \"PLAYER2_ID\",\n    CASE \n        WHEN runs_high > runs_low THEN runs_high\n        WHEN runs_low > runs_high THEN runs_low\n        ELSE runs_high  -- equal\n    END AS \"RUNS1\",\n    CASE \n        WHEN runs_high > runs_low THEN runs_low\n        WHEN runs_low > runs_high THEN runs_high\n        ELSE runs_low  -- equal\n    END AS \"RUNS2\",\n    pship_runs AS \"PSHIP_RUNS\"\nFROM best_partnerships\nORDER BY pship_runs DESC, \"match_id\"") t := by
  intro t; first | sql_equiv | sorry

