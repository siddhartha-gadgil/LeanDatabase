    (sql%([CYTOBANDS_HG38_schema, COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23_schema]) "WITH total_cases AS (SELECT COUNT(DISTINCT \"case_barcode\") AS n_cases FROM \"TCGA_MITELMAN\".\"TCGA_VERSIONED\".\"COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23\" WHERE \"project_short_name\" = 'TCGA-BRCA'), overlaps /* Step 1: Compute overlap between each CNV segment and each cytoband, per case */ AS (SELECT cn.\"case_barcode\", c.\"cytoband_name\", c.\"hg38_start\", c.\"hg38_stop\", cn.\"copy_number\", CAST((ABS(c.\"hg38_stop\" - c.\"hg38_start\") + ABS(cn.\"end_pos\" - cn.\"start_pos\") - ABS(c.\"hg38_stop\" - cn.\"end_pos\") - ABS(c.\"hg38_start\" - cn.\"start_pos\")) AS DOUBLE PRECISION) / 2.0 AS overlap_bp FROM \"TCGA_MITELMAN\".\"PROD\".\"CYTOBANDS_HG38\" AS c JOIN \"TCGA_MITELMAN\".\"TCGA_VERSIONED\".\"COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23\" AS cn ON c.\"chromosome\" = cn.\"chromosome\" AND cn.\"start_pos\" < c.\"hg38_stop\" AND cn.\"end_pos\" > c.\"hg38_start\" WHERE cn.\"project_short_name\" = 'TCGA-BRCA'), weighted_avg /* Step 2: Compute overlap-weighted average copy number per case, cytoband */ AS (SELECT \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\", CAST(SUM(overlap_bp * \"copy_number\") AS DOUBLE PRECISION) / SUM(overlap_bp) AS weighted_avg_cn FROM overlaps WHERE overlap_bp > 0 GROUP BY \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\"), classified /* Step 3: Round to nearest integer and classify CNV type */ AS (SELECT \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\", ROUND(weighted_avg_cn, 0) AS rounded_cn, CASE WHEN ROUND(weighted_avg_cn, 0) = 0 THEN 'homodel' WHEN ROUND(weighted_avg_cn, 0) = 1 THEN 'heterodel' WHEN ROUND(weighted_avg_cn, 0) = 2 THEN 'normal' WHEN ROUND(weighted_avg_cn, 0) = 3 THEN 'gain' WHEN ROUND(weighted_avg_cn, 0) >= 4 THEN 'amp' END AS cnv_type FROM weighted_avg) /* Step 4: Calculate frequency of each CNV type per cytoband */ SELECT cl.\"cytoband_name\", cl.\"hg38_start\", cl.\"hg38_stop\", ROUND(CAST(COUNT(CASE WHEN cnv_type = 'homodel' THEN 1 END) * 100.0 AS DOUBLE PRECISION) / tc.n_cases, 2) AS freq_homodel, ROUND(CAST(COUNT(CASE WHEN cnv_type = 'heterodel' THEN 1 END) * 100.0 AS DOUBLE PRECISION) / tc.n_cases, 2) AS freq_heterodel, ROUND(CAST(COUNT(CASE WHEN cnv_type = 'normal' THEN 1 END) * 100.0 AS DOUBLE PRECISION) / tc.n_cases, 2) AS freq_normal, ROUND(CAST(COUNT(CASE WHEN cnv_type = 'gain' THEN 1 END) * 100.0 AS DOUBLE PRECISION) / tc.n_cases, 2) AS freq_gain, ROUND(CAST(COUNT(CASE WHEN cnv_type = 'amp' THEN 1 END) * 100.0 AS DOUBLE PRECISION) / tc.n_cases, 2) AS freq_amp FROM classified AS cl CROSS JOIN total_cases AS tc GROUP BY cl.\"cytoband_name\", cl.\"hg38_start\", cl.\"hg38_stop\", tc.n_cases ORDER BY cl.\"cytoband_name\"") t0 t1
  ~= (sql%([CYTOBANDS_HG38_schema, COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23_schema]) "WITH brca_segments /* Get all TCGA-BRCA copy number segments */ AS (SELECT \"case_barcode\", \"chromosome\", \"start_pos\", \"end_pos\", \"copy_number\" FROM \"TCGA_MITELMAN\".\"TCGA_VERSIONED\".\"COPY_NUMBER_SEGMENT_ALLELIC_HG38_GDC_R23\" WHERE \"project_short_name\" = 'TCGA-BRCA'), cytobands /* Get cytobands */ AS (SELECT \"chromosome\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\" FROM \"TCGA_MITELMAN\".\"PROD\".\"CYTOBANDS_HG38\"), seg_cyto /* Join segments with cytobands on chromosome overlap */ AS (SELECT s.\"case_barcode\", c.\"cytoband_name\", c.\"hg38_start\", c.\"hg38_stop\", s.\"copy_number\", LEAST(s.\"end_pos\", c.\"hg38_stop\") /* Compute overlap length */ - GREATEST(s.\"start_pos\", c.\"hg38_start\") AS overlap_len FROM brca_segments AS s JOIN cytobands AS c ON s.\"chromosome\" = c.\"chromosome\" AND s.\"start_pos\" < c.\"hg38_stop\" AND s.\"end_pos\" > c.\"hg38_start\"), case_cyto /* Weighted average copy number per case per cytoband */ AS (SELECT \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\", ROUND(CAST(SUM(\"copy_number\" * overlap_len) AS DOUBLE PRECISION) / SUM(overlap_len), 0) AS avg_cn FROM seg_cyto WHERE overlap_len > 0 GROUP BY \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\"), classified /* Classify copy number */ AS (SELECT \"case_barcode\", \"cytoband_name\", \"hg38_start\", \"hg38_stop\", CASE WHEN avg_cn = 0 THEN 'homodel' WHEN avg_cn = 1 THEN 'heterodel' WHEN avg_cn = 2 THEN 'normal' WHEN avg_cn = 3 THEN 'gain' WHEN avg_cn >= 4 THEN 'amp' END AS cn_class FROM case_cyto), total_cases /* Count total distinct cases */ AS (SELECT COUNT(DISTINCT \"case_barcode\") AS total FROM brca_segments), freq /* Frequency per cytoband */ AS (SELECT c.\"cytoband_name\", c.\"hg38_start\", c.\"hg38_stop\", ROUND(CAST(100.0 * COUNT(CASE WHEN c.cn_class = 'homodel' THEN 1 END) AS DOUBLE PRECISION) / t.total, 2) AS freq_homodel, ROUND(CAST(100.0 * COUNT(CASE WHEN c.cn_class = 'heterodel' THEN 1 END) AS DOUBLE PRECISION) / t.total, 2) AS freq_heterodel, ROUND(CAST(100.0 * COUNT(CASE WHEN c.cn_class = 'normal' THEN 1 END) AS DOUBLE PRECISION) / t.total, 2) AS freq_normal, ROUND(CAST(100.0 * COUNT(CASE WHEN c.cn_class = 'gain' THEN 1 END) AS DOUBLE PRECISION) / t.total, 2) AS freq_gain, ROUND(CAST(100.0 * COUNT(CASE WHEN c.cn_class = 'amp' THEN 1 END) AS DOUBLE PRECISION) / t.total, 2) AS freq_amp FROM classified AS c CROSS JOIN total_cases AS t GROUP BY c.\"cytoband_name\", c.\"hg38_start\", c.\"hg38_stop\", t.total) SELECT \"cytoband_name\", \"hg38_start\", \"hg38_stop\", freq_homodel, freq_heterodel, freq_normal, freq_gain, freq_amp FROM freq ORDER BY \"cytoband_name\"") t0 t1
