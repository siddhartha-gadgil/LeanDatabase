import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq292_eq_1_3

CREATE TABLE TRANSACTIONS («block_height» INT, «block_timestamp» STRING, «block_timestamp_truncated» INT, «txhash» STRING, «transaction_type» STRING, «gas_wanted» INT, «gas_used» INT, «sender» STRING, «fee» STRING, «memo» STRING)
CREATE TABLE OUTPUTS («transaction_hash» STRING, «block_hash» STRING, «block_number» INT, «block_timestamp» INT, «index» INT, «script_asm» STRING, «script_hex» STRING, «required_signatures» INT, «type» STRING, «addresses» STRING, «value» INT)

theorem eq (t0 : TableRel TRANSACTIONS_schema) (t1 : TableRel OUTPUTS_schema) :
    (sql%([TRANSACTIONS_schema, OUTPUTS_schema]) "WITH coinjoin_tx AS (SELECT t.\"hash\", t.\"block_timestamp_month\" FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" AS t, LATERAL UNNEST(input => t.\"outputs\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE t.\"block_timestamp_month\" >= '2023-07-01' AND t.\"output_count\" > 2 AND t.\"output_value\" <= t.\"input_value\" GROUP BY t.\"hash\", t.\"block_timestamp_month\" HAVING COUNT(*) > COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(f.value, 'value') AS DECIMAL(38, 0)))) SELECT CAST(100.0 * COUNT(CASE WHEN NOT cj.\"hash\" IS NULL THEN 1 END) AS DOUBLE PRECISION) / COUNT(*) AS tx_percent, CAST(100.0 * (CAST(SUM(CASE WHEN NOT cj.\"hash\" IS NULL THEN t.\"input_count\" ELSE 0 END) * 1.0 AS DOUBLE PRECISION) / SUM(t.\"input_count\") + CAST(SUM(CASE WHEN NOT cj.\"hash\" IS NULL THEN t.\"output_count\" ELSE 0 END) * 1.0 AS DOUBLE PRECISION) / SUM(t.\"output_count\")) AS DOUBLE PRECISION) / 2 AS utxos_percent, CAST(100.0 * SUM(CASE WHEN NOT cj.\"hash\" IS NULL THEN t.\"input_value\" ELSE 0 END) AS DOUBLE PRECISION) / SUM(t.\"input_value\") AS value_percent FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" AS t LEFT JOIN coinjoin_tx AS cj ON t.\"hash\" = cj.\"hash\" WHERE t.\"block_timestamp_month\" >= '2023-07-01' GROUP BY t.\"block_timestamp_month\" ORDER BY t.\"block_timestamp_month\" DESC") t0 t1
  ~= (sql%([TRANSACTIONS_schema, OUTPUTS_schema]) "WITH coinjoin_txs AS (/* Identify CoinJoin transactions: >2 outputs, output_value <= input_value, */ /* and at least two outputs with the same value (excluding 0) */ SELECT DISTINCT t.\"hash\" FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" AS t, LATERAL UNNEST(input => t.\"outputs\") AS o(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE t.\"output_count\" > 2 AND t.\"is_coinbase\" = FALSE AND t.\"output_value\" <= t.\"input_value\" AND t.\"block_timestamp_month\" >= '2023-07-01' AND CAST(JSON_EXTRACT_PATH(o.value, 'value') AS DECIMAL(38, 0)) > 0 GROUP BY t.\"hash\", CAST(JSON_EXTRACT_PATH(o.value, 'value') AS DECIMAL(38, 0)) HAVING COUNT(*) > 1), all_txs AS (SELECT t.\"block_timestamp_month\", t.\"hash\", t.\"input_count\", t.\"output_count\", t.\"input_value\", CASE WHEN NOT cj.\"hash\" IS NULL THEN 1 ELSE 0 END AS is_coinjoin FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" AS t LEFT JOIN coinjoin_txs AS cj ON t.\"hash\" = cj.\"hash\" WHERE t.\"block_timestamp_month\" >= '2023-07-01') SELECT CAST(100.0 * SUM(is_coinjoin) AS DOUBLE PRECISION) / COUNT(*) AS tx_percent, CAST(100.0 * ((CAST(SUM(CASE WHEN is_coinjoin = 1 THEN \"input_count\" ELSE 0 END) * 1.0 AS DOUBLE PRECISION) / SUM(\"input_count\")) + (CAST(SUM(CASE WHEN is_coinjoin = 1 THEN \"output_count\" ELSE 0 END) * 1.0 AS DOUBLE PRECISION) / SUM(\"output_count\"))) AS DOUBLE PRECISION) / 2.0 AS utxos_percent, CAST(100.0 * SUM(CASE WHEN is_coinjoin = 1 THEN \"input_value\" ELSE 0 END) AS DOUBLE PRECISION) / SUM(\"input_value\") AS value_percent FROM all_txs GROUP BY \"block_timestamp_month\" ORDER BY \"block_timestamp_month\" DESC") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq292_eq_1_3
