S \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\" FROM all_toppings AS at2 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS pt ON at2.topping_id = pt.\"topping_id\" GROUP BY pt.\"topping_name\" ORDER BY pt.\"topping_name\"") t0 t1 t2 t3
