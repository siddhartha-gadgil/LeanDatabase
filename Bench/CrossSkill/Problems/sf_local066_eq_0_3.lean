,'), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT dp.\"extras\" IS NULL AND dp.\"extras\" <> ''), base_minus_exclusions /* Remove exclusions from base toppings */ AS (SELECT bt.\"order_id\", bt.rn, bt.topping_id FROM base_toppings AS bt LEFT JOIN pizza_exclusions AS exc ON bt.\"order_id\" = exc.\"order_id\" AND bt.rn = exc.rn AND bt.topping_id = exc.topping_id WHERE exc.topping_id IS NULL), all_toppings /* Combine base (minus exclusions) with extras */ AS (SELECT topping_id FROM base_minus_exclusions UNION ALL SELECT topping_id FROM pizza_extras) /* Final aggregation: count per topping */ SELECT t.\"topping_name\" AS \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\" FROM all_toppings AS a INNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON a.topping_id = t.\"topping_id\" GROUP BY t.\"topping_name\" ORDER BY t.\"topping_name\"") t0 t1 t2 t3
