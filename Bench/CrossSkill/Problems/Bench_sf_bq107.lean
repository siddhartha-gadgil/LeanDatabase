1_REFERENCE_201703\" r\n      ON vc.\"reference_name\" = r.\"name\"\n)\nSELECT REFERENCE_NAME,\n       VARIANT_DENSITY,\n       VARIANT_COUNT,\n       REFERENCE_LENGTH\nFROM joined\nORDER BY REFERENCE_LENGTH DESC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

