namespace N_sf_bq049_eq_2_3

CREATE TABLE POPULATION_BY_ZIP_2010 («geo_id» STRING, «zipcode» STRING, «population» INT, «minimum_age» INT, «maximum_age» INT, «gender» STRING)
CREATE TABLE SALES («invoice_and_item_number» STRING, «date» STRING, «store_number» STRING, «store_name» STRING, «address» STRING, «city» STRING, «zip_code» STRING, «store_location» STRING, «county_number» STRING, «county» STRING, «category» STRING, «category_name» STRING, «vendor_number» STRING, «vendor_name» STRING, «item_number» STRING, «item_description» STRING, «pack» INT, «bottle_volume_ml» INT, «state_bottle_cost» FLOAT, «state_bottle_retail» FLOAT, «bottles_sold» INT, «sale_dollars» FLOAT, «volume_sold_liters» FLOAT, «volume_sold_gallons» FLOAT)

theorem eq (t0 : TableRel POPULATION_BY_ZIP_2010_schema) (t1 : TableRel SALES_schema) :
    (sql%([POPULATION_BY_ZIP_2010_schema, SALES_schema]) "WITH bourbon_sales AS (SELECT CAST(\"zip_code\" AS INT) AS zip_code, \"date\", \"sale_dollars\" FROM \"IOWA_LIQUOR_SALES_PLUS\".\"IOWA_LIQUOR_SALES\".\"SALES\" WHERE \"county\" = 'DUBUQUE' AND LOWER(\"category_name\") LIKE '%bourbon%'), zip_ranked /* Rank zip codes by total bourbon whiskey sales (all time in Dubuque County) */ AS (SELECT zip_code, SUM(\"sale_dollars\") AS total_sales, ROW_NUMBER() OVER (ORDER BY SUM(\"sale_dollars\") DESC) AS rank FROM bourbon_sales GROUP BY zip_code), third_zip /* Get the 3rd-ranked zip code */ AS (SELECT zip_code FROM zip_ranked WHERE rank = 3), pop_21plus /* Population aged 21+ per zip code (sum male + female) */ AS (SELECT \"zipcode\", SUM(\"population\") AS population_21plus FROM \"IOWA_LIQUOR_SALES_PLUS\".\"CENSUS_BUREAU_USA\".\"POPULATION_BY_ZIP_2010\" WHERE \"minimum_age\" >= 21 AND \"gender\" IN ('male', 'female') GROUP BY \"zipcode\"), monthly_sales /* Monthly sales for the 3rd-ranked zip in 2022 */ AS (SELECT bs.zip_code, EXTRACT(MONTH FROM bs.\"date\") AS month, SUM(bs.\"sale_dollars\") AS total_monthly_sales FROM bourbon_sales AS bs INNER JOIN third_zip AS tz ON bs.zip_code = tz.zip_code WHERE EXTRACT(YEAR FROM bs.\"date\") = 2022 GROUP BY bs.zip_code, EXTRACT(MONTH FROM bs.\"date\")) SELECT ms.zip_code AS \"ZIP_CODE\", ms.month AS \"MONTH\", ROUND(CAST(ms.total_monthly_sales AS DOUBLE PRECISION) / p.population_21plus, 2) AS \"PER_CAPITA_SALES\" FROM monthly_sales AS ms INNER JOIN pop_21plus AS p ON CAST(ms.zip_code AS VARCHAR) = p.\"zipcode\" ORDER BY ms.month") t0 t1
  ~= (sql%([POPULATION_BY_ZIP_2010_schema, SALES_schema]) "WITH bourbon_sales_by_zip AS (SELECT REPLACE(\"zip_code\", '.0', '') AS ZIP_CODE, SUM(\"sale_dollars\") AS total_sales FROM \"IOWA_LIQUOR_SALES_PLUS\".\"IOWA_LIQUOR_SALES\".\"SALES\" WHERE UPPER(\"county\") = 'DUBUQUE' AND LOWER(\"category_name\") LIKE '%bourbon%' AND EXTRACT(YEAR FROM \"date\") = 2022 GROUP BY ZIP_CODE), pop_21_plus AS (SELECT \"zipcode\" AS ZIP_CODE, SUM(\"population\") AS pop_21 FROM \"IOWA_LIQUOR_SALES_PLUS\".\"CENSUS_BUREAU_USA\".\"POPULATION_BY_ZIP_2010\" WHERE \"minimum_age\" >= 21 AND NOT \"gender\" IS NULL GROUP BY \"zipcode\"), per_capita_ranked AS (SELECT bs.ZIP_CODE, CAST(bs.total_sales AS DOUBLE PRECISION) / p.pop_21 AS per_capita_total, ROW_NUMBER() OVER (ORDER BY CAST(bs.total_sales AS DOUBLE PRECISION) / p.pop_21 DESC) AS rank FROM bourbon_sales_by_zip AS bs JOIN pop_21_plus AS p ON bs.ZIP_CODE = p.ZIP_CODE), target_zip AS (SELECT ZIP_CODE FROM per_capita_ranked WHERE rank = 3) SELECT tz.ZIP_CODE, EXTRACT(MONTH FROM s.\"date\") AS MONTH, ROUND(CAST(SUM(s.\"sale_dollars\") AS DOUBLE PRECISION) / p.pop_21, 2) AS PER_CAPITA_SALES FROM \"IOWA_LIQUOR_SALES_PLUS\".\"IOWA_LIQUOR_SALES\".\"SALES\" AS s JOIN target_zip AS tz ON REPLACE(s.\"zip_code\", '.0', '') = tz.ZIP_CODE JOIN pop_21_plus AS p ON tz.ZIP_CODE = p.ZIP_CODE WHERE LOWER(s.\"category_name\") LIKE '%bourbon%' AND EXTRACT(YEAR FROM s.\"date\") = 2022 GROUP BY tz.ZIP_CODE, EXTRACT(MONTH FROM s.\"date\"), p.pop_21 ORDER BY MONTH") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq049_eq_2_3
