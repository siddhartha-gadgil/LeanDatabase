import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq418 — crossskill equivalence(s)

Question: Determine which three lowest-level Reactome pathways (with TAS evidence) have the highest chi-squared statistics, considering only Homo sapiens targets associated with sorafenib under the conditions that the median assay value is ≤ 100 and both low and high assay values are ≤ 100 or null. For each of these three pathways, how many of these targets and non-targets lie within the pathway and outside it?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq418

CREATE TABLE PE_TO_PATHWAY_V77 («pe_stable_id» STRING, «pathway_stable_id» STRING, «evidence_code» STRING)
CREATE TABLE PATHWAY_V77 («stable_id» STRING, «url» STRING, «name» STRING, «species» STRING, «lowest_level» BOOL)
CREATE TABLE PHYSICAL_ENTITY_V77 («ensembl_id» STRING, «uniprot_id» STRING, «stable_id» STRING, «name» STRING, «location» STRING)
CREATE TABLE EXPERIMENTS_V1 («expID» INT, «exp_assayType» STRING, «exp_assayValueLow» FLOAT, «exp_assayValueMedian» FLOAT, «exp_assayValueHigh» FLOAT, «exp_assayUnits» STRING, «exp_assayRelation» STRING, «exp_assayDescription» STRING, «exp_assaySpecies» STRING, «exp_parentSource» STRING, «sourceID» INT, «PubMedID» STRING, «databaseName» STRING, «db_version» STRING, «db_downloadURL» STRING, «db_downloadDate» STRING)
CREATE TABLE INTERACTIONS_V1 («interactionID» INT, «drugID» INT, «targetID» INT, «interactionType» STRING, «drugName» STRING, «drug_approvalDate» STRING, «drug_atcClassID» STRING, «drug_atcClassName» STRING, «drug_atcClassStatus» STRING, «drug_epcClassID» STRING, «drug_epcClassName» STRING, «targetName» STRING, «targetType» STRING, «target_uniprotID» STRING, «targetSpecies» STRING, «sourceID» INT, «expID» INT)

theorem eq_0_1 : ∀ t,
    (sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH sorafenib_targets AS (\n  SELECT DISTINCT i.\"target_uniprotID\" AS \"uniprot_id\"\n  FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" i\n  JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" e \n    ON i.\"expID\" = e.\"expID\"\n  WHERE LOWER(i.\"drugName\") LIKE '%sorafenib%' \n    AND i.\"targetSpecies\" = 'Homo sapiens'\n    AND e.\"exp_assayValueMedian\" <= 100\n    AND (e.\"exp_assayValueLow\" <= 100 OR e.\"exp_assayValueLow\" IS NULL)\n    AND (e.\"exp_assayValueHigh\" <= 100 OR e.\"exp_assayValueHigh\" IS NULL)\n),\n-- Universe: all distinct non-null uniprot_ids in lowest-level TAS pathways\nuniverse AS (\n  SELECT DISTINCT pe.\"uniprot_id\"\n  FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" pp\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw \n    ON pp.\"pathway_stable_id\" = pw.\"stable_id\"\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    ON pp.\"pe_stable_id\" = pe.\"stable_id\"\n  WHERE pp.\"evidence_code\" = 'TAS' \n    AND pw.\"lowest_level\" = 'True'\n    AND pe.\"uniprot_id\" IS NOT NULL\n),\n-- For each lowest-level TAS pathway, get distinct non-null uniprot_ids\npathway_genes AS (\n  SELECT DISTINCT pp.\"pathway_stable_id\", pe.\"uniprot_id\"\n  FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" pp\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw \n    ON pp.\"pathway_stable_id\" = pw.\"stable_id\"\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    ON pp.\"pe_stable_id\" = pe.\"stable_id\"\n  WHERE pp.\"evidence_code\" = 'TAS' \n    AND pw.\"lowest_level\" = 'True'\n    AND pe.\"uniprot_id\" IS NOT NULL\n),\n-- Count per pathway: n (total genes in pathway), k (target genes in pathway)\npathway_counts AS (\n  SELECT \n    pg.\"pathway_stable_id\",\n    COUNT(DISTINCT pg.\"uniprot_id\") AS n,\n    COUNT(DISTINCT CASE WHEN st.\"uniprot_id\" IS NOT NULL THEN pg.\"uniprot_id\" END) AS k\n  FROM pathway_genes pg\n  LEFT JOIN sorafenib_targets st ON pg.\"uniprot_id\" = st.\"uniprot_id\"\n  GROUP BY pg.\"pathway_stable_id\"\n),\n-- Global parameters\nparams AS (\n  SELECT \n    (SELECT COUNT(*) FROM universe) AS N_val,\n    (SELECT COUNT(*) FROM universe u INNER JOIN sorafenib_targets st ON u.\"uniprot_id\" = st.\"uniprot_id\") AS K_val\n)\nSELECT \n  pc.\"pathway_stable_id\" AS PATHWAY_ID,\n  pw.\"name\" AS PATHWAY_NAME,\n  pc.k AS TARGETS_IN_PATHWAY,\n  p.K_val - pc.k AS TARGETS_OUTSIDE_PATHWAY,\n  pc.n - pc.k AS NONTARGETS_IN_PATHWAY,\n  p.N_val - p.K_val - pc.n + pc.k AS NONTARGETS_OUTSIDE_PATHWAY,\n  ROUND(\n    CAST(p.N_val AS FLOAT) * \n    POWER(\n      CAST(pc.k AS FLOAT) * CAST(p.N_val - p.K_val - pc.n + pc.k AS FLOAT) - \n      CAST(p.K_val - pc.k AS FLOAT) * CAST(pc.n - pc.k AS FLOAT), \n      2\n    ) / NULLIF(\n      CAST(p.K_val AS FLOAT) * \n      CAST(p.N_val - p.K_val AS FLOAT) * \n      CAST(pc.n AS FLOAT) * \n      CAST(p.N_val - pc.n AS FLOAT), \n      0\n    ),\n    2\n  ) AS CHI_SQUARED\nFROM pathway_counts pc\nCROSS JOIN params p\nJOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw \n  ON pc.\"pathway_stable_id\" = pw.\"stable_id\"\nWHERE pc.k > 0\nORDER BY CHI_SQUARED DESC\nLIMIT 3;") t ~= (sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH sorafenib_targets AS (\n    SELECT DISTINCT i.\"target_uniprotID\"\n    FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" i\n    JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" e ON i.\"expID\" = e.\"expID\"\n    WHERE i.\"drugName\" = 'Sorafenib Tosylate'\n      AND i.\"targetSpecies\" = 'Homo sapiens'\n      AND e.\"exp_assayValueMedian\" <= 100\n),\nreactome_universe AS (\n    SELECT DISTINCT pe.\"uniprot_id\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" p2p ON pe.\"stable_id\" = p2p.\"pe_stable_id\"\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw ON p2p.\"pathway_stable_id\" = pw.\"stable_id\"\n    WHERE pw.\"species\" = 'Homo sapiens'\n      AND pw.\"lowest_level\" = TRUE\n      AND p2p.\"evidence_code\" = 'TAS'\n),\ntotal_counts AS (\n    SELECT\n        COUNT(DISTINCT ru.\"uniprot_id\") AS total_proteins,\n        COUNT(DISTINCT CASE WHEN st.\"target_uniprotID\" IS NOT NULL THEN ru.\"uniprot_id\" END) AS total_targets\n    FROM reactome_universe ru\n    LEFT JOIN sorafenib_targets st ON ru.\"uniprot_id\" = st.\"target_uniprotID\"\n),\npathway_proteins AS (\n    SELECT\n        pw.\"stable_id\" AS pathway_id,\n        pw.\"name\" AS pathway_name,\n        pe.\"uniprot_id\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" p2p ON pe.\"stable_id\" = p2p.\"pe_stable_id\"\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw ON p2p.\"pathway_stable_id\" = pw.\"stable_id\"\n    WHERE pw.\"species\" = 'Homo sapiens'\n      AND pw.\"lowest_level\" = TRUE\n      AND p2p.\"evidence_code\" = 'TAS'\n),\npathway_counts AS (\n    SELECT\n        pp.pathway_id,\n        pp.pathway_name,\n        COUNT(DISTINCT CASE WHEN st.\"target_uniprotID\" IS NOT NULL THEN pp.\"uniprot_id\" END) AS a,\n        COUNT(DISTINCT pp.\"uniprot_id\") AS proteins_in_pathway\n    FROM pathway_proteins pp\n    LEFT JOIN sorafenib_targets st ON pp.\"uniprot_id\" = st.\"target_uniprotID\"\n    GROUP BY pp.pathway_id, pp.pathway_name\n),\nchi_squared AS (\n    SELECT\n        pc.pathway_id,\n        pc.pathway_name,\n        pc.a AS TARGETS_IN_PATHWAY,\n        (tc.total_targets - pc.a) AS TARGETS_OUTSIDE_PATHWAY,\n        (pc.proteins_in_pathway - pc.a) AS NONTARGETS_IN_PATHWAY,\n        (tc.total_proteins - tc.total_targets - pc.proteins_in_pathway + pc.a) AS NONTARGETS_OUTSIDE_PATHWAY,\n        tc.total_proteins AS N,\n        pc.a AS cell_a,\n        (tc.total_targets - pc.a) AS cell_b,\n        (pc.proteins_in_pathway - pc.a) AS cell_c,\n        (tc.total_proteins - tc.total_targets - pc.proteins_in_pathway + pc.a) AS cell_d\n    FROM pathway_counts pc\n    CROSS JOIN total_counts tc\n)\nSELECT\n    pathway_id,\n    pathway_name,\n    TARGETS_IN_PATHWAY,\n    TARGETS_OUTSIDE_PATHWAY,\n    NONTARGETS_IN_PATHWAY,\n    NONTARGETS_OUTSIDE_PATHWAY,\n    ROUND(\n        (N * POWER(cell_a * cell_d - cell_b * cell_c, 2)) /\n        ((cell_a + cell_b) * (cell_c + cell_d) * (cell_a + cell_c) * (cell_b + cell_d)),\n        2\n    ) AS CHI_SQUARED\nFROM chi_squared\nWHERE TARGETS_IN_PATHWAY > 0\nORDER BY CHI_SQUARED DESC\nLIMIT 3") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH sorafenib_targets AS (\n  SELECT DISTINCT i.\"target_uniprotID\" AS \"uniprot_id\"\n  FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" i\n  JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" e \n    ON i.\"expID\" = e.\"expID\"\n  WHERE LOWER(i.\"drugName\") LIKE '%sorafenib%' \n    AND i.\"targetSpecies\" = 'Homo sapiens'\n    AND e.\"exp_assayValueMedian\" <= 100\n    AND (e.\"exp_assayValueLow\" <= 100 OR e.\"exp_assayValueLow\" IS NULL)\n    AND (e.\"exp_assayValueHigh\" <= 100 OR e.\"exp_assayValueHigh\" IS NULL)\n),\n-- Universe: all distinct non-null uniprot_ids in lowest-level TAS pathways\nuniverse AS (\n  SELECT DISTINCT pe.\"uniprot_id\"\n  FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" pp\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw \n    ON pp.\"pathway_stable_id\" = pw.\"stable_id\"\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    ON pp.\"pe_stable_id\" = pe.\"stable_id\"\n  WHERE pp.\"evidence_code\" = 'TAS' \n    AND pw.\"lowest_level\" = 'True'\n    AND pe.\"uniprot_id\" IS NOT NULL\n),\n-- For each lowest-level TAS pathway, get distinct non-null uniprot_ids\npathway_genes AS (\n  SELECT DISTINCT pp.\"pathway_stable_id\", pe.\"uniprot_id\"\n  FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" pp\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw \n    ON pp.\"pathway_stable_id\" = pw.\"stable_id\"\n  JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    ON pp.\"pe_stable_id\" = pe.\"stable_id\"\n  WHERE pp.\"evidence_code\" = 'TAS' \n    AND pw.\"lowest_level\" = 'True'\n    AND pe.\"uniprot_id\" IS NOT NULL\n),\n-- Count per pathway: n (total genes in pathway), k (target genes in pathway)\npathway_counts AS (\n  SELECT \n    pg.\"pathway_stable_id\",\n    COUNT(DISTINCT pg.\"uniprot_id\") AS n,\n    COUNT(DISTINCT CASE WHEN st.\"uniprot_id\" IS NOT NULL THEN pg.\"uniprot_id\" END) AS k\n  FROM pathway_genes pg\n  LEFT JOIN sorafenib_targets st ON pg.\"uniprot_id\" = st.\"uniprot_id\"\n  GROUP BY pg.\"pathway_stable_id\"\n),\n-- Global parameters\nparams AS (\n  SELECT \n    (SELECT COUNT(*) FROM universe) AS N_val,\n    (SELECT COUNT(*) FROM universe u INNER JOIN sorafenib_targets st ON u.\"uniprot_id\" = st.\"uniprot_id\") AS K_val\n)\nSELECT \n  pc.\"pathway_stable_id\" AS PATHWAY_ID,\n  pw.\"name\" AS PATHWAY_NAME,\n  pc.k AS TARGETS_IN_PATHWAY,\n  p.K_val - pc.k AS TARGETS_OUTSIDE_PATHWAY,\n  pc.n - pc.k AS NONTARGETS_IN_PATHWAY,\n  p.N_val - p.K_val - pc.n + pc.k AS NONTARGETS_OUTSIDE_PATHWAY,\n  ROUND(\n    CAST(p.N_val AS FLOAT) * \n    POWER(\n      CAST(pc.k AS FLOAT) * CAST(p.N_val - p.K_val - pc.n + pc.k AS FLOAT) - \n      CAST(p.K_val - pc.k AS FLOAT) * CAST(pc.n - pc.k AS FLOAT), \n      2\n    ) / NULLIF(\n      CAST(p.K_val AS FLOAT) * \n      CAST(p.N_val - p.K_val AS FLOAT) * \n      CAST(pc.n AS FLOAT) * \n      CAST(p.N_val - pc.n AS FLOAT), \n      0\n    ),\n    2\n  ) AS CHI_SQUARED\nFROM pathway_counts pc\nCROSS JOIN params p\nJOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw \n  ON pc.\"pathway_stable_id\" = pw.\"stable_id\"\nWHERE pc.k > 0\nORDER BY CHI_SQUARED DESC\nLIMIT 3;" = sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH \n-- Step 1: Get sorafenib targets (Homo sapiens) that pass assay filters\nsorafenib_targets AS (\n    SELECT DISTINCT i.\"target_uniprotID\" AS uniprot_id\n    FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" i\n    JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" e \n        ON i.\"expID\" = e.\"expID\"\n    WHERE LOWER(i.\"drugName\") LIKE '%sorafenib%'\n      AND i.\"targetSpecies\" = 'Homo sapiens'\n      AND e.\"exp_assayValueMedian\" <= 100\n      AND (e.\"exp_assayValueLow\" <= 100 OR e.\"exp_assayValueLow\" IS NULL)\n      AND (e.\"exp_assayValueHigh\" <= 100 OR e.\"exp_assayValueHigh\" IS NULL)\n),\n\n-- Step 2: Get all unique proteins (uniprot_id) that appear in lowest-level Homo sapiens pathways with TAS evidence\nall_pathway_genes AS (\n    SELECT DISTINCT pe.\"uniprot_id\", ptp.\"pathway_stable_id\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" ptp \n        ON pe.\"stable_id\" = ptp.\"pe_stable_id\"\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" p \n        ON ptp.\"pathway_stable_id\" = p.\"stable_id\"\n    WHERE ptp.\"evidence_code\" = 'TAS' \n      AND p.\"lowest_level\" = TRUE \n      AND p.\"species\" = 'Homo sapiens'\n),\n\n-- Step 3: Get the total universe of unique proteins across all TAS lowest-level pathways\ntotal_universe AS (\n    SELECT COUNT(DISTINCT \"uniprot_id\") AS total_genes\n    FROM all_pathway_genes\n),\n\n-- Step 4: Count total sorafenib targets (that are in the universe)\ntotal_targets AS (\n    SELECT COUNT(DISTINCT st.uniprot_id) AS total_target_count\n    FROM sorafenib_targets st\n    WHERE EXISTS (SELECT 1 FROM all_pathway_genes apg WHERE apg.\"uniprot_id\" = st.uniprot_id)\n),\n\n-- Step 5: Get lowest-level pathways\nlowest_level_pathways AS (\n    SELECT p.\"stable_id\", p.\"name\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" p\n    WHERE p.\"lowest_level\" = TRUE AND p.\"species\" = 'Homo sapiens'\n),\n\n-- Step 6: For each pathway, count genes in pathway and targets in pathway\npathway_stats AS (\n    SELECT \n        llp.\"stable_id\" AS pathway_id,\n        llp.\"name\" AS pathway_name,\n        COUNT(DISTINCT apg.\"uniprot_id\") AS genes_in_pathway,\n        COUNT(DISTINCT CASE WHEN st.uniprot_id IS NOT NULL THEN apg.\"uniprot_id\" END) AS targets_in_pathway\n    FROM lowest_level_pathways llp\n    JOIN all_pathway_genes apg ON apg.\"pathway_stable_id\" = llp.\"stable_id\"\n    LEFT JOIN sorafenib_targets st ON apg.\"uniprot_id\" = st.uniprot_id\n    GROUP BY llp.\"stable_id\", llp.\"name\"\n),\n\n-- Step 7: Build 2x2 contingency table and compute chi-squared\nchi_sq AS (\n    SELECT \n        ps.pathway_id,\n        ps.pathway_name,\n        ps.targets_in_pathway AS a,\n        tt.total_target_count - ps.targets_in_pathway AS b,\n        ps.genes_in_pathway - ps.targets_in_pathway AS c,\n        (tu.total_genes - ps.genes_in_pathway) - (tt.total_target_count - ps.targets_in_pathway) AS d,\n        tu.total_genes AS n\n    FROM pathway_stats ps\n    CROSS JOIN total_universe tu\n    CROSS JOIN total_targets tt\n)\n\nSELECT \n    pathway_id AS \"PATHWAY_ID\",\n    pathway_name AS \"PATHWAY_NAME\",\n    a AS \"TARGETS_IN_PATHWAY\",\n    b AS \"TARGETS_OUTSIDE_PATHWAY\",\n    c AS \"NONTARGETS_IN_PATHWAY\",\n    d AS \"NONTARGETS_OUTSIDE_PATHWAY\",\n    ROUND(\n        (n * POWER((a * d) - (b * c), 2))::FLOAT / \n        (NULLIF((a + b) * (c + d) * (a + c) * (b + d), 0))::FLOAT\n    , 4) AS \"CHI_SQUARED\"\nFROM chi_sq\nWHERE a > 0  -- only pathways that have at least one target\nORDER BY \"CHI_SQUARED\" DESC\nLIMIT 3;" := by
  first | sql_equiv | sorry

theorem eq_1_2 : ∀ t,
    (sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH sorafenib_targets AS (\n    SELECT DISTINCT i.\"target_uniprotID\"\n    FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" i\n    JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" e ON i.\"expID\" = e.\"expID\"\n    WHERE i.\"drugName\" = 'Sorafenib Tosylate'\n      AND i.\"targetSpecies\" = 'Homo sapiens'\n      AND e.\"exp_assayValueMedian\" <= 100\n),\nreactome_universe AS (\n    SELECT DISTINCT pe.\"uniprot_id\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" p2p ON pe.\"stable_id\" = p2p.\"pe_stable_id\"\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw ON p2p.\"pathway_stable_id\" = pw.\"stable_id\"\n    WHERE pw.\"species\" = 'Homo sapiens'\n      AND pw.\"lowest_level\" = TRUE\n      AND p2p.\"evidence_code\" = 'TAS'\n),\ntotal_counts AS (\n    SELECT\n        COUNT(DISTINCT ru.\"uniprot_id\") AS total_proteins,\n        COUNT(DISTINCT CASE WHEN st.\"target_uniprotID\" IS NOT NULL THEN ru.\"uniprot_id\" END) AS total_targets\n    FROM reactome_universe ru\n    LEFT JOIN sorafenib_targets st ON ru.\"uniprot_id\" = st.\"target_uniprotID\"\n),\npathway_proteins AS (\n    SELECT\n        pw.\"stable_id\" AS pathway_id,\n        pw.\"name\" AS pathway_name,\n        pe.\"uniprot_id\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" p2p ON pe.\"stable_id\" = p2p.\"pe_stable_id\"\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" pw ON p2p.\"pathway_stable_id\" = pw.\"stable_id\"\n    WHERE pw.\"species\" = 'Homo sapiens'\n      AND pw.\"lowest_level\" = TRUE\n      AND p2p.\"evidence_code\" = 'TAS'\n),\npathway_counts AS (\n    SELECT\n        pp.pathway_id,\n        pp.pathway_name,\n        COUNT(DISTINCT CASE WHEN st.\"target_uniprotID\" IS NOT NULL THEN pp.\"uniprot_id\" END) AS a,\n        COUNT(DISTINCT pp.\"uniprot_id\") AS proteins_in_pathway\n    FROM pathway_proteins pp\n    LEFT JOIN sorafenib_targets st ON pp.\"uniprot_id\" = st.\"target_uniprotID\"\n    GROUP BY pp.pathway_id, pp.pathway_name\n),\nchi_squared AS (\n    SELECT\n        pc.pathway_id,\n        pc.pathway_name,\n        pc.a AS TARGETS_IN_PATHWAY,\n        (tc.total_targets - pc.a) AS TARGETS_OUTSIDE_PATHWAY,\n        (pc.proteins_in_pathway - pc.a) AS NONTARGETS_IN_PATHWAY,\n        (tc.total_proteins - tc.total_targets - pc.proteins_in_pathway + pc.a) AS NONTARGETS_OUTSIDE_PATHWAY,\n        tc.total_proteins AS N,\n        pc.a AS cell_a,\n        (tc.total_targets - pc.a) AS cell_b,\n        (pc.proteins_in_pathway - pc.a) AS cell_c,\n        (tc.total_proteins - tc.total_targets - pc.proteins_in_pathway + pc.a) AS cell_d\n    FROM pathway_counts pc\n    CROSS JOIN total_counts tc\n)\nSELECT\n    pathway_id,\n    pathway_name,\n    TARGETS_IN_PATHWAY,\n    TARGETS_OUTSIDE_PATHWAY,\n    NONTARGETS_IN_PATHWAY,\n    NONTARGETS_OUTSIDE_PATHWAY,\n    ROUND(\n        (N * POWER(cell_a * cell_d - cell_b * cell_c, 2)) /\n        ((cell_a + cell_b) * (cell_c + cell_d) * (cell_a + cell_c) * (cell_b + cell_d)),\n        2\n    ) AS CHI_SQUARED\nFROM chi_squared\nWHERE TARGETS_IN_PATHWAY > 0\nORDER BY CHI_SQUARED DESC\nLIMIT 3") t ~= (sql%([PE_TO_PATHWAY_V77_schema, PATHWAY_V77_schema, PHYSICAL_ENTITY_V77_schema, EXPERIMENTS_V1_schema, INTERACTIONS_V1_schema]) "WITH \n-- Step 1: Get sorafenib targets (Homo sapiens) that pass assay filters\nsorafenib_targets AS (\n    SELECT DISTINCT i.\"target_uniprotID\" AS uniprot_id\n    FROM \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"INTERACTIONS_V1\" i\n    JOIN \"TARGETOME_REACTOME\".\"TARGETOME_VERSIONED\".\"EXPERIMENTS_V1\" e \n        ON i.\"expID\" = e.\"expID\"\n    WHERE LOWER(i.\"drugName\") LIKE '%sorafenib%'\n      AND i.\"targetSpecies\" = 'Homo sapiens'\n      AND e.\"exp_assayValueMedian\" <= 100\n      AND (e.\"exp_assayValueLow\" <= 100 OR e.\"exp_assayValueLow\" IS NULL)\n      AND (e.\"exp_assayValueHigh\" <= 100 OR e.\"exp_assayValueHigh\" IS NULL)\n),\n\n-- Step 2: Get all unique proteins (uniprot_id) that appear in lowest-level Homo sapiens pathways with TAS evidence\nall_pathway_genes AS (\n    SELECT DISTINCT pe.\"uniprot_id\", ptp.\"pathway_stable_id\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PHYSICAL_ENTITY_V77\" pe\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PE_TO_PATHWAY_V77\" ptp \n        ON pe.\"stable_id\" = ptp.\"pe_stable_id\"\n    JOIN \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" p \n        ON ptp.\"pathway_stable_id\" = p.\"stable_id\"\n    WHERE ptp.\"evidence_code\" = 'TAS' \n      AND p.\"lowest_level\" = TRUE \n      AND p.\"species\" = 'Homo sapiens'\n),\n\n-- Step 3: Get the total universe of unique proteins across all TAS lowest-level pathways\ntotal_universe AS (\n    SELECT COUNT(DISTINCT \"uniprot_id\") AS total_genes\n    FROM all_pathway_genes\n),\n\n-- Step 4: Count total sorafenib targets (that are in the universe)\ntotal_targets AS (\n    SELECT COUNT(DISTINCT st.uniprot_id) AS total_target_count\n    FROM sorafenib_targets st\n    WHERE EXISTS (SELECT 1 FROM all_pathway_genes apg WHERE apg.\"uniprot_id\" = st.uniprot_id)\n),\n\n-- Step 5: Get lowest-level pathways\nlowest_level_pathways AS (\n    SELECT p.\"stable_id\", p.\"name\"\n    FROM \"TARGETOME_REACTOME\".\"REACTOME_VERSIONED\".\"PATHWAY_V77\" p\n    WHERE p.\"lowest_level\" = TRUE AND p.\"species\" = 'Homo sapiens'\n),\n\n-- Step 6: For each pathway, count genes in pathway and targets in pathway\npathway_stats AS (\n    SELECT \n        llp.\"stable_id\" AS pathway_id,\n        llp.\"name\" AS pathway_name,\n        COUNT(DISTINCT apg.\"uniprot_id\") AS genes_in_pathway,\n        COUNT(DISTINCT CASE WHEN st.uniprot_id IS NOT NULL THEN apg.\"uniprot_id\" END) AS targets_in_pathway\n    FROM lowest_level_pathways llp\n    JOIN all_pathway_genes apg ON apg.\"pathway_stable_id\" = llp.\"stable_id\"\n    LEFT JOIN sorafenib_targets st ON apg.\"uniprot_id\" = st.uniprot_id\n    GROUP BY llp.\"stable_id\", llp.\"name\"\n),\n\n-- Step 7: Build 2x2 contingency table and compute chi-squared\nchi_sq AS (\n    SELECT \n        ps.pathway_id,\n        ps.pathway_name,\n        ps.targets_in_pathway AS a,\n        tt.total_target_count - ps.targets_in_pathway AS b,\n        ps.genes_in_pathway - ps.targets_in_pathway AS c,\n        (tu.total_genes - ps.genes_in_pathway) - (tt.total_target_count - ps.targets_in_pathway) AS d,\n        tu.total_genes AS n\n    FROM pathway_stats ps\n    CROSS JOIN total_universe tu\n    CROSS JOIN total_targets tt\n)\n\nSELECT \n    pathway_id AS \"PATHWAY_ID\",\n    pathway_name AS \"PATHWAY_NAME\",\n    a AS \"TARGETS_IN_PATHWAY\",\n    b AS \"TARGETS_OUTSIDE_PATHWAY\",\n    c AS \"NONTARGETS_IN_PATHWAY\",\n    d AS \"NONTARGETS_OUTSIDE_PATHWAY\",\n    ROUND(\n        (n * POWER((a * d) - (b * c), 2))::FLOAT / \n        (NULLIF((a + b) * (c + d) * (a + c) * (b + d), 0))::FLOAT\n    , 4) AS \"CHI_SQUARED\"\nFROM chi_sq\nWHERE a > 0  -- only pathways that have at least one target\nORDER BY \"CHI_SQUARED\" DESC\nLIMIT 3;") t := by
