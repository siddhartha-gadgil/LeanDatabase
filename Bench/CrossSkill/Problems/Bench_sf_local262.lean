n),\nproblem_counts AS (\n    SELECT \"name\" AS problem, COUNT(*) AS qualifying_count\n    FROM qualifying\n    WHERE \"step\" IN (1, 2, 3)\n    GROUP BY \"name\"\n),\nsolution_counts AS (\n    SELECT \"name\", COUNT(*) AS solution_count\n    FROM \"STACKING\".\"STACKING\".\"SOLUTION\"\n    GROUP BY \"name\"\n)\nSELECT pc.problem\nFROM problem_counts pc\nJOIN solution_counts sc ON pc.problem = sc.\"name\"\nWHERE pc.qualifying_count > sc.solution_count\nORDER BY pc.problem;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_3 : ∀ t,
