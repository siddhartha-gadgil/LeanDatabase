theorem eq (t0 : TableRel DEATHRECORDS_schema) (t1 : TableRel AGERECODE12_schema) (t2 : TableRel RACE_schema) (t3 : TableRel ICD10CODE_schema) :
    (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_codes AS (SELECT \"Code\" FROM \"DEATH\".\"DEATH\".\"ICD10CODE\" WHERE LOWER(\"Description\") LIKE '%discharge%' AND NOT \"Description\" LIKE '%Urethral discharge%' AND NOT \"Description\" LIKE '%Discharge of firework%' AND NOT \"Description\" LIKE '%Legal intervention involving firearm discharge%'), vehicle_codes AS (SELECT \"Code\" FROM \"DEATH\".\"DEATH\".\"ICD10CODE\" WHERE LOWER(\"Description\") LIKE '%vehicle%'), discharge_deaths AS (SELECT d.\"AgeRecode12\", d.\"Icd10Code\", COUNT(*) AS death_count FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN discharge_codes AS dc ON d.\"Icd10Code\" = dc.\"Code\" WHERE d.\"Race\" = 1 GROUP BY d.\"AgeRecode12\", d.\"Icd10Code\"), vehicle_deaths AS (SELECT d.\"AgeRecode12\", d.\"Icd10Code\", COUNT(*) AS death_count FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN vehicle_codes AS vc ON d.\"Icd10Code\" = vc.\"Code\" WHERE d.\"Race\" = 1 GROUP BY d.\"AgeRecode12\", d.\"Icd10Code\"), avg_discharge AS (SELECT \"AgeRecode12\", AVG(death_count) AS avg_deaths FROM discharge_deaths GROUP BY \"AgeRecode12\"), avg_vehicle AS (SELECT \"AgeRecode12\", AVG(death_count) AS avg_deaths FROM vehicle_deaths GROUP BY \"AgeRecode12\") SELECT ar.\"Description\" AS \"Age Group\", COALESCE(ad.avg_deaths, 0) AS \"Avg Deaths - Discharge Codes\", COALESCE(av.avg_deaths, 0) AS \"Avg Deaths - Vehicle Codes\", COALESCE(ad.avg_deaths, 0) - COALESCE(av.avg_deaths, 0) AS \"Difference (Discharge - Vehicle)\" FROM \"DEATH\".\"DEATH\".\"AGERECODE12\" AS ar LEFT JOIN avg_discharge AS ad ON ar.\"Code\" = ad.\"AgeRecode12\" LEFT JOIN avg_vehicle AS av ON ar.\"Code\" = av.\"AgeRecode12\" ORDER BY ar.\"Code\"") t0 t1 t2 t3
  ~= (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_by_age_code AS (SELECT ar.\"Description\" AS age_group, ar.\"Code\" AS age_code, icd.\"Code\" AS icd_code, COUNT(*) AS death_count FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS dr JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS icd ON dr.\"Icd10Code\" = icd.\"Code\" JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" AS ar ON dr.\"AgeRecode12\" = ar.\"Code\" WHERE dr.\"Race\" = 1 AND LOWER(icd.\"Description\") LIKE '%discharge%' AND NOT icd.\"Description\" LIKE '%Urethral discharge%' AND NOT icd.\"Description\" LIKE '%Discharge of firework%' AND NOT icd.\"Description\" LIKE '%Legal intervention involving firearm discharge%' GROUP BY ar.\"Description\", ar.\"Code\", icd.\"Code\"), vehicle_by_age_code AS (SELECT ar.\"Description\" AS age_group, ar.\"Code\" AS age_code, icd.\"Code\" AS icd_code, COUNT(*) AS death_count FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS dr JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS icd ON dr.\"Icd10Code\" = icd.\"Code\" JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" AS ar ON dr.\"AgeRecode12\" = ar.\"Code\" WHERE dr.\"Race\" = 1 AND LOWER(icd.\"Description\") LIKE '%vehicle%' GROUP BY ar.\"Description\", ar.\"Code\", icd.\"Code\"), discharge_avg AS (SELECT age_group, age_code, AVG(death_count) AS avg_deaths_discharge FROM discharge_by_age_code GROUP BY age_group, age_code), vehicle_avg AS (SELECT age_group, age_code, AVG(death_count) AS avg_deaths_vehicle FROM vehicle_by_age_code GROUP BY age_group, age_code) SELECT COALESCE(d.age_group, v.age_group) AS \"Age Group\", ROUND(d.avg_deaths_discharge, 6) AS \"Avg Deaths - Discharge Codes\", ROUND(v.avg_deaths_vehicle, 6) AS \"Avg Deaths - Vehicle Codes\", ROUND(d.avg_deaths_discharge - v.avg_deaths_vehicle, 6) AS \"Difference (Discharge - Vehicle)\" FROM discharge_avg AS d FULL OUTER JOIN vehicle_avg AS v ON d.age_code = v.age_code ORDER BY COALESCE(d.age_code, v.age_code)") t0 t1 t2 t3
