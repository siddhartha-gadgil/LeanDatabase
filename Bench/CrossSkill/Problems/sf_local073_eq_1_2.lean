namespace N_sf_local073_eq_1_2

CREATE TABLE PIZZA_NAMES («pizza_id» INT, «pizza_name» STRING)
CREATE TABLE PIZZA_RECIPES («pizza_id» INT, «toppings» STRING)
CREATE TABLE PIZZA_CLEAN_CUSTOMER_ORDERS («order_id» INT, «customer_id» INT, «pizza_id» INT, «exclusions» STRING, «extras» STRING, «order_time» STRING)
CREATE TABLE PIZZA_TOPPINGS («topping_id» INT, «topping_name» STRING)

theorem eq (t0 : TableRel PIZZA_NAMES_schema) (t1 : TableRel PIZZA_RECIPES_schema) (t2 : TableRel PIZZA_CLEAN_CUSTOMER_ORDERS_schema) (t3 : TableRel PIZZA_TOPPINGS_schema) :
    (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH customer_orders AS (SELECT ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"), recipe_toppings /* Split recipe toppings into individual rows */ AS (SELECT r.\"pizza_id\", CAST(TRIM(CAST(t.VALUE AS TEXT)) AS INT) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" AS r, LATERAL UNNEST(INPUT => SPLIT(r.\"toppings\", ',')) AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS)), order_base_toppings /* For each order row, get base toppings from recipe */ AS (SELECT co.row_id, co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\", co.\"order_time\", rt.topping_id, 1 AS topping_count FROM customer_orders AS co JOIN recipe_toppings AS rt ON co.\"pizza_id\" = rt.\"pizza_id\"), order_exclusions /* Parse exclusions per order row */ AS (SELECT co.row_id, CAST(TRIM(CAST(e.VALUE AS TEXT)) AS INT) AS excluded_topping_id FROM customer_orders AS co, LATERAL UNNEST(INPUT => SPLIT(co.\"exclusions\", ','), OUTER => TRUE) AS e(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT co.\"exclusions\" IS NULL AND co.\"exclusions\" <> ''), order_extras /* Parse extras per order row */ AS (SELECT co.row_id, CAST(TRIM(CAST(x.VALUE AS TEXT)) AS INT) AS extra_topping_id FROM customer_orders AS co, LATERAL UNNEST(INPUT => SPLIT(co.\"extras\", ','), OUTER => TRUE) AS x(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT co.\"extras\" IS NULL AND co.\"extras\" <> ''), base_minus_exclusions /* Remove exclusions from base toppings */ AS (SELECT obt.row_id, obt.\"order_id\", obt.\"customer_id\", obt.\"pizza_id\", obt.\"exclusions\", obt.\"extras\", obt.\"order_time\", obt.topping_id, obt.topping_count FROM order_base_toppings AS obt LEFT JOIN order_exclusions AS oe ON obt.row_id = oe.row_id AND obt.topping_id = oe.excluded_topping_id WHERE oe.excluded_topping_id IS NULL), all_toppings /* Combine base toppings (minus exclusions) with extras */ /* Extras that are already in base get counted as additional */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\", topping_id, topping_count FROM base_minus_exclusions UNION ALL SELECT ox.row_id, co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\", co.\"order_time\", ox.extra_topping_id AS topping_id, 1 AS topping_count FROM order_extras AS ox JOIN customer_orders AS co ON ox.row_id = co.row_id), topping_counts /* Aggregate topping counts per order row */ AS (SELECT at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"exclusions\", at2.\"extras\", at2.\"order_time\", at2.topping_id, SUM(at2.topping_count) AS total_count FROM all_toppings AS at2 GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"exclusions\", at2.\"extras\", at2.\"order_time\", at2.topping_id), formatted_toppings /* Join with topping names and format */ AS (SELECT tc.row_id, tc.\"order_id\", tc.\"customer_id\", tc.\"pizza_id\", tc.\"exclusions\", tc.\"extras\", tc.\"order_time\", tc.topping_id, tc.total_count, pt.\"topping_name\", CASE WHEN tc.total_count > 1 THEN '2x ' || pt.\"topping_name\" ELSE pt.\"topping_name\" END AS formatted_topping, CASE WHEN tc.total_count > 1 THEN 0 ELSE 1 END AS sort_group FROM topping_counts AS tc JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS pt ON tc.topping_id = pt.\"topping_id\"), ingredient_list /* Build sorted ingredient list using LISTAGG */ AS (SELECT ft.row_id, ft.\"order_id\", ft.\"customer_id\", pn.\"pizza_name\" AS PIZZA_NAME, STRING_AGG(ft.formatted_topping, ', ' ORDER BY ft.sort_group, ft.\"topping_name\") AS ingredients FROM formatted_toppings AS ft JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" AS pn ON ft.\"pizza_id\" = pn.\"pizza_id\" GROUP BY ft.row_id, ft.\"order_id\", ft.\"customer_id\", ft.\"pizza_id\", pn.\"pizza_name\", ft.\"order_time\") SELECT il.row_id AS ROW_ID, il.\"order_id\" AS ORDER_ID, il.\"customer_id\" AS CUSTOMER_ID, il.PIZZA_NAME, il.PIZZA_NAME || ': ' || il.ingredients AS FINAL_INGREDIENTS FROM ingredient_list AS il ORDER BY il.row_id") t0 t1 t2 t3
  = (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (SELECT ROW_NUMBER() OVER (ORDER BY \"order_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"), recipe_flat /* Flatten the recipe toppings for each pizza */ AS (SELECT \"pizza_id\", TRIM(CAST(t.VALUE AS TEXT)) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\", LATERAL SPLIT_TO_TABLE(\"toppings\", ',') AS t), order_base_toppings /* For each order row, get base toppings from recipe */ AS (SELECT o.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", o.\"exclusions\", o.\"extras\", o.\"order_time\", CAST(r.topping_id AS DECIMAL(38, 0)) AS topping_id FROM numbered_orders AS o JOIN recipe_flat AS r ON o.\"pizza_id\" = r.\"pizza_id\"), exclusions_flat /* Parse exclusions per order row */ AS (SELECT o.row_id, CAST(TRIM(CAST(e.VALUE AS TEXT)) AS DECIMAL(38, 0)) AS excluded_topping_id FROM numbered_orders AS o, LATERAL SPLIT_TO_TABLE(CASE WHEN NOT o.\"exclusions\" IS NULL AND o.\"exclusions\" <> '' THEN o.\"exclusions\" ELSE NULL END, ',') AS e WHERE NOT o.\"exclusions\" IS NULL AND o.\"exclusions\" <> ''), extras_flat /* Parse extras per order row */ AS (SELECT o.row_id, CAST(TRIM(CAST(x.VALUE AS TEXT)) AS DECIMAL(38, 0)) AS extra_topping_id FROM numbered_orders AS o, LATERAL SPLIT_TO_TABLE(CASE WHEN NOT o.\"extras\" IS NULL AND o.\"extras\" <> '' THEN o.\"extras\" ELSE NULL END, ',') AS x WHERE NOT o.\"extras\" IS NULL AND o.\"extras\" <> ''), base_after_exclusions /* Remove excluded toppings from base */ AS (SELECT bt.row_id, bt.\"order_id\", bt.\"customer_id\", bt.\"pizza_id\", bt.\"order_time\", bt.topping_id FROM order_base_toppings AS bt LEFT JOIN exclusions_flat AS ef ON bt.row_id = ef.row_id AND bt.topping_id = ef.excluded_topping_id WHERE ef.excluded_topping_id IS NULL), all_toppings /* Combine base toppings (after exclusions) and extras */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", topping_id, 'base' AS source FROM base_after_exclusions UNION ALL SELECT ef.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", o.\"order_time\", ef.extra_topping_id AS topping_id, 'extra' AS source FROM extras_flat AS ef JOIN numbered_orders AS o ON ef.row_id = o.row_id), topping_counts /* Count occurrences per topping per order row */ AS (SELECT at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"order_time\", at2.topping_id, t.\"topping_name\", COUNT(*) AS cnt FROM all_toppings AS at2 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON at2.topping_id = t.\"topping_id\" GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"order_time\", at2.topping_id, t.\"topping_name\"), formatted_toppings /* Format each topping with 2x prefix if needed, and add sort keys */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", CASE WHEN cnt > 1 THEN cnt || 'x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name, cnt, \"topping_name\" FROM topping_counts), ordered_toppings /* Order toppings: 2x first (alphabetically), then single (alphabetically) */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", formatted_name, ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY CASE WHEN cnt > 1 THEN 0 ELSE 1 END, \"topping_name\") AS rn FROM formatted_toppings), aggregated /* Aggregate into comma-separated string */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", STRING_AGG(formatted_name, ', ' ORDER BY CASE WHEN rn = rn THEN 0 END, rn) AS ingredients_list FROM ordered_toppings GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\") SELECT a.row_id AS \"ROW_ID\", a.\"order_id\" AS \"ORDER_ID\", a.\"customer_id\" AS \"CUSTOMER_ID\", CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END AS \"PIZZA_NAME\", CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END || ': ' || a.ingredients_list AS \"FINAL_INGREDIENTS\" FROM aggregated AS a ORDER BY a.row_id") t0 t1 t2 t3
