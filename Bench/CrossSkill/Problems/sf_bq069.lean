theorem eq_0_1 (t : TableRel DICOM_ALL_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) (h3 : hyp0_1_3 t) :
    (sql%([DICOM_ALL_schema]) "WITH series_all AS (SELECT \"SeriesInstanceUID\", \"SeriesNumber\", \"StudyInstanceUID\", \"PatientID\", \"SOPInstanceUID\", \"ImageOrientationPatient\", \"PixelSpacing\", \"ImagePositionPatient\", \"Rows\", \"Columns\", \"SliceThickness\", \"Exposure\", \"instance_size\", CAST(CAST(\"ImageOrientationPatient\" AS JSON)[0] AS DOUBLE PRECISION) AS iop0, CAST(CAST(\"ImageOrientationPatient\" AS JSON)[1] AS DOUBLE PRECISION) AS iop1, CAST(CAST(\"ImageOrientationPatient\" AS JSON)[3] AS DOUBLE PRECISION) AS iop3, CAST(CAST(\"ImageOrientationPatient\" AS JSON)[4] AS DOUBLE PRECISION) AS iop4, CAST(CAST(\"ImagePositionPatient\" AS JSON)[2] AS DOUBLE PRECISION) AS z_position, CAST(CAST(\"ImagePositionPatient\" AS JSON)[0] AS TEXT) || ',' || CAST(CAST(\"ImagePositionPatient\" AS JSON)[1] AS TEXT) AS xy_pos FROM \"IDC\".\"IDC_V17\".\"DICOM_ALL\" WHERE \"Modality\" = 'CT' AND \"collection_id\" <> 'nlst' AND NOT \"ImageType\" LIKE '%LOCALIZER%' AND NOT \"TransferSyntaxUID\" IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51') AND NOT \"ImagePositionPatient\" IS NULL AND NOT \"ImageOrientationPatient\" IS NULL AND NOT \"PixelSpacing\" IS NULL), geometry AS (SELECT \"SeriesInstanceUID\", MAX(\"SeriesNumber\") AS \"SERIES_NUMBER\", MAX(\"StudyInstanceUID\") AS \"STUDY_INSTANCE_UID\", MAX(\"PatientID\") AS \"PATIENT_ID\", MAX(iop0 * iop4 - iop1 * iop3) AS \"MAX_DOT_PRODUCT\", COUNT(DISTINCT \"SOPInstanceUID\") AS \"SOP_INSTANCE_COUNT\", COUNT(DISTINCT \"SliceThickness\") AS \"DISTINCT_SLICE_THICKNESS_COUNT\", COUNT(DISTINCT \"Exposure\") AS \"DISTINCT_EXPOSURE_COUNT\", MAX(CAST(\"Exposure\" AS DOUBLE PRECISION)) AS \"MAX_EXPOSURE\", MIN(CAST(\"Exposure\" AS DOUBLE PRECISION)) AS \"MIN_EXPOSURE\", CAST(SUM(\"instance_size\") AS DOUBLE PRECISION) / (1024 * 1024) AS \"SERIES_SIZE_MIB\" FROM series_all GROUP BY \"SeriesInstanceUID\" HAVING COUNT(DISTINCT \"ImageOrientationPatient\") = 1 AND COUNT(DISTINCT \"PixelSpacing\") = 1 AND CAST(COUNT(DISTINCT \"SOPInstanceUID\") AS VARCHAR) = CAST(COUNT(DISTINCT \"ImagePositionPatient\") AS VARCHAR) AND COUNT(DISTINCT \"Rows\") = 1 AND COUNT(DISTINCT \"Columns\") = 1 AND ABS(1.0 - MAX(iop0 * iop4 - iop1 * iop3)) < 0.01 AND COUNT(DISTINCT xy_pos) = 1), z_ordered AS (SELECT sa.\"SeriesInstanceUID\", sa.z_position, sa.z_position - LAG(sa.z_position) OVER (PARTITION BY sa.\"SeriesInstanceUID\" ORDER BY sa.z_position) AS z_diff FROM series_all AS sa INNER JOIN geometry AS g ON sa.\"SeriesInstanceUID\" = g.\"SeriesInstanceUID\"), z_stats AS (SELECT \"SeriesInstanceUID\", MAX(z_diff) AS \"MAX_SLICE_INTERVAL_DIFF\", MIN(z_diff) AS \"MIN_SLICE_INTERVAL_DIFF\", MAX(z_diff) - MIN(z_diff) AS \"SLICE_INTERVAL_TOLERANCE\" FROM z_ordered WHERE NOT z_diff IS NULL GROUP BY \"SeriesInstanceUID\") SELECT g.\"SeriesInstanceUID\" AS \"SERIES_INSTANCE_UID\", g.\"SERIES_NUMBER\", g.\"STUDY_INSTANCE_UID\", g.\"PATIENT_ID\", g.\"MAX_DOT_PRODUCT\", g.\"SOP_INSTANCE_COUNT\", g.\"DISTINCT_SLICE_THICKNESS_COUNT\", z.\"MAX_SLICE_INTERVAL_DIFF\", z.\"MIN_SLICE_INTERVAL_DIFF\", z.\"SLICE_INTERVAL_TOLERANCE\", g.\"DISTINCT_EXPOSURE_COUNT\", g.\"MAX_EXPOSURE\", g.\"MIN_EXPOSURE\", g.\"MAX_EXPOSURE\" - g.\"MIN_EXPOSURE\" AS \"EXPOSURE_RANGE\", g.\"SERIES_SIZE_MIB\" FROM geometry AS g LEFT JOIN z_stats AS z ON g.\"SeriesInstanceUID\" = z.\"SeriesInstanceUID\" ORDER BY z.\"SLICE_INTERVAL_TOLERANCE\" DESC, (g.\"MAX_EXPOSURE\" - g.\"MIN_EXPOSURE\") DESC, g.\"SeriesInstanceUID\" DESC") t ~= (sql%([DICOM_ALL_schema]) "/* Step 1: Filter instances at instance level, compute z-coordinate and dot product */ WITH filtered_instances AS (SELECT \"SeriesInstanceUID\", \"SeriesNumber\", \"StudyInstanceUID\", \"PatientID\", \"SOPInstanceUID\", \"ImageOrientationPatient\", \"PixelSpacing\", \"ImagePositionPatient\", \"Rows\", \"Columns\", \"Exposure\", \"SliceThickness\", \"instance_size\", (CAST(\"ImageOrientationPatient\"[1] AS DOUBLE PRECISION) * CAST(\"ImageOrientationPatient\"[5] AS DOUBLE PRECISION) - CAST(\"ImageOrientationPatient\"[2] AS DOUBLE PRECISION) * CAST(\"ImageOrientationPatient\"[4] AS DOUBLE PRECISION)) AS dot_product /* dot product: z-component of cross product of row vector and col vector with [0,0,1] */ /* Cross product of [IOP0,IOP1,IOP2] x [IOP3,IOP4,IOP5]: */ /*   z-component = IOP0*IOP4 - IOP1*IOP3 */, CAST(\"ImagePositionPatient\"[3] AS DOUBLE PRECISION) AS z_coord FROM \"IDC\".\"IDC_V17\".\"DICOM_ALL\" WHERE \"Modality\" = 'CT' AND \"collection_id\" <> 'nlst' AND NOT CASE WHEN CAST('LOCALIZER' AS VARIANT) IS NULL THEN NULL ELSE COALESCE(CAST('LOCALIZER' AS VARIANT) = ANY(\"ImageType\"), FALSE) END AND NOT \"TransferSyntaxUID\" IN ('1.2.840.10008.1.2.4.70', '1.2.840.10008.1.2.4.51')), z_diffs /* Step 2: Compute z-ordered consecutive differences using LEAD window function */ AS (SELECT \"SeriesInstanceUID\", \"SOPInstanceUID\", z_coord, dot_product, \"SeriesNumber\", \"StudyInstanceUID\", \"PatientID\", \"Exposure\", \"SliceThickness\", \"instance_size\", \"ImageOrientationPatient\", \"PixelSpacing\", \"ImagePositionPatient\", \"Rows\", \"Columns\", LEAD(z_coord) OVER (PARTITION BY \"SeriesInstanceUID\" ORDER BY z_coord) - z_coord AS slice_interval FROM filtered_instances), series_agg /* Step 3: Aggregate at series level with all geometry/consistency checks */ AS (SELECT \"SeriesInstanceUID\", MAX(CAST(\"SeriesNumber\" AS DECIMAL(38, 0))) AS SERIES_NUMBER, MAX(\"StudyInstanceUID\") AS STUDY_INSTANCE_UID, MAX(\"PatientID\") AS PATIENT_ID, MAX(dot_product) AS MAX_DOT_PRODUCT, COUNT(DISTINCT \"SOPInstanceUID\") AS SOP_INSTANCE_COUNT, COUNT(DISTINCT \"SliceThickness\") AS DISTINCT_SLICE_THICKNESS_COUNT, MAX(slice_interval) AS MAX_SLICE_INTERVAL_DIFF, MIN(slice_interval) AS MIN_SLICE_INTERVAL_DIFF, MAX(slice_interval) - MIN(slice_interval) AS SLICE_INTERVAL_TOLERANCE, COUNT(DISTINCT \"Exposure\") AS DISTINCT_EXPOSURE_COUNT, MAX(CAST(\"Exposure\" AS DOUBLE PRECISION)) AS MAX_EXPOSURE, MIN(CAST(\"Exposure\" AS DOUBLE PRECISION)) AS MIN_EXPOSURE, MAX(CAST(\"Exposure\" AS DOUBLE PRECISION)) - MIN(CAST(\"Exposure\" AS DOUBLE PRECISION)) AS EXPOSURE_RANGE, CAST(SUM(\"instance_size\") AS DOUBLE PRECISION) / (1024.0 * 1024.0) AS SERIES_SIZE_MIB, COUNT(DISTINCT CAST(\"ImageOrientationPatient\" AS VARCHAR)) AS distinct_iop /* For HAVING checks */, COUNT(DISTINCT CAST(\"PixelSpacing\" AS VARCHAR)) AS distinct_ps, COUNT(DISTINCT CAST(\"ImagePositionPatient\" AS VARCHAR)) AS distinct_ipp, COUNT(DISTINCT CAST(\"ImagePositionPatient\"[1] AS VARCHAR)) AS distinct_ipp_x, COUNT(DISTINCT CAST(\"ImagePositionPatient\"[2] AS VARCHAR)) AS distinct_ipp_y, COUNT(DISTINCT \"Rows\") AS distinct_rows, COUNT(DISTINCT \"Columns\") AS distinct_cols FROM z_diffs GROUP BY \"SeriesInstanceUID\" HAVING distinct_iop /* Single image orientation across series */ = 1 AND /* Identical pixel spacing across series */ distinct_ps = 1 AND /* SOP count = distinct position count (no duplicate positions) */ SOP_INSTANCE_COUNT = distinct_ipp AND /* Identical first two IPP components (x, y constant) */ distinct_ipp_x = 1 AND distinct_ipp_y = 1 AND /* Uniform rows and columns */ distinct_rows = 1 AND distinct_cols = 1 AND /* Near-unity dot product (axial orientation check) */ MAX_DOT_PRODUCT BETWEEN 0.99 AND 1.01) SELECT \"SeriesInstanceUID\" AS SERIES_INSTANCE_UID, SERIES_NUMBER, STUDY_INSTANCE_UID, PATIENT_ID, MAX_DOT_PRODUCT, SOP_INSTANCE_COUNT, DISTINCT_SLICE_THICKNESS_COUNT, MAX_SLICE_INTERVAL_DIFF, MIN_SLICE_INTERVAL_DIFF, SLICE_INTERVAL_TOLERANCE, DISTINCT_EXPOSURE_COUNT, MAX_EXPOSURE, MIN_EXPOSURE, EXPOSURE_RANGE, SERIES_SIZE_MIB FROM series_agg ORDER BY SLICE_INTERVAL_TOLERANCE DESC, EXPOSURE_RANGE DESC, \"SeriesInstanceUID\" DESC") t := by
  first | sql_equiv | sorry

