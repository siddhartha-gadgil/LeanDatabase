import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq262 — crossskill equivalence(s)

Question: Generate a monthly analysis report for e-commerce sales from June 2019 to December 2019 that includes, for each product category and each month, the total number of orders, total revenue, and total profit, along with their month-over-month growth rates using the data from June 2019 as the basis for calculating growth starting from July 2019. Ensure that all orders are included regardless of their status, and present the results sorted in ascending order by month (formatted as "2019-07") and then by product category. Omitting June 2019 from the final output but using it for the growth calculations.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq262

CREATE TABLE PRODUCTS («id» INT, «cost» FLOAT, «category» STRING, «name» STRING, «brand» STRING, «retail_price» FLOAT, «department» STRING, «sku» STRING, «distribution_center_id» INT)
CREATE TABLE ORDER_ITEMS («id» INT, «order_id» INT, «user_id» INT, «product_id» INT, «inventory_item_id» INT, «status» STRING, «created_at» INT, «shipped_at» INT, «delivered_at» INT, «returned_at» INT, «sale_price» FLOAT)

theorem eq_0_1 :
    sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_data AS (SELECT TO_CHAR(DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(oi.\"created_at\" AS DOUBLE PRECISION) / 1000000)), 'YYYY-MM') AS month, p.\"category\" AS product_category, COUNT(DISTINCT oi.\"order_id\") AS total_order, SUM(oi.\"sale_price\") AS total_revenue, SUM(oi.\"sale_price\" - p.\"cost\") AS total_profit FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" AS oi JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"id\" WHERE TO_TIMESTAMP(CAST(oi.\"created_at\" AS DOUBLE PRECISION) / 1000000) >= '2019-06-01' AND TO_TIMESTAMP(CAST(oi.\"created_at\" AS DOUBLE PRECISION) / 1000000) < '2020-01-01' GROUP BY month, p.\"category\"), with_growth AS (SELECT month, product_category, total_order, CAST((total_order - LAG(total_order) OVER (PARTITION BY product_category ORDER BY month)) AS DOUBLE PRECISION) / NULLIF(LAG(total_order) OVER (PARTITION BY product_category ORDER BY month), 0) * 100 AS order_growth, total_revenue, CAST((total_revenue - LAG(total_revenue) OVER (PARTITION BY product_category ORDER BY month)) AS DOUBLE PRECISION) / NULLIF(LAG(total_revenue) OVER (PARTITION BY product_category ORDER BY month), 0) * 100 AS revenue_growth, total_profit, CAST((total_profit - LAG(total_profit) OVER (PARTITION BY product_category ORDER BY month)) AS DOUBLE PRECISION) / NULLIF(LAG(total_profit) OVER (PARTITION BY product_category ORDER BY month), 0) * 100 AS profit_growth FROM monthly_data) SELECT month, product_category, total_order, order_growth, total_revenue, revenue_growth, total_profit, profit_growth FROM with_growth WHERE month >= '2019-07' ORDER BY month ASC, product_category ASC" = sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_category_stats AS (SELECT TO_CHAR(TO_TIMESTAMP(CAST(oi.\"created_at\" AS DOUBLE PRECISION) / 1000000), 'YYYY-MM') AS month, p.\"category\" AS product_category, COUNT(DISTINCT oi.\"order_id\") AS total_order, SUM(oi.\"sale_price\") AS total_revenue, SUM(oi.\"sale_price\" - p.\"cost\") AS total_profit FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" AS oi JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"id\" WHERE TO_TIMESTAMP(CAST(oi.\"created_at\" AS DOUBLE PRECISION) / 1000000) >= '2019-06-01' AND TO_TIMESTAMP(CAST(oi.\"created_at\" AS DOUBLE PRECISION) / 1000000) < '2020-01-01' GROUP BY month, p.\"category\"), with_lag AS (SELECT month, product_category, total_order, total_revenue, total_profit, LAG(total_order) OVER (PARTITION BY product_category ORDER BY month) AS prev_order, LAG(total_revenue) OVER (PARTITION BY product_category ORDER BY month) AS prev_revenue, LAG(total_profit) OVER (PARTITION BY product_category ORDER BY month) AS prev_profit FROM monthly_category_stats) SELECT month, product_category, total_order, CASE WHEN NOT prev_order IS NULL AND prev_order <> 0 THEN CAST((total_order - prev_order) * 100.0 AS DOUBLE PRECISION) / prev_order END AS order_growth, total_revenue, CASE WHEN NOT prev_revenue IS NULL AND prev_revenue <> 0 THEN CAST((total_revenue - prev_revenue) * 100.0 AS DOUBLE PRECISION) / prev_revenue END AS revenue_growth, total_profit, CASE WHEN NOT prev_profit IS NULL AND prev_profit <> 0 THEN CAST((total_profit - prev_profit) * 100.0 AS DOUBLE PRECISION) / prev_profit END AS profit_growth FROM with_lag WHERE month >= '2019-07' ORDER BY month, product_category" := by
  first | sql_equiv | sorry

