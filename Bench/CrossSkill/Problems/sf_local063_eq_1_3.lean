arter_sales END) AS SHARE_2019Q4, MAX(CASE WHEN b.\"calendar_quarter_id\" = 1776 THEN CAST(b.prod_sales AS DOUBLE PRECISION) / qt.total_quarter_sales END) AS SHARE_2020Q4, SUM(b.prod_sales) AS total_sales FROM base_sales AS b JOIN quarter_totals AS qt ON b.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\" GROUP BY b.\"prod_id\" HAVING NOT SHARE_2019Q4 IS NULL AND NOT SHARE_2020Q4 IS NULL), ranked AS (SELECT ps.\"prod_id\", p.\"prod_name\", ABS(ps.SHARE_2020Q4 - ps.SHARE_2019Q4) AS PP_CHANGE, ps.SHARE_2019Q4, ps.SHARE_2020Q4, PERCENT_RANK() OVER (ORDER BY ps.total_sales DESC) AS pct_rank FROM prod_shares AS ps JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON ps.\"prod_id\" = p.\"prod_id\") SELECT \"prod_id\", \"prod_name\", PP_CHANGE, SHARE_2019Q4, SHARE_2020Q4 FROM ranked WHERE pct_rank < 0.20 ORDER BY PP_CHANGE ASC LIMIT 1") t0 t1 t2 t3
  ~= (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, SALES_schema]) "WITH base_sales AS (/* All US sales with promo_id=999 in Q4 2019 or Q4 2020 */ SELECT s.\"prod_id\", c.\"cust_city\", t.\"calendar_quarter_id\", s.\"amount_sold\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" AS co ON c.\"country_id\" = co.\"country_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" WHERE co.\"country_name\" = 'United States of America' AND s.\"promo_id\" = 999 AND t.\"calendar_quarter_id\" IN (1772, 1776)), city_quarter_sales AS (/* Total sales per city per quarter */ SELECT \"cust_city\", \"calendar_quarter_id\", SUM(\"amount_sold\") AS total_sales FROM base_sales GROUP BY \"cust_city\", \"calendar_quarter_id\"), qualifying_cities AS (/* Cities with >=20% increase from Q4 2019 to Q4 2020 */ SELECT q4_2019.\"cust_city\" FROM (SELECT \"cust_city\", total_sales FROM city_quarter_sales WHERE \"calendar_quarter_id\" = 1772) AS q4_2019 JOIN (SELECT \"cust_city\", total_sales FROM city_quarter_sales WHERE \"calendar_quarter_id\" = 1776) AS q4_2020 ON q4_2019.\"cust_city\" = q4_2020.\"cust_city\" WHERE CAST((q4_2020.total_sales - q4_2019.total_sales) AS DOUBLE PRECISION) / q4_2019.total_sales >= 0.20), filtered_sales AS (/* Sales only from qualifying cities */ SELECT * FROM base_sales WHERE \"cust_city\" IN (SELECT \"cust_city\" FROM qualifying_cities)), product_total_sales AS (/* Total sales per product across both quarters (for ranking) */ SELECT \"prod_id\", SUM(\"amount_sold\") AS total_product_sales FROM filtered_sales GROUP BY \"prod_id\"), product_ranked AS (/* Rank products and identify top 20% */ SELECT \"prod_id\", total_product_sales, NTILE(5) OVER (ORDER BY total_product_sales DESC) AS quintile FROM product_total_sales), top_products AS (/* Top 20% of products by