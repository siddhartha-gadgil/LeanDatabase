theorem eq_0_1 : ∀ t,
    (sql%([_311_SERVICE_REQUESTS_schema, GSOD2008_schema, GSOD2013_schema, GSOD2010_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2014_schema, GSOD2016_schema, GSOD2009_schema, GSOD2017_schema]) "WITH weather AS (SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2008\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2009\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2010\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9), daily_temp AS (SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || LPAD(\"mo\", 2, '0') || '-' || LPAD(\"da\", 2, '0'), 'YYYY-MM-DD') AS DATE) AS weather_date, AVG(\"temp\") AS avg_temp FROM weather GROUP BY weather_date), complaints_raw AS (SELECT \"complaint_type\", CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) AS complaint_date FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\" WHERE CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) >= '2008-01-01' AND CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) < '2018-01-01'), daily_complaints AS (SELECT complaint_date, \"complaint_type\", COUNT(*) AS daily_count FROM complaints_raw GROUP BY complaint_date, \"complaint_type\"), daily_totals AS (SELECT complaint_date, SUM(daily_count) AS total_daily FROM daily_complaints GROUP BY complaint_date), daily_with_pct AS (SELECT dc.complaint_date, dc.\"complaint_type\", dc.daily_count, CAST(dc.daily_count * 1.0 AS DOUBLE PRECISION) / dt.total_daily AS daily_pct FROM daily_complaints AS dc JOIN daily_totals AS dt ON dc.complaint_date = dt.complaint_date), joined AS (SELECT dwp.\"complaint_type\", dwp.daily_count, dwp.daily_pct, t.avg_temp FROM daily_with_pct AS dwp JOIN daily_temp AS t ON dwp.complaint_date = t.weather_date), correlations AS (SELECT \"complaint_type\", SUM(daily_count) AS TOTAL_COMPLAINTS, COUNT(*) AS VALID_TEMP_DAYS, ROUND(CORR(daily_count, avg_temp), 4) AS CORR_COMPLAINT_COUNT_TEMP, ROUND(CORR(daily_pct, avg_temp), 4) AS CORR_COMPLAINT_PERCENTAGE_TEMP FROM joined GROUP BY \"complaint_type\" HAVING SUM(daily_count) > 5000) SELECT \"complaint_type\" AS \"complaint_type\", TOTAL_COMPLAINTS, VALID_TEMP_DAYS, CORR_COMPLAINT_COUNT_TEMP, CORR_COMPLAINT_PERCENTAGE_TEMP FROM correlations WHERE ABS(CORR_COMPLAINT_COUNT_TEMP) > 0.5 OR ABS(CORR_COMPLAINT_PERCENTAGE_TEMP) > 0.5 ORDER BY CORR_COMPLAINT_COUNT_TEMP DESC, TOTAL_COMPLAINTS DESC") t ~= (sql%([_311_SERVICE_REQUESTS_schema, GSOD2008_schema, GSOD2013_schema, GSOD2010_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2014_schema, GSOD2016_schema, GSOD2009_schema, GSOD2017_schema]) "WITH weather_daily AS (/* Combine GSOD tables for 2008-2017, average temp from LaGuardia + JFK */ SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE) AS weather_date, AVG(\"temp\") AS avg_temp FROM (SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2008\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2009\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2010\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9 UNION ALL SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" IN ('725030', '744860') AND \"temp\" <> 9999.9) AS gsod_all GROUP BY weather_date), complaints_daily AS (/* Daily complaint counts per type */ SELECT CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) AS complaint_date, \"complaint_type\", COUNT(*) AS daily_count FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\" GROUP BY complaint_date, \"complaint_type\"), total_daily AS (/* Total complaints per day (for percentage calculation) */ SELECT CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) AS complaint_date, COUNT(*) AS total_daily_count FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\" GROUP BY complaint_date), joined AS (/* Join weather with complaints */ SELECT c.\"complaint_type\", w.avg_temp, c.daily_count, CAST(c.daily_count * 1.0 AS DOUBLE PRECISION) / t.total_daily_count AS daily_pct FROM weather_daily AS w INNER JOIN complaints_daily AS c ON w.weather_date = c.complaint_date INNER JOIN total_daily AS t ON c.complaint_date = t.complaint_date), correlations AS (SELECT \"complaint_type\", SUM(daily_count) AS total_complaints, COUNT(*) AS valid_temp_days, ROUND(CORR(avg_temp, daily_count), 4) AS corr_complaint_count_temp, ROUND(CORR(avg_temp, daily_pct), 4) AS corr_complaint_percentage_temp FROM joined GROUP BY \"complaint_type\" HAVING SUM(daily_count) > 5000) SELECT \"complaint_type\", total_complaints AS TOTAL_COMPLAINTS, valid_temp_days AS VALID_TEMP_DAYS, corr_complaint_count_temp AS CORR_COMPLAINT_COUNT_TEMP, corr_complaint_percentage_temp AS CORR_COMPLAINT_PERCENTAGE_TEMP FROM correlations WHERE ABS(corr_complaint_count_temp) > 0.5 OR ABS(corr_complaint_percentage_temp) > 0.5 ORDER BY corr_complaint_count_temp DESC") t := by
  intro t; first | sql_equiv | sorry

