theorem eq_0_1 : ∀ t,
    (sql%([_311_SERVICE_REQUESTS_schema, GSOD2008_schema, GSOD2013_schema, GSOD2010_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2014_schema, GSOD2016_schema, GSOD2009_schema, GSOD2017_schema]) "WITH weather AS (\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2008\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2009\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2010\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n  UNION ALL\n  SELECT \"year\", \"mo\", \"da\", \"stn\", \"temp\"\n  FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\"\n  WHERE \"stn\" IN ('725030', '744860') AND \"temp\" != 9999.9\n),\ndaily_temp AS (\n  SELECT\n    TO_DATE(\"year\" || '-' || LPAD(\"mo\", 2, '0') || '-' || LPAD(\"da\", 2, '0'), 'YYYY-MM-DD') AS weather_date,\n    AVG(\"temp\") AS avg_temp\n  FROM weather\n  GROUP BY weather_date\n),\ncomplaints_raw AS (\n  SELECT\n    \"complaint_type\",\n    TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) AS complaint_date\n  FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\"\n  WHERE TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) >= '2008-01-01'\n    AND TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) < '2018-01-01'\n),\ndaily_complaints AS (\n  SELECT\n    complaint_date,\n    \"complaint_type\",\n    COUNT(*) AS daily_count\n  FROM complaints_raw\n  GROUP BY complaint_date, \"complaint_type\"\n),\ndaily_totals AS (\n  SELECT\n    complaint_date,\n    SUM(daily_count) AS total_daily\n  FROM daily_complaints\n  GROUP BY complaint_date\n),\ndaily_with_pct AS (\n  SELECT\n    dc.complaint_date,\n    dc.\"complaint_type\",\n    dc.daily_count,\n    dc.daily_count * 1.0 / dt.total_daily AS daily_pct\n  FROM daily_complaints dc\n  JOIN daily_totals dt ON dc.complaint_date = dt.complaint_date\n),\njoined AS (\n  SELECT\n    dwp.\"complaint_type\",\n    dwp.daily_count,\n    dwp.daily_pct,\n    t.avg_temp\n  FROM daily_with_pct dwp\n  JOIN daily_temp t ON dwp.complaint_date = t.weather_date\n),\ncorrelations AS (\n  SELECT\n    \"complaint_type\",\n    SUM(daily_count) AS TOTAL_COMPLAINTS,\n    COUNT(*) AS VALID_TEMP_DAYS,\n    ROUND(CORR(daily_count, avg_temp), 4) AS CORR_COMPLAINT_COUNT_TEMP,\n    ROUND(CORR(daily_pct, avg_temp), 4) AS CORR_COMPLAINT_PERCENTAGE_TEMP\n  FROM joined\n  GROUP BY \"complaint_type\"\n  HAVING SUM(daily_count) > 5000\n)\nSELECT\n  \"complaint_type\" AS \"complaint_type\",\n  TOTAL_COMPLAINTS,\n  VALID_TEMP_DAYS,\n  CORR_COMPLAINT_COUNT_TEMP,\n  CORR_COMPLAINT_PERCENTAGE_TEMP\nFROM correlations\nWHERE ABS(CORR_COMPLAINT_COUNT_TEMP) > 0.5\n   OR ABS(CORR_COMPLAINT_PERCENTAGE_TEMP) > 0.5\nORDER BY CORR_COMPLAINT_COUNT_TEMP DESC, TOTAL_COMPLAINTS DESC;") t ~= (sql%([_311_SERVICE_REQUESTS_schema, GSOD2008_schema, GSOD2013_schema, GSOD2010_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2014_schema, GSOD2016_schema, GSOD2009_schema, GSOD2017_schema]) "WITH weather_daily AS (\n  -- Combine GSOD tables for 2008-2017, average temp from LaGuardia + JFK\n  SELECT\n    TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS weather_date,\n    AVG(\"temp\") AS avg_temp\n  FROM (\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2008\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2009\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2010\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", \"temp\" FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" IN ('725030','744860') AND \"temp\" != 9999.9\n  ) gsod_all\n  GROUP BY weather_date\n),\n\ncomplaints_daily AS (\n  -- Daily complaint counts per type\n  SELECT\n    TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) AS complaint_date,\n    \"complaint_type\",\n    COUNT(*) AS daily_count\n  FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\"\n  GROUP BY complaint_date, \"complaint_type\"\n),\n\ntotal_daily AS (\n  -- Total complaints per day (for percentage calculation)\n  SELECT\n    TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) AS complaint_date,\n    COUNT(*) AS total_daily_count\n  FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\"\n  GROUP BY complaint_date\n),\n\njoined AS (\n  -- Join weather with complaints\n  SELECT\n    c.\"complaint_type\",\n    w.avg_temp,\n    c.daily_count,\n    c.daily_count * 1.0 / t.total_daily_count AS daily_pct\n  FROM weather_daily w\n  INNER JOIN complaints_daily c ON w.weather_date = c.complaint_date\n  INNER JOIN total_daily t ON c.complaint_date = t.complaint_date\n),\n\ncorrelations AS (\n  SELECT\n    \"complaint_type\",\n    SUM(daily_count) AS total_complaints,\n    COUNT(*) AS valid_temp_days,\n    ROUND(CORR(avg_temp, daily_count), 4) AS corr_complaint_count_temp,\n    ROUND(CORR(avg_temp, daily_pct), 4) AS corr_complaint_percentage_temp\n  FROM joined\n  GROUP BY \"complaint_type\"\n  HAVING SUM(daily_count) > 5000\n)\n\nSELECT\n  \"complaint_type\",\n  total_complaints AS TOTAL_COMPLAINTS,\n  valid_temp_days AS VALID_TEMP_DAYS,\n  corr_complaint_count_temp AS CORR_COMPLAINT_COUNT_TEMP,\n  corr_complaint_percentage_temp AS CORR_COMPLAINT_PERCENTAGE_TEMP\nFROM correlations\nWHERE ABS(corr_complaint_count_temp) > 0.5 OR ABS(corr_complaint_percentage_temp) > 0.5\nORDER BY corr_complaint_count_temp DESC;") t := by
