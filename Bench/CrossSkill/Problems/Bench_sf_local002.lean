import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local002 — crossskill equivalence(s)

Question: Can you calculate the 5-day symmetric moving average of predicted toy sales for December 5 to 8, 2018, using daily sales data from January 1, 2017, to August 29, 2018, with a simple linear regression model? Finally provide the sum of those four 5-day moving averages?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local002

CREATE TABLE ORDER_ITEMS («order_id» STRING, «order_item_id» INT, «product_id» STRING, «seller_id» STRING, «shipping_limit_date» STRING, «price» FLOAT, «freight_value» FLOAT)
CREATE TABLE PRODUCTS («product_id» STRING, «product_category_name» STRING, «product_name_lenght» FLOAT, «product_description_lenght» FLOAT, «product_photos_qty» FLOAT, «product_weight_g» FLOAT, «product_length_cm» FLOAT, «product_height_cm» FLOAT, «product_width_cm» FLOAT)
CREATE TABLE ORDERS («order_id» STRING, «customer_id» STRING, «order_status» STRING, «order_purchase_timestamp» STRING, «order_approved_at» STRING, «order_delivered_carrier_date» STRING, «order_delivered_customer_date» STRING, «order_estimated_delivery_date» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([ORDER_ITEMS_schema, PRODUCTS_schema, ORDERS_schema]) "-- sf_local002: 5-day symmetric moving average of predicted toy sales (price)\n-- Using simple linear regression on daily toy sales from 2017-01-01 to 2018-08-29\n-- Predictions for Dec 5-8, 2018, then sum the 4 moving averages\n\nWITH daily_sales AS (\n    SELECT \n        TO_DATE(o.\"order_purchase_timestamp\") AS sale_date,\n        SUM(TRY_TO_DOUBLE(oi.\"price\")) AS sum_price\n    FROM \"E_COMMERCE\".\"E_COMMERCE\".\"ORDERS\" o\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"ORDER_ITEMS\" oi ON o.\"order_id\" = oi.\"order_id\"\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"PRODUCTS\" p ON oi.\"product_id\" = p.\"product_id\"\n    WHERE p.\"product_category_name\" = 'brinquedos'\n      AND TO_DATE(o.\"order_purchase_timestamp\") BETWEEN '2017-01-01' AND '2018-08-29'\n    GROUP BY TO_DATE(o.\"order_purchase_timestamp\")\n),\nall_dates AS (\n    SELECT DATEADD('day', SEQ4(), '2017-01-01')::DATE AS sale_date\n    FROM TABLE(GENERATOR(ROWCOUNT => 606))\n),\nfull_data AS (\n    SELECT \n        a.sale_date,\n        DATEDIFF('day', '2017-01-01', a.sale_date) + 1 AS day_num,\n        COALESCE(d.sum_price, 0) AS y\n    FROM all_dates a\n    LEFT JOIN daily_sales d ON a.sale_date = d.sale_date\n),\nregression AS (\n    SELECT \n        REGR_SLOPE(y, day_num) AS slope,\n        REGR_INTERCEPT(y, day_num) AS intercept\n    FROM full_data\n),\npred_dates AS (\n    SELECT \n        DATEADD('day', SEQ4() + DATEDIFF('day', '2017-01-01', '2018-12-03'), '2017-01-01')::DATE AS pred_date,\n        DATEDIFF('day', '2017-01-01', DATEADD('day', SEQ4() + DATEDIFF('day', '2017-01-01', '2018-12-03'), '2017-01-01')::DATE) + 1 AS day_num\n    FROM TABLE(GENERATOR(ROWCOUNT => 8))\n),\npredictions AS (\n    SELECT \n        pd.pred_date,\n        pd.day_num,\n        r.slope * pd.day_num + r.intercept AS pred_price\n    FROM pred_dates pd, regression r\n),\nmoving_avg AS (\n    SELECT \n        p.pred_date,\n        AVG(p2.pred_price) AS ma_price\n    FROM predictions p\n    JOIN predictions p2 ON p2.day_num BETWEEN p.day_num - 2 AND p.day_num + 2\n    WHERE p.pred_date BETWEEN '2018-12-05' AND '2018-12-08'\n    GROUP BY p.pred_date\n)\nSELECT SUM(ma_price) AS TOTAL\nFROM moving_avg;") t ~= (sql%([ORDER_ITEMS_schema, PRODUCTS_schema, ORDERS_schema]) "-- sf_local002: Calculate 5-day symmetric moving average of predicted toy sales (revenue)\n-- for Dec 5-8 2018, using linear regression on daily data from Jan 1 2017 to Aug 29 2018.\n-- Since 5-day symmetric MA of a linear function = the function value itself,\n-- the sum of four MAs = sum of four predicted values.\n\nWITH date_spine AS (\n    -- Generate all dates from Jan 1 2017 to Aug 29 2018\n    SELECT DATEADD('day', seq4(), '2017-01-01') AS sale_date\n    FROM TABLE(GENERATOR(ROWCOUNT => 606))\n),\ndaily_sales AS (\n    -- Aggregate daily toy revenue\n    SELECT \n        DATE(TO_TIMESTAMP(o.\"order_purchase_timestamp\")) AS sale_date,\n        SUM(oi.\"price\") AS daily_revenue\n    FROM \"E_COMMERCE\".\"E_COMMERCE\".\"ORDERS\" o\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"ORDER_ITEMS\" oi ON o.\"order_id\" = oi.\"order_id\"\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"PRODUCTS\" p ON oi.\"product_id\" = p.\"product_id\"\n    WHERE p.\"product_category_name\" = 'brinquedos'\n      AND DATE(TO_TIMESTAMP(o.\"order_purchase_timestamp\")) >= '2017-01-01'\n      AND DATE(TO_TIMESTAMP(o.\"order_purchase_timestamp\")) <= '2018-08-29'\n    GROUP BY sale_date\n),\nall_days AS (\n    -- Fill in zero-revenue days\n    SELECT \n        ds.sale_date,\n        COALESCE(d.daily_revenue, 0) AS daily_revenue,\n        DATEDIFF('day', '2017-01-01', ds.sale_date) AS day_num\n    FROM date_spine ds\n    LEFT JOIN daily_sales d ON ds.sale_date = d.sale_date\n    WHERE ds.sale_date <= '2018-08-29'\n),\nregression AS (\n    -- Compute linear regression parameters\n    SELECT \n        REGR_SLOPE(daily_revenue, day_num) AS slope,\n        REGR_INTERCEPT(daily_revenue, day_num) AS intercept\n    FROM all_days\n),\npredictions AS (\n    -- Predict revenue for Dec 3-10, 2018 (needed for 5-day symmetric MA of Dec 5-8)\n    SELECT \n        DATEADD('day', seq4(), '2018-12-03') AS pred_date,\n        DATEDIFF('day', '2017-01-01', DATEADD('day', seq4(), '2018-12-03')) AS day_num\n    FROM TABLE(GENERATOR(ROWCOUNT => 8))\n),\npredicted_values AS (\n    SELECT \n        p.pred_date,\n        r.intercept + r.slope * p.day_num AS predicted_revenue\n    FROM predictions p\n    CROSS JOIN regression r\n),\nmoving_avg AS (\n    -- 5-day symmetric moving average for Dec 5-8\n    SELECT \n        pv.pred_date,\n        AVG(pv2.predicted_revenue) AS ma_5day\n    FROM predicted_values pv\n    JOIN predicted_values pv2 \n        ON pv2.pred_date BETWEEN DATEADD('day', -2, pv.pred_date) AND DATEADD('day', 2, pv.pred_date)\n    WHERE pv.pred_date BETWEEN '2018-12-05' AND '2018-12-08'\n    GROUP BY pv.pred_date\n)\nSELECT SUM(ma_5day) AS \"TOTAL\"\nFROM moving_avg;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([ORDER_ITEMS_schema, PRODUCTS_schema, ORDERS_schema]) "-- sf_local002: 5-day symmetric moving average of predicted toy sales (price)\n-- Using simple linear regression on daily toy sales from 2017-01-01 to 2018-08-29\n-- Predictions for Dec 5-8, 2018, then sum the 4 moving averages\n\nWITH daily_sales AS (\n    SELECT \n        TO_DATE(o.\"order_purchase_timestamp\") AS sale_date,\n        SUM(TRY_TO_DOUBLE(oi.\"price\")) AS sum_price\n    FROM \"E_COMMERCE\".\"E_COMMERCE\".\"ORDERS\" o\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"ORDER_ITEMS\" oi ON o.\"order_id\" = oi.\"order_id\"\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"PRODUCTS\" p ON oi.\"product_id\" = p.\"product_id\"\n    WHERE p.\"product_category_name\" = 'brinquedos'\n      AND TO_DATE(o.\"order_purchase_timestamp\") BETWEEN '2017-01-01' AND '2018-08-29'\n    GROUP BY TO_DATE(o.\"order_purchase_timestamp\")\n),\nall_dates AS (\n    SELECT DATEADD('day', SEQ4(), '2017-01-01')::DATE AS sale_date\n    FROM TABLE(GENERATOR(ROWCOUNT => 606))\n),\nfull_data AS (\n    SELECT \n        a.sale_date,\n        DATEDIFF('day', '2017-01-01', a.sale_date) + 1 AS day_num,\n        COALESCE(d.sum_price, 0) AS y\n    FROM all_dates a\n    LEFT JOIN daily_sales d ON a.sale_date = d.sale_date\n),\nregression AS (\n    SELECT \n        REGR_SLOPE(y, day_num) AS slope,\n        REGR_INTERCEPT(y, day_num) AS intercept\n    FROM full_data\n),\npred_dates AS (\n    SELECT \n        DATEADD('day', SEQ4() + DATEDIFF('day', '2017-01-01', '2018-12-03'), '2017-01-01')::DATE AS pred_date,\n        DATEDIFF('day', '2017-01-01', DATEADD('day', SEQ4() + DATEDIFF('day', '2017-01-01', '2018-12-03'), '2017-01-01')::DATE) + 1 AS day_num\n    FROM TABLE(GENERATOR(ROWCOUNT => 8))\n),\npredictions AS (\n    SELECT \n        pd.pred_date,\n        pd.day_num,\n        r.slope * pd.day_num + r.intercept AS pred_price\n    FROM pred_dates pd, regression r\n),\nmoving_avg AS (\n    SELECT \n        p.pred_date,\n        AVG(p2.pred_price) AS ma_price\n    FROM predictions p\n    JOIN predictions p2 ON p2.day_num BETWEEN p.day_num - 2 AND p.day_num + 2\n    WHERE p.pred_date BETWEEN '2018-12-05' AND '2018-12-08'\n    GROUP BY p.pred_date\n)\nSELECT SUM(ma_price) AS TOTAL\nFROM moving_avg;") t ~= (sql%([ORDER_ITEMS_schema, PRODUCTS_schema, ORDERS_schema]) "WITH calendar AS (\n    -- Generate all dates from 2017-01-01 to 2018-08-29 (606 days)\n    SELECT DATEADD(DAY, seq4(), '2017-01-01'::DATE) AS sale_date\n    FROM TABLE(GENERATOR(ROWCOUNT => 606))\n),\ntoy_daily_sales AS (\n    SELECT DATE(o.\"order_purchase_timestamp\") AS sale_date,\n           SUM(oi.\"price\") AS daily_sales\n    FROM \"E_COMMERCE\".\"E_COMMERCE\".\"ORDERS\" o\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"ORDER_ITEMS\" oi ON o.\"order_id\" = oi.\"order_id\"\n    JOIN \"E_COMMERCE\".\"E_COMMERCE\".\"PRODUCTS\" p ON oi.\"product_id\" = p.\"product_id\"\n    WHERE p.\"product_category_name\" = 'brinquedos'\n    AND DATE(o.\"order_purchase_timestamp\") BETWEEN '2017-01-01' AND '2018-08-29'\n    GROUP BY DATE(o.\"order_purchase_timestamp\")\n),\ndaily_data AS (\n    SELECT c.sale_date,\n           COALESCE(t.daily_sales, 0) AS y,\n           DATEDIFF('day', '2017-01-01'::DATE, c.sale_date) AS x\n    FROM calendar c\n    LEFT JOIN toy_daily_sales t ON c.sale_date = t.sale_date\n),\nregression_params AS (\n    SELECT \n        REGR_SLOPE(y::FLOAT, x::FLOAT) AS slope,\n        REGR_INTERCEPT(y::FLOAT, x::FLOAT) AS intercept\n    FROM daily_data\n),\nprediction_dates AS (\n    -- Dec 3 to Dec 10, 2018 (need +-2 days around Dec 5-8)\n    SELECT DATEADD(DAY, seq4(), '2018-12-03'::DATE) AS pred_date\n    FROM TABLE(GENERATOR(ROWCOUNT => 8))\n),\npredictions AS (\n    SELECT pd.pred_date,\n           rp.slope * DATEDIFF('day', '2017-01-01'::DATE, pd.pred_date) + rp.intercept AS predicted_sales\n    FROM prediction_dates pd\n    CROSS JOIN regression_params rp\n),\nmoving_avg AS (\n    SELECT p.pred_date,\n           AVG(p2.predicted_sales) AS ma5\n    FROM predictions p\n    JOIN predictions p2 ON p2.pred_date BETWEEN DATEADD(DAY, -2, p.pred_date) AND DATEADD(DAY, 2, p.pred_date)\n    WHERE p.pred_date BETWEEN '2018-12-05' AND '2018-12-08'\n    GROUP BY p.pred_date\n)\nSELECT SUM(ma5) AS \"TOTAL\"\nFROM moving_avg;") t := by
  intro t; first | sql_equiv | sorry

