ion_group, COUNT(*) AS N, SUM(avg_log_expr) AS S, SUM(avg_log_expr * avg_log_expr) AS Q FROM patient_groups GROUP BY mutation_group), pivoted AS (/* Pivot to get Y and N stats side by side */ SELECT MAX(CASE WHEN mutation_group = 'Y' THEN N END) AS Ny, MAX(CASE WHEN mutation_group = 'N' THEN N END) AS Nn, MAX(CASE WHEN mutation_group = 'Y' THEN S END) AS Sy, MAX(CASE WHEN mutation_group = 'N' THEN S END) AS Sn, MAX(CASE WHEN mutation_group = 'Y' THEN Q END) AS Qy, MAX(CASE WHEN mutation_group = 'N' THEN Q END) AS Qn FROM group_stats) SELECT Ny AS NY, Nn AS NN, CAST(Sy AS DOUBLE PRECISION) / Ny AS AVG_Y, CAST(Sn AS DOUBLE PRECISION) / Nn AS AVG_N, CAST((CAST(Sy AS DOUBLE PRECISION) / Ny - CAST(Sn AS DOUBLE PRECISION) / Nn) /* Welch's t-test: t = (avg_y - avg_n) / sqrt(var_y/Ny + var_n/Nn) */ /* var = (Q - S^2/N) / (N - 1) */ AS DOUBLE PRECISION) / SQRT(CAST((CAST((Qy - (CAST(Sy * Sy AS DOUBLE PRECISION) / Ny)) AS DOUBLE PRECISION) / (Ny - 1)) AS DOUBLE PRECISION) / Ny + CAST((CAST((Qn - (CAST(Sn * Sn AS DOUBLE PRECISION) / Nn)) AS DOUBLE PRECISION) / (Nn - 1)) AS DOUBLE PRECISION) / Nn) AS TSCORE FROM pivoted") t0 t1
