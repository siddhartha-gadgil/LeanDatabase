p53 = 0 THEN mean_expr END) AS AVG_N, CAST((MAX(CASE WHEN has_tp53 = 1 THEN mean_expr END) - MAX(CASE WHEN has_tp53 = 0 THEN mean_expr END)) AS DOUBLE PRECISION) / SQRT(CAST(MAX(CASE WHEN has_tp53 = 1 THEN var_expr END) AS DOUBLE PRECISION) / MAX(CASE WHEN has_tp53 = 1 THEN n END) + CAST(MAX(CASE WHEN has_tp53 = 0 THEN var_expr END) AS DOUBLE PRECISION) / MAX(CASE WHEN has_tp53 = 0 THEN n END)) AS TSCORE FROM group_stats") t0 t1
