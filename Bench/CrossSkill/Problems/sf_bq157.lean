    (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "/* Compute T-score for DRG2 expression difference between LGG patients with/without TP53 mutation */ /* Uses Welch's t-test: T = (mean_y - mean_n) / sqrt(var_y/n_y + var_n/n_n) */ /* y = WITH TP53 mutation, n = WITHOUT TP53 mutation */ WITH tp53_patients AS (/* Identify LGG patients with TP53 mutations (PASS filter) */ SELECT DISTINCT \"ParticipantBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG' AND \"Hugo_Symbol\" = 'TP53' AND \"FILTER\" = 'PASS'), lgg_samples AS (/* All LGG tumor sample barcodes in MC3_MAF */ SELECT DISTINCT \"Tumor_SampleBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG'), patient_expr AS (/* For each patient, compute average log10(normalized_count + 1) of DRG2 */ /* Only using samples present in MC3_MAF for LGG */ SELECT e.\"ParticipantBarcode\", AVG(LOG(10, e.\"normalized_count\" + 1)) AS avg_log_expr, CASE WHEN NOT tp53.\"ParticipantBarcode\" IS NULL THEN 1 ELSE 0 END AS has_tp53 FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" AS e INNER JOIN lgg_samples AS ls ON e.\"SampleBarcode\" = ls.\"Tumor_SampleBarcode\" LEFT JOIN tp53_patients AS tp53 ON e.\"ParticipantBarcode\" = tp53.\"ParticipantBarcode\" WHERE e.\"Symbol\" = 'DRG2' AND e.\"Study\" = 'LGG' GROUP BY e.\"ParticipantBarcode\", CASE WHEN NOT tp53.\"ParticipantBarcode\" IS NULL THEN 1 ELSE 0 END), group_stats AS (/* Compute group-level statistics */ SELECT has_tp53, COUNT(*) AS n, AVG(avg_log_expr) AS mean_expr, VAR_SAMP(avg_log_expr) AS var_expr FROM patient_expr GROUP BY has_tp53) SELECT MAX(CASE WHEN has_tp53 = 1 THEN n END) AS NY, MAX(CASE WHEN has_tp53 = 0 THEN n END) AS NN, MAX(CASE WHEN has_tp53 = 1 THEN mean_expr END) AS AVG_Y, MAX(CASE WHEN has_tp53 = 0 THEN mean_expr END) AS AVG_N, CAST((MAX(CASE WHEN has_tp53 = 1 THEN mean_expr END) - MAX(CASE WHEN has_tp53 = 0 THEN mean_expr END)) AS DOUBLE PRECISION) / SQRT(CAST(MAX(CASE WHEN has_tp53 = 1 THEN var_expr END) AS DOUBLE PRECISION) / MAX(CASE WHEN has_tp53 = 1 THEN n END) + CAST(MAX(CASE WHEN has_tp53 = 0 THEN var_expr END) AS DOUBLE PRECISION) / MAX(CASE WHEN has_tp53 = 0 THEN n END)) AS TSCORE FROM group_stats") t ~= (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "/* Welch's t-test for DRG2 gene expression between LGG patients with and without TP53 mutation */ /* Step 1: Get all MC3 LGG sample barcodes */ /* Step 2: Join to gene expression for DRG2 to get per-patient avg log10(normalized_count+1) */ /* Step 3: Split by TP53 mutation status */ /* Step 4: Compute Welch's t-test */ WITH mc3_samples AS (/* All distinct tumor sample barcodes for LGG patients in MC3 */ SELECT DISTINCT \"Tumor_SampleBarcode\", \"ParticipantBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG'), tp53_patients AS (/* LGG patients with TP53 mutation (FILTER='PASS') */ SELECT DISTINCT \"ParticipantBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG' AND \"Hugo_Symbol\" = 'TP53' AND \"FILTER\" = 'PASS'), drg2_expression AS (/* DRG2 gene expression for LGG samples that are present in MC3 */ SELECT g.\"ParticipantBarcode\", g.\"SampleBarcode\", LOG(10, g.\"normalized_count\" + 1) AS log_expr FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" AS g INNER JOIN mc3_samples AS m ON g.\"SampleBarcode\" = m.\"Tumor_SampleBarcode\" WHERE g.\"Study\" = 'LGG' AND g.\"Symbol\" = 'DRG2'), patient_avg_expr AS (/* Per-patient average DRG2 expression */ SELECT \"ParticipantBarcode\", AVG(log_expr) AS avg_log_expr FROM drg2_expression GROUP BY \"ParticipantBarcode\"), patient_groups AS (/* Tag each patient as Y (TP53 mutated) or N (not mutated) */ SELECT p.avg_log_expr, CASE WHEN NOT tp.\"ParticipantBarcode\" IS NULL THEN 'Y' ELSE 'N' END AS mutation_group FROM patient_avg_expr AS p LEFT JOIN tp53_patients AS tp ON p.\"ParticipantBarcode\" = tp.\"ParticipantBarcode\"), group_stats AS (/* Compute N, sum, sum of squares for each group */ SELECT mutation_group, COUNT(*) AS N, SUM(avg_log_expr) AS S, SUM(avg_log_expr * avg_log_expr) AS Q FROM patient_groups GROUP BY mutation_group), pivoted AS (/* Pivot to get Y and N stats side by side */ SELECT MAX(CASE WHEN mutation_group = 'Y' THEN N END) AS Ny, MAX(CASE WHEN mutation_group = 'N' THEN N END) AS Nn, MAX(CASE WHEN mutation_group = 'Y' THEN S END) AS Sy, MAX(CASE WHEN mutation_group = 'N' THEN S END) AS Sn, MAX(CASE WHEN mutation_group = 'Y' THEN Q END) AS Qy, MAX(CASE WHEN mutation_group = 'N' THEN Q END) AS Qn FROM group_stats) SELECT Ny AS NY, Nn AS NN, CAST(Sy AS DOUBLE PRECISION) / Ny AS AVG_Y, CAST(Sn AS DOUBLE PRECISION) / Nn AS AVG_N, CAST((CAST(Sy AS DOUBLE PRECISION) / Ny - CAST(Sn AS DOUBLE PRECISION) / Nn) /* Welch's t-test: t = (avg_y - avg_n) / sqrt(var_y/Ny + var_n/Nn) */ /* var = (Q - S^2/N) / (N - 1) */ AS DOUBLE PRECISION) / SQRT(CAST((CAST((Qy - (CAST(Sy * Sy AS DOUBLE PRECISION) / Ny)) AS DOUBLE PRECISION) / (Ny - 1)) AS DOUBLE PRECISION) / Ny + CAST((CAST((Qn - (CAST(Sn * Sn AS DOUBLE PRECISION) / Nn)) AS DOUBLE PRECISION) / (Nn - 1)) AS DOUBLE PRECISION) / Nn) AS TSCORE FROM pivoted") t := by
