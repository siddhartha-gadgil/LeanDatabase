import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq452 — crossskill equivalence(s)

Question: Identify variants on chromosome 12 and, for each variant, calculate the chi-squared score using allele counts in cases and controls, where cases are individuals from the 'EAS' super population and controls are individuals from all other super populations. Apply Yates's correction for continuity in the chi-squared calculation, ensuring that the expected counts for each allele in both groups are at least 5. Return the start position, end position, and chi-squared score of the top variants where the chi-squared score is no less than 29.71679.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq452

CREATE TABLE SAMPLE_INFO («Sample» STRING, «Family_ID» STRING, «Population» STRING, «Population_Description» STRING, «Gender» STRING, «Relationship» STRING, «Unexpected_Parent_Child» STRING, «Non_Paternity» STRING, «Siblings» STRING, «Grandparents» STRING, «Avuncular» STRING, «Half_Siblings» STRING, «Unknown_Second_Order» STRING, «Third_Order» STRING, «In_Low_Coverage_Pilot» BOOL, «LC_Pilot_Platforms» STRING, «LC_Pilot_Centers» STRING, «In_High_Coverage_Pilot» BOOL, «HC_Pilot_Platforms» STRING, «HC_Pilot_Centers» STRING, «In_Exon_Targetted_Pilot» BOOL, «ET_Pilot_Platforms» STRING, «ET_Pilot_Centers» STRING, «Has_Sequence_in_Phase1» BOOL, «Phase1_LC_Platform» STRING, «Phase1_LC_Centers» STRING, «Phase1_E_Platform» STRING, «Phase1_E_Centers» STRING, «In_Phase1_Integrated_Variant_Set» BOOL, «Has_Phase1_chrY_SNPS» BOOL, «Has_phase1_chrY_Deletions» BOOL, «Has_phase1_chrMT_SNPs» BOOL, «Main_project_LC_Centers» STRING, «Main_project_LC_platform» STRING, «Total_LC_Sequence» FLOAT, «LC_Non_Duplicated_Aligned_Coverage» FLOAT, «Main_Project_E_Centers» STRING, «Main_Project_E_Platform» STRING, «Total_Exome_Sequence» FLOAT, «X_Targets_Covered_to_20x_or_greater» FLOAT, «VerifyBam_E_Omni_Free» FLOAT, «VerifyBam_E_Affy_Free» FLOAT, «VerifyBam_E_Omni_Chip» FLOAT, «VerifyBam_E_Affy_Chip» FLOAT, «VerifyBam_LC_Omni_Free» FLOAT, «VerifyBam_LC_Affy_Free» FLOAT, «VerifyBam_LC_Omni_Chip» FLOAT, «VerifyBam_LC_Affy_Chip» FLOAT, «LC_Indel_Ratio» FLOAT, «E_Indel_Ratio» FLOAT, «LC_Passed_QC» BOOL, «E_Passed_QC» BOOL, «In_Final_Phase_Variant_Calling» BOOL, «Has_Omni_Genotypes» BOOL, «Has_Axiom_Genotypes» BOOL, «Has_Affy_6_0_Genotypes» BOOL, «Has_Exome_LOF_Genotypes» BOOL, «EBV_Coverage» FLOAT, «DNA_Source_from_Coriell» STRING, «Has_Sequence_from_Blood_in_Index» BOOL, «Super_Population» STRING, «Super_Population_Description» STRING)
CREATE TABLE VARIANTS («reference_name» STRING, «start» INT, «end» INT, «reference_bases» STRING, «alternate_bases» STRING, «quality» FLOAT, «filter» STRING, «names» STRING, «call» STRING, «AA» STRING, «AC» STRING, «AC1» INT, «AF» FLOAT, «AF1» FLOAT, «AFR_AF» FLOAT, «AMR_AF» FLOAT, «AN» INT, «ASN_AF» FLOAT, «AVGPOST» FLOAT, «CIEND» STRING, «CIPOS» STRING, «DP» INT, «DP4» STRING, «ERATE» FLOAT, «EUR_AF» FLOAT, «FQ» FLOAT, «G3» STRING, «HOMLEN» INT, «HOMSEQ» STRING, «HWE» FLOAT, «LDAF» FLOAT, «MQ» INT, «PV4» STRING, «RSQ» FLOAT, «SNPSOURCE» STRING, «SOURCE» STRING, «SVLEN» INT, «SVTYPE» STRING, «THETA» FLOAT, «VT» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH allele_counts AS (\n  SELECT \n    v.\"start\" AS start_pos,\n    v.\"end\" AS end_pos,\n    SUM(CASE WHEN s.\"Super_Population\" = 'EAS' \n             THEN 2 - (c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT) \n             ELSE 0 END) AS case_ref,\n    SUM(CASE WHEN s.\"Super_Population\" = 'EAS' \n             THEN c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT \n             ELSE 0 END) AS case_alt,\n    SUM(CASE WHEN s.\"Super_Population\" != 'EAS' \n             THEN 2 - (c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT) \n             ELSE 0 END) AS ctrl_ref,\n    SUM(CASE WHEN s.\"Super_Population\" != 'EAS' \n             THEN c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT \n             ELSE 0 END) AS ctrl_alt\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" s\n    ON c.value:\"call_set_name\"::STRING = s.\"Sample\"\n  WHERE v.\"reference_name\" = '12'\n  GROUP BY v.\"start\", v.\"end\"\n),\nchi_calc AS (\n  SELECT\n    start_pos AS \"start\",\n    end_pos AS \"end\",\n    case_ref AS a,\n    case_alt AS b,\n    ctrl_ref AS c,\n    ctrl_alt AS d,\n    (case_ref + case_alt + ctrl_ref + ctrl_alt) AS N,\n    -- Row totals\n    (case_ref + case_alt) AS R1,\n    (ctrl_ref + ctrl_alt) AS R2,\n    -- Column totals\n    (case_ref + ctrl_ref) AS C1,\n    (case_alt + ctrl_alt) AS C2,\n    -- Expected counts\n    ((case_ref + case_alt) * (case_ref + ctrl_ref)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_a,\n    ((case_ref + case_alt) * (case_alt + ctrl_alt)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_b,\n    ((ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_c,\n    ((ctrl_ref + ctrl_alt) * (case_alt + ctrl_alt)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_d,\n    -- Chi-squared with Yates correction\n    (case_ref + case_alt + ctrl_ref + ctrl_alt) * \n      POWER(\n        ABS(case_ref * ctrl_alt - case_alt * ctrl_ref) - (case_ref + case_alt + ctrl_ref + ctrl_alt) / 2.0, \n        2\n      ) / \n      NULLIF(\n        (case_ref + case_alt) * 1.0 * (ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref) * (case_alt + ctrl_alt), \n        0\n      ) AS \"CHI2\"\n  FROM allele_counts\n)\nSELECT\n  \"start\",\n  \"end\",\n  \"CHI2\"\nFROM chi_calc\nWHERE E_a >= 5 AND E_b >= 5 AND E_c >= 5 AND E_d >= 5\n  AND \"CHI2\" >= 29.71679\nORDER BY \"CHI2\" DESC;") t ~= (sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH allele_counts AS (\n  SELECT\n    v.\"start\" AS start_pos,\n    v.\"end\" AS end_pos,\n    -- EAS alt alleles (case alt = a)\n    SUM(CASE WHEN si.\"Super_Population\" = 'EAS'\n             THEN c.value:genotype[0]::INT + c.value:genotype[1]::INT\n             ELSE 0 END) AS a,\n    -- EAS ref alleles (case ref = b)\n    SUM(CASE WHEN si.\"Super_Population\" = 'EAS'\n             THEN 2 - (c.value:genotype[0]::INT + c.value:genotype[1]::INT)\n             ELSE 0 END) AS b,\n    -- non-EAS alt alleles (control alt = c)\n    SUM(CASE WHEN si.\"Super_Population\" != 'EAS'\n             THEN c.value:genotype[0]::INT + c.value:genotype[1]::INT\n             ELSE 0 END) AS cc,\n    -- non-EAS ref alleles (control ref = d)\n    SUM(CASE WHEN si.\"Super_Population\" != 'EAS'\n             THEN 2 - (c.value:genotype[0]::INT + c.value:genotype[1]::INT)\n             ELSE 0 END) AS d\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" si\n    ON c.value:call_set_name::STRING = si.\"Sample\"\n  WHERE v.\"reference_name\" = '12'\n  GROUP BY v.\"start\", v.\"end\"\n),\nchi2_calc AS (\n  SELECT\n    start_pos,\n    end_pos,\n    a, b, cc, d,\n    (a + b + cc + d) AS N,\n    (a + b) AS R1,\n    (cc + d) AS R2,\n    (a + cc) AS C1,\n    (b + d) AS C2,\n    -- Expected counts\n    (a + b) * (a + cc) * 1.0 / (a + b + cc + d) AS E_a,\n    (a + b) * (b + d) * 1.0 / (a + b + cc + d) AS E_b,\n    (cc + d) * (a + cc) * 1.0 / (a + b + cc + d) AS E_c,\n    (cc + d) * (b + d) * 1.0 / (a + b + cc + d) AS E_d,\n    -- Chi-squared with Yates' correction\n    CASE \n      WHEN (a + b) * (cc + d) * (a + cc) * (b + d) = 0 THEN 0\n      ELSE POWER(GREATEST(ABS(a * d - b * cc) - (a + b + cc + d) / 2.0, 0), 2)\n           * (a + b + cc + d)\n           / ((a + b) * (cc + d) * (a + cc) * (b + d))\n    END AS CHI2\n  FROM allele_counts\n)\nSELECT\n  start_pos AS \"start\",\n  end_pos AS \"end\",\n  CHI2 AS \"CHI2\"\nFROM chi2_calc\nWHERE E_a >= 5 AND E_b >= 5 AND E_c >= 5 AND E_d >= 5\n  AND CHI2 >= 29.71679\nORDER BY CHI2 DESC;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH allele_counts AS (\n  SELECT \n    v.\"start\" AS start_pos,\n    v.\"end\" AS end_pos,\n    SUM(CASE WHEN s.\"Super_Population\" = 'EAS' \n             THEN 2 - (c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT) \n             ELSE 0 END) AS case_ref,\n    SUM(CASE WHEN s.\"Super_Population\" = 'EAS' \n             THEN c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT \n             ELSE 0 END) AS case_alt,\n    SUM(CASE WHEN s.\"Super_Population\" != 'EAS' \n             THEN 2 - (c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT) \n             ELSE 0 END) AS ctrl_ref,\n    SUM(CASE WHEN s.\"Super_Population\" != 'EAS' \n             THEN c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT \n             ELSE 0 END) AS ctrl_alt\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" s\n    ON c.value:\"call_set_name\"::STRING = s.\"Sample\"\n  WHERE v.\"reference_name\" = '12'\n  GROUP BY v.\"start\", v.\"end\"\n),\nchi_calc AS (\n  SELECT\n    start_pos AS \"start\",\n    end_pos AS \"end\",\n    case_ref AS a,\n    case_alt AS b,\n    ctrl_ref AS c,\n    ctrl_alt AS d,\n    (case_ref + case_alt + ctrl_ref + ctrl_alt) AS N,\n    -- Row totals\n    (case_ref + case_alt) AS R1,\n    (ctrl_ref + ctrl_alt) AS R2,\n    -- Column totals\n    (case_ref + ctrl_ref) AS C1,\n    (case_alt + ctrl_alt) AS C2,\n    -- Expected counts\n    ((case_ref + case_alt) * (case_ref + ctrl_ref)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_a,\n    ((case_ref + case_alt) * (case_alt + ctrl_alt)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_b,\n    ((ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_c,\n    ((ctrl_ref + ctrl_alt) * (case_alt + ctrl_alt)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_d,\n    -- Chi-squared with Yates correction\n    (case_ref + case_alt + ctrl_ref + ctrl_alt) * \n      POWER(\n        ABS(case_ref * ctrl_alt - case_alt * ctrl_ref) - (case_ref + case_alt + ctrl_ref + ctrl_alt) / 2.0, \n        2\n      ) / \n      NULLIF(\n        (case_ref + case_alt) * 1.0 * (ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref) * (case_alt + ctrl_alt), \n        0\n      ) AS \"CHI2\"\n  FROM allele_counts\n)\nSELECT\n  \"start\",\n  \"end\",\n  \"CHI2\"\nFROM chi_calc\nWHERE E_a >= 5 AND E_b >= 5 AND E_c >= 5 AND E_d >= 5\n  AND \"CHI2\" >= 29.71679\nORDER BY \"CHI2\" DESC;" = sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH allele_counts AS (\n  SELECT\n    v.\"start\" AS start_pos,\n    v.\"end\" AS end_pos,\n    SUM(CASE WHEN si.\"Super_Population\" = 'EAS' THEN\n      (CASE WHEN f.value:genotype[0]::INT = 0 THEN 1 ELSE 0 END) +\n      (CASE WHEN f.value:genotype[1]::INT = 0 THEN 1 ELSE 0 END)\n    ELSE 0 END) AS case_ref,\n    SUM(CASE WHEN si.\"Super_Population\" = 'EAS' THEN\n      (CASE WHEN f.value:genotype[0]::INT > 0 THEN 1 ELSE 0 END) +\n      (CASE WHEN f.value:genotype[1]::INT > 0 THEN 1 ELSE 0 END)\n    ELSE 0 END) AS case_alt,\n    SUM(CASE WHEN si.\"Super_Population\" != 'EAS' THEN\n      (CASE WHEN f.value:genotype[0]::INT = 0 THEN 1 ELSE 0 END) +\n      (CASE WHEN f.value:genotype[1]::INT = 0 THEN 1 ELSE 0 END)\n    ELSE 0 END) AS ctrl_ref,\n    SUM(CASE WHEN si.\"Super_Population\" != 'EAS' THEN\n      (CASE WHEN f.value:genotype[0]::INT > 0 THEN 1 ELSE 0 END) +\n      (CASE WHEN f.value:genotype[1]::INT > 0 THEN 1 ELSE 0 END)\n    ELSE 0 END) AS ctrl_alt\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") f\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" si\n    ON f.value:call_set_name::STRING = si.\"Sample\"\n  WHERE v.\"reference_name\" = '12'\n  GROUP BY v.\"start\", v.\"end\"\n),\nchi2_calc AS (\n  SELECT\n    start_pos,\n    end_pos,\n    case_ref, case_alt, ctrl_ref, ctrl_alt,\n    (case_ref + case_alt + ctrl_ref + ctrl_alt) AS N,\n    (case_ref + case_alt) AS R1,\n    (ctrl_ref + ctrl_alt) AS R2,\n    (case_ref + ctrl_ref) AS C1,\n    (case_alt + ctrl_alt) AS C2,\n    -- Expected values\n    ((case_ref + case_alt) * (case_ref + ctrl_ref)) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E11,\n    ((case_ref + case_alt) * (case_alt + ctrl_alt)) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E12,\n    ((ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref)) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E21,\n    ((ctrl_ref + ctrl_alt) * (case_alt + ctrl_alt)) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt), 0) AS E22,\n    -- Chi-squared with Yates correction\n    (case_ref + case_alt + ctrl_ref + ctrl_alt)::FLOAT *\n    POWER(\n      GREATEST(ABS(case_ref::FLOAT * ctrl_alt::FLOAT - case_alt::FLOAT * ctrl_ref::FLOAT) - (case_ref + case_alt + ctrl_ref + ctrl_alt)::FLOAT / 2.0, 0),\n      2\n    ) /\n    NULLIF(\n      (case_ref + case_alt)::FLOAT * (ctrl_ref + ctrl_alt)::FLOAT * (case_ref + ctrl_ref)::FLOAT * (case_alt + ctrl_alt)::FLOAT,\n      0\n    ) AS CHI2\n  FROM allele_counts\n)\nSELECT\n  start_pos AS \"start\",\n  end_pos AS \"end\",\n  CHI2 AS \"CHI2\"\nFROM chi2_calc\nWHERE E11 >= 5 AND E12 >= 5 AND E21 >= 5 AND E22 >= 5\n  AND CHI2 >= 29.71679\nORDER BY CHI2 DESC\n;" := by
  first | sql_equiv | sorry

theorem eq_0_3 : ∀ t,
    (sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH allele_counts AS (\n  SELECT \n    v.\"start\" AS start_pos,\n    v.\"end\" AS end_pos,\n    SUM(CASE WHEN s.\"Super_Population\" = 'EAS' \n             THEN 2 - (c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT) \n             ELSE 0 END) AS case_ref,\n    SUM(CASE WHEN s.\"Super_Population\" = 'EAS' \n             THEN c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT \n             ELSE 0 END) AS case_alt,\n    SUM(CASE WHEN s.\"Super_Population\" != 'EAS' \n             THEN 2 - (c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT) \n             ELSE 0 END) AS ctrl_ref,\n    SUM(CASE WHEN s.\"Super_Population\" != 'EAS' \n             THEN c.value:\"genotype\"[0]::INT + c.value:\"genotype\"[1]::INT \n             ELSE 0 END) AS ctrl_alt\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n  LATERAL FLATTEN(input => v.\"call\") c\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" s\n    ON c.value:\"call_set_name\"::STRING = s.\"Sample\"\n  WHERE v.\"reference_name\" = '12'\n  GROUP BY v.\"start\", v.\"end\"\n),\nchi_calc AS (\n  SELECT\n    start_pos AS \"start\",\n    end_pos AS \"end\",\n    case_ref AS a,\n    case_alt AS b,\n    ctrl_ref AS c,\n    ctrl_alt AS d,\n    (case_ref + case_alt + ctrl_ref + ctrl_alt) AS N,\n    -- Row totals\n    (case_ref + case_alt) AS R1,\n    (ctrl_ref + ctrl_alt) AS R2,\n    -- Column totals\n    (case_ref + ctrl_ref) AS C1,\n    (case_alt + ctrl_alt) AS C2,\n    -- Expected counts\n    ((case_ref + case_alt) * (case_ref + ctrl_ref)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_a,\n    ((case_ref + case_alt) * (case_alt + ctrl_alt)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_b,\n    ((ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_c,\n    ((ctrl_ref + ctrl_alt) * (case_alt + ctrl_alt)) * 1.0 / (case_ref + case_alt + ctrl_ref + ctrl_alt) AS E_d,\n    -- Chi-squared with Yates correction\n    (case_ref + case_alt + ctrl_ref + ctrl_alt) * \n      POWER(\n        ABS(case_ref * ctrl_alt - case_alt * ctrl_ref) - (case_ref + case_alt + ctrl_ref + ctrl_alt) / 2.0, \n        2\n      ) / \n      NULLIF(\n        (case_ref + case_alt) * 1.0 * (ctrl_ref + ctrl_alt) * (case_ref + ctrl_ref) * (case_alt + ctrl_alt), \n        0\n      ) AS \"CHI2\"\n  FROM allele_counts\n)\nSELECT\n  \"start\",\n  \"end\",\n  \"CHI2\"\nFROM chi_calc\nWHERE E_a >= 5 AND E_b >= 5 AND E_c >= 5 AND E_d >= 5\n  AND \"CHI2\" >= 29.71679\nORDER BY \"CHI2\" DESC;") t ~= (sql%([SAMPLE_INFO_schema, VARIANTS_schema]) "WITH flattened AS (\n  SELECT\n    v.\"start\",\n    v.\"end\",\n    c.value:\"call_set_name\"::STRING AS sample_name,\n    g.value::INT AS genotype_val\n  FROM \"_1000_GENOMES\".\"_1000_GENOMES\".\"VARIANTS\" v,\n    LATERAL FLATTEN(input => v.\"call\") c,\n    LATERAL FLATTEN(input => c.value:\"genotype\") g\n  WHERE v.\"reference_name\" = '12'\n),\nallele_counts AS (\n  SELECT\n    f.\"start\",\n    f.\"end\",\n    SUM(CASE WHEN si.\"Super_Population\" = 'EAS' AND f.genotype_val = 0 THEN 1 ELSE 0 END) AS case_ref,\n    SUM(CASE WHEN si.\"Super_Population\" = 'EAS' AND f.genotype_val > 0 THEN 1 ELSE 0 END) AS case_alt,\n    SUM(CASE WHEN si.\"Super_Population\" != 'EAS' AND f.genotype_val = 0 THEN 1 ELSE 0 END) AS ctrl_ref,\n    SUM(CASE WHEN si.\"Super_Population\" != 'EAS' AND f.genotype_val > 0 THEN 1 ELSE 0 END) AS ctrl_alt\n  FROM flattened f\n  JOIN \"_1000_GENOMES\".\"_1000_GENOMES\".\"SAMPLE_INFO\" si\n    ON f.sample_name = si.\"Sample\"\n  GROUP BY f.\"start\", f.\"end\"\n),\nchi_sq AS (\n  SELECT\n    \"start\",\n    \"end\",\n    case_ref::FLOAT AS a,\n    case_alt::FLOAT AS b,\n    ctrl_ref::FLOAT AS c,\n    ctrl_alt::FLOAT AS d,\n    (case_ref + case_alt + ctrl_ref + ctrl_alt)::FLOAT AS N,\n    (case_ref + case_alt)::FLOAT AS R1,\n    (ctrl_ref + ctrl_alt)::FLOAT AS R2,\n    (case_ref + ctrl_ref)::FLOAT AS C1,\n    (case_alt + ctrl_alt)::FLOAT AS C2,\n    ((case_ref + case_alt)::FLOAT * (case_ref + ctrl_ref)::FLOAT) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt)::FLOAT, 0) AS E_case_ref,\n    ((case_ref + case_alt)::FLOAT * (case_alt + ctrl_alt)::FLOAT) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt)::FLOAT, 0) AS E_case_alt,\n    ((ctrl_ref + ctrl_alt)::FLOAT * (case_ref + ctrl_ref)::FLOAT) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt)::FLOAT, 0) AS E_ctrl_ref,\n    ((ctrl_ref + ctrl_alt)::FLOAT * (case_alt + ctrl_alt)::FLOAT) / NULLIF((case_ref + case_alt + ctrl_ref + ctrl_alt)::FLOAT, 0) AS E_ctrl_alt\n  FROM allele_counts\n)\nSELECT\n  \"start\",\n  \"end\",\n  POWER(\n    GREATEST(ABS(a * d - b * c) - N / 2.0, 0),\n    2\n  ) * N / NULLIF(R1 * R2 * C1 * C2, 0) AS CHI2\nFROM chi_sq\nWHERE E_case_ref >= 5\n  AND E_case_alt >= 5\n  AND E_ctrl_ref >= 5\n  AND E_ctrl_alt >= 5\n  AND POWER(\n    GREATEST(ABS(a * d - b * c) - N / 2.0, 0),\n    2\n  ) * N / NULLIF(R1 * R2 * C1 * C2, 0) >= 29.71679\nORDER BY CHI2 DESC;") t := by
