import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq287 — crossskill equivalence(s)

Question: Among all Utah ZIP codes, what is the 2017 American Community Survey employment rate for the population aged 16 or older in the ZIP code that has the fewest FDIC-insured bank locations?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq287

CREATE TABLE LOCATIONS («fdic_certificate_number» STRING, «institution_name» STRING, «branch_name» STRING, «branch_number» STRING, «main_office» BOOL, «branch_address» STRING, «branch_city» STRING, «zip_code» STRING, «branch_county» STRING, «county_fips_code» STRING, «state» STRING, «state_name» STRING, «institution_class» STRING, «cbsa_fips_code» STRING, «cbsa_name» STRING, «cbsa_division_flag» BOOL, «cbsa_division_fips_code» INT, «cbsa_division_name» STRING, «cbsa_metro_flag» BOOL, «cbsa_metro_fips_code» STRING, «cbsa_metro_name» STRING, «cbsa_micro_flag» BOOL, «csa_flag» BOOL, «csa_fips_code» STRING, «csa_name» STRING, «date_established» STRING, «fdic_uninum» STRING, «last_updated» STRING, «service_type» STRING, «branch_fdic_uninum» STRING)
CREATE TABLE ZIP_CODES («zip_code» STRING, «city» STRING, «county» STRING, «state_fips_code» STRING, «state_code» STRING, «state_name» STRING, «fips_class_code» STRING, «mtfcc_feature_class_code» STRING, «functional_status» STRING, «area_land_meters» FLOAT, «area_water_meters» FLOAT, «internal_point_lat» FLOAT, «internal_point_lon» FLOAT, «internal_point_geom» STRING, «zip_code_geom» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([LOCATIONS_schema, ZIP_CODES_schema]) "WITH utah_zips AS (\n  SELECT \"zip_code\"\n  FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n  WHERE \"state_code\" = 'UT'\n),\nbank_counts AS (\n  SELECT\n    uz.\"zip_code\",\n    COUNT(loc.\"zip_code\") AS bank_location_count\n  FROM utah_zips uz\n  LEFT JOIN \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\" loc\n    ON uz.\"zip_code\" = loc.\"zip_code\"\n  GROUP BY uz.\"zip_code\"\n),\nfewest_bank_zip AS (\n  SELECT \"zip_code\"\n  FROM bank_counts\n  ORDER BY bank_location_count ASC, \"zip_code\" ASC\n  LIMIT 1\n)\nSELECT\n  acs.\"employed_pop\" / acs.\"pop_16_over\" AS EMPLOYMENT_RATE\nFROM fewest_bank_zip fbz\nJOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"ZIP_CODES_2017_5YR\" acs\n  ON fbz.\"zip_code\" = acs.\"geo_id\";") t ~= (sql%([LOCATIONS_schema, ZIP_CODES_schema]) "WITH utah_zip_bank_counts AS (\n  SELECT \n    z.\"zip_code\",\n    COUNT(l.\"zip_code\") AS num_locations\n  FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" z\n  LEFT JOIN \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\" l\n    ON z.\"zip_code\" = l.\"zip_code\"\n  WHERE z.\"state_code\" = 'UT'\n  GROUP BY z.\"zip_code\"\n),\nmin_location_zip AS (\n  SELECT \"zip_code\"\n  FROM utah_zip_bank_counts\n  WHERE num_locations = (SELECT MIN(num_locations) FROM utah_zip_bank_counts)\n  ORDER BY \"zip_code\" ASC\n  LIMIT 1\n)\nSELECT \n  a.\"employed_pop\" / NULLIF(a.\"pop_16_over\", 0) AS EMPLOYMENT_RATE\nFROM min_location_zip m\nJOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"ZIP_CODES_2017_5YR\" a\n  ON m.\"zip_code\" = a.\"geo_id\";") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([LOCATIONS_schema, ZIP_CODES_schema]) "WITH utah_zips AS (\n  SELECT \"zip_code\"\n  FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n  WHERE \"state_code\" = 'UT'\n),\nbank_counts AS (\n  SELECT\n    uz.\"zip_code\",\n    COUNT(loc.\"zip_code\") AS bank_location_count\n  FROM utah_zips uz\n  LEFT JOIN \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\" loc\n    ON uz.\"zip_code\" = loc.\"zip_code\"\n  GROUP BY uz.\"zip_code\"\n),\nfewest_bank_zip AS (\n  SELECT \"zip_code\"\n  FROM bank_counts\n  ORDER BY bank_location_count ASC, \"zip_code\" ASC\n  LIMIT 1\n)\nSELECT\n  acs.\"employed_pop\" / acs.\"pop_16_over\" AS EMPLOYMENT_RATE\nFROM fewest_bank_zip fbz\nJOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"ZIP_CODES_2017_5YR\" acs\n  ON fbz.\"zip_code\" = acs.\"geo_id\";" = sql%([LOCATIONS_schema, ZIP_CODES_schema]) "WITH utah_zips AS (\n    SELECT DISTINCT \"zip_code\"\n    FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n    WHERE \"state_code\" = 'UT'\n),\nbank_counts AS (\n    SELECT \n        uz.\"zip_code\",\n        COUNT(l.\"zip_code\") AS bank_count\n    FROM utah_zips uz\n    LEFT JOIN \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\" l\n        ON uz.\"zip_code\" = l.\"zip_code\"\n    GROUP BY uz.\"zip_code\"\n),\nfewest_zip AS (\n    SELECT \"zip_code\"\n    FROM bank_counts\n    ORDER BY bank_count ASC, \"zip_code\" ASC\n    LIMIT 1\n)\nSELECT \n    acs.\"employed_pop\" / acs.\"pop_16_over\" AS \"EMPLOYMENT_RATE\"\nFROM fewest_zip fz\nJOIN \"CENSUS_BUREAU_ACS_1\".\"CENSUS_BUREAU_ACS\".\"ZIP_CODES_2017_5YR\" acs\n    ON fz.\"zip_code\" = acs.\"geo_id\";" := by
  first | sql_equiv | sorry

