    sql%([LOCATIONS_schema, ZIP_CODES_schema]) "WITH utah_zips AS (\n  SELECT \"zip_code\"\n  FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n  WHERE \"state_code\" = 'UT'\n),\nbank_counts AS (\n  SELECT\n    uz.\"zip_code\",\n    COUNT(loc.\"zip_code\") AS bank_location_count\n  FROM utah_zips uz\n  LEFT JOIN \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\" loc\n    ON uz.\"zip_code\" = loc.\"zip_code\"\n  GROUP BY uz.\"zip_code\"\n),\nfewest_bank_zip AS (\n  SELECT \"zip_code\"\n  FROM bank_counts\n  ORDER BY bank_location_count ASC, \"zip_code\" ASC\n  LIMIT 1\n)\nSELECT\n  acs.\"employed_pop\" / acs.\"pop_16_over\" AS EMPLOYMENT_RATE\nFROM fewest_bank_zip fbz\nJOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"ZIP_CODES_2017_5YR\" acs\n  ON fbz.\"zip_code\" = acs.\"geo_id\";" = sql%([LOCATIONS_schema, ZIP_CODES_schema]) "WITH utah_zips AS (\n    SELECT \"zip_code\"\n    FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n    WHERE \"state_code\" = 'UT'\n),\nbank_counts AS (\n    SELECT\n        uz.\"zip_code\",\n        COUNT(loc.\"zip_code\") AS bank_count\n    FROM utah_zips uz\n    LEFT JOIN \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\" loc\n        ON loc.\"zip_code\" = uz.\"zip_code\"\n    GROUP BY uz.\"zip_code\"\n    ORDER BY bank_count ASC, uz.\"zip_code\" ASC\n    LIMIT 1\n)\nSELECT\n    acs.\"employed_pop\" / acs.\"pop_16_over\" AS EMPLOYMENT_RATE\nFROM bank_counts bc\nJOIN \"CENSUS_BUREAU_ACS_1\".\"CENSUS_BUREAU_ACS\".\"ZIP_CODES_2017_5YR\" acs\n    ON acs.\"geo_id\" = bc.\"zip_code\";" := by
