rances FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20210102\" AS e, LATERAL UNNEST(input => e.EVENT_PARAMS) AS ep(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE e.EVENT_NAME = 'page_view' GROUP BY e.USER_PSEUDO_ID, e.EVENT_TIMESTAMP), home_landing_sessions AS (SELECT DISTINCT USER_PSEUDO_ID, ga_session_id FROM page_views WHERE page_title = 'Home' AND entrances = 1), session_checkout AS (SELECT DISTINCT USER_PSEUDO_ID, ga_session_id FROM page_views WHERE page_title = 'Checkout Confirmation') SELECT CAST(100.0 * (SELECT COUNT(*) FROM home_landing_sessions AS h INNER JOIN session_checkout AS c ON h.USER_PSEUDO_ID = c.USER_PSEUDO_ID AND h.ga_session_id = c.ga_session_id) AS DOUBLE PRECISION) / NULLIF((SELECT COUNT(*) FROM home_landing_sessions), 0) AS \"CONVERSION_RATE\"") t := by
