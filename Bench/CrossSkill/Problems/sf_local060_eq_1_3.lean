theorem eq (t0 : TableRel CUSTOMERS_schema) (t1 : TableRel PRODUCTS_schema) (t2 : TableRel TIMES_schema) (t3 : TableRel PROMOTIONS_schema) (t4 : TableRel SALES_schema) :
    (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "WITH base_sales AS (SELECT s.\"prod_id\", s.\"cust_id\", s.\"amount_sold\", t.\"calendar_year\", t.\"calendar_quarter_number\", c.\"cust_city\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" WHERE s.\"promo_id\" = 999 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND c.\"country_id\" = (SELECT \"country_id\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" WHERE \"country_iso_code\" = 'US')), city_sales AS (SELECT \"cust_city\", SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS sales_2019, SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS sales_2020 FROM base_sales GROUP BY \"cust_city\"), qualifying_cities AS (SELECT \"cust_city\" FROM city_sales WHERE sales_2019 > 0 AND sales_2020 >= 1.2 * sales_2019), sales_in_qualifying_cities AS (SELECT b.\"prod_id\", b.\"amount_sold\", b.\"calendar_year\" FROM base_sales AS b JOIN qualifying_cities AS qc ON b.\"cust_city\" = qc.\"cust_city\"), product_total_sales AS (SELECT \"prod_id\", SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS sales_2019, SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS sales_2020, SUM(\"amount_sold\") AS total_sales FROM sales_in_qualifying_cities GROUP BY \"prod_id\"), total_all_sales AS (SELECT SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS total_2019, SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS total_2020 FROM sales_in_qualifying_cities), product_ranked AS (SELECT pt.\"prod_id\", pt.sales_2019, pt.sales_2020, pt.total_sales, ROW_NUMBER() OVER (ORDER BY pt.total_sales DESC) AS rnk, COUNT(*) OVER () AS cnt FROM product_total_sales AS pt), top_products AS (SELECT * FROM product_ranked WHERE rnk <= CEIL(0.2 * cnt)) SELECT tp.\"prod_id\", p.\"prod_name\", CAST(tp.sales_2019 AS DOUBLE PRECISION) / tas.total_2019 AS SHARE_2019, CAST(tp.sales_2020 AS DOUBLE PRECISION) / tas.total_2020 AS SHARE_2020, (CAST(tp.sales_2020 AS DOUBLE PRECISION) / tas.total_2020) - (CAST(tp.sales_2019 AS DOUBLE PRECISION) / tas.total_2019) AS SHARE_CHANGE FROM top_products AS tp CROSS JOIN total_all_sales AS tas JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON tp.\"prod_id\" = p.\"prod_id\" ORDER BY SHARE_CHANGE DESC") t0 t1 t2 t3 t4
  ~= (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "/* Step 1: Base sales data for US customers in Q4 2019 and Q4 2020, no promotions */ WITH base_sales AS (SELECT s.\"prod_id\", c.\"cust_city\", t.\"calendar_quarter_desc\", s.\"amount_sold\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" AS co ON c.\"country_id\" = co.\"country_id\" WHERE co.\"country_name\" = 'United States of America' AND t.\"calendar_quarter_desc\" IN ('2019-04', '2020-04') AND s.\"promo_id\" = 999), city_quarter_sales /* Step 2: City-level total sales per quarter */ AS (SELECT \"cust_city\", \"calendar_quarter_desc\", SUM(\"amount_sold\") AS total_sales FROM base_sales GROUP BY \"cust_city\", \"calendar_quarter_desc\"), growing_cities /* Step 3: Find cities with >= 20% growth from Q4 2019 to Q4 2020 */ AS (SELECT q19.\"cust_city\" FROM city_quarter_sales AS q19 JOIN city_quarter_sales AS q20 ON q19.\"cust_city\" = q20.\"cust_city\" WHERE q19.\"calendar_quarter_desc\" = '2019-04' AND q20.\"calendar_quarter_desc\" = '2020-04' AND q20.total_sales >= q19.total_sales * 1.20), filtered_sales /* Step 4: Filter base sales to only growing cities */ AS (SELECT bs.\"prod_id\", bs.\"calendar_quarter_desc\", bs.\"amount_sold\" FROM base_sales AS bs WHERE bs.\"cust_city\" IN (SELECT \"cust_city\" FROM growing_cities)), product_total_sales /* Step 5: Rank products by total sales across both quarters, take top 20% */ AS (SELECT \"prod_id\", SUM(\"amount_sold\") AS total_prod_sales FROM filtered_sales GROUP BY \"prod_id\"), product_ranked AS (SELECT \"prod_id\", total_prod_sales, NTILE(5) OVER (ORDER BY total_prod_sales DESC) AS quintile FROM product_total_sales), top_products AS (SELECT \"prod_id\" FROM product_ranked WHERE quintile = 1), quarter_totals /* Step 6: Compute share of each top product in each quarter */ AS (SELECT \"calendar_quarter_desc\", SUM(\"amount_sold\") AS quarter_total FROM filtered_sales GROUP BY \"calendar_quarter_desc\"), product_quarter_sales AS (SELECT fs.\"prod_id\", fs.\"calendar_quarter_desc\", SUM(fs.\"amount_sold\") AS prod_quarter_sales FROM filtered_sales AS fs WHERE fs.\"prod_id\" IN (SELECT \"prod_id\" FROM top_products) GROUP BY fs.\"prod_id\", fs.\"calendar_quarter_desc\"), shares AS (SELECT pqs.\"prod_id\", pqs.\"calendar_quarter_desc\", CAST(pqs.prod_quarter_sales AS DOUBLE PRECISION) / qt.quarter_total AS share FROM product_quarter_sales AS pqs JOIN quarter_totals AS qt ON pqs.\"calendar_quarter_desc\" = qt.\"calendar_quarter_desc\"), share_pivot /* Step 7: Pivot to get share_2019 and share_2020 */ AS (SELECT \"prod_id\", MAX(CASE WHEN \"calendar_quarter_desc\" = '2019-04' THEN share ELSE 0 END) AS SHARE_2019, MAX(CASE WHEN \"calendar_quarter_desc\" = '2020-04' THEN share ELSE 0 END) AS SHARE_2020 FROM shares GROUP BY \"prod_id\") /* Final output */ SELECT sp.\"prod_id\", p.\"prod_name\", sp.SHARE_2019, sp.SHARE_2020, (sp.SHARE_2020 - sp.SHARE_2019) AS SHARE_CHANGE FROM share_pivot AS sp JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON sp.\"prod_id\" = p.\"prod_id\" ORDER BY SHARE_CHANGE DESC") t0 t1 t2 t3 t4
