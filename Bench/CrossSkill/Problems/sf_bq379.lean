    sql%([TARGETS_schema, ASSOCIATIONBYOVERALLDIRECT_schema, DISEASES_schema]) "WITH psoriasis_scores AS (SELECT a.\"targetId\", a.\"score\" FROM \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"ASSOCIATIONBYOVERALLDIRECT\" AS a JOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"DISEASES\" AS d ON a.\"diseaseId\" = d.\"id\" WHERE LOWER(d.\"name\") = 'psoriasis'), mean_calc AS (SELECT AVG(\"score\") AS mean_score FROM psoriasis_scores) SELECT t.\"approvedSymbol\" AS \"OUTPUT\" FROM psoriasis_scores AS ps CROSS JOIN mean_calc AS mc JOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"TARGETS\" AS t ON ps.\"targetId\" = t.\"id\" ORDER BY ABS(ps.\"score\" - mc.mean_score) ASC LIMIT 1" = sql%([TARGETS_schema, ASSOCIATIONBYOVERALLDIRECT_schema, DISEASES_schema]) "WITH psoriasis_scores AS (SELECT a.\"targetId\", a.\"score\" FROM \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"ASSOCIATIONBYOVERALLDIRECT\" AS a WHERE a.\"diseaseId\" = 'EFO_0000676'), mean_score AS (SELECT AVG(\"score\") AS avg_score FROM psoriasis_scores) SELECT t.\"approvedSymbol\" FROM psoriasis_scores AS ps JOIN \"OPEN_TARGETS_PLATFORM_1\".\"PLATFORM\".\"TARGETS\" AS t ON t.\"id\" = ps.\"targetId\" CROSS JOIN mean_score AS m ORDER BY ABS(ps.\"score\" - m.avg_score) ASC LIMIT 1" := by
  first | sql_equiv | sorry

