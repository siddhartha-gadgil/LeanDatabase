 ON pqs.\"calendar_quarter_desc\" = qt.\"calendar_quarter_desc\"\n),\n\n-- Step 7: Pivot to get share_2019 and share_2020\nshare_pivot AS (\n    SELECT\n        \"prod_id\",\n        MAX(CASE WHEN \"calendar_quarter_desc\" = '2019-04' THEN share ELSE 0 END) AS SHARE_2019,\n        MAX(CASE WHEN \"calendar_quarter_desc\" = '2020-04' THEN share ELSE 0 END) AS SHARE_2020\n    FROM shares\n    GROUP BY \"prod_id\"\n)\n\n-- Final output\nSELECT\n    sp.\"prod_id\",\n    p.\"prod_name\",\n    sp.SHARE_2019,\n    sp.SHARE_2020,\n    (sp.SHARE_2020 - sp.SHARE_2019) AS SHARE_CHANGE\nFROM share_pivot sp\nJOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p\n    ON sp.\"prod_id\" = p.\"prod_id\"\nORDER BY SHARE_CHANGE DESC;") t := by
