lendar_year\" IN (2019, 2020)\n    AND s.\"promo_id\" = 999\n  GROUP BY t.\"calendar_year\"\n),\nshares AS (\n  -- Step 8: Compute share per product per quarter\n  SELECT \n    pqs.\"prod_id\",\n    pqs.\"prod_name\",\n    pqs.\"calendar_year\",\n    pqs.product_quarter_sales / tqs.total_quarter_sales AS share\n  FROM product_quarterly_sales pqs\n  JOIN total_quarterly_sales tqs ON pqs.\"calendar_year\" = tqs.\"calendar_year\"\n)\n-- Step 9: Pivot and compute share change\nSELECT \n  s2019.\"prod_id\",\n  s2019.\"prod_name\",\n  s2019.share AS SHARE_2019,\n  s2020.share AS SHARE_2020,\n  (s2020.share - s2019.share) AS SHARE_CHANGE\nFROM shares s2019\nJOIN shares s2020 \n  ON s2019.\"prod_id\" = s2020.\"prod_id\"\nWHERE s2019.\"calendar_year\" = 2019 \n  AND s2020.\"calendar_year\" = 2020\nORDER BY SHARE_CHANGE DESC;") t ~= (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "-- Step 1: Base sales data for US customers in Q4 2019 and Q4 2020, no promotions\nWITH base_sales AS (\n    SELECT\n        s.\"prod_id\",\n        c.\"cust_city\",\n        t.\"calendar_quarter_desc\",\n        s.\"amount_sold\"\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t\n        ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c\n        ON s.\"cust_id\" = c.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co\n        ON c.\"country_id\" = co.\"country_id\"\n    WHERE co.\"country_name\" = 'United States of America'\n      AND t.\"calendar_quarter_desc\" IN ('2019-04', '2020-04')\n      AND s.\"promo_id\" = 999\n),\n\n-- Step 2: City-level total sales per quarter\ncity_quarter_sales AS (\n    SELECT\n        \"cust_city\",\n        \"calendar_quarter_desc\",\n        SUM(\"amount_sold\") AS total_sales\n    FROM base_sales\n    GROUP BY \"cust_city\", \"calendar_quarter_desc\"\n),\n\n-- Step 