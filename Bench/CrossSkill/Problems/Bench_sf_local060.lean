-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "WITH qualifying_cities AS (\n  -- Step 1: Get city-level sales for Q4 2019 and Q4 2020 (no promotions, US only)\n  SELECT \n    c.\"cust_city\", \n    t.\"calendar_year\", \n    SUM(s.\"amount_sold\") AS total_sales\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  WHERE c.\"country_id\" = 52790\n    AND t.\"calendar_quarter_number\" = 4\n    AND t.\"calendar_year\" IN (2019, 2020)\n    AND s.\"promo_id\" = 999\n  GROUP BY c.\"cust_city\", t.\"calendar_year\"\n),\ncities_with_growth AS (\n  -- Step 2: Filter cities with >= 20% sales growth from Q4 2019 to Q4 2020\n  SELECT q19.\"cust_city\"\n  FROM qualifying_cities q19\n  JOIN qualifying_cities q20 \n    ON q19.\"cust_city\" = q20.\"cust_city\"\n  WHERE q19.\"calendar_year\" = 2019 \n    AND q20.\"calendar_year\" = 2020\n    AND (q20.total_sales - q19.total_sales) / q19.total_sales >= 0.20\n),\nproduct_overall_sales AS (\n  -- Step 3: Compute overall sales per product in qualifying cities (Q4 2019 + Q4 2020, no promo)\n  SELECT \n    s.\"prod_id\", \n    SUM(s.\"amount_sold\") AS total_product_sales\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  JOIN cities_with_growth cg ON c.\"cust_city\" = cg.\"cust_city\"\n  WHERE c.\"country_id\" = 52790\n    AND t.\"calendar_quarter_number\" = 4\n    AND t.\"calendar_year\" IN (2019, 2020)\n    AND s.\"promo_id\" = 999\n  GROUP BY s.\"prod_id\"\n),\nall_products_ranked AS (\n  -- Step 4: Rank ALL products (including those with 0 sales) and take top 20%\n  SELECT \n    p.\"prod_id\", \n    p.\"prod_name\",\n    COALESCE(ps.total_product_sales, 0) AS total_product_sales,\n    ROW_NUMBER() OVER (ORDER BY COALESCE(ps.total_product_sales, 0) DESC) AS rn\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p\n  LEFT JOIN product_overall_sales ps ON p.\"prod_id\" = ps.\"prod_id\"\n),\ntop_products AS (\n  -- Step 5: Take top 20% = FLOOR(total_products * 0.2)\n  SELECT \"prod_id\", \"prod_name\"\n  FROM all_products_ranked\n  WHERE rn <= FLOOR((SELECT COUNT(*) FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\") * 0.2)\n),\nproduct_quarterly_sales AS (\n  -- Step 6: Compute each top product's sales per quarter in qualifying cities\n  SELECT \n    tp.\"prod_id\",\n    tp.\"prod_name\",\n    t.\"calendar_year\",\n    SUM(s.\"amount_sold\") AS product_quarter_sales\n  FROM top_products tp\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s ON tp.\"prod_id\" = s.\"prod_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  JOIN cities_with_growth cg ON c.\"cust_city\" = cg.\"cust_city\"\n  WHERE c.\"country_id\" = 52790\n    AND t.\"calendar_quarter_number\" = 4\n    AND t.\"calendar_year\" IN (2019, 2020)\n    AND s.\"promo_id\" = 999\n  GROUP BY tp.\"prod_id\", tp.\"prod_name\", t.\"calendar_year\"\n),\ntotal_quarterly_sales AS (\n  -- Step 7: Total sales per quarter in qualifying cities (denominator for share)\n  SELECT \n    t.\"calendar_year\",\n    SUM(s.\"amount_sold\") AS total_quarter_sales\n  FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n  JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n  JOIN cities_with_growth cg ON c.\"cust_city\" = cg.\"cust_city\"\n  WHERE c.\"country_id\" = 52790\n    AND t.\"calendar_quarter_number\" = 4\n    AND t.\"calendar_year\" IN (2019, 2020)\n    AND s.\"promo_id\" = 999\n  GROUP BY t.\"calendar_year\"\n),\nshares AS (\n  -- Step 8: Compute share per product per quarter\n  SELECT \n    pqs.\"prod_id\",\n    pqs.\"prod_name\",\n    pqs.\"calendar_year\",\n    pqs.product_quarter_sales / tqs.total_quarter_sales AS share\n  FROM product_quarterly_sales pqs\n  JOIN total_quarterly_sales tqs ON pqs.\"calendar_year\" = tqs.\"calendar_year\"\n)\n-- Step 9: Pivot and compute share change\nSELECT \n  s2019.\"prod_id\",\n  s2019.\"prod_name\",\n  s2019.share AS SHARE_2019,\n  s2020.share AS SHARE_2020,\n  (s2020.share - s2019.share) AS SHARE_CHANGE\nFROM shares s2019\nJOIN shares s2020 \n  ON s2019.\"prod_id\" = s2020.\"prod_id\"\nWHERE s2019.\"calendar_year\" = 2019 \n  AND s2020.\"calendar_year\" = 2020\nORDER BY SHARE_CHANGE DESC;") t ~= (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "WITH base_sales AS (\n    SELECT\n        s.\"prod_id\",\n        s.\"cust_id\",\n        s.\"amount_sold\",\n        t.\"calendar_year\",\n        t.\"calendar_quarter_number\",\n        c.\"cust_city\"\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" c ON s.\"cust_id\" = c.\"cust_id\"\n    WHERE s.\"promo_id\" = 999\n      AND t.\"calendar_quarter_number\" = 4\n      AND t.\"calendar_year\" IN (2019, 2020)\n      AND c.\"country_id\" = (SELECT \"country_id\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" WHERE \"country_iso_code\" = 'US')\n),\ncity_sales AS (\n    SELECT\n        \"cust_city\",\n        SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS sales_2019,\n        SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS sales_2020\n    FROM base_sales\n    GROUP BY \"cust_city\"\n),\nqualifying_cities AS (\n    SELECT \"cust_city\"\n    FROM city_sales\n    WHERE sales_2019 > 0\n      AND sales_2020 >= 1.2 * sales_2019\n),\nsales_in_qualifying_cities AS (\n    SELECT\n        b.\"prod_id\",\n        b.\"amount_sold\",\n        b.\"calendar_year\"\n    FROM base_sales b\n    JOIN qualifying_cities qc ON b.\"cust_city\" = qc.\"cust_city\"\n),\nproduct_total_sales AS (\n    SELECT\n        \"prod_id\",\n        SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS sales_2019,\n        SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS sales_2020,\n        SUM(\"amount_sold\") AS total_sales\n    FROM sales_in_qualifying_cities\n    GROUP BY \"prod_id\"\n),\ntotal_all_sales AS (\n    SELECT\n        SUM(CASE WHEN \"calendar_year\" = 2019 THEN \"amount_sold\" ELSE 0 END) AS total_2019,\n        SUM(CASE WHEN \"calendar_year\" = 2020 THEN \"amount_sold\" ELSE 0 END) AS total_2020\n    FROM sales_in_qualifying_cities\n),\nproduct_ranked AS (\n    SELECT\n        pt.\"prod_id\",\n        pt.sales_2019,\n        pt.sales_2020,\n        pt.total_sales,\n        ROW_NUMBER() OVER (ORDER BY pt.total_sales DESC) AS rnk,\n        COUNT(*) OVER () AS cnt\n    FROM product_total_sales pt\n),\ntop_products AS (\n    SELECT *\n    FROM product_ranked\n    WHERE rnk <= CEIL(0.2 * cnt)\n)\nSELECT\n    tp.\"prod_id\",\n    p.\"prod_name\",\n    tp.sales_2019 / tas.total_2019 AS SHARE_2019,\n    tp.sales_2020 / tas.total_2020 AS SHARE_2020,\n    (tp.sales_2020 / tas.total_2020) - (tp.sales_2019 / tas.total_2019) AS SHARE_CHANGE\nFROM top_products tp\nCROSS JOIN total_all_sales tas\nJOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" p ON tp.\"prod_id\" = p.\"prod_id\"\nORDER BY SHARE_CHANGE DESC") t := by
