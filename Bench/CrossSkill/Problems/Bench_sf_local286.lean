namespace Bench_sf_local286

CREATE TABLE ORDER_ITEMS («index» INT, «order_id» STRING, «order_item_id» INT, «product_id» STRING, «seller_id» STRING, «shipping_limit_date» STRING, «price» FLOAT, «freight_value» FLOAT)
