\".\"PRODUCTS\" p \n        ON oi.\"product_id\" = p.\"product_id\"\n    LEFT JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"PRODUCT_CATEGORY_NAME_TRANSLATION\" t \n        ON p.\"product_category_name\" = t.\"product_category_name\"\n    GROUP BY oi.\"seller_id\", t.\"product_category_name_english\"\n)\nSELECT\n    ss.\"seller_id\" AS \"SELLER_ID\",\n    ss.\"TOTAL_QUANTITY_SOLD\",\n    ss.\"TOTAL_SALES\",\n    ss.\"AVERAGE_ITEM_PRICE\",\n    sr.\"AVERAGE_REVIEW_SCORE\",\n    sp.\"AVERAGE_PACKING_TIME_HOURS\",\n    sc.\"product_category_name_english\" AS \"TOP_CATEGORIES_ENGLISH\"\nFROM seller_sales ss\nLEFT JOIN seller_reviews sr ON ss.\"seller_id\" = sr.\"seller_id\"\nLEFT JOIN seller_packing sp ON ss.\"seller_id\" = sp.\"seller_id\"\nLEFT JOIN seller_categories sc ON ss.\"seller_id\" = sc.\"seller_id\" AND sc.rn = 1\nORDER BY ss.\"TOTAL_SALES\" DESC;") t ~= (sql%([ORDER_ITEMS_schema, PRODUCT_CATEGORY_NAME_TRANSLATION_schema, ORDERS_schema, ORDER_REVIEWS_schema, PRODUCTS_schema]) "WITH seller_agg AS (\n    SELECT\n        oi.\"seller_id\",\n        COUNT(*) AS \"TOTAL_QUANTITY_SOLD\",\n        SUM(oi.\"price\") AS \"TOTAL_SALES\",\n        AVG(oi.\"price\") AS \"AVERAGE_ITEM_PRICE\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    GROUP BY oi.\"seller_id\"\n    HAVING COUNT(*) > 100\n),\nreview_agg AS (\n    SELECT\n        oi.\"seller_id\",\n        AVG(r.\"review_score\") AS \"AVERAGE_REVIEW_SCORE\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_REVIEWS\" r\n        ON oi.\"order_id\" = r.\"order_id\"\n    GROUP BY oi.\"seller_id\"\n),\npacking_agg AS (\n    SELECT\n        oi.\"seller_id\",\n        AVG(DATEDIFF('hour',\n            TO_TIMESTAMP(NULLIF(o.\"order_approved_at\", '')),\n            TO_TIMESTAMP(NULLIF(o.\"order_delivered_carrier_date\", ''))\n        )) AS \"AVERAGE_PACKING_TIME_HOURS\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDERS\" o\n        ON oi.\"order_id\" = o.\"order_id\"\n    WHERE NULLIF(o.\"order_approved_at\", '') IS NOT NULL\n      AND NULLIF(o.\"order_delivered_carrier_date\", '') IS NOT NULL\n    GROUP BY oi.\"seller_id\"\n),\ncategory_counts AS (\n    SELECT\n        oi.\"seller_id\",\n        COALESCE(t.\"product_category_name_english\", p.\"product_category_name\") AS category_english,\n        COUNT(*) AS cnt\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"PRODUCTS\" p\n        ON oi.\"product_id\" = p.\"product_id\"\n    LEFT JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"PRODUCT_CATEGORY_NAME_TRANSLATION\" t\n        ON p.\"product_category_name\" = t.\"product_category_name\"\n    GROUP BY oi.\"seller_id\", COALESCE(t.\"product_category_name_english\", p.\"product_category_name\")\n),\ntop_category AS (\n    SELECT\n        \"seller_id\",\n        category_english AS \"TOP_CATEGORIES_ENGLISH\"\n    FROM category_counts\n    QUALIFY ROW_NUMBER() OVER (PARTITION BY \"seller_id\" ORDER BY cnt DESC) = 1\n)\nSELECT\n    sa.\"seller_id\" AS \"SELLER_ID\",\n    sa.\"TOTAL_QUANTITY_SOLD\",\n    sa.\"TOTAL_SALES\",\n    sa.\"AVERAGE_ITEM_PRICE\",\n    ra.\"AVERAGE_REVIEW_SCORE\",\n    pa.\"AVERAGE_PACKING_TIME_HOURS\",\n    tc.\"TOP_CATEGORIES_ENGLISH\"\nFROM seller_agg sa\nLEFT JOIN review_agg ra ON sa.\"seller_id\" = ra.\"seller_id\"\nLEFT JOIN packing_agg pa ON sa.\"seller_id\" = pa.\"seller_id\"\nLEFT JOIN top_category tc ON sa.\"seller_id\" = tc.\"seller_id\"\nORDER BY sa.\"TOTAL_QUANTITY_SOLD\" DESC;") t := by
