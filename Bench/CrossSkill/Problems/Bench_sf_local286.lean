    (sql%([ORDER_ITEMS_schema, PRODUCT_CATEGORY_NAME_TRANSLATION_schema, ORDERS_schema, ORDER_REVIEWS_schema, PRODUCTS_schema]) "WITH seller_items AS (\n    SELECT\n        oi.\"seller_id\",\n        COUNT(*) AS \"TOTAL_QUANTITY_SOLD\",\n        SUM(oi.\"price\") AS \"TOTAL_SALES\",\n        AVG(oi.\"price\") AS \"AVERAGE_ITEM_PRICE\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    GROUP BY oi.\"seller_id\"\n    HAVING COUNT(*) > 100\n),\nseller_reviews AS (\n    SELECT\n        oi.\"seller_id\",\n        AVG(CAST(r.\"review_score\" AS DECIMAL(18,12))) AS \"AVERAGE_REVIEW_SCORE\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_REVIEWS\" r\n        ON oi.\"order_id\" = r.\"order_id\"\n    GROUP BY oi.\"seller_id\"\n),\nseller_packing AS (\n    SELECT\n        oi.\"seller_id\",\n        AVG(DATEDIFF('hour', TO_TIMESTAMP(o.\"order_approved_at\"), TO_TIMESTAMP(o.\"order_delivered_carrier_date\"))) AS \"AVERAGE_PACKING_TIME_HOURS\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDERS\" o\n        ON oi.\"order_id\" = o.\"order_id\"\n    WHERE o.\"order_approved_at\" != ''\n      AND o.\"order_delivered_carrier_date\" != ''\n    GROUP BY oi.\"seller_id\"\n),\nseller_category AS (\n    SELECT\n        oi.\"seller_id\",\n        COALESCE(t.\"product_category_name_english\", '') AS category_english,\n        COUNT(*) AS cnt,\n        ROW_NUMBER() OVER (PARTITION BY oi.\"seller_id\" ORDER BY COUNT(*) DESC) AS rn\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    LEFT JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"PRODUCTS\" p\n        ON oi.\"product_id\" = p.\"product_id\"\n    LEFT JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"PRODUCT_CATEGORY_NAME_TRANSLATION\" t\n        ON p.\"product_category_name\" = t.\"product_category_name\"\n    GROUP BY oi.\"seller_id\", COALESCE(t.\"product_category_name_english\", '')\n)\nSELECT\n    si.\"seller_id\" AS \"SELLER_ID\",\n    si.\"TOTAL_QUANTITY_SOLD\",\n    si.\"TOTAL_SALES\",\n    si.\"AVERAGE_ITEM_PRICE\",\n    sr.\"AVERAGE_REVIEW_SCORE\",\n    sp.\"AVERAGE_PACKING_TIME_HOURS\",\n    sc.category_english AS \"TOP_CATEGORIES_ENGLISH\"\nFROM seller_items si\nLEFT JOIN seller_reviews sr ON si.\"seller_id\" = sr.\"seller_id\"\nLEFT JOIN seller_packing sp ON si.\"seller_id\" = sp.\"seller_id\"\nLEFT JOIN seller_category sc ON si.\"seller_id\" = sc.\"seller_id\" AND sc.rn = 1\nORDER BY si.\"TOTAL_SALES\" DESC;") t ~= (sql%([ORDER_ITEMS_schema, PRODUCT_CATEGORY_NAME_TRANSLATION_schema, ORDERS_schema, ORDER_REVIEWS_schema, PRODUCTS_schema]) "WITH avg_reviews_per_order AS (\n    SELECT \"order_id\", AVG(\"review_score\") AS avg_score\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_REVIEWS\"\n    GROUP BY \"order_id\"\n),\nseller_sales AS (\n    SELECT\n        oi.\"seller_id\",\n        COUNT(*) AS \"TOTAL_QUANTITY_SOLD\",\n        SUM(oi.\"price\") AS \"TOTAL_SALES\",\n        AVG(oi.\"price\") AS \"AVERAGE_ITEM_PRICE\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    GROUP BY oi.\"seller_id\"\n    HAVING COUNT(*) > 100\n),\nseller_reviews AS (\n    SELECT\n        oi.\"seller_id\",\n        CAST(SUM(r.avg_score) AS DOUBLE) / CAST(COUNT(*) AS DOUBLE) AS \"AVERAGE_REVIEW_SCORE\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN avg_reviews_per_order r ON oi.\"order_id\" = r.\"order_id\"\n    GROUP BY oi.\"seller_id\"\n),\nseller_packing AS (\n    SELECT\n        oi.\"seller_id\",\n        AVG(DATEDIFF('hour', \n            TO_TIMESTAMP(o.\"order_approved_at\"), \n            TO_TIMESTAMP(o.\"order_delivered_carrier_date\")\n        )) AS \"AVERAGE_PACKING_TIME_HOURS\"\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDERS\" o \n        ON oi.\"order_id\" = o.\"order_id\"\n    WHERE o.\"order_approved_at\" IS NOT NULL AND o.\"order_approved_at\" != ''\n      AND o.\"order_delivered_carrier_date\" IS NOT NULL AND o.\"order_delivered_carrier_date\" != ''\n    GROUP BY oi.\"seller_id\"\n),\nseller_categories AS (\n    SELECT\n        oi.\"seller_id\",\n        t.\"product_category_name_english\",\n        COUNT(*) AS category_count,\n        ROW_NUMBER() OVER (PARTITION BY oi.\"seller_id\" ORDER BY COUNT(*) DESC) AS rn\n    FROM \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"ORDER_ITEMS\" oi\n    JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"PRODUCTS\" p \n        ON oi.\"product_id\" = p.\"product_id\"\n    LEFT JOIN \"ELECTRONIC_SALES\".\"ELECTRONIC_SALES\".\"PRODUCT_CATEGORY_NAME_TRANSLATION\" t \n        ON p.\"product_category_name\" = t.\"product_category_name\"\n    GROUP BY oi.\"seller_id\", t.\"product_category_name_english\"\n)\nSELECT\n    ss.\"seller_id\" AS \"SELLER_ID\",\n    ss.\"TOTAL_QUANTITY_SOLD\",\n    ss.\"TOTAL_SALES\",\n    ss.\"AVERAGE_ITEM_PRICE\",\n    sr.\"AVERAGE_REVIEW_SCORE\",\n    sp.\"AVERAGE_PACKING_TIME_HOURS\",\n    sc.\"product_category_name_english\" AS \"TOP_CATEGORIES_ENGLISH\"\nFROM seller_sales ss\nLEFT JOIN seller_reviews sr ON ss.\"seller_id\" = sr.\"seller_id\"\nLEFT JOIN seller_packing sp ON ss.\"seller_id\" = sp.\"seller_id\"\nLEFT JOIN seller_categories sc ON ss.\"seller_id\" = sc.\"seller_id\" AND sc.rn = 1\nORDER BY ss.\"TOTAL_SALES\" DESC;") t := by
