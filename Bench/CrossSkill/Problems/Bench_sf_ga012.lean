/-!
# sf_ga012 — crossskill equivalence(s)

Question: On November 30, 2020, identify the item category with the highest tax rate by dividing tax value in usd by purchase revenue in usd for purchase events, and then retrieve the transaction IDs, total item quantities, and both purchase revenue in usd and purchase revenue for those purchase events in that top-tax-rate category.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_ga012

CREATE TABLE EVENTS_20201130 («EVENT_DATE» STRING, «EVENT_TIMESTAMP» INT, «EVENT_NAME» STRING, «EVENT_PARAMS» STRING, «EVENT_PREVIOUS_TIMESTAMP» INT, «EVENT_VALUE_IN_USD» FLOAT, «EVENT_BUNDLE_SEQUENCE_ID» INT, «EVENT_SERVER_TIMESTAMP_OFFSET» INT, «USER_ID» STRING, «USER_PSEUDO_ID» STRING, «PRIVACY_INFO» STRING, «USER_PROPERTIES» STRING, «USER_FIRST_TOUCH_TIMESTAMP» INT, «USER_LTV» STRING, «DEVICE» STRING, «GEO» STRING, «APP_INFO» STRING, «TRAFFIC_SOURCE» STRING, «STREAM_ID» INT, «PLATFORM» STRING, «EVENT_DIMENSIONS» STRING, «ECOMMERCE» STRING, «ITEMS» STRING)

HYPOTHESIS hyp0_1_0 : EVENTS_20201130 "\"EVENT_NAME\" = 'purchase'"
theorem eq_0_1 (t : TableRel EVENTS_20201130_schema) (h0 : hyp0_1_0 t) :
    (sql%([EVENTS_20201130_schema]) "WITH purchase_items AS (\n    -- Flatten items from purchase events on November 30, 2020\n    SELECT\n        e.ECOMMERCE:\"transaction_id\"::STRING AS TRANSACTION_ID,\n        e.ECOMMERCE:\"total_item_quantity\"::INT AS TOTAL_ITEM_QUANTITY,\n        e.ECOMMERCE:\"purchase_revenue_in_usd\"::FLOAT AS PURCHASE_REVENUE_IN_USD,\n        e.ECOMMERCE:\"purchase_revenue\"::FLOAT AS PURCHASE_REVENUE,\n        e.ECOMMERCE:\"tax_value_in_usd\"::FLOAT AS TAX_VALUE_IN_USD,\n        f.value:\"item_category\"::STRING AS ITEM_CATEGORY\n    FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201130\" e,\n    LATERAL FLATTEN(input => e.ITEMS) f\n    WHERE e.EVENT_NAME = 'purchase'\n),\ncategory_tax_rates AS (\n    -- Compute tax rate per item category\n    SELECT\n        ITEM_CATEGORY,\n        SUM(TAX_VALUE_IN_USD) / NULLIF(SUM(PURCHASE_REVENUE_IN_USD), 0) AS TAX_RATE\n    FROM purchase_items\n    GROUP BY ITEM_CATEGORY\n),\ntop_category AS (\n    -- Find the category with the highest tax rate\n    SELECT ITEM_CATEGORY\n    FROM category_tax_rates\n    ORDER BY TAX_RATE DESC NULLS LAST\n    LIMIT 1\n)\n-- Retrieve transaction details for purchase events in the top-tax-rate category\nSELECT DISTINCT\n    pi.TRANSACTION_ID,\n    pi.TOTAL_ITEM_QUANTITY,\n    pi.PURCHASE_REVENUE_IN_USD,\n    pi.PURCHASE_REVENUE\nFROM purchase_items pi\nJOIN top_category tc ON pi.ITEM_CATEGORY = tc.ITEM_CATEGORY\nORDER BY pi.TRANSACTION_ID;") t ~= (sql%([EVENTS_20201130_schema]) "-- Find the item_category with the highest tax rate (SUM(tax_value_in_usd)/SUM(purchase_revenue_in_usd))\n-- Then retrieve transaction details for purchase events associated with that category\nWITH category_tax_rate AS (\n  SELECT \n    item.VALUE:item_category::STRING AS item_category,\n    SUM(\"ECOMMERCE\":tax_value_in_usd::FLOAT) / NULLIF(SUM(\"ECOMMERCE\":purchase_revenue_in_usd::FLOAT), 0) AS tax_rate\n  FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201130\",\n  LATERAL FLATTEN(input => \"ITEMS\") item\n  WHERE \"EVENT_NAME\" = 'purchase'\n  GROUP BY item_category\n  ORDER BY tax_rate DESC NULLS LAST\n  LIMIT 1\n),\ntop_category AS (\n  SELECT item_category FROM category_tax_rate\n)\nSELECT DISTINCT\n  \"ECOMMERCE\":transaction_id::STRING AS TRANSACTION_ID,\n  \"ECOMMERCE\":total_item_quantity::INT AS TOTAL_ITEM_QUANTITY,\n  \"ECOMMERCE\":purchase_revenue_in_usd::FLOAT AS PURCHASE_REVENUE_IN_USD,\n  \"ECOMMERCE\":purchase_revenue::FLOAT AS PURCHASE_REVENUE\nFROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201130\",\nLATERAL FLATTEN(input => \"ITEMS\") item\nWHERE \"EVENT_NAME\" = 'purchase'\nAND item.VALUE:item_category::STRING = (SELECT item_category FROM top_category)\nORDER BY TRANSACTION_ID;") t := by
  first | sql_equiv | sorry

