import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq396 — crossskill equivalence(s)

Question: Which top 3 states had the largest differences in the number of traffic accidents between rainy and clear weather during weekends in 2016? Please also provide the respective differences for each state.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq396

CREATE TABLE ACCIDENT_2016 («state_number» INT, «state_name» STRING, «consecutive_number» INT, «number_of_vehicle_forms_submitted_all» INT, «number_of_motor_vehicles_in_transport_mvit» INT, «number_of_parked_working_vehicles» INT, «number_of_forms_submitted_for_persons_not_in_motor_vehicles» INT, «number_of_persons_not_in_motor_vehicles_in_transport_mvit» INT, «number_of_persons_in_motor_vehicles_in_transport_mvit» INT, «number_of_forms_submitted_for_persons_in_motor_vehicles» INT, «county» INT, «city» INT, «day_of_crash» INT, «month_of_crash» INT, «year_of_crash» INT, «day_of_week» INT, «hour_of_crash» INT, «minute_of_crash» INT, «national_highway_system» INT, «land_use» INT, «land_use_name» STRING, «functional_system» INT, «functional_system_name» STRING, «ownership» INT, «ownership_name» STRING, «route_signing» INT, «route_signing_name» STRING, «trafficway_identifier» STRING, «trafficway_identifier_2» STRING, «milepoint» INT, «latitude» FLOAT, «longitude» FLOAT, «special_jurisdiction» INT, «special_jurisdiction_name» STRING, «first_harmful_event» INT, «first_harmful_event_name» STRING, «manner_of_collision» INT, «manner_of_collision_name» STRING, «relation_to_junction_within_interchange_area» STRING, «relation_to_junction_specific_location» INT, «relation_to_junction_specific_location_name» STRING, «type_of_intersection» STRING, «work_zone» STRING, «relation_to_trafficway» INT, «relation_to_trafficway_name» STRING, «light_condition» INT, «light_condition_name» STRING, «atmospheric_conditions_1» INT, «atmospheric_conditions_1_name» STRING, «atmospheric_conditions_2» INT, «atmospheric_conditions_2_name» STRING, «atmospheric_conditions» INT, «atmospheric_conditions_name» STRING, «school_bus_related» STRING, «rail_grade_crossing_identifier» STRING, «hour_of_notification» INT, «minute_of_notification» INT, «hour_of_arrival_at_scene» INT, «minute_of_arrival_at_scene» INT, «hour_of_ems_arrival_at_hospital» INT, «minute_of_ems_arrival_at_hospital» INT, «related_factors_crash_level_1» INT, «related_factors_crash_level_1_name» STRING, «related_factors_crash_level_2» INT, «related_factors_crash_level_2_name» STRING, «related_factors_crash_level_3» INT, «related_factors_crash_level_3_name» STRING, «number_of_fatalities» INT, «number_of_drunk_drivers» INT, «timestamp_of_crash» INT)

HYPOTHESIS hyp0_1_0 : ACCIDENT_2016 "\"atmospheric_conditions_1_name\" IN ('Rain', 'Clear')"
HYPOTHESIS hyp0_1_1 : ACCIDENT_2016 "\"atmospheric_conditions_1_name\" IN ('Clear', 'Rain')"
theorem eq_0_1 (t : TableRel ACCIDENT_2016_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) :
    (sql%([ACCIDENT_2016_schema]) "SELECT \n  \"state_name\",\n  SUM(CASE WHEN \"atmospheric_conditions_1_name\" = 'Clear' THEN 1 ELSE 0 END) - \n  SUM(CASE WHEN \"atmospheric_conditions_1_name\" = 'Rain' THEN 1 ELSE 0 END) AS \"Difference\"\nFROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\"\nWHERE \"day_of_week\" IN (1, 7)\n  AND \"atmospheric_conditions_1_name\" IN ('Rain', 'Clear')\nGROUP BY \"state_name\"\nORDER BY \"Difference\" DESC\nLIMIT 3;") t = (sql%([ACCIDENT_2016_schema]) "SELECT \n    \"state_name\",\n    ABS(\n        SUM(CASE WHEN \"atmospheric_conditions_1_name\" = 'Clear' THEN 1 ELSE 0 END) - \n        SUM(CASE WHEN \"atmospheric_conditions_1_name\" = 'Rain' THEN 1 ELSE 0 END)\n    ) AS \"Difference\"\nFROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\"\nWHERE \"day_of_week\" IN (1, 7)\n  AND \"atmospheric_conditions_1_name\" IN ('Clear', 'Rain')\nGROUP BY \"state_name\"\nORDER BY \"Difference\" DESC\nLIMIT 3;") t := by
  first | sql_equiv | sorry

