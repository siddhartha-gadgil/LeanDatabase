  first | sql_equiv | sorry

theorem eq_0_3 : ∀ t,
    (sql%([ACCIDENT_2016_schema]) "SELECT \n  \"state_name\",\n  SUM(CASE WHEN \"atmospheric_conditions_1_name\" = 'Clear' THEN 1 ELSE 0 END) - \n  SUM(CASE WHEN \"atmospheric_conditions_1_name\" = 'Rain' THEN 1 ELSE 0 END) AS \"Difference\"\nFROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\"\nWHERE \"day_of_week\" IN (1, 7)\n  AND \"atmospheric_conditions_1_name\" IN ('Rain', 'Clear')\nGROUP BY \"state_name\"\nORDER BY \"Difference\" DESC\nLIMIT 3;") t ~= (sql%([ACCIDENT_2016_schema]) "SELECT\n    \"state_name\",\n    COUNT(CASE WHEN \"atmospheric_conditions_1_name\" = 'Rain' THEN 1 END) AS rainy_accidents,\n    COUNT(CASE WHEN \"atmospheric_conditions_1_name\" = 'Clear' THEN 1 END) AS clear_accidents,\n    ABS(COUNT(CASE WHEN \"atmospheric_conditions_1_name\" = 'Clear' THEN 1 END)\n      - COUNT(CASE WHEN \"atmospheric_conditions_1_name\" = 'Rain' THEN 1 END)) AS difference\nFROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\"\nWHERE \"day_of_week\" IN (1, 7)\n  AND \"atmospheric_conditions_1_name\" IN ('Rain', 'Clear')\nGROUP BY \"state_name\"\nORDER BY difference DESC\nLIMIT 3;") t := by
  intro t; first | sql_equiv | sorry

