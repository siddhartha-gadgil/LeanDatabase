theorem eq_0_1 :
    sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "WITH living_a_patients AS (SELECT \"id\" AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" WHERE CAST(JSON_EXTRACT_PATH(\"name\"[1], 'family') AS TEXT) LIKE 'A%' AND \"deceased\" IS NULL), single_condition_patients AS (SELECT CAST(JSON_EXTRACT_PATH(c.\"subject\", 'patientId') AS TEXT) AS patient_id, MAX(CAST(JSON_EXTRACT_PATH(c.\"code\", 'coding', '0', 'display') AS TEXT)) AS condition_display, MAX(CAST(JSON_EXTRACT_PATH(c.\"code\", 'coding', '0', 'code') AS TEXT)) AS condition_code FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" AS c WHERE CAST(JSON_EXTRACT_PATH(c.\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM living_a_patients) GROUP BY CAST(JSON_EXTRACT_PATH(c.\"subject\", 'patientId') AS TEXT) HAVING COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(c.\"code\", 'coding', '0', 'code') AS TEXT)) = 1), patient_active_med_counts AS (SELECT sc.patient_id, sc.condition_display, sc.condition_code, COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(mr.\"medication\", 'codeableConcept', 'coding', '0', 'code') AS TEXT)) AS num_active_meds FROM single_condition_patients AS sc JOIN \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" AS mr ON CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) = sc.patient_id AND mr.\"status\" = 'active' GROUP BY sc.patient_id, sc.condition_display, sc.condition_code), condition_max_meds AS (SELECT condition_display AS \"CONDITIONS\", condition_code AS \"CODES\", MAX(num_active_meds) AS max_meds FROM patient_active_med_counts GROUP BY condition_display, condition_code) SELECT \"CONDITIONS\", \"CODES\" FROM condition_max_meds ORDER BY max_meds DESC LIMIT 8" = sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "WITH living_a_patients AS (SELECT \"id\" AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" WHERE JSON_EXTRACT_PATH(\"deceased\", 'dateTime') IS NULL AND CAST(JSON_EXTRACT_PATH(\"name\"[1], 'family') AS TEXT) LIKE 'A%'), patients_with_single_condition AS (SELECT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" WHERE CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM living_a_patients) GROUP BY 1 HAVING COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'code') AS TEXT)) = 1), patient_condition AS (SELECT DISTINCT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id, CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'code') AS TEXT) AS cond_code, CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'display') AS TEXT) AS cond_display FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" WHERE CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM patients_with_single_condition)), patient_active_med_count AS (SELECT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id, COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(\"medication\", 'codeableConcept', 'coding', '0', 'code') AS TEXT)) AS num_distinct_meds FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" WHERE \"status\" = 'active' AND CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM patients_with_single_condition) GROUP BY 1), condition_max_meds AS (SELECT pc.cond_display AS CONDITIONS, pc.cond_code AS CODES, MAX(pam.num_distinct_meds) AS max_meds FROM patient_condition AS pc JOIN patient_active_med_count AS pam ON pc.patient_id = pam.patient_id GROUP BY pc.cond_display, pc.cond_code) SELECT CONDITIONS, CODES FROM condition_max_meds ORDER BY max_meds DESC, CODES DESC LIMIT 8" := by
