theorem eq_2_3 :
    sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "/* Among living patients whose last names begin with \"A\" and who each have exactly */ /* one distinct condition, find the 8 conditions with the highest number of different */ /* active medications prescribed to any single patient, along with their codes. */ WITH living_a_patients AS (SELECT \"id\" AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" WHERE \"deceased\" IS NULL AND CAST(\"name\"[1]['family'] AS TEXT) LIKE 'A%'), patient_conditions AS (SELECT CAST(c.\"subject\"['patientId'] AS TEXT) AS patient_id, CAST(c.\"code\"['coding'][1]['display'] AS TEXT) AS condition_display, CAST(c.\"code\"['coding'][1]['code'] AS TEXT) AS condition_code FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" AS c INNER JOIN living_a_patients AS p ON CAST(c.\"subject\"['patientId'] AS TEXT) = p.patient_id), single_condition_patients /* Patients with exactly one distinct condition */ AS (SELECT patient_id FROM patient_conditions GROUP BY patient_id HAVING COUNT(DISTINCT condition_display) = 1), patient_single_condition /* Get the condition for each single-condition patient */ AS (SELECT DISTINCT pc.patient_id, pc.condition_display, pc.condition_code FROM patient_conditions AS pc INNER JOIN single_condition_patients AS scp ON pc.patient_id = scp.patient_id), patient_med_count /* Count distinct active medications per patient */ AS (SELECT psc.condition_display, psc.condition_code, psc.patient_id, COUNT(DISTINCT CAST(mr.\"medication\"['codeableConcept']['text'] AS TEXT)) AS med_count FROM patient_single_condition AS psc INNER JOIN \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" AS mr ON CAST(mr.\"subject\"['patientId'] AS TEXT) = psc.patient_id WHERE mr.\"status\" = 'active' GROUP BY psc.condition_display, psc.condition_code, psc.patient_id), condition_max_meds /* Get the max med count for any single patient per condition */ AS (SELECT condition_display, condition_code, MAX(med_count) AS max_med_count FROM patient_med_count GROUP BY condition_display, condition_code) SELECT condition_display AS \"CONDITIONS\", condition_code AS \"CODES\" FROM condition_max_meds ORDER BY max_med_count DESC, condition_display ASC LIMIT 8" = sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "WITH living_patients_A AS (SELECT p.\"id\" AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" AS p WHERE CAST(JSON_EXTRACT_PATH(p.\"name\"[1], 'family') AS TEXT) LIKE 'A%' AND JSON_EXTRACT_PATH(p.\"deceased\", 'dateTime') IS NULL), patient_conditions AS (SELECT CAST(JSON_EXTRACT_PATH(c.\"subject\", 'patientId') AS TEXT) AS patient_id, CAST(JSON_EXTRACT_PATH(c.\"code\", 'coding', '0', 'display') AS TEXT) AS condition_display, CAST(JSON_EXTRACT_PATH(c.\"code\", 'coding', '0', 'code') AS TEXT) AS condition_code FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" AS c WHERE CAST(JSON_EXTRACT_PATH(c.\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM living_patients_A)), single_condition_patients AS (SELECT patient_id, MAX(condition_display) AS condition_display, MAX(condition_code) AS condition_code FROM patient_conditions GROUP BY patient_id HAVING COUNT(DISTINCT condition_display) = 1), active_meds_per_patient AS (SELECT CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) AS patient_id, COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(mr.\"medication\", 'codeableConcept', 'coding', '0', 'code') AS TEXT)) AS num_active_meds FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" AS mr WHERE mr.\"status\" = 'active' AND CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT) IN (SELECT patient_id FROM single_condition_patients) GROUP BY CAST(JSON_EXTRACT_PATH(mr.\"subject\", 'patientId') AS TEXT)), condition_max_meds AS (SELECT scp.condition_display AS CONDITIONS, scp.condition_code AS CODES, MAX(amp.num_active_meds) AS max_meds FROM single_condition_patients AS scp JOIN active_meds_per_patient AS amp ON scp.patient_id = amp.patient_id GROUP BY scp.condition_display, scp.condition_code) SELECT CONDITIONS, CODES FROM condition_max_meds ORDER BY max_meds DESC LIMIT 8" := by
  first | sql_equiv | sorry

end Bench_sf_bq391
