import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local169 — crossskill equivalence(s)

Question: What is the annual retention rate of legislators who began their first term between January 1, 1917 and December 31, 1999, measured as the proportion of this cohort still in office on December 31st for each of the first 20 years following their initial term start? The results should show all 20 periods in sequence regardless of whether any legislators were retained in a particular year.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local169

CREATE TABLE LEGISLATORS («full_name» STRING, «first_name» STRING, «last_name» STRING, «middle_name» STRING, «nickname» STRING, «suffix» STRING, «other_names_end» STRING, «other_names_middle» STRING, «other_names_last» STRING, «birthday» STRING, «gender» STRING, «id_bioguide» STRING, «id_bioguide_previous_0» STRING, «id_govtrack» INT, «id_icpsr» FLOAT, «id_wikipedia» STRING, «id_wikidata» STRING, «id_google_entity_id» STRING, «id_house_history» FLOAT, «id_house_history_alternate» FLOAT, «id_thomas» FLOAT, «id_cspan» FLOAT, «id_votesmart» FLOAT, «id_lis» STRING, «id_ballotpedia» STRING, «id_opensecrets» STRING, «id_fec_0» STRING, «id_fec_1» STRING, «id_fec_2» STRING)
CREATE TABLE LEGISLATORS_TERMS («id_bioguide» STRING, «term_number» INT, «term_id» STRING, «term_type» STRING, «term_start» STRING, «term_end» STRING, «state» STRING, «district» FLOAT, «class» FLOAT, «party» STRING, «how» STRING, «url» STRING, «address» STRING, «phone» STRING, «fax» STRING, «contact_form» STRING, «office» STRING, «state_rank» STRING, «rss_url» STRING, «caucus» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH cohort AS (\n    SELECT \"id_bioguide\", \n           MIN(\"term_start\"::DATE) AS first_start\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\"\n    GROUP BY \"id_bioguide\"\n    HAVING first_start >= '1917-01-01' AND first_start <= '1999-12-31'\n),\ncohort_size AS (\n    SELECT COUNT(*) AS total FROM cohort\n),\nperiods AS (\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) AS period\n    FROM TABLE(GENERATOR(ROWCOUNT => 20))\n),\nretained AS (\n    SELECT p.period,\n        COUNT(DISTINCT c.\"id_bioguide\") AS cnt\n    FROM cohort c\n    CROSS JOIN periods p\n    INNER JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n        ON t.\"id_bioguide\" = c.\"id_bioguide\"\n        AND DATE_FROM_PARTS(EXTRACT(YEAR FROM c.first_start)::INT + p.period, 12, 31) >= t.\"term_start\"::DATE\n        AND DATE_FROM_PARTS(EXTRACT(YEAR FROM c.first_start)::INT + p.period, 12, 31) <= t.\"term_end\"::DATE\n    GROUP BY p.period\n)\nSELECT p.period AS \"PERIOD\",\n    ROUND(COALESCE(r.cnt, 0) * 1.0 / cs.total, 6) AS \"retention rate\"\nFROM periods p\nCROSS JOIN cohort_size cs\nLEFT JOIN retained r ON p.period = r.period\nORDER BY p.period;") t ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH cohort AS (\n    -- Define cohort: legislators whose first term (term_number=0) started between 1917-01-01 and 1999-12-31\n    SELECT \"id_bioguide\",\n           \"term_start\"::DATE AS first_term_start,\n           YEAR(\"term_start\"::DATE) AS start_year\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\"\n    WHERE \"term_number\" = 0\n      AND \"term_start\" >= '1917-01-01'\n      AND \"term_start\" <= '1999-12-31'\n),\nperiods AS (\n    -- Generate periods 1 through 20\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) AS period\n    FROM TABLE(GENERATOR(ROWCOUNT => 20))\n),\ncohort_periods AS (\n    -- Cross join cohort with periods and compute check date (Dec 31 of start_year + period)\n    SELECT c.\"id_bioguide\",\n           c.first_term_start,\n           c.start_year,\n           p.period,\n           TO_DATE((c.start_year + p.period)::VARCHAR || '-12-31', 'YYYY-MM-DD') AS check_date\n    FROM cohort c\n    CROSS JOIN periods p\n),\nretention AS (\n    -- Check if each cohort member is \"in office\" on the check date\n    -- A legislator is in office if any of their terms covers the check date:\n    -- term_start <= check_date AND term_end >= check_date\n    SELECT cp.period,\n           cp.\"id_bioguide\",\n           CASE WHEN EXISTS (\n               SELECT 1 \n               FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n               WHERE t.\"id_bioguide\" = cp.\"id_bioguide\"\n                 AND t.\"term_start\"::DATE <= cp.check_date\n                 AND t.\"term_end\"::DATE >= cp.check_date\n           ) THEN 1 ELSE 0 END AS in_office\n    FROM cohort_periods cp\n)\nSELECT r.period AS \"PERIOD\",\n       SUM(r.in_office) * 1.0 / COUNT(*) AS \"retention rate\"\nFROM retention r\nGROUP BY r.period\nORDER BY r.period;") t := by
  intro t; first | sql_equiv | sorry

