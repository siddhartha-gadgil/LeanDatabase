    sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH cohort AS (\n    SELECT \"id_bioguide\", \n           MIN(\"term_start\"::DATE) AS first_start\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\"\n    GROUP BY \"id_bioguide\"\n    HAVING first_start >= '1917-01-01' AND first_start <= '1999-12-31'\n),\ncohort_size AS (\n    SELECT COUNT(*) AS total FROM cohort\n),\nperiods AS (\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) AS period\n    FROM TABLE(GENERATOR(ROWCOUNT => 20))\n),\nretained AS (\n    SELECT p.period,\n        COUNT(DISTINCT c.\"id_bioguide\") AS cnt\n    FROM cohort c\n    CROSS JOIN periods p\n    INNER JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n        ON t.\"id_bioguide\" = c.\"id_bioguide\"\n        AND DATE_FROM_PARTS(EXTRACT(YEAR FROM c.first_start)::INT + p.period, 12, 31) >= t.\"term_start\"::DATE\n        AND DATE_FROM_PARTS(EXTRACT(YEAR FROM c.first_start)::INT + p.period, 12, 31) <= t.\"term_end\"::DATE\n    GROUP BY p.period\n)\nSELECT p.period AS \"PERIOD\",\n    ROUND(COALESCE(r.cnt, 0) * 1.0 / cs.total, 6) AS \"retention rate\"\nFROM periods p\nCROSS JOIN cohort_size cs\nLEFT JOIN retained r ON p.period = r.period\nORDER BY p.period;" = sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH cohort AS (\n    -- Find each legislator's first term start date\n    SELECT \"id_bioguide\", \n           MIN(TO_DATE(\"term_start\")) AS first_start\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\"\n    GROUP BY \"id_bioguide\"\n    HAVING MIN(TO_DATE(\"term_start\")) >= '1917-01-01' \n       AND MIN(TO_DATE(\"term_start\")) <= '1999-12-31'\n),\nperiods AS (\n    -- Generate periods 1-20\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) AS period\n    FROM TABLE(GENERATOR(ROWCOUNT => 20))\n),\ncohort_periods AS (\n    -- Cross join cohort with periods to get check dates\n    SELECT c.\"id_bioguide\",\n           c.first_start,\n           p.period,\n       