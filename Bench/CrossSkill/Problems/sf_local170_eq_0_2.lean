theorem eq (t0 : TableRel LEGISLATORS_schema) (t1 : TableRel LEGISLATORS_TERMS_schema) :
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_terms AS (SELECT \"id_bioguide\", MIN(CAST(\"term_start\" AS DATE)) AS first_term_date FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" GROUP BY \"id_bioguide\"), cohort AS (SELECT DISTINCT lt.\"id_bioguide\", lt.\"state\", l.\"gender\", ft.first_term_date FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS lt JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON lt.\"id_bioguide\" = l.\"id_bioguide\" JOIN first_terms AS ft ON lt.\"id_bioguide\" = ft.\"id_bioguide\"), years AS (SELECT 0 AS yr UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10), retention_check AS (SELECT c.\"state\", c.\"gender\", y.yr, COUNT(DISTINCT c.\"id_bioguide\") AS cohort_size, COUNT(DISTINCT CASE WHEN EXISTS(SELECT 1 FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t WHERE t.\"id_bioguide\" = c.\"id_bioguide\" AND t.\"state\" = c.\"state\" AND CAST(t.\"term_start\" AS DATE) <= DATE_FROM_PARTS(EXTRACT(YEAR FROM c.first_term_date) + y.yr, 12, 31) AND CAST(t.\"term_end\" AS DATE) >= DATE_FROM_PARTS(EXTRACT(YEAR FROM c.first_term_date) + y.yr, 12, 31)) THEN c.\"id_bioguide\" END) AS retained FROM cohort AS c CROSS JOIN years AS y GROUP BY c.\"state\", c.\"gender\", y.yr), retention_rates AS (SELECT \"state\", \"gender\", yr, CAST(retained * 1.0 AS DOUBLE PRECISION) / cohort_size AS retention_rate FROM retention_check), valid_states AS (SELECT \"state\" FROM retention_rates GROUP BY \"state\" HAVING SUM(CASE WHEN retention_rate > 0 THEN 1 ELSE 0 END) = 12 AND COUNT(DISTINCT \"gender\") = 2) SELECT \"state\" FROM valid_states ORDER BY \"state\"") t0 t1
