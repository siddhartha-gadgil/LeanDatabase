 retention_rate > 0 at ALL 6 intervals */ AS (SELECT \"state\", \"gender\", COUNT(*) AS intervals_with_retention FROM retention_rates WHERE retention_rate > 0 GROUP BY \"state\", \"gender\" HAVING COUNT(*) = 6 /* all 6 intervals (0,2,4,6,8,10) */) SELECT \"state\" FROM states_with_both WHERE \"gender\" IN ('M', 'F') GROUP BY \"state\" HAVING COUNT(DISTINCT \"gender\") = 2 ORDER BY \"state\"") t0 t1
