-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_terms AS (/* First term ACROSS ALL STATES for each male legislator */ SELECT t.\"id_bioguide\", MIN(CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE)) AS first_term_date FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON t.\"id_bioguide\" = l.\"id_bioguide\" WHERE l.\"gender\" = 'M' GROUP BY t.\"id_bioguide\"), year_range /* Generate years covering the full data range */ AS (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 1799 AS yr FROM TABLE(GENERATOR(250))), dec31_dates AS (SELECT yr, CAST(TO_TIMESTAMP(yr || '-12-31', 'YYYY-MM-DD') AS DATE) AS dec31 FROM year_range), actively_serving /* Find all male LA legislators actively serving on each Dec 31 */ AS (SELECT DISTINCT t.\"id_bioguide\", d.dec31, CAST(EXTRACT(year FROM AGE(CAST(d.dec31 AS TIMESTAMP), CAST(ft.first_term_date AS TIMESTAMP))) AS BIGINT) AS years_since_first_term FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON t.\"id_bioguide\" = l.\"id_bioguide\" JOIN first_terms AS ft ON t.\"id_bioguide\" = ft.\"id_bioguide\" JOIN dec31_dates AS d ON CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE) <= d.dec31 AND CAST(TO_TIMESTAMP(t.\"term_end\", 'YYYY-MM-DD') AS DATE) >= d.dec31 WHERE l.\"gender\" = 'M' AND t.\"state\" = 'LA'), years_range /* Generate all years_elapsed from 31 to 49 to include zeros */ AS (SELECT 30 + ROW_NUMBER() OVER (ORDER BY SEQ4()) AS years_elapsed FROM TABLE(GENERATOR(19))), counts /* Count distinct legislators per years_since_first_term */ AS (SELECT years_since_first_term, COUNT(DISTINCT \"id_bioguide\") AS cnt FROM actively_serving WHERE years_since_first_term > 30 AND years_since_first_term < 50 GROUP BY years_since_first_term) SELECT yr.years_elapsed AS YEARS_ELAPSED, COALESCE(c.cnt, 0) AS DISTINCT_LEGISLATORS_ACTIVE FROM years_range AS yr LEFT JOIN counts AS c ON yr.years_elapsed = c.years_since_first_term ORDER BY yr.years_elapsed") t ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH la_male AS (/* Male legislators who served in Louisiana */ SELECT DISTINCT t.\"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON t.\"id_bioguide\" = l.\"id_bioguide\" WHERE t.\"state\" = 'LA' AND l.\"gender\" = 'M'), first_terms AS (/* First term start date for each LA male legislator (across all states) */ SELECT \"id_bioguide\", CAST(MIN(\"term_start\") AS DATE) AS first_term_date FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" WHERE \"id_bioguide\" IN (SELECT \"id_bioguide\" FROM la_male) GROUP BY \"id_bioguide\"), year_seq AS (/* Generate years covering all possible legislative activity */ SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 + 1780 AS yr FROM TABLE(GENERATOR(300))), active_counts AS (/* Count distinct legislators actively serving on Dec 31 of each year */ /* with years_elapsed > 30 and < 50 */ SELECT CAST((y.yr - EXTRACT(YEAR FROM ft.first_term_date)) AS INT) AS years_elapsed, COUNT(DISTINCT t.\"id_bioguide\") AS cnt FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN first_terms AS ft ON t.\"id_bioguide\" = ft.\"id_bioguide\" CROSS JOIN year_seq AS y WHERE CAST(t.\"term_start\" AS DATE) <= CAST((y.yr || '-12-31') AS DATE) AND CAST(t.\"term_end\" AS DATE) >= CAST((y.yr || '-12-31') AS DATE) AND (y.yr - EXTRACT(YEAR FROM ft.first_term_date)) > 30 AND (y.yr - EXTRACT(YEAR FROM ft.first_term_date)) < 50 GROUP BY years_elapsed), all_years AS (/* Generate all years_elapsed values from 31 to 49 */ SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 30 AS years_elapsed FROM TABLE(GENERATOR(19))) SELECT ay.years_elapsed AS \"YEARS_ELAPSED\", COALESCE(ac.cnt, 0) AS \"DISTINCT_LEGISLATORS_ACTIVE\" FROM all_years AS ay LEFT JOIN active_counts AS ac ON ay.years_elapsed = ac.years_elapsed ORDER BY ay.years_elapsed") t := by
