VE FROM years_range AS yr LEFT JOIN counts AS c ON yr.years_elapsed = c.years_since_first_term ORDER BY yr.years_elapsed") t ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH male_la_legislators AS (/* Male legislators who have at least one LA term */ SELECT DISTINCT l.\"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON l.\"id_bioguide\" = t.\"id_bioguide\" WHERE l.\"gender\" = 'M' AND t.\"state\" = 'LA'), first_term AS (/* First term start for each male LA legislator (across all their terms) */ SELECT t.\"id_bioguide\", MIN(t.\"term_start\") AS first_term_start FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t WHERE t.\"id_bioguide\" IN (SELECT \"id_bioguide\" FROM male_la_legislators) GROUP BY t.\"id_bioguide\"), year_nums /* Generate a wide range of Dec 31 dates (1700-2020) */ AS (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 1699 AS yr FROM TABLE(GENERATOR(321))), dec31_dates AS (SELECT yr, yr || '-12-31' AS dec31_date FROM year_nums), active_on_dec31 AS (SELECT DISTINCT ft.\"id_bioguide\", d.dec31_date, d.yr - CAST(LEFT(ft.first_term_start, 4) AS INT) AS years_elapsed FROM first_term AS ft CROSS JOIN dec31_dates AS d JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON ft.\"id_bioguide\" = t.\"id_bioguide\" AND d.dec31_date >= t.\"term_start\" AND d.dec31_date <= t.\"term_end\"), active_counts AS (SELECT years_elapsed, COUNT(DISTINCT \"id_bioguide\") AS cnt FROM active_on_dec31 WHERE years_elapsed > 30 AND years_elapsed < 50 GROUP BY years_elapsed), year_series AS (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 30 AS years_elapsed FROM TABLE(GENERATOR(19))) SELECT ys.years_elapsed AS \"YEARS_ELAPSED\", COALESCE(ac.cnt, 0) AS \"DISTINCT_LEGISLATORS_ACTIVE\" FROM year_series AS ys LEFT JOIN active_counts AS ac ON ys.years_elapsed = ac.years_elapsed ORDER BY ys.years_elapsed") t := by
