/-!
# sf_local171 — crossskill equivalence(s)

Question: For male legislators from Louisiana, how many distinct legislators were actively serving on December 31 of each year from more than 30 years since their first term up to less than 50 years, grouping the results by the exact number of years elapsed since their first term?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local171

CREATE TABLE LEGISLATORS («full_name» STRING, «first_name» STRING, «last_name» STRING, «middle_name» STRING, «nickname» STRING, «suffix» STRING, «other_names_end» STRING, «other_names_middle» STRING, «other_names_last» STRING, «birthday» STRING, «gender» STRING, «id_bioguide» STRING, «id_bioguide_previous_0» STRING, «id_govtrack» INT, «id_icpsr» FLOAT, «id_wikipedia» STRING, «id_wikidata» STRING, «id_google_entity_id» STRING, «id_house_history» FLOAT, «id_house_history_alternate» FLOAT, «id_thomas» FLOAT, «id_cspan» FLOAT, «id_votesmart» FLOAT, «id_lis» STRING, «id_ballotpedia» STRING, «id_opensecrets» STRING, «id_fec_0» STRING, «id_fec_1» STRING, «id_fec_2» STRING)
CREATE TABLE LEGISLATORS_TERMS («id_bioguide» STRING, «term_number» INT, «term_id» STRING, «term_type» STRING, «term_start» STRING, «term_end» STRING, «state» STRING, «district» FLOAT, «class» FLOAT, «party» STRING, «how» STRING, «url» STRING, «address» STRING, «phone» STRING, «fax» STRING, «contact_form» STRING, «office» STRING, «state_rank» STRING, «rss_url» STRING, «caucus» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_terms AS (\n  -- First term ACROSS ALL STATES for each male legislator\n  SELECT \n    t.\"id_bioguide\", \n    MIN(TRY_TO_DATE(t.\"term_start\", 'YYYY-MM-DD')) AS first_term_date\n  FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n  JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l \n    ON t.\"id_bioguide\" = l.\"id_bioguide\"\n  WHERE l.\"gender\" = 'M'\n  GROUP BY t.\"id_bioguide\"\n),\n-- Generate years covering the full data range\nyear_range AS (\n  SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 1799 AS yr\n  FROM TABLE(GENERATOR(ROWCOUNT => 250))\n),\ndec31_dates AS (\n  SELECT yr, TRY_TO_DATE(yr || '-12-31', 'YYYY-MM-DD') AS dec31\n  FROM year_range\n),\n-- Find all male LA legislators actively serving on each Dec 31\nactively_serving AS (\n  SELECT DISTINCT \n    t.\"id_bioguide\", \n    d.dec31,\n    DATEDIFF('year', ft.first_term_date, d.dec31) AS years_since_first_term\n  FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n  JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l \n    ON t.\"id_bioguide\" = l.\"id_bioguide\"\n  JOIN first_terms ft \n    ON t.\"id_bioguide\" = ft.\"id_bioguide\"\n  JOIN dec31_dates d \n    ON TRY_TO_DATE(t.\"term_start\", 'YYYY-MM-DD') <= d.dec31\n    AND TRY_TO_DATE(t.\"term_end\", 'YYYY-MM-DD') >= d.dec31\n  WHERE l.\"gender\" = 'M' \n    AND t.\"state\" = 'LA'\n),\n-- Generate all years_elapsed from 31 to 49 to include zeros\nyears_range AS (\n  SELECT 30 + ROW_NUMBER() OVER (ORDER BY SEQ4()) AS years_elapsed\n  FROM TABLE(GENERATOR(ROWCOUNT => 19))\n),\n-- Count distinct legislators per years_since_first_term\ncounts AS (\n  SELECT \n    years_since_first_term,\n    COUNT(DISTINCT \"id_bioguide\") AS cnt\n  FROM actively_serving\n  WHERE years_since_first_term > 30 AND years_since_first_term < 50\n  GROUP BY years_since_first_term\n)\nSELECT \n  yr.years_elapsed AS YEARS_ELAPSED,\n  COALESCE(c.cnt, 0) AS DISTINCT_LEGISLATORS_ACTIVE\nFROM years_range yr\nLEFT JOIN counts c \n  ON yr.years_elapsed = c.years_since_first_term\nORDER BY yr.years_elapsed;") t ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH la_male AS (\n    -- Male legislators who served in Louisiana\n    SELECT DISTINCT t.\"id_bioguide\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n    JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l \n      ON t.\"id_bioguide\" = l.\"id_bioguide\"\n    WHERE t.\"state\" = 'LA' AND l.\"gender\" = 'M'\n),\nfirst_terms AS (\n    -- First term start date for each LA male legislator (across all states)\n    SELECT \"id_bioguide\", MIN(\"term_start\")::DATE AS first_term_date\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\"\n    WHERE \"id_bioguide\" IN (SELECT \"id_bioguide\" FROM la_male)\n    GROUP BY \"id_bioguide\"\n),\nyear_seq AS (\n    -- Generate years covering all possible legislative activity\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 + 1780 AS yr\n    FROM TABLE(GENERATOR(ROWCOUNT => 300))\n),\nactive_counts AS (\n    -- Count distinct legislators actively serving on Dec 31 of each year\n    -- with years_elapsed > 30 and < 50\n    SELECT \n        (y.yr - EXTRACT(YEAR FROM ft.first_term_date))::INT AS years_elapsed,\n        COUNT(DISTINCT t.\"id_bioguide\") AS cnt\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n    JOIN first_terms ft ON t.\"id_bioguide\" = ft.\"id_bioguide\"\n    CROSS JOIN year_seq y\n    WHERE t.\"term_start\"::DATE <= (y.yr || '-12-31')::DATE\n      AND t.\"term_end\"::DATE >= (y.yr || '-12-31')::DATE\n      AND (y.yr - EXTRACT(YEAR FROM ft.first_term_date)) > 30\n      AND (y.yr - EXTRACT(YEAR FROM ft.first_term_date)) < 50\n    GROUP BY years_elapsed\n),\nall_years AS (\n    -- Generate all years_elapsed values from 31 to 49\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 30 AS years_elapsed\n    FROM TABLE(GENERATOR(ROWCOUNT => 19))\n)\nSELECT \n    ay.years_elapsed AS \"YEARS_ELAPSED\",\n    COALESCE(ac.cnt, 0) AS \"DISTINCT_LEGISLATORS_ACTIVE\"\nFROM all_years ay\nLEFT JOIN active_counts ac ON ay.years_elapsed = ac.years_elapsed\nORDER BY ay.years_elapsed;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_terms AS (\n  -- First term ACROSS ALL STATES for each male legislator\n  SELECT \n    t.\"id_bioguide\", \n    MIN(TRY_TO_DATE(t.\"term_start\", 'YYYY-MM-DD')) AS first_term_date\n  FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n  JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l \n    ON t.\"id_bioguide\" = l.\"id_bioguide\"\n  WHERE l.\"gender\" = 'M'\n  GROUP BY t.\"id_bioguide\"\n),\n-- Generate years covering the full data range\nyear_range AS (\n  SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 1799 AS yr\n  FROM TABLE(GENERATOR(ROWCOUNT => 250))\n),\ndec31_dates AS (\n  SELECT yr, TRY_TO_DATE(yr || '-12-31', 'YYYY-MM-DD') AS dec31\n  FROM year_range\n),\n-- Find all male LA legislators actively serving on each Dec 31\nactively_serving AS (\n  SELECT DISTINCT \n    t.\"id_bioguide\", \n    d.dec31,\n    DATEDIFF('year', ft.first_term_date, d.dec31) AS years_since_first_term\n  FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n  JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l \n    ON t.\"id_bioguide\" = l.\"id_bioguide\"\n  JOIN first_terms ft \n    ON t.\"id_bioguide\" = ft.\"id_bioguide\"\n  JOIN dec31_dates d \n    ON TRY_TO_DATE(t.\"term_start\", 'YYYY-MM-DD') <= d.dec31\n    AND TRY_TO_DATE(t.\"term_end\", 'YYYY-MM-DD') >= d.dec31\n  WHERE l.\"gender\" = 'M' \n    AND t.\"state\" = 'LA'\n),\n-- Generate all years_elapsed from 31 to 49 to include zeros\nyears_range AS (\n  SELECT 30 + ROW_NUMBER() OVER (ORDER BY SEQ4()) AS years_elapsed\n  FROM TABLE(GENERATOR(ROWCOUNT => 19))\n),\n-- Count distinct legislators per years_since_first_term\ncounts AS (\n  SELECT \n    years_since_first_term,\n    COUNT(DISTINCT \"id_bioguide\") AS cnt\n  FROM actively_serving\n  WHERE years_since_first_term > 30 AND years_since_first_term < 50\n  GROUP BY years_since_first_term\n)\nSELECT \n  yr.years_elapsed AS YEARS_ELAPSED,\n  COALESCE(c.cnt, 0) AS DISTINCT_LEGISLATORS_ACTIVE\nFROM years_range yr\nLEFT JOIN counts c \n  ON yr.years_elapsed = c.years_since_first_term\nORDER BY yr.years_elapsed;") t ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH male_la_legislators AS (\n    -- Male legislators who have at least one LA term\n    SELECT DISTINCT l.\"id_bioguide\"\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" l\n    JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n        ON l.\"id_bioguide\" = t.\"id_bioguide\"\n    WHERE l.\"gender\" = 'M'\n      AND t.\"state\" = 'LA'\n),\nfirst_term AS (\n    -- First term start for each male LA legislator (across all their terms)\n    SELECT t.\"id_bioguide\",\n           MIN(t.\"term_start\") AS first_term_start\n    FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n    WHERE t.\"id_bioguide\" IN (SELECT \"id_bioguide\" FROM male_la_legislators)\n    GROUP BY t.\"id_bioguide\"\n),\n-- Generate a wide range of Dec 31 dates (1700-2020)\nyear_nums AS (\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 1699 AS yr\n    FROM TABLE(GENERATOR(ROWCOUNT => 321))\n),\ndec31_dates AS (\n    SELECT yr,\n           yr || '-12-31' AS dec31_date\n    FROM year_nums\n),\nactive_on_dec31 AS (\n    SELECT DISTINCT ft.\"id_bioguide\",\n           d.dec31_date,\n           d.yr - CAST(LEFT(ft.first_term_start, 4) AS INT) AS years_elapsed\n    FROM first_term ft\n    CROSS JOIN dec31_dates d\n    JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" t\n        ON ft.\"id_bioguide\" = t.\"id_bioguide\"\n       AND d.dec31_date >= t.\"term_start\"\n       AND d.dec31_date <= t.\"term_end\"\n),\nactive_counts AS (\n    SELECT years_elapsed,\n           COUNT(DISTINCT \"id_bioguide\") AS cnt\n    FROM active_on_dec31\n    WHERE years_elapsed > 30 AND years_elapsed < 50\n    GROUP BY years_elapsed\n),\nyear_series AS (\n    SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 30 AS years_elapsed\n    FROM TABLE(GENERATOR(ROWCOUNT => 19))\n)\nSELECT ys.years_elapsed AS \"YEARS_ELAPSED\",\n       COALESCE(ac.cnt, 0) AS \"DISTINCT_LEGISLATORS_ACTIVE\"\nFROM year_series ys\nLEFT JOIN active_counts ac ON ys.years_elapsed = ac.years_elapsed\nORDER BY ys.years_elapsed;") t := by
