theorem eq (t0 : TableRel NATURE_schema) (t1 : TableRel WORD_FREQUENCIES_schema) (t2 : TableRel GLOVE_VECTORS_schema) :
    (sql%([NATURE_schema, WORD_FREQUENCIES_schema, GLOVE_VECTORS_schema]) "WITH stopwords AS (SELECT word FROM (VALUES ('a'), ('about'), ('above'), ('after'), ('again'), ('against'), ('ain'), ('all'), ('am'), ('an'), ('and'), ('any'), ('are'), ('aren'), ('arent'), ('as'), ('at'), ('be'), ('because'), ('been'), ('before'), ('being'), ('below'), ('between'), ('both'), ('but'), ('by'), ('can'), ('couldn'), ('couldnt'), ('d'), ('did'), ('didn'), ('didnt'), ('do'), ('does'), ('doesn'), ('doesnt'), ('doing'), ('don'), ('dont'), ('down'), ('during'), ('each'), ('few'), ('for'), ('from'), ('further'), ('had'), ('hadn'), ('hadnt'), ('has'), ('hasn'), ('hasnt'), ('have'), ('haven'), ('havent'), ('having'), ('he'), ('her'), ('here'), ('hers'), ('herself'), ('him'), ('himself'), ('his'), ('how'), ('i'), ('if'), ('in'), ('into'), ('is'), ('isn'), ('isnt'), ('it'), ('its'), ('itself'), ('just'), ('ll'), ('m'), ('ma'), ('me'), ('mightn'), ('mightnt'), ('more'), ('most'), ('mustn'), ('mustnt'), ('my'), ('myself'), ('needn'), ('neednt'), ('no'), ('nor'), ('not'), ('now'), ('o'), ('of'), ('off'), ('on'), ('once'), ('only'), ('or'), ('other'), ('our'), ('ours'), ('ourselves'), ('out'), ('over'), ('own'), ('re'), ('s'), ('same'), ('shan'), ('shant'), ('she'), ('shes'), ('should'), ('shouldn'), ('shouldnt'), ('shouldve'), ('so'), ('some'), ('such'), ('t'), ('than'), ('that'), ('thatll'), ('the'), ('their'), ('theirs'), ('them'), ('themselves'), ('then'), ('there'), ('these'), ('they'), ('this'), ('those'), ('through'), ('to'), ('too'), ('under'), ('until'), ('up'), ('ve'), ('very'), ('was'), ('wasn'), ('wasnt'), ('we'), ('were'), ('weren'), ('werent'), ('what'), ('when'), ('where'), ('which'), ('while'), ('who'), ('whom'), ('why'), ('will'), ('with'), ('won'), ('wont'), ('wouldn'), ('wouldnt'), ('y'), ('you'), ('youd'), ('youll'), ('your'), ('youre'), ('yours'), ('yourself'), ('yourselves'), ('youve')) AS t(word)), target_tokens /* Step 1: Compute the target article's normalized vector */ AS (SELECT LOWER(CAST(f.VALUE AS TEXT)) AS word, COUNT(*) AS word_cnt FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" AS n, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(REGEXP_REPLACE(REGEXP_REPLACE(n.\"body\", '''s([^a-zA-Z0-9_])', '\\1', 'g'), '''', '', 'g'), '[a-zA-Z0-9_]+', 0)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE n.\"id\" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373' AND LOWER(CAST(f.VALUE AS TEXT)) <> ALL (SELECT word FROM stopwords) GROUP BY LOWER(CAST(f.VALUE AS TEXT))), target_weighted AS (SELECT vi.INDEX AS dim_idx, SUM(CAST(CAST(vi.VALUE AS DOUBLE PRECISION) * tt.word_cnt AS DOUBLE PRECISION) / POWER(wf.\"frequency\", 0.4)) AS weighted_sum FROM target_tokens AS tt JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"GLOVE_VECTORS\" AS g ON tt.word = g.\"word\" JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"WORD_FREQUENCIES\" AS wf ON tt.word = wf.\"word\", LATERAL UNNEST(input => g.\"vector\") AS vi(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY vi.INDEX), target_mag AS (SELECT SQRT(SUM(weighted_sum * weighted_sum)) AS magnitude FROM target_weighted), target_norm AS (SELECT tw.dim_idx, CAST(tw.weighted_sum AS DOUBLE PRECISION) / tm.magnitude AS norm_val FROM target_weighted AS tw CROSS JOIN target_mag AS tm), all_tokens /* Step 2: Tokenize all other articles, lowercase tokens, aggregate by (article, word) */ AS (SELECT n.\"id\", n.\"date\", n.\"title\", LOWER(CAST(f.VALUE AS TEXT)) AS word, COUNT(*) AS word_cnt FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" AS n, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(REGEXP_REPLACE(REGEXP_REPLACE(n.\"body\", '''s([^a-zA-Z0-9_])', '\\1', 'g'), '''', '', 'g'), '[a-zA-Z0-9_]+', 0)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE n.\"id\" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373' AND LOWER(CAST(f.VALUE AS TEXT)) <> ALL (SELECT word FROM stopwords) GROUP BY n.\"id\", n.\"date\", n.\"title\", LOWER(CAST(f.VALUE AS TEXT))), article_components /* Step 3: Flatten vectors, compute weighted sums per article per dimension */ AS (SELECT at.\"id\", at.\"date\", at.\"title\", vi.INDEX AS dim_idx, SUM(CAST(CAST(vi.VALUE AS DOUBLE PRECISION) * at.word_cnt AS DOUBLE PRECISION) / POWER(wf.\"frequency\", 0.4)) AS weighted_sum FROM all_tokens AS at JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"GLOVE_VECTORS\" AS g ON at.word = g.\"word\" JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"WORD_FREQUENCIES\" AS wf ON at.word = wf.\"word\", LATERAL UNNEST(input => g.\"vector\") AS vi(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY at.\"id\", at.\"date\", at.\"title\", vi.INDEX), article_stats /* Step 4: Compute dot product with target and magnitude for each article */ AS (SELECT ac.\"id\", ac.\"date\", ac.\"title\", SUM(ac.weighted_sum * tn.norm_val) AS dot_product, SQRT(SUM(ac.weighted_sum * ac.weighted_sum)) AS magnitude FROM article_components AS ac JOIN target_norm AS tn ON ac.dim_idx = tn.dim_idx GROUP BY ac.\"id\", ac.\"date\", ac.\"title\") /* Step 5: Cosine similarity = dot_product / magnitude (target already unit-normalized) */ SELECT \"id\", \"date\", \"title\", CAST(dot_product AS DOUBLE PRECISION) / magnitude AS \"COSINE_SIMILARITY\" FROM article_stats WHERE magnitude > 0 ORDER BY \"COSINE_SIMILARITY\" DESC LIMIT 10") t0 t1 t2
  ~= (sql%([NATURE_schema, WORD_FREQUENCIES_schema, GLOVE_VECTORS_schema]) "WITH article_words AS (SELECT n.\"id\" AS article_id, CAST(f.value AS TEXT) AS word, COUNT(*) AS cnt FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" AS n, LATERAL UNNEST(INPUT => SPLIT(REGEXP_REPLACE(LOWER(n.\"body\"), '[^a-z0-9 ]', ' ', 'g'), ' ')) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE TRIM(CAST(f.value AS TEXT)) <> '' AND NOT CAST(f.value AS TEXT) IN ('the', 'of', 'and', 'in', 'to', 'a', 'is', 'that', 'for', 'it', 'are', 'was', 'as', 'with', 'be', 'on', 'not', 'this', 'by', 'from', 'or', 'an', 'at', 'but', 'can', 'has', 'have', 'we', 'which', 'they', 'been', 'were', 'these', 'its', 'also', 'more', 'than', 'their', 'will', 'other', 'about', 'had', 'into', 'after', 'do', 'may', 'would', 'between', 'only', 'over', 'such', 'them', 'our', 'when', 'most', 'there', 'no', 'if', 'so', 'up', 'what', 'could', 'did', 'should', 'each', 'then', 'does', 'how', 'many', 'some', 'her', 'him', 'his', 'my', 'out', 'all', 'she', 'he', 'who', 'where', 'just', 'very', 'down', 'much', 'through', 'before', 'new', 'well', 'way', 'because', 'any', 'while', 'here', 'own', 'both', 'few', 'get', 'same', 'back', 'those', 'now', 'long', 'made', 'two', 'one', 'under', 'during', 'still', 'using', 'used', 'however', 'first', 'another', 'found', 'several', 'known', 'within', 'often', 'among', 'per', 'without', 'since', 'around', 'three', 'even', 'further', 'although', 'against', 'along') GROUP BY n.\"id\", CAST(f.value AS TEXT)), weighted_dims AS (SELECT aw.article_id, vf.index AS dim, SUM(CAST(aw.cnt * CAST(vf.value AS DOUBLE PRECISION) AS DOUBLE PRECISION) / POWER(wf.\"frequency\", 0.4)) AS dim_val FROM article_words AS aw JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"GLOVE_VECTORS\" AS g ON g.\"word\" = aw.word JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"WORD_FREQUENCIES\" AS wf ON wf.\"word\" = aw.word, LATERAL UNNEST(INPUT => g.\"vector\") AS vf(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY aw.article_id, vf.index), article_vecs AS (SELECT article_id, ARRAY_AGG(dim_val) FILTER(WHERE dim_val IS NOT NULL) WITHIN GROUP (ORDER BY dim) AS vec FROM weighted_dims GROUP BY article_id) SELECT n.\"id\", n.\"date\", n.\"title\", CAST(DOT_PRODUCT(CAST(a1.vec AS VECTOR(DOUBLE PRECISION, 300)), CAST(a2.vec AS VECTOR(DOUBLE PRECISION, 300))) AS DOUBLE PRECISION) / (SQRT(DOT_PRODUCT(CAST(a1.vec AS VECTOR(DOUBLE PRECISION, 300)), CAST(a1.vec AS VECTOR(DOUBLE PRECISION, 300)))) * SQRT(DOT_PRODUCT(CAST(a2.vec AS VECTOR(DOUBLE PRECISION, 300)), CAST(a2.vec AS VECTOR(DOUBLE PRECISION, 300))))) AS COSINE_SIMILARITY FROM article_vecs AS a1 JOIN article_vecs AS a2 ON a1.article_id <> a2.article_id JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" AS n ON n.\"id\" = a2.article_id WHERE a1.article_id = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373' ORDER BY COSINE_SIMILARITY DESC LIMIT 10") t0 t1 t2
