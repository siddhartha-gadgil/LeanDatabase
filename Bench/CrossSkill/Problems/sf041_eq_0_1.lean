theorem eq (t0 : TableRel TS_FORECAST_SAMPLE_schema) (t1 : TableRel DART_LOADS_SAMPLE_schema) (t2 : TableRel DART_PRICES_SAMPLE_schema) (t3 : TableRel TS_GEN_SAMPLE_schema) :
    (sql%([TS_FORECAST_SAMPLE_schema, DART_LOADS_SAMPLE_schema, DART_PRICES_SAMPLE_schema, TS_GEN_SAMPLE_schema]) "/* SF041: ERCOT Daily Market Dynamics Report for October 1, 2022 */ WITH hours AS (SELECT CAST('2022-10-01 00:00:00' AS TIMESTAMP) + INTERVAL '1 HOUR' * SEQ4() AS dt FROM TABLE(GENERATOR(24))), spine AS (SELECT 'ERCOT' AS ISO, dt AS DATETIME, 'CDT' AS TIMEZONE, dt + INTERVAL '5 HOUR' AS DATETIME_UTC, 0 AS ONPEAK, CASE WHEN HOUR(dt) BETWEEN 7 AND 22 THEN 0 ELSE 1 END AS OFFPEAK, CASE WHEN HOUR(dt) BETWEEN 7 AND 22 THEN 1 ELSE 0 END AS WEPEAK, 0 AS WDPEAK, CAST(dt AS DATE) AS MARKETDAY FROM hours), dart AS (SELECT DATETIME, DALMP, RTLMP FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_PRICES_SAMPLE\" WHERE OBJECTID = 10000697078 AND CAST(DATETIME AS DATE) = '2022-10-01'), load_fcst AS (SELECT DATETIME, VALUE AS LOAD_FORECAST, PUBLISHDATE AS LOAD_FORECAST_PUBLISH_DATE FROM (SELECT DATETIME, VALUE, PUBLISHDATE, ROW_NUMBER() OVER (PARTITION BY DATETIME ORDER BY PUBLISHDATE DESC) AS rn FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\" WHERE OBJECTID = 10000712973 AND DATATYPEID = 19060 AND CAST(DATETIME AS DATE) = '2022-10-01') WHERE rn = 1), rt_load AS (SELECT DATETIME, RTLOAD FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_LOADS_SAMPLE\" WHERE OBJECTID = 10000712973 AND CAST(DATETIME AS DATE) = '2022-10-01'), wind_fcst AS (SELECT DATETIME, VALUE AS WIND_GEN_FORECAST, PUBLISHDATE AS WIND_GEN_FORECAST_PUBLISH_DATE FROM (SELECT DATETIME, VALUE, PUBLISHDATE, ROW_NUMBER() OVER (PARTITION BY DATETIME ORDER BY PUBLISHDATE DESC) AS rn FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\" WHERE OBJECTID = 10000712973 AND DATATYPEID = 9285 AND CAST(DATETIME AS DATE) = '2022-10-01') WHERE rn = 1), wind_actual AS (SELECT DATE_TRUNC('HOUR', DATETIME) AS DATETIME, AVG(VALUE) AS WIND_GEN FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\" WHERE OBJECTID = 10000712973 AND DATATYPEID = 16 AND CAST(DATETIME AS DATE) = '2022-10-01' GROUP BY DATE_TRUNC('HOUR', DATETIME)), solar_fcst AS (SELECT DATETIME, VALUE AS SOLAR_GEN_FORECAST, PUBLISHDATE AS SOLAR_GEN_FORECAST_PUBLISH_DATE FROM (SELECT DATETIME, VALUE, PUBLISHDATE, ROW_NUMBER() OVER (PARTITION BY DATETIME ORDER BY PUBLISHDATE DESC) AS rn FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\" WHERE OBJECTID = 10000712973 AND DATATYPEID = 662 AND CAST(DATETIME AS DATE) = '2022-10-01') WHERE rn = 1), solar_actual AS (SELECT DATE_TRUNC('HOUR', DATETIME) AS DATETIME, AVG(VALUE) AS SOLAR_GEN FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\" WHERE OBJECTID = 10000712973 AND DATATYPEID = 650 AND CAST(DATETIME AS DATE) = '2022-10-01' GROUP BY DATE_TRUNC('HOUR', DATETIME)) SELECT s.ISO, s.DATETIME, s.TIMEZONE, s.DATETIME_UTC, s.ONPEAK, s.OFFPEAK, s.WEPEAK, s.WDPEAK, s.MARKETDAY, 'HB_NORTH' AS PRICE_NODE_NAME, 10000697078 AS PRICE_NODE_ID, d.DALMP, d.RTLMP, 'ERCOT' AS LOAD_ZONE_NAME, 10000712973 AS LOAD_ZONE_ID, lf.LOAD_FORECAST, lf.LOAD_FORECAST_PUBLISH_DATE, rl.RTLOAD, wf.WIND_GEN_FORECAST, wf.WIND_GEN_FORECAST_PUBLISH_DATE, wa.WIND_GEN, sf.SOLAR_GEN_FORECAST, sf.SOLAR_GEN_FORECAST_PUBLISH_DATE, sa.SOLAR_GEN, lf.LOAD_FORECAST - wf.WIND_GEN_FORECAST - sf.SOLAR_GEN_FORECAST AS NET_LOAD_FORECAST, rl.RTLOAD - wa.WIND_GEN - sa.SOLAR_GEN AS NET_LOAD_REAL_TIME FROM spine AS s LEFT JOIN dart AS d ON d.DATETIME = s.DATETIME LEFT JOIN load_fcst AS lf ON lf.DATETIME = s.DATETIME LEFT JOIN rt_load AS rl ON rl.DATETIME = s.DATETIME LEFT JOIN wind_fcst AS wf ON wf.DATETIME = s.DATETIME LEFT JOIN wind_actual AS wa ON wa.DATETIME = s.DATETIME LEFT JOIN solar_fcst AS sf ON sf.DATETIME = s.DATETIME LEFT JOIN solar_actual AS sa ON sa.DATETIME = s.DATETIME ORDER BY s.DATETIME") t0 t1 t2 t3
  = (sql%([TS_FORECAST_SAMPLE_schema, DART_LOADS_SAMPLE_schema, DART_PRICES_SAMPLE_schema, TS_GEN_SAMPLE_schema]) "WITH hours AS (SELECT CAST('2022-10-01 00:00:00' AS TIMESTAMP) + INTERVAL '1 HOUR' * SEQ4() AS dt FROM TABLE(GENERATOR(24))), time_scaffold AS (SELECT 'ERCOT' AS \"ISO\", h.dt AS \"DATETIME\", 'CDT' AS \"TIMEZONE\", h.dt + INTERVAL '5 HOUR' AS \"DATETIME_UTC\", 0 AS \"ONPEAK\", CASE WHEN EXTRACT(HOUR FROM h.dt) BETWEEN 7 AND 22 THEN 0 ELSE 1 END AS \"OFFPEAK\", CASE WHEN EXTRACT(HOUR FROM h.dt) BETWEEN 7 AND 22 THEN 1 ELSE 0 END AS \"WEPEAK\", 0 AS \"WDPEAK\", CAST('2022-10-01' AS DATE) AS \"MARKETDAY\", 'HB_NORTH' AS \"PRICE_NODE_NAME\", 10000697078 AS \"PRICE_NODE_ID\", 'ERCOT' AS \"LOAD_ZONE_NAME\", 10000712973 AS \"LOAD_ZONE_ID\" FROM hours AS h) SELECT ts.\"ISO\", ts.\"DATETIME\", ts.\"TIMEZONE\", ts.\"DATETIME_UTC\", ts.\"ONPEAK\", ts.\"OFFPEAK\", ts.\"WEPEAK\", ts.\"WDPEAK\", ts.\"MARKETDAY\", ts.\"PRICE_NODE_NAME\", ts.\"PRICE_NODE_ID\", dp.\"DALMP\" AS \"DALMP\", dp.\"RTLMP\" AS \"RTLMP\", ts.\"LOAD_ZONE_NAME\", ts.\"LOAD_ZONE_ID\", dl.\"DALOAD\" AS \"LOAD_FORECAST\", NULL AS \"LOAD_FORECAST_PUBLISH_DATE\", dl.\"RTLOAD\" AS \"RTLOAD\", wind_fc.\"VALUE\" AS \"WIND_GEN_FORECAST\", wind_fc.\"PUBLISHDATE\" AS \"WIND_GEN_FORECAST_PUBLISH_DATE\", wind_gen.\"VALUE\" AS \"WIND_GEN\", solar_fc.\"VALUE\" AS \"SOLAR_GEN_FORECAST\", solar_fc.\"PUBLISHDATE\" AS \"SOLAR_GEN_FORECAST_PUBLISH_DATE\", solar_gen.\"VALUE\" AS \"SOLAR_GEN\", dl.\"DALOAD\" - wind_fc.\"VALUE\" - solar_fc.\"VALUE\" AS \"NET_LOAD_FORECAST\", dl.\"RTLOAD\" - wind_gen.\"VALUE\" - solar_gen.\"VALUE\" AS \"NET_LOAD_REAL_TIME\" FROM time_scaffold AS ts LEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_PRICES_SAMPLE\" AS dp ON dp.\"OBJECTID\" = 10000697078 AND dp.\"DATETIME\" = ts.\"DATETIME\" LEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_LOADS_SAMPLE\" AS dl ON dl.\"OBJECTID\" = 10000712973 AND dl.\"DATETIME\" = ts.\"DATETIME\" LEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\" AS wind_fc ON wind_fc.\"OBJECTID\" = 10000712973 AND wind_fc.\"DATATYPEID\" = 9285 AND wind_fc.\"DATETIME\" = ts.\"DATETIME\" LEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\" AS wind_gen ON wind_gen.\"OBJECTID\" = 10000712973 AND wind_gen.\"DATATYPEID\" = 16 AND wind_gen.\"DATETIME\" = ts.\"DATETIME\" LEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\" AS solar_fc ON solar_fc.\"OBJECTID\" = 10000712973 AND solar_fc.\"DATATYPEID\" = 662 AND solar_fc.\"DATETIME\" = ts.\"DATETIME\" LEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\" AS solar_gen ON solar_gen.\"OBJECTID\" = 10000712973 AND solar_gen.\"DATATYPEID\" = 650 AND solar_gen.\"DATETIME\" = ts.\"DATETIME\" ORDER BY ts.\"DATETIME\"") t0 t1 t2 t3
