/-!
# sf_bq188 — crossskill equivalence(s)

Question: Among all product categories in the dataset, identify the category with the highest total purchase quantity (based on order_items table), and for that specific category, what is the average time in minutes that users spend on each product page visit? The average time should be calculated as the difference between the timestamp when a user views a product page and the timestamp of the next event within the same session

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq188

CREATE TABLE EVENTS («id» INT, «user_id» INT, «sequence_number» INT, «session_id» STRING, «created_at» INT, «ip_address» STRING, «city» STRING, «state» STRING, «postal_code» STRING, «browser» STRING, «traffic_source» STRING, «uri» STRING, «event_type» STRING)
CREATE TABLE PRODUCTS («id» INT, «cost» FLOAT, «category» STRING, «name» STRING, «brand» STRING, «retail_price» FLOAT, «department» STRING, «sku» STRING, «distribution_center_id» INT)
CREATE TABLE ORDER_ITEMS («id» INT, «order_id» INT, «user_id» INT, «product_id» INT, «inventory_item_id» INT, «status» STRING, «created_at» INT, «shipped_at» INT, «delivered_at» INT, «returned_at» INT, «sale_price» FLOAT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([EVENTS_schema, PRODUCTS_schema, ORDER_ITEMS_schema]) "-- Step 1: Find the category with the highest total purchase quantity\nWITH top_category AS (\n  SELECT \n    p.\"category\" AS TOP_CATEGORY,\n    COUNT(*) AS total_purchase_quantity\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p \n    ON oi.\"product_id\" = p.\"id\"\n  GROUP BY p.\"category\"\n  ORDER BY total_purchase_quantity DESC\n  LIMIT 1\n),\n-- Step 2: Add next event timestamp using LEAD window function\nevents_with_next AS (\n  SELECT \n    \"session_id\",\n    \"event_type\",\n    \"uri\",\n    \"created_at\",\n    \"sequence_number\",\n    LEAD(\"created_at\") OVER (\n      PARTITION BY \"session_id\" \n      ORDER BY \"sequence_number\"\n    ) AS next_event_time\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"EVENTS\"\n),\n-- Step 3: Calculate time on page for product views in the top category\nproduct_page_times AS (\n  SELECT \n    (e.next_event_time - e.\"created_at\") / 60000000.0 AS time_on_page_minutes\n  FROM events_with_next e\n  JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p\n    ON TRY_CAST(SPLIT_PART(e.\"uri\", '/', 3) AS NUMBER) = p.\"id\"\n  JOIN top_category tc\n    ON p.\"category\" = tc.TOP_CATEGORY\n  WHERE e.\"event_type\" = 'product'\n    AND e.next_event_time IS NOT NULL\n)\n-- Step 4: Return the top category and its average page visit time\nSELECT \n  tc.TOP_CATEGORY,\n  ROUND(AVG(ppt.time_on_page_minutes), 2) AS AVG_MINUTES_SPENT\nFROM product_page_times ppt\nCROSS JOIN top_category tc\nGROUP BY tc.TOP_CATEGORY;") t ~= (sql%([EVENTS_schema, PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH top_category AS (\n    SELECT p.\"category\", COUNT(*) AS total_qty\n    FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" oi\n    JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p\n      ON oi.\"product_id\" = p.\"id\"\n    GROUP BY p.\"category\"\n    ORDER BY total_qty DESC\n    LIMIT 1\n),\nevents_with_next AS (\n    SELECT\n        e.\"session_id\",\n        e.\"sequence_number\",\n        e.\"uri\",\n        e.\"created_at\",\n        LEAD(e.\"created_at\") OVER (\n            PARTITION BY e.\"session_id\"\n            ORDER BY e.\"sequence_number\"\n        ) AS next_created_at\n    FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"EVENTS\" e\n),\nproduct_page_times AS (\n    SELECT\n        ewn.\"uri\",\n        (ewn.next_created_at - ewn.\"created_at\") / 1000000.0 / 60.0 AS time_on_page_minutes\n    FROM events_with_next ewn\n    WHERE ewn.\"uri\" LIKE '/product/%'\n      AND ewn.next_created_at IS NOT NULL\n)\nSELECT\n    tc.\"category\" AS \"TOP_CATEGORY\",\n    ROUND(AVG(ppt.time_on_page_minutes), 2) AS \"AVG_MINUTES_SPENT\"\nFROM product_page_times ppt\nJOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" p\n  ON CAST(REPLACE(ppt.\"uri\", '/product/', '') AS INT) = p.\"id\"\nJOIN top_category tc\n  ON p.\"category\" = tc.\"category\"\nGROUP BY tc.\"category\";") t := by
  intro t; first | sql_equiv | sorry

