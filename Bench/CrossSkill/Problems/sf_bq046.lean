theorem eq_0_1 :
    sql%([REL14_CASEDATA_schema, REL14_GDCFILEID_TO_GCSURL_NEW_schema, REL14_FILEDATA_CURRENT_schema, ANNOTATIONS_schema, CLINICAL_schema]) "WITH annotation_patients AS (SELECT \"case_barcode\", \"category\" AS categoryName, \"classification\" AS classificationName FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"ANNOTATIONS\" WHERE \"entity_type\" = 'Patient' AND (\"category\" = 'History of unacceptable prior treatment related to a prior/other malignancy' OR \"classification\" = 'Redaction')), clinical_patients AS (SELECT \"case_barcode\" FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\" WHERE \"disease_code\" = 'BRCA' AND \"age_at_diagnosis\" <= 30 AND \"gender\" = 'FEMALE'), joined_patients AS (SELECT COALESCE(c.\"case_barcode\", a.\"case_barcode\") AS case_barcode, a.categoryName, a.classificationName FROM clinical_patients AS c FULL JOIN annotation_patients AS a ON c.\"case_barcode\" = a.\"case_barcode\"), filtered_patients AS (SELECT case_barcode FROM joined_patients WHERE categoryName IS NULL AND classificationName IS NULL) SELECT fp.case_barcode, g.\"file_gdc_url\" FROM filtered_patients AS fp JOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_CASEDATA\" AS cd ON fp.case_barcode = cd.\"case_barcode\" JOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_FILEDATA_CURRENT\" AS fd ON cd.\"case_gdc_id\" = fd.\"case_gdc_id\" JOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_GDCFILEID_TO_GCSURL_NEW\" AS g ON fd.\"file_gdc_id\" = g.\"file_gdc_id\" ORDER BY fp.case_barcode, g.\"file_gdc_url\"" = sql%([REL14_CASEDATA_schema, REL14_GDCFILEID_TO_GCSURL_NEW_schema, REL14_FILEDATA_CURRENT_schema, ANNOTATIONS_schema, CLINICAL_schema]) "WITH annot AS (SELECT DISTINCT \"case_barcode\", \"category\" AS categoryName, \"classification\" AS classificationName FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"ANNOTATIONS\" WHERE \"entity_type\" = 'Patient' AND (\"category\" = 'History of unacceptable prior treatment related to a prior/other malignancy' OR \"classification\" = 'Redaction')), clin AS (SELECT DISTINCT \"case_barcode\", \"case_gdc_id\" FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\" WHERE \"disease_code\" = 'BRCA' AND \"age_at_diagnosis\" <= 30 AND \"gender\" = 'FEMALE'), filtered AS (SELECT clin.\"case_barcode\", clin.\"case_gdc_id\" FROM clin FULL JOIN annot ON clin.\"case_barcode\" = annot.\"case_barcode\" WHERE annot.categoryName IS NULL AND annot.classificationName IS NULL) SELECT f.\"case_barcode\", gu.\"file_gdc_url\" FROM filtered AS f JOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_CASEDATA\" AS cd ON f.\"case_barcode\" = cd.\"case_barcode\" JOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_FILEDATA_CURRENT\" AS fd ON cd.\"case_gdc_id\" = fd.\"case_gdc_id\" JOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_GDCFILEID_TO_GCSURL_NEW\" AS gu ON fd.\"file_gdc_id\" = gu.\"file_gdc_id\" ORDER BY f.\"case_barcode\", gu.\"file_gdc_url\"" := by
  first | sql_equiv | sorry

