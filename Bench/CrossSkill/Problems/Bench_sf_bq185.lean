    sql%([TAXI_ZONE_GEOM_schema, TLC_YELLOW_TRIPS_2016_schema]) "SELECT \n  AVG(DATEDIFF('minute', \n    TO_TIMESTAMP(t.\"pickup_datetime\"::NUMBER, 6), \n    TO_TIMESTAMP(t.\"dropoff_datetime\"::NUMBER, 6)\n  )) AS AVG_DURATION\nFROM \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TLC_YELLOW_TRIPS_2016\" t\nJOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" pz \n  ON t.\"pickup_location_id\" = pz.\"zone_id\"\nJOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" dz \n  ON t.\"dropoff_location_id\" = dz.\"zone_id\"\nWHERE TO_TIMESTAMP(t.\"pickup_datetime\"::NUMBER, 6) >= '2016-02-01'\n  AND TO_TIMESTAMP(t.\"pickup_datetime\"::NUMBER, 6) < '2016-02-08'\n  AND t.\"dropoff_datetime\" > t.\"pickup_datetime\"\n  AND t.\"passenger_count\" > 3\n  AND t.\"trip_distance\" >= 10\n  AND pz.\"borough\" = 'Brooklyn'\n  AND dz.\"borough\" = 'Brooklyn';" = sql%([TAXI_ZONE_GEOM_schema, TLC_YELLOW_TRIPS_2016_schema]) "SELECT \n    AVG(TIMESTAMPDIFF('MINUTE', TO_TIMESTAMP(t.\"pickup_datetime\" / 1000000), TO_TIMESTAMP(t.\"dropoff_datetime\" / 1000000))) AS AVG_DURATION\nFROM \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TLC_YELLOW_TRIPS_2016\" t\nJOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" pz\n    ON t.\"pickup_location_id\" = pz.\"zone_id\"\nJOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" dz\n    ON t.\"dropoff_location_id\" = dz.\"zone_id\"\nWHERE DATE(TO_TIMESTAMP(t.\"pickup_datetime\" / 1000000)) BETWEEN '2016-02-01' AND '2016-02-07'\n  AND (t.\"dropoff_datetime\" - t.\"pickup_datetime\") > 0\n  AND t.\"passenger_count\" > 3\n  AND t.\"trip_distance\" >= 10\n  AND pz.\"borough\" = 'Brooklyn'\n  AND dz.\"borough\" = 'Brooklyn';" := by
  first | sql_equiv | sorry

