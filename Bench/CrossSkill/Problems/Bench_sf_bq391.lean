theorem eq_0_1 :
    sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "WITH living_a_patients AS (\n    SELECT \"id\" AS patient_id\n    FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\"\n    WHERE \"name\"[0]:\"family\"::STRING LIKE 'A%'\n      AND \"deceased\" IS NULL\n),\nsingle_condition_patients AS (\n    SELECT \n        c.\"subject\":\"patientId\"::STRING AS patient_id,\n        MAX(c.\"code\":\"coding\"[0]:\"display\"::STRING) AS condition_display,\n        MAX(c.\"code\":\"coding\"[0]:\"code\"::STRING) AS condition_code\n    FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" c\n    WHERE c.\"subject\":\"patientId\"::STRING IN (SELECT patient_id FROM living_a_patients)\n    GROUP BY c.\"subject\":\"patientId\"::STRING\n    HAVING COUNT(DISTINCT c.\"code\":\"coding\"[0]:\"code\"::STRING) = 1\n),\npatient_active_med_counts AS (\n    SELECT \n        sc.patient_id,\n        sc.condition_display,\n        sc.condition_code,\n        COUNT(DISTINCT mr.\"medication\":\"codeableConcept\":\"coding\"[0]:\"code\"::STRING) AS num_active_meds\n    FROM single_condition_patients sc\n    JOIN \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" mr\n        ON mr.\"subject\":\"patientId\"::STRING = sc.patient_id\n        AND mr.\"status\" = 'active'\n    GROUP BY sc.patient_id, sc.condition_display, sc.condition_code\n),\ncondition_max_meds AS (\n    SELECT \n        condition_display AS \"CONDITIONS\",\n        condition_code AS \"CODES\",\n        MAX(num_active_meds) AS max_meds\n    FROM patient_active_med_counts\n    GROUP BY condition_display, condition_code\n)\nSELECT \"CONDITIONS\", \"CODES\"\nFROM condition_max_meds\nORDER BY max_meds DESC\nLIMIT 8;" = sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "WITH living_a_patients AS (\n  SELECT \"id\" AS patient_id\n  FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\"\n  WHERE \"deceased\":dateTime IS NULL\n    AND \"name\"[0]:\"family\"::STRING LIKE 'A%'\n),\npatients_with_single_condition AS (\n  SELECT \"subject\":patientId::STRING AS patient_id\n  FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\"\n  WHERE \"subject\":patientId::STRING IN (SELECT patient_id FROM living_a_patients)\n  GROUP BY 1\n  HAVING COUNT(DISTINCT \"code\":coding[0]:code::STRING) = 1\n),\npatient_condition AS (\n  SELECT DISTINCT\n    \"subject\":patientId::STRING AS patient_id,\n    \"code\":coding[0]:code::STRING AS cond_code,\n    \"code\":coding[0]:display::STRING AS cond_display\n  FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\"\n  WHERE \"subject\":patientId::STRING IN (SELECT patient_id FROM patients_with_single_condition)\n),\npatient_active_med_count AS (\n  SELECT\n    \"subject\":patientId::STRING AS patient_id,\n    COUNT(DISTINCT \"medication\":codeableConcept:coding[0]:code::STRING) AS num_distinct_meds\n  FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\"\n  WHERE \"status\" = 'active'\n    AND \"subject\":patientId::STRING IN (SELECT patient_id FROM patients_with_single_condition)\n  GROUP BY 1\n),\ncondition_max_meds AS (\n  SELECT\n    pc.cond_display AS CONDITIONS,\n    pc.cond_code AS CODES,\n    MAX(pam.num_distinct_meds) AS max_meds\n  FROM patient_condition pc\n  JOIN patient_active_med_count pam ON pc.patient_id = pam.patient_id\n  GROUP BY pc.cond_display, pc.cond_code\n)\nSELECT CONDITIONS, CODES\nFROM condition_max_meds\nORDER BY max_meds DESC, CODES DESC\nLIMIT 8;" := by
