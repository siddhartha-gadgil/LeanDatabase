theorem eq_2_3 :
    sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "-- Among living patients whose last names begin with \"A\" and who each have exactly\n-- one distinct condition, find the 8 conditions with the highest number of different\n-- active medications prescribed to any single patient, along with their codes.\n\nWITH living_a_patients AS (\n    SELECT \"id\" AS patient_id\n    FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\"\n    WHERE \"deceased\" IS NULL\n      AND \"name\"[0]['family']::STRING LIKE 'A%'\n),\npatient_conditions AS (\n    SELECT \n        c.\"subject\"['patientId']::STRING AS patient_id,\n        c.\"code\"['coding'][0]['display']::STRING AS condition_display,\n        c.\"code\"['coding'][0]['code']::STRING AS condition_code\n    FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" c\n    INNER JOIN living_a_patients p ON c.\"subject\"['patientId']::STRING = p.patient_id\n),\n-- Patients with exactly one distinct condition\nsingle_condition_patients AS (\n    SELECT patient_id\n    FROM patient_conditions\n    GROUP BY patient_id\n    HAVING COUNT(DISTINCT condition_display) = 1\n),\n-- Get the condition for each single-condition patient\npatient_single_condition AS (\n    SELECT DISTINCT \n        pc.patient_id,\n        pc.condition_display,\n        pc.condition_code\n    FROM patient_conditions pc\n    INNER JOIN single_condition_patients scp ON pc.patient_id = scp.patient_id\n),\n-- Count distinct active medications per patient\npatient_med_count AS (\n    SELECT \n        psc.condition_display,\n        psc.condition_code,\n        psc.patient_id,\n        COUNT(DISTINCT mr.\"medication\"['codeableConcept']['text']::STRING) AS med_count\n    FROM patient_single_condition psc\n    INNER JOIN \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" mr\n        ON mr.\"subject\"['patientId']::STRING = psc.patient_id\n    WHERE mr.\"status\" = 'active'\n    GROUP BY psc.condition_display, psc.condition_code, psc.patient_id\n),\n-- Get the max med count for any single patient per condition\ncondition_max_meds AS (\n    SELECT \n        condition_display,\n        condition_code,\n        MAX(med_count) AS max_med_count\n    FROM patient_med_count\n    GROUP BY condition_display, condition_code\n)\nSELECT \n    condition_display AS \"CONDITIONS\",\n    condition_code AS \"CODES\"\nFROM condition_max_meds\nORDER BY max_med_count DESC, condition_display ASC\nLIMIT 8;" = sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "WITH living_patients_A AS (\n    SELECT \n        p.\"id\" AS patient_id\n    FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" p\n    WHERE p.\"name\"[0]:family::STRING LIKE 'A%'\n      AND p.\"deceased\":dateTime IS NULL\n),\npatient_conditions AS (\n    SELECT \n        c.\"subject\":patientId::STRING AS patient_id,\n        c.\"code\":coding[0]:display::STRING AS condition_display,\n        c.\"code\":coding[0]:code::STRING AS condition_code\n    FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" c\n    WHERE c.\"subject\":patientId::STRING IN (SELECT patient_id FROM living_patients_A)\n),\nsingle_condition_patients AS (\n    SELECT \n        patient_id,\n        MAX(condition_display) AS condition_display,\n        MAX(condition_code) AS condition_code\n    FROM patient_conditions\n    GROUP BY patient_id\n    HAVING COUNT(DISTINCT condition_display) = 1\n),\nactive_meds_per_patient AS (\n    SELECT \n        mr.\"subject\":patientId::STRING AS patient_id,\n        COUNT(DISTINCT mr.\"medication\":codeableConcept:coding[0]:code::STRING) AS num_active_meds\n    FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" mr\n    WHERE mr.\"status\" = 'active'\n      AND mr.\"subject\":patientId::STRING IN (SELECT patient_id FROM single_condition_patients)\n    GROUP BY mr.\"subject\":patientId::STRING\n),\ncondition_max_meds AS (\n    SELECT \n        scp.condition_display AS CONDITIONS,\n        scp.condition_code AS CODES,\n        MAX(amp.num_active_meds) AS max_meds\n    FROM single_condition_patients scp\n    JOIN active_meds_per_patient amp ON scp.patient_id = amp.patient_id\n    GROUP BY scp.condition_display, scp.condition_code\n)\nSELECT \n    CONDITIONS,\n    CODES\nFROM condition_max_meds\nORDER BY max_meds DESC\nLIMIT 8;" := by
  first | sql_equiv | sorry

end Bench_sf_bq391
