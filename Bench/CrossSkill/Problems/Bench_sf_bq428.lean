    sql%([MBB_HISTORICAL_TOURNAMENT_GAMES_schema, MBB_PBP_SR_schema]) "WITH top_markets AS (\n    -- Find top 5 team markets by distinct players scoring >=15 points in period 2\n    SELECT \"team_market\"\n    FROM (\n        SELECT \"game_id\", \"team_market\", \"player_full_name\", SUM(\"points_scored\") AS total_points\n        FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_PBP_SR\"\n        WHERE \"period\" = 2\n          AND \"season\" BETWEEN 2010 AND 2018\n        GROUP BY \"game_id\", \"team_market\", \"player_full_name\"\n        HAVING SUM(\"points_scored\") >= 15\n    )\n    GROUP BY \"team_market\"\n    ORDER BY COUNT(DISTINCT \"player_full_name\") DESC\n    LIMIT 5\n),\n-- Unpivot historical tournament games: winner side\nwin_rows AS (\n    SELECT\n        h.\"season\",\n        h.\"round\",\n        h.\"days_from_epoch\",\n        h.\"game_date\",\n        h.\"day\",\n        'win' AS \"label\",\n        h.\"win_seed\" AS \"seed\",\n        h.\"win_market\" AS \"market\",\n        h.\"win_name\" AS \"name\",\n        h.\"win_alias\" AS \"alias\",\n        h.\"win_school_ncaa\" AS \"school_ncaa\",\n        h.\"lose_seed\" AS \"opponent_seed\",\n        h.\"lose_market\" AS \"opponent_market\",\n        h.\"lose_name\" AS \"opponent_name\",\n        h.\"lose_alias\" AS \"opponent_alias\",\n        h.\"lose_school_ncaa\" AS \"opponent_school_ncaa\"\n    FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\" h\n    WHERE h.\"season\" BETWEEN 2010 AND 2018\n),\n-- Unpivot historical tournament games: loser side\nlose_rows AS (\n    SELECT\n        h.\"season\",\n        h.\"round\",\n        h.\"days_from_epoch\",\n        h.\"game_date\",\n        h.\"day\",\n        'loss' AS \"label\",\n        h.\"lose_seed\" AS \"seed\",\n        h.\"lose_market\" AS \"market\",\n        h.\"lose_name\" AS \"name\",\n        h.\"lose_alias\" AS \"alias\",\n        h.\"lose_school_ncaa\" AS \"school_ncaa\",\n        h.\"win_seed\" AS \"opponent_seed\",\n        h.\"win_market\" AS \"opponent_market\",\n        h.\"win_name\" AS \"opponent_name\",\n        h.\"win_alias\" AS \"opponent_alias\",\n        h.\"win_school_ncaa\" AS \"opponent_school_ncaa\"\n    FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\" h\n    WHERE h.\"season\" BETWEEN 2010 AND 2018\n),\n-- Combine both sides\nall_games AS (\n    SELECT * FROM win_rows\n    UNION ALL\n    SELECT * FROM lose_rows\n)\nSELECT\n    g.\"season\",\n    g.\"round\",\n    g.\"days_from_epoch\",\n    g.\"game_date\",\n    g.\"day\",\n    g.\"label\",\n    g.\"seed\",\n    g.\"market\",\n    g.\"name\",\n    g.\"alias\",\n    g.\"school_ncaa\",\n    g.\"opponent_seed\",\n    g.\"opponent_market\",\n    g.\"opponent_name\",\n    g.\"opponent_alias\",\n    g.\"opponent_school_ncaa\"\nFROM all_games g\nINNER JOIN top_markets tm ON g.\"market\" = tm.\"team_market\"\nORDER BY g.\"market\", g.\"season\", g.\"round\" DESC;" = sql%([MBB_HISTORICAL_TOURNAMENT_GAMES_schema, MBB_PBP_SR_schema]) "WITH top5_markets AS (\n  SELECT \"team_market\"\n  FROM (\n    SELECT \"player_id\", \"team_market\", \"game_id\", SUM(\"points_scored\") AS total_points\n    FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_PBP_SR\"\n    WHERE \"period\" = 2\n      AND \"season\" BETWEEN 2010 AND 2018\n    GROUP BY \"player_id\", \"team_market\", \"game_id\"\n    HAVING SUM(\"points_scored\") >= 15\n  ) sub\n  GROUP BY \"team_market\"\n  ORDER BY COUNT(DISTINCT \"player_id\") DESC\n  LIMIT 5\n),\ntournament_unpivot AS (\n  -- Wins: team is the winner\n  SELECT\n    t.\"season\",\n    t.\"round\",\n    t.\"days_from_epoch\",\n    t.\"game_date\",\n    t.\"day\",\n    'win' AS \"label\",\n    t.\"win_seed\" AS \"seed\",\n    t.\"win_market\" AS \"market\",\n    t.\"win_name\" AS \"name\",\n    t.\"win_alias\" AS \"alias\",\n    t.\"win_school_ncaa\" AS \"school_ncaa\",\n    t.\"lose_seed\" AS \"opponent_seed\",\n    t.\"lose_market\" AS \"opponent_market\",\n    t.\"lose_name\" AS \"opponent_name\",\n    t.\"lose_alias\" AS \"opponent_alias\",\n    t.\"lose_school_ncaa\" AS \"opponent_school_ncaa\"\n  FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\" t\n  JOIN top5_markets m ON t.\"win_market\" = m.\"team_market\"\n  WHERE t.\"season\" BETWEEN 2010 AND 2018\n\n  UNION ALL\n\n  -- Losses: team is the loser\n  SELECT\n    t.\"season\",\n    t.\"round\",\n    t.\"days_from_epoch\",\n    t.\"game_date\",\n    t.\"day\",\n    'loss' AS \"label\",\n    t.\"lose_seed\" AS \"seed\",\n    t.\"lose_market\" AS \"market\",\n    t.\"lose_name\" AS \"name\",\n    t.\"lose_alias\" AS \"alias\",\n    t.\"lose_school_ncaa\" AS \"school_ncaa\",\n    t.\"win_seed\" AS \"opponent_seed\",\n    t.\"win_market\" AS \"opponent_market\",\n    t.\"win_name\" AS \"opponent_name\",\n    t.\"win_alias\" AS \"opponent_alias\",\n    t.\"win_school_ncaa\" AS \"opponent_school_ncaa\"\n  FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\" t\n  JOIN top5_markets m ON t.\"lose_market\" = m.\"team_market\"\n  WHERE t.\"season\" BETWEEN 2010 AND 2018\n)\nSELECT\n  \"season\",\n  \"round\",\n  \"days_from_epoch\",\n  \"game_date\",\n  \"day\",\n  \"label\",\n  \"seed\",\n  \"market\",\n  \"name\",\n  \"alias\",\n  \"school_ncaa\",\n  \"opponent_seed\",\n  \"opponent_market\",\n  \"opponent_name\",\n  \"opponent_alias\",\n  \"opponent_school_ncaa\"\nFROM tournament_unpivot\nORDER BY \"market\", \"season\", \"round\" DESC" := by
