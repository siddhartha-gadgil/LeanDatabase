    (sql%([HURRICANES_schema]) "/* Find the latitude of the final coordinates for the hurricane that traveled */ /* the second longest distance in the North Atlantic during 2020. */ /* Distance is computed as total path distance (sum of consecutive segment distances). */ WITH ordered_points AS (SELECT \"sid\", \"iso_time\", \"latitude\", \"longitude\", LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat, LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" WHERE \"season\" = '2020' AND \"basin\" = 'NA'), hurricane_distances AS (SELECT \"sid\", SUM(ST_DISTANCE(ST_POINT(\"longitude\", \"latitude\"), ST_POINT(prev_lon, prev_lat))) AS total_distance FROM ordered_points WHERE NOT prev_lat IS NULL GROUP BY \"sid\" ORDER BY total_distance DESC LIMIT 2), second_longest AS (SELECT \"sid\" FROM (SELECT \"sid\", total_distance, ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rn FROM hurricane_distances) WHERE rn = 2), final_point AS (SELECT h.\"latitude\" AS OUTPUT, ROW_NUMBER() OVER (ORDER BY h.\"iso_time\" DESC) AS rn FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" AS h JOIN second_longest AS s ON h.\"sid\" = s.\"sid\") SELECT OUTPUT FROM final_point WHERE rn = 1") t0
  ~= (sql%([HURRICANES_schema]) "WITH ordered_obs AS (SELECT \"sid\", \"latitude\", \"longitude\", \"iso_time\", ROW_NUMBER() OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS rn, COUNT(*) OVER (PARTITION BY \"sid\") AS total_obs FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" WHERE \"season\" = '2020' AND \"basin\" = 'NA'), segments AS (SELECT a.\"sid\", ST_DISTANCE(ST_POINT(a.\"longitude\", a.\"latitude\"), ST_POINT(b.\"longitude\", b.\"latitude\")) AS segment_dist FROM ordered_obs AS a JOIN ordered_obs AS b ON a.\"sid\" = b.\"sid\" AND a.rn = b.rn - 1), total_distances AS (SELECT \"sid\", SUM(segment_dist) AS total_distance FROM segments GROUP BY \"sid\" ORDER BY total_distance DESC), ranked AS (SELECT \"sid\", total_distance, ROW_NUMBER() OVER (ORDER BY total_distance DESC) AS rank_num FROM total_distances), second_longest AS (SELECT \"sid\" FROM ranked WHERE rank_num = 2), final_coord AS (SELECT o.\"latitude\" FROM ordered_obs AS o JOIN second_longest AS s ON o.\"sid\" = s.\"sid\" WHERE o.rn = o.total_obs) SELECT \"latitude\" AS \"OUTPUT\" FROM final_coord") t0
