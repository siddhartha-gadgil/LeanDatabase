import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq045_eq_1_3

CREATE TABLE STATIONS («usaf» STRING, «wban» STRING, «name» STRING, «country» STRING, «state» STRING, «call» STRING, «lat» FLOAT, «lon» FLOAT, «elev» STRING, «begin» STRING, «end» STRING)
CREATE TABLE GSOD2023 («stn» STRING, «wban» STRING, «date» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)
CREATE TABLE GSOD2022 («stn» STRING, «wban» STRING, «date» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)

theorem eq (t0 : TableRel STATIONS_schema) (t1 : TableRel GSOD2023_schema) (t2 : TableRel GSOD2022_schema) :
    (sql%([STATIONS_schema, GSOD2023_schema, GSOD2022_schema]) "WITH rainy_2023 AS (SELECT g.\"stn\" AS STATION_ID, g.\"wban\" AS WBAN, s.\"name\" AS STATION_NAME, COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" <> 99.99 THEN 1 END) AS RAINY_DAYS_2023 FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" AS g JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE s.\"state\" = 'WA' GROUP BY g.\"stn\", g.\"wban\", s.\"name\" HAVING COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" <> 99.99 THEN 1 END) > 150), rainy_2022 AS (SELECT g.\"stn\" AS STATION_ID, g.\"wban\" AS WBAN, COUNT(CASE WHEN g.\"prcp\" > 0 AND g.\"prcp\" <> 99.99 THEN 1 END) AS RAINY_DAYS_2022 FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2022\" AS g JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE s.\"state\" = 'WA' GROUP BY g.\"stn\", g.\"wban\") SELECT r23.STATION_ID, r23.STATION_NAME, r23.RAINY_DAYS_2023, r22.RAINY_DAYS_2022 FROM rainy_2023 AS r23 JOIN rainy_2022 AS r22 ON r23.STATION_ID = r22.STATION_ID AND r23.WBAN = r22.WBAN WHERE r23.RAINY_DAYS_2023 < r22.RAINY_DAYS_2022 ORDER BY r23.RAINY_DAYS_2023 DESC") t0 t1 t2
  ~= (sql%([STATIONS_schema, GSOD2023_schema, GSOD2022_schema]) "WITH wa_stations AS (SELECT DISTINCT \"usaf\", \"wban\", \"name\" FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" WHERE \"state\" = 'WA'), rainy_2023 AS (SELECT g.\"stn\" AS STATION_ID, g.\"wban\" AS WBAN, s.\"name\" AS STATION_NAME, COUNT(*) AS RAINY_DAYS_2023 FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" AS g JOIN wa_stations AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE g.\"prcp\" > 0 AND g.\"prcp\" <> 99.99 GROUP BY g.\"stn\", g.\"wban\", s.\"name\"), rainy_2022 AS (SELECT g.\"stn\" AS STATION_ID, g.\"wban\" AS WBAN, COUNT(*) AS RAINY_DAYS_2022 FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2022\" AS g JOIN wa_stations AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE g.\"prcp\" > 0 AND g.\"prcp\" <> 99.99 GROUP BY g.\"stn\", g.\"wban\") SELECT r23.STATION_ID, r23.STATION_NAME, r23.RAINY_DAYS_2023, r22.RAINY_DAYS_2022 FROM rainy_2023 AS r23 JOIN rainy_2022 AS r22 ON r23.STATION_ID = r22.STATION_ID AND r23.WBAN = r22.WBAN WHERE r23.RAINY_DAYS_2023 > 150 AND r23.RAINY_DAYS_2023 < r22.RAINY_DAYS_2022 ORDER BY r23.RAINY_DAYS_2023 DESC") t0 t1 t2
  := by first | sql_equiv | sorry

end N_sf_bq045_eq_1_3
