import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local196 — crossskill equivalence(s)

Question: For each rating category of the first movie rented by customers—where the first movie is identified based on the earliest payment date per customer—please provide the average total amount spent per customer and the average number of subsequent rentals (calculated as the total number of rentals minus one) for customers whose first rented movie falls into that rating category.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local196

CREATE TABLE PAYMENT («payment_id» INT, «customer_id» INT, «staff_id» INT, «rental_id» FLOAT, «amount» FLOAT, «payment_date» STRING, «last_update» STRING)
CREATE TABLE RENTAL («rental_id» INT, «rental_date» STRING, «inventory_id» INT, «customer_id» INT, «return_date» STRING, «staff_id» INT, «last_update» STRING)
CREATE TABLE CUSTOMER («customer_id» INT, «store_id» INT, «first_name» STRING, «last_name» STRING, «email» STRING, «address_id» INT, «active» STRING, «create_date» STRING, «last_update» STRING)
CREATE TABLE INVENTORY («inventory_id» INT, «film_id» INT, «store_id» INT, «last_update» STRING)
CREATE TABLE FILM («film_id» INT, «title» STRING, «description» STRING, «release_year» STRING, «language_id» INT, «original_language_id» STRING, «rental_duration» INT, «rental_rate» FLOAT, «length» INT, «replacement_cost» FLOAT, «rating» STRING, «special_features» STRING, «last_update» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([PAYMENT_schema, RENTAL_schema, CUSTOMER_schema, INVENTORY_schema, FILM_schema]) "WITH first_payment AS (\n  -- Find earliest payment date per customer\n  SELECT \"customer_id\", MIN(\"payment_date\") AS first_payment_date\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\nfirst_movie_rating AS (\n  -- Get the rating of the first movie rented (identified by earliest payment date)\n  SELECT fp.\"customer_id\", f.\"rating\"\n  FROM first_payment fp\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p \n    ON fp.\"customer_id\" = p.\"customer_id\" \n    AND fp.first_payment_date = p.\"payment_date\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r \n    ON p.\"rental_id\" = r.\"rental_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"INVENTORY\" i \n    ON r.\"inventory_id\" = i.\"inventory_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"FILM\" f \n    ON i.\"film_id\" = f.\"film_id\"\n),\ncustomer_total_spend AS (\n  -- Total amount spent per customer (all payments)\n  SELECT \"customer_id\", SUM(\"amount\") AS total_spend\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\ncustomer_rental_count AS (\n  -- Total number of rentals per customer\n  SELECT \"customer_id\", COUNT(*) AS total_rentals\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\"\n  GROUP BY \"customer_id\"\n)\nSELECT \n  fmr.\"rating\",\n  AVG(cts.total_spend) AS AVG_TOTAL_SPEND,\n  AVG(crc.total_rentals - 1) AS AVG_SUBSEQUENT_RENTAL_COUNT\nFROM first_movie_rating fmr\nJOIN customer_total_spend cts ON fmr.\"customer_id\" = cts.\"customer_id\"\nJOIN customer_rental_count crc ON fmr.\"customer_id\" = crc.\"customer_id\"\nGROUP BY fmr.\"rating\"\nORDER BY fmr.\"rating\";") t ~= (sql%([PAYMENT_schema, RENTAL_schema, CUSTOMER_schema, INVENTORY_schema, FILM_schema]) "WITH first_payment AS (\n  SELECT \"customer_id\", MIN(\"payment_date\") AS min_payment_date\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\nfirst_film_rating AS (\n  SELECT fp.\"customer_id\", f.\"rating\"\n  FROM first_payment fp\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p \n    ON fp.\"customer_id\" = p.\"customer_id\" AND fp.min_payment_date = p.\"payment_date\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r \n    ON p.\"rental_id\" = r.\"rental_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"INVENTORY\" i \n    ON r.\"inventory_id\" = i.\"inventory_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"FILM\" f \n    ON i.\"film_id\" = f.\"film_id\"\n),\ncustomer_spend AS (\n  SELECT \"customer_id\", \n         SUM(\"amount\") AS total_spend\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\ncustomer_rentals AS (\n  SELECT \"customer_id\",\n         COUNT(*) AS total_rentals\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\"\n  GROUP BY \"customer_id\"\n)\nSELECT fr.\"rating\",\n       AVG(cs.total_spend) AS AVG_TOTAL_SPEND,\n       AVG(cr.total_rentals - 1) AS AVG_SUBSEQUENT_RENTAL_COUNT\nFROM first_film_rating fr\nJOIN customer_spend cs ON fr.\"customer_id\" = cs.\"customer_id\"\nJOIN customer_rentals cr ON fr.\"customer_id\" = cr.\"customer_id\"\nGROUP BY fr.\"rating\"\nORDER BY fr.\"rating\";") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([PAYMENT_schema, RENTAL_schema, CUSTOMER_schema, INVENTORY_schema, FILM_schema]) "WITH first_payment AS (\n  -- Find earliest payment date per customer\n  SELECT \"customer_id\", MIN(\"payment_date\") AS first_payment_date\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\nfirst_movie_rating AS (\n  -- Get the rating of the first movie rented (identified by earliest payment date)\n  SELECT fp.\"customer_id\", f.\"rating\"\n  FROM first_payment fp\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p \n    ON fp.\"customer_id\" = p.\"customer_id\" \n    AND fp.first_payment_date = p.\"payment_date\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r \n    ON p.\"rental_id\" = r.\"rental_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"INVENTORY\" i \n    ON r.\"inventory_id\" = i.\"inventory_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"FILM\" f \n    ON i.\"film_id\" = f.\"film_id\"\n),\ncustomer_total_spend AS (\n  -- Total amount spent per customer (all payments)\n  SELECT \"customer_id\", SUM(\"amount\") AS total_spend\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\ncustomer_rental_count AS (\n  -- Total number of rentals per customer\n  SELECT \"customer_id\", COUNT(*) AS total_rentals\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\"\n  GROUP BY \"customer_id\"\n)\nSELECT \n  fmr.\"rating\",\n  AVG(cts.total_spend) AS AVG_TOTAL_SPEND,\n  AVG(crc.total_rentals - 1) AS AVG_SUBSEQUENT_RENTAL_COUNT\nFROM first_movie_rating fmr\nJOIN customer_total_spend cts ON fmr.\"customer_id\" = cts.\"customer_id\"\nJOIN customer_rental_count crc ON fmr.\"customer_id\" = crc.\"customer_id\"\nGROUP BY fmr.\"rating\"\nORDER BY fmr.\"rating\";") t ~= (sql%([PAYMENT_schema, RENTAL_schema, CUSTOMER_schema, INVENTORY_schema, FILM_schema]) "WITH first_rental AS (\n    -- For each customer, find the first rental (earliest rental_date)\n    SELECT\n        r.\"customer_id\",\n        r.\"rental_id\",\n        r.\"inventory_id\",\n        ROW_NUMBER() OVER (PARTITION BY r.\"customer_id\" ORDER BY r.\"rental_date\" ASC) AS rn\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r\n),\nfirst_rental_rating AS (\n    -- Get the rating of the first rented film for each customer\n    SELECT\n        fr.\"customer_id\",\n        f.\"rating\"\n    FROM first_rental fr\n    JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"INVENTORY\" i ON fr.\"inventory_id\" = i.\"inventory_id\"\n    JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"FILM\" f ON i.\"film_id\" = f.\"film_id\"\n    WHERE fr.rn = 1\n),\ncustomer_totals AS (\n    -- For each customer, compute total spend from PAYMENT and total rental count from RENTAL\n    SELECT\n        p.\"customer_id\",\n        SUM(p.\"amount\") AS total_spend\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p\n    GROUP BY p.\"customer_id\"\n),\ncustomer_rental_counts AS (\n    SELECT\n        r.\"customer_id\",\n        COUNT(*) AS total_rental_count\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r\n    GROUP BY r.\"customer_id\"\n)\nSELECT\n    frr.\"rating\",\n    AVG(ct.total_spend) AS \"AVG_TOTAL_SPEND\",\n    AVG(crc.total_rental_count - 1) AS \"AVG_SUBSEQUENT_RENTAL_COUNT\"\nFROM first_rental_rating frr\nJOIN customer_totals ct ON frr.\"customer_id\" = ct.\"customer_id\"\nJOIN customer_rental_counts crc ON frr.\"customer_id\" = crc.\"customer_id\"\nGROUP BY frr.\"rating\"\nORDER BY frr.\"rating\";") t := by
  intro t; first | sql_equiv | sorry

theorem eq_1_2 : ∀ t,
    (sql%([PAYMENT_schema, RENTAL_schema, CUSTOMER_schema, INVENTORY_schema, FILM_schema]) "WITH first_payment AS (\n  SELECT \"customer_id\", MIN(\"payment_date\") AS min_payment_date\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\nfirst_film_rating AS (\n  SELECT fp.\"customer_id\", f.\"rating\"\n  FROM first_payment fp\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p \n    ON fp.\"customer_id\" = p.\"customer_id\" AND fp.min_payment_date = p.\"payment_date\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r \n    ON p.\"rental_id\" = r.\"rental_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"INVENTORY\" i \n    ON r.\"inventory_id\" = i.\"inventory_id\"\n  JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"FILM\" f \n    ON i.\"film_id\" = f.\"film_id\"\n),\ncustomer_spend AS (\n  SELECT \"customer_id\", \n         SUM(\"amount\") AS total_spend\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\"\n  GROUP BY \"customer_id\"\n),\ncustomer_rentals AS (\n  SELECT \"customer_id\",\n         COUNT(*) AS total_rentals\n  FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\"\n  GROUP BY \"customer_id\"\n)\nSELECT fr.\"rating\",\n       AVG(cs.total_spend) AS AVG_TOTAL_SPEND,\n       AVG(cr.total_rentals - 1) AS AVG_SUBSEQUENT_RENTAL_COUNT\nFROM first_film_rating fr\nJOIN customer_spend cs ON fr.\"customer_id\" = cs.\"customer_id\"\nJOIN customer_rentals cr ON fr.\"customer_id\" = cr.\"customer_id\"\nGROUP BY fr.\"rating\"\nORDER BY fr.\"rating\";") t ~= (sql%([PAYMENT_schema, RENTAL_schema, CUSTOMER_schema, INVENTORY_schema, FILM_schema]) "WITH first_rental AS (\n    -- For each customer, find the first rental (earliest rental_date)\n    SELECT\n        r.\"customer_id\",\n        r.\"rental_id\",\n        r.\"inventory_id\",\n        ROW_NUMBER() OVER (PARTITION BY r.\"customer_id\" ORDER BY r.\"rental_date\" ASC) AS rn\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r\n),\nfirst_rental_rating AS (\n    -- Get the rating of the first rented film for each customer\n    SELECT\n        fr.\"customer_id\",\n        f.\"rating\"\n    FROM first_rental fr\n    JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"INVENTORY\" i ON fr.\"inventory_id\" = i.\"inventory_id\"\n    JOIN \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"FILM\" f ON i.\"film_id\" = f.\"film_id\"\n    WHERE fr.rn = 1\n),\ncustomer_totals AS (\n    -- For each customer, compute total spend from PAYMENT and total rental count from RENTAL\n    SELECT\n        p.\"customer_id\",\n        SUM(p.\"amount\") AS total_spend\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"PAYMENT\" p\n    GROUP BY p.\"customer_id\"\n),\ncustomer_rental_counts AS (\n    SELECT\n        r.\"customer_id\",\n        COUNT(*) AS total_rental_count\n    FROM \"SQLITE_SAKILA\".\"SQLITE_SAKILA\".\"RENTAL\" r\n    GROUP BY r.\"customer_id\"\n)\nSELECT\n    frr.\"rating\",\n    AVG(ct.total_spend) AS \"AVG_TOTAL_SPEND\",\n    AVG(crc.total_rental_count - 1) AS \"AVG_SUBSEQUENT_RENTAL_COUNT\"\nFROM first_rental_rating frr\nJOIN customer_totals ct ON frr.\"customer_id\" = ct.\"customer_id\"\nJOIN customer_rental_counts crc ON frr.\"customer_id\" = crc.\"customer_id\"\nGROUP BY frr.\"rating\"\nORDER BY frr.\"rating\";") t := by
