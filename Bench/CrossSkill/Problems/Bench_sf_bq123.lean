/-!
# sf_bq123 — crossskill equivalence(s)

Question: You need to determine which day of the week has the third highest percentage of questions on Stack Overflow that receive an answer within an hour. To do this, use the question creation date from the posts_questions table and the earliest answer creation date from the posts_answers table. Once you’ve calculated the percentage of questions that get answered within an hour for each day, identify the day with the third highest percentage and report that percentage.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq123

CREATE TABLE POSTS_ANSWERS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» STRING, «answer_count» STRING, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» STRING, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» INT, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» STRING)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

theorem eq_0_1 :
    sql%([POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH earliest_answers AS (\n  SELECT \n    \"parent_id\",\n    MIN(\"creation_date\") AS earliest_answer_date\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n  GROUP BY \"parent_id\"\n),\nquestion_stats AS (\n  SELECT \n    DAYNAME(TO_TIMESTAMP(q.\"creation_date\" / 1000000)) AS DAY_OF_WEEK,\n    CASE \n      WHEN ea.earliest_answer_date IS NOT NULL \n           AND (ea.earliest_answer_date - q.\"creation_date\") / 1000000.0 <= 3600 \n      THEN 1 \n      ELSE 0 \n    END AS answered_within_hour\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n  LEFT JOIN earliest_answers ea ON q.\"id\" = ea.\"parent_id\"\n),\nday_pct AS (\n  SELECT \n    DAY_OF_WEEK,\n    ROUND(100.0 * SUM(answered_within_hour) / COUNT(*), 6) AS PCT_WITHIN_1H\n  FROM question_stats\n  GROUP BY DAY_OF_WEEK\n),\nranked AS (\n  SELECT \n    DAY_OF_WEEK,\n    PCT_WITHIN_1H,\n    ROW_NUMBER() OVER (ORDER BY PCT_WITHIN_1H DESC) AS rn\n  FROM day_pct\n)\nSELECT DAY_OF_WEEK, PCT_WITHIN_1H\nFROM ranked\nWHERE rn = 3;" = sql%([POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH earliest_answers AS (\n  SELECT\n    \"parent_id\",\n    MIN(\"creation_date\") AS earliest_answer_date\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n  GROUP BY \"parent_id\"\n),\nday_stats AS (\n  SELECT\n    DAYNAME(TO_TIMESTAMP(q.\"creation_date\" / 1000000)) AS DAY_OF_WEEK,\n    COUNT(*) AS total_questions,\n    SUM(\n      CASE\n        WHEN ea.earliest_answer_date IS NOT NULL\n          AND DATEDIFF(\n                'second',\n                TO_TIMESTAMP(q.\"creation_date\" / 1000000),\n                TO_TIMESTAMP(ea.earliest_answer_date / 1000000)\n              ) <= 3600\n        THEN 1\n        ELSE 0\n      END\n    ) AS answered_within_hour\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n  LEFT JOIN earliest_answers ea ON q.\"id\" = ea.\"parent_id\"\n  GROUP BY DAYNAME(TO_TIMESTAMP(q.\"creation_date\" / 1000000))\n),\nranked AS (\n  SELECT\n    DAY_OF_WEEK,\n    100.0 * answered_within_hour / total_questions AS PCT_WITHIN_1H,\n    ROW_NUMBER() OVER (ORDER BY 100.0 * answered_within_hour / total_questions DESC) AS rn\n  FROM day_stats\n)\nSELECT\n  DAY_OF_WEEK,\n  PCT_WITHIN_1H\nFROM ranked\nWHERE rn = 3;" := by
  first | sql_equiv | sorry

