_NUMBER() OVER (ORDER BY PCT_WITHIN_1H DESC) AS rn\n  FROM day_stats\n)\nSELECT\n  DAY_OF_WEEK,\n  PCT_WITHIN_1H\nFROM ranked\nWHERE rn = 3;") t := by
