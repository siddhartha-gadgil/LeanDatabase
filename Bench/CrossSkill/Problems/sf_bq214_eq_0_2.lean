CREATE TABLE ABS_AND_EMB («publication_number» STRING, «title» STRING, «title_translated» BOOL, «abstract» STRING, «abstract_translated» BOOL, «cpc» STRING, «cpc_low» STRING, «cpc_inventive_low» STRING, «top_terms» STRING, «similar» STRING, «url» STRING, «country» STRING, «publication_description» STRING, «cited_by» STRING, «embedding_v1» STRING)

theorem eq (t0 : TableRel PUBLICATIONS_schema) (t1 : TableRel ABS_AND_EMB_schema) :
    (sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "/* Step 1: Identify US B2 utility patents granted 2010-2014 */ WITH target_patents AS (SELECT p.\"publication_number\", p.\"filing_date\", p.\"grant_date\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" = 'B2' AND FLOOR(CAST(p.\"grant_date\" AS DOUBLE PRECISION) / 10000) BETWEEN 2010 AND 2014), forward_citation_counts /* Step 2: Count forward citations within a month of filing date */ /* Forward citations = other patents in PUBLICATIONS whose citation array references the target patent */ /* \"Within a month\" = citing patent's filing_date within 30 days of target patent's filing_date */ AS (SELECT t.\"publication_number\" AS focal_pub, t.\"filing_date\" AS focal_filing_date, t.\"grant_date\" AS focal_grant_date, COUNT(*) AS citation_count FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS citing, LATERAL UNNEST(input => citing.\"citation\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) JOIN target_patents AS t ON CAST(JSON_EXTRACT_PATH(f.value, 'publication_number') AS TEXT) = t.\"publication_number\" WHERE citing.\"filing_date\" > 0 AND ABS((CAST(CAST(TO_TIMESTAMP(CAST(citing.\"filing_date\" AS VARCHAR), 'YYYYMMDD') AS DATE) AS DATE) - CAST(CAST(TO_TIMESTAMP(CAST(t.\"filing_date\" AS VARCHAR), 'YYYYMMDD') AS DATE) AS DATE))) <= 30 GROUP BY t.\"publication_number\", t.\"filing_date\", t.\"grant_date\"), top_patent /* Step 3: Find the patent with the most forward citations (tiebreak by grant_date ASC) */ AS (SELECT focal_pub, focal_filing_date, citation_count FROM forward_citation_counts ORDER BY citation_count DESC, focal_grant_date ASC LIMIT 1), target_emb /* Step 4: Get the top patent's embedding */ AS (SELECT a.\"embedding_v1\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a JOIN top_patent AS tp ON a.\"publication_number\" = tp.focal_pub), candidates /* Step 5: Find all candidate patents from the same filing year (regardless of type) */ AS (SELECT a.\"publication_number\", a.\"embedding_v1\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p ON a.\"publication_number\" = p.\"publication_number\" JOIN top_patent AS tp ON 1 = 1 WHERE FLOOR(CAST(p.\"filing_date\" AS DOUBLE PRECISION) / 10000) = FLOOR(CAST(tp.focal_filing_date AS DOUBLE PRECISION) / 10000) AND a.\"publication_number\" <> tp.focal_pub AND ARRAY_LENGTH(a.\"embedding_v1\", 1) = 64), dot_products /* Step 6: Compute dot product similarity */ AS (SELECT c.\"publication_number\", SUM(CAST(te.value AS DOUBLE PRECISION) * CAST(ce.value AS DOUBLE PRECISION)) AS similarity FROM candidates AS c, target_emb AS t, LATERAL UNNEST(input => t.\"embedding_v1\") AS te(SEQ, KEY, PATH, INDEX, VALUE, THIS), LATERAL UNNEST(input => c.\"embedding_v1\") AS ce(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE te.index = ce.index GROUP BY c.\"publication_number\"), most_similar /* Step 7: Find the most similar patent */ AS (SELECT \"publication_number\" AS similar_patent, similarity FROM dot_products ORDER BY similarity DESC LIMIT 1) /* Final result */ SELECT tp.focal_pub, tp.citation_count, ms.similar_patent FROM top_patent AS tp CROSS JOIN most_similar AS ms") t0 t1
  ~= (sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "/* Find US B2 patent granted 2010-2014 with most forward citations within a month of filing date */ /* Then find the most similar patent from the same filing year using embedding dot product */ WITH focal_patents AS (/* US utility patents (B2) granted between 2010 and 2014 */ SELECT p.\"publication_number\", p.\"filing_date\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" = 'B2' AND p.\"grant_date\" >= 20100101 AND p.\"grant_date\" <= 20141231 AND p.\"filing_date\" > 0), forward_citations AS (/* Forward citations: other patents in PUBLICATIONS that cite the focal patent */ /* Filter to those filed within 30 days of the focal patent's filing date */ SELECT fp.\"publication_number\" AS focal_pub, fp.\"filing_date\" AS focal_fd, p2.\"publication_number\" AS citing_pub, p2.\"filing_date\" AS citing_fd FROM focal_patents AS fp, \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p2 CROSS JOIN LATERAL UNNEST(input => p2.\"citation\") AS c(SEQ, KEY, PATH, INDEX, VALUE, THIS) ON CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) = fp.\"publication_number\" WHERE p2.\"filing_date\" > 0 AND ABS((CAST(CAST(TO_TIMESTAMP(CAST(p2.\"filing_date\" AS TEXT), 'YYYYMMDD') AS DATE) AS DATE) - CAST(CAST(TO_TIMESTAMP(CAST(fp.\"filing_date\" AS TEXT), 'YYYYMMDD') AS DATE) AS DATE))) <= 30), citation_counts AS (SELECT focal_pub, focal_fd, COUNT(*) AS citation_count FROM forward_citations GROUP BY focal_pub, focal_fd), top_patent AS (SELECT focal_pub, focal_fd, citation_count FROM citation_counts ORDER BY citation_count DESC LIMIT 1), focal_embedding /* Find most similar patent from same filing year using embedding dot product */ AS (SELECT a.\"embedding_v1\" AS focal_emb FROM top_patent AS tp JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a ON tp.focal_pub = a.\"publication_number\"), candidates AS (/* All patents from the same filing year (regardless of type) */ SELECT p.\"publication_number\", a.\"embedding_v1\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a ON p.\"publication_number\" = a.\"publication_number\" JOIN top_patent AS tp ON 1 = 1 WHERE FLOOR(CAST(p.\"filing_date\" AS DOUBLE PRECISION) / 10000) = FLOOR(CAST(tp.focal_fd AS DOUBLE PRECISION) / 10000) AND p.\"publication_number\" <> tp.focal_pub AND NOT a.\"embedding_v1\" IS NULL), similarity_scores AS (SELECT c.\"publication_number\" AS similar_pub, SUM(CAST(fe.value AS DOUBLE PRECISION) * CAST(ce.value AS DOUBLE PRECISION)) AS dot_product FROM candidates AS c, focal_embedding AS f, LATERAL UNNEST(input => f.focal_emb) AS fe(SEQ, KEY, PATH, INDEX, VALUE, THIS), LATERAL UNNEST(input => c.\"embedding_v1\") AS ce(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE fe.index = ce.index GROUP BY c.\"publication_number\") SELECT tp.focal_pub AS \"FOCAL_PUB\", tp.citation_count AS \"CITATION_COUNT\", ss.similar_pub AS \"SIMILAR_PATENT\" FROM top_patent AS tp, (SELECT similar_pub FROM similarity_scores ORDER BY dot_product DESC LIMIT 1) AS ss") t0 t1
