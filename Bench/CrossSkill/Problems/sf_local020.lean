(*) AS total_wickets FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" AS w ON b.\"match_id\" = w.\"match_id\" AND b.\"over_id\" = w.\"over_id\" AND b.\"ball_id\" = w.\"ball_id\" AND b.\"innings_no\" = w.\"innings_no\" WHERE NOT w.\"kind_out\" IN ('run out', 'retired hurt', 'obstructing the field') GROUP BY b.\"bowler\"), bowling_avg AS (SELECT w.player_id, CAST((COALESCE(r.bat_runs, 0) + COALESCE(e.extra_runs_total, 0)) * 1.0 AS DOUBLE PRECISION) / w.total_wickets AS bowling_average FROM wickets AS w LEFT JOIN runs_conceded AS r ON w.player_id = r.player_id LEFT JOIN extras_conceded AS e ON w.player_id = e.player_id WHERE w.total_wickets > 0) SELECT p.\"player_name\" AS \"OUTPUT\" FROM bowling_avg AS ba JOIN \"IPL\".\"IPL\".\"PLAYER\" AS p ON ba.player_id = p.\"player_id\" ORDER BY ba.bowling_average ASC LIMIT 1") t := by
  intro t; first | sql_equiv | sorry

