CREATE TABLE EVENTS («id» INT, «user_id» INT, «sequence_number» INT, «session_id» STRING, «created_at» INT, «ip_address» STRING, «city» STRING, «state» STRING, «postal_code» STRING, «browser» STRING, «traffic_source» STRING, «uri» STRING, «event_type» STRING)
CREATE TABLE PRODUCTS («id» INT, «cost» FLOAT, «category» STRING, «name» STRING, «brand» STRING, «retail_price» FLOAT, «department» STRING, «sku» STRING, «distribution_center_id» INT)
CREATE TABLE ORDER_ITEMS («id» INT, «order_id» INT, «user_id» INT, «product_id» INT, «inventory_item_id» INT, «status» STRING, «created_at» INT, «shipped_at» INT, «delivered_at» INT, «returned_at» INT, «sale_price» FLOAT)

theorem eq (t0 : TableRel EVENTS_schema) (t1 : TableRel PRODUCTS_schema) (t2 : TableRel ORDER_ITEMS_schema) :
    (sql%([EVENTS_schema, PRODUCTS_schema, ORDER_ITEMS_schema]) "/* Step 1: Find the category with the highest total purchase quantity */ WITH top_category AS (SELECT p.\"category\" AS TOP_CATEGORY, COUNT(*) AS total_purchase_quantity FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" AS oi JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"id\" GROUP BY p.\"category\" ORDER BY total_purchase_quantity DESC LIMIT 1), events_with_next /* Step 2: Add next event timestamp using LEAD window function */ AS (SELECT \"session_id\", \"event_type\", \"uri\", \"created_at\", \"sequence_number\", LEAD(\"created_at\") OVER (PARTITION BY \"session_id\" ORDER BY \"sequence_number\") AS next_event_time FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"EVENTS\"), product_page_times /* Step 3: Calculate time on page for product views in the top category */ AS (SELECT CAST((e.next_event_time - e.\"created_at\") AS DOUBLE PRECISION) / 60000000.0 AS time_on_page_minutes FROM events_with_next AS e JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON CAST(SPLIT_PART(e.\"uri\", '/', 3) AS DECIMAL(38, 0)) = p.\"id\" JOIN top_category AS tc ON p.\"category\" = tc.TOP_CATEGORY WHERE e.\"event_type\" = 'product' AND NOT e.next_event_time IS NULL) /* Step 4: Return the top category and its average page visit time */ SELECT tc.TOP_CATEGORY, ROUND(CAST(AVG(ppt.time_on_page_minutes) AS DECIMAL), 2) AS AVG_MINUTES_SPENT FROM product_page_times AS ppt CROSS JOIN top_category AS tc GROUP BY tc.TOP_CATEGORY") t0 t1 t2
  ~= (sql%([EVENTS_schema, PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH top_category AS (/* Step 1: Find the product category with the highest total purchase quantity */ SELECT p.\"category\" AS top_category FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" AS oi JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"id\" GROUP BY p.\"category\" ORDER BY COUNT(*) DESC LIMIT 1), category_products AS (/* Step 2: Get all product IDs in the top category */ SELECT p.\"id\" AS product_id FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p WHERE p.\"category\" = (SELECT top_category FROM top_category)), all_events_with_next AS (/* Step 3: For ALL events, compute the next event time in the same session */ SELECT e.\"id\", e.\"session_id\", e.\"event_type\", e.\"uri\", e.\"created_at\" AS event_time, LEAD(e.\"created_at\") OVER (PARTITION BY e.\"session_id\" ORDER BY e.\"sequence_number\") AS next_event_time FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"EVENTS\" AS e), product_page_visits AS (/* Step 4: Filter to product page events for top category products */ SELECT ae.\"id\", ae.event_time, ae.next_event_time FROM all_events_with_next AS ae INNER JOIN category_products AS cp ON CAST(SPLIT_PART(ae.\"uri\", '/', 3) AS INT) = cp.product_id WHERE ae.\"event_type\" = 'product' AND NOT ae.next_event_time IS NULL) /* Step 5: Calculate average time in minutes */ SELECT (SELECT top_category FROM top_category) AS TOP_CATEGORY, ROUND(CAST(AVG(CAST(CAST((next_event_time - event_time) AS DOUBLE PRECISION) / 1000000.0 AS DOUBLE PRECISION) / 60.0) AS DECIMAL), 2) AS AVG_MINUTES_SPENT FROM product_page_visits") t0 t1 t2
  := by first | sql_equiv | sorry

end N_sf_bq188_eq_0_3
