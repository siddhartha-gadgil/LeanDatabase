import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq258 — crossskill equivalence(s)

Question: Generate a monthly report for each product category , where each row corresponds to orders that have a status of 'Complete' and were delivered before the year 2022, grouping by the month and year of delivery. For each category, calculate the total revenue (the sum of sale_price), the total number of completed orders, and compute the month-over-month percentage growth for both revenue and orders by comparing each month’s totals to the previous month’s. Then, for the same orders, aggregate and show the total cost (from product costs), total profit (revenue minus total cost), and finally the profit-to-cost ratio for each month.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq258

CREATE TABLE PRODUCTS («id» INT, «cost» FLOAT, «category» STRING, «name» STRING, «brand» STRING, «retail_price» FLOAT, «department» STRING, «sku» STRING, «distribution_center_id» INT)
CREATE TABLE ORDER_ITEMS («id» INT, «order_id» INT, «user_id» INT, «product_id» INT, «inventory_item_id» INT, «status» STRING, «created_at» INT, «shipped_at» INT, «delivered_at» INT, «returned_at» INT, «sale_price» FLOAT)

theorem eq_0_1 :
    sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_data AS (SELECT p.\"category\" AS CATEGORY, CAST(DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS DATE) AS MONTH_START, EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS YEAR, EXTRACT(MONTH FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS MONTH, SUM(oi.\"sale_price\") AS REVENUE, COUNT(DISTINCT oi.\"order_id\") AS ORDERS_COUNT, SUM(p.\"cost\") AS TOTAL_COST FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" AS oi JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"id\" WHERE oi.\"status\" = 'Complete' AND EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) < 2022 GROUP BY p.\"category\", DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)), EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)), EXTRACT(MONTH FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000))), with_growth AS (SELECT CATEGORY, MONTH_START, YEAR, MONTH, REVENUE, ORDERS_COUNT, ROUND(CAST((REVENUE - LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START)) AS DOUBLE PRECISION) / LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START) * 100, 2) AS REVENUE_MOM_PCT, ROUND(CAST((ORDERS_COUNT - LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START)) AS DOUBLE PRECISION) / LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY MONTH_START) * 100, 2) AS ORDERS_MOM_PCT, TOTAL_COST, REVENUE - TOTAL_COST AS PROFIT, CAST((REVENUE - TOTAL_COST) AS DOUBLE PRECISION) / TOTAL_COST AS PROFIT_TO_COST_RATIO FROM monthly_data) SELECT CATEGORY, MONTH_START, YEAR, MONTH, REVENUE, ORDERS_COUNT, REVENUE_MOM_PCT, ORDERS_MOM_PCT, TOTAL_COST, PROFIT, PROFIT_TO_COST_RATIO FROM with_growth ORDER BY CATEGORY, MONTH_START" = sql%([PRODUCTS_schema, ORDER_ITEMS_schema]) "WITH monthly_stats AS (SELECT p.\"category\" AS CATEGORY, CAST(DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS DATE) AS MONTH_START, EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS YEAR, EXTRACT(MONTH FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS MONTH, SUM(oi.\"sale_price\") AS REVENUE, COUNT(DISTINCT oi.\"order_id\") AS ORDERS_COUNT, SUM(p.\"cost\") AS TOTAL_COST, SUM(oi.\"sale_price\") - SUM(p.\"cost\") AS PROFIT FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" AS oi JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"id\" WHERE oi.\"status\" = 'Complete' AND TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000) < '2022-01-01' GROUP BY p.\"category\", DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)), EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)), EXTRACT(MONTH FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000))) SELECT CATEGORY, MONTH_START, YEAR, MONTH, REVENUE, ORDERS_COUNT, ROUND(CAST((REVENUE - LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH)) AS DOUBLE PRECISION) / NULLIF(LAG(REVENUE) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH), 0) * 100, 2) AS REVENUE_MOM_PCT, ROUND(CAST((ORDERS_COUNT - LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH)) AS DOUBLE PRECISION) / NULLIF(LAG(ORDERS_COUNT) OVER (PARTITION BY CATEGORY ORDER BY YEAR, MONTH), 0) * 100, 2) AS ORDERS_MOM_PCT, TOTAL_COST, PROFIT, CAST(PROFIT AS DOUBLE PRECISION) / NULLIF(TOTAL_COST, 0) AS PROFIT_TO_COST_RATIO FROM monthly_stats ORDER BY CATEGORY, YEAR, MONTH" := by
  first | sql_equiv | sorry

