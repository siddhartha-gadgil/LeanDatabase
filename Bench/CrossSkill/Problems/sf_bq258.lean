ma, ORDER_ITEMS_schema]) "WITH monthly_metrics AS (SELECT p.\"category\" AS \"CATEGORY\", CAST(DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS DATE) AS \"MONTH_START\", EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS \"YEAR\", EXTRACT(MONTH FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)) AS \"MONTH\", SUM(oi.\"sale_price\") AS \"REVENUE\", COUNT(DISTINCT oi.\"order_id\") AS \"ORDERS_COUNT\", SUM(p.\"cost\") AS \"TOTAL_COST\" FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDER_ITEMS\" AS oi JOIN \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"PRODUCTS\" AS p ON oi.\"product_id\" = p.\"id\" WHERE oi.\"status\" = 'Complete' AND TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000) < '2022-01-01' GROUP BY p.\"category\", DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)), EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000)), EXTRACT(MONTH FROM TO_TIMESTAMP(CAST(oi.\"delivered_at\" AS DOUBLE PRECISION) / 1000000))) SELECT \"CATEGORY\", \"MONTH_START\", \"YEAR\", \"MONTH\", \"REVENUE\", \"ORDERS_COUNT\", ROUND(CAST((\"REVENUE\" - LAG(\"REVENUE\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\")) AS DOUBLE PRECISION) / LAG(\"REVENUE\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\") * 100, 2) AS \"REVENUE_MOM_PCT\", ROUND(CAST((\"ORDERS_COUNT\" - LAG(\"ORDERS_COUNT\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\")) AS DOUBLE PRECISION) / LAG(\"ORDERS_COUNT\") OVER (PARTITION BY \"CATEGORY\" ORDER BY \"MONTH_START\") * 100, 2) AS \"ORDERS_MOM_PCT\", \"TOTAL_COST\", \"REVENUE\" - \"TOTAL_COST\" AS \"PROFIT\", ROUND(CAST((\"REVENUE\" - \"TOTAL_COST\") AS DOUBLE PRECISION) / \"TOTAL_COST\", 2) AS \"PROFIT_TO_COST_RATIO\" FROM monthly_metrics ORDER BY \"CATEGORY\", \"MONTH_START\"" := by
  first | sql_equiv | sorry

