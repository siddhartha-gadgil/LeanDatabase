*/ AS (SELECT LOWER(CAST(f.VALUE AS TEXT)) AS word, COUNT(*) AS word_cnt FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" AS n, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(REGEXP_REPLACE(REGEXP_REPLACE(n.\"body\", '''s([^a-zA-Z0-9_])', '\\1', 'g'), '''', '', 'g'), '[a-zA-Z0-9_]+', 0)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE n.\"id\" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373' AND LOWER(CAST(f.VALUE AS TEXT)) <> ALL (SELECT word FROM stopwords) GROUP BY LOWER(CAST(f.VALUE AS TEXT))), target_weighted AS (SELECT vi.INDEX AS dim_idx, SUM(CAST(CAST(vi.VALUE AS DOUBLE PRECISION) * tt.word_cnt AS DOUBLE PRECISION) / POWER(wf.\"frequency\", 0.4)) AS weighted_sum FROM target_tokens AS tt JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"GLOVE_VECTORS\" AS g ON tt.word = g.\"word\" JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"WORD_FREQUENCIES\" AS wf ON tt.word = wf.\"word\", LATERAL UNNEST(input => g.\"vector\") AS vi(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY vi.INDEX), target_mag AS (SELECT SQRT(SUM(weighted_sum * weighted_sum)) AS magnitude FROM target_weighted), target_norm AS (SELECT tw.dim_idx, CAST(tw.weighted_sum AS DOUBLE PRECISION) / tm.magnitude AS norm_val FROM target_weighted AS tw CROSS JOIN target_mag AS tm), all_tokens /* Step 2: Tokenize all other articles, lowercase tokens, aggregate by (article, word) */ AS (SELECT n.\"id\", n.\"date\", n.\"title\", LOWER(CAST(f.VALUE AS TEXT)) AS word, COUNT(*) AS word_cnt FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" AS n, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(REGEXP_REPLACE(REGEXP_REPLACE(n.\"body\", '''s([^a-zA-Z0-9_])', '\\1', 'g'), '''', '', 'g'), '[a-zA-Z0-9_]+', 0)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE n.\"id\" <> '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373' AND LOWER(CAST(f.VALUE AS TEXT)) <> ALL (SELECT word FROM stopwords) GROUP BY n.\"id\", n.\"date\", n.\"title\", LOWER(CAST(f.VALUE AS TEXT))), article_components /* Step 3: Flatten vectors, compute weighted sums per article per di