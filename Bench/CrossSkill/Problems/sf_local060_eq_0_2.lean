theorem eq (t0 : TableRel CUSTOMERS_schema) (t1 : TableRel PRODUCTS_schema) (t2 : TableRel TIMES_schema) (t3 : TableRel PROMOTIONS_schema) (t4 : TableRel SALES_schema) :
    (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "WITH qualifying_cities AS (/* Step 1: Get city-level sales for Q4 2019 and Q4 2020 (no promotions, US only) */ SELECT c.\"cust_city\", t.\"calendar_year\", SUM(s.\"amount_sold\") AS total_sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" WHERE c.\"country_id\" = 52790 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND s.\"promo_id\" = 999 GROUP BY c.\"cust_city\", t.\"calendar_year\"), cities_with_growth AS (/* Step 2: Filter cities with >= 20% sales growth from Q4 2019 to Q4 2020 */ SELECT q19.\"cust_city\" FROM qualifying_cities AS q19 JOIN qualifying_cities AS q20 ON q19.\"cust_city\" = q20.\"cust_city\" WHERE q19.\"calendar_year\" = 2019 AND q20.\"calendar_year\" = 2020 AND CAST((q20.total_sales - q19.total_sales) AS DOUBLE PRECISION) / q19.total_sales >= 0.20), product_overall_sales AS (/* Step 3: Compute overall sales per product in qualifying cities (Q4 2019 + Q4 2020, no promo) */ SELECT s.\"prod_id\", SUM(s.\"amount_sold\") AS total_product_sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN cities_with_growth AS cg ON c.\"cust_city\" = cg.\"cust_city\" WHERE c.\"country_id\" = 52790 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND s.\"promo_id\" = 999 GROUP BY s.\"prod_id\"), all_products_ranked AS (/* Step 4: Rank ALL products (including those with 0 sales) and take top 20% */ SELECT p.\"prod_id\", p.\"prod_name\", COALESCE(ps.total_product_sales, 0) AS total_product_sales, ROW_NUMBER() OVER (ORDER BY COALESCE(ps.total_product_sales, 0) DESC) AS rn FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p LEFT JOIN product_overall_sales AS ps ON p.\"prod_id\" = ps.\"prod_id\"), top_products AS (/* Step 5: Take top 20% = FLOOR(total_products * 0.2) */ SELECT \"prod_id\", \"prod_name\" FROM all_products_ranked WHERE rn <= FLOOR((SELECT COUNT(*) FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\") * 0.2)), product_quarterly_sales AS (/* Step 6: Compute each top product's sales per quarter in qualifying cities */ SELECT tp.\"prod_id\", tp.\"prod_name\", t.\"calendar_year\", SUM(s.\"amount_sold\") AS product_quarter_sales FROM top_products AS tp JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s ON tp.\"prod_id\" = s.\"prod_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN cities_with_growth AS cg ON c.\"cust_city\" = cg.\"cust_city\" WHERE c.\"country_id\" = 52790 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND s.\"promo_id\" = 999 GROUP BY tp.\"prod_id\", tp.\"prod_name\", t.\"calendar_year\"), total_quarterly_sales AS (/* Step 7: Total sales per quarter in qualifying cities (denominator for share) */ SELECT t.\"calendar_year\", SUM(s.\"amount_sold\") AS total_quarter_sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN cities_with_growth AS cg ON c.\"cust_city\" = cg.\"cust_city\" WHERE c.\"country_id\" = 52790 AND t.\"calendar_quarter_number\" = 4 AND t.\"calendar_year\" IN (2019, 2020) AND s.\"promo_id\" = 999 GROUP BY t.\"calendar_year\"), shares AS (/* Step 8: Compute share per product per quarter */ SELECT pqs.\"prod_id\", pqs.\"prod_name\", pqs.\"calendar_year\", CAST(pqs.product_quarter_sales AS DOUBLE PRECISION) / tqs.total_quarter_sales AS share FROM product_quarterly_sales AS pqs JOIN total_quarterly_sales AS tqs ON pqs.\"calendar_year\" = tqs.\"calendar_year\") /* Step 9: Pivot and compute share change */ SELECT s2019.\"prod_id\", s2019.\"prod_name\", s2019.share AS SHARE_2019, s2020.share AS SHARE_2020, (s2020.share - s2019.share) AS SHARE_CHANGE FROM shares AS s2019 JOIN shares AS s2020 ON s2019.\"prod_id\" = s2020.\"prod_id\" WHERE s2019.\"calendar_year\" = 2019 AND s2020.\"calendar_year\" = 2020 ORDER BY SHARE_CHANGE DESC") t0 t1 t2 t3 t4
  ~= (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "WITH us_customers AS (SELECT c.\"cust_id\", c.\"cust_city\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" AS co ON c.\"country_id\" = co.\"country_id\" WHERE co.\"country_name\" = 'United States of America'), q4_times AS (SELECT \"time_id\", \"calendar_quarter_desc\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" WHERE \"calendar_quarter_desc\" IN ('2019-04', '2020-04')), base_sales AS (SELECT s.\"prod_id\", uc.\"cust_city\", t.\"calendar_quarter_desc\", s.\"amount_sold\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN us_customers AS uc ON s.\"cust_id\" = uc.\"cust_id\" JOIN q4_times AS t ON s.\"time_id\" = t.\"time_id\" WHERE s.\"promo_id\" = 999), city_sales /* Step 1: Cities where total sales rose by at least 20% from Q4 2019 to Q4 2020 */ AS (SELECT \"cust_city\", SUM(CASE WHEN \"calendar_quarter_desc\" = '2019-04' THEN \"amount_sold\" ELSE 0 END) AS sales_2019, SUM(CASE WHEN \"calendar_quarter_desc\" = '2020-04' THEN \"amount_sold\" ELSE 0 END) AS sales_2020 FROM base_sales GROUP BY \"cust_city\" HAVING sales_2019 > 0 AND CAST((sales_2020 - sales_2019) AS DOUBLE PRECISION) / sales_2019 >= 0.20), product_sales /* Step 2: Among those cities, rank products by overall sales and take top 20% */ AS (SELECT bs.\"prod_id\", SUM(bs.\"amount_sold\") AS total_sales FROM base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" GROUP BY bs.\"prod_id\"), product_ranked AS (SELECT \"prod_id\", total_sales, NTILE(5) OVER (ORDER BY total_sales DESC) AS tile FROM product_sales), top_products AS (SELECT \"prod_id\" FROM product_ranked WHERE tile = 1), product_quarter_sales /* Step 3: Compute each top product's share of total sales in Q4 2019 and Q4 2020 */ AS (SELECT bs.\"prod_id\", bs.\"calendar_quarter_desc\", SUM(bs.\"amount_sold\") AS prod_q_sales FROM base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" JOIN top_products AS tp ON bs.\"prod_id\" = tp.\"prod_id\" GROUP BY bs.\"prod_id\", bs.\"calendar_quarter_desc\"), total_quarter_sales AS (SELECT bs.\"calendar_quarter_desc\", SUM(bs.\"amount_sold\") AS total_q_sales FROM base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" GROUP BY bs.\"calendar_quarter_desc\"), shares AS (SELECT pqs.\"prod_id\", ROUND(CAST(SUM(CASE WHEN pqs.\"calendar_quarter_desc\" = '2019-04' THEN pqs.prod_q_sales ELSE 0 END) AS DOUBLE PRECISION) / MAX(CASE WHEN tqs.\"calendar_quarter_desc\" = '2019-04' THEN tqs.total_q_sales END), 2) AS \"SHARE_2019\", ROUND(CAST(SUM(CASE WHEN pqs.\"calendar_quarter_desc\" = '2020-04' THEN pqs.prod_q_sales ELSE 0 END) AS DOUBLE PRECISION) / MAX(CASE WHEN tqs.\"calendar_quarter_desc\" = '2020-04' THEN tqs.total_q_sales END), 2) AS \"SHARE_2020\" FROM product_quarter_sales AS pqs JOIN total_quarter_sales AS tqs ON pqs.\"calendar_quarter_desc\" = tqs.\"calendar_quarter_desc\" GROUP BY pqs.\"prod_id\") SELECT s.\"prod_id\" AS \"prod_id\", p.\"prod_name\" AS \"prod_name\", s.\"SHARE_2019\", s.\"SHARE_2020\", ROUND(s.\"SHARE_2020\" - s.\"SHARE_2019\", 2) AS \"SHARE_CHANGE\" FROM shares AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON s.\"prod_id\" = p.\"prod_id\" ORDER BY \"SHARE_CHANGE\" DESC") t0 t1 t2 t3 t4
