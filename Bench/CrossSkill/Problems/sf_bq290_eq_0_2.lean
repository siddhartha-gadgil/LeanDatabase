    (sql%([STATIONS_schema, GSOD2023_schema]) "WITH us_daily AS (SELECT g.\"date\", AVG(CASE WHEN g.\"max\" <> 9999.9 THEN g.\"max\" END) AS avg_max_temp, AVG(CASE WHEN g.\"min\" <> 9999.9 THEN g.\"min\" END) AS avg_min_temp, AVG(CASE WHEN g.\"temp\" <> 9999.9 THEN g.\"temp\" END) AS avg_temp FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" AS g JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE s.\"country\" = 'US' AND g.\"date\" >= '2023-10-01' AND g.\"date\" <= '2023-10-31' AND g.\"max\" <> 9999.9 AND g.\"min\" <> 9999.9 AND g.\"temp\" <> 9999.9 GROUP BY g.\"date\"), uk_daily AS (SELECT g.\"date\", AVG(CASE WHEN g.\"max\" <> 9999.9 THEN g.\"max\" END) AS avg_max_temp, AVG(CASE WHEN g.\"min\" <> 9999.9 THEN g.\"min\" END) AS avg_min_temp, AVG(CASE WHEN g.\"temp\" <> 9999.9 THEN g.\"temp\" END) AS avg_temp FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" AS g JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE s.\"country\" = 'UK' AND g.\"date\" >= '2023-10-01' AND g.\"date\" <= '2023-10-31' AND g.\"max\" <> 9999.9 AND g.\"min\" <> 9999.9 AND g.\"temp\" <> 9999.9 GROUP BY g.\"date\") SELECT u.\"date\", u.avg_max_temp - k.avg_max_temp AS DIFF_MAX_TEMP, u.avg_min_temp - k.avg_min_temp AS DIFF_MIN_TEMP, u.avg_temp - k.avg_temp AS DIFF_AVG_TEMP FROM us_daily AS u JOIN uk_daily AS k ON u.\"date\" = k.\"date\" ORDER BY u.\"date\"") t0 t1
  = (sql%([STATIONS_schema, GSOD2023_schema]) "WITH us_data AS (SELECT g.\"date\", AVG(g.\"max\") AS avg_max_temp, AVG(g.\"min\") AS avg_min_temp, AVG(g.\"temp\") AS avg_temp FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" AS g JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE s.\"country\" = 'US' AND g.\"mo\" = '10' AND g.\"temp\" <> 9999.9 AND g.\"max\" <> 9999.9 AND g.\"min\" <> 9999.9 GROUP BY g.\"date\"), uk_data AS (SELECT g.\"date\", AVG(g.\"max\") AS avg_max_temp, AVG(g.\"min\") AS avg_min_temp, AVG(g.\"temp\") AS avg_temp FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2023\" AS g JOIN \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" AS s ON g.\"stn\" = s.\"usaf\" AND g.\"wban\" = s.\"wban\" WHERE s.\"country\" = 'UK' AND g.\"mo\" = '10' AND g.\"temp\" <> 9999.9 AND g.\"max\" <> 9999.9 AND g.\"min\" <> 9999.9 GROUP BY g.\"date\") SELECT u.\"date\", (u.avg_max_temp - k.avg_max_temp) AS DIFF_MAX_TEMP, (u.avg_min_temp - k.avg_min_temp) AS DIFF_MIN_TEMP, (u.avg_temp - k.avg_temp) AS DIFF_AVG_TEMP FROM us_data AS u JOIN uk_data AS k ON u.\"date\" = k.\"date\" ORDER BY u.\"date\"") t0 t1
