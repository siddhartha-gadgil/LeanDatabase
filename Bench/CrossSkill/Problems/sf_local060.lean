M base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" JOIN top_products AS tp ON bs.\"prod_id\" = tp.\"prod_id\" GROUP BY bs.\"prod_id\", bs.\"calendar_quarter_desc\"), total_quarter_sales AS (SELECT bs.\"calendar_quarter_desc\", SUM(bs.\"amount_sold\") AS total_q_sales FROM base_sales AS bs JOIN city_sales AS cs ON bs.\"cust_city\" = cs.\"cust_city\" GROUP BY bs.\"calendar_quarter_desc\"), shares AS (SELECT pqs.\"prod_id\", ROUND(CAST(SUM(CASE WHEN pqs.\"calendar_quarter_desc\" = '2019-04' THEN pqs.prod_q_sales ELSE 0 END) AS DOUBLE PRECISION) / MAX(CASE WHEN tqs.\"calendar_quarter_desc\" = '2019-04' THEN tqs.total_q_sales END), 2) AS \"SHARE_2019\", ROUND(CAST(SUM(CASE WHEN pqs.\"calendar_quarter_desc\" = '2020-04' THEN pqs.prod_q_sales ELSE 0 END) AS DOUBLE PRECISION) / MAX(CASE WHEN tqs.\"calendar_quarter_desc\" = '2020-04' THEN tqs.total_q_sales END), 2) AS \"SHARE_2020\" FROM product_quarter_sales AS pqs JOIN total_quarter_sales AS tqs ON pqs.\"calendar_quarter_desc\" = tqs.\"calendar_quarter_desc\" GROUP BY pqs.\"prod_id\") SELECT s.\"prod_id\" AS \"prod_id\", p.\"prod_name\" AS \"prod_name\", s.\"SHARE_2019\", s.\"SHARE_2020\", ROUND(s.\"SHARE_2020\" - s.\"SHARE_2019\", 2) AS \"SHARE_CHANGE\" FROM shares AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON s.\"prod_id\" = p.\"prod_id\" ORDER BY \"SHARE_CHANGE\" DESC") t ~= (sql%([COUNTRIES_schema, CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, PROMOTIONS_schema, SALES_schema]) "/* Step 1: Base sales data for US customers in Q4 2019 and Q4 2020, no promotions */ WITH base_sales AS (SELECT s.\"prod_id\", c.\"cust_city\", t.\"calendar_quarter_desc\", s.\"amount_sold\" FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS c ON s.\"cust_id\" = c.\"cust_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" AS co ON c.\"country_id\" = co.\"country_id\" WHERE co.\"country_name\" = 'United States of America' AND t.\"calendar_quarter_desc\" IN ('2019-04', '2020-04') AND s.\"promo_id\" = 999), city_quarter_sales /* Step 2: City-level total sales per quarter */ AS (SELECT \"cust_city\", \"calendar_quarter_desc\", SUM(\"amount_sold\") AS total_sales FROM base_sales GROUP BY \"cust_city\", \"calendar_quarter_desc\"), growing_cities /* Step 3: Find cities with >= 20% growth from Q4 2019 to Q4 2020 */ AS (SELECT q19.\"cust_city\" FROM city_quarter_sales AS q19 JOIN city_quarter_sales AS q20 ON q19.\"cust_city\" = q20.\"cust_city\" WHERE q19.\"calendar_quarter_desc\" = '2019-04' AND q20.\"calendar_quarter_desc\" = '2020-04' AND q20.total_sales >= q19.total_sales * 1.20), filtered_sales /* Step 4: Filter base sales to only growing cities */ AS (SELECT bs.\"prod_id\", bs.\"calendar_quarter_desc\", bs.\"amount_sold\" FROM base_sales AS bs WHERE bs.\"cust_city\" IN (SELECT \"cust_city\" FROM growing_cities)), product_total_sales /* Step 5: Rank products by total sales across both quarters, take top 20% */ AS (SELECT \"prod_id\", SUM(\"amount_sold\") AS total_prod_sales FROM filtered_sales GROUP BY \"prod_id\"), product_ranked AS (SELECT \"prod_id\", total_prod_sales, NTILE(5) OVER (ORDER BY total_prod_sales DESC) AS quintile FROM product_total_sales), top_products AS (SELECT \"prod_id\" FROM product_ranked WHERE quintile = 1), quarter_totals /* Step 6: Compute share of each top product in each quarter */ AS (SELECT \"calendar_quarter_desc\", SUM(\"amount_sold\") AS quarter_total FROM filtered_sales GROUP BY \"calendar_quarter_desc\"), product_quarter_sales AS (SELECT fs.\"prod_id\", fs.\"calendar_quarter_desc\", SUM(fs.\"amount_sold\") AS prod_quarter_sales FROM filtered_sales AS fs WHERE fs.\"prod_id\" IN (SELECT \"prod_id\" FROM top_products) GROUP BY fs.\"prod_id\", fs.\"calendar_quarter_desc\"), shares AS (SELECT pqs.\"prod_id\", pqs.\"calendar_quarter_desc\", CAST(pqs.prod_quarter_sales AS DOUBLE PRECISION) / qt.quarter_total AS share FROM product_quarter_sales AS pqs JOIN quarter_totals AS qt ON pqs.\"calendar_quarter_desc\" = qt.\"calendar_quarter_desc\"), share_pivot /* Step 7: Pivot to get share_2019 and share_2020 */ AS (SELECT \"prod_id\", MAX(CASE WHEN \"calendar_quarter_desc\" = '2019-04' THEN share ELSE 0 END) AS SHARE_2019, MAX(CASE WHEN \"calendar_quarter_desc\" = '2020-04' THEN share ELSE 0 END) AS SHARE_2020 FROM shares GROUP BY \"prod_id\") /* Final output */ SELECT sp.\"prod_id\", p.\"prod_name\", sp.SHARE_2019, sp.SHARE_2020, (sp.SHARE_2020 - sp.SHARE_2019) AS SHARE_CHANGE FROM share_pivot AS sp JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON sp.\"prod_id\" = p.\"prod_id\" ORDER BY SHARE_CHANGE DESC") t := by
  intro t; first | sql_equiv | sorry

