    sql%([BATTING_schema, PLAYER_schema]) "WITH career_totals AS (\n    SELECT\n        b.\"PLAYER_ID\",\n        SUM(COALESCE(b.\"G\", 0)) AS total_g,\n        SUM(COALESCE(b.\"R\", 0)) AS total_r,\n        SUM(COALESCE(b.\"H\", 0)) AS total_h,\n        SUM(COALESCE(b.\"HR\", 0)) AS total_hr\n    FROM \"BASEBALL\".\"BASEBALL\".\"BATTING\" b\n    GROUP BY b.\"PLAYER_ID\"\n),\ngames_leader AS (\n    SELECT 'Games Played' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", ct.total_g AS \"Batting_Table_Topper\"\n    FROM career_totals ct\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON ct.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY ct.total_g DESC\n    LIMIT 1\n),\nruns_leader AS (\n    SELECT 'Runs' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", ct.total_r AS \"Batting_Table_Topper\"\n    FROM career_totals ct\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON ct.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY ct.total_r DESC\n    LIMIT 1\n),\nhits_leader AS (\n    SELECT 'Hits' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", ct.total_h AS \"Batting_Table_Topper\"\n    FROM career_totals ct\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON ct.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY ct.total_h DESC\n    LIMIT 1\n),\nhr_leader AS (\n    SELECT 'Home Runs' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", ct.total_hr AS \"Batting_Table_Topper\"\n    FROM career_totals ct\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON ct.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY ct.total_hr DESC\n    LIMIT 1\n)\nSELECT * FROM games_leader\nUNION ALL\nSELECT * FROM runs_leader\nUNION ALL\nSELECT * FROM hits_leader\nUNION ALL\nSELECT * FROM hr_leader;" = sql%([BATTING_schema, PLAYER_schema]) "WITH batting_totals AS (\n    SELECT\n        \"PLAYER_ID\",\n        SUM(\"G\") AS total_G,\n        SUM(\"R\") AS total_R,\n        SUM(\"H\") AS total_H,\n        SUM(\"HR\") AS total_HR\n    FROM \"BASEBALL\".\"BASEBALL\".\"BATTING\"\n    GROUP BY \"PLAYER_ID\"\n),\nmax_g AS (\n    SELECT 'Games Played' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", b.total_G AS \"Batting_Table_Topper\"\n    FROM batting_totals b\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON b.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY b.total_G DESC NULLS LAST\n    LIMIT 1\n),\nmax_r AS (\n    SELECT 'Runs' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", b.total_R AS \"Batting_Table_Topper\"\n    FROM batting_totals b\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON b.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY b.total_R DESC NULLS LAST\n    LIMIT 1\n),\nmax_h AS (\n    SELECT 'Hits' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", b.total_H AS \"Batting_Table_Topper\"\n    FROM batting_totals b\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON b.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY b.total_H DESC NULLS LAST\n    LIMIT 1\n),\nmax_hr AS (\n    SELECT 'Home Runs' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", b.total_HR AS \"Batting_Table_Topper\"\n    FROM batting_totals b\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON b.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY b.total_HR DESC NULLS LAST\n    LIMIT 1\n)\nSELECT * FROM max_g\nUNION ALL\nSELECT * FROM max_r\nUNION ALL\nSELECT * FROM max_h\nUNION ALL\nSELECT * FROM max_hr;" := by
  first | sql_equiv | sorry

end Bench_sf_local008
