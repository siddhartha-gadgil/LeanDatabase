/-!
# sf_local008 — crossskill equivalence(s)

Question: I would like to know the given names of baseball players who have achieved the highest value of games played, runs, hits, and home runs, with their corresponding score values.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local008

CREATE TABLE BATTING («player_id» STRING, «year» INT, «stint» INT, «team_id» STRING, «league_id» STRING, «g» INT, «ab» STRING, «r» STRING, «h» STRING, «double» STRING, «triple» STRING, «hr» STRING, «rbi» STRING, «sb» STRING, «cs» STRING, «bb» STRING, «so» STRING, «ibb» STRING, «hbp» STRING, «sh» STRING, «sf» STRING, «g_idp» STRING)
CREATE TABLE PLAYER («player_id» STRING, «birth_year» STRING, «birth_month» STRING, «birth_day» STRING, «birth_country» STRING, «birth_state» STRING, «birth_city» STRING, «death_year» STRING, «death_month» STRING, «death_day» STRING, «death_country» STRING, «death_state» STRING, «death_city» STRING, «name_first» STRING, «name_last» STRING, «name_given» STRING, «weight» STRING, «height» STRING, «bats» STRING, «throws» STRING, «debut» STRING, «final_game» STRING, «retro_id» STRING, «bbref_id» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([BATTING_schema, PLAYER_schema]) "WITH career_g AS (\n    SELECT b.\"PLAYER_ID\", SUM(COALESCE(b.\"G\", 0)) AS total_g\n    FROM \"BASEBALL\".\"BASEBALL\".\"BATTING\" b\n    GROUP BY b.\"PLAYER_ID\"\n    ORDER BY total_g DESC\n    LIMIT 1\n),\ncareer_r AS (\n    SELECT b.\"PLAYER_ID\", SUM(COALESCE(b.\"R\", 0)) AS total_r\n    FROM \"BASEBALL\".\"BASEBALL\".\"BATTING\" b\n    GROUP BY b.\"PLAYER_ID\"\n    ORDER BY total_r DESC\n    LIMIT 1\n),\ncareer_h AS (\n    SELECT b.\"PLAYER_ID\", SUM(COALESCE(b.\"H\", 0)) AS total_h\n    FROM \"BASEBALL\".\"BASEBALL\".\"BATTING\" b\n    GROUP BY b.\"PLAYER_ID\"\n    ORDER BY total_h DESC\n    LIMIT 1\n),\ncareer_hr AS (\n    SELECT b.\"PLAYER_ID\", SUM(COALESCE(b.\"HR\", 0)) AS total_hr\n    FROM \"BASEBALL\".\"BASEBALL\".\"BATTING\" b\n    GROUP BY b.\"PLAYER_ID\"\n    ORDER BY total_hr DESC\n    LIMIT 1\n)\nSELECT 'Games Played' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", g.total_g AS \"Batting_Table_Topper\"\nFROM career_g g\nJOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON g.\"PLAYER_ID\" = p.\"PLAYER_ID\"\nUNION ALL\nSELECT 'Runs', p.\"NAME_GIVEN\", r.total_r\nFROM career_r r\nJOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON r.\"PLAYER_ID\" = p.\"PLAYER_ID\"\nUNION ALL\nSELECT 'Hits', p.\"NAME_GIVEN\", h.total_h\nFROM career_h h\nJOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON h.\"PLAYER_ID\" = p.\"PLAYER_ID\"\nUNION ALL\nSELECT 'Home Runs', p.\"NAME_GIVEN\", hr.total_hr\nFROM career_hr hr\nJOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON hr.\"PLAYER_ID\" = p.\"PLAYER_ID\";") t ~= (sql%([BATTING_schema, PLAYER_schema]) "WITH career_stats AS (\n    SELECT\n        b.\"PLAYER_ID\",\n        SUM(COALESCE(b.\"G\", 0)) AS total_games,\n        SUM(COALESCE(b.\"R\", 0)) AS total_runs,\n        SUM(COALESCE(b.\"H\", 0)) AS total_hits,\n        SUM(COALESCE(b.\"HR\", 0)) AS total_hr\n    FROM \"BASEBALL\".\"BASEBALL\".\"BATTING\" b\n    GROUP BY b.\"PLAYER_ID\"\n),\nmax_games AS (\n    SELECT 'Games Played' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", cs.total_games AS \"Batting_Table_Topper\"\n    FROM career_stats cs\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON cs.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY cs.total_games DESC\n    LIMIT 1\n),\nmax_runs AS (\n    SELECT 'Runs' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", cs.total_runs AS \"Batting_Table_Topper\"\n    FROM career_stats cs\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON cs.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY cs.total_runs DESC\n    LIMIT 1\n),\nmax_hits AS (\n    SELECT 'Hits' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", cs.total_hits AS \"Batting_Table_Topper\"\n    FROM career_stats cs\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON cs.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY cs.total_hits DESC\n    LIMIT 1\n),\nmax_hr AS (\n    SELECT 'Home Runs' AS \"Category\", p.\"NAME_GIVEN\" AS \"Player_Name\", cs.total_hr AS \"Batting_Table_Topper\"\n    FROM career_stats cs\n    JOIN \"BASEBALL\".\"BASEBALL\".\"PLAYER\" p ON cs.\"PLAYER_ID\" = p.\"PLAYER_ID\"\n    ORDER BY cs.total_hr DESC\n    LIMIT 1\n)\nSELECT * FROM max_games\nUNION ALL\nSELECT * FROM max_runs\nUNION ALL\nSELECT * FROM max_hits\nUNION ALL\nSELECT * FROM max_hr;") t := by
  intro t; first | sql_equiv | sorry

