theorem eq (t0 : TableRel USERS_schema) (t1 : TableRel POSTS_ANSWERS_schema) (t2 : TableRel POSTS_QUESTIONS_schema) :
    (sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH answer_total_scores AS (/* Pre-compute total answer scores per question */ SELECT \"parent_id\" AS question_id, SUM(\"score\") AS total_score FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" GROUP BY \"parent_id\"), answer_ranks AS (/* Pre-compute rank of each answer within its question */ SELECT \"id\" AS answer_id, \"parent_id\" AS question_id, \"owner_user_id\", \"score\", RANK() OVER (PARTITION BY \"parent_id\" ORDER BY \"score\" DESC) AS score_rank FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" WHERE NOT \"owner_user_id\" IS NULL), criterion1 /* Criterion 1: User owns the question */ AS (SELECT \"owner_user_id\" AS user_id, \"id\" AS question_id FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" WHERE NOT \"owner_user_id\" IS NULL), criterion2 /* Criterion 2: User's answer is the accepted answer */ AS (SELECT a.\"owner_user_id\" AS user_id, q.\"id\" AS question_id FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" AS a ON q.\"accepted_answer_id\" = a.\"id\" WHERE NOT a.\"owner_user_id\" IS NULL), criterion3 /* Criterion 3: User's answer score > 5 */ AS (SELECT ar.\"owner_user_id\" AS user_id, ar.question_id FROM answer_ranks AS ar WHERE ar.\"score\" > 5), criterion4 /* Criterion 4: User's answer score > 20% of total AND score > 0 */ AS (SELECT ar.\"owner_user_id\" AS user_id, ar.question_id FROM answer_ranks AS ar JOIN answer_total_scores AS ats ON ar.question_id = ats.question_id WHERE ar.\"score\" > 0 AND ats.total_score > 0 AND ar.\"score\" > 0.2 * ats.total_score), criterion5 /* Criterion 5: User's answer is among top 3 highest-scoring for that question */ AS (SELECT ar.\"owner_user_id\" AS user_id, ar.question_id FROM answer_ranks AS ar WHERE ar.score_rank <= 3), all_associations /* Union all criteria (dedup user-question pairs) */ AS (SELECT user_id, question_id FROM criterion1 UNION SELECT user_id, question_id FROM criterion2 UNION SELECT user_id, question_id FROM criterion3 UNION SELECT user_id, question_id FROM criterion4 UNION SELECT user_id, question_id FROM criterion5), user_views /* Sum view counts per user */ AS (SELECT a.user_id, SUM(q.\"view_count\") AS TOTAL_VIEW_COUNT FROM all_associations AS a JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q ON a.question_id = q.\"id\" GROUP BY a.user_id) SELECT uv.user_id AS USER_ID, u.\"display_name\", uv.TOTAL_VIEW_COUNT FROM user_views AS uv JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" AS u ON uv.user_id = u.\"id\" ORDER BY uv.TOTAL_VIEW_COUNT DESC LIMIT 10") t0 t1 t2
