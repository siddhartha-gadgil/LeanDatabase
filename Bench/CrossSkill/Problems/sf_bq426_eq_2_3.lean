import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq426_eq_2_3

CREATE TABLE ZIP_CODES («zip» INT, «borough» STRING, «neighborhood» STRING)
CREATE TABLE CITIBIKE_TRIPS («tripduration» INT, «starttime» INT, «stoptime» INT, «start_station_id» INT, «start_station_name» STRING, «start_station_latitude» FLOAT, «start_station_longitude» FLOAT, «end_station_id» INT, «end_station_name» STRING, «end_station_latitude» FLOAT, «end_station_longitude» FLOAT, «bikeid» INT, «usertype» STRING, «birth_year» INT, «gender» STRING, «customer_plan» STRING)
CREATE TABLE GSOD2018 («stn» STRING, «wban» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)

theorem eq (t0 : TableRel ZIP_CODES_schema) (t1 : TableRel CITIBIKE_TRIPS_schema) (t2 : TableRel GSOD2018_schema) :
    (sql%([ZIP_CODES_schema, CITIBIKE_TRIPS_schema, GSOD2018_schema]) "WITH zip_geom AS (SELECT \"zip_code_geom\" FROM \"NEW_YORK_CITIBIKE_1\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" WHERE \"zip_code\" = '10019'), trips_in_zip AS (SELECT t.\"usertype\", CAST(TO_TIMESTAMP(CAST(t.\"starttime\" AS DOUBLE PRECISION) / 1000000) AS DATE) AS trip_date FROM \"NEW_YORK_CITIBIKE_1\".\"NEW_YORK_CITIBIKE\".\"CITIBIKE_TRIPS\" AS t, zip_geom AS z WHERE NOT t.\"usertype\" IS NULL AND EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(t.\"starttime\" AS DOUBLE PRECISION) / 1000000)) = 2018 AND ST_WITHIN(ST_POINT(t.\"start_station_longitude\", t.\"start_station_latitude\"), CAST(z.\"zip_code_geom\" AS GEOGRAPHY)) AND ST_WITHIN(ST_POINT(t.\"end_station_longitude\", t.\"end_station_latitude\"), CAST(z.\"zip_code_geom\" AS GEOGRAPHY))), weather AS (SELECT CAST(\"year\" AS INT) AS yr, CAST(\"mo\" AS INT) AS mo, CAST(\"da\" AS INT) AS da, DATE_FROM_PARTS(CAST(\"year\" AS INT), CAST(\"mo\" AS INT), CAST(\"da\" AS INT)) AS weather_date, CASE WHEN CAST(\"prcp\" AS DOUBLE PRECISION) >= 99.99 THEN NULL ELSE CAST(\"prcp\" AS DOUBLE PRECISION) END AS precipitation, CASE WHEN CAST(\"wdsp\" AS DOUBLE PRECISION) >= 999.9 THEN NULL ELSE CAST(\"wdsp\" AS DOUBLE PRECISION) END AS wind_speed, CASE WHEN CAST(\"temp\" AS DOUBLE PRECISION) >= 9999.9 THEN NULL ELSE CAST(\"temp\" AS DOUBLE PRECISION) END AS temperature FROM \"NEW_YORK_CITIBIKE_1\".\"NOAA_GSOD\".\"GSOD2018\" WHERE \"stn\" = '725053' AND \"wban\" = '94728'), trip_weather AS (SELECT t.\"usertype\", w.precipitation, w.wind_speed, w.temperature FROM trips_in_zip AS t JOIN weather AS w ON t.trip_date = w.weather_date) SELECT \"usertype\" AS \"usertype\", ROUND(CAST(AVG(precipitation) AS DECIMAL), 2) AS \"AVG_PRECIPITATION\", ROUND(CAST(AVG(wind_speed) AS DECIMAL), 2) AS \"AVG_WIND_SPEED\", ROUND(CAST(AVG(temperature) AS DECIMAL), 2) AS \"AVG_TEMPERATURE\" FROM trip_weather GROUP BY \"usertype\" ORDER BY \"AVG_TEMPERATURE\" DESC LIMIT 1") t0 t1 t2
  = (sql%([ZIP_CODES_schema, CITIBIKE_TRIPS_schema, GSOD2018_schema]) "WITH zip_geom AS (SELECT \"zip_code_geom\" FROM \"NEW_YORK_CITIBIKE_1\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" WHERE \"zip_code\" = '10019'), trips_in_zip AS (SELECT t.\"usertype\", CAST(TO_TIMESTAMP(CAST(t.\"starttime\" AS DOUBLE PRECISION) / POWER(10, 6)) AS DATE) AS trip_date FROM \"NEW_YORK_CITIBIKE_1\".\"NEW_YORK_CITIBIKE\".\"CITIBIKE_TRIPS\" AS t, zip_geom AS z WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(t.\"starttime\" AS DOUBLE PRECISION) / POWER(10, 6))) = 2018 AND NOT t.\"start_station_latitude\" IS NULL AND NOT t.\"end_station_latitude\" IS NULL AND NOT t.\"usertype\" IS NULL AND t.\"usertype\" <> '' AND ST_WITHIN(ST_POINT(t.\"start_station_longitude\", t.\"start_station_latitude\"), CAST(z.\"zip_code_geom\" AS GEOGRAPHY)) AND ST_WITHIN(ST_POINT(t.\"end_station_longitude\", t.\"end_station_latitude\"), CAST(z.\"zip_code_geom\" AS GEOGRAPHY))), weather AS (SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE) AS weather_date, \"temp\", \"prcp\", \"wdsp\" FROM \"NEW_YORK_CITIBIKE_1\".\"NOAA_GSOD\".\"GSOD2018\" WHERE \"stn\" = '725053' AND \"wban\" = '94728'), joined AS (SELECT t.\"usertype\", w.\"temp\", w.\"prcp\", w.\"wdsp\" FROM trips_in_zip AS t JOIN weather AS w ON t.trip_date = w.weather_date) SELECT \"usertype\", AVG(\"prcp\") AS AVG_PRECIPITATION, AVG(\"wdsp\") AS AVG_WIND_SPEED, AVG(\"temp\") AS AVG_TEMPERATURE FROM joined GROUP BY \"usertype\" ORDER BY AVG_TEMPERATURE DESC LIMIT 1") t0 t1 t2
  := by first | sql_equiv | sorry

end N_sf_bq426_eq_2_3
