n_count FROM \"STACKING\".\"STACKING\".\"SOLUTION\" GROUP BY \"name\") SELECT pc.problem FROM problem_counts AS pc JOIN solution_counts AS sc ON pc.problem = sc.\"name\" WHERE pc.qualifying_count > sc.solution_count ORDER BY pc.problem") t := by
  intro t; first | sql_equiv | sorry

