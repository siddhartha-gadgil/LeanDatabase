/-!
# sf_local077 — crossskill equivalence(s)

Question: Please analyze our interest data from September 2018 to August 2019. For each month, calculate the average composition for each interest by dividing the composition by the index value. Identify the interest with the highest average composition value each month and report its average composition as the max index composition for that month. Compute the three-month rolling average of these monthly max index compositions. Ensure the output includes the date, the interest name, the max index composition for that month, the rolling average, and the names and max index compositions of the top interests from one month ago and two months ago.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local077

CREATE TABLE INTEREST_MAP («id» INT, «interest_name» STRING, «interest_summary» STRING, «created_at» STRING, «last_modified» STRING)
CREATE TABLE INTEREST_METRICS («_month» FLOAT, «_year» FLOAT, «month_year» STRING, «interest_id» FLOAT, «composition» FLOAT, «index_value» FLOAT, «ranking» INT, «percentile_ranking» FLOAT)

theorem eq_0_1 : ∀ t,
    (sql%([INTEREST_MAP_schema, INTEREST_METRICS_schema]) "WITH monthly_comp AS (SELECT m.\"_month\", m.\"_year\", im.\"interest_name\", CAST(m.\"composition\" AS DOUBLE PRECISION) / m.\"index_value\" AS avg_composition, ROW_NUMBER() OVER (PARTITION BY m.\"_year\", m.\"_month\" ORDER BY CAST(m.\"composition\" AS DOUBLE PRECISION) / m.\"index_value\" DESC) AS rn FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_METRICS\" AS m JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_MAP\" AS im ON m.\"interest_id\" = im.\"id\" WHERE NOT m.\"interest_id\" IS NULL AND NOT m.\"month_year\" IS NULL AND m.\"month_year\" <> ''), monthly_max AS (SELECT \"_month\", \"_year\", \"interest_name\", avg_composition AS max_index_composition FROM monthly_comp WHERE rn = 1), filtered AS (SELECT * FROM monthly_max WHERE (\"_year\" = 2018 AND \"_month\" >= 9) OR (\"_year\" = 2019 AND \"_month\" <= 8)), with_window AS (SELECT DATE_FROM_PARTS(\"_year\", \"_month\", 1) AS \"MONTH_DATE\", \"interest_name\", max_index_composition AS \"MAX_INDEX_COMPOSITION\", AVG(max_index_composition) OVER (ORDER BY \"_year\", \"_month\" ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS \"ROLLING_AVG_3MONTH\", LAG(\"interest_name\", 1) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_MONTH_INTEREST_NAME\", LAG(max_index_composition, 1) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_MONTH_MAX_COMPOSITION\", LAG(\"interest_name\", 2) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_2MONTH_INTEREST_NAME\", LAG(max_index_composition, 2) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_2MONTH_MAX_COMPOSITION\" FROM filtered) SELECT \"MONTH_DATE\", \"interest_name\", \"MAX_INDEX_COMPOSITION\", \"ROLLING_AVG_3MONTH\", \"PREV_MONTH_INTEREST_NAME\", \"PREV_MONTH_MAX_COMPOSITION\", \"PREV_2MONTH_INTEREST_NAME\", \"PREV_2MONTH_MAX_COMPOSITION\" FROM with_window ORDER BY \"MONTH_DATE\"") t ~= (sql%([INTEREST_MAP_schema, INTEREST_METRICS_schema]) "WITH avg_comp AS (/* Calculate avg composition = composition / index_value for each interest per month */ SELECT im.\"_month\", im.\"_year\", im.\"month_year\", im.\"interest_id\", m.\"interest_name\", CAST(im.\"composition\" AS DOUBLE PRECISION) / NULLIF(im.\"index_value\", 0) AS avg_composition FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_METRICS\" AS im JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_MAP\" AS m ON im.\"interest_id\" = m.\"id\" WHERE NOT im.\"_month\" IS NULL), max_per_month AS (/* For each month, find the interest with the highest avg composition */ SELECT \"_month\", \"_year\", \"month_year\", \"interest_name\", avg_composition AS max_index_composition, ROW_NUMBER() OVER (PARTITION BY \"_month\", \"_year\" ORDER BY avg_composition DESC) AS rn FROM avg_comp), filtered AS (/* Keep only the top interest per month and filter to Sep 2018 - Aug 2019 */ SELECT DATE_FROM_PARTS(\"_year\", \"_month\", 1) AS MONTH_DATE, \"interest_name\", max_index_composition FROM max_per_month WHERE rn = 1 AND ((\"_year\" = 2018 AND \"_month\" >= 9) OR (\"_year\" = 2019 AND \"_month\" <= 8))), with_rolling AS (SELECT MONTH_DATE, \"interest_name\", max_index_composition AS MAX_INDEX_COMPOSITION, AVG(max_index_composition) OVER (ORDER BY MONTH_DATE ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS ROLLING_AVG_3MONTH, LAG(\"interest_name\", 1) OVER (ORDER BY MONTH_DATE) AS PREV_MONTH_INTEREST_NAME, LAG(max_index_composition, 1) OVER (ORDER BY MONTH_DATE) AS PREV_MONTH_MAX_COMPOSITION, LAG(\"interest_name\", 2) OVER (ORDER BY MONTH_DATE) AS PREV_2MONTH_INTEREST_NAME, LAG(max_index_composition, 2) OVER (ORDER BY MONTH_DATE) AS PREV_2MONTH_MAX_COMPOSITION FROM filtered) SELECT MONTH_DATE, \"interest_name\", MAX_INDEX_COMPOSITION, ROLLING_AVG_3MONTH, PREV_MONTH_INTEREST_NAME, PREV_MONTH_MAX_COMPOSITION, PREV_2MONTH_INTEREST_NAME, PREV_2MONTH_MAX_COMPOSITION FROM with_rolling ORDER BY MONTH_DATE") t := by
