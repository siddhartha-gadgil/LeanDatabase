theorem eq (t0 : TableRel PIZZA_NAMES_schema) (t1 : TableRel PIZZA_RECIPES_schema) (t2 : TableRel PIZZA_CLEAN_CUSTOMER_ORDERS_schema) (t3 : TableRel PIZZA_TOPPINGS_schema) :
    (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (SELECT ROW_NUMBER() OVER (ORDER BY \"order_id\", \"order_time\") AS row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"), orders_with_names AS (SELECT o.row_id, o.\"order_id\", o.\"customer_id\", CASE WHEN pn.\"pizza_name\" = 'Meatlovers' THEN 1 ELSE 2 END AS pizza_id, pn.\"pizza_name\", o.\"exclusions\", o.\"extras\", o.\"order_time\" FROM numbered_orders AS o JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" AS pn ON o.\"pizza_id\" = pn.\"pizza_id\"), recipe_toppings /* Split recipe toppings into individual rows */ AS (SELECT r.\"pizza_id\", CAST(TRIM(rt.VALUE) AS INT) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" AS r, LATERAL UNNEST(INPUT => SPLIT(r.\"toppings\", ',')) AS rt(SEQ, KEY, PATH, INDEX, VALUE, THIS)), order_standard_toppings /* For each order row, get standard toppings */ AS (SELECT o.row_id, o.\"order_id\", o.\"customer_id\", o.pizza_id, o.\"pizza_name\", o.\"order_time\", o.\"exclusions\", o.\"extras\", rt.topping_id, 'standard' AS source FROM orders_with_names AS o JOIN recipe_toppings AS rt ON o.pizza_id = rt.\"pizza_id\"), order_exclusions /* Split exclusions for each order row */ AS (SELECT o.row_id, CAST(TRIM(ex.VALUE) AS INT) AS excluded_topping_id FROM orders_with_names AS o, LATERAL UNNEST(INPUT => SPLIT(o.\"exclusions\", ','), OUTER => TRUE) AS ex(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT o.\"exclusions\" IS NULL AND o.\"exclusions\" <> ''), order_extras /* Split extras for each order row */ AS (SELECT o.row_id, CAST(TRIM(ext.VALUE) AS INT) AS extra_topping_id FROM orders_with_names AS o, LATERAL UNNEST(INPUT => SPLIT(o.\"extras\", ','), OUTER => TRUE) AS ext(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT o.\"extras\" IS NULL AND o.\"extras\" <> ''), standard_minus_exclusions /* Remove excluded toppings from standard */ AS (SELECT st.row_id, st.\"order_id\", st.\"customer_id\", st.pizza_id, st.\"pizza_name\", st.\"order_time\", st.topping_id, st.source FROM order_standard_toppings AS st LEFT JOIN order_exclusions AS ex ON st.row_id = ex.row_id AND st.topping_id = ex.excluded_topping_id WHERE ex.excluded_topping_id IS NULL), all_toppings /* Add extras as separate rows */ AS (SELECT row_id, \"order_id\", \"customer_id\", pizza_id, \"pizza_name\", \"order_time\", topping_id, source FROM standard_minus_exclusions UNION ALL SELECT o.row_id, o.\"order_id\", o.\"customer_id\", o.pizza_id, o.\"pizza_name\", o.\"order_time\", ext.extra_topping_id AS topping_id, 'extra' AS source FROM orders_with_names AS o JOIN order_extras AS ext ON o.row_id = ext.row_id), topping_counts /* Count each topping per order row */ AS (SELECT at.row_id, at.\"order_id\", at.\"customer_id\", at.pizza_id, at.\"pizza_name\", at.\"order_time\", at.topping_id, t.\"topping_name\", COUNT(*) AS cnt FROM all_toppings AS at JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON at.topping_id = t.\"topping_id\" GROUP BY at.row_id, at.\"order_id\", at.\"customer_id\", at.pizza_id, at.\"pizza_name\", at.\"order_time\", at.topping_id, t.\"topping_name\"), formatted_toppings /* Format topping names with 2x prefix where needed */ AS (SELECT row_id, \"order_id\", \"customer_id\", pizza_id, \"pizza_name\", \"order_time\", topping_id, \"topping_name\", cnt, CASE WHEN cnt >= 2 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name, CASE WHEN cnt >= 2 THEN 0 ELSE 1 END AS sort_group FROM topping_counts), ingredient_strings /* Aggregate into ingredient string: 2x items first (alphabetical), then single items (alphabetical) */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_name\", \"order_time\", \"pizza_name\" || ': ' || STRING_AGG(formatted_name, ', ' ORDER BY sort_group, \"topping_name\") AS ingredients FROM formatted_toppings GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_name\", \"order_time\") SELECT row_id, \"order_id\", \"customer_id\", \"pizza_name\", ingredients FROM ingredient_strings ORDER BY row_id") t0 t1 t2 t3
  = (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH customer_orders AS (SELECT ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"), recipe_toppings /* Split recipe toppings into individual rows */ AS (SELECT r.\"pizza_id\", CAST(TRIM(CAST(t.VALUE AS TEXT)) AS INT) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" AS r, LATERAL UNNEST(INPUT => SPLIT(r.\"toppings\", ',')) AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS)), order_base_toppings /* For each order row, get base toppings from recipe */ AS (SELECT co.row_id, co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\", co.\"order_time\", rt.topping_id, 1 AS topping_count FROM customer_orders AS co JOIN recipe_toppings AS rt ON co.\"pizza_id\" = rt.\"pizza_id\"), order_exclusions /* Parse exclusions per order row */ AS (SELECT co.row_id, CAST(TRIM(CAST(e.VALUE AS TEXT)) AS INT) AS excluded_topping_id FROM customer_orders AS co, LATERAL UNNEST(INPUT => SPLIT(co.\"exclusions\", ','), OUTER => TRUE) AS e(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT co.\"exclusions\" IS NULL AND co.\"exclusions\" <> ''), order_extras /* Parse extras per order row */ AS (SELECT co.row_id, CAST(TRIM(CAST(x.VALUE AS TEXT)) AS INT) AS extra_topping_id FROM customer_orders AS co, LATERAL UNNEST(INPUT => SPLIT(co.\"extras\", ','), OUTER => TRUE) AS x(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT co.\"extras\" IS NULL AND co.\"extras\" <> ''), base_minus_exclusions /* Remove exclusions from base toppings */ AS (SELECT obt.row_id, obt.\"order_id\", obt.\"customer_id\", obt.\"pizza_id\", obt.\"exclusions\", obt.\"extras\", obt.\"order_time\", obt.topping_id, obt.topping_count FROM order_base_toppings AS obt LEFT JOIN order_exclusions AS oe ON obt.row_id = oe.row_id AND obt.topping_id = oe.excluded_topping_id WHERE oe.excluded_topping_id IS NULL), all_toppings /* Combine base toppings (minus exclusions) with extras */ /* Extras that are already in base get counted as additional */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\", topping_id, topping_count FROM base_minus_exclusions UNION ALL SELECT ox.row_id, co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\", co.\"order_time\", ox.extra_topping_id AS topping_id, 1 AS topping_count FROM order_extras AS ox JOIN customer_orders AS co ON ox.row_id = co.row_id), topping_counts /* Aggregate topping counts per order row */ AS (SELECT at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"exclusions\", at2.\"extras\", at2.\"order_time\", at2.topping_id, SUM(at2.topping_count) AS total_count FROM all_toppings AS at2 GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"exclusions\", at2.\"extras\", at2.\"order_time\", at2.topping_id), formatted_toppings /* Join with topping names and format */ AS (SELECT tc.row_id, tc.\"order_id\", tc.\"customer_id\", tc.\"pizza_id\", tc.\"exclusions\", tc.\"extras\", tc.\"order_time\", tc.topping_id, tc.total_count, pt.\"topping_name\", CASE WHEN tc.total_count > 1 THEN '2x ' || pt.\"topping_name\" ELSE pt.\"topping_name\" END AS formatted_topping, CASE WHEN tc.total_count > 1 THEN 0 ELSE 1 END AS sort_group FROM topping_counts AS tc JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS pt ON tc.topping_id = pt.\"topping_id\"), ingredient_list /* Build sorted ingredient list using LISTAGG */ AS (SELECT ft.row_id, ft.\"order_id\", ft.\"customer_id\", pn.\"pizza_name\" AS PIZZA_NAME, STRING_AGG(ft.formatted_topping, ', ' ORDER BY ft.sort_group, ft.\"topping_name\") AS ingredients FROM formatted_toppings AS ft JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" AS pn ON ft.\"pizza_id\" = pn.\"pizza_id\" GROUP BY ft.row_id, ft.\"order_id\", ft.\"customer_id\", ft.\"pizza_id\", pn.\"pizza_name\", ft.\"order_time\") SELECT il.row_id AS ROW_ID, il.\"order_id\" AS ORDER_ID, il.\"customer_id\" AS CUSTOMER_ID, il.PIZZA_NAME, il.PIZZA_NAME || ': ' || il.ingredients AS FINAL_INGREDIENTS FROM ingredient_list AS il ORDER BY il.row_id") t0 t1 t2 t3
