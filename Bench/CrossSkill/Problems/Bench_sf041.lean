import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf041 — crossskill equivalence(s)

Question: Produce a report for ERCOT on October 1, 2022, that combines hourly data on day-ahead and real-time prices from node ID 10000697078, load forecasts (datatypeid 19060) and actual loads, plus wind (forecast datatypeid 9285, actual datatypeid 16) and solar (forecast datatypeid 662, actual datatypeid 650) generation forecasts and actuals from object ID 10000712973. This report should include time zone alignments, peak classifications, and net load calculations, providing insights into daily operational dynamics and efficiency.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf041

CREATE TABLE TS_FORECAST_SAMPLE («LOADID» INT, «HISTORYID» INT, «DATETIME» STRING, «VALUE» INT, «PUBLISHDATE» STRING, «TIMEZONE» STRING, «DATATYPEID» INT, «OBJECTID» INT)
CREATE TABLE DART_LOADS_SAMPLE («DATETIME» STRING, «OBJECTID» INT, «DALOAD» INT, «LOADID» INT, «TIMEZONE» STRING, «RTFINAL» STRING, «DARTLOADID» INT, «RTLOAD» INT)
CREATE TABLE DART_PRICES_SAMPLE («DACONG» INT, «DATETIME» STRING, «DALMP» INT, «HALOSS» INT, «RTLMP» INT, «RTLOSS» INT, «LOADID» INT, «ISO» STRING, «RTCONG» INT, «TIMEZONE» STRING, «HALMP» INT, «DALOSS» INT, «RTFINAL» STRING, «HACONG» INT, «PROXYCODE» STRING, «OBJECTID» INT)
CREATE TABLE TS_GEN_SAMPLE («VALUE» INT, «HISTORYID» INT, «LOADID» INT, «TIMEZONE» STRING, «OBJECTID» INT, «DATETIME» STRING, «DATATYPEID» INT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([TS_FORECAST_SAMPLE_schema, DART_LOADS_SAMPLE_schema, DART_PRICES_SAMPLE_schema, TS_GEN_SAMPLE_schema]) "-- SF041: ERCOT Daily Market Dynamics Report for October 1, 2022\nWITH hours AS (\n    SELECT \n        DATEADD('hour', seq4(), '2022-10-01 00:00:00'::TIMESTAMP_NTZ) AS dt\n    FROM TABLE(GENERATOR(ROWCOUNT => 24))\n),\nspine AS (\n    SELECT\n        'ERCOT' AS ISO,\n        dt AS DATETIME,\n        'CDT' AS TIMEZONE,\n        DATEADD('hour', 5, dt) AS DATETIME_UTC,\n        0 AS ONPEAK,\n        CASE WHEN HOUR(dt) BETWEEN 7 AND 22 THEN 0 ELSE 1 END AS OFFPEAK,\n        CASE WHEN HOUR(dt) BETWEEN 7 AND 22 THEN 1 ELSE 0 END AS WEPEAK,\n        0 AS WDPEAK,\n        DATE(dt) AS MARKETDAY\n    FROM hours\n),\ndart AS (\n    SELECT\n        DATETIME,\n        DALMP,\n        RTLMP\n    FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_PRICES_SAMPLE\"\n    WHERE OBJECTID = 10000697078\n    AND DATE(DATETIME) = '2022-10-01'\n),\nload_fcst AS (\n    SELECT\n        DATETIME,\n        VALUE AS LOAD_FORECAST,\n        PUBLISHDATE AS LOAD_FORECAST_PUBLISH_DATE\n    FROM (\n        SELECT\n            DATETIME,\n            VALUE,\n            PUBLISHDATE,\n            ROW_NUMBER() OVER (PARTITION BY DATETIME ORDER BY PUBLISHDATE DESC) AS rn\n        FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\"\n        WHERE OBJECTID = 10000712973\n        AND DATATYPEID = 19060\n        AND DATE(DATETIME) = '2022-10-01'\n    ) WHERE rn = 1\n),\nrt_load AS (\n    SELECT\n        DATETIME,\n        RTLOAD\n    FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_LOADS_SAMPLE\"\n    WHERE OBJECTID = 10000712973\n    AND DATE(DATETIME) = '2022-10-01'\n),\nwind_fcst AS (\n    SELECT\n        DATETIME,\n        VALUE AS WIND_GEN_FORECAST,\n        PUBLISHDATE AS WIND_GEN_FORECAST_PUBLISH_DATE\n    FROM (\n        SELECT\n            DATETIME,\n            VALUE,\n            PUBLISHDATE,\n            ROW_NUMBER() OVER (PARTITION BY DATETIME ORDER BY PUBLISHDATE DESC) AS rn\n        FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\"\n        WHERE OBJECTID = 10000712973\n        AND DATATYPEID = 9285\n        AND DATE(DATETIME) = '2022-10-01'\n    ) WHERE rn = 1\n),\nwind_actual AS (\n    SELECT\n        DATE_TRUNC('hour', DATETIME) AS DATETIME,\n        AVG(VALUE) AS WIND_GEN\n    FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\"\n    WHERE OBJECTID = 10000712973\n    AND DATATYPEID = 16\n    AND DATE(DATETIME) = '2022-10-01'\n    GROUP BY DATE_TRUNC('hour', DATETIME)\n),\nsolar_fcst AS (\n    SELECT\n        DATETIME,\n        VALUE AS SOLAR_GEN_FORECAST,\n        PUBLISHDATE AS SOLAR_GEN_FORECAST_PUBLISH_DATE\n    FROM (\n        SELECT\n            DATETIME,\n            VALUE,\n            PUBLISHDATE,\n            ROW_NUMBER() OVER (PARTITION BY DATETIME ORDER BY PUBLISHDATE DESC) AS rn\n        FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\"\n        WHERE OBJECTID = 10000712973\n        AND DATATYPEID = 662\n        AND DATE(DATETIME) = '2022-10-01'\n    ) WHERE rn = 1\n),\nsolar_actual AS (\n    SELECT\n        DATE_TRUNC('hour', DATETIME) AS DATETIME,\n        AVG(VALUE) AS SOLAR_GEN\n    FROM \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\"\n    WHERE OBJECTID = 10000712973\n    AND DATATYPEID = 650\n    AND DATE(DATETIME) = '2022-10-01'\n    GROUP BY DATE_TRUNC('hour', DATETIME)\n)\nSELECT\n    s.ISO,\n    s.DATETIME,\n    s.TIMEZONE,\n    s.DATETIME_UTC,\n    s.ONPEAK,\n    s.OFFPEAK,\n    s.WEPEAK,\n    s.WDPEAK,\n    s.MARKETDAY,\n    'HB_NORTH' AS PRICE_NODE_NAME,\n    10000697078 AS PRICE_NODE_ID,\n    d.DALMP,\n    d.RTLMP,\n    'ERCOT' AS LOAD_ZONE_NAME,\n    10000712973 AS LOAD_ZONE_ID,\n    lf.LOAD_FORECAST,\n    lf.LOAD_FORECAST_PUBLISH_DATE,\n    rl.RTLOAD,\n    wf.WIND_GEN_FORECAST,\n    wf.WIND_GEN_FORECAST_PUBLISH_DATE,\n    wa.WIND_GEN,\n    sf.SOLAR_GEN_FORECAST,\n    sf.SOLAR_GEN_FORECAST_PUBLISH_DATE,\n    sa.SOLAR_GEN,\n    lf.LOAD_FORECAST - wf.WIND_GEN_FORECAST - sf.SOLAR_GEN_FORECAST AS NET_LOAD_FORECAST,\n    rl.RTLOAD - wa.WIND_GEN - sa.SOLAR_GEN AS NET_LOAD_REAL_TIME\nFROM spine s\nLEFT JOIN dart d ON d.DATETIME = s.DATETIME\nLEFT JOIN load_fcst lf ON lf.DATETIME = s.DATETIME\nLEFT JOIN rt_load rl ON rl.DATETIME = s.DATETIME\nLEFT JOIN wind_fcst wf ON wf.DATETIME = s.DATETIME\nLEFT JOIN wind_actual wa ON wa.DATETIME = s.DATETIME\nLEFT JOIN solar_fcst sf ON sf.DATETIME = s.DATETIME\nLEFT JOIN solar_actual sa ON sa.DATETIME = s.DATETIME\nORDER BY s.DATETIME" = sql%([TS_FORECAST_SAMPLE_schema, DART_LOADS_SAMPLE_schema, DART_PRICES_SAMPLE_schema, TS_GEN_SAMPLE_schema]) "WITH hours AS (\n    SELECT \n        DATEADD(HOUR, seq4(), '2022-10-01 00:00:00'::TIMESTAMP_NTZ) AS dt\n    FROM TABLE(GENERATOR(ROWCOUNT => 24))\n),\ntime_scaffold AS (\n    SELECT\n        'ERCOT' AS \"ISO\",\n        h.dt AS \"DATETIME\",\n        'CDT' AS \"TIMEZONE\",\n        DATEADD(HOUR, 5, h.dt) AS \"DATETIME_UTC\",\n        0 AS \"ONPEAK\",\n        CASE WHEN EXTRACT(HOUR FROM h.dt) BETWEEN 7 AND 22 THEN 0 ELSE 1 END AS \"OFFPEAK\",\n        CASE WHEN EXTRACT(HOUR FROM h.dt) BETWEEN 7 AND 22 THEN 1 ELSE 0 END AS \"WEPEAK\",\n        0 AS \"WDPEAK\",\n        '2022-10-01'::DATE AS \"MARKETDAY\",\n        'HB_NORTH' AS \"PRICE_NODE_NAME\",\n        10000697078 AS \"PRICE_NODE_ID\",\n        'ERCOT' AS \"LOAD_ZONE_NAME\",\n        10000712973 AS \"LOAD_ZONE_ID\"\n    FROM hours h\n)\nSELECT\n    ts.\"ISO\",\n    ts.\"DATETIME\",\n    ts.\"TIMEZONE\",\n    ts.\"DATETIME_UTC\",\n    ts.\"ONPEAK\",\n    ts.\"OFFPEAK\",\n    ts.\"WEPEAK\",\n    ts.\"WDPEAK\",\n    ts.\"MARKETDAY\",\n    ts.\"PRICE_NODE_NAME\",\n    ts.\"PRICE_NODE_ID\",\n    dp.\"DALMP\" AS \"DALMP\",\n    dp.\"RTLMP\" AS \"RTLMP\",\n    ts.\"LOAD_ZONE_NAME\",\n    ts.\"LOAD_ZONE_ID\",\n    dl.\"DALOAD\" AS \"LOAD_FORECAST\",\n    NULL AS \"LOAD_FORECAST_PUBLISH_DATE\",\n    dl.\"RTLOAD\" AS \"RTLOAD\",\n    wind_fc.\"VALUE\" AS \"WIND_GEN_FORECAST\",\n    wind_fc.\"PUBLISHDATE\" AS \"WIND_GEN_FORECAST_PUBLISH_DATE\",\n    wind_gen.\"VALUE\" AS \"WIND_GEN\",\n    solar_fc.\"VALUE\" AS \"SOLAR_GEN_FORECAST\",\n    solar_fc.\"PUBLISHDATE\" AS \"SOLAR_GEN_FORECAST_PUBLISH_DATE\",\n    solar_gen.\"VALUE\" AS \"SOLAR_GEN\",\n    dl.\"DALOAD\" - wind_fc.\"VALUE\" - solar_fc.\"VALUE\" AS \"NET_LOAD_FORECAST\",\n    dl.\"RTLOAD\" - wind_gen.\"VALUE\" - solar_gen.\"VALUE\" AS \"NET_LOAD_REAL_TIME\"\nFROM time_scaffold ts\nLEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_PRICES_SAMPLE\" dp\n    ON dp.\"OBJECTID\" = 10000697078\n    AND dp.\"DATETIME\" = ts.\"DATETIME\"\nLEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"DART_LOADS_SAMPLE\" dl\n    ON dl.\"OBJECTID\" = 10000712973\n    AND dl.\"DATETIME\" = ts.\"DATETIME\"\nLEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\" wind_fc\n    ON wind_fc.\"OBJECTID\" = 10000712973\n    AND wind_fc.\"DATATYPEID\" = 9285\n    AND wind_fc.\"DATETIME\" = ts.\"DATETIME\"\nLEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\" wind_gen\n    ON wind_gen.\"OBJECTID\" = 10000712973\n    AND wind_gen.\"DATATYPEID\" = 16\n    AND wind_gen.\"DATETIME\" = ts.\"DATETIME\"\nLEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_FORECAST_SAMPLE\" solar_fc\n    ON solar_fc.\"OBJECTID\" = 10000712973\n    AND solar_fc.\"DATATYPEID\" = 662\n    AND solar_fc.\"DATETIME\" = ts.\"DATETIME\"\nLEFT JOIN \"YES_ENERGY__SAMPLE_DATA\".\"YES_ENERGY_SAMPLE\".\"TS_GEN_SAMPLE\" solar_gen\n    ON solar_gen.\"OBJECTID\" = 10000712973\n    AND solar_gen.\"DATATYPEID\" = 650\n    AND solar_gen.\"DATETIME\" = ts.\"DATETIME\"\nORDER BY ts.\"DATETIME\";" := by
  first | sql_equiv | sorry

end Bench_sf041
