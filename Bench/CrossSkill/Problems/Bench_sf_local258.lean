     b.\"bowler\",\n        CASE WHEN er.\"extra_type\" = 'wides' THEN 1 ELSE 0 END AS is_wide,\n        CASE WHEN er.\"extra_type\" = 'noballs' THEN 1 ELSE 0 END AS is_noball\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    LEFT JOIN \"IPL\".\"IPL\".\"EXTRA_RUNS\" er\n        ON b.\"match_id\" = er.\"match_id\"\n        AND b.\"over_id\" = er.\"over_id\"\n        AND b.\"ball_id\" = er.\"ball_id\"\n        AND b.\"innings_no\" = er.\"innings_no\"\n),\nbowler_balls AS (\n    -- Per bowler: total balls, legal balls\n    SELECT\n        be.\"bowler\" AS player_id,\n        COUNT(*) AS total_balls,\n        SUM(1 - be.is_wide - be.is_noball) AS legal_balls\n    FROM ball_extras be\n    GROUP BY be.\"bowler\"\n),\nbowler_runs AS (\n    -- Per bowler: total runs conceded (from BATSMAN_SCORED)\n    SELECT\n        b.\"bowler\" AS player_id,\n        SUM(bs.\"runs_scored\") AS bat_runs\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"bowler\"\n),\nbowler_wickets AS (\n    -- Per bowler: total wickets (excluding run out, retired hurt, obstructing the field)\n    SELECT\n        b.\"bowler\" AS player_id,\n        COUNT(*) AS total_wickets\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n        ON b.\"match_id\" = wt.\"match_id\"\n        AND b.\"over_id\" = wt.\"over_id\"\n        AND b.\"ball_id\" = wt.\"ball_id\"\n        AND b.\"innings_no\" = wt.\"innings_no\"\n    WHERE wt.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n    GROUP BY b.\"bowler\"\n),\n-- Per match stats for best bowling\nmatch_wickets AS (\n    SELECT\n        b.\"bowler\" AS player_id,\n        b.\"match_id\",\n        COUNT(*) AS match_wickets\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n        ON b.\"match_id\" = wt.\"match_id\"\n        AND b.\"over_id\" = wt.\"over_id\"\n        AND b.\"ball_id\" = wt.\"ball_id\"\n        AND b.\"innings_no\" = wt.\"innings_no\"\n    WHERE wt.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n    GROUP BY b.\"bowler\", b.\"match_id\"\n),\nmatch_runs AS (\n    SELECT\n        b.\"bowler\" AS player_id,\n        b.\"match_id\",\n        SUM(COALESCE(bs.\"runs_scored\", 0)) AS match_runs\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    LEFT JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"bowler\", b.\"match_id\"\n),\nbest_bowling AS (\n    SELECT\n        mw.player_id,\n        mw.\"match_id\",\n        mw.match_wickets,\n        mr.match_runs,\n        ROW_NUMBER() OVER (\n            PARTITION BY mw.player_id\n            ORDER BY mw.match_wickets DESC, mr.match_runs ASC\n        ) AS rn\n    FROM match_wickets mw\n    JOIN match_runs mr\n        ON mw.player_id = mr.player_id\n        AND mw.\"match_id\" = mr.\"match_id\"\n)\nSELECT\n    p.\"player_name\" AS player_name,\n    COALESCE(bw.total_wickets, 0) AS TOTAL_WICKETS,\n    ROUND(br.bat_runs * 6.0 / bb.legal_balls, 4) AS ECONOMY_RATE,\n    CASE WHEN COALESCE(bw.total_wickets, 0) > 0\n         THEN ROUND(bb.legal_balls * 1.0 / bw.total_wickets, 4)\n         ELSE NULL\n    END AS STRIKE_RATE,\n    CASE WHEN COALESCE(bw.total_wickets, 0) > 0\n         THEN best.match_wickets || '-' || best.match_runs\n         ELSE NULL\n    END AS BEST_BOWLING\nFROM bowler_balls bb\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p ON bb.player_id = p.\"player_id\"\nLEFT JOIN bowler_runs br ON bb.player_id = br.player_id\nLEFT JOIN bowler_wickets bw ON bb.player_id = bw.player_id\nLEFT JOIN best_bowling best ON bb.player_id = best.player_id AND best.rn = 1\nORDER BY p.\"player_name\";") t := by
