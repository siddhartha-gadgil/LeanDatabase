/-!
# sf_local258 — crossskill equivalence(s)

Question: Calculate the total number of wickets taken by each bowler (excluding run-outs and other dismissals not attributed to the bowler), their economy rate (total runs conceded divided by total overs bowled, considering only runs scored off the bat and ignoring any extra runs like wides and no-balls), their strike rate (average number of balls bowled per wicket taken), and their best bowling performance in a single match (the match with the most wickets taken by the bowler, formatted as "wickets-runs" where runs are the runs conceded excluding extras).

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local258

CREATE TABLE PLAYER («player_id» INT, «player_name» STRING, «dob» STRING, «batting_hand» STRING, «bowling_skill» STRING, «country_name» STRING)
CREATE TABLE BATSMAN_SCORED («match_id» INT, «over_id» INT, «ball_id» INT, «runs_scored» INT, «innings_no» INT)
CREATE TABLE WICKET_TAKEN («match_id» INT, «over_id» INT, «ball_id» INT, «player_out» INT, «kind_out» STRING, «innings_no» INT)
CREATE TABLE BALL_BY_BALL («match_id» INT, «over_id» INT, «ball_id» INT, «innings_no» INT, «team_batting» INT, «team_bowling» INT, «striker_batting_position» INT, «striker» INT, «non_striker» INT, «bowler» INT)
CREATE TABLE EXTRA_RUNS («match_id» INT, «over_id» INT, «ball_id» INT, «extra_type» STRING, «extra_runs» INT, «innings_no» INT)
CREATE TABLE MATCH («match_id» INT, «team_1» INT, «team_2» INT, «match_date» STRING, «season_id» INT, «venue» STRING, «toss_winner» INT, «toss_decision» STRING, «win_type» STRING, «win_margin» INT, «outcome_type» STRING, «match_winner» INT, «man_of_the_match» INT)

theorem eq_0_1 : ∀ t,
    (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema, MATCH_schema]) "WITH ball_data AS (\n    -- Base: every ball with bowler, bat runs, extra type\n    SELECT\n        b.\"match_id\",\n        b.\"over_id\",\n        b.\"ball_id\",\n        b.\"innings_no\",\n        b.\"bowler\",\n        COALESCE(bs.\"runs_scored\", 0) AS runs_scored,\n        e.\"extra_type\"\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    LEFT JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n    LEFT JOIN \"IPL\".\"IPL\".\"EXTRA_RUNS\" e\n        ON b.\"match_id\" = e.\"match_id\"\n        AND b.\"over_id\" = e.\"over_id\"\n        AND b.\"ball_id\" = e.\"ball_id\"\n        AND b.\"innings_no\" = e.\"innings_no\"\n),\nbowler_overall AS (\n    -- Per-bowler aggregates: legal balls, bat runs\n    SELECT\n        bd.\"bowler\",\n        SUM(bd.runs_scored) AS total_runs_conceded,\n        SUM(CASE WHEN bd.\"extra_type\" NOT IN ('wides', 'noballs') OR bd.\"extra_type\" IS NULL THEN 1 ELSE 0 END) AS legal_balls\n    FROM ball_data bd\n    GROUP BY bd.\"bowler\"\n),\nwicket_data AS (\n    -- Wickets attributed to bowler (exclude run out, retired hurt, obstructing the field)\n    SELECT\n        b.\"bowler\",\n        b.\"match_id\",\n        w.\"kind_out\"\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n        ON b.\"match_id\" = w.\"match_id\"\n        AND b.\"over_id\" = w.\"over_id\"\n        AND b.\"ball_id\" = w.\"ball_id\"\n        AND b.\"innings_no\" = w.\"innings_no\"\n    WHERE w.\"kind_out\" IN ('caught', 'bowled', 'lbw', 'stumped', 'caught and bowled', 'hit wicket')\n),\nbowler_wickets AS (\n    -- Total wickets per bowler\n    SELECT\n        \"bowler\",\n        COUNT(*) AS total_wickets\n    FROM wicket_data\n    GROUP BY \"bowler\"\n),\n-- Per-match stats for best bowling\nmatch_wickets AS (\n    SELECT\n        bd.\"bowler\",\n        bd.\"match_id\",\n        SUM(CASE WHEN w.\"kind_out\" IN ('caught', 'bowled', 'lbw', 'stumped', 'caught and bowled', 'hit wicket') THEN 1 ELSE 0 END) AS match_wkts,\n        SUM(bd.runs_scored) AS match_runs\n    FROM ball_data bd\n    LEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n        ON bd.\"match_id\" = w.\"match_id\"\n        AND bd.\"over_id\" = w.\"over_id\"\n        AND bd.\"ball_id\" = w.\"ball_id\"\n        AND bd.\"innings_no\" = w.\"innings_no\"\n    GROUP BY bd.\"bowler\", bd.\"match_id\"\n),\nbest_bowling AS (\n    -- Best bowling: most wickets in a match, tiebreak fewest runs\n    SELECT\n        \"bowler\",\n        match_wkts,\n        match_runs,\n        ROW_NUMBER() OVER (PARTITION BY \"bowler\" ORDER BY match_wkts DESC, match_runs ASC) AS rn\n    FROM match_wickets\n)\nSELECT\n    p.\"player_name\",\n    COALESCE(bw.total_wickets, 0) AS TOTAL_WICKETS,\n    ROUND(bo.total_runs_conceded * 6.0 / bo.legal_balls, 4) AS ECONOMY_RATE,\n    CASE WHEN COALESCE(bw.total_wickets, 0) > 0\n         THEN ROUND(bo.legal_balls * 1.0 / bw.total_wickets, 4)\n         ELSE NULL\n    END AS STRIKE_RATE,\n    CASE WHEN COALESCE(bw.total_wickets, 0) > 0\n         THEN bb.match_wkts || '-' || bb.match_runs\n         ELSE NULL\n    END AS BEST_BOWLING\nFROM bowler_overall bo\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p ON bo.\"bowler\" = p.\"player_id\"\nLEFT JOIN bowler_wickets bw ON bo.\"bowler\" = bw.\"bowler\"\nLEFT JOIN best_bowling bb ON bo.\"bowler\" = bb.\"bowler\" AND bb.rn = 1\nORDER BY p.\"player_name\";") t ~= (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema, MATCH_schema]) "WITH bowler_balls AS (\n    -- Base: every ball bowled, with runs scored and extras info\n    SELECT\n        b.\"bowler\",\n        b.\"match_id\",\n        b.\"over_id\",\n        b.\"ball_id\",\n        b.\"innings_no\",\n        COALESCE(bs.\"runs_scored\", 0) AS runs_scored,\n        e.\"extra_type\",\n        CASE WHEN e.\"extra_type\" IN ('wides', 'noballs') THEN 0 ELSE 1 END AS is_legal\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    LEFT JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n    LEFT JOIN \"IPL\".\"IPL\".\"EXTRA_RUNS\" e\n        ON b.\"match_id\" = e.\"match_id\"\n        AND b.\"over_id\" = e.\"over_id\"\n        AND b.\"ball_id\" = e.\"ball_id\"\n        AND b.\"innings_no\" = e.\"innings_no\"\n),\nbowler_wickets AS (\n    -- Wickets attributed to the bowler (excluding run out, retired hurt, obstructing the field)\n    SELECT\n        b.\"bowler\",\n        b.\"match_id\",\n        w.\"kind_out\"\n    FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n    JOIN \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n        ON w.\"match_id\" = b.\"match_id\"\n        AND w.\"over_id\" = b.\"over_id\"\n        AND w.\"ball_id\" = b.\"ball_id\"\n        AND w.\"innings_no\" = b.\"innings_no\"\n    WHERE w.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n),\n-- Overall stats per bowler\nbowler_overall AS (\n    SELECT\n        bb.\"bowler\",\n        SUM(bb.runs_scored) AS total_runs_conceded,\n        SUM(bb.is_legal) AS legal_balls\n    FROM bowler_balls bb\n    GROUP BY bb.\"bowler\"\n),\nbowler_total_wickets AS (\n    SELECT\n        bw.\"bowler\",\n        COUNT(*) AS total_wickets\n    FROM bowler_wickets bw\n    GROUP BY bw.\"bowler\"\n),\n-- Per match stats for best bowling\nbowler_match_runs AS (\n    SELECT\n        bb.\"bowler\",\n        bb.\"match_id\",\n        SUM(bb.runs_scored) AS match_runs\n    FROM bowler_balls bb\n    GROUP BY bb.\"bowler\", bb.\"match_id\"\n),\nbowler_match_wickets AS (\n    SELECT\n        bw.\"bowler\",\n        bw.\"match_id\",\n        COUNT(*) AS match_wickets\n    FROM bowler_wickets bw\n    GROUP BY bw.\"bowler\", bw.\"match_id\"\n),\nbowler_match_combined AS (\n    SELECT\n        bmr.\"bowler\",\n        bmr.\"match_id\",\n        COALESCE(bmw.match_wickets, 0) AS match_wickets,\n        bmr.match_runs\n    FROM bowler_match_runs bmr\n    LEFT JOIN bowler_match_wickets bmw\n        ON bmr.\"bowler\" = bmw.\"bowler\"\n        AND bmr.\"match_id\" = bmw.\"match_id\"\n),\nbest_bowling AS (\n    SELECT\n        bmc.\"bowler\",\n        bmc.match_wickets,\n        bmc.match_runs,\n        ROW_NUMBER() OVER (\n            PARTITION BY bmc.\"bowler\"\n            ORDER BY bmc.match_wickets DESC, bmc.match_runs ASC\n        ) AS rn\n    FROM bowler_match_combined bmc\n    WHERE bmc.match_wickets > 0\n)\nSELECT\n    p.\"player_name\",\n    COALESCE(btw.total_wickets, 0) AS TOTAL_WICKETS,\n    ROUND(bo.total_runs_conceded * 6.0 / bo.legal_balls, 4) AS ECONOMY_RATE,\n    CASE \n        WHEN COALESCE(btw.total_wickets, 0) > 0 \n        THEN ROUND(bo.legal_balls * 1.0 / btw.total_wickets, 4)\n        ELSE NULL \n    END AS STRIKE_RATE,\n    CASE \n        WHEN bb.match_wickets IS NOT NULL \n        THEN bb.match_wickets || '-' || bb.match_runs\n        ELSE NULL \n    END AS BEST_BOWLING\nFROM bowler_overall bo\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p ON bo.\"bowler\" = p.\"player_id\"\nLEFT JOIN bowler_total_wickets btw ON bo.\"bowler\" = btw.\"bowler\"\nLEFT JOIN best_bowling bb ON bo.\"bowler\" = bb.\"bowler\" AND bb.rn = 1\nORDER BY p.\"player_name\";") t := by
