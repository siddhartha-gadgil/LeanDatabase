/-!
# sf_local302 — crossskill equivalence(s)

Question: Analyze the average percentage change in sales between the 12 weeks before and after June 15, 2020, for each attribute type: region, platform, age band, demographic, and customer type. For each attribute type, calculate the average percentage change in sales across all its attribute values. Identify the attribute type with the highest negative impact on sales and provide its average percentage change in sales.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local302

CREATE TABLE CLEANED_WEEKLY_SALES («week_date_formatted» STRING, «week_date» STRING, «region» STRING, «platform» STRING, «segment» STRING, «customer_type» STRING, «transactions» INT, «sales» INT, «week_number» INT, «month_number» INT, «calendar_year» INT, «age_band» STRING, «demographic» STRING, «avg_transaction» FLOAT)

HYPOTHESIS hyp0_1_0 : CLEANED_WEEKLY_SALES "\"week_date\" >= '2020-03-23'"
HYPOTHESIS hyp0_1_1 : CLEANED_WEEKLY_SALES "\"week_date\" <= '2020-08-31'"
theorem eq_0_1 (t : TableRel CLEANED_WEEKLY_SALES_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) :
    (sql%([CLEANED_WEEKLY_SALES_schema]) "WITH before_after AS (\n    SELECT \n        \"region\",\n        \"platform\",\n        \"age_band\",\n        \"demographic\",\n        \"customer_type\",\n        SUM(CASE WHEN \"week_date\" < '2020-06-15' THEN \"sales\" ELSE 0 END) AS before_sales,\n        SUM(CASE WHEN \"week_date\" >= '2020-06-15' THEN \"sales\" ELSE 0 END) AS after_sales\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CLEANED_WEEKLY_SALES\"\n    WHERE \"week_date\" >= '2020-03-23' AND \"week_date\" <= '2020-08-31'\n    GROUP BY \"region\", \"platform\", \"age_band\", \"demographic\", \"customer_type\"\n),\n-- Compute pct change per attribute value for each attribute type\nregion_pct AS (\n    SELECT 'region' AS metric, \"region\" AS attr_value,\n        (SUM(after_sales) - SUM(before_sales)) * 100.0 / SUM(before_sales) AS pct_change\n    FROM before_after\n    GROUP BY \"region\"\n),\nplatform_pct AS (\n    SELECT 'platform' AS metric, \"platform\" AS attr_value,\n        (SUM(after_sales) - SUM(before_sales)) * 100.0 / SUM(before_sales) AS pct_change\n    FROM before_after\n    GROUP BY \"platform\"\n),\nage_band_pct AS (\n    SELECT 'age_band' AS metric, \"age_band\" AS attr_value,\n        (SUM(after_sales) - SUM(before_sales)) * 100.0 / SUM(before_sales) AS pct_change\n    FROM before_after\n    GROUP BY \"age_band\"\n),\ndemographic_pct AS (\n    SELECT 'demographic' AS metric, \"demographic\" AS attr_value,\n        (SUM(after_sales) - SUM(before_sales)) * 100.0 / SUM(before_sales) AS pct_change\n    FROM before_after\n    GROUP BY \"demographic\"\n),\ncustomer_type_pct AS (\n    SELECT 'customer_type' AS metric, \"customer_type\" AS attr_value,\n        (SUM(after_sales) - SUM(before_sales)) * 100.0 / SUM(before_sales) AS pct_change\n    FROM before_after\n    GROUP BY \"customer_type\"\n),\nall_pct AS (\n    SELECT * FROM region_pct\n    UNION ALL SELECT * FROM platform_pct\n    UNION ALL SELECT * FROM age_band_pct\n    UNION ALL SELECT * FROM demographic_pct\n    UNION ALL SELECT * FROM customer_type_pct\n),\navg_by_type AS (\n    SELECT metric AS \"METRIC\", AVG(pct_change) AS \"AVG_PERCENT_CHANGE\"\n    FROM all_pct\n    GROUP BY metric\n)\nSELECT \"METRIC\", ROUND(\"AVG_PERCENT_CHANGE\", 6) AS \"AVG_PERCENT_CHANGE\"\nFROM avg_by_type\nORDER BY \"AVG_PERCENT_CHANGE\" ASC\nLIMIT 1;") t ~= (sql%([CLEANED_WEEKLY_SALES_schema]) "WITH before_after AS (\n  SELECT \n    'region' AS attribute_type,\n    \"region\" AS attribute_value,\n    SUM(CASE WHEN \"week_date\" >= '2020-03-23' AND \"week_date\" < '2020-06-15' THEN \"sales\" ELSE 0 END) AS before_sales,\n    SUM(CASE WHEN \"week_date\" >= '2020-06-15' AND \"week_date\" < '2020-09-07' THEN \"sales\" ELSE 0 END) AS after_sales\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CLEANED_WEEKLY_SALES\"\n  GROUP BY \"region\"\n  \n  UNION ALL\n  \n  SELECT \n    'platform' AS attribute_type,\n    \"platform\" AS attribute_value,\n    SUM(CASE WHEN \"week_date\" >= '2020-03-23' AND \"week_date\" < '2020-06-15' THEN \"sales\" ELSE 0 END),\n    SUM(CASE WHEN \"week_date\" >= '2020-06-15' AND \"week_date\" < '2020-09-07' THEN \"sales\" ELSE 0 END)\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CLEANED_WEEKLY_SALES\"\n  GROUP BY \"platform\"\n  \n  UNION ALL\n  \n  SELECT \n    'age_band' AS attribute_type,\n    \"age_band\" AS attribute_value,\n    SUM(CASE WHEN \"week_date\" >= '2020-03-23' AND \"week_date\" < '2020-06-15' THEN \"sales\" ELSE 0 END),\n    SUM(CASE WHEN \"week_date\" >= '2020-06-15' AND \"week_date\" < '2020-09-07' THEN \"sales\" ELSE 0 END)\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CLEANED_WEEKLY_SALES\"\n  GROUP BY \"age_band\"\n  \n  UNION ALL\n  \n  SELECT \n    'demographic' AS attribute_type,\n    \"demographic\" AS attribute_value,\n    SUM(CASE WHEN \"week_date\" >= '2020-03-23' AND \"week_date\" < '2020-06-15' THEN \"sales\" ELSE 0 END),\n    SUM(CASE WHEN \"week_date\" >= '2020-06-15' AND \"week_date\" < '2020-09-07' THEN \"sales\" ELSE 0 END)\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CLEANED_WEEKLY_SALES\"\n  GROUP BY \"demographic\"\n  \n  UNION ALL\n  \n  SELECT \n    'customer_type' AS attribute_type,\n    \"customer_type\" AS attribute_value,\n    SUM(CASE WHEN \"week_date\" >= '2020-03-23' AND \"week_date\" < '2020-06-15' THEN \"sales\" ELSE 0 END),\n    SUM(CASE WHEN \"week_date\" >= '2020-06-15' AND \"week_date\" < '2020-09-07' THEN \"sales\" ELSE 0 END)\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CLEANED_WEEKLY_SALES\"\n  GROUP BY \"customer_type\"\n),\npct AS (\n  SELECT attribute_type, attribute_value,\n    100.0 * (after_sales - before_sales) / NULLIF(before_sales, 0) AS pct_change\n  FROM before_after\n),\navg_pct AS (\n  SELECT attribute_type AS METRIC,\n    AVG(pct_change) AS AVG_PERCENT_CHANGE\n  FROM pct\n  GROUP BY attribute_type\n)\nSELECT METRIC, AVG_PERCENT_CHANGE\nFROM avg_pct\nORDER BY AVG_PERCENT_CHANGE ASC\nLIMIT 1;") t := by
