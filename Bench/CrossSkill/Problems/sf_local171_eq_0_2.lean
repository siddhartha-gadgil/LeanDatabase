CREATE TABLE LEGISLATORS («full_name» STRING, «first_name» STRING, «last_name» STRING, «middle_name» STRING, «nickname» STRING, «suffix» STRING, «other_names_end» STRING, «other_names_middle» STRING, «other_names_last» STRING, «birthday» STRING, «gender» STRING, «id_bioguide» STRING, «id_bioguide_previous_0» STRING, «id_govtrack» INT, «id_icpsr» FLOAT, «id_wikipedia» STRING, «id_wikidata» STRING, «id_google_entity_id» STRING, «id_house_history» FLOAT, «id_house_history_alternate» FLOAT, «id_thomas» FLOAT, «id_cspan» FLOAT, «id_votesmart» FLOAT, «id_lis» STRING, «id_ballotpedia» STRING, «id_opensecrets» STRING, «id_fec_0» STRING, «id_fec_1» STRING, «id_fec_2» STRING)
CREATE TABLE LEGISLATORS_TERMS («id_bioguide» STRING, «term_number» INT, «term_id» STRING, «term_type» STRING, «term_start» STRING, «term_end» STRING, «state» STRING, «district» FLOAT, «class» FLOAT, «party» STRING, «how» STRING, «url» STRING, «address» STRING, «phone» STRING, «fax» STRING, «contact_form» STRING, «office» STRING, «state_rank» STRING, «rss_url» STRING, «caucus» STRING)

theorem eq (t0 : TableRel LEGISLATORS_schema) (t1 : TableRel LEGISLATORS_TERMS_schema) :
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_terms AS (/* First term ACROSS ALL STATES for each male legislator */ SELECT t.\"id_bioguide\", MIN(CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE)) AS first_term_date FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON t.\"id_bioguide\" = l.\"id_bioguide\" WHERE l.\"gender\" = 'M' GROUP BY t.\"id_bioguide\"), year_range /* Generate years covering the full data range */ AS (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 1799 AS yr FROM TABLE(GENERATOR(250))), dec31_dates AS (SELECT yr, CAST(TO_TIMESTAMP(yr || '-12-31', 'YYYY-MM-DD') AS DATE) AS dec31 FROM year_range), actively_serving /* Find all male LA legislators actively serving on each Dec 31 */ AS (SELECT DISTINCT t.\"id_bioguide\", d.dec31, CAST(EXTRACT(year FROM AGE(CAST(d.dec31 AS TIMESTAMP), CAST(ft.first_term_date AS TIMESTAMP))) AS BIGINT) AS years_since_first_term FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON t.\"id_bioguide\" = l.\"id_bioguide\" JOIN first_terms AS ft ON t.\"id_bioguide\" = ft.\"id_bioguide\" JOIN dec31_dates AS d ON CAST(TO_TIMESTAMP(t.\"term_start\", 'YYYY-MM-DD') AS DATE) <= d.dec31 AND CAST(TO_TIMESTAMP(t.\"term_end\", 'YYYY-MM-DD') AS DATE) >= d.dec31 WHERE l.\"gender\" = 'M' AND t.\"state\" = 'LA'), years_range /* Generate all years_elapsed from 31 to 49 to include zeros */ AS (SELECT 30 + ROW_NUMBER() OVER (ORDER BY SEQ4()) AS years_elapsed FROM TABLE(GENERATOR(19))), counts /* Count distinct legislators per years_since_first_term */ AS (SELECT years_since_first_term, COUNT(DISTINCT \"id_bioguide\") AS cnt FROM actively_serving WHERE years_since_first_term > 30 AND years_since_first_term < 50 GROUP BY years_since_first_term) SELECT yr.years_elapsed AS YEARS_ELAPSED, COALESCE(c.cnt, 0) AS DISTINCT_LEGISLATORS_ACTIVE FROM years_range AS yr LEFT JOIN counts AS c ON yr.years_elapsed = c.years_since_first_term ORDER BY yr.years_elapsed") t0 t1
  ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH male_la_legislators AS (/* Male legislators who have at least one LA term */ SELECT DISTINCT l.\"id_bioguide\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON l.\"id_bioguide\" = t.\"id_bioguide\" WHERE l.\"gender\" = 'M' AND t.\"state\" = 'LA'), first_term AS (/* First term start for each male LA legislator (across all their terms) */ SELECT t.\"id_bioguide\", MIN(t.\"term_start\") AS first_term_start FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t WHERE t.\"id_bioguide\" IN (SELECT \"id_bioguide\" FROM male_la_legislators) GROUP BY t.\"id_bioguide\"), year_nums /* Generate a wide range of Dec 31 dates (1700-2020) */ AS (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 1699 AS yr FROM TABLE(GENERATOR(321))), dec31_dates AS (SELECT yr, yr || '-12-31' AS dec31_date FROM year_nums), active_on_dec31 AS (SELECT DISTINCT ft.\"id_bioguide\", d.dec31_date, d.yr - CAST(LEFT(ft.first_term_start, 4) AS INT) AS years_elapsed FROM first_term AS ft CROSS JOIN dec31_dates AS d JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON ft.\"id_bioguide\" = t.\"id_bioguide\" AND d.dec31_date >= t.\"term_start\" AND d.dec31_date <= t.\"term_end\"), active_counts AS (SELECT years_elapsed, COUNT(DISTINCT \"id_bioguide\") AS cnt FROM active_on_dec31 WHERE years_elapsed > 30 AND years_elapsed < 50 GROUP BY years_elapsed), year_series AS (SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) + 30 AS years_elapsed FROM TABLE(GENERATOR(19))) SELECT ys.years_elapsed AS \"YEARS_ELAPSED\", COALESCE(ac.cnt, 0) AS \"DISTINCT_LEGISLATORS_ACTIVE\" FROM year_series AS ys LEFT JOIN active_counts AS ac ON ys.years_elapsed = ac.years_elapsed ORDER BY ys.years_elapsed") t0 t1
