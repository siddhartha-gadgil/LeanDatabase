theorem eq_0_1 (t : TableRel CLEANED_WEEKLY_SALES_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) :
    (sql%([CLEANED_WEEKLY_SALES_schema]) "WITH before_after AS (SELECT \"region\", \"platform\", \"age_band\", \"demographic\", \"customer_type\", SUM(CASE WHEN \"week_date\" < '2020-06-15' THEN \"sales\" ELSE 0 END) AS before_sales, SUM(CASE WHEN \"week_date\" >= '2020-06-15' THEN \"sales\" ELSE 0 END) AS after_sales FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CLEANED_WEEKLY_SALES\" WHERE \"week_date\" >= '2020-03-23' AND \"week_date\" <= '2020-08-31' GROUP BY \"region\", \"platform\", \"age_band\", \"demographic\", \"customer_type\"), region_pct /* Compute pct change per attribute value for each attribute type */ AS (SELECT 'region' AS metric, \"region\" AS attr_value, CAST((SUM(after_sales) - SUM(before_sales)) * 100.0 AS DOUBLE PRECISION) / SUM(before_sales) AS pct_change FROM before_after GROUP BY \"region\"), platform_pct AS (SELECT 'platform' AS metric, \"platform\" AS attr_value, CAST((SUM(after_sales) - SUM(before_sales)) * 100.0 AS DOUBLE PRECISION) / SUM(before_sales) AS pct_change FROM before_after GROUP BY \"platform\"), age_band_pct AS (SELECT 'age_band' AS metric, \"age_band\" AS attr_value, CAST((SUM(after_sales) - SUM(before_sales)) * 100.0 AS DOUBLE PRECISION) / SUM(before_sales) AS pct_change FROM before_after GROUP BY \"age_band\"), demographic_pct AS (SELECT 'demographic' AS metric, \"demographic\" AS attr_value, CAST((SUM(after_sales) - SUM(before_sales)) * 100.0 AS DOUBLE PRECISION) / SUM(before_sales) AS pct_change FROM before_after GROUP BY \"demographic\"), customer_type_pct AS (SELECT 'customer_type' AS metric, \"customer_type\" AS attr_value, CAST((SUM(after_sales) - SUM(before_sales)) * 100.0 AS DOUBLE PRECISION) / SUM(before_sales) AS pct_change FROM before_after GROUP BY \"customer_type\"), all_pct AS (SELECT * FROM region_pct UNION ALL SELECT * FROM platform_pct UNION ALL SELECT * FROM age_band_pct UNION ALL SELECT * FROM demographic_pct UNION ALL SELECT * FROM customer_type_pct), avg_by_type AS (SELECT metric AS \"METRIC\", 