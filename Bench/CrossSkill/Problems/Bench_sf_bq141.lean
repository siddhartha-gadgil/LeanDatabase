import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq141 — crossskill equivalence(s)

Question: Using the TCGA-KIRP dataset, select patients from the 'TCGA_bioclin_v0.Clinical' table who have a non-null clinical_stage and a disease_code of 'KIRP.' Retrieve their gene expression data from the 'TCGA_hg38_data_v0.RNAseq_Gene_Expression' table for the genes 'MT-CO3,' 'MT-CO1,' and 'MT-CO2,' and randomly split the patients into a training set (90%) and a test set (10%) based on their case_barcode via the FARM_FINGERPRINT method. For each clinical stage in the training set, calculate the average HTSeq__FPKM_UQ expression of the three genes. For each patient in the test set, compute the Euclidean distance between the patient’s expression values and the stage-specific averages, and assign that patient to the clinical stage whose average is closest. Finally, output the case_barcode and the predicted clinical stage.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq141

CREATE TABLE CLINICAL («program_name» STRING, «case_barcode» STRING, «case_gdc_id» STRING, «program_dbgap_accession_number» STRING, «project_short_name» STRING, «project_name» STRING, «disease_code» STRING, «gender» STRING, «vital_status» STRING, «race» STRING, «ethnicity» STRING, «age_at_diagnosis» INT, «days_to_birth» INT, «days_to_death» INT, «days_to_initial_pathologic_diagnosis» INT, «days_to_last_followup» INT, «days_to_last_known_alive» INT, «days_to_submitted_specimen_dx» INT, «clinical_stage» STRING, «clinical_T» STRING, «clinical_N» STRING, «clinical_M» STRING, «pathologic_stage» STRING, «pathologic_T» STRING, «pathologic_N» STRING, «pathologic_M» STRING, «year_of_initial_pathologic_diagnosis» INT, «tumor_tissue_site» STRING, «primary_neoplasm_melanoma_dx» STRING, «anatomic_neoplasm_subdivision» STRING, «country» STRING, «other_dx» STRING, «other_malignancy_anatomic_site» STRING, «other_malignancy_type» STRING, «other_malignancy_histological_type» STRING, «history_of_neoadjuvant_treatment» STRING, «primary_therapy_outcome_success» STRING, «histological_type» STRING, «neoplasm_histologic_grade» STRING, «icd_10» STRING, «icd_o_3_site» STRING, «icd_o_3_histology» STRING, «person_neoplasm_cancer_status» STRING, «residual_tumor» STRING, «tumor_type» STRING, «new_tumor_event_after_initial_treatment» STRING, «lymphnodes_examined» STRING, «number_of_lymphnodes_examined» INT, «number_of_lymphnodes_positive_by_he» INT, «lymphatic_invasion» STRING, «venous_invasion» STRING, «lymphovascular_invasion_present» STRING, «bcr» STRING, «batch_number» INT, «tss_code» STRING, «age_began_smoking_in_years» INT, «year_of_tobacco_smoking_onset» INT, «stopped_smoking_year» INT, «tobacco_smoking_history» INT, «number_pack_years_smoked» FLOAT, «height» FLOAT, «weight» FLOAT, «bmi» FLOAT, «mononucleotide_and_dinucleotide_marker_panel_analysis_status» STRING, «menopause_status» STRING, «pregnancies» STRING, «hpv_status» STRING, «hpv_calls» STRING, «h_pylori_infection» STRING, «gleason_score_combined» INT, «psa_value» FLOAT, «colorectal_cancer» STRING, «history_of_colon_polyps» STRING)
CREATE TABLE RNASEQ_GENE_EXPRESSION («project_short_name» STRING, «case_barcode» STRING, «sample_barcode» STRING, «aliquot_barcode» STRING, «gene_name» STRING, «gene_type» STRING, «Ensembl_gene_id» STRING, «Ensembl_gene_id_v» STRING, «HTSeq__Counts» INT, «HTSeq__FPKM» FLOAT, «HTSeq__FPKM_UQ» FLOAT, «case_gdc_id» STRING, «sample_gdc_id» STRING, «aliquot_gdc_id» STRING, «file_gdc_id» STRING, «platform» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([CLINICAL_schema, RNASEQ_GENE_EXPRESSION_schema]) "WITH kirp_cases AS (\n    SELECT\n        c.\"case_barcode\",\n        c.\"clinical_stage\",\n        ABS(MOD(HASH(c.\"case_barcode\"), 10)) AS split_val\n    FROM \"TCGA_HG38_DATA_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\" c\n    WHERE c.\"disease_code\" = 'KIRP'\n      AND c.\"clinical_stage\" IS NOT NULL\n),\ngene_expr AS (\n    SELECT\n        r.\"case_barcode\",\n        MAX(CASE WHEN r.\"gene_name\" = 'MT-CO1' THEN r.\"HTSeq__FPKM_UQ\" END) AS co1,\n        MAX(CASE WHEN r.\"gene_name\" = 'MT-CO2' THEN r.\"HTSeq__FPKM_UQ\" END) AS co2,\n        MAX(CASE WHEN r.\"gene_name\" = 'MT-CO3' THEN r.\"HTSeq__FPKM_UQ\" END) AS co3\n    FROM \"TCGA_HG38_DATA_V0\".\"TCGA_HG38_DATA_V0\".\"RNASEQ_GENE_EXPRESSION\" r\n    WHERE r.\"project_short_name\" = 'TCGA-KIRP'\n      AND r.\"gene_name\" IN ('MT-CO1', 'MT-CO2', 'MT-CO3')\n    GROUP BY r.\"case_barcode\"\n),\nall_cases AS (\n    SELECT\n        kc.\"case_barcode\",\n        kc.\"clinical_stage\",\n        kc.split_val,\n        ge.co1,\n        ge.co2,\n        ge.co3\n    FROM kirp_cases kc\n    INNER JOIN gene_expr ge ON kc.\"case_barcode\" = ge.\"case_barcode\"\n),\ntrain_set AS (\n    SELECT * FROM all_cases WHERE split_val != 9\n),\ntest_set AS (\n    SELECT * FROM all_cases WHERE split_val = 9\n),\nstage_centroids AS (\n    SELECT\n        \"clinical_stage\",\n        AVG(co1) AS avg_co1,\n        AVG(co2) AS avg_co2,\n        AVG(co3) AS avg_co3\n    FROM train_set\n    GROUP BY \"clinical_stage\"\n),\ndistances AS (\n    SELECT\n        te.\"case_barcode\",\n        sc.\"clinical_stage\" AS predicted_stage,\n        SQRT(\n            COALESCE(POWER(te.co1 - sc.avg_co1, 2), 0) +\n            COALESCE(POWER(te.co2 - sc.avg_co2, 2), 0) +\n            COALESCE(POWER(te.co3 - sc.avg_co3, 2), 0)\n        ) AS distance\n    FROM test_set te\n    CROSS JOIN stage_centroids sc\n),\nranked AS (\n    SELECT\n        \"case_barcode\",\n        predicted_stage,\n        distance,\n        ROW_NUMBER() OVER (PARTITION BY \"case_barcode\" ORDER BY distance) AS rn\n    FROM distances\n)\nSELECT\n    \"case_barcode\" AS case_barcode,\n    predicted_stage AS predicted_stage\nFROM ranked\nWHERE rn = 1\nORDER BY case_barcode") t ~= (sql%([CLINICAL_schema, RNASEQ_GENE_EXPRESSION_schema]) "-- Step 1: Get training data (90%) - average HTSeq__FPKM_UQ per clinical_stage per gene\nWITH kirp_patients AS (\n    SELECT \"case_barcode\", \"clinical_stage\"\n    FROM \"TCGA_HG38_DATA_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\"\n    WHERE \"disease_code\" = 'KIRP'\n      AND \"clinical_stage\" IS NOT NULL\n),\ngene_expr AS (\n    SELECT r.\"case_barcode\", r.\"gene_name\", r.\"HTSeq__FPKM_UQ\"\n    FROM \"TCGA_HG38_DATA_V0\".\"TCGA_HG38_DATA_V0\".\"RNASEQ_GENE_EXPRESSION\" r\n    WHERE r.\"gene_name\" IN ('MT-CO3', 'MT-CO1', 'MT-CO2')\n      AND r.\"project_short_name\" = 'TCGA-KIRP'\n),\ncombined AS (\n    SELECT k.\"case_barcode\", k.\"clinical_stage\", g.\"gene_name\", g.\"HTSeq__FPKM_UQ\",\n           ABS(MOD(HASH(k.\"case_barcode\"), 10)) AS hash_mod\n    FROM kirp_patients k\n    JOIN gene_expr g ON k.\"case_barcode\" = g.\"case_barcode\"\n),\n-- Step 2: Compute training averages per stage per gene\ntrain_avg AS (\n    SELECT \"clinical_stage\", \"gene_name\", AVG(\"HTSeq__FPKM_UQ\") AS avg_expr\n    FROM combined\n    WHERE hash_mod != 9\n    GROUP BY \"clinical_stage\", \"gene_name\"\n),\n-- Pivot training averages: one row per stage with avg for each gene\ntrain_pivot AS (\n    SELECT \"clinical_stage\",\n           MAX(CASE WHEN \"gene_name\" = 'MT-CO1' THEN avg_expr END) AS avg_co1,\n           MAX(CASE WHEN \"gene_name\" = 'MT-CO2' THEN avg_expr END) AS avg_co2,\n           MAX(CASE WHEN \"gene_name\" = 'MT-CO3' THEN avg_expr END) AS avg_co3\n    FROM train_avg\n    GROUP BY \"clinical_stage\"\n),\n-- Step 3: Get test set gene expression, pivoted\ntest_patients AS (\n    SELECT \"case_barcode\",\n           MAX(CASE WHEN \"gene_name\" = 'MT-CO1' THEN \"HTSeq__FPKM_UQ\" END) AS co1,\n           MAX(CASE WHEN \"gene_name\" = 'MT-CO2' THEN \"HTSeq__FPKM_UQ\" END) AS co2,\n           MAX(CASE WHEN \"gene_name\" = 'MT-CO3' THEN \"HTSeq__FPKM_UQ\" END) AS co3\n    FROM combined\n    WHERE hash_mod = 9\n    GROUP BY \"case_barcode\"\n),\n-- Step 4: Compute Euclidean distance from each test patient to each stage\ndistances AS (\n    SELECT t.\"case_barcode\",\n           tr.\"clinical_stage\",\n           SQRT(\n               POWER(t.co1 - tr.avg_co1, 2) +\n               POWER(t.co2 - tr.avg_co2, 2) +\n               POWER(t.co3 - tr.avg_co3, 2)\n           ) AS distance\n    FROM test_patients t\n    CROSS JOIN train_pivot tr\n),\n-- Step 5: Find the closest stage for each test patient\nranked AS (\n    SELECT \"case_barcode\", \"clinical_stage\", distance,\n           ROW_NUMBER() OVER (PARTITION BY \"case_barcode\" ORDER BY distance ASC) AS rn\n    FROM distances\n)\nSELECT \"case_barcode\", \"clinical_stage\" AS predicted_stage\nFROM ranked\nWHERE rn = 1\nORDER BY \"case_barcode\";") t := by
  intro t; first | sql_equiv | sorry

end Bench_sf_bq141
