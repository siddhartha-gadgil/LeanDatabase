ted_answer\n    UNION\n    SELECT user_id, question_id, vc FROM answer_score_gt5\n    UNION\n    SELECT user_id, question_id, vc FROM answer_score_20pct\n    UNION\n    SELECT user_id, question_id, vc FROM answer_top3\n)\n\nSELECT \n    a.user_id,\n    u.\"display_name\",\n    SUM(a.vc) AS total_view_count\nFROM all_associations a\nJOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" u\n    ON a.user_id = u.\"id\"\nGROUP BY a.user_id, u.\"display_name\"\nORDER BY total_view_count DESC\nLIMIT 10;") t := by
