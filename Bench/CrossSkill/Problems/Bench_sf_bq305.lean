/-!
# sf_bq305 — crossskill equivalence(s)

Question: Which 10 users have the highest combined view counts for questions they are associated with, where a user is considered associated if they own the question, or their answer is the accepted answer, or their answer's score is greater than 5, or their answer's score exceeds 20% of the total answer scores for that question (and is above 0), or their answer is among the top three highest-scoring answers for that question?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq305

CREATE TABLE USERS («id» INT, «display_name» STRING, «about_me» STRING, «age» STRING, «creation_date» INT, «last_access_date» INT, «location» STRING, «reputation» INT, «up_votes» INT, «down_votes» INT, «views» INT, «profile_image_url» STRING, «website_url» STRING)
CREATE TABLE POSTS_ANSWERS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» STRING, «answer_count» STRING, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» STRING, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» INT, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» STRING)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

theorem eq_0_1 : ∀ t,
    (sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH answer_total_scores AS (\n    -- Pre-compute total answer scores per question\n    SELECT\n        \"parent_id\" AS question_id,\n        SUM(\"score\") AS total_score\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n    GROUP BY \"parent_id\"\n),\nanswer_ranks AS (\n    -- Pre-compute rank of each answer within its question\n    SELECT\n        \"id\" AS answer_id,\n        \"parent_id\" AS question_id,\n        \"owner_user_id\",\n        \"score\",\n        RANK() OVER (PARTITION BY \"parent_id\" ORDER BY \"score\" DESC) AS score_rank\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n    WHERE \"owner_user_id\" IS NOT NULL\n),\n-- Criterion 1: User owns the question\ncriterion1 AS (\n    SELECT\n        \"owner_user_id\" AS user_id,\n        \"id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\"\n    WHERE \"owner_user_id\" IS NOT NULL\n),\n-- Criterion 2: User's answer is the accepted answer\ncriterion2 AS (\n    SELECT\n        a.\"owner_user_id\" AS user_id,\n        q.\"id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n        ON q.\"accepted_answer_id\" = a.\"id\"\n    WHERE a.\"owner_user_id\" IS NOT NULL\n),\n-- Criterion 3: User's answer score > 5\ncriterion3 AS (\n    SELECT\n        ar.\"owner_user_id\" AS user_id,\n        ar.question_id\n    FROM answer_ranks ar\n    WHERE ar.\"score\" > 5\n),\n-- Criterion 4: User's answer score > 20% of total AND score > 0\ncriterion4 AS (\n    SELECT\n        ar.\"owner_user_id\" AS user_id,\n        ar.question_id\n    FROM answer_ranks ar\n    JOIN answer_total_scores ats ON ar.question_id = ats.question_id\n    WHERE ar.\"score\" > 0\n      AND ats.total_score > 0\n      AND ar.\"score\" > 0.2 * ats.total_score\n),\n-- Criterion 5: User's answer is among top 3 highest-scoring for that question\ncriterion5 AS (\n    SELECT\n        ar.\"owner_user_id\" AS user_id,\n        ar.question_id\n    FROM answer_ranks ar\n    WHERE ar.score_rank <= 3\n),\n-- Union all criteria (dedup user-question pairs)\nall_associations AS (\n    SELECT user_id, question_id FROM criterion1\n    UNION\n    SELECT user_id, question_id FROM criterion2\n    UNION\n    SELECT user_id, question_id FROM criterion3\n    UNION\n    SELECT user_id, question_id FROM criterion4\n    UNION\n    SELECT user_id, question_id FROM criterion5\n),\n-- Sum view counts per user\nuser_views AS (\n    SELECT\n        a.user_id,\n        SUM(q.\"view_count\") AS TOTAL_VIEW_COUNT\n    FROM all_associations a\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q ON a.question_id = q.\"id\"\n    GROUP BY a.user_id\n)\nSELECT\n    uv.user_id AS USER_ID,\n    u.\"display_name\",\n    uv.TOTAL_VIEW_COUNT\nFROM user_views uv\nJOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" u ON uv.user_id = u.\"id\"\nORDER BY uv.TOTAL_VIEW_COUNT DESC\nLIMIT 10;") t ~= (sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "-- Find top 10 users by combined view counts of questions they are associated with.\n-- A user is associated with a question if ANY of 5 criteria hold.\n-- Use UNION to deduplicate (user_id, question_id) pairs across all criteria.\n\nWITH associated AS (\n    -- Criterion 1: User owns the question\n    SELECT q.\"owner_user_id\" AS user_id, q.\"id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    WHERE q.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 2: User's answer is the accepted answer for the question\n    SELECT a.\"owner_user_id\" AS user_id, q.\"id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n        ON q.\"accepted_answer_id\" = a.\"id\"\n    WHERE a.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 3: User has provided an answer with score > 5\n    SELECT a.\"owner_user_id\" AS user_id, a.\"parent_id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n    WHERE a.\"score\" > 5\n      AND a.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 4: Answer score > 20% of total answer scores for the question AND score > 0\n    SELECT a.\"owner_user_id\" AS user_id, a.\"parent_id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n    JOIN (\n        SELECT \"parent_id\", SUM(\"score\") AS total_score\n        FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n        GROUP BY \"parent_id\"\n    ) ts ON a.\"parent_id\" = ts.\"parent_id\"\n    WHERE a.\"score\" > 0\n      AND a.\"score\" > 0.2 * ts.total_score\n      AND a.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 5: Answer is among top 3 highest-scoring answers for the question\n    SELECT sub.user_id, sub.question_id\n    FROM (\n        SELECT a.\"owner_user_id\" AS user_id,\n               a.\"parent_id\" AS question_id,\n               DENSE_RANK() OVER (PARTITION BY a.\"parent_id\" ORDER BY a.\"score\" DESC) AS rnk\n        FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n        WHERE a.\"owner_user_id\" IS NOT NULL\n    ) sub\n    WHERE sub.rnk <= 3\n),\n\n-- Sum view counts of distinct associated questions per user\nuser_views AS (\n    SELECT \n        assoc.user_id,\n        SUM(q.\"view_count\") AS TOTAL_VIEW_COUNT\n    FROM associated assoc\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n        ON assoc.question_id = q.\"id\"\n    GROUP BY assoc.user_id\n)\n\nSELECT \n    uv.user_id AS USER_ID,\n    u.\"display_name\",\n    uv.TOTAL_VIEW_COUNT\nFROM user_views uv\nJOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" u\n    ON uv.user_id = u.\"id\"\nORDER BY uv.TOTAL_VIEW_COUNT DESC\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

