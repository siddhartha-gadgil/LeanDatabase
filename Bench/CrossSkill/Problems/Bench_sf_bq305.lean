RFLOW\".\"POSTS_QUESTIONS\" q\n        ON a.\"parent_id\" = q.\"id\"\n    WHERE a.\"score\" > 5\n      AND a.\"owner_user_id\" IS NOT NULL\n),\n\ntotal_scores AS (\n    SELECT \n        \"parent_id\",\n        SUM(\"score\") AS total_score\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n    GROUP BY \"parent_id\"\n),\n\nanswer_score_20pct AS (\n    -- Criterion 4: User's answer score exceeds 20% of total answer scores (and > 0)\n    SELECT \n        a.\"owner_user_id\" AS user_id,\n        a.\"parent_id\" AS question_id,\n        q.\"view_count\" AS vc\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n        ON a.\"parent_id\" = q.\"id\"\n    JOIN total_scores ts\n        ON a.\"parent_id\" = ts.\"parent_id\"\n    WHERE a.\"score\" > 0\n      AND ts.total_score > 0\n      AND a.\"score\" > 0.2 * ts.total_score\n      AND a.\"owner_user_id\" IS NOT NULL\n),\n\nranked_answers AS (\n    SELECT \n        \"owner_user_id\",\n        \"parent_id\",\n        \"score\",\n        \"id\",\n        ROW_NUMBER() OVER (PARTITION BY \"parent_id\" ORDER BY \"score\" DESC, \"id\" ASC) AS rn\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n    WHERE \"owner_user_id\" IS NOT NULL\n),\n\nanswer_top3 AS (\n    -- Criterion 5: User's answer is among top 3 highest-scoring answers\n    SELECT \n        ra.\"owner_user_id\" AS user_id,\n        ra.\"parent_id\" AS question_id,\n        q.\"view_count\" AS vc\n    FROM ranked_answers ra\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n        ON ra.\"parent_id\" = q.\"id\"\n    WHERE ra.rn <= 3\n),\n\nall_associations AS (\n    SELECT user_id, question_id, vc FROM question_owner\n    UNION\n    SELECT user_id, question_id, vc FROM accepted_answer\n    UNION\n    SELECT user_id, question_id, vc FROM answer_score_gt5\n    UNION\n    SELECT user_id, question_id, vc FROM answer_score_20pct\n    UNION\n    SE