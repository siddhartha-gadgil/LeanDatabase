theorem eq_1_2 : ∀ t,
    (sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "-- Find top 10 users by combined view counts of questions they are associated with.\n-- A user is associated with a question if ANY of 5 criteria hold.\n-- Use UNION to deduplicate (user_id, question_id) pairs across all criteria.\n\nWITH associated AS (\n    -- Criterion 1: User owns the question\n    SELECT q.\"owner_user_id\" AS user_id, q.\"id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    WHERE q.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 2: User's answer is the accepted answer for the question\n    SELECT a.\"owner_user_id\" AS user_id, q.\"id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n        ON q.\"accepted_answer_id\" = a.\"id\"\n    WHERE a.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 3: User has provided an answer with score > 5\n    SELECT a.\"owner_user_id\" AS user_id, a.\"parent_id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n    WHERE a.\"score\" > 5\n      AND a.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 4: Answer score > 20% of total answer scores for the question AND score > 0\n    SELECT a.\"owner_user_id\" AS user_id, a.\"parent_id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n    JOIN (\n        SELECT \"parent_id\", SUM(\"score\") AS total_score\n        FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n        GROUP BY \"parent_id\"\n    ) ts ON a.\"parent_id\" = ts.\"parent_id\"\n    WHERE a.\"score\" > 0\n      AND a.\"score\" > 0.2 * ts.total_score\n      AND a.\"owner_user_id\" IS NOT NULL\n\n    UNION\n\n    -- Criterion 5: Answer is among top 3 highest-scoring answers for the question\n    SELECT sub.user_id, sub.question_id\n    FROM (\n        SELECT a.\"owner_user_id\" AS user_id,\n               a.\"parent_id\" AS question_id,\n               DENSE_RANK() OVER (PARTITION BY a.\"parent_id\" ORDER BY a.\"score\" DESC) AS rnk\n        FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n        WHERE a.\"owner_user_id\" IS NOT NULL\n    ) sub\n    WHERE sub.rnk <= 3\n),\n\n-- Sum view counts of distinct associated questions per user\nuser_views AS (\n    SELECT \n        assoc.user_id,\n        SUM(q.\"view_count\") AS TOTAL_VIEW_COUNT\n    FROM associated assoc\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n        ON assoc.question_id = q.\"id\"\n    GROUP BY assoc.user_id\n)\n\nSELECT \n    uv.user_id AS USER_ID,\n    u.\"display_name\",\n    uv.TOTAL_VIEW_COUNT\nFROM user_views uv\nJOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" u\n    ON uv.user_id = u.\"id\"\nORDER BY uv.TOTAL_VIEW_COUNT DESC\nLIMIT 10;") t ~= (sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH answer_stats AS (\n    SELECT\n        a.\"id\" AS answer_id,\n        a.\"owner_user_id\" AS answerer_user_id,\n        a.\"parent_id\" AS question_id,\n        a.\"score\" AS answer_score,\n        SUM(a.\"score\") OVER (PARTITION BY a.\"parent_id\") AS total_answer_score,\n        ROW_NUMBER() OVER (PARTITION BY a.\"parent_id\" ORDER BY a.\"score\" DESC) AS score_rank\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n),\nassoc_owner AS (\n    SELECT\n        q.\"owner_user_id\" AS user_id,\n        q.\"id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    WHERE q.\"owner_user_id\" IS NOT NULL\n),\nassoc_accepted AS (\n    SELECT\n        a.\"owner_user_id\" AS user_id,\n        a.\"parent_id\" AS question_id\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n        ON q.\"accepted_answer_id\" = a.\"id\"\n    WHERE a.\"owner_user_id\" IS NOT NULL\n),\nassoc_score_gt5 AS (\n    SELECT\n        answerer_user_id AS user_id,\n        question_id\n    FROM answer_stats\n    WHERE answer_score > 5\n      AND answerer_user_id IS NOT NULL\n),\nassoc_score_pct AS (\n    SELECT\n        answerer_user_id AS user_id,\n        question_id\n    FROM answer_stats\n    WHERE answer_score > 0\n      AND total_answer_score > 0\n      AND answer_score > 0.2 * total_answer_score\n      AND answerer_user_id IS NOT NULL\n),\nassoc_top3 AS (\n    SELECT\n        answerer_user_id AS user_id,\n        question_id\n    FROM answer_stats\n    WHERE score_rank <= 3\n      AND answerer_user_id IS NOT NULL\n),\nall_assoc AS (\n    SELECT user_id, question_id FROM assoc_owner\n    UNION\n    SELECT user_id, question_id FROM assoc_accepted\n    UNION\n    SELECT user_id, question_id FROM assoc_score_gt5\n    UNION\n    SELECT user_id, question_id FROM assoc_score_pct\n    UNION\n    SELECT user_id, question_id FROM assoc_top3\n)\nSELECT\n    a.user_id AS \"USER_ID\",\n    u.\"display_name\" AS \"display_name\",\n    SUM(q.\"view_count\") AS \"TOTAL_VIEW_COUNT\"\nFROM all_assoc a\nJOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    ON a.question_id = q.\"id\"\nJOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" u\n    ON a.user_id = u.\"id\"\nGROUP BY a.user_id, u.\"display_name\"\nORDER BY \"TOTAL_VIEW_COUNT\" DESC\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

