import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local020 — crossskill equivalence(s)

Question: Which bowler has the lowest bowling average per wicket taken?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local020

CREATE TABLE PLAYER («player_id» INT, «player_name» STRING, «dob» STRING, «batting_hand» STRING, «bowling_skill» STRING, «country_name» STRING)
CREATE TABLE BATSMAN_SCORED («match_id» INT, «over_id» INT, «ball_id» INT, «runs_scored» INT, «innings_no» INT)
CREATE TABLE WICKET_TAKEN («match_id» INT, «over_id» INT, «ball_id» INT, «player_out» INT, «kind_out» STRING, «innings_no» INT)
CREATE TABLE BALL_BY_BALL («match_id» INT, «over_id» INT, «ball_id» INT, «innings_no» INT, «team_batting» INT, «team_bowling» INT, «striker_batting_position» INT, «striker» INT, «non_striker» INT, «bowler» INT)
CREATE TABLE EXTRA_RUNS («match_id» INT, «over_id» INT, «ball_id» INT, «extra_type» STRING, «extra_runs» INT, «innings_no» INT)

theorem eq_0_1 : ∀ t,
    (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema]) "SELECT p.\"player_name\" AS \"OUTPUT\"\nFROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\nJOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n  ON b.\"match_id\" = bs.\"match_id\"\n  AND b.\"over_id\" = bs.\"over_id\"\n  AND b.\"ball_id\" = bs.\"ball_id\"\n  AND b.\"innings_no\" = bs.\"innings_no\"\nLEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n  ON b.\"match_id\" = w.\"match_id\"\n  AND b.\"over_id\" = w.\"over_id\"\n  AND b.\"ball_id\" = w.\"ball_id\"\n  AND b.\"innings_no\" = w.\"innings_no\"\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p\n  ON b.\"bowler\" = p.\"player_id\"\nGROUP BY b.\"bowler\", p.\"player_name\"\nHAVING COUNT(DISTINCT CASE WHEN w.\"match_id\" IS NOT NULL\n    THEN CONCAT(w.\"match_id\", '-', w.\"over_id\", '-', w.\"ball_id\", '-', w.\"innings_no\") END) > 0\nORDER BY SUM(bs.\"runs_scored\") * 1.0 \n    / COUNT(DISTINCT CASE WHEN w.\"match_id\" IS NOT NULL\n    THEN CONCAT(w.\"match_id\", '-', w.\"over_id\", '-', w.\"ball_id\", '-', w.\"innings_no\") END) ASC\nLIMIT 1;") t ~= (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema]) "WITH bowler_runs AS (\n    SELECT bb.\"bowler\", SUM(bs.\"runs_scored\") AS total_runs\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" bb\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n      ON bb.\"match_id\" = bs.\"match_id\"\n      AND bb.\"over_id\" = bs.\"over_id\"\n      AND bb.\"ball_id\" = bs.\"ball_id\"\n      AND bb.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY bb.\"bowler\"\n),\nbowler_wickets AS (\n    SELECT bb.\"bowler\", COUNT(*) AS total_wickets\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" bb\n    JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n      ON bb.\"match_id\" = wt.\"match_id\"\n      AND bb.\"over_id\" = wt.\"over_id\"\n      AND bb.\"ball_id\" = wt.\"ball_id\"\n      AND bb.\"innings_no\" = wt.\"innings_no\"\n    GROUP BY bb.\"bowler\"\n)\nSELECT p.\"player_name\" AS \"OUTPUT\"\nFROM bowler_runs br\nJOIN bowler_wickets bw ON br.\"bowler\" = bw.\"bowler\"\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p ON br.\"bowler\" = p.\"player_id\"\nORDER BY br.total_runs * 1.0 / bw.total_wickets ASC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema]) "SELECT p.\"player_name\" AS \"OUTPUT\"\nFROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\nJOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n  ON b.\"match_id\" = bs.\"match_id\"\n  AND b.\"over_id\" = bs.\"over_id\"\n  AND b.\"ball_id\" = bs.\"ball_id\"\n  AND b.\"innings_no\" = bs.\"innings_no\"\nLEFT JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n  ON b.\"match_id\" = w.\"match_id\"\n  AND b.\"over_id\" = w.\"over_id\"\n  AND b.\"ball_id\" = w.\"ball_id\"\n  AND b.\"innings_no\" = w.\"innings_no\"\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p\n  ON b.\"bowler\" = p.\"player_id\"\nGROUP BY b.\"bowler\", p.\"player_name\"\nHAVING COUNT(DISTINCT CASE WHEN w.\"match_id\" IS NOT NULL\n    THEN CONCAT(w.\"match_id\", '-', w.\"over_id\", '-', w.\"ball_id\", '-', w.\"innings_no\") END) > 0\nORDER BY SUM(bs.\"runs_scored\") * 1.0 \n    / COUNT(DISTINCT CASE WHEN w.\"match_id\" IS NOT NULL\n    THEN CONCAT(w.\"match_id\", '-', w.\"over_id\", '-', w.\"ball_id\", '-', w.\"innings_no\") END) ASC\nLIMIT 1;") t ~= (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema]) "WITH runs_conceded AS (\n    SELECT\n        b.\"bowler\" AS player_id,\n        SUM(bs.\"runs_scored\") AS bat_runs\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" bs\n        ON b.\"match_id\" = bs.\"match_id\"\n        AND b.\"over_id\" = bs.\"over_id\"\n        AND b.\"ball_id\" = bs.\"ball_id\"\n        AND b.\"innings_no\" = bs.\"innings_no\"\n    GROUP BY b.\"bowler\"\n),\nextras_conceded AS (\n    SELECT\n        b.\"bowler\" AS player_id,\n        SUM(e.\"extra_runs\") AS extra_runs_total\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"EXTRA_RUNS\" e\n        ON b.\"match_id\" = e.\"match_id\"\n        AND b.\"over_id\" = e.\"over_id\"\n        AND b.\"ball_id\" = e.\"ball_id\"\n        AND b.\"innings_no\" = e.\"innings_no\"\n    WHERE e.\"extra_type\" NOT IN ('legbyes', 'byes')\n    GROUP BY b.\"bowler\"\n),\nwickets AS (\n    SELECT\n        b.\"bowler\" AS player_id,\n        COUNT(*) AS total_wickets\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" b\n    JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" w\n        ON b.\"match_id\" = w.\"match_id\"\n        AND b.\"over_id\" = w.\"over_id\"\n        AND b.\"ball_id\" = w.\"ball_id\"\n        AND b.\"innings_no\" = w.\"innings_no\"\n    WHERE w.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n    GROUP BY b.\"bowler\"\n),\nbowling_avg AS (\n    SELECT\n        w.player_id,\n        (COALESCE(r.bat_runs, 0) + COALESCE(e.extra_runs_total, 0)) * 1.0 / w.total_wickets AS bowling_average\n    FROM wickets w\n    LEFT JOIN runs_conceded r ON w.player_id = r.player_id\n    LEFT JOIN extras_conceded e ON w.player_id = e.player_id\n    WHERE w.total_wickets > 0\n)\nSELECT p.\"player_name\" AS \"OUTPUT\"\nFROM bowling_avg ba\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p ON ba.player_id = p.\"player_id\"\nORDER BY ba.bowling_average ASC\nLIMIT 1;") t := by
