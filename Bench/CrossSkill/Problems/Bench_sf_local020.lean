        AND bb.\"over_id\" = er.\"over_id\"\n        AND bb.\"ball_id\" = er.\"ball_id\"\n        AND bb.\"innings_no\" = er.\"innings_no\"\n    WHERE er.\"extra_type\" IN ('wides', 'noballs')\n    GROUP BY bb.\"bowler\"\n),\nwickets AS (\n    -- Wickets credited to the bowler (excluding run out, retired hurt, obstructing the field)\n    SELECT\n        bb.\"bowler\" AS bowler_id,\n        COUNT(*) AS total_wickets\n    FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" bb\n    JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" wt\n        ON bb.\"match_id\" = wt.\"match_id\"\n        AND bb.\"over_id\" = wt.\"over_id\"\n        AND bb.\"ball_id\" = wt.\"ball_id\"\n        AND bb.\"innings_no\" = wt.\"innings_no\"\n    WHERE wt.\"kind_out\" NOT IN ('run out', 'retired hurt', 'obstructing the field')\n    GROUP BY bb.\"bowler\"\n)\nSELECT\n    p.\"player_name\"\nFROM runs_conceded rc\nJOIN wickets w ON rc.bowler_id = w.bowler_id\nLEFT JOIN extras_conceded ec ON rc.bowler_id = ec.bowler_id\nJOIN \"IPL\".\"IPL\".\"PLAYER\" p ON rc.bowler_id = p.\"player_id\"\nWHERE w.total_wickets > 0\nORDER BY (rc.batsman_runs + COALESCE(ec.extra_runs, 0)) * 1.0 / w.total_wickets ASC\nLIMIT 1;") t := by
