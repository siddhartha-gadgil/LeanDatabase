import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq426 — crossskill equivalence(s)

Question: What user type recorded the highest average temperature for trips starting and ending in New York City's zip code 10019 during 2018? Include average precipitation, wind speed, and temperature for that user type based on weather data from the New York Central Park station.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq426

CREATE TABLE ZIP_CODES («zip» INT, «borough» STRING, «neighborhood» STRING)
CREATE TABLE CITIBIKE_TRIPS («tripduration» INT, «starttime» INT, «stoptime» INT, «start_station_id» INT, «start_station_name» STRING, «start_station_latitude» FLOAT, «start_station_longitude» FLOAT, «end_station_id» INT, «end_station_name» STRING, «end_station_latitude» FLOAT, «end_station_longitude» FLOAT, «bikeid» INT, «usertype» STRING, «birth_year» INT, «gender» STRING, «customer_plan» STRING)
CREATE TABLE GSOD2018 («stn» STRING, «wban» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([ZIP_CODES_schema, CITIBIKE_TRIPS_schema, GSOD2018_schema]) "WITH zip_geom AS (\n  SELECT TO_GEOGRAPHY(\"zip_code_geom\") AS geom\n  FROM \"NEW_YORK_CITIBIKE_1\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n  WHERE \"zip_code\" = '10019'\n),\ntrips_in_zip AS (\n  SELECT\n    t.\"usertype\",\n    TO_TIMESTAMP(t.\"starttime\" / 1000000) AS trip_ts,\n    LPAD(CAST(EXTRACT(MONTH FROM TO_TIMESTAMP(t.\"starttime\" / 1000000)) AS VARCHAR), 2, '0') AS trip_mo,\n    LPAD(CAST(EXTRACT(DAY FROM TO_TIMESTAMP(t.\"starttime\" / 1000000)) AS VARCHAR), 2, '0') AS trip_da\n  FROM \"NEW_YORK_CITIBIKE_1\".\"NEW_YORK_CITIBIKE\".\"CITIBIKE_TRIPS\" t\n  CROSS JOIN zip_geom z\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(t.\"starttime\" / 1000000)) = 2018\n    AND t.\"usertype\" IS NOT NULL\n    AND ST_WITHIN(ST_MAKEPOINT(t.\"start_station_longitude\", t.\"start_station_latitude\"), z.geom)\n    AND ST_WITHIN(ST_MAKEPOINT(t.\"end_station_longitude\", t.\"end_station_latitude\"), z.geom)\n),\ntrip_weather AS (\n  SELECT\n    tr.\"usertype\",\n    w.\"prcp\",\n    w.\"wdsp\",\n    w.\"temp\"\n  FROM trips_in_zip tr\n  JOIN \"NEW_YORK_CITIBIKE_1\".\"NOAA_GSOD\".\"GSOD2018\" w\n    ON w.\"stn\" = '725053'\n    AND w.\"wban\" = '94728'\n    AND w.\"mo\" = tr.trip_mo\n    AND w.\"da\" = tr.trip_da\n),\nuser_avgs AS (\n  SELECT\n    \"usertype\",\n    AVG(\"prcp\") AS AVG_PRECIPITATION,\n    AVG(\"wdsp\") AS AVG_WIND_SPEED,\n    AVG(\"temp\") AS AVG_TEMPERATURE\n  FROM trip_weather\n  GROUP BY \"usertype\"\n)\nSELECT\n  \"usertype\",\n  AVG_PRECIPITATION,\n  AVG_WIND_SPEED,\n  AVG_TEMPERATURE\nFROM user_avgs\nORDER BY AVG_TEMPERATURE DESC\nLIMIT 1;") t ~= (sql%([ZIP_CODES_schema, CITIBIKE_TRIPS_schema, GSOD2018_schema]) "WITH trips_in_zip AS (\n  SELECT \n    t.\"usertype\",\n    CAST(YEAR(TO_TIMESTAMP(t.\"starttime\" / 1000000)) AS VARCHAR) AS yr,\n    LPAD(CAST(MONTH(TO_TIMESTAMP(t.\"starttime\" / 1000000)) AS VARCHAR), 2, '0') AS mn,\n    LPAD(CAST(DAY(TO_TIMESTAMP(t.\"starttime\" / 1000000)) AS VARCHAR), 2, '0') AS dy\n  FROM \"NEW_YORK_CITIBIKE_1\".\"NEW_YORK_CITIBIKE\".\"CITIBIKE_TRIPS\" t\n  CROSS JOIN \"NEW_YORK_CITIBIKE_1\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" z\n  WHERE z.\"zip_code\" = '10019'\n    AND ST_WITHIN(ST_MAKEPOINT(t.\"start_station_longitude\", t.\"start_station_latitude\"), TO_GEOGRAPHY(z.\"zip_code_geom\"))\n    AND ST_WITHIN(ST_MAKEPOINT(t.\"end_station_longitude\", t.\"end_station_latitude\"), TO_GEOGRAPHY(z.\"zip_code_geom\"))\n    AND t.\"starttime\" IS NOT NULL\n    AND YEAR(TO_TIMESTAMP(t.\"starttime\" / 1000000)) = 2018\n),\nuser_weather AS (\n  SELECT \n    tz.\"usertype\",\n    AVG(CAST(w.\"prcp\" AS FLOAT)) AS AVG_PRECIPITATION,\n    AVG(CAST(w.\"wdsp\" AS FLOAT)) AS AVG_WIND_SPEED,\n    AVG(CAST(w.\"temp\" AS FLOAT)) AS AVG_TEMPERATURE\n  FROM trips_in_zip tz\n  JOIN \"NEW_YORK_CITIBIKE_1\".\"NOAA_GSOD\".\"GSOD2018\" w\n    ON w.\"stn\" = '725053' \n    AND w.\"wban\" = '94728'\n    AND w.\"year\" = tz.yr \n    AND w.\"mo\" = tz.mn \n    AND w.\"da\" = tz.dy\n  GROUP BY tz.\"usertype\"\n)\nSELECT \n  \"usertype\",\n  AVG_PRECIPITATION,\n  AVG_WIND_SPEED,\n  AVG_TEMPERATURE\nFROM user_weather\nORDER BY AVG_TEMPERATURE DESC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

