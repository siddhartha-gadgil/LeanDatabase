theorem eq_2_3 :
    sql%([ZIP_CODES_schema, CITIBIKE_TRIPS_schema, GSOD2018_schema]) "WITH zip_geom AS (\n  SELECT \"zip_code_geom\"\n  FROM \"NEW_YORK_CITIBIKE_1\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n  WHERE \"zip_code\" = '10019'\n),\ntrips_in_zip AS (\n  SELECT\n    t.\"usertype\",\n    TO_DATE(TO_TIMESTAMP(t.\"starttime\" / 1000000)) AS trip_date\n  FROM \"NEW_YORK_CITIBIKE_1\".\"NEW_YORK_CITIBIKE\".\"CITIBIKE_TRIPS\" t,\n       zip_geom z\n  WHERE t.\"usertype\" IS NOT NULL\n    AND YEAR(TO_TIMESTAMP(t.\"starttime\" / 1000000)) = 2018\n    AND ST_WITHIN(\n          ST_POINT(t.\"start_station_longitude\", t.\"start_station_latitude\"),\n          TO_GEOGRAPHY(z.\"zip_code_geom\")\n        )\n    AND ST_WITHIN(\n          ST_POINT(t.\"end_station_longitude\", t.\"end_station_latitude\"),\n          TO_GEOGRAPHY(z.\"zip_code_geom\")\n        )\n),\nweather AS (\n  SELECT\n    CAST(\"year\" AS INT) AS yr,\n    CAST(\"mo\" AS INT) AS mo,\n    CAST(\"da\" AS INT) AS da,\n    DATE_FROM_PARTS(CAST(\"year\" AS INT), CAST(\"mo\" AS INT), CAST(\"da\" AS INT)) AS weather_date,\n    CASE WHEN CAST(\"prcp\" AS FLOAT) >= 99.99 THEN NULL ELSE CAST(\"prcp\" AS FLOAT) END AS precipitation,\n    CASE WHEN CAST(\"wdsp\" AS FLOAT) >= 999.9 THEN NULL ELSE CAST(\"wdsp\" AS FLOAT) END AS wind_speed,\n    CASE WHEN CAST(\"temp\" AS FLOAT) >= 9999.9 THEN NULL ELSE CAST(\"temp\" AS FLOAT) END AS temperature\n  FROM \"NEW_YORK_CITIBIKE_1\".\"NOAA_GSOD\".\"GSOD2018\"\n  WHERE \"stn\" = '725053'\n    AND \"wban\" = '94728'\n),\ntrip_weather AS (\n  SELECT\n    t.\"usertype\",\n    w.precipitation,\n    w.wind_speed,\n    w.temperature\n  FROM trips_in_zip t\n  JOIN weather w ON t.trip_date = w.weather_date\n)\nSELECT\n  \"usertype\" AS \"usertype\",\n  ROUND(AVG(precipitation), 2) AS \"AVG_PRECIPITATION\",\n  ROUND(AVG(wind_speed), 2) AS \"AVG_WIND_SPEED\",\n  ROUND(AVG(temperature), 2) AS \"AVG_TEMPERATURE\"\nFROM trip_weather\nGROUP BY \"usertype\"\nORDER BY \"AVG_TEMPERATURE\" DESC\nLIMIT 1;" = sql%([ZIP_CODES_schema, CITIBIKE_TRIPS_schema, GSOD2018_schema]) "WITH zip_geom AS (\n  SELECT \"zip_code_geom\"\n  FROM \"NEW_YORK_CITIBIKE_1\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\"\n  WHERE \"zip_code\" = '10019'\n),\ntrips_in_zip AS (\n  SELECT\n    t.\"usertype\",\n    TO_DATE(TO_TIMESTAMP(t.\"starttime\", 6)) AS trip_date\n  FROM \"NEW_YORK_CITIBIKE_1\".\"NEW_YORK_CITIBIKE\".\"CITIBIKE_TRIPS\" t,\n       zip_geom z\n  WHERE YEAR(TO_TIMESTAMP(t.\"starttime\", 6)) = 2018\n    AND t.\"start_station_latitude\" IS NOT NULL\n    AND t.\"end_station_latitude\" IS NOT NULL\n    AND t.\"usertype\" IS NOT NULL\n    AND t.\"usertype\" != ''\n    AND ST_WITHIN(\n          ST_MAKEPOINT(t.\"start_station_longitude\", t.\"start_station_latitude\"),\n          TO_GEOGRAPHY(z.\"zip_code_geom\")\n        )\n    AND ST_WITHIN(\n          ST_MAKEPOINT(t.\"end_station_longitude\", t.\"end_station_latitude\"),\n          TO_GEOGRAPHY(z.\"zip_code_geom\")\n        )\n),\nweather AS (\n  SELECT\n    TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS weather_date,\n    \"temp\",\n    \"prcp\",\n    \"wdsp\"\n  FROM \"NEW_YORK_CITIBIKE_1\".\"NOAA_GSOD\".\"GSOD2018\"\n  WHERE \"stn\" = '725053'\n    AND \"wban\" = '94728'\n),\njoined AS (\n  SELECT\n    t.\"usertype\",\n    w.\"temp\",\n    w.\"prcp\",\n    w.\"wdsp\"\n  FROM trips_in_zip t\n  JOIN weather w ON t.trip_date = w.weather_date\n)\nSELECT\n  \"usertype\",\n  AVG(\"prcp\") AS AVG_PRECIPITATION,\n  AVG(\"wdsp\") AS AVG_WIND_SPEED,\n  AVG(\"temp\") AS AVG_TEMPERATURE\nFROM joined\nGROUP BY \"usertype\"\nORDER BY AVG_TEMPERATURE DESC\nLIMIT 1;" := by
