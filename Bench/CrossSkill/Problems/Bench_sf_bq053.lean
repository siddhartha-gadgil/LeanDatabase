/-!
# sf_bq053 — crossskill equivalence(s)

Question: Calculate the change in the number of living trees of each fall color in New York City from 1995 to 2015 by computing, for each tree species, the difference between the number of trees not marked as dead in 1995 and the number of trees alive in 2015, matching species by the uppercase form of their scientific names from the tree_species table. Then, group the species by their fall color and sum these differences to determine the total change in the number of trees for each fall color.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq053

CREATE TABLE TREE_CENSUS_1995 («recordid» INT, «address» STRING, «house_number» STRING, «street» STRING, «zip_original» INT, «cb_original» INT, «site» STRING, «species» STRING, «diameter» INT, «status» STRING, «wires» STRING, «sidewalk_condition» STRING, «support_structure» STRING, «borough» STRING, «x» FLOAT, «y» FLOAT, «longitude» FLOAT, «latitude» FLOAT, «cb_new» INT, «zip_new» INT, «censustract_2010» STRING, «censusblock_2010» STRING, «nta_2010» STRING, «segmentid» INT, «spc_common» STRING, «spc_latin» STRING, «location» STRING)
CREATE TABLE TREE_CENSUS_2015 («tree_id» INT, «block_id» INT, «created_at» STRING, «tree_dbh» INT, «stump_diam» INT, «curb_loc» STRING, «status» STRING, «health» STRING, «spc_latin» STRING, «spc_common» STRING, «steward» STRING, «guards» STRING, «sidewalk» STRING, «user_type» STRING, «problems» STRING, «root_stone» STRING, «root_grate» STRING, «root_other» STRING, «trunk_wire» STRING, «trnk_light» STRING, «trnk_other» STRING, «brch_light» STRING, «brch_shoe» STRING, «brch_other» STRING, «address» STRING, «zipcode» INT, «zip_city» STRING, «cb_num» INT, «borocode» INT, «boroname» STRING, «cncldist» INT, «st_assem» INT, «st_senate» INT, «nta» STRING, «nta_name» STRING, «boro_ct» INT, «state» STRING, «latitude» FLOAT, «longitude» FLOAT, «x_sp» FLOAT, «y_sp» FLOAT)
CREATE TABLE TREE_SPECIES («species_scientific_name» STRING, «species_common_name» STRING, «form» STRING, «growth_rate» STRING, «fall_color» STRING, «environmental_tolerances» STRING, «location_tolerances» STRING, «notes_suggested_cultivars» STRING, «tree_size» STRING, «comments» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([TREE_CENSUS_1995_schema, TREE_CENSUS_2015_schema, TREE_SPECIES_schema]) "WITH sp_1995 AS (SELECT UPPER(\"spc_latin\") AS species_upper, COUNT(*) AS cnt_1995 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_1995\" WHERE \"status\" <> 'Dead' AND NOT \"spc_latin\" IS NULL AND \"spc_latin\" <> '' GROUP BY UPPER(\"spc_latin\")), sp_2015 AS (SELECT UPPER(\"spc_latin\") AS species_upper, COUNT(*) AS cnt_2015 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_2015\" WHERE \"status\" = 'Alive' AND NOT \"spc_latin\" IS NULL AND \"spc_latin\" <> '' GROUP BY UPPER(\"spc_latin\")), ts AS (SELECT UPPER(\"species_scientific_name\") AS species_upper, \"fall_color\" FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_SPECIES\") SELECT ts.\"fall_color\", SUM(COALESCE(sp_2015.cnt_2015, 0) - COALESCE(sp_1995.cnt_1995, 0)) AS change FROM ts LEFT JOIN sp_1995 ON ts.species_upper = sp_1995.species_upper LEFT JOIN sp_2015 ON ts.species_upper = sp_2015.species_upper WHERE NOT sp_1995.species_upper IS NULL OR NOT sp_2015.species_upper IS NULL GROUP BY ts.\"fall_color\" ORDER BY change DESC" = sql%([TREE_CENSUS_1995_schema, TREE_CENSUS_2015_schema, TREE_SPECIES_schema]) "WITH species_1995 AS (SELECT UPPER(t95.\"spc_latin\") AS species_upper, COUNT(*) AS cnt_1995 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_1995\" AS t95 WHERE t95.\"status\" <> 'Dead' GROUP BY UPPER(t95.\"spc_latin\")), species_2015 AS (SELECT UPPER(t15.\"spc_latin\") AS species_upper, COUNT(*) AS cnt_2015 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_2015\" AS t15 WHERE t15.\"status\" = 'Alive' GROUP BY UPPER(t15.\"spc_latin\")), species_diff AS (SELECT COALESCE(s15.species_upper, s95.species_upper) AS species_upper, COALESCE(s15.cnt_2015, 0) - COALESCE(s95.cnt_1995, 0) AS diff FROM species_2015 AS s15 FULL OUTER JOIN species_1995 AS s95 ON s15.species_upper = s95.species_upper) SELECT ts.\"fall_color\" AS fall_color, SUM(sd.diff) AS change FROM species_diff AS sd JOIN \"NEW_YORK\".\"NEW_YORK\".\"TREE_SPECIES\" AS ts ON sd.species_upper = UPPER(ts.\"species_scientific_name\") GROUP BY ts.\"fall_color\" HAVING SUM(sd.diff) > 0 ORDER BY change DESC" := by
  first | sql_equiv | sorry

