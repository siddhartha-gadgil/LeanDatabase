import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq162_eq_1_3

CREATE TABLE IMAGING_LEVEL2_METADATA_R5 («Pyramid» STRING, «Channel_Metadata_Filename» STRING, «Frame_Averaging» STRING, «PlaneCount» STRING, «PhysicalSizeXUnit» STRING, «MERFISH_Codebook_File» STRING, «Objective» STRING, «DimensionOrder» STRING, «WorkingDistanceUnit» STRING, «Image_ID» STRING, «HTAN_Data_File_ID» STRING, «Component» STRING, «FOVX» STRING, «Imaging_Assay_Type» STRING, «Comment» STRING, «FOV_number» STRING, «FOVY» STRING, «Zstack» STRING, «SizeC» STRING, «PhysicalSizeY» STRING, «SizeX» STRING, «HTAN_Parent_Data_File_ID» STRING, «HTAN_Parent_Biospecimen_ID» STRING, «Passed_QC» STRING, «Filename» STRING, «PhysicalSizeX» STRING, «Microscope» STRING, «entityId» STRING, «SizeT» STRING, «PixelType» STRING, «PhysicalSizeZ» STRING, «Protocol_Link» STRING, «SizeY» STRING, «Pixels_BigEndian» STRING, «HTAN_Participant_ID» STRING, «PhysicalSizeYUnit» STRING, «FOVYUnit» STRING, «LensNA» STRING, «NominalMagnification» STRING, «SizeZ» STRING, «Id» STRING, «Immersion» STRING, «FOVXUnit» STRING, «PhysicalSizeZUnit» STRING, «MERFISH_Positions_File» STRING, «WorkingDistance» STRING, «Tseries» STRING, «Software_and_Version» STRING, «File_Format» STRING, «HTAN_Center» STRING, «Manifest_Id» STRING, «Manifest_Version» INT, «File_Size» INT, «md5» STRING, «Data_Release» STRING, «CDS_Release» STRING)
CREATE TABLE ID_PROVENANCE_R5 («HTAN_DATA_FILE_ID» STRING, «FILENAME» STRING, «ENTITYID» STRING, «COMPONENT» STRING, «DATA_RELEASE» STRING, «CDS_RELEASE» STRING, «HTAN_CENTER» STRING, «HTAN_ASSAYED_BIOSPECIMEN_ID» STRING, «HTAN_PARENT_DATA_FILE_ID» STRING, «HTAN_ORIGINATING_BIOSPECIMEN_ID» STRING, «HTAN_PARTICIPANT_ID» STRING, «BIOSPECIMEN_PATH» STRING)

theorem eq (t0 : TableRel IMAGING_LEVEL2_METADATA_R5_schema) (t1 : TableRel ID_PROVENANCE_R5_schema) :
    (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH imaging_data AS (/* Get all WUSTL imaging records from id_provenance_r5, excluding NULL/Auxiliary/OtherAssay components */ /* and excluding Level1 */ SELECT p.\"ENTITYID\", p.\"HTAN_DATA_FILE_ID\", p.\"COMPONENT\", p.\"HTAN_CENTER\", p.\"HTAN_PARENT_DATA_FILE_ID\" FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS p WHERE p.\"HTAN_CENTER\" = 'HTAN WUSTL' AND NOT p.\"COMPONENT\" IS NULL AND NOT p.\"COMPONENT\" LIKE '%Auxiliary%' AND NOT p.\"COMPONENT\" LIKE '%OtherAssay%' AND p.\"COMPONENT\" IN ('ImagingLevel2', 'ImagingLevel3Segmentation', 'ImagingLevel4')), level2_assays /* Join Level2 records with imaging_level2_metadata to get assay types */ AS (SELECT DISTINCT m.\"Imaging_Assay_Type\", id.\"HTAN_CENTER\", id.\"HTAN_DATA_FILE_ID\" FROM imaging_data AS id JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" AS m ON id.\"ENTITYID\" = m.\"entityId\" WHERE id.\"COMPONENT\" = 'ImagingLevel2' AND m.\"Imaging_Assay_Type\" <> 'Electron Microscopy'), level3_exists /* Check for Level3 children */ AS (SELECT DISTINCT l2.\"Imaging_Assay_Type\" FROM level2_assays AS l2 JOIN imaging_data AS l3 ON l3.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" WHERE l3.\"COMPONENT\" = 'ImagingLevel3Segmentation'), level4_exists /* Check for Level4 children (derived from Level3 or Level2) */ AS (SELECT DISTINCT l2.\"Imaging_Assay_Type\" FROM level2_assays AS l2 JOIN imaging_data AS l3 ON l3.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" JOIN imaging_data AS l4 ON l4.\"HTAN_PARENT_DATA_FILE_ID\" = l3.\"HTAN_DATA_FILE_ID\" WHERE l3.\"COMPONENT\" = 'ImagingLevel3Segmentation' AND l4.\"COMPONENT\" = 'ImagingLevel4'), assay_levels /* Build results */ AS (SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_CENTER\", 'Level2' AS base_level, CASE WHEN NOT l3.\"Imaging_Assay_Type\" IS NULL THEN TRUE ELSE FALSE END AS has_level3, CASE WHEN NOT l4.\"Imaging_Assay_Type\" IS NULL THEN TRUE ELSE FALSE END AS has_level4 FROM level2_assays AS l2 LEFT JOIN level3_exists AS l3 ON l2.\"Imaging_Assay_Type\" = l3.\"Imaging_Assay_Type\" LEFT JOIN level4_exists AS l4 ON l2.\"Imaging_Assay_Type\" = l4.\"Imaging_Assay_Type\") SELECT \"Imaging_Assay_Type\", \"HTAN_CENTER\" AS \"HTAN_Center\", CASE WHEN has_level3 AND has_level4 THEN 'Level2, Level3, Level4' WHEN has_level3 THEN 'Level2, Level3' WHEN has_level4 THEN 'Level2, Level4' ELSE 'Level2' END AS \"AVAILABLE_DATA_LEVELS\" FROM assay_levels ORDER BY \"Imaging_Assay_Type\"") t0 t1
  ~= (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH level2_files AS (/* Get Level2 imaging data for WUSTL, excluding Electron Microscopy */ SELECT DISTINCT m.\"Imaging_Assay_Type\", m.\"HTAN_Center\", p.\"HTAN_DATA_FILE_ID\", p.\"COMPONENT\" FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" AS m INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS p ON m.\"HTAN_Data_File_ID\" = p.\"HTAN_DATA_FILE_ID\" WHERE m.\"HTAN_Center\" = 'HTAN WUSTL' AND m.\"Imaging_Assay_Type\" <> 'Electron Microscopy' AND NOT p.\"COMPONENT\" IS NULL AND NOT p.\"COMPONENT\" IN ('Auxiliary', 'OtherAssay')), all_levels /* Find all imaging levels: Level2 from the files themselves, plus Level3/4 derived from them */ AS (/* Level2 data */ SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_Center\", CASE WHEN l2.\"COMPONENT\" LIKE '%Level2%' THEN 'Level2' WHEN l2.\"COMPONENT\" LIKE '%Level3%' THEN 'Level3' WHEN l2.\"COMPONENT\" LIKE '%Level4%' THEN 'Level4' END AS DATA_LEVEL FROM level2_files AS l2 WHERE NOT l2.\"COMPONENT\" LIKE '%Level1%' UNION /* Level3/4 data derived from Level2 */ SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_Center\", CASE WHEN child.\"COMPONENT\" LIKE '%Level2%' THEN 'Level2' WHEN child.\"COMPONENT\" LIKE '%Level3%' THEN 'Level3' WHEN child.\"COMPONENT\" LIKE '%Level4%' THEN 'Level4' END AS DATA_LEVEL FROM level2_files AS l2 INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS child ON child.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" WHERE NOT child.\"COMPONENT\" IS NULL AND NOT child.\"COMPONENT\" IN ('Auxiliary', 'OtherAssay') AND NOT child.\"COMPONENT\" LIKE '%Level1%') SELECT \"Imaging_Assay_Type\", \"HTAN_Center\", STRING_AGG(DISTINCT DATA_LEVEL, ', ' ORDER BY DATA_LEVEL) AS \"AVAILABLE_DATA_LEVELS\" FROM all_levels WHERE NOT DATA_LEVEL IS NULL GROUP BY \"Imaging_Assay_Type\", \"HTAN_Center\" ORDER BY \"Imaging_Assay_Type\"") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq162_eq_1_3
