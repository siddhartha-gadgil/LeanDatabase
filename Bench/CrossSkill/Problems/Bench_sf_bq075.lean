import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq075 — crossskill equivalence(s)

Question: Could you provide a combined 2021 report comparing racial (Asian, Black, Hispanic/Latinx, White) and gender (U.S. Women, U.S. Men) distributions across Google’s overall workforce hiring, Google’s overall workforce representation, and the BLS data specifically for the technology sectors defined as Internet publishing and broadcasting and web search portals or Computer systems design and related services?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq075

CREATE TABLE CPSAAT18 («year» INT, «sector» STRING, «subsector» STRING, «industry_group» STRING, «industry» STRING, «total_employed_in_thousands» INT, «percent_women» FLOAT, «percent_white» FLOAT, «percent_black_or_african_american» FLOAT, «percent_asian» FLOAT, «percent_hispanic_or_latino» FLOAT)
CREATE TABLE DAR_NON_INTERSECTIONAL_REPRESENTATION («workforce» STRING, «report_year» INT, «race_asian» FLOAT, «race_black» FLOAT, «race_hispanic_latinx» FLOAT, «race_native_american» FLOAT, «race_white» FLOAT, «gender_us_women» FLOAT, «gender_us_men» FLOAT, «gender_global_women» FLOAT, «gender_global_men» FLOAT)
CREATE TABLE DAR_NON_INTERSECTIONAL_HIRING («workforce» STRING, «report_year» INT, «race_asian» FLOAT, «race_black» FLOAT, «race_hispanic_latinx» FLOAT, «race_native_american» FLOAT, «race_white» FLOAT, «gender_us_women» FLOAT, «gender_us_men» FLOAT, «gender_global_women» FLOAT, «gender_global_men» FLOAT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([CPSAAT18_schema, DAR_NON_INTERSECTIONAL_REPRESENTATION_schema, DAR_NON_INTERSECTIONAL_HIRING_schema]) "WITH representation AS (\n    SELECT \n        '2021 Google Workforce Representation' AS data_source,\n        \"race_asian\",\n        \"race_black\",\n        \"race_hispanic_latinx\",\n        \"race_white\",\n        \"gender_us_women\",\n        \"gender_us_men\"\n    FROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_REPRESENTATION\"\n    WHERE \"report_year\" = 2021 AND \"workforce\" = 'overall'\n),\nhiring AS (\n    SELECT \n        '2021 Google Hiring' AS data_source,\n        \"race_asian\",\n        \"race_black\",\n        \"race_hispanic_latinx\",\n        \"race_white\",\n        \"gender_us_women\",\n        \"gender_us_men\"\n    FROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_HIRING\"\n    WHERE \"report_year\" = 2021 AND \"workforce\" = 'overall'\n),\nbls AS (\n    SELECT \n        CASE \n            WHEN \"subsector\" = 'Internet publishing and broadcasting and web search portals' \n                THEN '2021 BLS Industry - Internet publishing and broadcasting and web search portals'\n            WHEN \"industry_group\" = 'Computer systems design and related services' \n                THEN '2021 BLS Industry - Computer systems design and related services'\n        END AS data_source,\n        \"percent_asian\" AS race_asian,\n        \"percent_black_or_african_american\" AS race_black,\n        \"percent_hispanic_or_latino\" AS race_hispanic_latinx,\n        \"percent_white\" AS race_white,\n        \"percent_women\" AS gender_us_women,\n        1 - \"percent_women\" AS gender_us_men\n    FROM \"GOOGLE_DEI\".\"BLS\".\"CPSAAT18\"\n    WHERE \"year\" = 2021 \n    AND (\"subsector\" = 'Internet publishing and broadcasting and web search portals'\n         OR \"industry_group\" = 'Computer systems design and related services')\n)\nSELECT * FROM representation\nUNION ALL\nSELECT * FROM hiring\nUNION ALL\nSELECT * FROM bls\nORDER BY CASE data_source\n    WHEN '2021 Google Workforce Representation' THEN 1\n    WHEN '2021 Google Hiring' THEN 2\n    WHEN '2021 BLS Industry - Internet publishing and broadcasting and web search portals' THEN 3\n    WHEN '2021 BLS Industry - Computer systems design and related services' THEN 4\nEND;" = sql%([CPSAAT18_schema, DAR_NON_INTERSECTIONAL_REPRESENTATION_schema, DAR_NON_INTERSECTIONAL_HIRING_schema]) "-- Google overall workforce representation (2021)\nSELECT\n  '2021 Google Workforce Representation' AS data_source,\n  \"race_asian\",\n  \"race_black\",\n  \"race_hispanic_latinx\",\n  \"race_white\",\n  \"gender_us_women\",\n  \"gender_us_men\"\nFROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_REPRESENTATION\"\nWHERE \"report_year\" = 2021\n  AND \"workforce\" = 'overall'\n\nUNION ALL\n\n-- Google overall workforce hiring (2021)\nSELECT\n  '2021 Google Hiring' AS data_source,\n  \"race_asian\",\n  \"race_black\",\n  \"race_hispanic_latinx\",\n  \"race_white\",\n  \"gender_us_women\",\n  \"gender_us_men\"\nFROM \"GOOGLE_DEI\".\"GOOGLE_DEI\".\"DAR_NON_INTERSECTIONAL_HIRING\"\nWHERE \"report_year\" = 2021\n  AND \"workforce\" = 'overall'\n\nUNION ALL\n\n-- BLS: Internet publishing and broadcasting and web search portals (2021)\nSELECT\n  '2021 BLS Industry - Internet publishing and broadcasting and web search portals' AS data_source,\n  \"percent_asian\" AS race_asian,\n  \"percent_black_or_african_american\" AS race_black,\n  \"percent_hispanic_or_latino\" AS race_hispanic_latinx,\n  \"percent_white\" AS race_white,\n  \"percent_women\" AS gender_us_women,\n  ROUND(1 - \"percent_women\", 3) AS gender_us_men\nFROM \"GOOGLE_DEI\".\"BLS\".\"CPSAAT18\"\nWHERE \"year\" = 2021\n  AND \"subsector\" = 'Internet publishing and broadcasting and web search portals'\n\nUNION ALL\n\n-- BLS: Computer systems design and related services (2021)\nSELECT\n  '2021 BLS Industry - Computer systems design and related services' AS data_source,\n  \"percent_asian\" AS race_asian,\n  \"percent_black_or_african_american\" AS race_black,\n  \"percent_hispanic_or_latino\" AS race_hispanic_latinx,\n  \"percent_white\" AS race_white,\n  \"percent_women\" AS gender_us_women,\n  ROUND(1 - \"percent_women\", 3) AS gender_us_men\nFROM \"GOOGLE_DEI\".\"BLS\".\"CPSAAT18\"\nWHERE \"year\" = 2021\n  AND \"industry_group\" = 'Computer systems design and related services'" := by
  first | sql_equiv | sorry

