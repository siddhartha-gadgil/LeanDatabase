(*) AS word_cnt\n  FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" n,\n  LATERAL FLATTEN(input => REGEXP_SUBSTR_ALL(\n    REGEXP_REPLACE(REGEXP_REPLACE(n.\"body\", '''s([^a-zA-Z0-9_])', '\\\\1'), '''', ''),\n    '[a-zA-Z0-9_]+'\n  )) f\n  WHERE n.\"id\" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'\n    AND LOWER(f.VALUE::STRING) NOT IN (SELECT word FROM stopwords)\n  GROUP BY LOWER(f.VALUE::STRING)\n),\ntarget_weighted AS (\n  SELECT vi.INDEX AS dim_idx,\n    SUM(vi.VALUE::FLOAT * tt.word_cnt / POWER(wf.\"frequency\", 0.4)) AS weighted_sum\n  FROM target_tokens tt\n  JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"GLOVE_VECTORS\" g ON tt.word = g.\"word\"\n  JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"WORD_FREQUENCIES\" wf ON tt.word = wf.\"word\",\n  LATERAL FLATTEN(input => g.\"vector\") vi\n  GROUP BY vi.INDEX\n),\ntarget_mag AS (\n  SELECT SQRT(SUM(weighted_sum * weighted_sum)) AS magnitude FROM target_weighted\n),\ntarget_norm AS (\n  SELECT tw.dim_idx, tw.weighted_sum / tm.magnitude AS norm_val\n  FROM target_weighted tw\n  CROSS JOIN target_mag tm\n),\n-- Step 2: Tokenize all other articles, lowercase tokens, aggregate by (article, word)\nall_tokens AS (\n  SELECT n.\"id\", n.\"date\", n.\"title\",\n    LOWER(f.VALUE::STRING) AS word, COUNT(*) AS word_cnt\n  FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" n,\n  LATERAL FLATTEN(input => REGEXP_SUBSTR_ALL(\n    REGEXP_REPLACE(REGEXP_REPLACE(n.\"body\", '''s([^a-zA-Z0-9_])', '\\\\1'), '''', ''),\n    '[a-zA-Z0-9_]+'\n  )) f\n  WHERE n.\"id\" != '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'\n    AND LOWER(f.VALUE::STRING) NOT IN (SELECT word FROM stopwords)\n  GROUP BY n.\"id\", n.\"date\", n.\"title\", LOWER(f.VALUE::STRING)\n),\n-- Step 3: Flatten vectors, compute weighted sums per article per dimension\narticle_components AS (\n  SELECT\n    at.\"id\",\n    at.\"date\",\n    at.\"title\",\n    vi.INDEX AS dim_idx,\n    SUM(vi.VALUE::FLOAT * at.word_cnt / POWER(wf.\"frequency\", 0.4)) AS weighted_sum\n  FROM all_tokens at\n  JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"GLOVE_VECTORS\" g ON at.word = g.\"word\"\n  JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"WORD_FREQUENCIES\" wf ON at.word = wf.\"word\",\n  LATERAL FLATTEN(input => g.\"vector\") vi\n  GROUP BY at.\"id\", at.\"date\", at.\"title\", vi.INDEX\n),\n-- Step 4: Compute dot product with target and magnitude for each article\narticle_stats AS (\n  SELECT\n    ac.\"id\",\n    ac.\"date\",\n    ac.\"title\",\n    SUM(ac.weighted_sum * tn.norm_val) AS dot_product,\n    SQRT(SUM(ac.weighted_sum * ac.weighted_sum)) AS magnitude\n  FROM article_components ac\n  JOIN target_norm tn ON ac.dim_idx = tn.dim_idx\n  GROUP BY ac.\"id\", ac.\"date\", ac.\"title\"\n)\n-- Step 5: Cosine similarity = dot_product / magnitude (target already unit-normalized)\nSELECT\n  \"id\",\n  \"date\",\n  \"title\",\n  dot_product / magnitude AS \"COSINE_SIMILARITY\"\nFROM article_stats\nWHERE magnitude > 0\nORDER BY \"COSINE_SIMILARITY\" DESC\nLIMIT 10;") t ~= (sql%([NATURE_schema, WORD_FREQUENCIES_schema, GLOVE_VECTORS_schema]) "WITH article_words AS (\n  SELECT n.\"id\" AS article_id, f.value::STRING AS word, COUNT(*) AS cnt\n  FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" n,\n  LATERAL FLATTEN(INPUT => SPLIT(REGEXP_REPLACE(LOWER(n.\"body\"), '[^a-z0-9 ]', ' '), ' ')) f\n  WHERE TRIM(f.value::STRING) != ''\n  AND f.value::STRING NOT IN (\n    'the','of','and','in','to','a','is','that','for','it',\n    'are','was','as','with','be','on','not','this','by','from',\n    'or','an','at','but','can','has','have','we','which','they',\n    'been','were','these','its','also','more','than','their','will','other',\n    'about','had','into','after','do','may','would','between','only','over',\n    'such','them','our','when','most','there','no','if','so','up',\n    'what','could','did','should','each','then','does','how','many','some',\n    'her','him','his','my','out','all','she','he','who','where',\n    'just','very','down','much','th