8+v219*v219+\n            v220*v220+v221*v221+v222*v222+v223*v223+v224*v224+v225*v225+v226*v226+v227*v227+v228*v228+v229*v229+\n            v230*v230+v231*v231+v232*v232+v233*v233+v234*v234+v235*v235+v236*v236+v237*v237+v238*v238+v239*v239+\n            v240*v240+v241*v241+v242*v242+v243*v243+v244*v244+v245*v245+v246*v246+v247*v247+v248*v248+v249*v249+\n            v250*v250+v251*v251+v252*v252+v253*v253+v254*v254+v255*v255+v256*v256+v257*v257+v258*v258+v259*v259+\n            v260*v260+v261*v261+v262*v262+v263*v263+v264*v264+v265*v265+v266*v266+v267*v267+v268*v268+v269*v269+\n            v270*v270+v271*v271+v272*v272+v273*v273+v274*v274+v275*v275+v276*v276+v277*v277+v278*v278+v279*v279+\n            v280*v280+v281*v281+v282*v282+v283*v283+v284*v284+v285*v285+v286*v286+v287*v287+v288*v288+v289*v289+\n            v290*v290+v291*v291+v292*v292+v293*v293+v294*v294+v295*v295+v296*v296+v297*v297+v298*v298+v299*v299\n        ) AS magnitude\n    FROM article_vectors\n),\n\n-- Get target article vector\ntarget AS (\n    SELECT * FROM article_vectors_norm WHERE \"id\" = '8a78ef2d-d5f7-4d2d-9b47-5adb25cbd373'\n),\n\n-- Compute cosine similarity between target and all other articles\ncosine_sim AS (\n    SELECT\n        a.\"id\",\n        a.\"date\",\n        a.\"title\",\n        (\n            a.v0*t.v0+a.v1*t.v1+a.v2*t.v2+a.v3*t.v3+a.v4*t.v4+a.v5*t.v5+a.v6*t.v6+a.v7*t.v7+a.v8*t.v8+a.v9*t.v9+\n            a.v10*t.v10+a.v11*t.v11+a.v12*t.v12+a.v13*t.v13+a.v14*t.v14+a.v15*t.v15+a.v16*t.v16+a.v17*t.v17+a.v18*t.v18+a.v19*t.v19+\n            a.v20*t.v20+a.v21*t.v21+a.v22*t.v22+a.v23*t.v23+a.v24*t.v24+a.v25*t.v25+a.v26*t.v26+a.v27*t.v27+a.v28*t.v28+a.v29*t.v29+\n            a.v30*t.v30+a.v31*t.v31+a.v32*t.v32+a.v33*t.v33+a.v34*t.v34+a.v35*t.v35+a.v36*t.v36+a.v37*t.v37+a.v38*t.v38+a.v39*t.v39+\n            a.v40*t.v40+a.v41*t.v41+a.v42*t.v42+a.v43*t.v43+a.v44*t.v44+a.v45*t.v45+a.v46*t.v46+a.v47*t.v47+a.v48*t.v48+a.v49*t.v49+\n            a.v50*t.v50+a.v51*t.v51+a.v52*t.v52+a.v53*t.