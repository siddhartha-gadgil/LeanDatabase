theorem eq_1_2 : ∀ t,
    (sql%([NATURE_schema, WORD_FREQUENCIES_schema, GLOVE_VECTORS_schema]) "WITH article_words AS (\n  SELECT n.\"id\" AS article_id, f.value::STRING AS word, COUNT(*) AS cnt\n  FROM \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"NATURE\" n,\n  LATERAL FLATTEN(INPUT => SPLIT(REGEXP_REPLACE(LOWER(n.\"body\"), '[^a-z0-9 ]', ' '), ' ')) f\n  WHERE TRIM(f.value::STRING) != ''\n  AND f.value::STRING NOT IN (\n    'the','of','and','in','to','a','is','that','for','it',\n    'are','was','as','with','be','on','not','this','by','from',\n    'or','an','at','but','can','has','have','we','which','they',\n    'been','were','these','its','also','more','than','their','will','other',\n    'about','had','into','after','do','may','would','between','only','over',\n    'such','them','our','when','most','there','no','if','so','up',\n    'what','could','did','should','each','then','does','how','many','some',\n    'her','him','his','my','out','all','she','he','who','where',\n    'just','very','down','much','through','before','new','well','way','because',\n    'any','while','here','own','both','few','get','same','back','those',\n    'now','long','made','two','one','under','during','still','using','used',\n    'however','first','another','found','several','known','within','often','among','per',\n    'without','since','around','three','even','further','although','against','along'\n  )\n  GROUP BY n.\"id\", f.value::STRING\n),\nweighted_dims AS (\n  SELECT aw.article_id, vf.index AS dim,\n    SUM(aw.cnt * vf.value::FLOAT / POW(wf.\"frequency\", 0.4)) AS dim_val\n  FROM article_words aw\n  JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"GLOVE_VECTORS\" g ON g.\"word\" = aw.word\n  JOIN \"WORD_VECTORS_US\".\"WORD_VECTORS_US\".\"WORD_FREQUENCIES\" wf ON wf.\"word\" = aw.word,\n  LATERAL FLATTEN(INPUT => g.\"vector\") vf\n  GROUP BY aw.article_id, vf.index\n),\narticle_vecs AS (\n  SELECT article_id,\n    ARRAY_AGG(dim_val) WITHIN GROUP (ORDER BY dim) AS vec\n  FROM weighted_dims\n  GROUP BY article_id\n