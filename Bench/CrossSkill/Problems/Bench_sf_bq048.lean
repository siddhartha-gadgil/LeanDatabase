ve and negative\nranked AS (\n    SELECT \n        complaint_type,\n        \"CORRELATION\",\n        ROW_NUMBER() OVER (ORDER BY \"CORRELATION\" DESC) AS pos_rank,\n        ROW_NUMBER() OVER (ORDER BY \"CORRELATION\" ASC) AS neg_rank\n    FROM correlations\n)\n\nSELECT complaint_type, \"CORRELATION\"\nFROM ranked\nWHERE pos_rank = 1 OR neg_rank = 1\nORDER BY \"CORRELATION\" DESC;") t := by
