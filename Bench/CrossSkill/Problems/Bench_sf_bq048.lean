theorem eq_0_1 :
    sql%([_311_SERVICE_REQUESTS_schema, GSOD2019_schema, GSOD2013_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2020_schema, GSOD2014_schema, GSOD2016_schema, GSOD2017_schema, GSOD2018_schema]) "WITH wind_data AS (\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt, CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2018\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2019\" WHERE \"stn\" = '744860'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD'), CAST(\"wdsp\" AS FLOAT)\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2020\" WHERE \"stn\" = '744860'\n),\n\ncomplaints_raw AS (\n    SELECT\n        TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) AS dt,\n        \"complaint_type\"\n    FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\"\n    WHERE TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) BETWEEN '2011-01-01' AND '2020-12-31'\n),\n\n-- Filter to complaint types with > 3000 total requests\nqualifying_types AS (\n    SELECT \"complaint_type\"\n    FROM complaints_raw\n    GROUP BY \"complaint_type\"\n    HAVING COUNT(*) > 3000\n),\n\n-- Daily total complaints\ndaily_totals AS (\n    SELECT dt, COUNT(*) AS total_complaints\n    FROM complaints_raw\n    GROUP BY dt\n),\n\n-- Daily complaint counts per qualifying type\ndaily_type_counts AS (\n    SELECT c.dt, c.\"complaint_type\", COUNT(*) AS type_count\n    FROM complaints_raw c\n    INNER JOIN qualifying_types q ON c.\"complaint_type\" = q.\"complaint_type\"\n    GROUP BY c.dt, c.\"complaint_type\"\n),\n\n-- Daily complaint proportions\ndaily_proportions AS (\n    SELECT\n        dtc.dt,\n        dtc.\"complaint_type\",\n        dtc.type_count::FLOAT / dt.total_complaints::FLOAT AS proportion\n    FROM daily_type_counts dtc\n    INNER JOIN daily_totals dt ON dtc.dt = dt.dt\n),\n\n-- Join with wind data and compute correlations\ncorrelations AS (\n    SELECT\n        dp.\"complaint_type\",\n        ROUND(CORR(dp.proportion, w.wdsp), 4) AS CORRELATION\n    FROM daily_proportions dp\n    INNER JOIN wind_data w ON dp.dt = w.dt\n    GROUP BY dp.\"complaint_type\"\n)\n\n-- Get the strongest positive and negative correlations\nSELECT \"complaint_type\", CORRELATION\nFROM (\n    SELECT \"complaint_type\", CORRELATION\n    FROM correlations\n    ORDER BY CORRELATION DESC\n    LIMIT 1\n)\nUNION ALL\nSELECT \"complaint_type\", CORRELATION\nFROM (\n    SELECT \"complaint_type\", CORRELATION\n    FROM correlations\n    ORDER BY CORRELATION ASC\n    LIMIT 1\n);" = sql%([_311_SERVICE_REQUESTS_schema, GSOD2019_schema, GSOD2013_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2020_schema, GSOD2014_schema, GSOD2016_schema, GSOD2017_schema, GSOD2018_schema]) "WITH weather AS (\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2018\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2019\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n           CAST(\"wdsp\" AS FLOAT) AS wdsp\n    FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2020\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n),\n\ndaily_totals AS (\n    SELECT TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) AS dt,\n           COUNT(*) AS total_complaints\n    FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\"\n    WHERE TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) BETWEEN '2011-01-01' AND '2020-12-31'\n    GROUP BY dt\n),\n\ndaily_type_counts AS (\n    SELECT TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) AS dt,\n           \"complaint_type\",\n           COUNT(*) AS type_count\n    FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\"\n    WHERE TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) BETWEEN '2011-01-01' AND '2020-12-31'\n    GROUP BY dt, \"complaint_type\"\n),\n\nqualifying_types AS (\n    SELECT \"complaint_type\"\n    FROM daily_type_counts\n    GROUP BY \"complaint_type\"\n    HAVING SUM(type_count) > 3000\n),\n\ndaily_proportions AS (\n    SELECT dtc.dt,\n           dtc.\"complaint_type\",\n           dtc.type_count::FLOAT / dt_tot.total_complaints::FLOAT AS proportion\n    FROM daily_type_counts dtc\n    JOIN daily_totals dt_tot ON dtc.dt = dt_tot.dt\n    JOIN qualifying_types qt ON dtc.\"complaint_type\" = qt.\"complaint_type\"\n),\n\njoined AS (\n    SELECT dp.dt,\n           dp.\"complaint_type\",\n           dp.proportion,\n           w.wdsp\n    FROM daily_proportions dp\n    JOIN weather w ON dp.dt = w.dt\n),\n\ncorrelations AS (\n    SELECT \"complaint_type\",\n           ROUND(CORR(proportion, wdsp), 4) AS \"CORRELATION\"\n    FROM joined\n    GROUP BY \"complaint_type\"\n),\n\nranked AS (\n    SELECT \"complaint_type\",\n           \"CORRELATION\",\n           ROW_NUMBER() OVER (ORDER BY \"CORRELATION\" DESC) AS pos_rank,\n           ROW_NUMBER() OVER (ORDER BY \"CORRELATION\" ASC) AS neg_rank\n    FROM correlations\n)\n\nSELECT \"complaint_type\", \"CORRELATION\"\nFROM ranked\nWHERE pos_rank = 1 OR neg_rank = 1\nORDER BY \"CORRELATION\" DESC;" := by
  first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
