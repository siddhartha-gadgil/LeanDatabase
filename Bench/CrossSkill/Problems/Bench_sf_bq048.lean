 OVER (ORDER BY \"CORRELATION\" DESC) AS pos_rank,\n        ROW_NUMBER() OVER (ORDER BY \"CORRELATION\" ASC) AS neg_rank\n    FROM correlations\n)\n\nSELECT complaint_type, \"CORRELATION\"\nFROM ranked\nWHERE pos_rank = 1 OR neg_rank = 1\nORDER BY \"CORRELATION\" DESC;") t ~= (sql%([_311_SERVICE_REQUESTS_schema, GSOD2019_schema, GSOD2013_schema, GSOD2011_schema, GSOD2015_schema, GSOD2012_schema, GSOD2020_schema, GSOD2014_schema, GSOD2016_schema, GSOD2017_schema, GSOD2018_schema]) "WITH gsod_all AS (\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2011\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2012\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2013\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2014\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2015\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2016\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2017\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2018\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2019\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n    UNION ALL\n    SELECT \"stn\", \"year\", \"mo\", \"da\", CAST(\"wdsp\" AS FLOAT) AS wdsp FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2020\" WHERE \"stn\" = '744860' AND \"wdsp\" != '999.9'\n),\nweather AS (\n    SELECT\n        TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n        AVG(wdsp) AS avg_wdsp\n    FROM gsod_all\n    GROUP BY dt\n),\ncomplaints_raw AS (\n    SELECT\n        TO_DATE(TO_TIMESTAMP(\"created_date\" / 1000000)) AS dt,\n        \"complaint_type\"\n    FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\"\n    WHERE TO_TIMESTAMP(\"created_date\" / 1000000) >= '2011-01-01'\n      AND TO_TIMESTAMP(\"created_date\" / 1000000) < '2021-01-01'\n),\ndaily_total AS (\n    SELECT dt, COUNT(*) AS total_complaints\n    FROM complaints_raw\n    GROUP BY dt\n),\ndaily_type AS (\n    SELECT dt, \"complaint_type\", COUNT(*) AS type_complaints\n    FROM complaints_raw\n    GROUP BY dt, \"complaint_type\"\n),\ncomplaint_types_filtered AS (\n    SELECT \"complaint_type\"\n    FROM complaints_raw\n    GROUP BY \"complaint_type\"\n    HAVING COUNT(*) > 3000\n),\ndaily_proportions AS (\n    SELECT\n        dt2.\"complaint_type\",\n        dt2.dt,\n        dt2.type_complaints::FLOAT / dtot.total_complaints::FLOAT AS proportion\n    FROM daily_type dt2\n    JOIN daily_total dtot ON dt2.dt = dtot.dt\n    WHERE dt2.\"complaint_type\" IN (SELECT \"complaint_type\" FROM complaint_types_filtered)\n),\ncorr_data AS (\n    SELECT\n        dp.\"complaint_type\",\n        CORR(w.avg_wdsp, dp.proportion) AS correlation\n    FROM daily_proportions dp\n    JOIN weather w ON dp.dt = w.dt\n    GROUP BY dp.\"complaint_type\"\n),\nranked AS (\n    SELECT\n        \"complaint_type\",\n        ROUND(correlation, 4) AS CORRELATION,\n        ROW_NUMBER() OVER (ORDER BY correlation DESC) AS rn_pos,\n        ROW_NUMBER() OVER (ORDER BY correlation ASC) AS rn_neg\n    FROM corr_data\n)\nSELECT \"complaint_type\", CORRELATION\nFROM ranked\nWHERE rn_pos = 1 OR rn_neg = 1\nORDER BY CORRELATION DESC;") t := by
