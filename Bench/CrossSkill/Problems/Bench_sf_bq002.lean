170625\"\nUNION ALL\nSELECT 'GA_SESSIONS_20170626' as table_name, \"date\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170626\"\nUNION ALL\nSELECT 'GA_SESSIONS_20170627' as table_name, \"date\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170627\"\nUNION ALL\nSELECT 'GA_SESSIONS_20170628' as table_name, \"date\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170628\"\nUNION ALL\nSELECT 'GA_SESSIONS_20170629' as table_name, \"date\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170629\"\nUNION ALL\nSELECT 'GA_SESSIONS_20170630' as table_name, \"date\", \"trafficSource\", \"hits\" FROM \"GA360\".\"GOOGLE_ANALYTICS_SAMPLE\".\"GA_SESSIONS_20170630\"\n),\nflattened AS (\n  SELECT\n    b.\"date\"::STRING as session_date,\n    b.\"trafficSource\":\"source\"::STRING as traffic_source,\n    p.value:\"productRevenue\"::FLOAT / 1000000.0 as product_revenue\n  FROM base b,\n  LATERAL FLATTEN(input => b.\"hits\") h,\n  LATERAL FLATTEN(input => h.value:\"product\") p\n  WHERE p.value:\"productRevenue\" IS NOT NULL\n),\ndaily AS (\n  SELECT traffic_source, session_date,\n    SUM(product_revenue) as daily_revenue\n  FROM flattened\n  GROUP BY traffic_source, session_date\n),\nweekly AS (\n  SELECT traffic_source,\n    WEEKISO(TO_DATE(session_date, 'YYYYMMDD')) as week_num,\n    EXTRACT(YEAR FROM TO_DATE(session_date, 'YYYYMMDD')) as yr,\n    SUM(product_revenue) as weekly_revenue\n  FROM flattened\n  GROUP BY traffic_source, week_num, yr\n),\nmonthly AS (\n  SELECT traffic_source,\n    DATE_TRUNC('month', TO_DATE(session_date, 'YYYYMMDD')) as month_start,\n    SUM(product_revenue) as monthly_revenue\n  FROM flattened\n  GROUP BY traffic_source, month_start\n),\nsource_totals AS (\n  SELECT traffic_source, SUM(product_revenue) as total_revenue\n  FROM flattened\n  GROUP BY traffic_source\n),\ntop_source AS (\n  SELECT traffic_source, total_revenue\n  FROM source_totals\n  ORDER BY total_revenue DESC\n  LIMIT 1\n)\nSELECT\n  t.traffic_source as TRAFFIC_SOURCE,\n  ROUND(t.total_revenue, 6) as TOTAL_PRODUCT_REVENUE_MILLIONS,\n  ROUND(MAX(d.daily_revenue), 6) as MAX_DAILY_PRODUCT_REVENUE_MILLIONS,\n  ROUND(MAX(w.weekly_revenue), 6) as MAX_WEEKLY_PRODUCT_REVENUE_MILLIONS,\n  ROUND(MAX(m.monthly_revenue), 6) as MAX_MONTHLY_PRODUCT_REVENUE_MILLIONS\nFROM top_source t\nJOIN daily d ON d.traffic_source = t.traffic_source\nJOIN weekly w ON w.traffic_source = t.traffic_source\nJOIN monthly m ON m.traffic_source = t.traffic_source\nGROUP BY t.traffic_source, t.total_revenue;") t := by
