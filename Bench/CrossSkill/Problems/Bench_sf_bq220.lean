    (sql%([POPULATION_schema, CONDITION_schema, POPULATION_STRATUM_schema, POPULATION_EVALUATION_TYPE_schema, POPULATION_STRATUM_ASSIGN_schema, POPULATION_EVALUATION_schema]) "WITH base AS (\n  SELECT\n    p.\"inventory_year\",\n    c.\"state_code\",\n    c.\"state_code_name\",\n    CASE\n      WHEN c.\"proportion_basis\" = 'SUBP' AND p.\"adjustment_factor_for_the_subplot\" > 0\n        THEN p.\"expansion_factor\" * c.\"condition_proportion_unadjusted\" * p.\"adjustment_factor_for_the_subplot\"\n      ELSE 0\n    END AS subplot_size,\n    CASE\n      WHEN c.\"proportion_basis\" = 'MACR' AND p.\"adjustment_factor_for_the_macroplot\" > 0\n        THEN p.\"expansion_factor\" * c.\"condition_proportion_unadjusted\" * p.\"adjustment_factor_for_the_macroplot\"\n      ELSE 0\n    END AS macroplot_size\n  FROM \"USFS_FIA\".\"USFS_FIA\".\"POPULATION\" p\n  JOIN \"USFS_FIA\".\"USFS_FIA\".\"CONDITION\" c\n    ON p.\"plot_sequence_number\" = c.\"plot_sequence_number\"\n    AND p.\"state_code\" = c.\"state_code\"\n    AND p.\"inventory_year\" = c.\"inventory_year\"\n  WHERE p.\"evaluation_type\" = 'EXPCURR'\n    AND c.\"condition_status_code\" = 1\n    AND p.\"inventory_year\" IN (2015, 2016, 2017)\n),\nstate_avg AS (\n  SELECT\n    'SUBPLOT' AS PLOT_TYPE,\n    \"inventory_year\" AS INVENTORY_YEAR,\n    \"state_code\",\n    \"state_code_name\",\n    AVG(subplot_size) AS AVG_SIZE\n  FROM base\n  GROUP BY \"inventory_year\", \"state_code\", \"state_code_name\"\n\n  UNION ALL\n\n  SELECT\n    'MACROPLOT' AS PLOT_TYPE,\n    \"inventory_year\" AS INVENTORY_YEAR,\n    \"state_code\",\n    \"state_code_name\",\n    AVG(macroplot_size) AS AVG_SIZE\n  FROM base\n  GROUP BY \"inventory_year\", \"state_code\", \"state_code_name\"\n),\nranked AS (\n  SELECT\n    PLOT_TYPE,\n    INVENTORY_YEAR,\n    \"state_code\",\n    \"state_code_name\",\n    AVG_SIZE,\n    ROW_NUMBER() OVER (PARTITION BY PLOT_TYPE, INVENTORY_YEAR ORDER BY AVG_SIZE DESC) AS rn\n  FROM state_avg\n)\nSELECT\n  PLOT_TYPE,\n  INVENTORY_YEAR,\n  \"state_code\",\n  \"state_code_name\",\n  AVG_SIZE\nFROM ranked\nWHERE rn = 1\nORDER BY PLOT_TYPE, INVENTORY_YEAR;") t ~= (sql%([POPULATION_schema, CONDITION_schema, POPULATION_STRATUM_schema, POPULATION_EVALUATION_TYPE_schema, POPULATION_STRATUM_ASSIGN_schema, POPULATION_EVALUATION_schema]) "WITH forest_area AS (\n  SELECT\n    CASE \n      WHEN c.\"proportion_basis\" = 'MACR' THEN 'MACROPLOT'\n      WHEN c.\"proportion_basis\" = 'SUBP' THEN 'SUBPLOT'\n    END AS PLOT_TYPE,\n    c.\"inventory_year\" AS INVENTORY_YEAR,\n    c.\"state_code\" AS state_code,\n    c.\"state_code_name\" AS state_code_name,\n    p.\"expansion_factor\" * c.\"condition_proportion_unadjusted\" * \n      CASE \n        WHEN c.\"proportion_basis\" = 'MACR' THEN p.\"adjustment_factor_for_the_macroplot\"\n        WHEN c.\"proportion_basis\" = 'SUBP' THEN p.\"adjustment_factor_for_the_subplot\"\n      END AS estimated_area\n  FROM \"USFS_FIA\".\"USFS_FIA\".\"CONDITION\" c\n  JOIN \"USFS_FIA\".\"USFS_FIA\".\"POPULATION\" p\n    ON c.\"state_code\" = p.\"state_code\"\n    AND c.\"county_code\" = p.\"county_code\"\n    AND c.\"phase_2_plot_number\" = p.\"phase_2_plot_number\"\n    AND c.\"inventory_year\" = p.\"inventory_year\"\n  WHERE p.\"evaluation_type\" = 'EXPCURR'\n    AND c.\"condition_status_code\" = 1\n    AND c.\"proportion_basis\" IN ('MACR', 'SUBP')\n    AND (\n      (c.\"proportion_basis\" = 'MACR' AND p.\"adjustment_factor_for_the_macroplot\" > 0)\n      OR\n      (c.\"proportion_basis\" = 'SUBP' AND p.\"adjustment_factor_for_the_subplot\" > 0)\n    )\n    AND c.\"inventory_year\" IN (2015, 2016, 2017)\n),\navg_by_state AS (\n  SELECT\n    PLOT_TYPE,\n    INVENTORY_YEAR,\n    state_code,\n    state_code_name,\n    AVG(estimated_area) AS AVG_SIZE\n  FROM forest_area\n  GROUP BY PLOT_TYPE, INVENTORY_YEAR, state_code, state_code_name\n),\nranked AS (\n  SELECT\n    PLOT_TYPE,\n    INVENTORY_YEAR,\n    state_code,\n    state_code_name,\n    AVG_SIZE,\n    ROW_NUMBER() OVER (PARTITION BY PLOT_TYPE, INVENTORY_YEAR ORDER BY AVG_SIZE DESC) AS rn\n  FROM avg_by_state\n)\nSELECT\n  PLOT_TYPE,\n  INVENTORY_YEAR,\n  state_code,\n  state_code_name,\n  AVG_SIZE\nFROM ranked\nWHERE rn = 1\nORDER BY PLOT_TYPE, INVENTORY_YEAR;") t := by
