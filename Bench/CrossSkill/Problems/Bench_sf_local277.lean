onal s ON b.\"product_id\" = s.\"product_id\" AND b.cal_month = s.cal_month\n  JOIN regression r ON b.\"product_id\" = r.\"product_id\"\n  WHERE b.t BETWEEN 25 AND 36\n),\nannual AS (\n  SELECT \"product_id\", SUM(forecasted_sales) as annual_forecast\n  FROM forecast\n  GROUP BY \"product_id\"\n)\nSELECT \n  ROUND(AVG(annual_forecast), 4) as AVG_FORECASTED_ANNUAL_SALES_2018\nFROM annual;") t ~= (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base_data AS (\n    SELECT \n        \"product_id\",\n        \"mth\",\n        \"qty\",\n        ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS time_step,\n        MONTH(TO_DATE(\"mth\", 'YYYY-MM-DD')) AS month_num\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\"\n    WHERE \"product_id\" IN (4160, 7790)\n      AND \"mth\" >= '2016-01-01'\n      AND \"mth\" < '2019-01-01'\n),\n\n-- Calculate 2x12 Centered Moving Average\n-- MA1 centered at t: average of t-5 to t+6\n-- MA2 centered at t: average of t-6 to t+5\n-- CMA = (MA1 + MA2) / 2\ncma_calc AS (\n    SELECT \n        a.\"product_id\",\n        a.time_step,\n        a.month_num,\n        a.\"qty\",\n        (\n            (SELECT AVG(b.\"qty\") FROM base_data b \n             WHERE b.\"product_id\" = a.\"product_id\" \n               AND b.time_step BETWEEN a.time_step - 5 AND a.time_step + 6)\n            +\n            (SELECT AVG(b.\"qty\") FROM base_data b \n             WHERE b.\"product_id\" = a.\"product_id\" \n               AND b.time_step BETWEEN a.time_step - 6 AND a.time_step + 5)\n        ) / 2.0 AS cma\n    FROM base_data a\n    WHERE a.time_step BETWEEN 7 AND 30\n),\n\n-- Sales-to-CMA ratio\nratios AS (\n    SELECT \n        \"product_id\",\n        time_step,\n        month_num,\n        \"qty\",\n        cma,\n        CASE WHEN cma != 0 THEN \"qty\" / cma ELSE NULL END AS sales_to_cma\n    FROM cma_calc\n),\n\n-- Seasonal indices: average of sales-to-CMA ratios by month_num per product\nseasonal_indices AS (\n    SELECT \n        \"product_id\",\n        month_num,\n        AVG(sales_to_cma) AS seasonal_index\n    FROM ratios\n    WHERE sales_to_cma IS NOT NULL\n    GROUP BY \"product_id\", month_num\n),\n\n-- Deseasonalize all 36 months\ndeseasonalized AS (\n    SELECT \n        b.\"product_id\",\n        b.time_step,\n        b.month_num,\n        b.\"qty\",\n        s.seasonal_index,\n        CASE WHEN s.seasonal_index != 0 THEN b.\"qty\" / s.seasonal_index ELSE NULL END AS deseas_qty\n    FROM base_data b\n    JOIN seasonal_indices s \n      ON b.\"product_id\" = s.\"product_id\" AND b.month_num = s.month_num\n),\n\n-- Weighted linear regression on deseasonalized data (all 36 months)\n-- Weights = time_step\n-- WLS: minimize sum(w_i * (y_i - a - b*x_i)^2)\n-- Normal equations:\n-- b = (sum(w*x*y) - sum(w*x)*sum(w*y)/sum(w)) / (sum(w*x^2) - (sum(w*x))^2/sum(w))\n-- a = (sum(w*y) - b*sum(w*x)) / sum(w)\nregression_stats AS (\n    SELECT \n        \"product_id\",\n        SUM(time_step * deseas_qty * time_step) AS sum_wxy,   -- sum(w*x*y) where w=x=time_step\n        SUM(time_step * time_step) AS sum_wx2,                  -- sum(w*x^2)\n        SUM(time_step * time_step) AS sum_wx,                   -- sum(w*x) -- wait, w=time_step, x=time_step\n        SUM(time_step * deseas_qty) AS sum_wy,                  -- sum(w*y)\n        SUM(time_step) AS sum_w                                  -- sum(w)\n    FROM deseasonalized\n    GROUP BY \"product_id\"\n),\n\n-- Actually, let me redo this. w_i = time_step_i, x_i = time_step_i, y_i = deseas_qty_i\n-- sum_w = sum(w_i) = sum(time_step)\n-- sum_wx = sum(w_i * x_i) = sum(time_step^2)\n-- sum_wy = sum(w_i * y_i) = sum(time_step * deseas_qty)\n-- sum_wxy = sum(w_i * x_i * y_i) = sum(time_step^2 * deseas_qty)\n-- sum_wx2 = sum(w_i * x_i^2) = sum(time_step^3)\nregression_stats2 AS (\n    SELECT \n        \"product_id\",\n        SUM(CAST(time_step AS FLOAT)) AS sum_w,\n        SUM(CAST(time_step AS FLOAT) * CAST(time_step AS FLOAT)) AS sum_wx,\n        SUM(CAST(time_step AS FLOAT) * deseas_qty) AS sum_wy,\n        SUM(CAST(time_step AS FLOAT) * CAST(time_step AS FLOAT) * deseas_qty) AS sum_wxy,\n        SUM(CAST(time_step AS FLOAT) * CAST(time_step AS FLOAT) * CAST(time_step AS FLOAT)) AS sum_wx2\n    FROM deseasonalized\n    GROUP BY \"product_id\"\n),\n\nregression_coeffs AS (\n    SELECT \n        \"product_id\",\n        (sum_wxy - sum_wx * sum_wy / sum_w) / (sum_wx2 - sum_wx * sum_wx / sum_w) AS slope,\n        (sum_wy - ((sum_wxy - sum_wx * sum_wy / sum_w) / (sum_wx2 - sum_wx * sum_wx / sum_w)) * sum_wx) / sum_w AS intercept\n    FROM regression_stats2\n),\n\n-- Forecast: for each month in 2018 (time steps 25-36), predict deseasonalized value\n-- then re-seasonalize\nforecast_months AS (\n    SELECT 25 AS time_step, 1 AS month_num UNION ALL\n    SELECT 26, 2 UNION ALL\n    SELECT 27, 3 UNION ALL\n    SELECT 28, 4 UNION ALL\n    SELECT 29, 5 UNION ALL\n    SELECT 30, 6 UNION ALL\n    SELECT 31, 7 UNION ALL\n    SELECT 32, 8 UNION ALL\n    SELECT 33, 9 UNION ALL\n    SELECT 34, 10 UNION ALL\n    SELECT 35, 11 UNION ALL\n    SELECT 36, 12\n),\n\nforecasted AS (\n    SELECT \n        r.\"product_id\",\n        f.time_step,\n        f.month_num,\n        r.intercept + r.slope * f.time_step AS forecast_deseas,\n        s.seasonal_index,\n        (r.intercept + r.slope * f.time_step) * s.seasonal_index AS forecast_seas\n    FROM regression_coeffs r\n    CROSS JOIN forecast_months f\n    JOIN seasonal_indices s \n      ON r.\"product_id\" = s.\"product_id\" AND f.month_num = s.month_num\n),\n\n-- Sum forecasted monthly values to get annual forecast per product\nannual_forecast AS (\n    SELECT \n        \"product_id\",\n        SUM(forecast_seas) AS forecasted_annual_sales\n    FROM forecasted\n    GROUP BY \"product_id\"\n)\n\nSELECT \n    ROUND(AVG(forecasted_annual_sales), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018\nFROM annual_forecast;") t := by
  intro t; first | sql_equiv | sorry

-- eq_2_3: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_2_3 : ∀ t,
    (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base AS (\n    -- Assign time steps 1-36 per product starting Jan 2016\n    SELECT\n        \"product_id\",\n        \"mth\",\n        \"qty\",\n        ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t,\n        EXTRACT(MONTH FROM TO_DATE(\"mth\", 'YYYY-MM-DD')) AS month_of_year\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\"\n    WHERE \"product_id\" IN (4160, 7790)\n      AND \"mth\" >= '2016-01-01'\n      AND \"mth\" < '2019-01-01'\n),\n\n-- Step 1: Compute Centered Moving Average (CMA) using two overlapping 12-month windows\ncma_calc AS (\n    SELECT\n        b.\"product_id\",\n        b.t,\n        b.\"mth\",\n        b.\"qty\",\n        b.month_of_year,\n        -- Window 1: t-5 to t+6\n        AVG(b2.\"qty\") AS ma1,\n        -- Window 2: t-6 to t+5\n        AVG(b3.\"qty\") AS ma2\n    FROM base b\n    LEFT JOIN base b2 ON b.\"product_id\" = b2.\"product_id\" \n        AND b2.t BETWEEN b.t - 5 AND b.t + 6\n    LEFT JOIN base b3 ON b.\"product_id\" = b3.\"product_id\" \n        AND b3.t BETWEEN b.t - 6 AND b.t + 5\n    GROUP BY b.\"product_id\", b.t, b.\"mth\", b.\"qty\", b.month_of_year\n),\n\ncma AS (\n    SELECT\n        \"product_id\",\n        t,\n        \"mth\",\n        \"qty\",\n        month_of_year,\n        CASE \n            WHEN t >= 7 AND t <= 30 THEN (ma1 + ma2) / 2.0\n            ELSE NULL\n        END AS cma_value\n    FROM cma_calc\n),\n\n-- Step 2: Compute sales-to-CMA ratio for time steps 7-30\nratios AS (\n    SELECT\n        \"product_id\",\n        t,\n        month_of_year,\n        \"qty\",\n        cma_value,\n        \"qty\" / NULLIF(cma_value, 0) AS ratio\n    FROM cma\n    WHERE t BETWEEN 7 AND 30 AND cma_value IS NOT NULL\n),\n\n-- Step 3: Compute seasonal factors (average ratio per month-of-year per product)\nseasonal_factors AS (\n    SELECT\n        \"product_id\",\n        month_of_year,\n        AVG(ratio) AS seasonal_factor\n    FROM ratios\n    GROUP BY \"product_id\", month_of_year\n),\n\n-- Step 4: Deseasonalize data for time steps 7-30\ndeseasonalized AS (\n    SELECT\n        c.\"product_id\",\n        c.t,\n        c.\"qty\",\n        c.month_of_year,\n        sf.seasonal_factor,\n        c.\"qty\" / NULLIF(sf.seasonal_factor, 0) AS deseasonalized_qty\n    FROM cma c\n    JOIN seasonal_factors sf ON c.\"product_id\" = sf.\"product_id\" \n        AND c.month_of_year = sf.month_of_year\n    WHERE c.t BETWEEN 7 AND 30\n),\n\n-- Step 5: Weighted linear regression on deseasonalized data (time steps 7-30)\n-- Using REGR functions: y = deseasonalized_qty, x = t, weighted by t\nregression AS (\n    SELECT\n        \"product_id\",\n        REGR_SLOPE(deseasonalized_qty * t, t * t) / REGR_SLOPE(t, t) AS w_slope,\n        REGR_INTERCEPT(deseasonalized_qty * t, t * t) AS w_intercept_raw,\n        -- Standard weighted regression: minimize sum(w_i * (y_i - a - b*x_i)^2)\n        -- With weights = time step t\n        SUM(t * deseasonalized_qty * t) AS sum_wxy,\n        SUM(t * t) AS sum_wx2,\n        SUM(t * deseasonalized_qty) AS sum_wy,\n        SUM(t) AS sum_w,\n        SUM(t * t * t) AS sum_wx3,\n        COUNT(*) AS n\n    FROM deseasonalized\n    GROUP BY \"product_id\"\n),\n\n-- Weighted regression coefficients\n-- b = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wx3 - sum_wx2 * sum_wx2)  -- wrong\n-- Actually: weight w_i = t_i\n-- sum_w = SUM(w_i), sum_wx = SUM(w_i * x_i), sum_wy = SUM(w_i * y_i)\n-- sum_wxx = SUM(w_i * x_i * x_i), sum_wxy = SUM(w_i * x_i * y_i)\n-- slope = (sum_w * sum_wxy - sum_wx * sum_wy) / (sum_w * sum_wxx - sum_wx * sum_wx)\n-- intercept = (sum_wy - slope * sum_wx) / sum_w\nweighted_reg AS (\n    SELECT\n        \"product_id\",\n        SUM(t) AS sum_w,\n        SUM(t * t) AS sum_wx,        -- sum(w_i * x_i) where w=t, x=t => sum(t^2)\n        SUM(t * deseasonalized_qty) AS sum_wy,  -- sum(w_i * y_i)\n        SUM(t * t * t) AS sum_wxx,    -- sum(w_i * x_i^2) = sum(t^3)\n        SUM(t * t * deseasonalized_qty) AS sum_wxy  -- sum(w_i * x_i * y_i) = sum(t^2 * y)\n    FROM deseasonalized\n    GROUP BY \"product_id\"\n),\n\nreg_coeffs AS (\n    SELECT\n        \"product_id\",\n        (sum_w * sum_wxy - sum_wx * sum_wy) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0) AS slope,\n        (sum_wy - ((sum_w * sum_wxy - sum_wx * sum_wy) / NULLIF(sum_w * sum_wxx - sum_wx * sum_wx, 0)) * sum_wx) / NULLIF(sum_w, 0) AS intercept\n    FROM weighted_reg\n),\n\n-- Step 6: Generate time steps for 2018 (t = 25 to 36)\nforecast_months AS (\n    SELECT \"product_id\", 25 AS t, 1 AS month_of_year FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 26, 2 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 27, 3 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 28, 4 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 29, 5 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 30, 6 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 31, 7 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 32, 8 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 33, 9 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 34, 10 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 35, 11 FROM reg_coeffs\n    UNION ALL SELECT \"product_id\", 36, 12 FROM reg_coeffs\n),\n\n-- Step 7: Forecast = (intercept + slope * t) * seasonal_factor\nforecasted AS (\n    SELECT\n        fm.\"product_id\",\n        fm.t,\n        fm.month_of_year,\n        rc.intercept + rc.slope * fm.t AS deseasonalized_forecast,\n        sf.seasonal_factor,\n        (rc.intercept + rc.slope * fm.t) * sf.seasonal_factor AS forecasted_qty\n    FROM forecast_months fm\n    JOIN reg_coeffs rc ON fm.\"product_id\" = rc.\"product_id\"\n    JOIN seasonal_factors sf ON fm.\"product_id\" = sf.\"product_id\" \n        AND fm.month_of_year = sf.month_of_year\n),\n\n-- Step 8: Sum monthly forecasts to get annual 2018 per product\nannual_forecast AS (\n    SELECT\n        \"product_id\",\n        SUM(forecasted_qty) AS annual_sales_2018\n    FROM forecasted\n    GROUP BY \"product_id\"\n)\n\n-- Step 9: Average across both products\nSELECT\n    ROUND(AVG(annual_sales_2018), 2) AS \"AVG_FORECASTED_ANNUAL_SALES_2018\"\nFROM annual_forecast;") t ~= (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base_data AS (\n    SELECT \n        \"product_id\",\n        \"mth\",\n        \"qty\",\n        ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS time_step,\n        MONTH(TO_DATE(\"mth\", 'YYYY-MM-DD')) AS month_num\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\"\n    WHERE \"product_id\" IN (4160, 7790)\n      AND \"mth\" >= '2016-01-01'\n      AND \"mth\" < '2019-01-01'\n),\n\n-- Calculate 2x12 Centered Moving Average\n-- MA1 centered at t: average of t-5 to t+6\n-- MA2 centered at t: average of t-6 to t+5\n-- CMA = (MA1 + MA2) / 2\ncma_calc AS (\n    SELECT \n        a.\"product_id\",\n        a.time_step,\n        a.month_num,\n        a.\"qty\",\n        (\n            (SELECT AVG(b.\"qty\") FROM base_data b \n             WHERE b.\"product_id\" = a.\"product_id\" \n               AND b.time_step BETWEEN a.time_step - 5 AND a.time_step + 6)\n            +\n            (SELECT AVG(b.\"qty\") FROM base_data b \n             WHERE b.\"product_id\" = a.\"product_id\" \n               AND b.time_step BETWEEN a.time_step - 6 AND a.time_step + 5)\n        ) / 2.0 AS cma\n    FROM base_data a\n    WHERE a.time_step BETWEEN 7 AND 30\n),\n\n-- Sales-to-CMA ratio\nratios AS (\n    SELECT \n        \"product_id\",\n        time_step,\n        month_num,\n        \"qty\",\n        cma,\n        CASE WHEN cma != 0 THEN \"qty\" / cma ELSE NULL END AS sales_to_cma\n    FROM cma_calc\n),\n\n-- Seasonal indices: average of sales-to-CMA ratios by month_num per product\nseasonal_indices AS (\n    SELECT \n        \"product_id\",\n        month_num,\n        AVG(sales_to_cma) AS seasonal_index\n    FROM ratios\n    WHERE sales_to_cma IS NOT NULL\n    GROUP BY \"product_id\", month_num\n),\n\n-- Deseasonalize all 36 months\ndeseasonalized AS (\n    SELECT \n        b.\"product_id\",\n        b.time_step,\n        b.month_num,\n        b.\"qty\",\n        s.seasonal_index,\n        CASE WHEN s.seasonal_index != 0 THEN b.\"qty\" / s.seasonal_index ELSE NULL END AS deseas_qty\n    FROM base_data b\n    JOIN seasonal_indices s \n      ON b.\"product_id\" = s.\"product_id\" AND b.month_num = s.month_num\n),\n\n-- Weighted linear regression on deseasonalized data (all 36 months)\n-- Weights = time_step\n-- WLS: minimize sum(w_i * (y_i - a - b*x_i)^2)\n-- Normal equations:\n-- b = (sum(w*x*y) - sum(w*x)*sum(w*y)/sum(w)) / (sum(w*x^2) - (sum(w*x))^2/sum(w))\n-- a = (sum(w*y) - b*sum(w*x)) / sum(w)\nregression_stats AS (\n    SELECT \n        \"product_id\",\n        SUM(time_step * deseas_qty * time_step) AS sum_wxy,   -- sum(w*x*y) where w=x=time_step\n        SUM(time_step * time_step) AS sum_wx2,                  -- sum(w*x^2)\n        SUM(time_step * time_step) AS sum_wx,                   -- sum(w*x) -- wait, w=time_step, x=time_step\n        SUM(time_step * deseas_qty) AS sum_wy,                  -- sum(w*y)\n        SUM(time_step) AS sum_w                                  -- sum(w)\n    FROM deseasonalized\n    GROUP BY \"product_id\"\n),\n\n-- Actually, let me redo this. w_i = time_step_i, x_i = time_step_i, y_i = deseas_qty_i\n-- sum_w = sum(w_i) = sum(time_step)\n-- sum_wx = sum(w_i * x_i) = sum(time_step^2)\n-- sum_wy = sum(w_i * y_i) = sum(time_step * deseas_qty)\n-- sum_wxy = sum(w_i * x_i * y_i) = sum(time_step^2 * deseas_qty)\n-- sum_wx2 = sum(w_i * x_i^2) = sum(time_step^3)\nregression_stats2 AS (\n    SELECT \n        \"product_id\",\n        SUM(CAST(time_step AS FLOAT)) AS sum_w,\n        SUM(CAST(time_step AS FLOAT) * CAST(time_step AS FLOAT)) AS sum_wx,\n        SUM(CAST(time_step AS FLOAT) * deseas_qty) AS sum_wy,\n        SUM(CAST(time_step AS FLOAT) * CAST(time_step AS FLOAT) * deseas_qty) AS sum_wxy