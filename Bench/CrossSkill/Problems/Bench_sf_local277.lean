    (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base AS (\n    SELECT \"product_id\", \"mth\", \"qty\",\n        ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") AS t\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\"\n    WHERE \"product_id\" IN (4160, 7790)\n),\ncma AS (\n    SELECT a.\"product_id\", a.t, a.\"qty\",\n        (SUM(CASE WHEN b.t BETWEEN a.t - 5 AND a.t + 6 THEN b.\"qty\" END) / 12.0\n        + SUM(CASE WHEN b.t BETWEEN a.t - 6 AND a.t + 5 THEN b.\"qty\" END) / 12.0) / 2.0 AS cma_value,\n        ((a.t - 1) % 12) + 1 AS month_num\n    FROM base a JOIN base b ON a.\"product_id\" = b.\"product_id\"\n    WHERE a.t BETWEEN 7 AND 30\n    GROUP BY a.\"product_id\", a.t, a.\"qty\"\n),\nratios AS (\n    SELECT \"product_id\", t, \"qty\", cma_value,\n        CAST(\"qty\" AS DOUBLE) / NULLIF(cma_value, 0) AS ratio, month_num\n    FROM cma\n),\nseasonal_indices AS (\n    SELECT \"product_id\", month_num, AVG(ratio) AS seasonal_index\n    FROM ratios GROUP BY \"product_id\", month_num\n),\ndeseas AS (\n    SELECT r.\"product_id\", r.t, r.cma_value, r.month_num, si.seasonal_index,\n        CAST(r.\"qty\" AS DOUBLE) / NULLIF(si.seasonal_index, 0) AS deseasonalized\n    FROM ratios r\n    JOIN seasonal_indices si ON r.\"product_id\" = si.\"product_id\" AND r.month_num = si.month_num\n),\nwls_regression AS (\n    SELECT \"product_id\",\n        SUM(cma_value) AS sum_w,\n        SUM(cma_value * CAST(t AS DOUBLE)) AS sum_wx,\n        SUM(cma_value * CAST(t AS DOUBLE) * CAST(t AS DOUBLE)) AS sum_wx2,\n        SUM(cma_value * deseasonalized) AS sum_wy,\n        SUM(cma_value * CAST(t AS DOUBLE) * deseasonalized) AS sum_wxy\n    FROM deseas GROUP BY \"product_id\"\n),\nregression_coeffs AS (\n    SELECT \"product_id\",\n        (sum_w * sum_wxy - sum_wx * sum_wy) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0) AS slope,\n        (sum_wy - ((sum_w * sum_wxy - sum_wx * sum_wy) / NULLIF(sum_w * sum_wx2 - sum_wx * sum_wx, 0)) * sum_wx) / NULLIF(sum_w, 0) AS intercept\n    FROM wls_regression\n),\nforecast_2018 AS (\n    SELECT rc.\"product_id\", si.month_num,\n        (rc.intercept + rc.slope * (24.0 + si.month_num)) * si.seasonal_index AS forecasted_sales\n    FROM regression_coeffs rc\n    JOIN seasonal_indices si ON rc.\"product_id\" = si.\"product_id\"\n)\nSELECT ROUND(AVG(annual_sales), 4) AS AVG_FORECASTED_ANNUAL_SALES_2018 FROM (\n    SELECT \"product_id\", SUM(forecasted_sales) AS annual_sales\n    FROM forecast_2018 GROUP BY \"product_id\"\n);") t ~= (sql%([MONTHLY_SALES_schema, PRODUCTS_schema]) "WITH base AS (\n  SELECT \"product_id\", \"mth\", CAST(\"qty\" AS DOUBLE) as qty,\n    ROW_NUMBER() OVER (PARTITION BY \"product_id\" ORDER BY \"mth\") as t,\n    CAST(SUBSTRING(\"mth\", 6, 2) AS INTEGER) as cal_month\n  FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"MONTHLY_SALES\"\n  WHERE \"product_id\" IN (4160, 7790)\n),\ncma_calc AS (\n  SELECT b.\"product_id\", b.t, b.qty, b.cal_month,\n    ((SELECT SUM(b2.qty) FROM base b2 WHERE b2.\"product_id\" = b.\"product_id\" AND b2.t BETWEEN b.t - 5 AND b.t + 6) +\n     (SELECT SUM(b2.qty) FROM base b2 WHERE b2.\"product_id\" = b.\"product_id\" AND b2.t BETWEEN b.t - 6 AND b.t + 5)) / 24.0 as cma\n  FROM base b\n  WHERE b.t BETWEEN 7 AND 30\n),\nratios AS (\n  SELECT \"product_id\", t, qty, cal_month, cma,\n    qty / NULLIF(cma, 0) as ratio\n  FROM cma_calc\n),\nseasonal AS (\n  SELECT \"product_id\", cal_month, AVG(ratio) as si\n  FROM ratios\n  GROUP BY \"product_id\", cal_month\n),\ndeseasonalized AS (\n  SELECT c.\"product_id\", c.t, c.qty, c.cal_month, s.si, c.cma,\n    CASE WHEN s.si = 0 THEN 0.0 ELSE c.qty / s.si END as deseas\n  FROM cma_calc c\n  JOIN seasonal s ON c.\"product_id\" = s.\"product_id\" AND c.cal_month = s.cal_month\n),\nwls_parts AS (\n  SELECT \"product_id\",\n    SUM(cma) as S_w,\n    SUM(cma * CAST(t AS DOUBLE)) as S_wx,\n    SUM(cma * deseas) as S_wy,\n    SUM(cma * CAST(t AS DOUBLE) * deseas) as S_wxy,\n    SUM(cma * CAST(t AS DOUBLE) * CAST(t AS DOUBLE)) as S_wxx\n  FROM deseasonalized\n  GROUP BY \"product_id\"\n),\nregression AS (\n  SELECT \"product_id\",\n    (S_w * S_wxy - S_wx * S_wy) / NULLIF(S_w * S_wxx - S_wx * S_wx, 0) as slope,\n    (S_wy - ((S_w * S_wxy - S_wx * S_wy) / NULLIF(S_w * S_wxx - S_wx * S_wx, 0)) * S_wx) / NULLIF(S_w, 0) as intercept\n  FROM wls_parts\n),\nforecast AS (\n  SELECT b.\"product_id\", b.t, b.cal_month, s.si,\n    (r.intercept + r.slope * CAST(b.t AS DOUBLE)) * s.si as forecasted_sales\n  FROM base b\n  JOIN seasonal s ON b.\"product_id\" = s.\"product_id\" AND b.cal_month = s.cal_month\n  JOIN regression r ON b.\"product_id\" = r.\"product_id\"\n  WHERE b.t BETWEEN 25 AND 36\n),\nannual AS (\n  SELECT \"product_id\", SUM(forecasted_sales) as annual_forecast\n  FROM forecast\n  GROUP BY \"product_id\"\n)\nSELECT \n  ROUND(AVG(annual_forecast), 4) as AVG_FORECASTED_ANNUAL_SALES_2018\nFROM annual;") t := by
