import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq114 — crossskill equivalence(s)

Question: Which three cities have the largest difference between their 1990 EPA PM2.5 measurements (using units_of_measure = 'Micrograms/cubic meter (LC)' and parameter_name = 'Acceptable PM2.5 AQI & Speciation Mass') and their 2020 OpenAQ PM2.5 measurements (where pollutant = 'pm25' based on the year extracted from the timestamp), with both datasets matched by latitude and longitude rounded to two decimals, and the difference ordered from greatest to least?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq114

CREATE TABLE PM25_NONFRM_DAILY_SUMMARY («state_code» STRING, «county_code» STRING, «site_num» STRING, «parameter_code» INT, «poc» INT, «latitude» FLOAT, «longitude» FLOAT, «datum» STRING, «parameter_name» STRING, «sample_duration» STRING, «pollutant_standard» STRING, «date_local» STRING, «units_of_measure» STRING, «event_type» STRING, «observation_count» INT, «observation_percent» FLOAT, «arithmetic_mean» FLOAT, «first_max_value» FLOAT, «first_max_hour» INT, «aqi» INT, «method_code» INT, «method_name» STRING, «local_site_name» STRING, «address» STRING, «state_name» STRING, «county_name» STRING, «city_name» STRING, «cbsa_name» STRING, «date_of_last_change» STRING)
CREATE TABLE AIR_QUALITY_ANNUAL_SUMMARY («state_code» STRING, «county_code» STRING, «site_num» STRING, «parameter_code» INT, «poc» INT, «latitude» FLOAT, «longitude» FLOAT, «datum» STRING, «parameter_name» STRING, «sample_duration» STRING, «pollutant_standard» STRING, «metric_used» STRING, «method_name» STRING, «year» INT, «units_of_measure» STRING, «event_type» STRING, «observation_count» INT, «observation_percent» FLOAT, «completeness_indicator» STRING, «valid_day_count» INT, «required_day_count» INT, «exceptional_data_count» INT, «null_data_count» INT, «primary_exceedance_count» INT, «secondary_exceedance_count» INT, «certification_indicator» STRING, «num_obs_below_mdl» INT, «arithmetic_mean» FLOAT, «arithmetic_standard_dev» FLOAT, «first_max_value» FLOAT, «first_max_datetime» INT, «second_max_value» FLOAT, «second_max_datetime» INT, «third_max_value» FLOAT, «third_max_datetime» INT, «fourth_max_value» FLOAT, «fourth_max_datetime» INT, «first_max_non_overlapping_value» FLOAT, «first_no_max_datetime» INT, «second_max_non_overlapping_value» FLOAT, «second_no_max_datetime» INT, «ninety_nine_percentile» FLOAT, «ninety_eight_percentile» FLOAT, «ninety_five_percentile» FLOAT, «ninety_percentile» FLOAT, «seventy_five_percentile» FLOAT, «fifty_percentile» FLOAT, «ten_percentile» FLOAT, «local_site_name» STRING, «address» STRING, «state_name» STRING, «county_name» STRING, «city_name» STRING, «cbsa_name» STRING, «date_of_last_change» STRING)
CREATE TABLE GLOBAL_AIR_QUALITY («location» STRING, «city» STRING, «country» STRING, «pollutant» STRING, «value» FLOAT, «timestamp» INT, «unit» STRING, «source_name» STRING, «latitude» FLOAT, «longitude» FLOAT, «averaged_over_in_hours» FLOAT, «location_geom» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([PM25_NONFRM_DAILY_SUMMARY_schema, AIR_QUALITY_ANNUAL_SUMMARY_schema, GLOBAL_AIR_QUALITY_schema]) "WITH epa AS (\n  SELECT ROUND(\"latitude\", 2) AS lat, ROUND(\"longitude\", 2) AS lon,\n         AVG(\"arithmetic_mean\") AS arithmetic_mean\n  FROM \"OPENAQ\".\"EPA_HISTORICAL_AIR_QUALITY\".\"PM25_NONFRM_DAILY_SUMMARY\" \n  WHERE \"parameter_name\" = 'Acceptable PM2.5 AQI & Speciation Mass' \n    AND \"units_of_measure\" = 'Micrograms/cubic meter (LC)'\n    AND EXTRACT(YEAR FROM \"date_local\") = 1990\n  GROUP BY ROUND(\"latitude\", 2), ROUND(\"longitude\", 2)\n),\noaq AS (\n  SELECT \"city\", \"value\", TO_TIMESTAMP(\"timestamp\" / 1000000) AS ts,\n         ROUND(\"latitude\", 2) AS lat, ROUND(\"longitude\", 2) AS lon\n  FROM \"OPENAQ\".\"OPENAQ\".\"GLOBAL_AIR_QUALITY\" \n  WHERE \"pollutant\" = 'pm25'\n    AND EXTRACT(YEAR FROM TO_TIMESTAMP(\"timestamp\" / 1000000)) = 2020\n)\nSELECT oaq.\"city\" AS city, \n       epa.arithmetic_mean,\n       oaq.\"value\" AS value,\n       CAST(oaq.ts AS DATE) AS timestamp,\n       epa.arithmetic_mean - oaq.\"value\" AS f0_\nFROM epa\nJOIN oaq ON epa.lat = oaq.lat AND epa.lon = oaq.lon\nORDER BY f0_ DESC\nLIMIT 3;") t ~= (sql%([PM25_NONFRM_DAILY_SUMMARY_schema, AIR_QUALITY_ANNUAL_SUMMARY_schema, GLOBAL_AIR_QUALITY_schema]) "SELECT oaq.\"city\", \n  epa.arithmetic_mean,\n  oaq.\"value\",\n  TO_DATE(TO_TIMESTAMP(oaq.\"timestamp\" / 1000000)) as timestamp,\n  ABS(epa.arithmetic_mean - oaq.\"value\") as f0_\nFROM (\n  SELECT ROUND(\"latitude\", 2) as lat, ROUND(\"longitude\", 2) as lon, \n    AVG(\"arithmetic_mean\") as arithmetic_mean\n  FROM \"OPENAQ\".\"EPA_HISTORICAL_AIR_QUALITY\".\"PM25_NONFRM_DAILY_SUMMARY\"\n  WHERE \"parameter_name\" = 'Acceptable PM2.5 AQI & Speciation Mass' \n    AND \"units_of_measure\" = 'Micrograms/cubic meter (LC)'\n    AND EXTRACT(YEAR FROM \"date_local\") = 1990\n  GROUP BY ROUND(\"latitude\", 2), ROUND(\"longitude\", 2)\n) epa\nINNER JOIN (\n  SELECT \"city\", \"value\", \"timestamp\", ROUND(\"latitude\", 2) as lat, ROUND(\"longitude\", 2) as lon\n  FROM \"OPENAQ\".\"OPENAQ\".\"GLOBAL_AIR_QUALITY\"\n  WHERE \"pollutant\" = 'pm25' \n    AND \"unit\" = 'µg/m³'\n    AND \"country\" = 'US'\n    AND EXTRACT(YEAR FROM TO_TIMESTAMP(\"timestamp\" / 1000000)) = 2020\n) oaq\nON epa.lat = oaq.lat AND epa.lon = oaq.lon\nORDER BY f0_ DESC\nLIMIT 3;") t := by
  intro t; first | sql_equiv | sorry

