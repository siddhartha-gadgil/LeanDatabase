/-!
# sf_bq022 — crossskill equivalence(s)

Question: Calculate the minimum and maximum trip duration in minutes (rounded to the nearest whole number), total number of trips, and average fare for each of six equal quantile groups based on trip duration, considering only trips between 0 and 60 minutes.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq022

CREATE TABLE TAXI_TRIPS («unique_key» STRING, «taxi_id» STRING, «trip_start_timestamp» INT, «trip_end_timestamp» INT, «trip_seconds» INT, «trip_miles» FLOAT, «pickup_census_tract» INT, «dropoff_census_tract» INT, «pickup_community_area» INT, «dropoff_community_area» INT, «fare» FLOAT, «tips» FLOAT, «tolls» FLOAT, «extras» FLOAT, «trip_total» FLOAT, «payment_type» STRING, «company» STRING, «pickup_latitude» FLOAT, «pickup_longitude» FLOAT, «pickup_location» STRING, «dropoff_latitude» FLOAT, «dropoff_longitude» FLOAT, «dropoff_location» STRING)

HYPOTHESIS hyp0_1_0 : TAXI_TRIPS "\"trip_seconds\" IS NOT NULL"
theorem eq_0_1 (t : TableRel TAXI_TRIPS_schema) (h0 : hyp0_1_0 t) :
    (sql%([TAXI_TRIPS_schema]) "WITH agg_by_seconds AS (\n  SELECT \n    \"trip_seconds\",\n    COUNT(*) AS row_cnt,\n    SUM(\"fare\") AS fare_sum,\n    COUNT(\"fare\") AS fare_cnt\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE \"trip_seconds\" IS NOT NULL \n    AND \"trip_seconds\" >= 0 \n    AND \"trip_seconds\" <= 3600\n  GROUP BY \"trip_seconds\"\n),\nwith_cumulative AS (\n  SELECT\n    \"trip_seconds\",\n    row_cnt,\n    fare_sum,\n    fare_cnt,\n    SUM(row_cnt) OVER (ORDER BY \"trip_seconds\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_end,\n    SUM(row_cnt) OVER (ORDER BY \"trip_seconds\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) - row_cnt + 1 AS cum_start\n  FROM agg_by_seconds\n),\ntotal AS (\n  SELECT SUM(row_cnt) AS n, MOD(SUM(row_cnt), 6) AS remainder FROM agg_by_seconds\n),\n-- NTILE boundary: group g contains rows from boundary(g-1)+1 to boundary(g)\n-- where boundary(g) = FLOOR(n/6)*g + LEAST(g, n%6)\n-- boundary(0) = 0\ngroups AS (\n  SELECT 1 AS grp UNION ALL SELECT 2 UNION ALL SELECT 3 \n  UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6\n),\ngroup_boundaries AS (\n  SELECT \n    g.grp,\n    FLOOR(t.n / 6.0) * (g.grp - 1) + LEAST(g.grp - 1, t.remainder) + 1 AS grp_start,\n    FLOOR(t.n / 6.0) * g.grp + LEAST(g.grp, t.remainder) AS grp_end\n  FROM groups g\n  CROSS JOIN total t\n),\nexpanded AS (\n  SELECT\n    c.\"trip_seconds\",\n    c.row_cnt,\n    c.fare_sum,\n    c.fare_cnt,\n    c.cum_start,\n    c.cum_end,\n    gb.grp AS quantile_group,\n    GREATEST(c.cum_start, gb.grp_start) AS overlap_start,\n    LEAST(c.cum_end, gb.grp_end) AS overlap_end\n  FROM with_cumulative c\n  CROSS JOIN group_boundaries gb\n  WHERE c.cum_start <= gb.grp_end\n    AND c.cum_end >= gb.grp_start\n)\nSELECT\n  ROUND(MIN(\"trip_seconds\" / 60.0), 1) AS min_minutes,\n  ROUND(MAX(\"trip_seconds\" / 60.0), 1) AS max_minutes,\n  SUM(overlap_end - overlap_start + 1) AS total_trips,\n  SUM(CASE WHEN fare_cnt > 0 THEN fare_sum * (overlap_end - overlap_start + 1) / row_cnt ELSE 0 END) \n    / SUM(overlap_end - overlap_start + 1) AS average_fare\nFROM expanded\nGROUP BY quantile_group\nORDER BY quantile_group;") t ~= (sql%([TAXI_TRIPS_schema]) "WITH per_second AS (\n  SELECT \n    \"trip_seconds\",\n    COUNT(*) as cnt,\n    SUM(\"fare\") as total_fare,\n    COUNT(\"fare\") as fare_count\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE \"trip_seconds\" >= 0 AND \"trip_seconds\" <= 3600\n  GROUP BY \"trip_seconds\"\n),\ncumulative AS (\n  SELECT \n    \"trip_seconds\",\n    cnt,\n    total_fare,\n    fare_count,\n    COALESCE(SUM(cnt) OVER (ORDER BY \"trip_seconds\" ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING), 0) as prev_cum,\n    SUM(cnt) OVER (ORDER BY \"trip_seconds\") as cum_cnt\n  FROM per_second\n),\n-- Total = 207933411\n-- Group boundaries (cumulative): g1=34655569, g2=69311138, g3=103966707, g4=138622275, g5=173277843, g6=207933411\n-- For each trip_seconds value, determine which group(s) it belongs to\n-- and how many rows are allocated to each group\nassignments AS (\n  SELECT\n    \"trip_seconds\",\n    cnt,\n    total_fare,\n    fare_count,\n    prev_cum,\n    cum_cnt,\n    g.grp,\n    -- group start boundary (exclusive)\n    CASE g.grp \n      WHEN 1 THEN 0\n      WHEN 2 THEN 34655569\n      WHEN 3 THEN 69311138\n      WHEN 4 THEN 103966707\n      WHEN 5 THEN 138622275\n      WHEN 6 THEN 173277843\n    END as grp_start,\n    -- group end boundary (inclusive)\n    CASE g.grp\n      WHEN 1 THEN 34655569\n      WHEN 2 THEN 69311138\n      WHEN 3 THEN 103966707\n      WHEN 4 THEN 138622275\n      WHEN 5 THEN 173277843\n      WHEN 6 THEN 207933411\n    END as grp_end\n  FROM cumulative\n  CROSS JOIN (SELECT 1 as grp UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6) g\n  -- Only keep groups that this trip_seconds value overlaps with\n  WHERE prev_cum < CASE g.grp WHEN 1 THEN 34655569 WHEN 2 THEN 69311138 WHEN 3 THEN 103966707 WHEN 4 THEN 138622275 WHEN 5 THEN 173277843 WHEN 6 THEN 207933411 END\n    AND cum_cnt > CASE g.grp WHEN 1 THEN 0 WHEN 2 THEN 34655569 WHEN 3 THEN 69311138 WHEN 4 THEN 103966707 WHEN 5 THEN 138622275 WHEN 6 THEN 173277843 END\n),\nallocated AS (\n  SELECT\n    grp,\n    \"trip_seconds\",\n    -- Number of rows from this trip_seconds allocated to this group\n    LEAST(cum_cnt, grp_end) - GREATEST(prev_cum, grp_start) as alloc_cnt,\n    cnt,\n    total_fare,\n    fare_count\n  FROM assignments\n)\nSELECT\n  MIN(\"trip_seconds\" / 60.0) AS min_minutes,\n  MAX(\"trip_seconds\" / 60.0) AS max_minutes,\n  SUM(alloc_cnt) AS total_trips,\n  SUM(total_fare * alloc_cnt / cnt) / SUM(CASE WHEN fare_count > 0 THEN alloc_cnt * fare_count / cnt ELSE 0 END) AS average_fare\nFROM allocated\nGROUP BY grp\nORDER BY grp;") t := by
  first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([TAXI_TRIPS_schema]) "WITH agg_by_seconds AS (\n  SELECT \n    \"trip_seconds\",\n    COUNT(*) AS row_cnt,\n    SUM(\"fare\") AS fare_sum,\n    COUNT(\"fare\") AS fare_cnt\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE \"trip_seconds\" IS NOT NULL \n    AND \"trip_seconds\" >= 0 \n    AND \"trip_seconds\" <= 3600\n  GROUP BY \"trip_seconds\"\n),\nwith_cumulative AS (\n  SELECT\n    \"trip_seconds\",\n    row_cnt,\n    fare_sum,\n    fare_cnt,\n    SUM(row_cnt) OVER (ORDER BY \"trip_seconds\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_end,\n    SUM(row_cnt) OVER (ORDER BY \"trip_seconds\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) - row_cnt + 1 AS cum_start\n  FROM agg_by_seconds\n),\ntotal AS (\n  SELECT SUM(row_cnt) AS n, MOD(SUM(row_cnt), 6) AS remainder FROM agg_by_seconds\n),\n-- NTILE boundary: group g contains rows from boundary(g-1)+1 to boundary(g)\n-- where boundary(g) = FLOOR(n/6)*g + LEAST(g, n%6)\n-- boundary(0) = 0\ngroups AS (\n  SELECT 1 AS grp UNION ALL SELECT 2 UNION ALL SELECT 3 \n  UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6\n),\ngroup_boundaries AS (\n  SELECT \n    g.grp,\n    FLOOR(t.n / 6.0) * (g.grp - 1) + LEAST(g.grp - 1, t.remainder) + 1 AS grp_start,\n    FLOOR(t.n / 6.0) * g.grp + LEAST(g.grp, t.remainder) AS grp_end\n  FROM groups g\n  CROSS JOIN total t\n),\nexpanded AS (\n  SELECT\n    c.\"trip_seconds\",\n    c.row_cnt,\n    c.fare_sum,\n    c.fare_cnt,\n    c.cum_start,\n    c.cum_end,\n    gb.grp AS quantile_group,\n    GREATEST(c.cum_start, gb.grp_start) AS overlap_start,\n    LEAST(c.cum_end, gb.grp_end) AS overlap_end\n  FROM with_cumulative c\n  CROSS JOIN group_boundaries gb\n  WHERE c.cum_start <= gb.grp_end\n    AND c.cum_end >= gb.grp_start\n)\nSELECT\n  ROUND(MIN(\"trip_seconds\" / 60.0), 1) AS min_minutes,\n  ROUND(MAX(\"trip_seconds\" / 60.0), 1) AS max_minutes,\n  SUM(overlap_end - overlap_start + 1) AS total_trips,\n  SUM(CASE WHEN fare_cnt > 0 THEN fare_sum * (overlap_end - overlap_start + 1) / row_cnt ELSE 0 END) \n    / SUM(overlap_end - overlap_start + 1) AS average_fare\nFROM expanded\nGROUP BY quantile_group\nORDER BY quantile_group;") t ~= (sql%([TAXI_TRIPS_schema]) "WITH agg AS (\n  SELECT \n    \"trip_seconds\" AS ts,\n    COUNT(*) AS cnt,\n    SUM(\"fare\") AS total_fare\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE \"trip_seconds\" IS NOT NULL \n    AND \"trip_seconds\" >= 0 \n    AND \"trip_seconds\" <= 3600\n  GROUP BY \"trip_seconds\"\n),\ncum AS (\n  SELECT \n    ts, cnt, total_fare,\n    SUM(cnt) OVER (ORDER BY ts ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_cnt,\n    SUM(cnt) OVER () AS N\n  FROM agg\n),\nwith_bounds AS (\n  SELECT\n    ts, cnt, total_fare, cum_cnt, N,\n    cum_cnt - cnt AS prev_cum,\n    FLOOR(N / 6.0)::INT AS base_size,\n    (N % 6)::INT AS remainder\n  FROM cum\n),\nassigned AS (\n  SELECT\n    ts, cnt, total_fare, cum_cnt, prev_cum, N, base_size, remainder,\n    -- NTILE group boundaries (1-based):\n    -- Group g starts at: (g-1)*base_size + LEAST(g-1, remainder) + 1\n    -- Group g ends at: g*base_size + LEAST(g, remainder)\n    -- For row r (1-based), ntile group = ?\n    -- We need to find which group the first and last row of this ts falls into\n    -- first_row = prev_cum + 1, last_row = cum_cnt\n    -- For a row r, group g satisfies: (g-1)*base_size + LEAST(g-1, remainder) < r <= g*base_size + LEAST(g, remainder)\n    -- Simplified: if r <= remainder * (base_size+1) then g = CEIL(r / (base_size+1))\n    --             else g = remainder + CEIL((r - remainder*(base_size+1)) / base_size)\n    0 AS placeholder\n  FROM with_bounds\n),\ngrp_boundaries AS (\n  -- Generate exact group boundaries for groups 1-6\n  SELECT \n    grp,\n    (grp - 1) * base_size + LEAST(grp - 1, remainder) + 1 AS grp_start,\n    grp * base_size + LEAST(grp, remainder) AS grp_end\n  FROM (SELECT DISTINCT base_size, remainder FROM assigned) params,\n  (SELECT 1 AS grp UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6) g\n),\n-- Now for each (ts, grp) pair where there's overlap, compute the number of rows\nts_grp AS (\n  SELECT\n    a.ts, a.cnt, a.total_fare, a.prev_cum, a.cum_cnt,\n    b.grp,\n    GREATEST(a.prev_cum + 1, b.grp_start) AS overlap_start,\n    LEAST(a.cum_cnt, b.grp_end) AS overlap_end\n  FROM assigned a\n  JOIN grp_boundaries b\n    ON a.cum_cnt >= b.grp_start AND a.prev_cum < b.grp_end\n),\nwith_rows AS (\n  SELECT\n    ts, cnt, total_fare, grp,\n    (overlap_end - overlap_start + 1) AS grp_rows\n  FROM ts_grp\n  WHERE overlap_end >= overlap_start\n)\nSELECT\n  ROUND(MIN(ts) / 60.0, 1) AS min_minutes,\n  ROUND(MAX(ts) / 60.0, 1) AS max_minutes,\n  SUM(grp_rows)::INT AS total_trips,\n  SUM(total_fare * grp_rows::FLOAT / cnt) / SUM(grp_rows) AS average_fare\nFROM with_rows\nGROUP BY grp\nORDER BY grp;") t := by
