import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf010 — crossskill equivalence(s)

Question: What are the cumulative ratios of mortgages near default in California for each recorded date in 2023, including those that are 90 to 180 days past due, in forbearance, or undergoing foreclosure, bankruptcy, or deed-in-lieu processes?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf010

CREATE TABLE FHFA_MORTGAGE_PERFORMANCE_TIMESERIES («DATE» STRING, «UNIT» STRING, «GEO_ID» STRING, «VARIABLE_NAME» STRING, «VARIABLE» STRING, «VALUE» FLOAT)
CREATE TABLE FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES («VARIABLE_GROUP» STRING, «UNIT» STRING, «FREQUENCY» STRING, «VARIABLE» STRING, «MARKET» STRING, «VARIABLE_NAME» STRING)
CREATE TABLE GEOGRAPHY_INDEX («LEVEL» STRING, «ISO_ALPHA2» STRING, «GEO_ID» STRING, «ISO_3166_2_CODE» STRING, «ISO_NUMERIC_CODE» STRING, «GEO_NAME» STRING, «ISO_NAME» STRING, «ISO_ALPHA3» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([FHFA_MORTGAGE_PERFORMANCE_TIMESERIES_schema, FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES_schema, GEOGRAPHY_INDEX_schema]) "SELECT t.\"DATE\", ROUND(SUM(t.\"VALUE\"), 3) AS \"PCT_NEAR_DEFAULT\" FROM \"US_REAL_ESTATE\".\"CYBERSYN\".\"FHFA_MORTGAGE_PERFORMANCE_TIMESERIES\" AS t JOIN \"US_REAL_ESTATE\".\"CYBERSYN\".\"FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES\" AS a ON t.\"VARIABLE\" = a.\"VARIABLE\" WHERE t.\"GEO_ID\" = 'geoId/06' AND EXTRACT(YEAR FROM t.\"DATE\") = 2023 AND a.\"VARIABLE_GROUP\" IN ('Percent 90 or More, Days Past Due Date', 'PFORB - Percent in Forbearance', 'Percent in the Process of Foreclosure, Bankruptcy, or Deed in Lieu') AND a.\"MARKET\" = 'All Mortgages' GROUP BY t.\"DATE\" ORDER BY t.\"DATE\"" = sql%([FHFA_MORTGAGE_PERFORMANCE_TIMESERIES_schema, FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES_schema, GEOGRAPHY_INDEX_schema]) "SELECT t.\"DATE\", SUM(t.\"VALUE\") AS \"PCT_NEAR_DEFAULT\" FROM \"US_REAL_ESTATE\".\"CYBERSYN\".\"FHFA_MORTGAGE_PERFORMANCE_TIMESERIES\" AS t JOIN \"US_REAL_ESTATE\".\"CYBERSYN\".\"FHFA_MORTGAGE_PERFORMANCE_ATTRIBUTES\" AS a ON t.\"VARIABLE\" = a.\"VARIABLE\" JOIN \"US_REAL_ESTATE\".\"CYBERSYN\".\"GEOGRAPHY_INDEX\" AS g ON t.\"GEO_ID\" = g.\"GEO_ID\" WHERE g.\"GEO_NAME\" = 'California' AND g.\"LEVEL\" = 'State' AND a.\"MARKET\" = 'All Mortgages' AND EXTRACT(YEAR FROM t.\"DATE\") = 2023 AND (a.\"VARIABLE_GROUP\" = 'Percent 90 or More, Days Past Due Date' OR a.\"VARIABLE_GROUP\" = 'PFORB - Percent in Forbearance' OR a.\"VARIABLE_GROUP\" = 'Percent in the Process of Foreclosure, Bankruptcy, or Deed in Lieu') GROUP BY t.\"DATE\" ORDER BY t.\"DATE\"" := by
  first | sql_equiv | sorry

