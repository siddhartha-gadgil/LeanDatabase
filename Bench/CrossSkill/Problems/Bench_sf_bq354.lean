/-!
# sf_bq354 — crossskill equivalence(s)

Question: Could you provide the percentage of participants for standard acne, atopic dermatitis, psoriasis, and vitiligo as defined by the International Classification of Diseases 10-CM (ICD-10-CM), including their subcategories? Please include all related concepts mapped to the standard ICD-10-CM codes (L70 for acne, L20 for atopic dermatitis, L40 for psoriasis, and L80 for vitiligo) by utilizing concept relationships, including descendant concepts. The percentage should be calculated based on the total number of participants, considering only the standard concepts and their related descendants.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq354

CREATE TABLE CONDITION_OCCURRENCE («condition_occurrence_id» INT, «person_id» INT, «condition_concept_id» INT, «condition_start_date» STRING, «condition_start_datetime» INT, «condition_end_date» STRING, «condition_end_datetime» INT, «condition_type_concept_id» INT, «stop_reason» STRING, «provider_id» INT, «visit_occurrence_id» INT, «visit_detail_id» INT, «condition_source_value» STRING, «condition_source_concept_id» INT, «condition_status_source_value» STRING, «condition_status_concept_id» INT)
CREATE TABLE PERSON («race_concept_id» INT, «ethnicity_concept_id» INT, «location_id» INT, «provider_id» INT, «care_site_id» INT, «person_source_value» STRING, «gender_source_value» STRING, «gender_source_concept_id» INT, «race_source_value» STRING, «race_source_concept_id» INT, «ethnicity_source_value» STRING, «ethnicity_source_concept_id» INT, «person_id» INT, «gender_concept_id» INT, «year_of_birth» INT, «month_of_birth» INT, «day_of_birth» INT, «birth_datetime» INT)
CREATE TABLE CONCEPT_ANCESTOR («ancestor_concept_id» INT, «descendant_concept_id» INT, «min_levels_of_separation» INT, «max_levels_of_separation» INT)
CREATE TABLE CONCEPT_RELATIONSHIP («concept_id_1» INT, «concept_id_2» INT, «relationship_id» STRING, «valid_start_date» STRING, «valid_end_date» STRING, «invalid_reason» STRING)
CREATE TABLE CONCEPT («concept_id» INT, «concept_name» STRING, «domain_id» STRING, «vocabulary_id» STRING, «concept_class_id» STRING, «standard_concept» STRING, «concept_code» STRING, «valid_start_date» STRING, «valid_end_date» STRING, «invalid_reason» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([CONDITION_OCCURRENCE_schema, PERSON_schema, CONCEPT_ANCESTOR_schema, CONCEPT_RELATIONSHIP_schema, CONCEPT_schema]) "WITH icd_codes AS (/* Find all ICD-10-CM codes and subcategories for the 4 conditions */ SELECT \"concept_id\", \"concept_code\", \"concept_name\", CASE WHEN \"concept_code\" LIKE 'L70%' THEN 'Acne' WHEN \"concept_code\" LIKE 'L20%' THEN 'Atopic Dermatitis' WHEN \"concept_code\" LIKE 'L40%' THEN 'Psoriasis' WHEN \"concept_code\" LIKE 'L80%' THEN 'Vitiligo' END AS condition_group FROM \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT\" WHERE \"vocabulary_id\" = 'ICD10CM' AND (\"concept_code\" LIKE 'L70%' OR \"concept_code\" LIKE 'L20%' OR \"concept_code\" LIKE 'L40%' OR \"concept_code\" LIKE 'L80%')), mapped_standard AS (/* Map each ICD-10-CM code to standard SNOMED concepts via concept relationships */ SELECT DISTINCT ic.condition_group, cr.\"concept_id_2\" AS standard_concept_id FROM icd_codes AS ic JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT_RELATIONSHIP\" AS cr ON ic.\"concept_id\" = cr.\"concept_id_1\" AND cr.\"relationship_id\" = 'Maps to' JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT\" AS c2 ON cr.\"concept_id_2\" = c2.\"concept_id\" AND c2.\"standard_concept\" = 'S'), all_related_concepts AS (/* Include the mapped standard concepts themselves */ SELECT condition_group, standard_concept_id AS concept_id FROM mapped_standard UNION /* Include all descendant concepts of those standard concepts */ SELECT ms.condition_group, ca.\"descendant_concept_id\" AS concept_id FROM mapped_standard AS ms JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT_ANCESTOR\" AS ca ON ms.standard_concept_id = ca.\"ancestor_concept_id\"), total_participants AS (SELECT COUNT(DISTINCT \"person_id\") AS total FROM \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"PERSON\") SELECT arc.condition_group AS CONDITION_NAME, COUNT(DISTINCT co.\"person_id\") AS PARTICIPANT_COUNT, tp.total AS TOTAL_PARTICIPANTS, ROUND(CAST(COUNT(DISTINCT co.\"person_id\") * 100.0 AS DOUBLE PRECISION) / tp.total, 2) AS PERCENTAGE FROM all_related_concepts AS arc JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONDITION_OCCURRENCE\" AS co ON co.\"condition_concept_id\" = arc.concept_id CROSS JOIN total_participants AS tp GROUP BY arc.condition_group, tp.total ORDER BY arc.condition_group") t ~= (sql%([CONDITION_OCCURRENCE_schema, PERSON_schema, CONCEPT_ANCESTOR_schema, CONCEPT_RELATIONSHIP_schema, CONCEPT_schema]) "WITH condition_labels AS (SELECT 'L70' AS icd_prefix, 'Acne' AS condition_name UNION ALL SELECT 'L20', 'Atopic dermatitis' UNION ALL SELECT 'L40', 'Psoriasis' UNION ALL SELECT 'L80', 'Vitiligo'), icd10_codes AS (/* Find all ICD-10-CM codes that start with the given prefix (parent + sub-codes) */ SELECT cl.icd_prefix, cl.condition_name, c.\"concept_id\" FROM condition_labels AS cl JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT\" AS c ON c.\"vocabulary_id\" = 'ICD10CM' AND c.\"concept_code\" LIKE cl.icd_prefix || '%'), standard_mapped AS (/* Map all ICD-10-CM codes to standard (SNOMED) concepts */ SELECT DISTINCT i.icd_prefix, i.condition_name, cr.\"concept_id_2\" AS standard_concept_id FROM icd10_codes AS i JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT_RELATIONSHIP\" AS cr ON cr.\"concept_id_1\" = i.\"concept_id\" AND cr.\"relationship_id\" = 'Maps to' JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT\" AS c2 ON c2.\"concept_id\" = cr.\"concept_id_2\" AND c2.\"standard_concept\" = 'S'), all_descendants AS (/* Get all descendant concepts for each standard concept */ SELECT DISTINCT sm.icd_prefix, sm.condition_name, ca.\"descendant_concept_id\" AS concept_id FROM standard_mapped AS sm JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONCEPT_ANCESTOR\" AS ca ON ca.\"ancestor_concept_id\" = sm.standard_concept_id), total_participants AS (SELECT COUNT(DISTINCT \"person_id\") AS total FROM \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"PERSON\"), condition_counts AS (SELECT ad.condition_name, COUNT(DISTINCT co.\"person_id\") AS participant_count FROM all_descendants AS ad JOIN \"CMS_DATA\".\"CMS_SYNTHETIC_PATIENT_DATA_OMOP\".\"CONDITION_OCCURRENCE\" AS co ON co.\"condition_concept_id\" = ad.concept_id GROUP BY ad.condition_name) SELECT cc.condition_name AS \"CONDITION_NAME\", cc.participant_count AS \"PARTICIPANT_COUNT\", tp.total AS \"TOTAL_PARTICIPANTS\", ROUND(CAST(100.0 * cc.participant_count AS DOUBLE PRECISION) / tp.total, 2) AS \"PERCENTAGE\" FROM condition_counts AS cc CROSS JOIN total_participants AS tp ORDER BY cc.condition_name") t := by
