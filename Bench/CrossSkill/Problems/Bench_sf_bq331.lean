IN avg_score AS a JOIN \"META_KAGGLE\".\"META_KAGGLE\".\"USERS\" AS u ON u.\"Id\" = r.\"PostUserId\" WHERE r.rn <= 3 ORDER BY r.rn") t := by
  intro t; first | sql_equiv | sorry

