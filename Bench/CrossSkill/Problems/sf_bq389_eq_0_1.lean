D FROM pm10 AS p JOIN pm25_frm AS f ON p.month = f.month JOIN pm25_nonfrm AS n ON p.month = n.month JOIN voc AS v ON p.month = v.month JOIN so2 AS s ON p.month = s.month JOIN lead_data AS l ON p.month = l.month ORDER BY p.month") t0 t1 t2 t3 t4 t5
