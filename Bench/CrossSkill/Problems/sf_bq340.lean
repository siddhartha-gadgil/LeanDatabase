/-!
# sf_bq340 — crossskill equivalence(s)

Question: Which six Ethereum addresses, excluding '0x0000000000000000000000000000000000000000', have the largest absolute differences between their previous and current balances from the tokens at addresses '0x0d8775f648430679a709e98d2b0cb6250d2887ef0' and '0x1e15c05cbad367f044cbfbafda3d9a1510db5513'?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq340

CREATE TABLE TOKEN_TRANSFERS («token_address» STRING, «from_address» STRING, «to_address» STRING, «value» STRING, «transaction_hash» STRING, «log_index» INT, «block_timestamp» INT, «block_number» INT, «block_hash» STRING)

HYPOTHESIS hyp0_1_0 : TOKEN_TRANSFERS "\"token_address\" IN ('0x0d8775f648430679a709e98d2b0cb6250d2887ef0', '0x1e15c05cbad367f044cbfbafda3d9a1510db5513')"
theorem eq_0_1 (t : TableRel TOKEN_TRANSFERS_schema) (h0 : hyp0_1_0 t) :
    (sql%([TOKEN_TRANSFERS_schema]) "WITH all_transfers AS (SELECT \"to_address\" AS addr, CAST(\"value\" AS DECIMAL(38, 0)) AS val, \"block_number\", \"log_index\" FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\" WHERE \"token_address\" IN ('0x0d8775f648430679a709e98d2b0cb6250d2887ef0', '0x1e15c05cbad367f044cbfbafda3d9a1510db5513') UNION ALL SELECT \"from_address\" AS addr, CAST(\"value\" AS DECIMAL(38, 0)) AS val, \"block_number\", \"log_index\" FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\" WHERE \"token_address\" IN ('0x0d8775f648430679a709e98d2b0cb6250d2887ef0', '0x1e15c05cbad367f044cbfbafda3d9a1510db5513')), ranked AS (SELECT addr, val, ROW_NUMBER() OVER (PARTITION BY addr ORDER BY \"block_number\" DESC, \"log_index\" DESC) AS rn FROM all_transfers WHERE addr <> '0x0000000000000000000000000000000000000000') SELECT addr AS ADDRESS FROM ranked WHERE rn = 1 ORDER BY val DESC LIMIT 6") t ~= (sql%([TOKEN_TRANSFERS_schema]) "/* For each transfer, unpack into per-address balance events */ /* Compute running balance (previous and current) for each address per token */ /* Take the LAST event per address, rank by absolute difference, return top 6 */ WITH events AS (/* Receiver gains value */ SELECT \"to_address\" AS address, \"token_address\", \"block_number\", \"log_index\", CAST(\"value\" AS DECIMAL(38, 0)) AS delta FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\" WHERE \"token_address\" IN ('0x0d8775f648430679a709e98d2b0cb6250d2887ef0', '0x1e15c05cbad367f044cbfbafda3d9a1510db5513') AND \"to_address\" <> '0x0000000000000000000000000000000000000000' UNION ALL /* Sender loses value */ SELECT \"from_address\" AS address, \"token_address\", \"block_number\", \"log_index\", -CAST(\"value\" AS DECIMAL(38, 0)) AS delta FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TOKEN_TRANSFERS\" WHERE \"token_address\" IN ('0x0d8775f648430679a709e98d2b0cb6250d2887ef0', '0x1e15c05cbad367f044cbfbafda3d9a1510db5513') AND \"from_address\" <> '0x0000000000000000000000000000000000000000'), running AS (SELECT address, \"token_address\", \"block_number\", \"log_index\", delta, SUM(delta) OVER (PARTITION BY address, \"token_address\" ORDER BY \"block_number\", \"log_index\") AS current_balance, SUM(delta) OVER (PARTITION BY address, \"token_address\" ORDER BY \"block_number\", \"log_index\") - delta AS previous_balance, ROW_NUMBER() OVER (PARTITION BY address, \"token_address\" ORDER BY \"block_number\" DESC, \"log_index\" DESC) AS rn FROM events), last_event AS (SELECT address, previous_balance, current_balance, ABS(current_balance - previous_balance) AS abs_diff FROM running WHERE rn = 1) SELECT address AS ADDRESS FROM last_event ORDER BY abs_diff DESC LIMIT 6") t := by
  first | sql_equiv | sorry

