amId\" WHEN g.\"pitcherId\" IN (g.\"awayFielder1\", g.\"awayFielder2\", g.\"awayFielder3\", g.\"awayFielder4\", g.\"awayFielder5\", g.\"awayFielder6\", g.\"awayFielder7\", g.\"awayFielder8\", g.\"awayFielder9\", g.\"awayFielder10\", g.\"awayFielder11\", g.\"awayFielder12\") THEN s.\"awayTeamId\" END AS team_id, CASE WHEN g.\"pitcherId\" IN (g.\"homeFielder1\", g.\"homeFielder2\", g.\"homeFielder3\", g.\"homeFielder4\", g.\"homeFielder5\", g.\"homeFielder6\", g.\"homeFielder7\", g.\"homeFielder8\", g.\"homeFielder9\", g.\"homeFielder10\", g.\"homeFielder11\", g.\"homeFielder12\") THEN s.\"homeTeamName\" WHEN g.\"pitcherId\" IN (g.\"awayFielder1\", g.\"awayFielder2\", g.\"awayFielder3\", g.\"awayFielder4\", g.\"awayFielder5\", g.\"awayFielder6\", g.\"awayFielder7\", g.\"awayFielder8\", g.\"awayFielder9\", g.\"awayFielder10\", g.\"awayFielder11\", g.\"awayFielder12\") THEN s.\"awayTeamName\" END AS team_name FROM \"MLB\".\"BASEBALL\".\"GAMES_POST_WIDE\" AS g INNER JOIN \"MLB\".\"BASEBALL\".\"SCHEDULES\" AS s ON g.\"gameId\" = s.\"gameId\" WHERE g.\"pitchSpeed\" > 0), filtered AS (SELECT * FROM all_pitches WHERE NOT team_id IS NULL AND NOT team_name IN ('American League', 'National League')), ranked AS (SELECT team_id AS \"teamId\", team_name AS \"teamName\", \"pitcherId\", \"pitcherFirstName\", \"pitcherLastName\", \"pitchSpeed\" AS \"maxPitchSpeed\", ROW_NUMBER() OVER (PARTITION BY team_id ORDER BY \"pitchSpeed\" DESC, \"pitcherId\" ASC) AS rn FROM filtered) SELECT \"teamId\", \"teamName\", \"pitcherId\", \"pitcherFirstName\", \"pitcherLastName\", \"maxPitchSpeed\" FROM ranked WHERE rn = 1 ORDER BY \"teamName\"") t0 t1 t2
