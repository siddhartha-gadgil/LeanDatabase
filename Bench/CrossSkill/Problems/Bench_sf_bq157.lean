 LEFT JOIN tp53_patients tp ON p.\"ParticipantBarcode\" = tp.\"ParticipantBarcode\"\n),\n\ngroup_stats AS (\n    -- Compute N, sum, sum of squares for each group\n    SELECT \n        mutation_group,\n        COUNT(*) AS N,\n        SUM(avg_log_expr) AS S,\n        SUM(avg_log_expr * avg_log_expr) AS Q\n    FROM patient_groups\n    GROUP BY mutation_group\n),\n\npivoted AS (\n    -- Pivot to get Y and N stats side by side\n    SELECT\n        MAX(CASE WHEN mutation_group = 'Y' THEN N END) AS Ny,\n        MAX(CASE WHEN mutation_group = 'N' THEN N END) AS Nn,\n        MAX(CASE WHEN mutation_group = 'Y' THEN S END) AS Sy,\n        MAX(CASE WHEN mutation_group = 'N' THEN S END) AS Sn,\n        MAX(CASE WHEN mutation_group = 'Y' THEN Q END) AS Qy,\n        MAX(CASE WHEN mutation_group = 'N' THEN Q END) AS Qn\n    FROM group_stats\n)\n\nSELECT \n    Ny AS NY,\n    Nn AS NN,\n    Sy / Ny AS AVG_Y,\n    Sn / Nn AS AVG_N,\n    -- Welch's t-test: t = (avg_y - avg_n) / sqrt(var_y/Ny + var_n/Nn)\n    -- var = (Q - S^2/N) / (N - 1)\n    (Sy/Ny - Sn/Nn) / SQRT(\n        ((Qy - (Sy * Sy / Ny)) / (Ny - 1)) / Ny +\n        ((Qn - (Sn * Sn / Nn)) / (Nn - 1)) / Nn\n    ) AS TSCORE\nFROM pivoted;") t ~= (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "WITH drg2_expr AS (\n    -- DRG2 gene expression per LGG patient: average log10(normalized_count+1) across samples\n    SELECT \"ParticipantBarcode\",\n           AVG(LOG(10, \"normalized_count\" + 1)) AS avg_expr\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\"\n    WHERE \"Study\" = 'LGG' AND \"Symbol\" = 'DRG2'\n    GROUP BY \"ParticipantBarcode\"\n),\ntp53_mutated AS (\n    -- LGG participants with TP53 mutation (PASS filter)\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG' AND \"Hugo_Symbol\" = 'TP53' AND \"FILTER\" = 'PASS'\n),\nmc3_participants AS (\n    -- All LGG participants from MC3\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG'\n),\npatient_data AS (\n    -- Only patients with DRG2 expression who are in MC3\n    SELECT d.\"ParticipantBarcode\",\n           d.avg_expr,\n           CASE WHEN t.\"ParticipantBarcode\" IS NOT NULL THEN 'Y' ELSE 'N' END AS has_tp53\n    FROM drg2_expr d\n    INNER JOIN mc3_participants m ON d.\"ParticipantBarcode\" = m.\"ParticipantBarcode\"\n    LEFT JOIN tp53_mutated t ON d.\"ParticipantBarcode\" = t.\"ParticipantBarcode\"\n),\nstats AS (\n    SELECT\n        COUNT(CASE WHEN has_tp53 = 'Y' THEN 1 END) AS NY,\n        COUNT(CASE WHEN has_tp53 = 'N' THEN 1 END) AS NN,\n        AVG(CASE WHEN has_tp53 = 'Y' THEN avg_expr END) AS AVG_Y,\n        AVG(CASE WHEN has_tp53 = 'N' THEN avg_expr END) AS AVG_N,\n        VARIANCE(CASE WHEN has_tp53 = 'Y' THEN avg_expr END) AS VAR_Y,\n        VARIANCE(CASE WHEN has_tp53 = 'N' THEN avg_expr END) AS VAR_N\n    FROM patient_data\n)\nSELECT\n    NY,\n    NN,\n    AVG_Y,\n    AVG_N,\n    (AVG_Y - AVG_N) / SQRT(VAR_Y / NY + VAR_N / NN) AS TSCORE\nFROM stats;") t := by
