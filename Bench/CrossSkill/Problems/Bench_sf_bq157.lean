 AS NY,\n  MAX(CASE WHEN has_tp53 = 0 THEN n END) AS NN,\n  MAX(CASE WHEN has_tp53 = 1 THEN mean_expr END) AS AVG_Y,\n  MAX(CASE WHEN has_tp53 = 0 THEN mean_expr END) AS AVG_N,\n  (MAX(CASE WHEN has_tp53 = 1 THEN mean_expr END) - MAX(CASE WHEN has_tp53 = 0 THEN mean_expr END)) /\n  SQRT(\n    MAX(CASE WHEN has_tp53 = 1 THEN var_expr END) / MAX(CASE WHEN has_tp53 = 1 THEN n END) +\n    MAX(CASE WHEN has_tp53 = 0 THEN var_expr END) / MAX(CASE WHEN has_tp53 = 0 THEN n END)\n  ) AS TSCORE\nFROM group_stats;" = sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "-- Step 1: Get all distinct LGG patients from the MC3 mutation table\n-- Step 2: Get DRG2 expression for those patients, joining on ParticipantBarcode\n-- Step 3: For each patient, compute AVG(LOG10(normalized_count + 1))\n-- Step 4: Identify TP53-mutated patients (Hugo_Symbol='TP53', FILTER='PASS', Study='LGG')\n-- Step 5: Split into two groups and compute Welch's T-test\n\nWITH\n-- All LGG patients present in MC3 table\nlgg_patients AS (\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG'\n),\n\n-- TP53-mutated LGG patients\ntp53_mutated AS (\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG'\n      AND \"Hugo_Symbol\" = 'TP53'\n      AND \"FILTER\" = 'PASS'\n),\n\n-- DRG2 expression for LGG patients present in MC3, averaged per patient\npatient_expr AS (\n    SELECT\n        e.\"ParticipantBarcode\",\n        AVG(LOG(10, e.\"normalized_count\" + 1)) AS avg_log_expr\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" e\n    INNER JOIN lgg_patients lp ON e.\"ParticipantBarcode\" = lp.\"ParticipantBarcode\"\n    WHERE e.\"Study\" = 'LGG'\n      AND e.\"Symbol\" = 'DRG2'\n    GROUP BY e.\"ParticipantBarcode\"\n),\n\n-- Tag each patient with TP53 mutation status\npatient_tagged AS (\n    SELECT\n        pe.\"ParticipantBarcode\",\n        pe.avg_log_expr,\n        CASE WHEN tp.\"ParticipantBarcode\" IS NOT NULL THEN 'Y' ELSE 'N' END AS has_tp53\n    FROM patient_expr pe\n    LEFT JOIN tp53_mutated tp ON pe.\"ParticipantBarcode\" = tp.\"ParticipantBarcode\"\n),\n\n-- Compute group statistics\ngroup_stats AS (\n    SELECT\n        has_tp53,\n        COUNT(*) AS n,\n        AVG(avg_log_expr) AS mean_val,\n        VARIANCE(avg_log_expr) AS var_val\n    FROM patient_tagged\n    GROUP BY has_tp53\n),\n\n-- Pivot to get Y and N stats side by side\nstats_y AS (\n    SELECT n AS n_y, mean_val AS avg_y, var_val AS var_y\n    FROM group_stats WHERE has_tp53 = 'Y'\n),\nstats_n AS (\n    SELECT n AS n_n, mean_val AS avg_n, var_val AS var_n\n    FROM group_stats WHERE has_tp53 = 'N'\n)\n\nSELECT\n    sy.n_y AS NY,\n    sn.n_n AS NN,\n    sy.avg_y AS AVG_Y,\n    sn.avg_n AS AVG_N,\n    (sy.avg_y - sn.avg_n) / SQRT(sy.var_y / sy.n_y + sn.var_n / sn.n_n) AS TSCORE\nFROM stats_y sy, stats_n sn;" := by
