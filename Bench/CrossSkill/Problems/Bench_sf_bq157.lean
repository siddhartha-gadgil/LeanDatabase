CREATE TABLE MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE («ParticipantBarcode» STRING, «Tumor_SampleBarcode» STRING, «Tumor_AliquotBarcode» STRING, «Normal_SampleBarcode» STRING, «Normal_AliquotBarcode» STRING, «Normal_SampleTypeLetterCode» STRING, «Study» STRING, «Hugo_Symbol» STRING, «HGVSp_Short» STRING, «Variant_Classification» STRING, «HGVSc» STRING, «CENTERS» STRING, «FILTER» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "-- Compute T-score for DRG2 expression difference between LGG patients with/without TP53 mutation\n-- Uses Welch's t-test: T = (mean_y - mean_n) / sqrt(var_y/n_y + var_n/n_n)\n-- y = WITH TP53 mutation, n = WITHOUT TP53 mutation\n\nWITH tp53_patients AS (\n  -- Identify LGG patients with TP53 mutations (PASS filter)\n  SELECT DISTINCT \"ParticipantBarcode\"\n  FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n  WHERE \"Study\" = 'LGG'\n    AND \"Hugo_Symbol\" = 'TP53'\n    AND \"FILTER\" = 'PASS'\n),\n\nlgg_samples AS (\n  -- All LGG tumor sample barcodes in MC3_MAF\n  SELECT DISTINCT \"Tumor_SampleBarcode\"\n  FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n  WHERE \"Study\" = 'LGG'\n),\n\npatient_expr AS (\n  -- For each patient, compute average log10(normalized_count + 1) of DRG2\n  -- Only using samples present in MC3_MAF for LGG\n  SELECT\n    e.\"ParticipantBarcode\",\n    AVG(LOG(10, e.\"normalized_count\" + 1)) AS avg_log_expr,\n    CASE WHEN tp53.\"ParticipantBarcode\" IS NOT NULL THEN 1 ELSE 0 END AS has_tp53\n  FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" e\n  INNER JOIN lgg_samples ls\n    ON e.\"SampleBarcode\" = ls.\"Tumor_SampleBarcode\"\n  LEFT JOIN tp53_patients tp53\n    ON e.\"ParticipantBarcode\" = tp53.\"ParticipantBarcode\"\n  WHERE e.\"Symbol\" = 'DRG2'\n    AND e.\"Study\" = 'LGG'\n  GROUP BY e.\"ParticipantBarcode\",\n           CASE WHEN tp53.\"ParticipantBarcode\" IS NOT NULL THEN 1 ELSE 0 END\n),\n\ngroup_stats AS (\n  -- Compute group-level statistics\n  SELECT\n    has_tp53,\n    COUNT(*) AS n,\n    AVG(avg_log_expr) AS mean_expr,\n    VARIANCE(avg_log_expr) AS var_expr\n  FROM patient_expr\n  GROUP BY has_tp53\n)\n\nSELECT\n  MAX(CASE WHEN has_tp53 = 1 THEN n END) AS NY,\n  MAX(CASE WHEN has_tp53 = 0 THEN n END) AS NN,\n  MAX(CASE WHEN has_tp53 = 1 THEN mean_expr END) AS AVG_Y,\n  MAX(CASE WHEN has_tp53 = 0 THEN mean_expr END) AS AVG_N,\n  (MAX(CASE WHEN has_tp53 = 1 THEN mean_expr END) - MAX(CASE WHEN has_tp53 = 0 THEN mean_expr END)) /\n  SQRT(\n    MAX(CASE WHEN has_tp53 = 1 THEN var_expr END) / MAX(CASE WHEN has_tp53 = 1 THEN n END) +\n    MAX(CASE WHEN has_tp53 = 0 THEN var_expr END) / MAX(CASE WHEN has_tp53 = 0 THEN n END)\n  ) AS TSCORE\nFROM group_stats;") t ~= (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "-- Welch's t-test for DRG2 gene expression between LGG patients with and without TP53 mutation\n-- Step 1: Get all MC3 LGG sample barcodes\n-- Step 2: Join to gene expression for DRG2 to get per-patient avg log10(normalized_count+1)\n-- Step 3: Split by TP53 mutation status\n-- Step 4: Compute Welch's t-test\n\nWITH mc3_samples AS (\n    -- All distinct tumor sample barcodes for LGG patients in MC3\n    SELECT DISTINCT \"Tumor_SampleBarcode\", \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG'\n),\n\ntp53_patients AS (\n    -- LGG patients with TP53 mutation (FILTER='PASS')\n    SELECT DISTINCT \"ParticipantBarcode\"\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\"\n    WHERE \"Study\" = 'LGG' \n      AND \"Hugo_Symbol\" = 'TP53' \n      AND \"FILTER\" = 'PASS'\n),\n\ndrg2_expression AS (\n    -- DRG2 gene expression for LGG samples that are present in MC3\n    SELECT g.\"ParticipantBarcode\",\n           g.\"SampleBarcode\",\n           LOG(10, g.\"normalized_count\" + 1) AS log_expr\n    FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" g\n    INNER JOIN mc3_samples m ON g.\"SampleBarcode\" = m.\"Tumor_SampleBarcode\"\n    WHERE g.\"Study\" = 'LGG' \n      AND g.\"Symbol\" = 'DRG2'\n),\n\npatient_avg_expr AS (\n    -- Per-patient average DRG2 expression\n    SELECT \"ParticipantBarcode\",\n           AVG(log_expr) AS avg_log_expr\n    FROM drg2_expression\n    GROUP BY \"ParticipantBarcode\"\n),\n\npatient_groups AS (\n    -- Tag each patient as Y (TP53 mutated) or N (not mutated)\n    SELECT p.avg_log_expr,\n           CASE WHEN tp.\"ParticipantBarcode\" IS NOT NULL THEN 'Y' ELSE 'N' END AS mutation_group\n    FROM patient_avg_expr p\n    LEFT JOIN tp53_patients tp ON p.\"ParticipantBarcode\" = tp.\"ParticipantBarcode\"\n),\n\ngroup_stats AS (\n    -- Compute N, sum, sum of squares for each group\n    SELECT \n        mutation_group,\n        COUNT(*) AS N,\n        SUM(avg_log_expr) AS S,\n        SUM(avg_log_expr * avg_log_expr) AS Q\n    FROM patient_groups\n    GROUP BY mutation_group\n),\n\npivoted AS (\n    -- Pivot to get Y and N stats side by side\n    SELECT\n        MAX(CASE WHEN mutation_group = 'Y' THEN N END) AS Ny,\n        MAX(CASE WHEN mutation_group = 'N' THEN N END) AS Nn,\n        MAX(CASE WHEN mutation_group = 'Y' THEN S END) AS Sy,\n        MAX(CASE WHEN mutation_group = 'N' THEN S END) AS Sn,\n        MAX(CASE WHEN mutation_group = 'Y' THEN Q END) AS Qy,\n        MAX(CASE WHEN mutation_group = 'N' THEN Q END) AS Qn\n    FROM group_stats\n)\n\nSELECT \n    Ny AS NY,\n    Nn AS NN,\n    Sy / Ny AS AVG_Y,\n    Sn / Nn AS AVG_N,\n    -- Welch's t-test: t = (avg_y - avg_n) / sqrt(var_y/Ny + var_n/Nn)\n    -- var = (Q - S^2/N) / (N - 1)\n    (Sy/Ny - Sn/Nn) / SQRT(\n        ((Qy - (Sy * Sy / Ny)) / (Ny - 1)) / Ny +\n        ((Qn - (Sn * Sn / Nn)) / (Nn - 1)) / Nn\n    ) AS TSCORE\nFROM pivoted;") t := by
  intro t; first | sql_equiv | sorry

