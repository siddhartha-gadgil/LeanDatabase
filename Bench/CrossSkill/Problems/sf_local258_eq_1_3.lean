namespace N_sf_local258_eq_1_3

CREATE TABLE PLAYER («player_id» INT, «player_name» STRING, «dob» STRING, «batting_hand» STRING, «bowling_skill» STRING, «country_name» STRING)
CREATE TABLE BATSMAN_SCORED («match_id» INT, «over_id» INT, «ball_id» INT, «runs_scored» INT, «innings_no» INT)
CREATE TABLE WICKET_TAKEN («match_id» INT, «over_id» INT, «ball_id» INT, «player_out» INT, «kind_out» STRING, «innings_no» INT)
CREATE TABLE BALL_BY_BALL («match_id» INT, «over_id» INT, «ball_id» INT, «innings_no» INT, «team_batting» INT, «team_bowling» INT, «striker_batting_position» INT, «striker» INT, «non_striker» INT, «bowler» INT)
CREATE TABLE EXTRA_RUNS («match_id» INT, «over_id» INT, «ball_id» INT, «extra_type» STRING, «extra_runs» INT, «innings_no» INT)
CREATE TABLE MATCH («match_id» INT, «team_1» INT, «team_2» INT, «match_date» STRING, «season_id» INT, «venue» STRING, «toss_winner» INT, «toss_decision» STRING, «win_type» STRING, «win_margin» INT, «outcome_type» STRING, «match_winner» INT, «man_of_the_match» INT)

theorem eq (t0 : TableRel PLAYER_schema) (t1 : TableRel BATSMAN_SCORED_schema) (t2 : TableRel WICKET_TAKEN_schema) (t3 : TableRel BALL_BY_BALL_schema) (t4 : TableRel EXTRA_RUNS_schema) (t5 : TableRel MATCH_schema) :
    (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema, MATCH_schema]) "WITH bowler_balls AS (/* Base: every ball bowled, with runs scored and extras info */ SELECT b.\"bowler\", b.\"match_id\", b.\"over_id\", b.\"ball_id\", b.\"innings_no\", COALESCE(bs.\"runs_scored\", 0) AS runs_scored, e.\"extra_type\", CASE WHEN e.\"extra_type\" IN ('wides', 'noballs') THEN 0 ELSE 1 END AS is_legal FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b LEFT JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" AS bs ON b.\"match_id\" = bs.\"match_id\" AND b.\"over_id\" = bs.\"over_id\" AND b.\"ball_id\" = bs.\"ball_id\" AND b.\"innings_no\" = bs.\"innings_no\" LEFT JOIN \"IPL\".\"IPL\".\"EXTRA_RUNS\" AS e ON b.\"match_id\" = e.\"match_id\" AND b.\"over_id\" = e.\"over_id\" AND b.\"ball_id\" = e.\"ball_id\" AND b.\"innings_no\" = e.\"innings_no\"), bowler_wickets AS (/* Wickets attributed to the bowler (excluding run out, retired hurt, obstructing the field) */ SELECT b.\"bowler\", b.\"match_id\", w.\"kind_out\" FROM \"IPL\".\"IPL\".\"WICKET_TAKEN\" AS w JOIN \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b ON w.\"match_id\" = b.\"match_id\" AND w.\"over_id\" = b.\"over_id\" AND w.\"ball_id\" = b.\"ball_id\" AND w.\"innings_no\" = b.\"innings_no\" WHERE NOT w.\"kind_out\" IN ('run out', 'retired hurt', 'obstructing the field')), bowler_overall /* Overall stats per bowler */ AS (SELECT bb.\"bowler\", SUM(bb.runs_scored) AS total_runs_conceded, SUM(bb.is_legal) AS legal_balls FROM bowler_balls AS bb GROUP BY bb.\"bowler\"), bowler_total_wickets AS (SELECT bw.\"bowler\", COUNT(*) AS total_wickets FROM bowler_wickets AS bw GROUP BY bw.\"bowler\"), bowler_match_runs /* Per match stats for best bowling */ AS (SELECT bb.\"bowler\", bb.\"match_id\", SUM(bb.runs_scored) AS match_runs FROM bowler_balls AS bb GROUP BY bb.\"bowler\", bb.\"match_id\"), bowler_match_wickets AS (SELECT bw.\"bowler\", bw.\"match_id\", COUNT(*) AS match_wickets FROM bowler_wickets AS bw GROUP BY bw.\"bowler\", bw.\"match_id\"), bowler_match_combined AS (SELECT bmr.\"bowler\", bmr.\"match_id\", COALESCE(bmw.match_wickets, 0) AS match_wickets, bmr.match_runs FROM bowler_match_runs AS bmr LEFT JOIN bowler_match_wickets AS bmw ON bmr.\"bowler\" = bmw.\"bowler\" AND bmr.\"match_id\" = bmw.\"match_id\"), best_bowling AS (SELECT bmc.\"bowler\", bmc.match_wickets, bmc.match_runs, ROW_NUMBER() OVER (PARTITION BY bmc.\"bowler\" ORDER BY bmc.match_wickets DESC, bmc.match_runs ASC) AS rn FROM bowler_match_combined AS bmc WHERE bmc.match_wickets > 0) SELECT p.\"player_name\", COALESCE(btw.total_wickets, 0) AS TOTAL_WICKETS, ROUND(CAST(bo.total_runs_conceded * 6.0 AS DOUBLE PRECISION) / bo.legal_balls, 4) AS ECONOMY_RATE, CASE WHEN COALESCE(btw.total_wickets, 0) > 0 THEN ROUND(CAST(bo.legal_balls * 1.0 AS DOUBLE PRECISION) / btw.total_wickets, 4) ELSE NULL END AS STRIKE_RATE, CASE WHEN NOT bb.match_wickets IS NULL THEN bb.match_wickets || '-' || bb.match_runs ELSE NULL END AS BEST_BOWLING FROM bowler_overall AS bo JOIN \"IPL\".\"IPL\".\"PLAYER\" AS p ON bo.\"bowler\" = p.\"player_id\" LEFT JOIN bowler_total_wickets AS btw ON bo.\"bowler\" = btw.\"bowler\" LEFT JOIN best_bowling AS bb ON bo.\"bowler\" = bb.\"bowler\" AND bb.rn = 1 ORDER BY p.\"player_name\"") t0 t1 t2 t3 t4 t5
  ~= (sql%([PLAYER_schema, BATSMAN_SCORED_schema, WICKET_TAKEN_schema, BALL_BY_BALL_schema, EXTRA_RUNS_schema, MATCH_schema]) "WITH ball_extras AS (/* Join BALL_BY_BALL with EXTRA_RUNS to identify wides and noballs */ SELECT b.\"match_id\", b.\"over_id\", b.\"ball_id\", b.\"innings_no\", b.\"bowler\", CASE WHEN er.\"extra_type\" = 'wides' THEN 1 ELSE 0 END AS is_wide, CASE WHEN er.\"extra_type\" = 'noballs' THEN 1 ELSE 0 END AS is_noball FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b LEFT JOIN \"IPL\".\"IPL\".\"EXTRA_RUNS\" AS er ON b.\"match_id\" = er.\"match_id\" AND b.\"over_id\" = er.\"over_id\" AND b.\"ball_id\" = er.\"ball_id\" AND b.\"innings_no\" = er.\"innings_no\"), bowler_balls AS (/* Per bowler: total balls, legal balls */ SELECT be.\"bowler\" AS player_id, COUNT(*) AS total_balls, SUM(1 - be.is_wide - be.is_noball) AS legal_balls FROM ball_extras AS be GROUP BY be.\"bowler\"), bowler_runs AS (/* Per bowler: total runs conceded (from BATSMAN_SCORED) */ SELECT b.\"bowler\" AS player_id, SUM(bs.\"runs_scored\") AS bat_runs FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" AS bs ON b.\"match_id\" = bs.\"match_id\" AND b.\"over_id\" = bs.\"over_id\" AND b.\"ball_id\" = bs.\"ball_id\" AND b.\"innings_no\" = bs.\"innings_no\" GROUP BY b.\"bowler\"), bowler_wickets AS (/* Per bowler: total wickets (excluding run out, retired hurt, obstructing the field) */ SELECT b.\"bowler\" AS player_id, COUNT(*) AS total_wickets FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" AS wt ON b.\"match_id\" = wt.\"match_id\" AND b.\"over_id\" = wt.\"over_id\" AND b.\"ball_id\" = wt.\"ball_id\" AND b.\"innings_no\" = wt.\"innings_no\" WHERE NOT wt.\"kind_out\" IN ('run out', 'retired hurt', 'obstructing the field') GROUP BY b.\"bowler\"), match_wickets /* Per match stats for best bowling */ AS (SELECT b.\"bowler\" AS player_id, b.\"match_id\", COUNT(*) AS match_wickets FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b JOIN \"IPL\".\"IPL\".\"WICKET_TAKEN\" AS wt ON b.\"match_id\" = wt.\"match_id\" AND b.\"over_id\" = wt.\"over_id\" AND b.\"ball_id\" = wt.\"ball_id\" AND b.\"innings_no\" = wt.\"innings_no\" WHERE NOT wt.\"kind_out\" IN ('run out', 'retired hurt', 'obstructing the field') GROUP BY b.\"bowler\", b.\"match_id\"), match_runs AS (SELECT b.\"bowler\" AS player_id, b.\"match_id\", SUM(COALESCE(bs.\"runs_scored\", 0)) AS match_runs FROM \"IPL\".\"IPL\".\"BALL_BY_BALL\" AS b LEFT JOIN \"IPL\".\"IPL\".\"BATSMAN_SCORED\" AS bs ON b.\"match_id\" = bs.\"match_id\" AND b.\"over_id\" = bs.\"over_id\" AND b.\"ball_id\" = bs.\"ball_id\" AND b.\"innings_no\" = bs.\"innings_no\" GROUP BY b.\"bowler\", b.\"match_id\"), best_bowling AS (SELECT mw.player_id, mw.\"match_id\", mw.match_wickets, mr.match_runs, ROW_NUMBER() OVER (PARTITION BY mw.player_id ORDER BY mw.match_wickets DESC, mr.match_runs ASC) AS rn FROM match_wickets AS mw JOIN match_runs AS mr ON mw.player_id = mr.player_id AND mw.\"match_id\" = mr.\"match_id\") SELECT p.\"player_name\" AS player_name, COALESCE(bw.total_wickets, 0) AS TOTAL_WICKETS, ROUND(CAST(br.bat_runs * 6.0 AS DOUBLE PRECISION) / bb.legal_balls, 4) AS ECONOMY_RATE, CASE WHEN COALESCE(bw.total_wickets, 0) > 0 THEN ROUND(CAST(bb.legal_balls * 1.0 AS DOUBLE PRECISION) / bw.total_wickets, 4) ELSE NULL END AS STRIKE_RATE, CASE WHEN COALESCE(bw.total_wickets, 0) > 0 THEN best.match_wickets || '-' || best.match_runs ELSE NULL END AS BEST_BOWLING FROM bowler_balls AS bb JOIN \"IPL\".\"IPL\".\"PLAYER\" AS p ON bb.player_id = p.\"player_id\" LEFT JOIN bowler_runs AS br ON bb.player_id = br.player_id LEFT JOIN bowler_wickets AS bw ON bb.player_id = bw.player_id LEFT JOIN best_bowling AS best ON bb.player_id = best.player_id AND best.rn = 1 ORDER BY p.\"player_name\"") t0 t1 t2 t3 t4 t5
  := by first | sql_equiv | sorry

end N_sf_local258_eq_1_3
