FROM \"HACKER_NEWS\".\"HACKER_NEWS\".\"FULL\"\n    WHERE \"by\" IS NOT NULL\n      AND \"time\" IS NOT NULL\n      AND TO_TIMESTAMP(\"time\") < '2024-09-11'\n    GROUP BY \"by\", DATE_TRUNC('MONTH', TO_TIMESTAMP(\"time\"))\n),\nuser_span AS (\n    -- Get each user's first and last activity month\n    SELECT\n        user_id,\n        MIN(activity_month) AS first_month,\n        MAX(activity_month) AS last_month\n    FROM user_activity\n    GROUP BY user_id\n),\n-- Generate all months in each user's span\nall_months AS (\n    SELECT\n        us.user_id,\n        us.first_month,\n        us.last_month,\n        DATEADD('MONTH', seq.seq, us.first_month) AS expected_month\n    FROM user_span us\n    JOIN (\n        SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS seq\n        FROM TABLE(GENERATOR(ROWCOUNT => 300))\n    ) seq\n    ON DATEADD('MONTH', seq.seq, us.first_month) <= us.last_month\n),\n-- Find inactive months within the activity span\ninactive_months AS (\n    SELECT\n        am.user_id,\n        am.expected_month,\n        am.first_month\n    FROM all_months am\n    LEFT JOIN user_activity ua\n        ON am.user_id = ua.user_id AND am.expected_month = ua.activity_month\n    WHERE ua.activity_month IS NULL\n),\n-- Users who have at least one inactive month within their span\nusers_with_inactivity AS (\n    SELECT DISTINCT user_id\n    FROM inactive_months\n),\n-- For qualifying users, compute the churn month number\n-- Churn month = last_activity_month + 1 month\n-- Month number = counted from first activity month (first = 1)\nchurn_info AS (\n    SELECT\n        us.user_id,\n        us.first_month,\n        us.last_month,\n        DATEADD('MONTH', 1, us.last_month) AS churn_month,\n        DATEDIFF('MONTH', us.first_month, DATEADD('MONTH', 1, us.last_month)) + 1 AS month_number\n    FROM user_span us\n    INNER JOIN users_with_inactivity uwi\n        ON us.user_id = uwi.user_id\n)\nSELECT\n    user_id,\n    month_number\nFROM churn_info\nORDER BY month_number DESC\nLIMIT 1;") t := by
