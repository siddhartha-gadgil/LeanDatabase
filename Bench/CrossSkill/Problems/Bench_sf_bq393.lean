\"\n    WHERE \"by\" IS NOT NULL\n      AND TO_TIMESTAMP(\"time\") < '2024-09-10'::DATE\n    GROUP BY \"by\", DATE_TRUNC('MONTH', TO_TIMESTAMP(\"time\"))\n),\nuser_span AS (\n    SELECT\n        user_id,\n        MIN(activity_month) AS first_month,\n        MAX(activity_month) AS last_month,\n        COUNT(DISTINCT activity_month) AS active_months,\n        DATEDIFF('MONTH', MIN(activity_month), MAX(activity_month)) + 1 AS total_span_months\n    FROM activity\n    GROUP BY user_id\n),\nusers_with_gaps AS (\n    SELECT\n        user_id,\n        first_month,\n        last_month,\n        total_span_months,\n        active_months,\n        -- month number of the first inactive month after last activity\n        DATEDIFF('MONTH', first_month, last_month) + 2 AS month_number\n    FROM user_span\n    WHERE total_span_months > active_months  -- at least one gap month\n)\nSELECT\n    user_id AS \"USER_ID\",\n    month_number AS \"MONTH_NUMBER\"\nFROM users_with_gaps\nORDER BY month_number DESC\nLIMIT 1;") t := by
