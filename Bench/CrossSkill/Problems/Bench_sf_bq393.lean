/-!
# sf_bq393 — crossskill equivalence(s)

Question: I want to identify users who had activity followed by inactivity. Specifically, find the user ID and their corresponding month number (counting from their first activity month) for the user with the highest month number who became inactive (no activity recorded) after their last recorded activity month. For this analysis, only consider data up until September 10, 2024, and ensure the month number represents the count of months since the user's first activity. The user should have at least one month where they were expected to be active (within their activity span) but actually had no records.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq393

CREATE TABLE FULL («title» STRING, «url» STRING, «text» STRING, «dead» BOOL, «by» STRING, «score» INT, «time» INT, «timestamp» INT, «type» STRING, «id» INT, «parent» INT, «descendants» INT, «ranking» INT, «deleted» BOOL)

HYPOTHESIS hyp0_1_0 : FULL "\"time\" > 0"
HYPOTHESIS hyp0_1_1 : FULL "\"time\" < 2000000000"
HYPOTHESIS hyp0_1_2 : FULL "TO_TIMESTAMP(\"time\") <= '2024-09-10'"
theorem eq_0_1 (t : TableRel FULL_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) :
    (sql%([FULL_schema]) "WITH user_activity_months AS (\n  -- Get distinct activity months per user, up until Sep 10, 2024\n  SELECT \n    \"by\" AS user_id,\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(\"time\")) AS activity_month\n  FROM \"HACKER_NEWS\".\"HACKER_NEWS\".\"FULL\"\n  WHERE \"by\" IS NOT NULL\n    AND \"time\" > 0 AND \"time\" < 2000000000\n    AND TO_TIMESTAMP(\"time\") <= '2024-09-10'\n  GROUP BY \"by\", DATE_TRUNC('MONTH', TO_TIMESTAMP(\"time\"))\n),\nuser_span AS (\n  -- For each user, compute first/last activity month, active month count, and total span\n  SELECT \n    user_id,\n    MIN(activity_month) AS first_month,\n    MAX(activity_month) AS last_month,\n    COUNT(DISTINCT activity_month) AS active_months,\n    DATEDIFF('MONTH', MIN(activity_month), MAX(activity_month)) + 1 AS span_months\n  FROM user_activity_months\n  GROUP BY user_id\n),\nqualified_users AS (\n  -- Users who have at least one inactive month within their activity span\n  -- i.e., span_months > active_months\n  -- AND who became inactive (last_month before September 2024)\n  SELECT\n    user_id,\n    first_month,\n    last_month,\n    span_months,\n    -- Month number = count of months since first activity month\n    -- The month they became inactive is the month AFTER their last activity\n    -- 1-indexed: first_month = month 1, so last_month = DATEDIFF + 1\n    -- The inactive month after = DATEDIFF + 2\n    DATEDIFF('MONTH', first_month, last_month) + 2 AS month_number\n  FROM user_span\n  WHERE span_months > active_months  -- at least one inactive month in span\n    AND last_month < '2024-09-01'    -- became inactive (not active in the cutoff month)\n)\nSELECT \n  user_id AS USER_ID,\n  month_number AS MONTH_NUMBER\nFROM qualified_users\nORDER BY month_number DESC\nLIMIT 1;") t ~= (sql%([FULL_schema]) "WITH user_months AS (\n    SELECT\n        \"by\",\n        DATE_TRUNC('MONTH', TO_TIMESTAMP(\"time\")) AS activity_month\n    FROM \"HACKER_NEWS\".\"HACKER_NEWS\".\"FULL\"\n    WHERE \"by\" IS NOT NULL\n      AND TO_TIMESTAMP(\"time\") < '2024-09-10'::TIMESTAMP\n    GROUP BY \"by\", DATE_TRUNC('MONTH', TO_TIMESTAMP(\"time\"))\n),\nuser_summary AS (\n    SELECT\n        \"by\" AS USER_ID,\n        COUNT(*) AS active_months,\n        MIN(activity_month) AS first_month,\n        MAX(activity_month) AS last_month,\n        DATEDIFF('MONTH', MIN(activity_month), MAX(activity_month)) + 1 AS span_months,\n        -- Month number of inactivity = ordinal of month after last active month\n        DATEDIFF('MONTH', MIN(activity_month), MAX(activity_month)) + 2 AS MONTH_NUMBER\n    FROM user_months\n    GROUP BY \"by\"\n)\nSELECT\n    USER_ID,\n    MONTH_NUMBER\nFROM user_summary\nWHERE active_months < span_months  -- has at least one gap month within activity span\n  AND last_month < '2024-09-01'::TIMESTAMP  -- became inactive (not active in latest month)\nORDER BY MONTH_NUMBER DESC\nLIMIT 1;") t := by
  first | sql_equiv | sorry

