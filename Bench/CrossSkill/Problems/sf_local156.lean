N_MEMBERS\" AS m ON t.\"member_id\" = m.\"member_id\" JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_PRICES\" AS p ON t.\"ticker\" = p.\"ticker\" AND t.\"txn_date\" = p.\"market_date\" WHERE t.\"txn_type\" = 'BUY' AND t.\"ticker\" = 'BTC'), yearly_dca AS (SELECT year_start, region, ROUND(CAST(SUM(quantity * price) AS DOUBLE PRECISION) / SUM(quantity), 2) AS btc_dca FROM purchases GROUP BY year_start, region), first_year AS (SELECT region, MIN(year_start) AS min_year FROM yearly_dca GROUP BY region), with_lag AS (SELECT y.year_start, y.region, y.btc_dca, LAG(y.btc_dca) OVER (PARTITION BY y.region ORDER BY y.year_start) AS prev_dca FROM yearly_dca AS y), filtered AS (SELECT w.year_start, w.region, w.btc_dca, w.prev_dca FROM with_lag AS w JOIN first_year AS f ON w.region = f.region WHERE w.year_start > f.min_year), ranked AS (SELECT f.year_start, f.region, f.btc_dca, RANK() OVER (PARTITION BY f.year_start ORDER BY f.btc_dca) AS dca_ranking, ROUND(CAST((f.btc_dca - f.prev_dca) AS DOUBLE PRECISION) / f.prev_dca * 100, 2) AS dca_percentage_change FROM filtered AS f) SELECT year_start AS \"YEAR_START\", region AS \"REGION\", btc_dca AS \"BTC_DCA\", dca_ranking AS \"DCA_RANKING\", dca_percentage_change AS \"DCA_PERCENTAGE_CHANGE\" FROM ranked ORDER BY region, year_start") t := by
