theorem eq_0_1 : ∀ t,
    (sql%([BITCOIN_PRICES_schema, BITCOIN_TRANSACTIONS_schema, BITCOIN_MEMBERS_schema]) "WITH buy_data AS (SELECT m.\"region\", EXTRACT(YEAR FROM CAST(TO_TIMESTAMP(t.\"txn_date\", 'DD-MM-YYYY') AS DATE)) AS year_val, t.\"quantity\" * p.\"price\" AS dollar_amount, t.\"quantity\" FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_TRANSACTIONS\" AS t JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_MEMBERS\" AS m ON t.\"member_id\" = m.\"member_id\" JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_PRICES\" AS p ON t.\"txn_date\" = p.\"market_date\" AND t.\"ticker\" = p.\"ticker\" WHERE t.\"txn_type\" = 'BUY' AND t.\"ticker\" = 'BTC'), annual_avg AS (SELECT \"region\", year_val, CAST(SUM(dollar_amount) AS DOUBLE PRECISION) / SUM(\"quantity\") AS btc_dca FROM buy_data GROUP BY \"region\", year_val), first_year AS (SELECT \"region\", MIN(year_val) AS min_year FROM annual_avg GROUP BY \"region\"), filtered AS (SELECT a.\"region\", a.year_val, a.btc_dca FROM annual_avg AS a JOIN first_year AS f ON a.\"region\" = f.\"region\" WHERE a.year_val > f.min_year), with_lag AS (SELECT f.\"region\", f.year_val, f.btc_dca, LAG(f.btc_dca) OVER (PARTITION BY f.\"region\" ORDER BY f.year_val) AS prev_btc_dca FROM annual_avg AS f), final AS (SELECT fl.year_val AS \"YEAR_START\", fl.\"region\" AS \"REGION\", ROUND(fl.btc_dca, 2) AS \"BTC_DCA\", RANK() OVER (PARTITION BY fl.year_val ORDER BY fl.btc_dca ASC) AS \"DCA_RANKING\", ROUND(CAST((fl.btc_dca - wl.prev_btc_dca) AS DOUBLE PRECISION) / wl.prev_btc_dca * 100, 2) AS \"DCA_PERCENTAGE_CHANGE\" FROM filtered AS fl JOIN with_lag AS wl ON fl.\"region\" = wl.\"region\" AND fl.year_val = wl.year_val) SELECT \"YEAR_START\", \"REGION\", \"BTC_DCA\", \"DCA_RANKING\", \"DCA_PERCENTAGE_CHANGE\" FROM final ORDER BY \"REGION\", \"YEAR_START\"") t ~= (sql%([BITCOIN_PRICES_schema, BITCOIN_TRANSACTIONS_schema, BITCOIN_MEMBERS_schema]) "WITH avg_prices AS (SELECT m.\"region\" AS REGION, CAST(EXTRACT(YEAR FROM CAST(TO_TIME