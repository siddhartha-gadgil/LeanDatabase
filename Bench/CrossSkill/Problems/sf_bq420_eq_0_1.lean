theorem eq (t0 : TableRel PUBLICATIONS_schema) (t1 : TableRel PATENT_CLAIMS_STATS_schema) (t2 : TableRel PGPUB_CLAIMS_FULLTEXT_schema) (t3 : TableRel MATCH_APP_schema) (t4 : TableRel OFFICE_ACTIONS_schema) :
    (sql%([PUBLICATIONS_schema, PATENT_CLAIMS_STATS_schema, PGPUB_CLAIMS_FULLTEXT_schema, MATCH_APP_schema, OFFICE_ACTIONS_schema]) "WITH rejected_apps AS (SELECT \"app_id\", MIN(\"mail_dt\") AS first_office_action_date FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"OFFICE_ACTIONS\" WHERE \"rejection_101\" = 1 AND \"allowed_claims\" = 0 GROUP BY \"app_id\"), app_link AS (SELECT ma.\"app_id\", ma.\"application_number\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"MATCH_APP\" AS ma WHERE NOT ma.\"application_number\" IS NULL), grant_pubs AS (SELECT p.\"application_number\", p.\"publication_number\" AS grant_publication_number, p.\"grant_date\" FROM \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" AS p WHERE p.\"country_code\" = 'US' AND p.\"grant_date\" BETWEEN 20100101 AND 20231231 AND p.\"kind_code\" IN ('B1', 'B2')), granted_claims /* Granted claims word count: independent claims from PATENT_CLAIMS_STATS */ /* Formula: SUM(word_ct) - COUNT(*) to exclude claim number prefix word */ AS (SELECT CAST(cs.\"appl_id\" AS VARCHAR) AS app_id, CAST(cs.\"pat_no\" AS VARCHAR) AS pat_no, SUM(CAST(cs.\"word_ct\" AS INT)) - COUNT(*) AS granted_claims_length_words FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PATENT_CLAIMS_STATS\" AS cs WHERE cs.\"ind_flg\" = 1 GROUP BY cs.\"appl_id\", cs.\"pat_no\"), filed_claims /* Filed claims: pre-grant publication claims from PGPUB_CLAIMS_FULLTEXT */ /* Also get pub_no for first_publication_number */ AS (SELECT CAST(pcf.\"appl_id\" AS VARCHAR) AS app_id, pcf.\"pub_no\", SUM(ARRAY_LENGTH(SPLIT(TRIM(pcf.\"claim_txt\"), ' '), 1)) - COUNT(*) AS filed_claims_length_words FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PGPUB_CLAIMS_FULLTEXT\" AS pcf WHERE pcf.\"ind_flg\" = '1' GROUP BY pcf.\"appl_id\", pcf.\"pub_no\"), first_pub_a1 /* Get the A1 (pre-grant) publication date from PUBLICATIONS if it exists */ AS (SELECT p.\"application_number\", p.\"publication_number\" AS first_publication_number, p.\"publication_date\" AS first_publication_date FROM \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" AS p WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" IN ('A1', 'A2')) SELECT gp.grant_publication_number, gp.\"grant_date\" AS grant_date, gc.granted_claims_length_words, COALESCE(CASE WHEN NOT fc.\"pub_no\" IS NULL THEN 'US-' || fc.\"pub_no\" || '-A1' END, gp.grant_publication_number) AS first_publication_number, fpa.first_publication_date AS first_publication_date, fc.filed_claims_length_words, ra.first_office_action_date FROM rejected_apps AS ra JOIN app_link AS al ON ra.\"app_id\" = al.\"app_id\" JOIN grant_pubs AS gp ON al.\"application_number\" = gp.\"application_number\" JOIN granted_claims AS gc ON ra.\"app_id\" = gc.app_id LEFT JOIN filed_claims AS fc ON ra.\"app_id\" = fc.app_id LEFT JOIN first_pub_a1 AS fpa ON al.\"application_number\" = fpa.\"application_number\" ORDER BY gc.granted_claims_length_words DESC LIMIT 5") t0 t1 t2 t3 t4
  = (sql%([PUBLICATIONS_schema, PATENT_CLAIMS_STATS_schema, PGPUB_CLAIMS_FULLTEXT_schema, MATCH_APP_schema, OFFICE_ACTIONS_schema]) "WITH first_oa AS (SELECT \"app_id\", MIN(\"mail_dt\") AS \"first_office_action_date\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_OFFICE_ACTIONS\".\"OFFICE_ACTIONS\" WHERE \"rejection_101\" = '1' AND \"allowed_claims\" = '0' GROUP BY \"app_id\"), granted AS (SELECT pds.\"pat_no\", pds.\"appl_id\", CAST(pds.\"pat_wrd_ct\" AS INT) AS \"granted_claims_length_words\", cm.\"publication_number\" AS \"grant_publication_number\", p.\"grant_date\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PATENT_DOCUMENT_STATS\" AS pds JOIN \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"MATCH\" AS cm ON cm.\"pat_no\" = pds.\"pat_no\" JOIN \"PATENTS_USPTO\".\"PATENTS\".\"PUBLICATIONS\" AS p ON p.\"publication_number\" = cm.\"publication_number\" WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" IN ('B1', 'B2') AND p.\"grant_date\" BETWEEN 20100101 AND 20231231), a1_info AS (SELECT \"appl_id\", 'US-' || CAST(\"pub_no\" AS VARCHAR) || '-A1' AS \"first_publication_number\", \"pub_wrd_ct\" AS \"filed_claims_length_words\" FROM \"PATENTS_USPTO\".\"USPTO_OCE_CLAIMS\".\"PGPUB_DOCUMENT_STATS\") SELECT g.\"grant_publication_number\", g.\"grant_date\", g.\"granted_claims_length_words\", COALESCE(a1.\"first_publication_number\", g.\"grant_publication_number\") AS \"first_publication_number\", NULL AS \"first_publication_date\", a1.\"filed_claims_length_words\", CAST(foa.\"first_office_action_date\" AS VARCHAR) AS \"first_office_action_date\" FROM granted AS g JOIN first_oa AS foa ON foa.\"app_id\" = g.\"appl_id\" LEFT JOIN a1_info AS a1 ON a1.\"appl_id\" = g.\"appl_id\" ORDER BY g.\"granted_claims_length_words\" DESC LIMIT 5") t0 t1 t2 t3 t4
  := by first | sql_equiv | sorry

