    (sql%([V2_1_1_GENOMES__CHR17_schema]) "WITH brca1_region AS (\n    -- Step 1: Find the smallest start and largest end position for BRCA1 variants\n    SELECT \n        MIN(t.\"start_position\") AS gene_start,\n        MAX(t.\"end_position\") AS gene_end\n    FROM \"GNOMAD\".\"GNOMAD\".\"V2_1_1_GENOMES__CHR17\" t,\n    LATERAL FLATTEN(input => t.\"alternate_bases\") ab,\n    LATERAL FLATTEN(input => ab.value:vep) v\n    WHERE v.value:SYMBOL::STRING = 'BRCA1'\n)\n-- Step 2: For variants in that region, get Protein_position where Consequence includes missense_variant\nSELECT \n    v.value:Protein_position::STRING AS PROTEIN_POSITION\nFROM \"GNOMAD\".\"GNOMAD\".\"V2_1_1_GENOMES__CHR17\" t,\nLATERAL FLATTEN(input => t.\"alternate_bases\") ab,\nLATERAL FLATTEN(input => ab.value:vep) v,\nbrca1_region r\nWHERE t.\"start_position\" >= r.gene_start\n  AND t.\"end_position\" <= r.gene_end\n  AND v.value:Consequence::STRING LIKE '%missense_variant%'\n  AND v.value:Protein_position::STRING IS NOT NULL\nORDER BY TRY_CAST(v.value:Protein_position::STRING AS INTEGER) ASC\nLIMIT 1;") t ~= (sql%([V2_1_1_GENOMES__CHR17_schema]) "WITH brca1_variants AS (\n    SELECT t.\"start_position\", t.\"end_position\"\n    FROM \"GNOMAD\".\"GNOMAD\".\"V2_1_1_GENOMES__CHR17\" t,\n    LATERAL FLATTEN(input => t.\"alternate_bases\") ab,\n    LATERAL FLATTEN(input => ab.value:vep) v\n    WHERE v.value:SYMBOL::STRING = 'BRCA1'\n),\nbrca1_region AS (\n    SELECT MIN(\"start_position\") AS gene_start, MAX(\"end_position\") AS gene_end\n    FROM brca1_variants\n)\nSELECT v.value:Protein_position::STRING AS PROTEIN_POSITION\nFROM \"GNOMAD\".\"GNOMAD\".\"V2_1_1_GENOMES__CHR17\" t,\nLATERAL FLATTEN(input => t.\"alternate_bases\") ab,\nLATERAL FLATTEN(input => ab.value:vep) v\nWHERE t.\"start_position\" >= (SELECT gene_start FROM brca1_region)\n  AND t.\"end_position\" <= (SELECT gene_end FROM brca1_region)\n  AND v.value:Consequence::STRING LIKE '%missense_variant%'\nORDER BY TRY_TO_NUMBER(v.value:Protein_position::STRING) ASC\nLIMIT 1;") t := by
