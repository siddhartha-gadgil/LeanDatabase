theorem eq_0_1 :
    sql%([SOLAR_POTENTIAL_BY_POSTAL_CODE_schema, SOLAR_POTENTIAL_BY_CENSUSTRACT_schema]) "SELECT\n  \"state_name\",\n  'Census Tract' AS \"ANALYSIS_LEVEL\",\n  COUNT(*) AS \"REGION_COUNT\",\n  SUM(\"count_qualified\") AS \"BUILDINGS_AVAILABLE\",\n  ROUND(AVG(\"percent_covered\"), 2) AS \"AVG_GOOGLE_MAPS_COVERAGE_PCT\",\n  ROUND(AVG(\"percent_qualified\"), 2) AS \"AVG_SUITABLE_COVERAGE_PCT\",\n  SUM(\"number_of_panels_total\") AS \"POTENTIAL_PANEL_COUNT\",\n  SUM(\"kw_total\") AS \"TOTAL_KW_CAPACITY\",\n  SUM(\"yearly_sunlight_kwh_total\") AS \"ENERGY_GENERATION_POTENTIAL_KWH\",\n  SUM(\"carbon_offset_metric_tons\") AS \"CARBON_DIOXIDE_OFFSET_TONS\",\n  SUM(\"existing_installs_count\") AS \"CURRENT_BUILDINGS_WITH_SOLAR\",\n  ROUND(SUM(\"count_qualified\" * \"percent_covered\" / 100.0 * \"percent_qualified\" / 100.0) - SUM(\"existing_installs_count\"), 0) AS \"GAP_IN_POTENTIAL_INSTALLS\"\nFROM \"SUNROOF_SOLAR\".\"SUNROOF_SOLAR\".\"SOLAR_POTENTIAL_BY_CENSUSTRACT\"\nGROUP BY \"state_name\"\n\nUNION ALL\n\nSELECT\n  \"state_name\",\n  'Postal Code' AS \"ANALYSIS_LEVEL\",\n  COUNT(*) AS \"REGION_COUNT\",\n  SUM(\"count_qualified\") AS \"BUILDINGS_AVAILABLE\",\n  ROUND(AVG(\"percent_covered\"), 2) AS \"AVG_GOOGLE_MAPS_COVERAGE_PCT\",\n  ROUND(AVG(\"percent_qualified\"), 2) AS \"AVG_SUITABLE_COVERAGE_PCT\",\n  SUM(\"number_of_panels_total\") AS \"POTENTIAL_PANEL_COUNT\",\n  SUM(\"kw_total\") AS \"TOTAL_KW_CAPACITY\",\n  SUM(\"yearly_sunlight_kwh_total\") AS \"ENERGY_GENERATION_POTENTIAL_KWH\",\n  SUM(\"carbon_offset_metric_tons\") AS \"CARBON_DIOXIDE_OFFSET_TONS\",\n  SUM(\"existing_installs_count\") AS \"CURRENT_BUILDINGS_WITH_SOLAR\",\n  ROUND(SUM(\"count_qualified\" * \"percent_covered\" / 100.0 * \"percent_qualified\" / 100.0) - SUM(\"existing_installs_count\"), 0) AS \"GAP_IN_POTENTIAL_INSTALLS\"\nFROM \"SUNROOF_SOLAR\".\"SUNROOF_SOLAR\".\"SOLAR_POTENTIAL_BY_POSTAL_CODE\"\nGROUP BY \"state_name\"\n\nORDER BY \"state_name\", \"ANALYSIS_LEVEL\";" = sql%([SOLAR_POTENTIAL_BY_POSTAL_CODE_schema, SOLAR_POTENTIAL_BY_CENSUSTRACT_schema]) "SELECT\n  \"state_name\",\n  \"ANALYSIS_LEVEL\",\n  \"REGION_COUNT\",\n  \"BUILDINGS_AVAILABLE\",\n  ROUND(\"AVG_GOOGLE_MAPS_COVERAGE_PCT\", 2) AS \"AVG_GOOGLE_MAPS_COVERAGE_PCT\",\n  ROUND(\"AVG_SUITABLE_COVERAGE_PCT\", 2) AS \"AVG_SUITABLE_COVERAGE_PCT\",\n  \"POTENTIAL_PANEL_COUNT\",\n  \"TOTAL_KW_CAPACITY\",\n  \"ENERGY_GENERATION_POTENTIAL_KWH\",\n  \"CARBON_DIOXIDE_OFFSET_TONS\",\n  \"CURRENT_BUILDINGS_WITH_SOLAR\",\n  ROUND(\"GAP_RAW\", 0) AS \"GAP_IN_POTENTIAL_INSTALLS\"\nFROM (\n  SELECT\n    \"state_name\",\n    'Census Tract' AS \"ANALYSIS_LEVEL\",\n    COUNT(*) AS \"REGION_COUNT\",\n    SUM(\"count_qualified\") AS \"BUILDINGS_AVAILABLE\",\n    AVG(\"percent_covered\") AS \"AVG_GOOGLE_MAPS_COVERAGE_PCT\",\n    AVG(\"percent_qualified\") AS \"AVG_SUITABLE_COVERAGE_PCT\",\n    SUM(\"number_of_panels_total\") AS \"POTENTIAL_PANEL_COUNT\",\n    SUM(\"kw_total\") AS \"TOTAL_KW_CAPACITY\",\n    SUM(\"yearly_sunlight_kwh_total\") AS \"ENERGY_GENERATION_POTENTIAL_KWH\",\n    SUM(\"carbon_offset_metric_tons\") AS \"CARBON_DIOXIDE_OFFSET_TONS\",\n    SUM(\"existing_installs_count\") AS \"CURRENT_BUILDINGS_WITH_SOLAR\",\n    SUM(\"count_qualified\" * (\"percent_covered\" / 100.0) * (\"percent_qualified\" / 100.0)) - SUM(\"existing_installs_count\") AS \"GAP_RAW\"\n  FROM \"SUNROOF_SOLAR\".\"SUNROOF_SOLAR\".\"SOLAR_POTENTIAL_BY_CENSUSTRACT\"\n  GROUP BY \"state_name\"\n\n  UNION ALL\n\n  SELECT\n    \"state_name\",\n    'Postal Code' AS \"ANALYSIS_LEVEL\",\n    COUNT(*) AS \"REGION_COUNT\",\n    SUM(\"count_qualified\") AS \"BUILDINGS_AVAILABLE\",\n    AVG(\"percent_covered\") AS \"AVG_GOOGLE_MAPS_COVERAGE_PCT\",\n    AVG(\"percent_qualified\") AS \"AVG_SUITABLE_COVERAGE_PCT\",\n    SUM(\"number_of_panels_total\") AS \"POTENTIAL_PANEL_COUNT\",\n    SUM(\"kw_total\") AS \"TOTAL_KW_CAPACITY\",\n    SUM(\"yearly_sunlight_kwh_total\") AS \"ENERGY_GENERATION_POTENTIAL_KWH\",\n    SUM(\"carbon_offset_metric_tons\") AS \"CARBON_DIOXIDE_OFFSET_TONS\",\n    SUM(\"existing_installs_count\") AS \"CURRENT_BUILDINGS_WITH_SOLAR\",\n    SUM(\"count_qualified\" * (\"percent_covered\" / 100.0) * (\"percent_qualified\" / 100.0)) - SUM(\"existing_installs_count\") AS \"GAP_RAW\"\n  FROM \"SUNROOF_SOLAR\".\"SUNROOF_SOLAR\".\"SOLAR_POTENTIAL_BY_POSTAL_CODE\"\n  GROUP BY \"state_name\"\n) sub\nORDER BY \"state_name\", \"ANALYSIS_LEVEL\";" := by
  first | sql_equiv | sorry

