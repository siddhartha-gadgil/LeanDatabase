    (sql%([COLLISIONS_schema]) "WITH yearly_cause_ranked AS (\n    SELECT \n        EXTRACT(YEAR FROM TO_DATE(\"collision_date\", 'YYYY-MM-DD')) AS yr,\n        \"pcf_violation_category\" AS cause,\n        COUNT(*) AS cnt,\n        ROW_NUMBER() OVER (\n            PARTITION BY EXTRACT(YEAR FROM TO_DATE(\"collision_date\", 'YYYY-MM-DD')) \n            ORDER BY COUNT(*) DESC\n        ) AS rn\n    FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n    WHERE \"pcf_violation_category\" IS NOT NULL \n      AND \"pcf_violation_category\" != ''\n    GROUP BY yr, cause\n),\ntop2_per_year AS (\n    SELECT yr, cause\n    FROM yearly_cause_ranked\n    WHERE rn <= 2\n),\nyear_cause_set AS (\n    SELECT yr, LISTAGG(cause, ',') WITHIN GROUP (ORDER BY cause) AS cause_set\n    FROM top2_per_year\n    GROUP BY yr\n),\ncause_set_counts AS (\n    SELECT cause_set, COUNT(*) AS num_years\n    FROM year_cause_set\n    GROUP BY cause_set\n    ORDER BY num_years DESC\n),\nmajority_set AS (\n    SELECT cause_set\n    FROM cause_set_counts\n    ORDER BY num_years DESC\n    LIMIT 1\n)\nSELECT ycs.yr AS OUTPUT\nFROM year_cause_set ycs\nWHERE ycs.cause_set != (SELECT cause_set FROM majority_set)\nORDER BY ycs.yr;") t ~= (sql%([COLLISIONS_schema]) "WITH yearly_counts AS (\n    SELECT \n        LEFT(\"collision_date\", 4) AS yr,\n        \"pcf_violation_category\" AS cause,\n        COUNT(*) AS cnt\n    FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\"\n    WHERE \"pcf_violation_category\" IS NOT NULL \n      AND \"collision_date\" IS NOT NULL\n    GROUP BY yr, cause\n),\nranked AS (\n    SELECT yr, cause, cnt,\n        ROW_NUMBER() OVER (PARTITION BY yr ORDER BY cnt DESC) AS rn\n    FROM yearly_counts\n),\ntop2_per_year AS (\n    SELECT yr,\n        ARRAY_AGG(cause) WITHIN GROUP (ORDER BY rn) AS top2_causes\n    FROM ranked\n    WHERE rn <= 2\n    GROUP BY yr\n),\n-- Find the most common top-2 combination (the \"normal\" pattern)\ncause_combos AS (\n    SELECT top2_causes, COUNT(*) AS combo_cnt\n    FROM top2_per_year\n    GROUP BY top2_causes\n),\nmost_common_combo AS (\n    SELECT top2_causes\n    FROM cause_combos\n    ORDER BY combo_cnt DESC\n    LIMIT 1\n)\nSELECT t.yr AS \"OUTPUT\"\nFROM top2_per_year t\nWHERE t.top2_causes != (SELECT top2_causes FROM most_common_combo);") t := by
  first | sql_equiv | sorry

