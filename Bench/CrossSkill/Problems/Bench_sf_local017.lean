/-!
# sf_local017 — crossskill equivalence(s)

Question: In which year were the two most common causes of traffic accidents different from those in other years?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local017

CREATE TABLE COLLISIONS («case_id» FLOAT, «jurisdiction» FLOAT, «officer_id» STRING, «reporting_district» STRING, «chp_shift» STRING, «population» STRING, «county_city_location» INT, «county_location» STRING, «special_condition» FLOAT, «beat_type» STRING, «chp_beat_type» STRING, «city_division_lapd» STRING, «chp_beat_class» STRING, «beat_number» STRING, «primary_road» STRING, «secondary_road» STRING, «distance» FLOAT, «direction» STRING, «intersection» FLOAT, «weather_1» STRING, «weather_2» STRING, «state_highway_indicator» FLOAT, «caltrans_county» STRING, «caltrans_district» FLOAT, «state_route» FLOAT, «route_suffix» STRING, «postmile_prefix» STRING, «postmile» FLOAT, «location_type» STRING, «ramp_intersection» STRING, «side_of_highway» STRING, «tow_away» FLOAT, «collision_severity» STRING, «killed_victims» FLOAT, «injured_victims» FLOAT, «party_count» FLOAT, «primary_collision_factor» STRING, «pcf_violation_code» STRING, «pcf_violation_category» STRING, «pcf_violation» FLOAT, «pcf_violation_subsection» STRING, «hit_and_run» STRING, «type_of_collision» STRING, «motor_vehicle_involved_with» STRING, «pedestrian_action» STRING, «road_surface» STRING, «road_condition_1» STRING, «road_condition_2» STRING, «lighting» STRING, «control_device» STRING, «chp_road_type» STRING, «pedestrian_collision» INT, «bicycle_collision» INT, «motorcycle_collision» INT, «truck_collision» INT, «not_private_property» FLOAT, «alcohol_involved» FLOAT, «statewide_vehicle_type_at_fault» STRING, «chp_vehicle_type_at_fault» STRING, «severe_injury_count» INT, «other_visible_injury_count» INT, «complaint_of_pain_injury_count» INT, «pedestrian_killed_count» INT, «pedestrian_injured_count» INT, «bicyclist_killed_count» INT, «bicyclist_injured_count» INT, «motorcyclist_killed_count» INT, «motorcyclist_injured_count» FLOAT, «primary_ramp» STRING, «secondary_ramp» STRING, «latitude» FLOAT, «longitude» FLOAT, «collision_date» STRING, «collision_time» STRING, «process_date» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([COLLISIONS_schema]) "WITH yearly_cause_ranked AS (SELECT EXTRACT(YEAR FROM CAST(TO_TIMESTAMP(\"collision_date\", 'YYYY-MM-DD') AS DATE)) AS yr, \"pcf_violation_category\" AS cause, COUNT(*) AS cnt, ROW_NUMBER() OVER (PARTITION BY EXTRACT(YEAR FROM CAST(TO_TIMESTAMP(\"collision_date\", 'YYYY-MM-DD') AS DATE)) ORDER BY COUNT(*) DESC) AS rn FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\" WHERE NOT \"pcf_violation_category\" IS NULL AND \"pcf_violation_category\" <> '' GROUP BY yr, cause), top2_per_year AS (SELECT yr, cause FROM yearly_cause_ranked WHERE rn <= 2), year_cause_set AS (SELECT yr, STRING_AGG(cause, ',' ORDER BY cause) AS cause_set FROM top2_per_year GROUP BY yr), cause_set_counts AS (SELECT cause_set, COUNT(*) AS num_years FROM year_cause_set GROUP BY cause_set ORDER BY num_years DESC), majority_set AS (SELECT cause_set FROM cause_set_counts ORDER BY num_years DESC LIMIT 1) SELECT ycs.yr AS OUTPUT FROM year_cause_set AS ycs WHERE ycs.cause_set <> (SELECT cause_set FROM majority_set) ORDER BY ycs.yr") t ~= (sql%([COLLISIONS_schema]) "WITH yearly_cause_counts AS (SELECT SUBSTRING(\"collision_date\" FROM 1 FOR 4) AS yr, \"pcf_violation_category\" AS cause, COUNT(*) AS cnt FROM \"CALIFORNIA_TRAFFIC_COLLISION\".\"CALIFORNIA_TRAFFIC_COLLISION\".\"COLLISIONS\" WHERE NOT \"pcf_violation_category\" IS NULL AND \"pcf_violation_category\" <> '' GROUP BY yr, cause), ranked AS (SELECT yr, cause, cnt, ROW_NUMBER() OVER (PARTITION BY yr ORDER BY cnt DESC) AS rn FROM yearly_cause_counts), top2_per_year AS (SELECT yr, ARRAY_AGG(cause) FILTER(WHERE cause IS NOT NULL) WITHIN GROUP (ORDER BY rn) AS top2_set FROM ranked WHERE rn <= 2 GROUP BY yr), pattern_counts /* Find the most common top-2 pattern (the majority pattern) */ AS (SELECT top2_set, COUNT(*) AS num_years FROM top2_per_year GROUP BY top2_set), majority_pattern AS (SELECT top2_set FROM pattern_counts ORDER BY num_years DESC LIMIT 1) SELECT t.yr AS OUTPUT FROM top2_per_year AS t JOIN majority_pattern AS m ON t.top2_set <> m.top2_set") t := by
  intro t; first | sql_equiv | sorry

