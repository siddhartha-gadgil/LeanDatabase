import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local077 — crossskill equivalence(s)

Question: Please analyze our interest data from September 2018 to August 2019. For each month, calculate the average composition for each interest by dividing the composition by the index value. Identify the interest with the highest average composition value each month and report its average composition as the max index composition for that month. Compute the three-month rolling average of these monthly max index compositions. Ensure the output includes the date, the interest name, the max index composition for that month, the rolling average, and the names and max index compositions of the top interests from one month ago and two months ago.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local077

CREATE TABLE INTEREST_MAP («id» INT, «interest_name» STRING, «interest_summary» STRING, «created_at» STRING, «last_modified» STRING)
CREATE TABLE INTEREST_METRICS («_month» FLOAT, «_year» FLOAT, «month_year» STRING, «interest_id» FLOAT, «composition» FLOAT, «index_value» FLOAT, «ranking» INT, «percentile_ranking» FLOAT)

theorem eq_0_1 : ∀ t,
    (sql%([INTEREST_MAP_schema, INTEREST_METRICS_schema]) "WITH monthly_comp AS (\n  SELECT \n    m.\"_month\",\n    m.\"_year\",\n    im.\"interest_name\",\n    m.\"composition\" / m.\"index_value\" AS avg_composition,\n    ROW_NUMBER() OVER (\n      PARTITION BY m.\"_year\", m.\"_month\" \n      ORDER BY m.\"composition\" / m.\"index_value\" DESC\n    ) AS rn\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_METRICS\" m\n  JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_MAP\" im \n    ON m.\"interest_id\" = im.\"id\"\n  WHERE m.\"interest_id\" IS NOT NULL\n    AND m.\"month_year\" IS NOT NULL\n    AND m.\"month_year\" != ''\n),\nmonthly_max AS (\n  SELECT \n    \"_month\",\n    \"_year\",\n    \"interest_name\",\n    avg_composition AS max_index_composition\n  FROM monthly_comp\n  WHERE rn = 1\n),\nfiltered AS (\n  SELECT *\n  FROM monthly_max\n  WHERE (\"_year\" = 2018 AND \"_month\" >= 9)\n     OR (\"_year\" = 2019 AND \"_month\" <= 8)\n),\nwith_window AS (\n  SELECT \n    DATE_FROM_PARTS(\"_year\", \"_month\", 1) AS \"MONTH_DATE\",\n    \"interest_name\",\n    max_index_composition AS \"MAX_INDEX_COMPOSITION\",\n    AVG(max_index_composition) OVER (\n      ORDER BY \"_year\", \"_month\" \n      ROWS BETWEEN 2 PRECEDING AND CURRENT ROW\n    ) AS \"ROLLING_AVG_3MONTH\",\n    LAG(\"interest_name\", 1) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_MONTH_INTEREST_NAME\",\n    LAG(max_index_composition, 1) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_MONTH_MAX_COMPOSITION\",\n    LAG(\"interest_name\", 2) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_2MONTH_INTEREST_NAME\",\n    LAG(max_index_composition, 2) OVER (ORDER BY \"_year\", \"_month\") AS \"PREV_2MONTH_MAX_COMPOSITION\"\n  FROM filtered\n)\nSELECT \n  \"MONTH_DATE\",\n  \"interest_name\",\n  \"MAX_INDEX_COMPOSITION\",\n  \"ROLLING_AVG_3MONTH\",\n  \"PREV_MONTH_INTEREST_NAME\",\n  \"PREV_MONTH_MAX_COMPOSITION\",\n  \"PREV_2MONTH_INTEREST_NAME\",\n  \"PREV_2MONTH_MAX_COMPOSITION\"\nFROM with_window\nORDER BY \"MONTH_DATE\";") t ~= (sql%([INTEREST_MAP_schema, INTEREST_METRICS_schema]) "WITH avg_comp AS (\n  -- Calculate avg composition = composition / index_value for each interest per month\n  SELECT\n    im.\"_month\",\n    im.\"_year\",\n    im.\"month_year\",\n    im.\"interest_id\",\n    m.\"interest_name\",\n    im.\"composition\" / NULLIF(im.\"index_value\", 0) AS avg_composition\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_METRICS\" im\n  JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"INTEREST_MAP\" m\n    ON im.\"interest_id\" = m.\"id\"\n  WHERE im.\"_month\" IS NOT NULL\n),\nmax_per_month AS (\n  -- For each month, find the interest with the highest avg composition\n  SELECT\n    \"_month\",\n    \"_year\",\n    \"month_year\",\n    \"interest_name\",\n    avg_composition AS max_index_composition,\n    ROW_NUMBER() OVER (\n      PARTITION BY \"_month\", \"_year\"\n      ORDER BY avg_composition DESC\n    ) AS rn\n  FROM avg_comp\n),\nfiltered AS (\n  -- Keep only the top interest per month and filter to Sep 2018 - Aug 2019\n  SELECT\n    DATE_FROM_PARTS(\"_year\", \"_month\", 1) AS MONTH_DATE,\n    \"interest_name\",\n    max_index_composition\n  FROM max_per_month\n  WHERE rn = 1\n    AND (\n      (\"_year\" = 2018 AND \"_month\" >= 9)\n      OR (\"_year\" = 2019 AND \"_month\" <= 8)\n    )\n),\nwith_rolling AS (\n  SELECT\n    MONTH_DATE,\n    \"interest_name\",\n    max_index_composition AS MAX_INDEX_COMPOSITION,\n    AVG(max_index_composition) OVER (\n      ORDER BY MONTH_DATE\n      ROWS BETWEEN 2 PRECEDING AND CURRENT ROW\n    ) AS ROLLING_AVG_3MONTH,\n    LAG(\"interest_name\", 1) OVER (ORDER BY MONTH_DATE) AS PREV_MONTH_INTEREST_NAME,\n    LAG(max_index_composition, 1) OVER (ORDER BY MONTH_DATE) AS PREV_MONTH_MAX_COMPOSITION,\n    LAG(\"interest_name\", 2) OVER (ORDER BY MONTH_DATE) AS PREV_2MONTH_INTEREST_NAME,\n    LAG(max_index_composition, 2) OVER (ORDER BY MONTH_DATE) AS PREV_2MONTH_MAX_COMPOSITION\n  FROM filtered\n)\nSELECT\n  MONTH_DATE,\n  \"interest_name\",\n  MAX_INDEX_COMPOSITION,\n  ROLLING_AVG_3MONTH,\n  PREV_MONTH_INTEREST_NAME,\n  PREV_MONTH_MAX_COMPOSITION,\n  PREV_2MONTH_INTEREST_NAME,\n  PREV_2MONTH_MAX_COMPOSITION\nFROM with_rolling\nORDER BY MONTH_DATE;") t := by
  intro t; first | sql_equiv | sorry

