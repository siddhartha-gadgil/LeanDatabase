  intro t; first | sql_equiv | sorry

theorem eq_1_3 : ∀ t,
    (sql%([STATIONS_schema, GSOD2022_schema]) "WITH valid_station_days AS (SELECT \"stn\", SUM(CASE WHEN \"temp\" <> 9999.9 AND \"max\" <> 9999.9 AND \"min\" <> 9999.9 THEN 1 ELSE 0 END) AS valid_days FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2022\" GROUP BY \"stn\" HAVING valid_days >= 0.9 * 365), total_stations AS (SELECT COUNT(*) AS total FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" WHERE \"usaf\" <> '999999') SELECT CAST(CAST(100.0 AS DOUBLE PRECISION) * (SELECT COUNT(*) FROM valid_station_days) AS DOUBLE PRECISION) / (SELECT total FROM total_stations) AS \"percentage_of_stations_with_90_percent_coverage\"") t ~= (sql%([STATIONS_schema, GSOD2022_schema]) "WITH valid_station_days AS (SELECT \"stn\", \"wban\", COUNT(DISTINCT \"date\") AS valid_day_count FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2022\" WHERE \"stn\" <> '999999' AND NOT \"temp\" IS NULL AND \"temp\" <> 9999.9 AND NOT \"max\" IS NULL AND \"max\" <> 9999.9 AND NOT \"min\" IS NULL AND \"min\" <> 9999.9 GROUP BY \"stn\", \"wban\" HAVING COUNT(DISTINCT \"date\") >= 0.9 * 365), total_stations AS (SELECT COUNT(*) AS cnt FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"STATIONS\" WHERE \"usaf\" <> '999999') SELECT CAST(100.0 * (SELECT COUNT(*) FROM valid_station_days) AS DOUBLE PRECISION) / (SELECT cnt FROM total_stations) AS percentage_of_stations_with_90_percent_coverage") t := by
