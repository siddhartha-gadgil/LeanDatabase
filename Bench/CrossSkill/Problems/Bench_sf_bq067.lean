mber\"\nORDER BY a.\"consecutive_number\";") t ~= (sql%([ACCIDENT_2016_schema, PERSON_2016_schema, VEHICLE_2016_schema]) "WITH person_counts AS (\n    SELECT \n        \"consecutive_number\",\n        COUNT(DISTINCT \"person_number\") AS person_count,\n        SUM(CASE WHEN \"injury_severity\" = 4 THEN 1 ELSE 0 END) AS fatality_count\n    FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\"\n    GROUP BY \"consecutive_number\"\n    HAVING COUNT(DISTINCT \"person_number\") > 1\n),\nfirst_vehicle AS (\n    SELECT \n        \"consecutive_number\",\n        \"body_type\"\n    FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\"\n    WHERE \"vehicle_number\" = 1\n),\nspeed_diff AS (\n    SELECT \n        \"consecutive_number\",\n        AVG(ABS(\"travel_speed\" - \"speed_limit\")) AS avg_abs_speed_diff\n    FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\"\n    WHERE \"travel_speed\" <= 151\n      AND \"speed_limit\" <= 80\n    GROUP BY \"consecutive_number\"\n)\nSELECT \n    a.\"state_number\",\n    a.\"consecutive_number\",\n    CAST(fv.\"body_type\" AS FLOAT) AS \"vehicle_body_type\",\n    a.\"number_of_drunk_drivers\",\n    a.\"day_of_week\",\n    a.\"hour_of_crash\",\n    CASE WHEN a.\"work_zone\" != 'None' THEN 1 ELSE 0 END AS \"work_zone_indicator\",\n    sd.avg_abs_speed_diff AS \"avg_abs_speed_diff\",\n    CASE \n        WHEN sd.avg_abs_speed_diff IS NULL THEN NULL\n        WHEN FLOOR(sd.avg_abs_speed_diff / 20) > 4 THEN 4.0\n        ELSE FLOOR(sd.avg_abs_speed_diff / 20)\n    END AS \"avg_speed_diff_bin\",\n    CASE WHEN pc.fatality_count > 1 THEN 1 ELSE 0 END AS \"label_more_than_one_fatality\"\nFROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" a\nJOIN person_counts pc ON a.\"consecutive_number\" = pc.\"consecutive_number\"\nLEFT JOIN first_vehicle fv ON a.\"consecutive_number\" = fv.\"consecutive_number\"\nLEFT JOIN speed_diff sd ON a.\"consecutive_number\" = sd.\"consecutive_number\"\nORDER BY a.\"state_number\", a.\"consecutive_number\";") t := by
  intro t; first | sql_equiv | sorry

theorem eq_1_2 :
    sql%([ACCIDENT_2016_schema, PERSON_2016_schema, VEHICLE_2016_schema]) "WITH multi_person_crashes AS (\n  -- Crashes with more than one distinct person\n  SELECT \"consecutive_number\"\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\"\n  GROUP BY \"consecutive_number\"\n  HAVING COUNT(DISTINCT \"person_number\") > 1\n),\nfatal_counts AS (\n  -- Count persons with injury_severity = 4 per crash\n  SELECT \"consecutive_number\",\n    SUM(CASE WHEN \"injury_severity\" = 4 THEN 1 ELSE 0 END) AS fatal_count\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\"\n  GROUP BY \"consecutive_number\"\n),\nvehicle_body AS (\n  -- Get body_type from vehicle_number = 1 (first vehicle)\n  SELECT \"consecutive_number\", \"body_type\" AS vehicle_body_type\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\"\n  WHERE \"vehicle_number\" = 1\n),\nspeed_diff AS (\n  -- Average absolute difference between travel_speed and speed_limit per crash\n  -- Only for vehicles where travel_speed <= 151 AND speed_limit <= 80\n  SELECT \"consecutive_number\",\n    AVG(ABS(\"travel_speed\" - \"speed_limit\")) AS avg_abs_speed_diff\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\"\n  WHERE \"travel_speed\" <= 151 AND \"speed_limit\" <= 80\n  GROUP BY \"consecutive_number\"\n)\nSELECT\n  a.\"state_number\",\n  a.\"consecutive_number\",\n  vb.vehicle_body_type,\n  a.\"number_of_drunk_drivers\",\n  a.\"day_of_week\",\n  a.\"hour_of_crash\",\n  CASE WHEN a.\"work_zone\" != 'None' THEN 1 ELSE 0 END AS work_zone_indicator,\n  sd.avg_abs_speed_diff,\n  CASE \n    WHEN sd.avg_abs_speed_diff IS NULL THEN NULL\n    WHEN FLOOR(sd.avg_abs_speed_diff / 20) >= 4 THEN 4\n    ELSE FLOOR(sd.avg_abs_speed_diff / 20)\n  END AS avg_speed_diff_bin,\n  CASE WHEN fc.fatal_count > 1 THEN 1 ELSE 0 END AS label_more_than_one_fatality\nFROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" a\nINNER JOIN multi_person_crashes mpc ON a.\"consecutive_number\" = mpc.\"consecutive_number\"\nINNER JOIN fatal_counts fc ON a.\"consecutive_number\" = fc.\"consecutive_number\"\nLEFT JOIN vehicle_body vb ON a.\"consecutive_number\" = vb.\"consecutive_number\"\nLEFT JOIN speed_diff sd ON a.\"consecutive_number\" = sd.\"consecutive_number\"\nORDER BY a.\"state_number\", a.\"consecutive_number\";" = sql%([ACCIDENT_2016_schema, PERSON_2016_schema, VEHICLE_2016_schema]) "WITH multi_person_accidents AS (\n  SELECT \"consecutive_number\"\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\"\n  GROUP BY \"consecutive_number\"\n  HAVING COUNT(DISTINCT \"person_number\") > 1\n),\nfatality_labels AS (\n  SELECT\n    p.\"consecutive_number\",\n    CASE WHEN SUM(CASE WHEN p.\"injury_severity\" = 4 THEN 1 ELSE 0 END) > 1 THEN 1 ELSE 0 END AS \"label_more_than_one_fatality\"\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\" p\n  INNER JOIN multi_person_accidents mpa ON p.\"consecutive_number\" = mpa.\"consecutive_number\"\n  GROUP BY p.\"consecutive_number\"\n),\nfirst_vehicle AS (\n  SELECT\n    v.\"consecutive_number\",\n    v.\"body_type\" AS \"vehicle_body_type\"\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\" v\n  INNER JOIN multi_person_accidents mpa ON v.\"consecutive_number\" = mpa.\"consecutive_number\"\n  QUALIFY ROW_NUMBER() OVER (PARTITION BY v.\"consecutive_number\" ORDER BY v.\"vehicle_number\") = 1\n),\nspeed_diff AS (\n  SELECT\n    v.\"consecutive_number\",\n    AVG(ABS(v.\"travel_speed\" - v.\"speed_limit\")) AS \"avg_abs_speed_diff\"\n  FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\" v\n  INNER JOIN multi_person_accidents mpa ON v.\"consecutive_number\" = mpa.\"consecutive_number\"\n  WHERE v.\"travel_speed\" <= 151\n    AND v.\"speed_limit\" <= 80\n  GROUP BY v.\"consecutive_number\"\n)\nSELECT\n  a.\"state_number\",\n  a.\"consecutive_number\",\n  fv.\"vehicle_body_type\",\n  a.\"number_of_drunk_drivers\",\n  a.\"day_of_week\",\n  a.\"hour_of_crash\",\n  CASE WHEN a.\"work_zone\" != 'None' THEN 1 ELSE 0 END AS \"work_zone_indicator\",\n  COALESCE(sd.\"avg_abs_speed_diff\", 0) AS \"avg_abs_speed_diff\",\n  CASE\n    WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 80 THEN 4\n    WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 60 THEN 3\n    WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 40 THEN 2\n    WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 20 THEN 1\n    ELSE 0\n  END AS \"avg_speed_diff_bin\",\n  fl.\"label_more_than_one_fatality\"\nFROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" a\nINNER JOIN multi_person_accidents mpa ON a.\"consecutive_number\" = mpa.\"consecutive_number\"\nINNER JOIN fatality_labels fl ON a.\"consecutive_number\" = fl.\"consecutive_number\"\nINNER JOIN first_vehicle fv ON a.\"consecutive_number\" = fv.\"consecutive_number\"\nLEFT JOIN speed_diff sd ON a.\"consecutive_number\" = sd.\"consecutive_number\"\nORDER BY a.\"consecutive_number\";" := by
  first | sql_equiv | sorry

