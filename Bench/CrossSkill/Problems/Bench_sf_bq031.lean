/-!
# sf_bq031 — crossskill equivalence(s)

Question: Provide the daily weather data for Rochester from January 1 to March 31, 2019, including temperature (in Celsius), precipitation (in centimeters), and wind speed (in meters per second). For each variable, calculate the 8-day moving average (including the current day and the previous 7 days). Also, calculate the difference between the moving average on each day and the moving averages for the previous 1 to 8 days (i.e., lag1 to lag8). The result should include: The daily values for temperature, precipitation, and wind speed.The 8-day moving averages for each variable. The differences between the moving averages for each of the previous 1 to 8 days (e.g., the difference between today's moving average and the moving average from 1 day ago, from 2 days ago, and so on). Round all values to one decimal place. The data should be ordered by date, starting from January 9, 2019.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq031

CREATE TABLE GSOD2019 («stn» STRING, «wban» STRING, «year» STRING, «mo» STRING, «da» STRING, «temp» FLOAT, «count_temp» INT, «dewp» FLOAT, «count_dewp» INT, «slp» FLOAT, «count_slp» INT, «stp» FLOAT, «count_stp» INT, «visib» FLOAT, «count_visib» INT, «wdsp» STRING, «count_wdsp» STRING, «mxpsd» STRING, «gust» FLOAT, «max» FLOAT, «flag_max» STRING, «min» FLOAT, «flag_min» STRING, «prcp» FLOAT, «flag_prcp» STRING, «sndp» FLOAT, «fog» STRING, «rain_drizzle» STRING, «snow_ice_pellets» STRING, «hail» STRING, «thunder» STRING, «tornado_funnel_cloud» STRING)

HYPOTHESIS hyp0_1_0 : GSOD2019 "ROUND((\"temp\" - 32) * 5.0 / 9.0, 1) = ROUND((\"temp\" - 32.0) * 5.0 / 9.0, 1)"
theorem eq_0_1 (t : TableRel GSOD2019_schema) (h0 : hyp0_1_0 t) :
    (sql%([GSOD2019_schema]) "WITH daily_data AS (\n    SELECT\n        TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS \"DATE\",\n        ROUND((\"temp\" - 32) * 5.0 / 9.0, 1) AS \"TEMP_C\",\n        ROUND(\"prcp\" * 2.54, 1) AS \"PRCP_CM\",\n        ROUND(CAST(\"wdsp\" AS FLOAT) * 0.514444, 1) AS \"WDSP_MPS\"\n    FROM \"NOAA_DATA\".\"NOAA_GSOD\".\"GSOD2019\"\n    WHERE \"stn\" = '725290' AND \"wban\" = '14768'\n      AND \"mo\" IN ('01','02','03')\n),\nwith_ma AS (\n    SELECT\n        \"DATE\",\n        \"TEMP_C\",\n        \"PRCP_CM\",\n        \"WDSP_MPS\",\n        ROUND(AVG(\"TEMP_C\") OVER (ORDER BY \"DATE\" ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS \"TEMP_MA_8D\",\n        ROUND(AVG(\"PRCP_CM\") OVER (ORDER BY \"DATE\" ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS \"PRCP_MA_8D\",\n        ROUND(AVG(\"WDSP_MPS\") OVER (ORDER BY \"DATE\" ROWS BETWEEN 7 PRECEDING AND CURRENT ROW), 1) AS \"WDSP_MA_8D\"\n    FROM daily_data\n),\nwith_lags AS (\n    SELECT\n        \"DATE\",\n        \"TEMP_C\",\n        \"PRCP_CM\",\n        \"WDSP_MPS\",\n        \"TEMP_MA_8D\",\n        \"PRCP_MA_8D\",\n        \"WDSP_MA_8D\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 1) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_1\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 2) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_2\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 3) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_3\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 4) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_4\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 5) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_5\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 6) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_6\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 7) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_7\",\n        ROUND(\"TEMP_MA_8D\" - LAG(\"TEMP_MA_8D\", 8) OVER (ORDER BY \"DATE\"), 1) AS \"TEMP_MA_DIFF_8\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 1) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_1\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 2) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_2\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 3) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_3\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 4) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_4\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 5) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_5\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 6) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_6\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 7) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_7\",\n        ROUND(\"PRCP_MA_8D\" - LAG(\"PRCP_MA_8D\", 8) OVER (ORDER BY \"DATE\"), 1) AS \"PRCP_MA_DIFF_8\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 1) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_1\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 2) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_2\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 3) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_3\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 4) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_4\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 5) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_5\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 6) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_6\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 7) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_7\",\n        ROUND(\"WDSP_MA_8D\" - LAG(\"WDSP_MA_8D\", 8) OVER (ORDER BY \"DATE\"), 1) AS \"WDSP_MA_DIFF_8\"\n    FROM with_ma\n)\nSELECT *\nFROM with_lags\nWHERE \"DATE\" >= '2019-01-09'\nORDER BY \"DATE\";") t ~= (sql%([GSOD2019_schema]) "WITH raw_data AS (\n    SELECT\n        TO_DATE(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS dt,\n        ROUND((\"temp