ON_PER_BLOCK_GROUP\n    FROM distributed_banks\n    GROUP BY \"zip_code\"\n)\nSELECT\n    \"zip_code\" AS \"ZIP_CODE\",\n    BANK_CONCENTRATION_PER_BLOCK_GROUP AS \"BANK_CONCENTRATION_PER_BLOCK_GROUP\"\nFROM zip_concentration\nORDER BY BANK_CONCENTRATION_PER_BLOCK_GROUP DESC\nLIMIT 1;") t := by
