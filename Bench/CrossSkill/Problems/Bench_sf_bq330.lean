import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq330 — crossskill equivalence(s)

Question: Which Colorado zip code has the highest concentration of bank locations per block group, based on the overlap between zip codes and block groups?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq330

CREATE TABLE LOCATIONS («fdic_certificate_number» STRING, «institution_name» STRING, «branch_name» STRING, «branch_number» STRING, «main_office» BOOL, «branch_address» STRING, «branch_city» STRING, «zip_code» STRING, «branch_county» STRING, «county_fips_code» STRING, «state» STRING, «state_name» STRING, «institution_class» STRING, «cbsa_fips_code» STRING, «cbsa_name» STRING, «cbsa_division_flag» BOOL, «cbsa_division_fips_code» INT, «cbsa_division_name» STRING, «cbsa_metro_flag» BOOL, «cbsa_metro_fips_code» STRING, «cbsa_metro_name» STRING, «cbsa_micro_flag» BOOL, «csa_flag» BOOL, «csa_fips_code» STRING, «csa_name» STRING, «date_established» STRING, «fdic_uninum» STRING, «last_updated» STRING, «service_type» STRING, «branch_fdic_uninum» STRING)
CREATE TABLE BLOCKGROUPS_08 («geo_id» STRING, «state_fips_code» STRING, «county_fips_code» STRING, «tract_ce» STRING, «blockgroup_ce» STRING, «lsad_name» STRING, «mtfcc_feature_class_code» STRING, «functional_status» STRING, «area_land_meters» INT, «area_water_meters» INT, «internal_point_lat» FLOAT, «internal_point_lon» FLOAT, «internal_point_geom» STRING, «blockgroup_geom» STRING)
CREATE TABLE ZIP_CODES («zip_code» STRING, «city» STRING, «county» STRING, «state_fips_code» STRING, «state_code» STRING, «state_name» STRING, «fips_class_code» STRING, «mtfcc_feature_class_code» STRING, «functional_status» STRING, «area_land_meters» FLOAT, «area_water_meters» FLOAT, «internal_point_lat» FLOAT, «internal_point_lon» FLOAT, «internal_point_geom» STRING, «zip_code_geom» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([LOCATIONS_schema, BLOCKGROUPS_08_schema, ZIP_CODES_schema]) "WITH zip_with_block_groups AS (\n  SELECT DISTINCT z.\"zip_code\"\n  FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" z\n  JOIN \"FDA\".\"GEO_CENSUS_BLOCKGROUPS\".\"BLOCKGROUPS_08\" b\n    ON ST_INTERSECTS(TO_GEOGRAPHY(z.\"zip_code_geom\"), TO_GEOGRAPHY(b.\"blockgroup_geom\"))\n  WHERE z.\"state_code\" = 'CO'\n),\nbank_counts AS (\n  SELECT \"zip_code\", CAST(COUNT(*) AS FLOAT) AS bank_count\n  FROM \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\"\n  WHERE \"state_name\" = 'Colorado'\n  GROUP BY \"zip_code\"\n)\nSELECT \n  bc.\"zip_code\" AS ZIP_CODE,\n  bc.bank_count AS BANK_CONCENTRATION_PER_BLOCK_GROUP\nFROM bank_counts bc\nJOIN zip_with_block_groups zb ON bc.\"zip_code\" = zb.\"zip_code\"\nORDER BY BANK_CONCENTRATION_PER_BLOCK_GROUP DESC\nLIMIT 1;") t ~= (sql%([LOCATIONS_schema, BLOCKGROUPS_08_schema, ZIP_CODES_schema]) "WITH zip_bg_overlap AS (\n  SELECT \n    z.\"zip_code\",\n    bg.\"geo_id\",\n    COALESCE(\n      ST_AREA(ST_INTERSECTION(TO_GEOGRAPHY(z.\"zip_code_geom\"), TO_GEOGRAPHY(bg.\"blockgroup_geom\"))),\n      0\n    ) / NULLIF(ST_AREA(TO_GEOGRAPHY(bg.\"blockgroup_geom\")), 0) AS overlap_ratio\n  FROM \"FDA\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" z\n  JOIN \"FDA\".\"GEO_CENSUS_BLOCKGROUPS\".\"BLOCKGROUPS_08\" bg\n    ON ST_INTERSECTS(TO_GEOGRAPHY(z.\"zip_code_geom\"), TO_GEOGRAPHY(bg.\"blockgroup_geom\"))\n  WHERE z.\"state_code\" = 'CO'\n),\nbank_counts AS (\n  SELECT \"zip_code\", COUNT(*) AS bank_count\n  FROM \"FDA\".\"FDIC_BANKS\".\"LOCATIONS\"\n  WHERE \"state_name\" = 'Colorado'\n  GROUP BY \"zip_code\"\n),\nconcentration AS (\n  SELECT \n    zbo.\"zip_code\",\n    zbo.\"geo_id\",\n    COALESCE(bc.bank_count, 0) * zbo.overlap_ratio AS bank_institutions_per_bg\n  FROM zip_bg_overlap zbo\n  LEFT JOIN bank_counts bc ON zbo.\"zip_code\" = bc.\"zip_code\"\n),\nzip_max_concentration AS (\n  SELECT \n    \"zip_code\" AS ZIP_CODE,\n    MAX(bank_institutions_per_bg) AS BANK_CONCENTRATION_PER_BLOCK_GROUP\n  FROM concentration\n  GROUP BY \"zip_code\"\n)\nSELECT ZIP_CODE, BANK_CONCENTRATION_PER_BLOCK_GROUP\nFROM zip_max_concentration\nORDER BY BANK_CONCENTRATION_PER_BLOCK_GROUP DESC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

