import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq442 — crossskill equivalence(s)

Question: Please collect the information of the top 6 trade report with the highest closing prices. Refer to the document for all the information I want.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq442

CREATE TABLE TRADE_CAPTURE_REPORT («SendingTime» INT, «TargetCompID» STRING, «SenderCompID» STRING, «Symbol» STRING, «Quantity» INT, «OrderID» STRING, «TransactTime» INT, «StrikePrice» FLOAT, «LastPx» FLOAT, «MaturityDate» INT, «TradeReportID» STRING, «TradeDate» STRING, «CFICode» STRING, «Sides» STRING)

theorem eq_0_1 :
    sql%([TRADE_CAPTURE_REPORT_schema]) "SELECT\n  t.\"OrderID\" AS TRADEID,\n  TO_VARCHAR(TO_TIMESTAMP(t.\"TransactTime\", 6), 'YYYY-MM-DD HH24:MI:SS.FF6') || ' UTC' AS TRADETIMESTAMP,\n  CASE\n    WHEN LEFT(t.\"TargetCompID\", 4) = 'MOMO' THEN 'Momentum'\n    WHEN LEFT(t.\"TargetCompID\", 4) = 'LUCK' THEN 'Feeling Lucky'\n    WHEN LEFT(t.\"TargetCompID\", 4) = 'PRED' THEN 'Prediction'\n  END AS ALGORITHM,\n  t.\"Symbol\" AS SYMBOL,\n  t.\"LastPx\" AS OPENPRICE,\n  t.\"StrikePrice\" AS CLOSEPRICE,\n  f.value:\"Side\"::STRING AS TRADEDIRECTION,\n  CASE\n    WHEN f.value:\"Side\"::STRING = 'SHORT' THEN -1\n    WHEN f.value:\"Side\"::STRING = 'LONG' THEN 1\n  END AS TRADEMULTIPLIER\nFROM \"CYMBAL_INVESTMENTS\".\"CYMBAL_INVESTMENTS\".\"TRADE_CAPTURE_REPORT\" t,\nLATERAL FLATTEN(input => t.\"Sides\") f\nORDER BY t.\"StrikePrice\" DESC, t.\"TransactTime\" DESC\nLIMIT 6;" = sql%([TRADE_CAPTURE_REPORT_schema]) "SELECT \n  \"OrderID\" AS TRADEID,\n  TO_VARCHAR(TO_TIMESTAMP(\"TransactTime\"::NUMBER, 6), 'YYYY-MM-DD HH24:MI:SS.FF6') || ' UTC' AS TRADETIMESTAMP,\n  CASE LEFT(\"TargetCompID\", 4)\n    WHEN 'MOMO' THEN 'Momentum'\n    WHEN 'LUCK' THEN 'Feeling Lucky'\n    WHEN 'PRED' THEN 'Prediction'\n  END AS ALGORITHM,\n  \"Symbol\" AS SYMBOL,\n  \"LastPx\" AS OPENPRICE,\n  \"StrikePrice\" AS CLOSEPRICE,\n  s.value:\"Side\"::STRING AS TRADEDIRECTION,\n  CASE s.value:\"Side\"::STRING\n    WHEN 'LONG' THEN 1\n    WHEN 'SHORT' THEN -1\n  END AS TRADEMULTIPLIER\nFROM \"CYMBAL_INVESTMENTS\".\"CYMBAL_INVESTMENTS\".\"TRADE_CAPTURE_REPORT\",\nLATERAL FLATTEN(input => \"Sides\") s\nORDER BY \"StrikePrice\" DESC\nLIMIT 6;" := by
  first | sql_equiv | sorry

