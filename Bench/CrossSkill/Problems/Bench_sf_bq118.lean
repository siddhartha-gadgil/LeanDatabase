import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq118 — crossskill equivalence(s)

Question: Among individuals identified as white, how much higher is the average number of deaths from ICD-10 codes whose descriptions contain the word “discharge” (specifically excluding “Urethral discharge,” “Discharge of firework,” and “Legal intervention involving firearm discharge”) compared to the average number of deaths from ICD-10 codes whose descriptions contain the word “vehicle,” when aggregated by age groups?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq118

CREATE TABLE DEATHRECORDS («HispanicOrigin» INT, «RaceRecode3» INT, «RaceImputationFlag» INT, «HispanicOriginRaceRecode» INT, «NumberOfRecordAxisConditions» INT, «NumberOfEntityAxisConditions» INT, «CauseRecode39» INT, «InfantCauseRecode130» INT, «CauseRecode113» INT, «CauseRecode358» INT, «PlaceOfInjury» INT, «Autopsy» STRING, «RaceRecode5» INT, «InjuryAtWork» STRING, «Id» INT, «AgeRecode27» INT, «MannerOfDeath» INT, «Education2003Revision» INT, «MethodOfDisposition» STRING, «CurrentDataYear» INT, «DayOfWeekOfDeath» INT, «ActivityCode» INT, «AgeRecode52» INT, «MaritalStatus» STRING, «AgeRecode12» INT, «PlaceOfDeathAndDecedentsStatus» INT, «InfantAgeRecode22» INT, «ResidentStatus» INT, «AgeType» INT, «Race» INT, «MonthOfDeath» INT, «Age» INT, «AgeSubstitutionFlag» INT, «BridgedRaceFlag» INT, «Icd10Code» STRING, «Sex» STRING, «Education1989Revision» INT, «EducationReportingFlag» INT)
CREATE TABLE AGERECODE12 («Code» INT, «Description» STRING)
CREATE TABLE RACE («Description» STRING, «Code» INT)
CREATE TABLE ICD10CODE («Description» STRING, «Code» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_by_age AS (\n  SELECT \n    a12.\"Description\" AS age_group,\n    a12.\"Code\" AS age_code,\n    ROUND(COUNT(*) * 1.0 / COUNT(DISTINCT d.\"Icd10Code\"), 6) AS avg_deaths\n  FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" d\n  JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" i ON d.\"Icd10Code\" = i.\"Code\"\n  JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" a12 ON d.\"AgeRecode12\" = a12.\"Code\"\n  WHERE d.\"Race\" = 1\n    AND LOWER(i.\"Description\") LIKE '%discharge%'\n    AND i.\"Description\" NOT LIKE '%Urethral discharge%'\n    AND i.\"Description\" NOT LIKE '%Discharge of firework%'\n    AND i.\"Description\" NOT LIKE '%Legal intervention involving firearm discharge%'\n  GROUP BY a12.\"Code\", a12.\"Description\"\n),\nvehicle_by_age AS (\n  SELECT \n    a12.\"Description\" AS age_group,\n    a12.\"Code\" AS age_code,\n    ROUND(COUNT(*) * 1.0 / COUNT(DISTINCT d.\"Icd10Code\"), 6) AS avg_deaths\n  FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" d\n  JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" i ON d.\"Icd10Code\" = i.\"Code\"\n  JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" a12 ON d.\"AgeRecode12\" = a12.\"Code\"\n  WHERE d.\"Race\" = 1\n    AND LOWER(i.\"Description\") LIKE '%vehicle%'\n  GROUP BY a12.\"Code\", a12.\"Description\"\n)\nSELECT \n  COALESCE(dc.age_group, vc.age_group) AS \"Age Group\",\n  dc.avg_deaths AS \"Avg Deaths - Discharge Codes\",\n  vc.avg_deaths AS \"Avg Deaths - Vehicle Codes\",\n  ROUND(dc.avg_deaths - vc.avg_deaths, 6) AS \"Difference (Discharge - Vehicle)\"\nFROM discharge_by_age dc\nFULL OUTER JOIN vehicle_by_age vc ON dc.age_code = vc.age_code\nORDER BY COALESCE(dc.age_code, vc.age_code);") t ~= (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_by_age AS (\n    SELECT \n        d.\"AgeRecode12\" AS age_code,\n        CAST(COUNT(*) AS FLOAT) / COUNT(DISTINCT d.\"Icd10Code\") AS avg_deaths\n    FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" d\n    JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" i ON d.\"Icd10Code\" = i.\"Code\"\n    WHERE d.\"Race\" = 1\n      AND LOWER(i.\"Description\") LIKE '%discharge%'\n      AND LOWER(i.\"Description\") NOT LIKE '%urethral discharge%'\n      AND LOWER(i.\"Description\") NOT LIKE '%discharge of firework%'\n      AND LOWER(i.\"Description\") NOT LIKE '%legal intervention involving firearm discharge%'\n    GROUP BY d.\"AgeRecode12\"\n),\nvehicle_by_age AS (\n    SELECT \n        d.\"AgeRecode12\" AS age_code,\n        CAST(COUNT(*) AS FLOAT) / COUNT(DISTINCT d.\"Icd10Code\") AS avg_deaths\n    FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" d\n    JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" i ON d.\"Icd10Code\" = i.\"Code\"\n    WHERE d.\"Race\" = 1\n      AND LOWER(i.\"Description\") LIKE '%vehicle%'\n    GROUP BY d.\"AgeRecode12\"\n)\nSELECT \n    a.\"Description\" AS \"Age Group\",\n    ROUND(dis.avg_deaths, 6) AS \"Avg Deaths - Discharge Codes\",\n    ROUND(veh.avg_deaths, 6) AS \"Avg Deaths - Vehicle Codes\",\n    ROUND(dis.avg_deaths - veh.avg_deaths, 6) AS \"Difference (Discharge - Vehicle)\"\nFROM discharge_by_age dis\nJOIN vehicle_by_age veh ON dis.age_code = veh.age_code\nJOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" a ON dis.age_code = a.\"Code\"\nORDER BY dis.age_code;") t := by
