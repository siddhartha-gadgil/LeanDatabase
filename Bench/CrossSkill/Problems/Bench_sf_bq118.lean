import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq118 — crossskill equivalence(s)

Question: Among individuals identified as white, how much higher is the average number of deaths from ICD-10 codes whose descriptions contain the word “discharge” (specifically excluding “Urethral discharge,” “Discharge of firework,” and “Legal intervention involving firearm discharge”) compared to the average number of deaths from ICD-10 codes whose descriptions contain the word “vehicle,” when aggregated by age groups?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq118

CREATE TABLE DEATHRECORDS («HispanicOrigin» INT, «RaceRecode3» INT, «RaceImputationFlag» INT, «HispanicOriginRaceRecode» INT, «NumberOfRecordAxisConditions» INT, «NumberOfEntityAxisConditions» INT, «CauseRecode39» INT, «InfantCauseRecode130» INT, «CauseRecode113» INT, «CauseRecode358» INT, «PlaceOfInjury» INT, «Autopsy» STRING, «RaceRecode5» INT, «InjuryAtWork» STRING, «Id» INT, «AgeRecode27» INT, «MannerOfDeath» INT, «Education2003Revision» INT, «MethodOfDisposition» STRING, «CurrentDataYear» INT, «DayOfWeekOfDeath» INT, «ActivityCode» INT, «AgeRecode52» INT, «MaritalStatus» STRING, «AgeRecode12» INT, «PlaceOfDeathAndDecedentsStatus» INT, «InfantAgeRecode22» INT, «ResidentStatus» INT, «AgeType» INT, «Race» INT, «MonthOfDeath» INT, «Age» INT, «AgeSubstitutionFlag» INT, «BridgedRaceFlag» INT, «Icd10Code» STRING, «Sex» STRING, «Education1989Revision» INT, «EducationReportingFlag» INT)
CREATE TABLE AGERECODE12 («Code» INT, «Description» STRING)
CREATE TABLE RACE («Description» STRING, «Code» INT)
CREATE TABLE ICD10CODE («Description» STRING, «Code» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_by_age AS (SELECT a12.\"Description\" AS age_group, a12.\"Code\" AS age_code, ROUND(CAST(CAST(COUNT(*) * 1.0 AS DOUBLE PRECISION) / COUNT(DISTINCT d.\"Icd10Code\") AS DECIMAL), 6) AS avg_deaths FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS i ON d.\"Icd10Code\" = i.\"Code\" JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" AS a12 ON d.\"AgeRecode12\" = a12.\"Code\" WHERE d.\"Race\" = 1 AND LOWER(i.\"Description\") LIKE '%discharge%' AND NOT i.\"Description\" LIKE '%Urethral discharge%' AND NOT i.\"Description\" LIKE '%Discharge of firework%' AND NOT i.\"Description\" LIKE '%Legal intervention involving firearm discharge%' GROUP BY a12.\"Code\", a12.\"Description\"), vehicle_by_age AS (SELECT a12.\"Description\" AS age_group, a12.\"Code\" AS age_code, ROUND(CAST(CAST(COUNT(*) * 1.0 AS DOUBLE PRECISION) / COUNT(DISTINCT d.\"Icd10Code\") AS DECIMAL), 6) AS avg_deaths FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS i ON d.\"Icd10Code\" = i.\"Code\" JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" AS a12 ON d.\"AgeRecode12\" = a12.\"Code\" WHERE d.\"Race\" = 1 AND LOWER(i.\"Description\") LIKE '%vehicle%' GROUP BY a12.\"Code\", a12.\"Description\") SELECT COALESCE(dc.age_group, vc.age_group) AS \"Age Group\", dc.avg_deaths AS \"Avg Deaths - Discharge Codes\", vc.avg_deaths AS \"Avg Deaths - Vehicle Codes\", ROUND(dc.avg_deaths - vc.avg_deaths, 6) AS \"Difference (Discharge - Vehicle)\" FROM discharge_by_age AS dc FULL OUTER JOIN vehicle_by_age AS vc ON dc.age_code = vc.age_code ORDER BY COALESCE(dc.age_code, vc.age_code)") t ~= (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_by_age AS (SELECT d.\"AgeRecode12\" AS age_code, CAST(COUNT(*) AS DOUBLE PRECISION) / COUNT(DISTINCT d.\"Icd10Code\") AS avg_deaths FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS i ON d.\"Icd10Code\" = i.\"Code\" WHERE d.\"Race\" = 1 AND LOWER(i.\"Description\") LIKE '%discharge%' AND NOT LOWER(i.\"Description\") LIKE '%urethral discharge%' AND NOT LOWER(i.\"Description\") LIKE '%discharge of firework%' AND NOT LOWER(i.\"Description\") LIKE '%legal intervention involving firearm discharge%' GROUP BY d.\"AgeRecode12\"), vehicle_by_age AS (SELECT d.\"AgeRecode12\" AS age_code, CAST(COUNT(*) AS DOUBLE PRECISION) / COUNT(DISTINCT d.\"Icd10Code\") AS avg_deaths FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS i ON d.\"Icd10Code\" = i.\"Code\" WHERE d.\"Race\" = 1 AND LOWER(i.\"Description\") LIKE '%vehicle%' GROUP BY d.\"AgeRecode12\") SELECT a.\"Description\" AS \"Age Group\", ROUND(dis.avg_deaths, 6) AS \"Avg Deaths - Discharge Codes\", ROUND(veh.avg_deaths, 6) AS \"Avg Deaths - Vehicle Codes\", ROUND(dis.avg_deaths - veh.avg_deaths, 6) AS \"Difference (Discharge - Vehicle)\" FROM discharge_by_age AS dis JOIN vehicle_by_age AS veh ON dis.age_code = veh.age_code JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" AS a ON dis.age_code = a.\"Code\" ORDER BY dis.age_code") t := by
