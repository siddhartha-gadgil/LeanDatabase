    (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_codes AS (\n    SELECT \"Code\"\n    FROM \"DEATH\".\"DEATH\".\"ICD10CODE\"\n    WHERE LOWER(\"Description\") LIKE '%discharge%'\n      AND \"Description\" NOT LIKE '%Urethral discharge%'\n      AND \"Description\" NOT LIKE '%Discharge of firework%'\n      AND \"Description\" NOT LIKE '%Legal intervention involving firearm discharge%'\n),\nvehicle_codes AS (\n    SELECT \"Code\"\n    FROM \"DEATH\".\"DEATH\".\"ICD10CODE\"\n    WHERE LOWER(\"Description\") LIKE '%vehicle%'\n),\ndischarge_deaths AS (\n    SELECT \n        d.\"AgeRecode12\",\n        d.\"Icd10Code\",\n        COUNT(*) AS death_count\n    FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" d\n    JOIN discharge_codes dc ON d.\"Icd10Code\" = dc.\"Code\"\n    WHERE d.\"Race\" = 1\n    GROUP BY d.\"AgeRecode12\", d.\"Icd10Code\"\n),\nvehicle_deaths AS (\n    SELECT \n        d.\"AgeRecode12\",\n        d.\"Icd10Code\",\n        COUNT(*) AS death_count\n    FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" d\n    JOIN vehicle_codes vc ON d.\"Icd10Code\" = vc.\"Code\"\n    WHERE d.\"Race\" = 1\n    GROUP BY d.\"AgeRecode12\", d.\"Icd10Code\"\n),\navg_discharge AS (\n    SELECT \n        \"AgeRecode12\",\n        AVG(death_count) AS avg_deaths\n    FROM discharge_deaths\n    GROUP BY \"AgeRecode12\"\n),\navg_vehicle AS (\n    SELECT \n        \"AgeRecode12\",\n        AVG(death_count) AS avg_deaths\n    FROM vehicle_deaths\n    GROUP BY \"AgeRecode12\"\n)\nSELECT \n    ar.\"Description\" AS \"Age Group\",\n    COALESCE(ad.avg_deaths, 0) AS \"Avg Deaths - Discharge Codes\",\n    COALESCE(av.avg_deaths, 0) AS \"Avg Deaths - Vehicle Codes\",\n    COALESCE(ad.avg_deaths, 0) - COALESCE(av.avg_deaths, 0) AS \"Difference (Discharge - Vehicle)\"\nFROM \"DEATH\".\"DEATH\".\"AGERECODE12\" ar\nLEFT JOIN avg_discharge ad ON ar.\"Code\" = ad.\"AgeRecode12\"\nLEFT JOIN avg_vehicle av ON ar.\"Code\" = av.\"AgeRecode12\"\nORDER BY ar.\"Code\";") t ~= (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_by_age_code AS (\n    SELECT\n        ar.\"Description\" AS age_group,\n        ar.\"Code\" AS age_code,\n        icd.\"Code\" AS icd_code,\n        COUNT(*) AS death_count\n    FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" dr\n    JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" icd\n        ON dr.\"Icd10Code\" = icd.\"Code\"\n    JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" ar\n        ON dr.\"AgeRecode12\" = ar.\"Code\"\n    WHERE dr.\"Race\" = 1\n      AND LOWER(icd.\"Description\") LIKE '%discharge%'\n      AND icd.\"Description\" NOT LIKE '%Urethral discharge%'\n      AND icd.\"Description\" NOT LIKE '%Discharge of firework%'\n      AND icd.\"Description\" NOT LIKE '%Legal intervention involving firearm discharge%'\n    GROUP BY ar.\"Description\", ar.\"Code\", icd.\"Code\"\n),\nvehicle_by_age_code AS (\n    SELECT\n        ar.\"Description\" AS age_group,\n        ar.\"Code\" AS age_code,\n        icd.\"Code\" AS icd_code,\n        COUNT(*) AS death_count\n    FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" dr\n    JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" icd\n        ON dr.\"Icd10Code\" = icd.\"Code\"\n    JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" ar\n        ON dr.\"AgeRecode12\" = ar.\"Code\"\n    WHERE dr.\"Race\" = 1\n      AND LOWER(icd.\"Description\") LIKE '%vehicle%'\n    GROUP BY ar.\"Description\", ar.\"Code\", icd.\"Code\"\n),\ndischarge_avg AS (\n    SELECT age_group, age_code, AVG(death_count) AS avg_deaths_discharge\n    FROM discharge_by_age_code\n    GROUP BY age_group, age_code\n),\nvehicle_avg AS (\n    SELECT age_group, age_code, AVG(death_count) AS avg_deaths_vehicle\n    FROM vehicle_by_age_code\n    GROUP BY age_group, age_code\n)\nSELECT\n    COALESCE(d.age_group, v.age_group) AS \"Age Group\",\n    ROUND(d.avg_deaths_discharge, 6) AS \"Avg Deaths - Discharge Codes\",\n    ROUND(v.avg_deaths_vehicle, 6) AS \"Avg Deaths - Vehicle Codes\",\n    ROUND(d.avg_deaths_discharge - v.avg_deaths_vehicle, 6) AS \"Difference (Discharge - Vehicle)\"\nFROM discharge_avg d\nFULL OUTER JOIN vehicle_avg v\n    ON d.age_code = v.age_code\nORDER BY COALESCE(d.age_code, v.age_code);") t := by
