import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq080 — crossskill equivalence(s)

Question: Using only the Ethereum traces table, can you provide a daily cumulative count of smart contracts created by external users (where trace_address is null) versus contracts created by other contracts (where trace_address is not null) between August 30, 2018, and September 30, 2018? Ensure results include every date in this range, even if no new contracts were created, and show strictly increasing cumulative totals.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq080

CREATE TABLE TRACES («transaction_hash» STRING, «transaction_index» INT, «from_address» STRING, «to_address» STRING, «value» INT, «input» STRING, «output» STRING, «trace_type» STRING, «call_type» STRING, «reward_type» STRING, «gas» INT, «gas_used» INT, «subtraces» INT, «trace_address» STRING, «error» STRING, «status» INT, «block_timestamp» INT, «block_number» INT, «block_hash» STRING, «trace_id» STRING)

theorem eq_0_1 :
    sql%([TRACES_schema]) "WITH date_range AS (\n  SELECT DATEADD(day, seq4(), '2018-08-30'::DATE) AS \"DATE\"\n  FROM TABLE(GENERATOR(ROWCOUNT => 32))\n),\ndaily_counts AS (\n  SELECT \n    TO_DATE(TO_TIMESTAMP(\"block_timestamp\" / 1000000)) AS dt,\n    SUM(CASE WHEN \"trace_address\" IS NULL THEN 1 ELSE 0 END) AS external_daily,\n    SUM(CASE WHEN \"trace_address\" IS NOT NULL THEN 1 ELSE 0 END) AS contract_daily\n  FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n  WHERE \"trace_type\" = 'create'\n    AND TO_DATE(TO_TIMESTAMP(\"block_timestamp\" / 1000000)) BETWEEN '2018-08-30' AND '2018-09-30'\n  GROUP BY dt\n)\nSELECT \n  dr.\"DATE\",\n  SUM(COALESCE(dc.external_daily, 0)) OVER (ORDER BY dr.\"DATE\") AS \"EXTERNAL_USER_CUMULATIVE_CONTRACTS\",\n  SUM(COALESCE(dc.contract_daily, 0)) OVER (ORDER BY dr.\"DATE\") AS \"CONTRACT_CREATOR_CUMULATIVE_CONTRACTS\"\nFROM date_range dr\nLEFT JOIN daily_counts dc ON dr.\"DATE\" = dc.dt\nORDER BY dr.\"DATE\";" = sql%([TRACES_schema]) "WITH date_spine AS (\n    -- Generate all dates from Aug 30 to Sep 30, 2018 (32 days)\n    SELECT DATEADD(DAY, SEQ4(), '2018-08-30'::DATE) AS \"DATE\"\n    FROM TABLE(GENERATOR(ROWCOUNT => 32))\n),\ndaily_counts AS (\n    -- Count daily contract creations by type\n    SELECT\n        TO_DATE(TO_TIMESTAMP(\"block_timestamp\", 6)) AS dt,\n        SUM(CASE WHEN \"trace_address\" IS NULL THEN 1 ELSE 0 END) AS external_daily,\n        SUM(CASE WHEN \"trace_address\" IS NOT NULL THEN 1 ELSE 0 END) AS contract_daily\n    FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n    WHERE \"trace_type\" = 'create'\n      AND TO_DATE(TO_TIMESTAMP(\"block_timestamp\", 6)) BETWEEN '2018-08-30' AND '2018-09-30'\n    GROUP BY dt\n)\nSELECT\n    ds.\"DATE\",\n    SUM(COALESCE(dc.external_daily, 0)) OVER (ORDER BY ds.\"DATE\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"EXTERNAL_USER_CUMULATIVE_CONTRACTS\",\n    SUM(COALESCE(dc.contract_daily, 0)) OVER (ORDER BY ds.\"DATE\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"CONTRACT_CREATOR_CUMULATIVE_CONTRACTS\"\nFROM date_spine ds\nLEFT JOIN daily_counts dc ON ds.\"DATE\" = dc.dt\nORDER BY ds.\"DATE\";" := by
  first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([TRACES_schema]) "WITH date_range AS (\n  SELECT DATEADD(day, seq4(), '2018-08-30'::DATE) AS \"DATE\"\n  FROM TABLE(GENERATOR(ROWCOUNT => 32))\n),\ndaily_counts AS (\n  SELECT \n    TO_DATE(TO_TIMESTAMP(\"block_timestamp\" / 1000000)) AS dt,\n    SUM(CASE WHEN \"trace_address\" IS NULL THEN 1 ELSE 0 END) AS external_daily,\n    SUM(CASE WHEN \"trace_address\" IS NOT NULL THEN 1 ELSE 0 END) AS contract_daily\n  FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n  WHERE \"trace_type\" = 'create'\n    AND TO_DATE(TO_TIMESTAMP(\"block_timestamp\" / 1000000)) BETWEEN '2018-08-30' AND '2018-09-30'\n  GROUP BY dt\n)\nSELECT \n  dr.\"DATE\",\n  SUM(COALESCE(dc.external_daily, 0)) OVER (ORDER BY dr.\"DATE\") AS \"EXTERNAL_USER_CUMULATIVE_CONTRACTS\",\n  SUM(COALESCE(dc.contract_daily, 0)) OVER (ORDER BY dr.\"DATE\") AS \"CONTRACT_CREATOR_CUMULATIVE_CONTRACTS\"\nFROM date_range dr\nLEFT JOIN daily_counts dc ON dr.\"DATE\" = dc.dt\nORDER BY dr.\"DATE\";" = sql%([TRACES_schema]) "WITH date_range AS (\n  SELECT DATEADD(DAY, seq4(), '2018-08-30'::DATE) AS \"DATE\"\n  FROM TABLE(GENERATOR(ROWCOUNT => 32))\n),\ndaily_counts AS (\n  SELECT\n    TO_DATE(TO_TIMESTAMP(\"block_timestamp\" / 1000000)) AS dt,\n    COUNT(CASE WHEN \"trace_address\" IS NULL THEN 1 END) AS external_user_count,\n    COUNT(CASE WHEN \"trace_address\" IS NOT NULL THEN 1 END) AS contract_creator_count\n  FROM \"CRYPTO\".\"CRYPTO_ETHEREUM\".\"TRACES\"\n  WHERE \"trace_type\" = 'create'\n    AND TO_DATE(TO_TIMESTAMP(\"block_timestamp\" / 1000000)) BETWEEN '2018-08-30' AND '2018-09-30'\n  GROUP BY dt\n),\njoined AS (\n  SELECT\n    dr.\"DATE\",\n    COALESCE(dc.external_user_count, 0) AS external_user_count,\n    COALESCE(dc.contract_creator_count, 0) AS contract_creator_count\n  FROM date_range dr\n  LEFT JOIN daily_counts dc ON dr.\"DATE\" = dc.dt\n)\nSELECT\n  \"DATE\",\n  SUM(external_user_count) OVER (ORDER BY \"DATE\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"EXTERNAL_USER_CUMULATIVE_CONTRACTS\",\n  SUM(contract_creator_count) OVER (ORDER BY \"DATE\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"CONTRACT_CREATOR_CUMULATIVE_CONTRACTS\"\nFROM joined\nORDER BY \"DATE\";" := by
  first | sql_equiv | sorry

