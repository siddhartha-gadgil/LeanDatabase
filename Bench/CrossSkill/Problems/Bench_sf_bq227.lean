/-!
# sf_bq227 — crossskill equivalence(s)

Question: Could you provide the annual percentage shares, rounded to two decimal places, of the top 5 minor crime categories from 2008 in London's total crimes, with each year displayed in one row?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq227

CREATE TABLE CRIME_BY_LSOA («lsoa_code» STRING, «borough» STRING, «major_category» STRING, «minor_category» STRING, «value» INT, «year» INT, «month» INT)

theorem eq_0_1 : ∀ t,
    (sql%([CRIME_BY_LSOA_schema]) "WITH top5 AS (\n    SELECT \"minor_category\", SUM(\"value\") AS total_2008\n    FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\"\n    WHERE \"year\" = 2008\n    GROUP BY \"minor_category\"\n    ORDER BY total_2008 DESC\n    LIMIT 5\n),\ntop5_ranked AS (\n    SELECT \"minor_category\", total_2008, ROW_NUMBER() OVER (ORDER BY total_2008 DESC) AS rn\n    FROM top5\n),\nyearly_total AS (\n    SELECT \"year\", SUM(\"value\") AS total\n    FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\"\n    GROUP BY \"year\"\n),\ncategory_yearly AS (\n    SELECT c.\"year\", c.\"minor_category\", SUM(c.\"value\") AS cat_total\n    FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" c\n    INNER JOIN top5 t ON c.\"minor_category\" = t.\"minor_category\"\n    GROUP BY c.\"year\", c.\"minor_category\"\n)\nSELECT \n    cy.\"year\",\n    ROUND(SUM(CASE WHEN tr.rn = 1 THEN cy.cat_total * 100.0 / yt.total END), 2) AS \"Category 1\",\n    ROUND(SUM(CASE WHEN tr.rn = 2 THEN cy.cat_total * 100.0 / yt.total END), 2) AS \"Category 2\",\n    ROUND(SUM(CASE WHEN tr.rn = 3 THEN cy.cat_total * 100.0 / yt.total END), 2) AS \"Category 3\",\n    ROUND(SUM(CASE WHEN tr.rn = 4 THEN cy.cat_total * 100.0 / yt.total END), 2) AS \"Category 4\",\n    ROUND(SUM(CASE WHEN tr.rn = 5 THEN cy.cat_total * 100.0 / yt.total END), 2) AS \"Category 5\"\nFROM category_yearly cy\nJOIN yearly_total yt ON cy.\"year\" = yt.\"year\"\nJOIN top5_ranked tr ON cy.\"minor_category\" = tr.\"minor_category\"\nGROUP BY cy.\"year\"\nORDER BY cy.\"year\";") t ~= (sql%([CRIME_BY_LSOA_schema]) "WITH top5 AS (\n    SELECT \"minor_category\",\n           ROW_NUMBER() OVER (ORDER BY SUM(\"value\") DESC) AS rn\n    FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\"\n    WHERE \"year\" = 2008\n    GROUP BY \"minor_category\"\n    ORDER BY SUM(\"value\") DESC\n    LIMIT 5\n),\nyearly_total AS (\n    SELECT \"year\", SUM(\"value\") AS total\n    FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\"\n    GROUP BY \"year\"\n),\ncategory_yearly AS (\n    SELECT c.\"year\", t.rn, SUM(c.\"value\") AS cat_total\n    FROM \"LONDON\".\"LONDON_CRIME\".\"CRIME_BY_LSOA\" c\n    INNER JOIN top5 t ON c.\"minor_category\" = t.\"minor_category\"\n    GROUP BY c.\"year\", t.rn\n)\nSELECT\n    cy.\"year\" AS \"year\",\n    ROUND(100.0 * MAX(CASE WHEN cy.rn = 1 THEN cy.cat_total END) / yt.total, 2) AS \"Category 1\",\n    ROUND(100.0 * MAX(CASE WHEN cy.rn = 2 THEN cy.cat_total END) / yt.total, 2) AS \"Category 2\",\n    ROUND(100.0 * MAX(CASE WHEN cy.rn = 3 THEN cy.cat_total END) / yt.total, 2) AS \"Category 3\",\n    ROUND(100.0 * MAX(CASE WHEN cy.rn = 4 THEN cy.cat_total END) / yt.total, 2) AS \"Category 4\",\n    ROUND(100.0 * MAX(CASE WHEN cy.rn = 5 THEN cy.cat_total END) / yt.total, 2) AS \"Category 5\"\nFROM category_yearly cy\nJOIN yearly_total yt ON cy.\"year\" = yt.\"year\"\nGROUP BY cy.\"year\", yt.total\nORDER BY cy.\"year\";") t := by
  intro t; first | sql_equiv | sorry

