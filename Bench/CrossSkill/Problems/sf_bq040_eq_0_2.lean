egory_counts AS cc JOIN borough_counts AS bc ON cc.\"PICKUP_BOROUGH\" = bc.\"PICKUP_BOROUGH\" ORDER BY cc.\"PICKUP_BOROUGH\", cc.\"TIP_CATEGORY\"") t0 t1
