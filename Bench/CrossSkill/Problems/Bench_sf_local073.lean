    (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH customer_orders AS (\n    SELECT \n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\",\n        \"order_time\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\n-- Split recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT \n        r.\"pizza_id\",\n        TRIM(t.VALUE::STRING)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r,\n        LATERAL FLATTEN(INPUT => SPLIT(r.\"toppings\", ',')) t\n),\n-- For each order row, get base toppings from recipe\norder_base_toppings AS (\n    SELECT \n        co.row_id,\n        co.\"order_id\",\n        co.\"customer_id\",\n        co.\"pizza_id\",\n        co.\"exclusions\",\n        co.\"extras\",\n        co.\"order_time\",\n        rt.topping_id,\n        1 AS topping_count\n    FROM customer_orders co\n    JOIN recipe_toppings rt ON co.\"pizza_id\" = rt.\"pizza_id\"\n),\n-- Parse exclusions per order row\norder_exclusions AS (\n    SELECT \n        co.row_id,\n        TRIM(e.VALUE::STRING)::INT AS excluded_topping_id\n    FROM customer_orders co,\n        LATERAL FLATTEN(INPUT => SPLIT(co.\"exclusions\", ','), OUTER => TRUE) e\n    WHERE co.\"exclusions\" IS NOT NULL AND co.\"exclusions\" != ''\n),\n-- Parse extras per order row\norder_extras AS (\n    SELECT \n        co.row_id,\n        TRIM(x.VALUE::STRING)::INT AS extra_topping_id\n    FROM customer_orders co,\n        LATERAL FLATTEN(INPUT => SPLIT(co.\"extras\", ','), OUTER => TRUE) x\n    WHERE co.\"extras\" IS NOT NULL AND co.\"extras\" != ''\n),\n-- Remove exclusions from base toppings\nbase_minus_exclusions AS (\n    SELECT \n        obt.row_id,\n        obt.\"order_id\",\n        obt.\"customer_id\",\n        obt.\"pizza_id\",\n        obt.\"exclusions\",\n        obt.\"extras\",\n        obt.\"order_time\",\n        obt.topping_id,\n        obt.topping_count\n    FROM order_base_toppings obt\n    LEFT JOIN order_exclusions oe ON obt.row_id = oe.row_id AND obt.topping_id = oe.excluded_topping_id\n    WHERE oe.excluded_topping_id IS NULL\n),\n-- Combine base toppings (minus exclusions) with extras\n-- Extras that are already in base get counted as additional\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\", topping_id, topping_count\n    FROM base_minus_exclusions\n    UNION ALL\n    SELECT \n        ox.row_id,\n        co.\"order_id\",\n        co.\"customer_id\",\n        co.\"pizza_id\",\n        co.\"exclusions\",\n        co.\"extras\",\n        co.\"order_time\",\n        ox.extra_topping_id AS topping_id,\n        1 AS topping_count\n    FROM order_extras ox\n    JOIN customer_orders co ON ox.row_id = co.row_id\n),\n-- Aggregate topping counts per order row\ntopping_counts AS (\n    SELECT \n        at2.row_id,\n        at2.\"order_id\",\n        at2.\"customer_id\",\n        at2.\"pizza_id\",\n        at2.\"exclusions\",\n        at2.\"extras\",\n        at2.\"order_time\",\n        at2.topping_id,\n        SUM(at2.topping_count) AS total_count\n    FROM all_toppings at2\n    GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", \n             at2.\"exclusions\", at2.\"extras\", at2.\"order_time\", at2.topping_id\n),\n-- Join with topping names and format\nformatted_toppings AS (\n    SELECT \n        tc.row_id,\n        tc.\"order_id\",\n        tc.\"customer_id\",\n        tc.\"pizza_id\",\n        tc.\"exclusions\",\n        tc.\"extras\",\n        tc.\"order_time\",\n        tc.topping_id,\n        tc.total_count,\n        pt.\"topping_name\",\n        CASE WHEN tc.total_count > 1 THEN '2x ' || pt.\"topping_name\" ELSE pt.\"topping_name\" END AS formatted_topping,\n        CASE WHEN tc.total_count > 1 THEN 0 ELSE 1 END AS sort_group\n    FROM topping_counts tc\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" pt ON tc.topping_id = pt.\"topping_id\"\n),\n-- Build sorted ingredient list using LISTAGG\ningredient_list AS (\n    SELECT \n        ft.row_id,\n        ft.\"order_id\",\n        ft.\"customer_id\",\n        pn.\"pizza_name\" AS PIZZA_NAME,\n        LISTAGG(ft.formatted_topping, ', ') WITHIN GROUP (ORDER BY ft.sort_group, ft.\"topping_name\") AS ingredients\n    FROM formatted_toppings ft\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" pn ON ft.\"pizza_id\" = pn.\"pizza_id\"\n    GROUP BY ft.row_id, ft.\"order_id\", ft.\"customer_id\", ft.\"pizza_id\", pn.\"pizza_name\", ft.\"order_time\"\n)\nSELECT \n    il.row_id AS ROW_ID,\n    il.\"order_id\" AS ORDER_ID,\n    il.\"customer_id\" AS CUSTOMER_ID,\n    il.PIZZA_NAME,\n    il.PIZZA_NAME || ': ' || il.ingredients AS FINAL_INGREDIENTS\nFROM ingredient_list il\nORDER BY il.row_id;") t ~= (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (\n    SELECT\n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\") AS row_id,\n        ROW_NUMBER() OVER (PARTITION BY \"order_id\" ORDER BY \"customer_id\", \"pizza_id\") AS order_row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\n\n-- Split recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT\n        \"pizza_id\",\n        TRIM(t.VALUE::STRING)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\",\n        LATERAL SPLIT_TO_TABLE(\"toppings\", ',') AS t\n),\n\n-- Split exclusions from the customer orders into individual topping_ids\norder_exclusions AS (\n    SELECT\n        o.row_id,\n        TRIM(e.VALUE::STRING)::INT AS topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(o.\"exclusions\", ',') AS e\n    WHERE o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != ''\n),\n\n-- Split extras from the customer orders into individual topping_ids\norder_extras AS (\n    SELECT\n        o.row_id,\n        TRIM(x.VALUE::STRING)::INT AS topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(o.\"extras\", ',') AS x\n    WHERE o.\"extras\" IS NOT NULL AND o.\"extras\" != ''\n),\n\n-- For each order, get the base recipe toppings\norder_base_toppings AS (\n    SELECT\n        o.row_id,\n        o.\"order_id\",\n        o.\"customer_id\",\n        o.\"pizza_id\",\n        rt.topping_id\n    FROM numbered_orders o\n    JOIN recipe_toppings rt ON o.\"pizza_id\" = rt.\"pizza_id\"\n),\n\n-- Remove exclusions from base toppings\nafter_exclusions AS (\n    SELECT\n        bt.row_id,\n        bt.\"order_id\",\n        bt.\"customer_id\",\n        bt.\"pizza_id\",\n        bt.topping_id\n    FROM order_base_toppings bt\n    WHERE NOT EXISTS (\n        SELECT 1 FROM order_exclusions ex\n        WHERE ex.row_id = bt.row_id AND ex.topping_id = bt.topping_id\n    )\n),\n\n-- Combine: base toppings (after exclusions) + extras\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", topping_id\n    FROM after_exclusions\n    UNION ALL\n    SELECT oe.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", oe.topping_id\n    FROM order_extras oe\n    JOIN numbered_orders o ON oe.row_id = o.row_id\n),\n\n-- Count toppings per order row\ntopping_counts AS (\n    SELECT\n        at2.row_id,\n        at2.\"order_id\",\n        at2.\"customer_id\",\n        at2.\"pizza_id\",\n        at2.topping_id,\n        pt.\"topping_name\",\n        COUNT(*) AS cnt\n    FROM all_toppings at2\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" pt\n        ON at2.topping_id = pt.\"topping_id\"\n    GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.topping_id, pt.\"topping_name\"\n),\n\n-- Format topping names with 2x prefix if needed, and sort: 2x first (alphabetically), then 1x (alphabetically)\nformatted_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        CASE WHEN cnt > 1 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name,\n        CASE WHEN cnt > 1 THEN 0 ELSE 1 END AS sort_group,\n        \"topping_name\"\n    FROM topping_counts\n),\n\n-- Aggregate toppings into comma-separated string per order row\nagg_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        LISTAGG(formatted_name, ', ') WITHIN GROUP (ORDER BY sort_group, \"topping_name\") AS ingredients_list\n    FROM formatted_toppings\n    GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\"\n)\n\nSELECT\n    at3.row_id AS \"ROW_ID\",\n    at3.\"order_id\" AS \"ORDER_ID\",\n    at3.\"customer_id\" AS \"CUSTOMER_ID\",\n    pn.\"pizza_name\" AS \"PIZZA_NAME\",\n    pn.\"pizza_name\" || ': ' || at3.ingredients_list AS \"FINAL_INGREDIENTS\"\nFROM agg_toppings at3\nJOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" pn ON at3.\"pizza_id\" = pn.\"pizza_id\"\nORDER BY at3.row_id;") t := by
  intro t; first | sql_equiv | sorry

