theorem eq_0_3 : ∀ t,
    (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (\n    SELECT \n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"order_time\") AS row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\",\n        \"order_time\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\norders_with_names AS (\n    SELECT \n        o.row_id,\n        o.\"order_id\",\n        o.\"customer_id\",\n        CASE WHEN pn.\"pizza_name\" = 'Meatlovers' THEN 1 ELSE 2 END AS pizza_id,\n        pn.\"pizza_name\",\n        o.\"exclusions\",\n        o.\"extras\",\n        o.\"order_time\"\n    FROM numbered_orders o\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" pn ON o.\"pizza_id\" = pn.\"pizza_id\"\n),\n-- Split recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT \n        r.\"pizza_id\",\n        TRIM(rt.VALUE)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r,\n    LATERAL FLATTEN(INPUT => SPLIT(r.\"toppings\", ',')) rt\n),\n-- For each order row, get standard toppings\norder_standard_toppings AS (\n    SELECT \n        o.row_id,\n        o.\"order_id\",\n        o.\"customer_id\",\n        o.pizza_id,\n        o.\"pizza_name\",\n        o.\"order_time\",\n        o.\"exclusions\",\n        o.\"extras\",\n        rt.topping_id,\n        'standard' AS source\n    FROM orders_with_names o\n    JOIN recipe_toppings rt ON o.pizza_id = rt.\"pizza_id\"\n),\n-- Split exclusions for each order row\norder_exclusions AS (\n    SELECT \n        o.row_id,\n        TRIM(ex.VALUE)::INT AS excluded_topping_id\n    FROM orders_with_names o,\n    LATERAL FLATTEN(INPUT => SPLIT(o.\"exclusions\", ','), OUTER => TRUE) ex\n    WHERE o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != ''\n),\n-- Split extras for each order row\norder_extras AS (\n    SELECT \n        o.row_id,\n        TRIM(ext.VALUE)::INT AS extra_topping_id\n    FROM orders_with_names o,\n    LATERAL FLATTEN(INPUT => SPLIT(o.\"extras\", ','), OUTER => TRUE) ext\n    WHERE o.\"extras\" IS NOT NULL AND o.\"extras\" != ''\n),\n-- Remove excluded toppings from standard\nstandard_minus_exclusions AS (\n    SELECT \n        st.row_id,\n        st.\"order_id\",\n        st.\"customer_id\",\n        st.pizza_id,\n        st.\"pizza_name\",\n        st.\"order_time\",\n        st.topping_id,\n        st.source\n    FROM order_standard_toppings st\n    LEFT JOIN order_exclusions ex \n        ON st.row_id = ex.row_id AND st.topping_id = ex.excluded_topping_id\n    WHERE ex.excluded_topping_id IS NULL\n),\n-- Add extras as separate rows\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", pizza_id, \"pizza_name\", \"order_time\", topping_id, source\n    FROM standard_minus_exclusions\n    UNION ALL\n    SELECT \n        o.row_id, \n        o.\"order_id\", \n        o.\"customer_id\", \n        o.pizza_id, \n        o.\"pizza_name\", \n        o.\"order_time\",\n        ext.extra_topping_id AS topping_id,\n        'extra' AS source\n    FROM orders_with_names o\n    JOIN order_extras ext ON o.row_id = ext.row_id\n),\n-- Count each topping per order row\ntopping_counts AS (\n    SELECT \n        at.row_id,\n        at.\"order_id\",\n        at.\"customer_id\",\n        at.pizza_id,\n        at.\"pizza_name\",\n        at.\"order_time\",\n        at.topping_id,\n        t.\"topping_name\",\n        COUNT(*) AS cnt\n    FROM all_toppings at\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t ON at.topping_id = t.\"topping_id\"\n    GROUP BY at.row_id, at.\"order_id\", at.\"customer_id\", at.pizza_id, at.\"pizza_name\", at.\"order_time\", at.topping_id, t.\"topping_name\"\n),\n-- Format topping names with 2x prefix where needed\nformatted_toppings AS (\n    SELECT \n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        pizza_id,\n        \"pizza_name\",\n        \"order_time\",\n        topping_id,\n        \"topping_name\",\n        cnt,\n        CASE WHEN cnt >= 2 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name,\n        CASE WHEN cnt >= 2 THEN 0 ELSE 1 END AS sort_group\n    FROM topping_counts\n),\n-- Aggregate into ingredient string: 2x items first (alphabetical), then single items (alphabetical)\ningredient_strings AS (\n    SELECT \n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_name\",\n        \"order_time\",\n        \"pizza_name\" || ': ' || LISTAGG(formatted_name, ', ') WITHIN GROUP (ORDER BY sort_group, \"topping_name\") AS ingredients\n    FROM formatted_toppings\n    GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_name\", \"order_time\"\n)\nSELECT \n    row_id,\n    \"order_id\",\n    \"customer_id\",\n    \"pizza_name\",\n    ingredients\nFROM ingredient_strings\nORDER BY row_id") t ~= (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (\n    SELECT\n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\") AS row_id,\n        ROW_NUMBER() OVER (PARTITION BY \"order_id\" ORDER BY \"customer_id\", \"pizza_id\") AS order_row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\n\n-- Split recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT\n        \"pizza_id\",\n        TRIM(t.VALUE::STRING)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\",\n        LATERAL SPLIT_TO_TABLE(\"toppings\", ',') AS t\n),\n\n-- Split exclusions from the customer orders into individual topping_ids\norder_exclusions AS (\n    SELECT\n        o.row_id,\n        TRIM(e.VALUE::STRING)::INT AS topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(o.\"exclusions\", ',') AS e\n    WHERE o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != ''\n),\n\n-- Split extras from the customer orders into individual topping_ids\norder_extras AS (\n    SELECT\n        o.row_id,\n        TRIM(x.VALUE::STRING)::INT AS topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(o.\"extras\", ',') AS x\n    WHERE o.\"extras\" IS NOT NULL AND o.\"extras\" != ''\n),\n\n-- For each order, get the base recipe toppings\norder_base_toppings AS (\n    SELECT\n        o.row_id,\n        o.\"order_id\",\n        o.\"customer_id\",\n        o.\"pizza_id\",\n        rt.topping_id\n    FROM numbered_orders o\n    JOIN recipe_toppings rt ON o.\"pizza_id\" = rt.\"pizza_id\"\n),\n\n-- Remove exclusions from base toppings\nafter_exclusions AS (\n    SELECT\n        bt.row_id,\n        bt.\"order_id\",\n        bt.\"customer_id\",\n        bt.\"pizza_id\",\n        bt.topping_id\n    FROM order_base_toppings bt\n    WHERE NOT EXISTS (\n        SELECT 1 FROM order_exclusions ex\n        WHERE ex.row_id = bt.row_id AND ex.topping_id = bt.topping_id\n    )\n),\n\n-- Combine: base toppings (after exclusions) + extras\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", topping_id\n    FROM after_exclusions\n    UNION ALL\n    SELECT oe.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", oe.topping_id\n    FROM order_extras oe\n    JOIN numbered_orders o ON oe.row_id = o.row_id\n),\n\n-- Count toppings per order row\ntopping_counts AS (\n    SELECT\n        at2.row_id,\n        at2.\"order_id\",\n        at2.\"customer_id\",\n        at2.\"pizza_id\",\n        at2.topping_id,\n        pt.\"topping_name\",\n        COUNT(*) AS cnt\n    FROM all_toppings at2\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" pt\n        ON at2.topping_id = pt.\"topping_id\"\n    GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.topping_id, pt.\"topping_name\"\n),\n\n-- Format topping names with 2x prefix if needed, and sort: 2x first (alphabetically), then 1x (alphabetically)\nformatted_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        CASE WHEN cnt > 1 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name,\n        CASE WHEN cnt > 1 THEN 0 ELSE 1 END AS sort_group,\n        \"topping_name\"\n    FROM topping_counts\n),\n\n-- Aggregate toppings into comma-separated string per order row\nagg_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        LISTAGG(formatted_name, ', ') WITHIN GROUP (ORDER BY sort_group, \"topping_name\") AS ingredients_list\n    FROM formatted_toppings\n    GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\"\n)\n\nSELECT\n    at3.row_id AS \"ROW_ID\",\n    at3.\"order_id\" AS \"ORDER_ID\",\n    at3.\"customer_id\" AS \"CUSTOMER_ID\",\n    pn.\"pizza_name\" AS \"PIZZA_NAME\",\n    pn.\"pizza_name\" || ': ' || at3.ingredients_list AS \"FINAL_INGREDIENTS\"\nFROM agg_toppings at3\nJOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" pn ON at3.\"pizza_id\" = pn.\"pizza_id\"\nORDER BY at3.row_id;") t := by
