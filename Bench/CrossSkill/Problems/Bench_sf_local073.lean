theorem eq_2_3 : ∀ t,
    (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (\n    SELECT\n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\",\n        \"order_time\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\n-- Flatten the recipe toppings for each pizza\nrecipe_flat AS (\n    SELECT\n        \"pizza_id\",\n        TRIM(t.VALUE::STRING) AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\",\n        LATERAL SPLIT_TO_TABLE(\"toppings\", ',') t\n),\n-- For each order row, get base toppings from recipe\norder_base_toppings AS (\n    SELECT\n        o.row_id,\n        o.\"order_id\",\n        o.\"customer_id\",\n        o.\"pizza_id\",\n        o.\"exclusions\",\n        o.\"extras\",\n        o.\"order_time\",\n        r.topping_id::NUMBER AS topping_id\n    FROM numbered_orders o\n    JOIN recipe_flat r ON o.\"pizza_id\" = r.\"pizza_id\"\n),\n-- Parse exclusions per order row\nexclusions_flat AS (\n    SELECT\n        o.row_id,\n        TRIM(e.VALUE::STRING)::NUMBER AS excluded_topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(\n            CASE WHEN o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != '' THEN o.\"exclusions\" ELSE NULL END,\n            ','\n        ) e\n    WHERE o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != ''\n),\n-- Parse extras per order row\nextras_flat AS (\n    SELECT\n        o.row_id,\n        TRIM(x.VALUE::STRING)::NUMBER AS extra_topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(\n            CASE WHEN o.\"extras\" IS NOT NULL AND o.\"extras\" != '' THEN o.\"extras\" ELSE NULL END,\n            ','\n        ) x\n    WHERE o.\"extras\" IS NOT NULL AND o.\"extras\" != ''\n),\n-- Remove excluded toppings from base\nbase_after_exclusions AS (\n    SELECT\n        bt.row_id,\n        bt.\"order_id\",\n        bt.\"customer_id\",\n        bt.\"pizza_id\",\n        bt.\"order_time\",\n        bt.topping_id\n    FROM order_base_toppings bt\n    LEFT JOIN exclusions_flat ef\n        ON bt.row_id = ef.row_id AND bt.topping_id = ef.excluded_topping_id\n    WHERE ef.excluded_topping_id IS NULL\n),\n-- Combine base toppings (after exclusions) and extras\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", topping_id, 'base' AS source\n    FROM base_after_exclusions\n    UNION ALL\n    SELECT ef.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", o.\"order_time\", ef.extra_topping_id AS topping_id, 'extra' AS source\n    FROM extras_flat ef\n    JOIN numbered_orders o ON ef.row_id = o.row_id\n),\n-- Count occurrences per topping per order row\ntopping_counts AS (\n    SELECT\n        at2.row_id,\n        at2.\"order_id\",\n        at2.\"customer_id\",\n        at2.\"pizza_id\",\n        at2.\"order_time\",\n        at2.topping_id,\n        t.\"topping_name\",\n        COUNT(*) AS cnt\n    FROM all_toppings at2\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t ON at2.topping_id = t.\"topping_id\"\n    GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"order_time\", at2.topping_id, t.\"topping_name\"\n),\n-- Format each topping with 2x prefix if needed, and add sort keys\nformatted_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"order_time\",\n        CASE WHEN cnt > 1 THEN cnt || 'x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name,\n        cnt,\n        \"topping_name\"\n    FROM topping_counts\n),\n-- Order toppings: 2x first (alphabetically), then single (alphabetically)\nordered_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"order_time\",\n        formatted_name,\n        ROW_NUMBER() OVER (\n            PARTITION BY row_id\n            ORDER BY\n                CASE WHEN cnt > 1 THEN 0 ELSE 1 END,\n                \"topping_name\"\n        ) AS rn\n    FROM formatted_toppings\n),\n-- Aggregate into comma-separated string\naggregated AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"order_time\",\n        LISTAGG(formatted_name, ', ') WITHIN GROUP (ORDER BY\n            CASE WHEN rn = rn THEN 0 END, rn\n        ) AS ingredients_list\n    FROM ordered_toppings\n    GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\"\n)\nSELECT\n    a.row_id AS \"ROW_ID\",\n    a.\"order_id\" AS \"ORDER_ID\",\n    a.\"customer_id\" AS \"CUSTOMER_ID\",\n    CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END AS \"PIZZA_NAME\",\n    CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END || ': ' || a.ingredients_list AS \"FINAL_INGREDIENTS\"\nFROM aggregated a\nORDER BY a.row_id;") t ~= (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (\n    SELECT\n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\") AS row_id,\n        ROW_NUMBER() OVER (PARTITION BY \"order_id\" ORDER BY \"customer_id\", \"pizza_id\") AS order_row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\n\n-- Split recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT\n        \"pizza_id\",\n        TRIM(t.VALUE::STRING)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\",\n        LATERAL SPLIT_TO_TABLE(\"toppings\", ',') AS t\n),\n\n-- Split exclusions from the customer orders into individual topping_ids\norder_exclusions AS (\n    SELECT\n        o.row_id,\n        TRIM(e.VALUE::STRING)::INT AS topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(o.\"exclusions\", ',') AS e\n    WHERE o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != ''\n),\n\n-- Split extras from the customer orders into individual topping_ids\norder_extras AS (\n    SELECT\n        o.row_id,\n        TRIM(x.VALUE::STRING)::INT AS topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(o.\"extras\", ',') AS x\n    WHERE o.\"extras\" IS NOT NULL AND o.\"extras\" != ''\n),\n\n-- For each order, get the base recipe toppings\norder_base_toppings AS (\n    SELECT\n        o.row_id,\n        o.\"order_id\",\n        o.\"customer_id\",\n        o.\"pizza_id\",\n        rt.topping_id\n    FROM numbered_orders o\n    JOIN recipe_toppings rt ON o.\"pizza_id\" = rt.\"pizza_id\"\n),\n\n-- Remove exclusions from base toppings\nafter_exclusions AS (\n    SELECT\n        bt.row_id,\n        bt.\"order_id\",\n        bt.\"customer_id\",\n        bt.\"pizza_id\",\n        bt.topping_id\n    FROM order_base_toppings bt\n    WHERE NOT EXISTS (\n        SELECT 1 FROM order_exclusions ex\n        WHERE ex.row_id = bt.row_id AND ex.topping_id = bt.topping_id\n    )\n),\n\n-- Combine: base toppings (after exclusions) + extras\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", topping_id\n    FROM after_exclusions\n    UNION ALL\n    SELECT oe.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", oe.topping_id\n    FROM order_extras oe\n    JOIN numbered_orders o ON oe.row_id = o.row_id\n),\n\n-- Count toppings per order row\ntopping_counts AS (\n    SELECT\n        at2.row_id,\n        at2.\"order_id\",\n        at2.\"customer_id\",\n        at2.\"pizza_id\",\n        at2.topping_id,\n        pt.\"topping_name\",\n        COUNT(*) AS cnt\n    FROM all_toppings at2\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" pt\n        ON at2.topping_id = pt.\"topping_id\"\n    GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.topping_id, pt.\"topping_name\"\n),\n\n-- Format topping names with 2x prefix if needed, and sort: 2x first (alphabetically), then 1x (alphabetically)\nformatted_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        CASE WHEN cnt > 1 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name,\n        CASE WHEN cnt > 1 THEN 0 ELSE 1 END AS sort_group,\n        \"topping_name\"\n    FROM topping_counts\n),\n\n-- Aggregate toppings into comma-separated string per order row\nagg_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        LISTAGG(formatted_name, ', ') WITHIN GROUP (ORDER BY sort_group, \"topping_name\") AS ingredients_list\n    FROM formatted_toppings\n    GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\"\n)\n\nSELECT\n    at3.row_id AS \"ROW_ID\",\n    at3.\"order_id\" AS \"ORDER_ID\",\n    at3.\"customer_id\" AS \"CUSTOMER_ID\",\n    pn.\"pizza_name\" AS \"PIZZA_NAME\",\n    pn.\"pizza_name\" || ': ' || at3.ingredients_list AS \"FINAL_INGREDIENTS\"\nFROM agg_toppings at3\nJOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" pn ON at3.\"pizza_id\" = pn.\"pizza_id\"\nORDER BY at3.row_id;") t := by
