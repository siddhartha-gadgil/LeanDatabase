    sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH customer_orders AS (\n    SELECT \n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\",\n        \"order_time\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\n-- Split recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT \n        r.\"pizza_id\",\n        TRIM(t.VALUE::STRING)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r,\n        LATERAL FLATTEN(INPUT => SPLIT(r.\"toppings\", ',')) t\n),\n-- For each order row, get base toppings from recipe\norder_base_toppings AS (\n    SELECT \n        co.row_id,\n        co.\"order_id\",\n        co.\"customer_id\",\n        co.\"pizza_id\",\n        co.\"exclusions\",\n        co.\"extras\",\n        co.\"order_time\",\n        rt.topping_id,\n        1 AS topping_count\n    FROM customer_orders co\n    JOIN recipe_toppings rt ON co.\"pizza_id\" = rt.\"pizza_id\"\n),\n-- Parse exclusions per order row\norder_exclusions AS (\n    SELECT \n        co.row_id,\n        TRIM(e.VALUE::STRING)::INT AS excluded_topping_id\n    FROM customer_orders co,\n        LATERAL FLATTEN(INPUT => SPLIT(co.\"exclusions\", ','), OUTER => TRUE) e\n    WHERE co.\"exclusions\" IS NOT NULL AND co.\"exclusions\" != ''\n),\n-- Parse extras per order row\norder_extras AS (\n    SELECT \n        co.row_id,\n        TRIM(x.VALUE::STRING)::INT AS extra_topping_id\n    FROM customer_orders co,\n        LATERAL FLATTEN(INPUT => SPLIT(co.\"extras\", ','), OUTER => TRUE) x\n    WHERE co.\"extras\" IS NOT NULL AND co.\"extras\" != ''\n),\n-- Remove exclusions from base toppings\nbase_minus_exclusions AS (\n    SELECT \n        obt.row_id,\n        obt.\"order_id\",\n        obt.\"customer_id\",\n        obt.\"pizza_id\",\n        obt.\"exclusions\",\n        obt.\"extras\",\n        obt.\"order_time\",\n        obt.topping_id,\n        obt.topping_count\n    FROM order_base_toppings obt\n    LEFT JOIN order_exclusions oe ON obt.row_id = oe.row_id AND obt.topping_id = oe.excluded_topping_id\n    WHERE oe.excluded_topping_id IS NULL\n),\n-- Combine base toppings (minus exclusions) with extras\n-- Extras that are already in base get counted as additional\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\", topping_id, topping_count\n    FROM base_minus_exclusions\n    UNION ALL\n    SELECT \n        ox.row_id,\n        co.\"order_id\",\n        co.\"customer_id\",\n        co.\"pizza_id\",\n        co.\"exclusions\",\n        co.\"extras\",\n        co.\"order_time\",\n        ox.extra_topping_id AS topping_id,\n        1 AS topping_count\n    FROM order_extras ox\n    JOIN customer_orders co ON ox.row_id = co.row_id\n),\n-- Aggregate topping counts per order row\ntopping_counts AS (\n    SELECT \n        at2.row_id,\n        at2.\"order_id\",\n        at2.\"customer_id\",\n        at2.\"pizza_id\",\n        at2.\"exclusions\",\n        at2.\"extras\",\n        at2.\"order_time\",\n        at2.topping_id,\n        SUM(at2.topping_count) AS total_count\n    FROM all_toppings at2\n    GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", \n             at2.\"exclusions\", at2.\"extras\", at2.\"order_time\", at2.topping_id\n),\n-- Join with topping names and format\nformatted_toppings AS (\n    SELECT \n        tc.row_id,\n        tc.\"order_id\",\n        tc.\"customer_id\",\n        tc.\"pizza_id\",\n        tc.\"exclusions\",\n        tc.\"extras\",\n        tc.\"order_time\",\n        tc.topping_id,\n        tc.total_count,\n        pt.\"topping_name\",\n        CASE WHEN tc.total_count > 1 THEN '2x ' || pt.\"topping_name\" ELSE pt.\"topping_name\" END AS formatted_topping,\n        CASE WHEN tc.total_count > 1 THEN 0 ELSE 1 END AS sort_group\n    FROM topping_counts tc\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" pt ON tc.topping_id = pt.\"topping_id\"\n),\n-- Build sorted ingredient list using LISTAGG\ningredient_list AS (\n    SELECT \n        ft.row_id,\n        ft.\"order_id\",\n        ft.\"customer_id\",\n        pn.\"pizza_name\" AS PIZZA_NAME,\n        LISTAGG(ft.formatted_topping, ', ') WITHIN GROUP (ORDER BY ft.sort_group, ft.\"topping_name\") AS ingredients\n    FROM formatted_toppings ft\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" pn ON ft.\"pizza_id\" = pn.\"pizza_id\"\n    GROUP BY ft.row_id, ft.\"order_id\", ft.\"customer_id\", ft.\"pizza_id\", pn.\"pizza_name\", ft.\"order_time\"\n)\nSELECT \n    il.row_id AS ROW_ID,\n    il.\"order_id\" AS ORDER_ID,\n    il.\"customer_id\" AS CUSTOMER_ID,\n    il.PIZZA_NAME,\n    il.PIZZA_NAME || ': ' || il.ingredients AS FINAL_INGREDIENTS\nFROM ingredient_list il\nORDER BY il.row_id;" = sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (\n    SELECT\n        ROW_NUMBER() OVER (ORDER BY \"order_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"exclusions\",\n        \"extras\",\n        \"order_time\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"\n),\n-- Flatten the recipe toppings for each pizza\nrecipe_flat AS (\n    SELECT\n        \"pizza_id\",\n        TRIM(t.VALUE::STRING) AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\",\n        LATERAL SPLIT_TO_TABLE(\"toppings\", ',') t\n),\n-- For each order row, get base toppings from recipe\norder_base_toppings AS (\n    SELECT\n        o.row_id,\n        o.\"order_id\",\n        o.\"customer_id\",\n        o.\"pizza_id\",\n        o.\"exclusions\",\n        o.\"extras\",\n        o.\"order_time\",\n        r.topping_id::NUMBER AS topping_id\n    FROM numbered_orders o\n    JOIN recipe_flat r ON o.\"pizza_id\" = r.\"pizza_id\"\n),\n-- Parse exclusions per order row\nexclusions_flat AS (\n    SELECT\n        o.row_id,\n        TRIM(e.VALUE::STRING)::NUMBER AS excluded_topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(\n            CASE WHEN o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != '' THEN o.\"exclusions\" ELSE NULL END,\n            ','\n        ) e\n    WHERE o.\"exclusions\" IS NOT NULL AND o.\"exclusions\" != ''\n),\n-- Parse extras per order row\nextras_flat AS (\n    SELECT\n        o.row_id,\n        TRIM(x.VALUE::STRING)::NUMBER AS extra_topping_id\n    FROM numbered_orders o,\n        LATERAL SPLIT_TO_TABLE(\n            CASE WHEN o.\"extras\" IS NOT NULL AND o.\"extras\" != '' THEN o.\"extras\" ELSE NULL END,\n            ','\n        ) x\n    WHERE o.\"extras\" IS NOT NULL AND o.\"extras\" != ''\n),\n-- Remove excluded toppings from base\nbase_after_exclusions AS (\n    SELECT\n        bt.row_id,\n        bt.\"order_id\",\n        bt.\"customer_id\",\n        bt.\"pizza_id\",\n        bt.\"order_time\",\n        bt.topping_id\n    FROM order_base_toppings bt\n    LEFT JOIN exclusions_flat ef\n        ON bt.row_id = ef.row_id AND bt.topping_id = ef.excluded_topping_id\n    WHERE ef.excluded_topping_id IS NULL\n),\n-- Combine base toppings (after exclusions) and extras\nall_toppings AS (\n    SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", topping_id, 'base' AS source\n    FROM base_after_exclusions\n    UNION ALL\n    SELECT ef.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", o.\"order_time\", ef.extra_topping_id AS topping_id, 'extra' AS source\n    FROM extras_flat ef\n    JOIN numbered_orders o ON ef.row_id = o.row_id\n),\n-- Count occurrences per topping per order row\ntopping_counts AS (\n    SELECT\n        at2.row_id,\n        at2.\"order_id\",\n        at2.\"customer_id\",\n        at2.\"pizza_id\",\n        at2.\"order_time\",\n        at2.topping_id,\n        t.\"topping_name\",\n        COUNT(*) AS cnt\n    FROM all_toppings at2\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t ON at2.topping_id = t.\"topping_id\"\n    GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"order_time\", at2.topping_id, t.\"topping_name\"\n),\n-- Format each topping with 2x prefix if needed, and add sort keys\nformatted_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"order_time\",\n        CASE WHEN cnt > 1 THEN cnt || 'x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name,\n        cnt,\n        \"topping_name\"\n    FROM topping_counts\n),\n-- Order toppings: 2x first (alphabetically), then single (alphabetically)\nordered_toppings AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"order_time\",\n        formatted_name,\n        ROW_NUMBER() OVER (\n            PARTITION BY row_id\n            ORDER BY\n                CASE WHEN cnt > 1 THEN 0 ELSE 1 END,\n                \"topping_name\"\n        ) AS rn\n    FROM formatted_toppings\n),\n-- Aggregate into comma-separated string\naggregated AS (\n    SELECT\n        row_id,\n        \"order_id\",\n        \"customer_id\",\n        \"pizza_id\",\n        \"order_time\",\n        LISTAGG(formatted_name, ', ') WITHIN GROUP (ORDER BY\n            CASE WHEN rn = rn THEN 0 END, rn\n        ) AS ingredients_list\n    FROM ordered_toppings\n    GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\"\n)\nSELECT\n    a.row_id AS \"ROW_ID\",\n    a.\"order_id\" AS \"ORDER_ID\",\n    a.\"customer_id\" AS \"CUSTOMER_ID\",\n    CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END AS \"PIZZA_NAME\",\n    CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END || ': ' || a.ingredients_list AS \"FINAL_INGREDIENTS\"\nFROM aggregated a\nORDER BY a.row_id;" := by
