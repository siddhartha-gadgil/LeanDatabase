theorem eq (t0 : TableRel IMAGING_LEVEL2_METADATA_R5_schema) (t1 : TableRel ID_PROVENANCE_R5_schema) :
    (sql%([IMAGING_LEVEL2_METADATA_R5_schema, ID_PROVENANCE_R5_schema]) "WITH level2_data AS (/* Get WUSTL ImagingLevel2 records with their assay types */ SELECT DISTINCT m.\"Imaging_Assay_Type\", p.\"HTAN_CENTER\", p.\"HTAN_DATA_FILE_ID\", p.\"ENTITYID\", 'Level2' AS data_level FROM \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS p INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"IMAGING_LEVEL2_METADATA_R5\" AS m ON p.\"ENTITYID\" = m.\"entityId\" WHERE p.\"HTAN_CENTER\" = 'HTAN WUSTL' AND NOT p.\"COMPONENT\" IS NULL AND NOT p.\"COMPONENT\" LIKE '%Auxiliary%' AND NOT p.\"COMPONENT\" LIKE '%OtherAssay%' AND NOT p.\"COMPONENT\" LIKE '%Level1%' AND NOT p.\"COMPONENT\" LIKE '%ElectronMicroscopy%' AND p.\"COMPONENT\" LIKE '%Imaging%'), level3_data AS (/* Find Level3 records derived from Level2 through provenance */ SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_CENTER\", 'Level3' AS data_level FROM level2_data AS l2 INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS child ON child.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" WHERE NOT child.\"COMPONENT\" IS NULL AND NOT child.\"COMPONENT\" LIKE '%Auxiliary%' AND NOT child.\"COMPONENT\" LIKE '%OtherAssay%' AND child.\"COMPONENT\" LIKE '%Level3%'), level4_data AS (/* Find Level4 records derived from Level3 or Level2 through provenance */ SELECT DISTINCT l2.\"Imaging_Assay_Type\", l2.\"HTAN_CENTER\", 'Level4' AS data_level FROM level2_data AS l2 INNER JOIN \"HTAN_1\".\"HTAN_VERSIONED\".\"ID_PROVENANCE_R5\" AS child ON child.\"HTAN_PARENT_DATA_FILE_ID\" = l2.\"HTAN_DATA_FILE_ID\" WHERE NOT child.\"COMPONENT\" IS NULL AND NOT child.\"COMPONENT\" LIKE '%Auxiliary%' AND NOT child.\"COMPONENT\" LIKE '%OtherAssay%' AND child.\"COMPONENT\" LIKE '%Level4%'), all_levels AS (SELECT \"Imaging_Assay_Type\", \"HTAN_CENTER\", data_level FROM level2_data UNION SELECT \"Imaging_Assay_Type\", \"HTAN_CENTER\", data_level FROM level3_data UNION SELECT \"Imaging_Assay_Type\", \"HTAN_CENTER\", data_level FROM level4_data) SELECT \"Imaging_Assay_Type\", \"HTAN_CENTER\" AS \"HTAN_Center\", STRING_AGG(DISTINCT data_level, ', ' ORDER BY data_level) AS \"AVAILABLE_DATA_LEVELS\" FROM all_levels GROUP BY \"Imaging_Assay_Type\", \"HTAN_CENTER\" ORDER BY \"Imaging_Assay_Type\"") t0 t1
