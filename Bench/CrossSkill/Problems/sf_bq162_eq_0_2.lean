y_Type\" <> 'Electron Microscopy'), all_levels AS (SELECT * FROM imaging_level2 UNION SELECT * FROM imaging_level3 UNION SELECT * FROM imaging_level4) SELECT \"Imaging_Assay_Type\", \"HTAN_Center\" AS \"HTAN_Center\", STRING_AGG(DISTINCT data_level, ', ' ORDER BY data_level) AS \"AVAILABLE_DATA_LEVELS\" FROM all_levels GROUP BY \"Imaging_Assay_Type\", \"HTAN_Center\" ORDER BY \"Imaging_Assay_Type\"") t0 t1
