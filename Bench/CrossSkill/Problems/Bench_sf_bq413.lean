import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq413 — crossskill equivalence(s)

Question: Retrieve the venue titles of publications that have a `date_inserted` from the year 2021 onwards and are associated with a grid whose address city is 'Qianjiang'. For each publication, prioritize the venue title by selecting the journal title first if it exists; if not, then the proceedings title; if that's also unavailable, then the book title; and finally, if none of those are available, the book series title.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq413

CREATE TABLE GRID («id» STRING, «status» STRING, «redirect» STRING, «name» STRING, «established» INT, «closed» INT, «aliases» STRING, «acronyms» STRING, «types» STRING, «email_address» STRING, «links» STRING, «wikipedia_url» STRING, «labels» STRING, «relationships» STRING, «external_ids» STRING, «address» STRING)
CREATE TABLE PUBLICATIONS («id» STRING, «year» INT, «doi» STRING, «volume» STRING, «issue» STRING, «pages» STRING, «subtitles» STRING, «abstract» STRING, «acknowledgements» STRING, «funding_section» STRING, «copyright_statement» STRING, «publisher» STRING, «pmid» STRING, «pmcid» STRING, «type» STRING, «date» STRING, «date_online» STRING, «date_print» STRING, «open_access_categories» STRING, «open_access_categories_v2» STRING, «book_title» STRING, «book_series_title» STRING, «proceedings_title» STRING, «conference» STRING, «repository_dois» STRING, «arxiv_id» STRING, «resulting_publication_doi» STRING, «eisbn» STRING, «isbn» STRING, «editors» STRING, «reference_ids» STRING, «mesh_headings» STRING, «mesh_terms» STRING, «category_bra» STRING, «category_for» STRING, «category_hra» STRING, «category_hrcs_hc» STRING, «category_hrcs_rac» STRING, «category_icrp_cso» STRING, «category_icrp_ct» STRING, «category_rcdc» STRING, «category_sdg» STRING, «category_uoa» STRING, «categories» STRING, «clinical_trial_ids» STRING, «funding_details» STRING, «funder_orgs» STRING, «document_type» STRING, «title» STRING, «date_normal» STRING, «date_inserted» INT, «date_imported_gbq» INT, «patent_ids» STRING, «citations» STRING, «citations_count» INT, «journal» STRING, «journal_lists» STRING, «parent_id» STRING, «source_id» STRING, «researcher_ids» STRING, «research_orgs» STRING, «research_org_cities» STRING, «research_org_city_names» STRING, «research_org_countries» STRING, «research_org_country_names» STRING, «research_org_state_codes» STRING, «research_org_state_names» STRING, «supporting_grant_ids» STRING, «funder_countries» STRING, «metrics» STRING, «authors» STRING, «concepts» STRING, «altmetrics» STRING)

theorem eq_0_1 :
    sql%([GRID_schema, PUBLICATIONS_schema]) "SELECT\n  COALESCE(\n    p.\"journal\":\"title\"::STRING,\n    p.\"proceedings_title\":\"preferred\"::STRING,\n    p.\"book_title\":\"preferred\"::STRING,\n    p.\"book_series_title\":\"preferred\"::STRING\n  ) AS VENUE\nFROM \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"PUBLICATIONS\" p,\nLATERAL FLATTEN(input => p.\"research_orgs\") f\nINNER JOIN \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"GRID\" g\n  ON f.value::STRING = g.\"id\"\nWHERE g.\"address\":\"city\"::STRING = 'Qianjiang'\n  AND EXTRACT(YEAR FROM TO_TIMESTAMP(p.\"date_inserted\" / 1000000)) >= 2021;" = sql%([GRID_schema, PUBLICATIONS_schema]) "SELECT\n  COALESCE(\n    p.\"journal\":\"title\"::STRING,\n    p.\"proceedings_title\":\"preferred\"::STRING,\n    p.\"book_title\":\"preferred\"::STRING,\n    p.\"book_series_title\":\"preferred\"::STRING\n  ) AS VENUE\nFROM \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"PUBLICATIONS\" p,\nLATERAL FLATTEN(input => p.\"research_orgs\") ro\nJOIN \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"GRID\" g\n  ON ro.VALUE::STRING = g.\"id\"\nWHERE g.\"address\":\"city\"::STRING = 'Qianjiang'\n  AND EXTRACT(YEAR FROM TO_TIMESTAMP(p.\"date_inserted\" / 1000000)) >= 2021;" := by
  first | sql_equiv | sorry

