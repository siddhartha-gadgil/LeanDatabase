theorem eq_0_3 : ∀ t,
    (sql%([GRID_schema, PUBLICATIONS_schema]) "SELECT COALESCE(CAST(JSON_EXTRACT_PATH(p.\"journal\", 'title') AS TEXT), CAST(JSON_EXTRACT_PATH(p.\"proceedings_title\", 'preferred') AS TEXT), CAST(JSON_EXTRACT_PATH(p.\"book_title\", 'preferred') AS TEXT), CAST(JSON_EXTRACT_PATH(p.\"book_series_title\", 'preferred') AS TEXT)) AS VENUE FROM \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"PUBLICATIONS\" AS p, LATERAL UNNEST(input => p.\"research_orgs\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) INNER JOIN \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"GRID\" AS g ON CAST(f.value AS TEXT) = g.\"id\" WHERE CAST(JSON_EXTRACT_PATH(g.\"address\", 'city') AS TEXT) = 'Qianjiang' AND EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(p.\"date_inserted\" AS DOUBLE PRECISION) / 1000000)) >= 2021") t ~= (sql%([GRID_schema, PUBLICATIONS_schema]) "SELECT DISTINCT COALESCE(CAST(JSON_EXTRACT_PATH(p.\"journal\", 'title') AS TEXT), CAST(p.\"proceedings_title\" AS TEXT), CAST(p.\"book_title\" AS TEXT), CAST(p.\"book_series_title\" AS TEXT)) AS venue_title FROM \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"PUBLICATIONS\" AS p, LATERAL UNNEST(input => p.\"research_orgs\") AS ro(SEQ, KEY, PATH, INDEX, VALUE, THIS) JOIN \"DIMENSIONS_AI_COVID19\".\"DIMENSIONS_AI_COVID19\".\"GRID\" AS g ON CAST(ro.VALUE AS TEXT) = g.\"id\" WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(p.\"date_inserted\" AS DECIMAL(38, 0)) / POWER(10, 6))) >= 2021 AND CAST(JSON_EXTRACT_PATH(g.\"address\", 'city') AS TEXT) = 'Qianjiang' AND NOT COALESCE(CAST(JSON_EXTRACT_PATH(p.\"journal\", 'title') AS TEXT), CAST(p.\"proceedings_title\" AS TEXT), CAST(p.\"book_title\" AS TEXT), CAST(p.\"book_series_title\" AS TEXT)) IS NULL ORDER BY venue_title") t := by
  intro t; first | sql_equiv | sorry

