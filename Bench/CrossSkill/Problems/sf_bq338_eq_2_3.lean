theorem eq (t0 : TableRel CENSUSTRACT_2011_5YR_schema) (t1 : TableRel CENSUSTRACT_2018_5YR_schema) :
    (sql%([CENSUSTRACT_2011_5YR_schema, CENSUSTRACT_2018_5YR_schema]) "WITH pop_data AS (SELECT t11.\"geo_id\", t11.\"total_pop\" AS pop_2011, t18.\"total_pop\" AS pop_2018, t11.\"median_income\" AS income_2011, t18.\"median_income\" AS income_2018 FROM \"CENSUS_BUREAU_ACS_1\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2011_5YR\" AS t11 JOIN \"CENSUS_BUREAU_ACS_1\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2018_5YR\" AS t18 ON t11.\"geo_id\" = t18.\"geo_id\" WHERE t11.\"geo_id\" LIKE '36047%' AND t11.\"total_pop\" > 1000 AND t18.\"total_pop\" > 1000), top_pop_increase AS (SELECT \"geo_id\", CAST((pop_2018 - pop_2011) * 1.0 AS DOUBLE PRECISION) / pop_2011 AS pct_increase FROM pop_data WHERE pop_2011 > 0 ORDER BY pct_increase DESC LIMIT 20), top_income_increase AS (SELECT \"geo_id\" FROM pop_data ORDER BY (income_2018 - income_2011) DESC LIMIT 20) SELECT t.\"geo_id\" AS \"geo_id\" FROM top_pop_increase AS t INNER JOIN top_income_increase AS i ON t.\"geo_id\" = i.\"geo_id\" ORDER BY t.pct_increase DESC") t0 t1
  ~= (sql%([CENSUSTRACT_2011_5YR_schema, CENSUSTRACT_2018_5YR_schema]) "WITH base AS (SELECT t2018.\"geo_id\", t2011.\"total_pop\" AS pop_2011, t2018.\"total_pop\" AS pop_2018, t2011.\"median_income\" AS income_2011, t2018.\"median_income\" AS income_2018, CAST((t2018.\"total_pop\" - t2011.\"total_pop\") * 100.0 AS DOUBLE PRECISION) / t2011.\"total_pop\" AS pop_pct_increase, (t2018.\"median_income\" - t2011.\"median_income\") AS income_abs_increase FROM \"CENSUS_BUREAU_ACS_1\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2018_5YR\" AS t2018 JOIN \"CENSUS_BUREAU_ACS_1\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2011_5YR\" AS t2011 ON t2018.\"geo_id\" = t2011.\"geo_id\" WHERE t2018.\"geo_id\" LIKE '36047%' AND t2011.\"total_pop\" > 1000 AND t2018.\"total_pop\" > 1000), top_pop AS (SELECT \"geo_id\" FROM base ORDER BY pop_pct_increase DESC LIMIT 20), top_income AS (SELECT \"geo_id\" FROM base ORDER BY income_abs_increase DESC LIMIT 20) SELECT tp.\"geo_id\" FROM top_pop AS tp JOIN top_income AS ti ON tp.\"geo_id\" = ti.\"geo_id\" ORDER BY tp.\"geo_id\"") t0 t1
