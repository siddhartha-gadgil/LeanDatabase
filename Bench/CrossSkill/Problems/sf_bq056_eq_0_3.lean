namespace N_sf_bq056_eq_0_3

CREATE TABLE PLANET_WAYS («id» INT, «version» INT, «username» STRING, «changeset» INT, «visible» BOOL, «osm_timestamp» INT, «geometry» STRING, «all_tags» STRING, «nodes» STRING)
CREATE TABLE STATES («geo_id» STRING, «region_code» STRING, «division_code» STRING, «state_fips_code» STRING, «state_gnis_code» STRING, «state» STRING, «state_name» STRING, «lsad_code» STRING, «mtfcc_feature_class_code» STRING, «functional_status» STRING, «area_land_meters» INT, «area_water_meters» INT, «int_point_lat» FLOAT, «int_point_lon» FLOAT, «int_point_geom» STRING, «state_geom» STRING)

theorem eq (t0 : TableRel PLANET_WAYS_schema) (t1 : TableRel STATES_schema) :
    (sql%([PLANET_WAYS_schema, STATES_schema]) "WITH bridge_ways AS (SELECT DISTINCT w.\"id\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(t.value, 'key') AS TEXT) = 'bridge'), california_highways AS (SELECT DISTINCT w.\"id\", w.\"geometry\", w.\"nodes\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\" AS s, LATERAL UNNEST(input => w.\"all_tags\") AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE s.\"state_name\" = 'California' AND CAST(JSON_EXTRACT_PATH(t.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(t.value, 'value') AS TEXT) IN ('motorway', 'trunk', 'primary', 'secondary', 'residential') AND ST_INTERSECTS(CAST(w.\"geometry\" AS GEOGRAPHY), CAST(s.\"state_geom\" AS GEOGRAPHY)) AND w.\"id\" <> ALL (SELECT \"id\" FROM bridge_ways)) SELECT COUNT(*) AS NUM_OVERLAPPING_WAYS FROM california_highways AS w1 JOIN california_highways AS w2 ON w1.\"id\" < w2.\"id\" AND ST_INTERSECTS(CAST(w1.\"geometry\" AS GEOGRAPHY), CAST(w2.\"geometry\" AS GEOGRAPHY)) AND NOT w1.\"nodes\" && w2.\"nodes\"") t0 t1
  ~= (sql%([PLANET_WAYS_schema, STATES_schema]) "WITH california AS (SELECT CAST(\"state_geom\" AS GEOGRAPHY) AS geom FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\" WHERE \"state_name\" = 'California'), highway_tagged /* Get ways with highway tags of interest */ AS (SELECT DISTINCT w.\"id\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => CAST(w.\"all_tags\" AS JSON)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(f.value, 'value') AS TEXT) IN ('motorway', 'trunk', 'primary', 'secondary', 'residential')), bridge_tagged /* Get ways with bridge tag */ AS (SELECT DISTINCT w.\"id\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => CAST(w.\"all_tags\" AS JSON)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(f.value, 'key') AS TEXT) = 'bridge'), highway_ways /* Filter: highway ways without bridge tag, in California */ AS (SELECT w.\"id\", w.\"geometry\" AS geom_bin, w.\"nodes\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w JOIN california AS c ON ST_INTERSECTS(CAST(w.\"geometry\" AS GEOGRAPHY), c.geom) JOIN highway_tagged AS ht ON w.\"id\" = ht.\"id\" LEFT JOIN bridge_tagged AS bt ON w.\"id\" = bt.\"id\" WHERE bt.\"id\" IS NULL), highway_ways_with_node_ids /* Extract node IDs into arrays */ AS (SELECT hw.\"id\", hw.geom_bin, ARRAY_AGG(CAST(JSON_EXTRACT_PATH(n.value, 'id') AS DECIMAL(38, 0))) FILTER(WHERE CAST(JSON_EXTRACT_PATH(n.value, 'id') AS DECIMAL(38, 0)) IS NOT NULL) AS node_ids FROM highway_ways AS hw, LATERAL UNNEST(input => CAST(hw.\"nodes\" AS JSON)) AS n(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY hw.\"id\", hw.geom_bin), overlapping_pairs /* Find overlapping pairs without shared nodes */ AS (SELECT a.\"id\" AS id_a, b.\"id\" AS id_b FROM highway_ways_with_node_ids AS a JOIN highway_ways_with_node_ids AS b ON a.\"id\" < b.\"id\" AND ST_INTERSECTS(CAST(a.geom_bin AS GEOGRAPHY), CAST(b.geom_bin AS GEOGRAPHY)) AND NOT a.node_ids && b.node_ids) SELECT COUNT(*) AS NUM_OVERLAPPING_WAYS FROM overlapping_pairs") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq056_eq_0_3
