import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq021 — crossskill equivalence(s)

Question: For the top 20 Citi Bike routes in 2016, which route is faster than yellow taxis and among those, which one has the longest average bike duration? Please provide the start station name of this route. The coordinates are rounded to three decimals.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq021

CREATE TABLE CITIBIKE_TRIPS («tripduration» INT, «starttime» INT, «stoptime» INT, «start_station_id» INT, «start_station_name» STRING, «start_station_latitude» FLOAT, «start_station_longitude» FLOAT, «end_station_id» INT, «end_station_name» STRING, «end_station_latitude» FLOAT, «end_station_longitude» FLOAT, «bikeid» INT, «usertype» STRING, «birth_year» INT, «gender» STRING)
CREATE TABLE TLC_YELLOW_TRIPS_2016 («vendor_id» STRING, «pickup_datetime» INT, «dropoff_datetime» INT, «passenger_count» INT, «trip_distance» FLOAT, «pickup_longitude» FLOAT, «pickup_latitude» FLOAT, «rate_code» INT, «store_and_fwd_flag» STRING, «dropoff_longitude» FLOAT, «dropoff_latitude» FLOAT, «payment_type» STRING, «fare_amount» FLOAT, «extra» FLOAT, «mta_tax» FLOAT, «tip_amount» FLOAT, «tolls_amount» FLOAT, «imp_surcharge» FLOAT, «total_amount» FLOAT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_routes_2016 AS (SELECT \"start_station_name\", \"end_station_name\", ROUND(\"start_station_latitude\", 3) AS start_lat, ROUND(\"start_station_longitude\", 3) AS start_lon, ROUND(\"end_station_latitude\", 3) AS end_lat, ROUND(\"end_station_longitude\", 3) AS end_lon, COUNT(*) AS bike_trip_count, AVG(\"tripduration\") AS avg_bike_duration FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\" WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(\"starttime\" AS DOUBLE PRECISION) / 1000000)) = 2016 GROUP BY \"start_station_name\", \"end_station_name\", ROUND(\"start_station_latitude\", 3), ROUND(\"start_station_longitude\", 3), ROUND(\"end_station_latitude\", 3), ROUND(\"end_station_longitude\", 3) ORDER BY bike_trip_count DESC LIMIT 20), taxi_routes AS (SELECT ROUND(\"pickup_latitude\", 3) AS start_lat, ROUND(\"pickup_longitude\", 3) AS start_lon, ROUND(\"dropoff_latitude\", 3) AS end_lat, ROUND(\"dropoff_longitude\", 3) AS end_lon, AVG(CAST((\"dropoff_datetime\" - \"pickup_datetime\") AS DOUBLE PRECISION) / 1000000) AS avg_taxi_duration FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\" GROUP BY ROUND(\"pickup_latitude\", 3), ROUND(\"pickup_longitude\", 3), ROUND(\"dropoff_latitude\", 3), ROUND(\"dropoff_longitude\", 3)), bike_faster AS (SELECT b.\"start_station_name\", b.avg_bike_duration FROM bike_routes_2016 AS b INNER JOIN taxi_routes AS t ON b.start_lat = t.start_lat AND b.start_lon = t.start_lon AND b.end_lat = t.end_lat AND b.end_lon = t.end_lon WHERE b.avg_bike_duration < t.avg_taxi_duration) SELECT \"start_station_name\" AS OUTPUT FROM bike_faster ORDER BY avg_bike_duration DESC LIMIT 1" = sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_routes AS (SELECT \"start_station_name\", \"end_station_name\", ROUND(\"start_station_latitude\", 3) AS start_lat, ROUND(\"start_station_longitude\", 3) AS start_lon, ROUND(\"end_station_latitude\", 3) AS end_lat, ROUND(\"end_station_longitude\", 3) AS end_lon, COUNT(*) AS bike_trip_count, AVG(\"tripduration\") AS avg_bike_duration FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\" WHERE \"starttime\" >= 1451606400000000 AND \"starttime\" < 1483228800000000 GROUP BY \"start_station_name\", \"end_station_name\", ROUND(\"start_station_latitude\", 3), ROUND(\"start_station_longitude\", 3), ROUND(\"end_station_latitude\", 3), ROUND(\"end_station_longitude\", 3) ORDER BY bike_trip_count DESC LIMIT 20), taxi_routes AS (SELECT ROUND(\"pickup_latitude\", 3) AS start_lat, ROUND(\"pickup_longitude\", 3) AS start_lon, ROUND(\"dropoff_latitude\", 3) AS end_lat, ROUND(\"dropoff_longitude\", 3) AS end_lon, COUNT(*) AS taxi_trip_count, AVG(CAST((\"dropoff_datetime\" - \"pickup_datetime\") AS DOUBLE PRECISION) / 1000000) AS avg_taxi_duration FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\" GROUP BY ROUND(\"pickup_latitude\", 3), ROUND(\"pickup_longitude\", 3), ROUND(\"dropoff_latitude\", 3), ROUND(\"dropoff_longitude\", 3)) SELECT b.\"start_station_name\" AS OUTPUT FROM bike_routes AS b INNER JOIN taxi_routes AS t ON b.start_lat = t.start_lat AND b.start_lon = t.start_lon AND b.end_lat = t.end_lat AND b.end_lon = t.end_lon WHERE b.avg_bike_duration < t.avg_taxi_duration ORDER BY b.avg_bike_duration DESC LIMIT 1" := by
  first | sql_equiv | sorry

-- eq_0_2: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_2 : ∀ t,
    (sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_routes_2016 AS (SELECT \"start_station_name\", \"end_station_name\", ROUND(\"start_station_latitude\", 3) AS start_lat, ROUND(\"start_station_longitude\", 3) AS start_lon, ROUND(\"end_station_latitude\", 3) AS end_lat, ROUND(\"end_station_longitude\", 3) AS end_lon, COUNT(*) AS bike_trip_count, AVG(\"tripduration\") AS avg_bike_duration FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\" WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(\"starttime\" AS DOUBLE PRECISION) / 1000000)) = 2016 GROUP BY \"start_station_name\", \"end_station_name\", ROUND(\"start_station_latitude\", 3), ROUND(\"start_station_longitude\", 3), ROUND(\"end_station_latitude\", 3), ROUND(\"end_station_longitude\", 3) ORDER BY bike_trip_count DESC LIMIT 20), taxi_routes AS (SELECT ROUND(\"pickup_latitude\", 3) AS start_lat, ROUND(\"pickup_longitude\", 3) AS start_lon, ROUND(\"dropoff_latitude\", 3) AS end_lat, ROUND(\"dropoff_longitude\", 3) AS end_lon, AVG(CAST((\"dropoff_datetime\" - \"pickup_datetime\") AS DOUBLE PRECISION) / 1000000) AS avg_taxi_duration FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\" GROUP BY ROUND(\"pickup_latitude\", 3), ROUND(\"pickup_longitude\", 3), ROUND(\"dropoff_latitude\", 3), ROUND(\"dropoff_longitude\", 3)), bike_faster AS (SELECT b.\"start_station_name\", b.avg_bike_duration FROM bike_routes_2016 AS b INNER JOIN taxi_routes AS t ON b.start_lat = t.start_lat AND b.start_lon = t.start_lon AND b.end_lat = t.end_lat AND b.end_lon = t.end_lon WHERE b.avg_bike_duration < t.avg_taxi_duration) SELECT \"start_station_name\" AS OUTPUT FROM bike_faster ORDER BY avg_bike_duration DESC LIMIT 1") t ~= (sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_trips AS (SELECT \"start_station_name\", ROUND(\"start_station_latitude\", 3) AS start_lat, ROUND(\"start_station_longitude\", 3) AS start_lon, ROUND(\"end_station_latitude\", 3) AS end_lat, ROUND(\"end_station_longitude\", 3) AS end_lon, \"tripduration\" FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\" WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(\"starttime\" AS DOUBLE PRECISION) / 1000000)) = 2016), top20_routes AS (SELECT start_lat, start_lon, end_lat, end_lon, COUNT(*) AS trip_count, AVG(\"tripduration\") AS avg_bike_duration, ANY_VALUE(\"start_station_name\") AS start_station_name FROM bike_trips GROUP BY start_lat, start_lon, end_lat, end_lon ORDER BY trip_count DESC LIMIT 20), taxi_avg AS (SELECT ROUND(\"pickup_latitude\", 3) AS start_lat, ROUND(\"pickup_longitude\", 3) AS start_lon, ROUND(\"dropoff_latitude\", 3) AS end_lat, ROUND(\"dropoff_longitude\", 3) AS end_lon, AVG(CAST(EXTRACT(epoch FROM CAST(TO_TIMESTAMP(CAST(\"dropoff_datetime\" AS DOUBLE PRECISION) / 1000000) AS TIMESTAMP) - CAST(TO_TIMESTAMP(CAST(\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) AS TIMESTAMP)) AS BIGINT)) AS avg_taxi_duration FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\" GROUP BY start_lat, start_lon, end_lat, end_lon) SELECT t.start_station_name AS \"OUTPUT\" FROM top20_routes AS t JOIN taxi_avg AS x ON t.start_lat = x.start_lat AND t.start_lon = x.start_lon AND t.end_lat = x.end_lat AND t.end_lon = x.end_lon WHERE t.avg_bike_duration < x.avg_taxi_duration ORDER BY t.avg_bike_duration DESC LIMIT 1") t := by
  intro t; first | sql_equiv | sorry

