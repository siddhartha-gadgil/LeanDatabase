import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq021 — crossskill equivalence(s)

Question: For the top 20 Citi Bike routes in 2016, which route is faster than yellow taxis and among those, which one has the longest average bike duration? Please provide the start station name of this route. The coordinates are rounded to three decimals.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq021

CREATE TABLE CITIBIKE_TRIPS («tripduration» INT, «starttime» INT, «stoptime» INT, «start_station_id» INT, «start_station_name» STRING, «start_station_latitude» FLOAT, «start_station_longitude» FLOAT, «end_station_id» INT, «end_station_name» STRING, «end_station_latitude» FLOAT, «end_station_longitude» FLOAT, «bikeid» INT, «usertype» STRING, «birth_year» INT, «gender» STRING)
CREATE TABLE TLC_YELLOW_TRIPS_2016 («vendor_id» STRING, «pickup_datetime» INT, «dropoff_datetime» INT, «passenger_count» INT, «trip_distance» FLOAT, «pickup_longitude» FLOAT, «pickup_latitude» FLOAT, «rate_code» INT, «store_and_fwd_flag» STRING, «dropoff_longitude» FLOAT, «dropoff_latitude» FLOAT, «payment_type» STRING, «fare_amount» FLOAT, «extra» FLOAT, «mta_tax» FLOAT, «tip_amount» FLOAT, «tolls_amount» FLOAT, «imp_surcharge» FLOAT, «total_amount» FLOAT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_routes_2016 AS (\n  SELECT \n    \"start_station_name\",\n    \"end_station_name\",\n    ROUND(\"start_station_latitude\", 3) AS start_lat,\n    ROUND(\"start_station_longitude\", 3) AS start_lon,\n    ROUND(\"end_station_latitude\", 3) AS end_lat,\n    ROUND(\"end_station_longitude\", 3) AS end_lon,\n    COUNT(*) AS bike_trip_count,\n    AVG(\"tripduration\") AS avg_bike_duration\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"starttime\" / 1000000)) = 2016\n  GROUP BY \n    \"start_station_name\", \"end_station_name\",\n    ROUND(\"start_station_latitude\", 3), ROUND(\"start_station_longitude\", 3),\n    ROUND(\"end_station_latitude\", 3), ROUND(\"end_station_longitude\", 3)\n  ORDER BY bike_trip_count DESC\n  LIMIT 20\n),\ntaxi_routes AS (\n  SELECT \n    ROUND(\"pickup_latitude\", 3) AS start_lat,\n    ROUND(\"pickup_longitude\", 3) AS start_lon,\n    ROUND(\"dropoff_latitude\", 3) AS end_lat,\n    ROUND(\"dropoff_longitude\", 3) AS end_lon,\n    AVG((\"dropoff_datetime\" - \"pickup_datetime\") / 1000000) AS avg_taxi_duration\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\"\n  GROUP BY \n    ROUND(\"pickup_latitude\", 3), ROUND(\"pickup_longitude\", 3),\n    ROUND(\"dropoff_latitude\", 3), ROUND(\"dropoff_longitude\", 3)\n),\nbike_faster AS (\n  SELECT \n    b.\"start_station_name\",\n    b.avg_bike_duration\n  FROM bike_routes_2016 b\n  INNER JOIN taxi_routes t\n    ON b.start_lat = t.start_lat\n    AND b.start_lon = t.start_lon\n    AND b.end_lat = t.end_lat\n    AND b.end_lon = t.end_lon\n  WHERE b.avg_bike_duration < t.avg_taxi_duration\n)\nSELECT \"start_station_name\" AS OUTPUT\nFROM bike_faster\nORDER BY avg_bike_duration DESC\nLIMIT 1;" = sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_routes AS (\n  SELECT \n    \"start_station_name\",\n    \"end_station_name\",\n    ROUND(\"start_station_latitude\", 3) AS start_lat,\n    ROUND(\"start_station_longitude\", 3) AS start_lon,\n    ROUND(\"end_station_latitude\", 3) AS end_lat,\n    ROUND(\"end_station_longitude\", 3) AS end_lon,\n    COUNT(*) AS bike_trip_count,\n    AVG(\"tripduration\") AS avg_bike_duration\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\"\n  WHERE \"starttime\" >= 1451606400000000 AND \"starttime\" < 1483228800000000\n  GROUP BY \"start_station_name\", \"end_station_name\",\n           ROUND(\"start_station_latitude\", 3), ROUND(\"start_station_longitude\", 3),\n           ROUND(\"end_station_latitude\", 3), ROUND(\"end_station_longitude\", 3)\n  ORDER BY bike_trip_count DESC\n  LIMIT 20\n),\ntaxi_routes AS (\n  SELECT \n    ROUND(\"pickup_latitude\", 3) AS start_lat,\n    ROUND(\"pickup_longitude\", 3) AS start_lon,\n    ROUND(\"dropoff_latitude\", 3) AS end_lat,\n    ROUND(\"dropoff_longitude\", 3) AS end_lon,\n    COUNT(*) AS taxi_trip_count,\n    AVG((\"dropoff_datetime\" - \"pickup_datetime\") / 1000000) AS avg_taxi_duration\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\"\n  GROUP BY ROUND(\"pickup_latitude\", 3), ROUND(\"pickup_longitude\", 3),\n           ROUND(\"dropoff_latitude\", 3), ROUND(\"dropoff_longitude\", 3)\n)\nSELECT \n  b.\"start_station_name\" AS OUTPUT\nFROM bike_routes b\nINNER JOIN taxi_routes t \n  ON b.start_lat = t.start_lat \n  AND b.start_lon = t.start_lon\n  AND b.end_lat = t.end_lat\n  AND b.end_lon = t.end_lon\nWHERE b.avg_bike_duration < t.avg_taxi_duration\nORDER BY b.avg_bike_duration DESC\nLIMIT 1;" := by
  first | sql_equiv | sorry

-- eq_0_2: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_2 : ∀ t,
    (sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_routes_2016 AS (\n  SELECT \n    \"start_station_name\",\n    \"end_station_name\",\n    ROUND(\"start_station_latitude\", 3) AS start_lat,\n    ROUND(\"start_station_longitude\", 3) AS start_lon,\n    ROUND(\"end_station_latitude\", 3) AS end_lat,\n    ROUND(\"end_station_longitude\", 3) AS end_lon,\n    COUNT(*) AS bike_trip_count,\n    AVG(\"tripduration\") AS avg_bike_duration\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"starttime\" / 1000000)) = 2016\n  GROUP BY \n    \"start_station_name\", \"end_station_name\",\n    ROUND(\"start_station_latitude\", 3), ROUND(\"start_station_longitude\", 3),\n    ROUND(\"end_station_latitude\", 3), ROUND(\"end_station_longitude\", 3)\n  ORDER BY bike_trip_count DESC\n  LIMIT 20\n),\ntaxi_routes AS (\n  SELECT \n    ROUND(\"pickup_latitude\", 3) AS start_lat,\n    ROUND(\"pickup_longitude\", 3) AS start_lon,\n    ROUND(\"dropoff_latitude\", 3) AS end_lat,\n    ROUND(\"dropoff_longitude\", 3) AS end_lon,\n    AVG((\"dropoff_datetime\" - \"pickup_datetime\") / 1000000) AS avg_taxi_duration\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\"\n  GROUP BY \n    ROUND(\"pickup_latitude\", 3), ROUND(\"pickup_longitude\", 3),\n    ROUND(\"dropoff_latitude\", 3), ROUND(\"dropoff_longitude\", 3)\n),\nbike_faster AS (\n  SELECT \n    b.\"start_station_name\",\n    b.avg_bike_duration\n  FROM bike_routes_2016 b\n  INNER JOIN taxi_routes t\n    ON b.start_lat = t.start_lat\n    AND b.start_lon = t.start_lon\n    AND b.end_lat = t.end_lat\n    AND b.end_lon = t.end_lon\n  WHERE b.avg_bike_duration < t.avg_taxi_duration\n)\nSELECT \"start_station_name\" AS OUTPUT\nFROM bike_faster\nORDER BY avg_bike_duration DESC\nLIMIT 1;") t ~= (sql%([CITIBIKE_TRIPS_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH bike_trips AS (\n  SELECT\n    \"start_station_name\",\n    ROUND(\"start_station_latitude\", 3)  AS start_lat,\n    ROUND(\"start_station_longitude\", 3) AS start_lon,\n    ROUND(\"end_station_latitude\", 3)    AS end_lat,\n    ROUND(\"end_station_longitude\", 3)   AS end_lon,\n    \"tripduration\"\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"CITIBIKE_TRIPS\"\n  WHERE YEAR(TO_TIMESTAMP(\"starttime\" / 1000000)) = 2016\n),\ntop20_routes AS (\n  SELECT\n    start_lat,\n    start_lon,\n    end_lat,\n    end_lon,\n    COUNT(*) AS trip_count,\n    AVG(\"tripduration\") AS avg_bike_duration,\n    ANY_VALUE(\"start_station_name\") AS start_station_name\n  FROM bike_trips\n  GROUP BY start_lat, start_lon, end_lat, end_lon\n  ORDER BY trip_count DESC\n  LIMIT 20\n),\ntaxi_avg AS (\n  SELECT\n    ROUND(\"pickup_latitude\", 3)  AS start_lat,\n    ROUND(\"pickup_longitude\", 3) AS start_lon,\n    ROUND(\"dropoff_latitude\", 3) AS end_lat,\n    ROUND(\"dropoff_longitude\", 3) AS end_lon,\n    AVG(DATEDIFF('second', TO_TIMESTAMP(\"pickup_datetime\" / 1000000), TO_TIMESTAMP(\"dropoff_datetime\" / 1000000))) AS avg_taxi_duration\n  FROM \"NEW_YORK\".\"NEW_YORK\".\"TLC_YELLOW_TRIPS_2016\"\n  GROUP BY start_lat, start_lon, end_lat, end_lon\n)\nSELECT t.start_station_name AS \"OUTPUT\"\nFROM top20_routes t\nJOIN taxi_avg x\n  ON t.start_lat = x.start_lat\n AND t.start_lon = x.start_lon\n AND t.end_lat   = x.end_lat\n AND t.end_lon   = x.end_lon\nWHERE t.avg_bike_duration < x.avg_taxi_duration\nORDER BY t.avg_bike_duration DESC\nLIMIT 1;") t := by
  intro t; first | sql_equiv | sorry

