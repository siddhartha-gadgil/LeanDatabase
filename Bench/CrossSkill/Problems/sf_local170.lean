tention_check AS (SELECT cp.\"id_bioguide\", cp.state, cp.\"gender\", cp.period, MAX(CASE WHEN CAST(t.\"term_start\" AS DATE) <= cp.check_date AND CAST(t.\"term_end\" AS DATE) >= cp.check_date THEN 1 ELSE 0 END) AS retained FROM cohort_periods AS cp LEFT JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON cp.\"id_bioguide\" = t.\"id_bioguide\" GROUP BY cp.\"id_bioguide\", cp.state, cp.\"gender\", cp.period), retention_rates AS (SELECT state, \"gender\", period, SUM(retained) AS retained_count, COUNT(*) AS total_count, CAST(SUM(retained) AS DOUBLE PRECISION) / CAST(COUNT(*) AS DOUBLE PRECISION) AS retention_rate FROM retention_check GROUP BY state, \"gender\", period), states_with_full_retention AS (SELECT state FROM retention_rates WHERE retention_rate > 0 AND \"gender\" IN ('M', 'F') GROUP BY state HAVING COUNT(DISTINCT \"gender\" || '_' || period) = 12) SELECT state FROM states_with_full_retention ORDER BY state") t := by
