CREATE TABLE CUSTOMERS («CustomerID» INT, «CustFirstName» STRING, «CustLastName» STRING, «CustStreetAddress» STRING, «CustCity» STRING, «CustState» STRING, «CustZipCode» STRING, «CustPhoneNumber» STRING)
CREATE TABLE MUSICAL_PREFERENCES («CustomerID» INT, «StyleID» INT, «PreferenceSeq» INT)

