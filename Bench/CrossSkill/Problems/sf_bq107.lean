PR01_REFERENCE_201703\" AS r ON vc.\"reference_name\" = r.\"name\") SELECT REFERENCE_NAME, VARIANT_DENSITY, VARIANT_COUNT, REFERENCE_LENGTH FROM joined ORDER BY REFERENCE_LENGTH DESC LIMIT 1") t := by
  intro t; first | sql_equiv | sorry

