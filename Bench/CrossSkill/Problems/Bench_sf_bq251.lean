import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq251 — crossskill equivalence(s)

Question: I want to know the GitHub project URLs for the top 3 most downloaded PyPI packages based on download count. First, extract PyPI package metadata including name, version, and project URLs. Filter these URLs to only include those that link to GitHub repositories. Use a regular expression to clean the GitHub URLs by removing unnecessary parts like 'issues', 'pull', 'blob', and 'tree' paths, keeping only the main repository URL. For packages with multiple versions, use only the most recent version based on upload time. Join this data with download metrics to determine the most downloaded packages. Return only the cleaned GitHub repository URLs (without quotation marks) for the top 3 packages by total download count, ensuring that only packages with valid GitHub URLs are included in the results.

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq251

CREATE TABLE DISTRIBUTION_METADATA («metadata_version» STRING, «name» STRING, «version» STRING, «summary» STRING, «description» STRING, «description_content_type» STRING, «author» STRING, «author_email» STRING, «maintainer» STRING, «maintainer_email» STRING, «license» STRING, «keywords» STRING, «classifiers» STRING, «platform» STRING, «home_page» STRING, «download_url» STRING, «requires_python» STRING, «requires» STRING, «provides» STRING, «obsoletes» STRING, «requires_dist» STRING, «provides_dist» STRING, «obsoletes_dist» STRING, «requires_external» STRING, «project_urls» STRING, «uploaded_via» STRING, «upload_time» INT, «filename» STRING, «size» INT, «path» STRING, «python_version» STRING, «packagetype» STRING, «comment_text» STRING, «has_signature» BOOL, «md5_digest» STRING, «sha256_digest» STRING, «blake2_256_digest» STRING)
CREATE TABLE FILE_DOWNLOADS («timestamp» INT, «country_code» STRING, «url» STRING, «project» STRING, «file» STRING, «details» STRING, «tls_protocol» STRING, «tls_cipher» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([DISTRIBUTION_METADATA_schema, FILE_DOWNLOADS_schema]) "WITH latest_versions AS (\n  -- For packages with multiple versions, use only the most recent version based on upload time\n  SELECT\n    \"name\",\n    \"version\",\n    \"project_urls\",\n    \"upload_time\",\n    ROW_NUMBER() OVER (PARTITION BY \"name\" ORDER BY \"upload_time\" DESC) AS rn\n  FROM \"PYPI\".\"PYPI\".\"DISTRIBUTION_METADATA\"\n),\ngithub_urls AS (\n  -- Extract and clean GitHub URLs from project_urls array\n  SELECT DISTINCT\n    lv.\"name\",\n    REGEXP_REPLACE(\n      TRIM(SUBSTR(f.value::STRING, POSITION(', ' IN f.value::STRING) + 2)),\n      '/(issues|pull|blob|tree)(/.*)?$', ''\n    ) AS github_url\n  FROM latest_versions lv,\n  LATERAL FLATTEN(input => lv.\"project_urls\") f\n  WHERE lv.rn = 1\n    AND f.value::STRING ILIKE '%github.com%'\n),\ndownloads AS (\n  -- Count downloads per project\n  SELECT \"project\", COUNT(*) AS download_count\n  FROM \"PYPI\".\"PYPI\".\"FILE_DOWNLOADS\"\n  GROUP BY \"project\"\n)\nSELECT g.github_url AS GITHUB_URL\nFROM github_urls g\nJOIN downloads d ON g.\"name\" = d.\"project\"\nWHERE g.github_url IS NOT NULL AND g.github_url != ''\nORDER BY d.download_count DESC\nLIMIT 3;") t ~= (sql%([DISTRIBUTION_METADATA_schema, FILE_DOWNLOADS_schema]) "WITH latest_versions AS (\n  -- Get the most recent version per package using upload_time\n  SELECT\n    \"name\",\n    \"version\",\n    \"project_urls\",\n    ROW_NUMBER() OVER (PARTITION BY \"name\" ORDER BY \"upload_time\" DESC) AS rn\n  FROM \"PYPI\".\"PYPI\".\"DISTRIBUTION_METADATA\"\n),\nlatest AS (\n  SELECT \"name\", \"version\", \"project_urls\"\n  FROM latest_versions\n  WHERE rn = 1\n),\ngithub_urls AS (\n  -- Extract and clean GitHub URLs from project_urls array\n  -- project_urls entries are in \"Label, URL\" format\n  SELECT DISTINCT\n    l.\"name\",\n    RTRIM(\n      REGEXP_REPLACE(\n        TRIM(REGEXP_SUBSTR(f.value::string, ',\\\\s*(.+)', 1, 1, 'e')),\n        '/(issues|pull|blob|tree)(/.*)?$', ''\n      ),\n      '/'\n    ) AS cleaned_github_url\n  FROM latest l,\n  LATERAL FLATTEN(input => l.\"project_urls\") f\n  WHERE LOWER(f.value::string) LIKE '%github.com%'\n),\ndownloads AS (\n  -- Count downloads per project\n  SELECT \"project\", COUNT(*) AS download_count\n  FROM \"PYPI\".\"PYPI\".\"FILE_DOWNLOADS\"\n  GROUP BY \"project\"\n)\nSELECT\n  g.cleaned_github_url AS GITHUB_URL\nFROM github_urls g\nJOIN downloads d ON LOWER(g.\"name\") = LOWER(d.\"project\")\nWHERE g.cleaned_github_url IS NOT NULL AND g.cleaned_github_url != ''\nGROUP BY g.cleaned_github_url\nORDER BY SUM(d.download_count) DESC\nLIMIT 3;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([DISTRIBUTION_METADATA_schema, FILE_DOWNLOADS_schema]) "WITH latest_versions AS (\n  -- For packages with multiple versions, use only the most recent version based on upload time\n  SELECT\n    \"name\",\n    \"version\",\n    \"project_urls\",\n    \"upload_time\",\n    ROW_NUMBER() OVER (PARTITION BY \"name\" ORDER BY \"upload_time\" DESC) AS rn\n  FROM \"PYPI\".\"PYPI\".\"DISTRIBUTION_METADATA\"\n),\ngithub_urls AS (\n  -- Extract and clean GitHub URLs from project_urls array\n  SELECT DISTINCT\n    lv.\"name\",\n    REGEXP_REPLACE(\n      TRIM(SUBSTR(f.value::STRING, POSITION(', ' IN f.value::STRING) + 2)),\n      '/(issues|pull|blob|tree)(/.*)?$', ''\n    ) AS github_url\n  FROM latest_versions lv,\n  LATERAL FLATTEN(input => lv.\"project_urls\") f\n  WHERE lv.rn = 1\n    AND f.value::STRING ILIKE '%github.com%'\n),\ndownloads AS (\n  -- Count downloads per project\n  SELECT \"project\", COUNT(*) AS download_count\n  FROM \"PYPI\".\"PYPI\".\"FILE_DOWNLOADS\"\n  GROUP BY \"project\"\n)\nSELECT g.github_url AS GITHUB_URL\nFROM github_urls g\nJOIN downloads d ON g.\"name\" = d.\"project\"\nWHERE g.github_url IS NOT NULL AND g.github_url != ''\nORDER BY d.download_count DESC\nLIMIT 3;" = sql%([DISTRIBUTION_METADATA_schema, FILE_DOWNLOADS_schema]) "WITH latest_versions AS (\n    -- Get the latest version per package\n    SELECT \"name\", \"version\", \"project_urls\", \"upload_time\",\n           ROW_NUMBER() OVER (PARTITION BY \"name\" ORDER BY \"upload_time\" DESC) as rn\n    FROM \"PYPI\".\"PYPI\".\"DISTRIBUTION_METADATA\"\n),\ngithub_urls AS (\n    -- Extract GitHub URLs from project_urls array for latest versions only\n    SELECT DISTINCT\n        lv.\"name\" as project_name,\n        -- Extract URL part after \", \" and clean it\n        REGEXP_REPLACE(\n            TRIM(SPLIT_PART(f.value::STRING, ', ', 2)),\n            '(https://github\\\\.com/[^/]+/[^/]+)(/.*)?',\n            '\\\\1'\n        ) as github_url\n    FROM latest_versions lv,\n    LATERAL FLATTEN(input => lv.\"project_urls\") f\n    WHERE lv.rn = 1\n    AND f.value::STRING ILIKE '%github.com%'\n),\ndownloads AS (\n    -- Count downloads per project\n    SELECT \"project\", COUNT(*) as download_count\n    FROM \"PYPI\".\"PYPI\".\"FILE_DOWNLOADS\"\n    GROUP BY \"project\"\n),\nranked AS (\n    SELECT DISTINCT\n        gu.github_url,\n        d.download_count,\n        ROW_NUMBER() OVER (ORDER BY d.download_count DESC) as rn\n    FROM github_urls gu\n    INNER JOIN downloads d ON LOWER(d.\"project\") = LOWER(gu.project_name)\n)\nSELECT github_url AS \"github_url\"\nFROM ranked\nWHERE rn <= 3\nORDER BY rn;" := by
  first | sql_equiv | sorry

