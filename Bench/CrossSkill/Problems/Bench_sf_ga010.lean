ia','aol','startpage','search')\n           AND REGEXP_LIKE(LOWER(medium), '^(.*cp.*|ppc|retargeting|paid.*)$') THEN 'Paid Search'\n      -- 5. Paid Social (source matches social sites AND medium matches paid pattern)\n      WHEN LOWER(source) IN ('facebook','instagram','twitter','linkedin','pinterest','snapchat','tiktok','reddit','tumblr','vk','whatsapp','youtube','wechat','weibo','quora')\n           AND REGEXP_LIKE(LOWER(medium), '^(.*cp.*|ppc|retargeting|paid.*)$') THEN 'Paid Social'\n      -- 6. Paid Video (source matches video sites AND medium matches paid pattern)\n      WHEN LOWER(source) IN ('youtube','vimeo','dailymotion','twitch')\n           AND REGEXP_LIKE(LOWER(medium), '^(.*cp.*|ppc|retargeting|paid.*)$') THEN 'Paid Video'\n      -- 7. Display (medium matches display/banner/expandable/interstitial/cpm)\n      WHEN REGEXP_LIKE(LOWER(medium), '^(display|cpm|banner|expandable|interstitial)$') THEN 'Display'\n      -- 8. Organic Shopping (source matches shopping sites OR campaign matches shop pattern)\n      WHEN LOWER(source) IN ('google shopping','shopify','stripe','walmart','amazon','ebay','wish','mercadolibre','etsy','alibaba','aliexpress')\n           OR REGEXP_LIKE(LOWER(campaign), '.*(([^a-df-z]|^)shop|shopping).*') THEN 'Organic Shopping'\n      -- 9. Organic Social (source matches social sites OR medium matches social/community/etc)\n      WHEN LOWER(source) IN ('facebook','instagram','twitter','linkedin','pinterest','snapchat','tiktok','reddit','tumblr','vk','whatsapp','youtube','wechat','weibo','quora')\n           OR REGEXP_LIKE(LOWER(medium), '^(social|social-network|social-media|sm|social network|social media)$') THEN 'Organic Social'\n      -- 10. Organic Video (source matches video sites OR medium matches video)\n      WHEN LOWER(source) IN ('youtube','vimeo','dailymotion','twitch')\n           OR REGEXP_LIKE(LOWER(medium), '^(.*video.*)$') THEN 'Organic Video'\n      -- 11. Organic Search (source matches search sites OR medium matches organic)\n      WHEN LOWER(source) IN ('google','bing','yahoo','baidu','duckduckgo','yandex','ask','ecosia','aol','startpage','search')\n           OR LOWER(medium) = 'organic' THEN 'Organic Search'\n      -- 12. Referral (medium matches referral)\n      WHEN LOWER(medium) = 'referral' THEN 'Referral'\n      -- 13. Email\n      WHEN LOWER(medium) = 'email' OR LOWER(source) = 'email' THEN 'Email'\n      -- 14. Affiliates\n      WHEN LOWER(medium) = 'affiliate' THEN 'Affiliates'\n      -- 15. Audio\n      WHEN LOWER(medium) = 'audio' THEN 'Audio'\n      -- 16. SMS\n      WHEN LOWER(medium) = 'sms' OR LOWER(source) = 'sms' THEN 'SMS'\n      -- 17. Mobile Push Notifications\n      WHEN LOWER(medium) LIKE '%push%' OR REGEXP_LIKE(LOWER(medium), '.*(mobile|notification).*') THEN 'Mobile Push Notifications'\n      ELSE 'Unassigned'\n    END AS channel\n  FROM all_sessions\n),\nchannel_counts AS (\n  SELECT channel, COUNT(*) AS session_count\n  FROM channeled\n  GROUP BY channel\n),\nranked AS (\n  SELECT channel, session_count, ROW_NUMBER() OVER (ORDER BY session_count DESC) AS rn\n  FROM channel_counts\n)\nSELECT channel AS OUTPUT\nFROM ranked\nWHERE rn = 4;") t := by
