ts\n)\nSELECT channel AS OUTPUT\nFROM ranked\nWHERE rn = 4;") t ~= (sql%([EVENTS_20201204_schema, EVENTS_20201207_schema, EVENTS_20201211_schema, EVENTS_20201220_schema, EVENTS_20201208_schema, EVENTS_20201223_schema, EVENTS_20201212_schema, EVENTS_20201202_schema, EVENTS_20201203_schema, EVENTS_20201206_schema, EVENTS_20201210_schema, EVENTS_20201216_schema, EVENTS_20201218_schema, EVENTS_20201224_schema, EVENTS_20201227_schema, EVENTS_20201228_schema, EVENTS_20201214_schema, EVENTS_20201215_schema, EVENTS_20201222_schema, EVENTS_20201231_schema, EVENTS_20201219_schema, EVENTS_20201201_schema, EVENTS_20201213_schema, EVENTS_20201217_schema, EVENTS_20201226_schema, EVENTS_20201230_schema, EVENTS_20201205_schema, EVENTS_20201221_schema, EVENTS_20201225_schema, EVENTS_20201209_schema, EVENTS_20201229_schema]) "WITH all_events AS (\n    SELECT TRAFFIC_SOURCE, EVENT_NAME\n    FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201201\" WHERE EVENT_NAME = 'session_start'\n    UNION ALL SELECT TRAFFIC_SOURCE, EVENT_NAME FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201202\" WHERE EVENT_NAME = 'session_start'\n    UNION ALL SELECT TRAFFIC_SOURCE, EVENT_NAME FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201203\" WHERE EVENT_NAME = 'session_start'\n    UNION ALL SELECT TRAFFIC_SOURCE, EVENT_NAME FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201204\" WHERE EVENT_NAME = 'session_start'\n    UNION ALL SELECT TRAFFIC_SOURCE, EVENT_NAME FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201205\" WHERE EVENT_NAME = 'session_start'\n    UNION ALL SELECT TRAFFIC_SOURCE, EVENT_NAME FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201206\" WHERE EVENT_NAME = 'session_start'\n    UNION ALL SELECT TRAFFIC_SOURCE, EVENT_NAME FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMERCE\".\"EVENTS_20201207\" WHERE EVENT_NAME = 'session_start'\n    UNION ALL SELECT TRAFFIC_SOURCE, EVENT_NAME FROM \"GA4\".\"GA4_OBFUSCATED_SAMPLE_ECOMMER