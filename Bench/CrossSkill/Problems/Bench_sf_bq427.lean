theorem eq_0_1 (t : TableRel MBB_PBP_SR_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) (h3 : hyp0_1_3 t) :
    (sql%([MBB_PBP_SR_schema]) "SELECT\n    \"shot_type\",\n    AVG(CASE WHEN \"event_coord_x\" < 564 THEN \"event_coord_x\" ELSE 1128 - \"event_coord_x\" END) AS AVG_X,\n    AVG(CASE WHEN \"event_coord_x\" < 564 THEN 600 - \"event_coord_y\" ELSE \"event_coord_y\" END) AS AVG_Y,\n    CAST(COUNT(*) AS FLOAT) / COUNT(DISTINCT \"game_id\") AS AVG_ATTEMPTS,\n    CAST(SUM(CASE WHEN \"shot_made\" THEN 1 ELSE 0 END) AS FLOAT) / COUNT(DISTINCT \"game_id\") AS AVG_SUCCESSES\nFROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_PBP_SR\"\nWHERE \"shot_type\" IS NOT NULL\n  AND \"event_coord_x\" IS NOT NULL\n  AND \"event_coord_y\" IS NOT NULL\n  AND TO_DATE(TO_TIMESTAMP(\"scheduled_date\" / 1000000)) < '2018-03-15'\n  AND (\n      (\"team_basket\" = 'left' AND \"event_coord_x\" < 564)\n      OR (\"team_basket\" = 'right' AND \"event_coord_x\" >= 564)\n  )\nGROUP BY \"shot_type\"\nORDER BY \"shot_type\";") t ~= (sql%([MBB_PBP_SR_schema]) "WITH filtered AS (\n  SELECT \"shot_type\", \"event_coord_x\", \"event_coord_y\", \"shot_made\", \"game_id\"\n  FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_PBP_SR\"\n  WHERE \"shot_type\" IS NOT NULL \n    AND \"event_coord_x\" IS NOT NULL \n    AND \"event_coord_y\" IS NOT NULL\n    AND \"team_basket\" IS NOT NULL\n    AND \"scheduled_date\" < 1521072000000000\n    AND (\n      (\"team_basket\" = 'left' AND \"event_coord_x\" < 564)\n      OR (\"team_basket\" = 'right' AND \"event_coord_x\" >= 564)\n    )\n),\ncoords AS (\n  SELECT \"shot_type\",\n    AVG(\n      CASE WHEN \"event_coord_x\" < 564 THEN \"event_coord_x\"\n           ELSE 1128 - \"event_coord_x\" END\n    ) as AVG_X,\n    AVG(\n      CASE WHEN \"event_coord_x\" < 564 THEN 600 - \"event_coord_y\"\n           ELSE \"event_coord_y\" END\n    ) as AVG_Y\n  FROM filtered\n  GROUP BY \"shot_type\"\n),\ngame_stats AS (\n  SELECT \"shot_type\",\n    AVG(attempts) as AVG_ATTEMPTS,\n    AVG(made) as AVG_SUCCESSES\n  FROM (\n    SELECT \"game_id\", \"shot_type\",\n      COUNT(*) as attempts,\n      SUM(CASE WHEN \"shot_made\" = TRUE THEN 1 ELSE 0 END) as made\n    FROM filtered\n    GROUP BY \"game_id\", \"shot_type\"\n  ) g\n  GROUP BY \"shot_type\"\n)\nSELECT c.\"shot_type\", c.AVG_X, c.AVG_Y, g.AVG_ATTEMPTS, g.AVG_SUCCESSES\nFROM coords c\nJOIN game_stats g ON c.\"shot_type\" = g.\"shot_type\"\nORDER BY c.\"shot_type\";") t := by
  first | sql_equiv | sorry

