_y,\n    CASE WHEN \"shot_made\" = 'true' THEN 1 ELSE 0 END AS is_success\n  FROM \"NCAA_BASKETBALL\".\"NCAA_BASKETBALL\".\"MBB_PBP_SR\"\n  WHERE \"scheduled_date\" < 1521072000000000\n    AND \"shot_type\" IS NOT NULL\n    AND \"event_coord_x\" IS NOT NULL\n    AND \"event_coord_y\" IS NOT NULL\n    AND (\n      (\"team_basket\" = 'left' AND \"event_coord_x\" < 564)\n      OR (\"team_basket\" = 'right' AND \"event_coord_x\" >= 564)\n    )\n),\ncoord_avgs AS (\n  SELECT\n    \"shot_type\",\n    AVG(adjusted_x) AS AVG_X,\n    AVG(adjusted_y) AS AVG_Y\n  FROM filtered_shots\n  GROUP BY \"shot_type\"\n),\ngame_level AS (\n  SELECT\n    \"game_id\",\n    \"shot_type\",\n    COUNT(*) AS attempts,\n    SUM(is_success) AS successes\n  FROM filtered_shots\n  GROUP BY \"game_id\", \"shot_type\"\n),\ngame_avgs AS (\n  SELECT\n    \"shot_type\",\n    AVG(attempts) AS AVG_ATTEMPTS,\n    AVG(successes) AS AVG_SUCCESSES\n  FROM game_level\n  GROUP BY \"shot_type\"\n)\nSELECT\n  c.\"shot_type\",\n  c.AVG_X,\n  c.AVG_Y,\n  g.AVG_ATTEMPTS,\n  g.AVG_SUCCESSES\nFROM coord_avgs c\nJOIN game_avgs g ON c.\"shot_type\" = g.\"shot_type\"\nORDER BY c.\"shot_type\";") t := by
