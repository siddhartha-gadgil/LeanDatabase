/-!
# sf_bq194 — crossskill equivalence(s)

Question: Among all Python (*.py), R (*.r, *.R, *.Rmd, *.rmd), and IPython notebook (*.ipynb) files in the GitHub sample dataset, which library or module is identified as the second most frequently imported or loaded based on the extracted import statements?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq194

CREATE TABLE SAMPLE_CONTENTS («id» STRING, «size» INT, «content» STRING, «binary» BOOL, «copies» INT, «sample_repo_name» STRING, «sample_ref» STRING, «sample_path» STRING, «sample_mode» INT, «sample_symlink_target» STRING)

HYPOTHESIS hyp0_1_0 : SAMPLE_CONTENTS "\"binary\" = FALSE"
HYPOTHESIS hyp0_1_1 : SAMPLE_CONTENTS "(\"sample_path\" LIKE '%.py' OR \"sample_path\" LIKE '%.ipynb')"
HYPOTHESIS hyp0_1_2 : SAMPLE_CONTENTS "(\"sample_path\" LIKE '%.r' OR \"sample_path\" LIKE '%.R' OR \"sample_path\" LIKE '%.Rmd' OR \"sample_path\" LIKE '%.rmd')"
theorem eq_0_1 (t : TableRel SAMPLE_CONTENTS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) :
    (sql%([SAMPLE_CONTENTS_schema]) "WITH python_import_lines AS (SELECT TRIM(line.VALUE) AS line_content FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS sc, LATERAL SPLIT_TO_TABLE(sc.\"content\", '\n') AS line WHERE sc.\"binary\" = FALSE AND (sc.\"sample_path\" LIKE '%.py' OR sc.\"sample_path\" LIKE '%.ipynb') AND (TRIM(line.VALUE) LIKE 'import %' OR TRIM(line.VALUE) LIKE 'from %import%')), parsed_python_imports AS (SELECT CASE WHEN line_content LIKE 'import %' AND NOT line_content LIKE 'from %' THEN TRIM(REGEXP_EXTRACT(line_content, 'import\\s+([a-zA-Z_][a-zA-Z0-9_.]*)', 1, 1, 'e', 1)) WHEN line_content LIKE 'from %import%' THEN TRIM(SPLIT_PART(SPLIT_PART(line_content, 'from ', 2), ' import', 1)) ELSE NULL END AS module_name FROM python_import_lines), r_import_lines AS (SELECT TRIM(line.VALUE) AS line_content FROM GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS AS sc, LATERAL SPLIT_TO_TABLE(sc.\"content\", '\n') AS line WHERE sc.\"binary\" = FALSE AND (sc.\"sample_path\" LIKE '%.r' OR sc.\"sample_path\" LIKE '%.R' OR sc.\"sample_path\" LIKE '%.Rmd' OR sc.\"sample_path\" LIKE '%.rmd') AND (TRIM(line.VALUE) LIKE '%library(%' OR TRIM(line.VALUE) LIKE '%require(%')), parsed_r_imports AS (SELECT REGEXP_EXTRACT(line_content, '(library|require)\\s*\\(\\s*[\\\"'']*([a-zA-Z0-9._]+)', 1, 1, 'e', 2) AS module_name FROM r_import_lines), all_imports AS (SELECT module_name FROM parsed_python_imports WHERE NOT module_name IS NULL AND module_name <> '' UNION ALL SELECT module_name FROM parsed_r_imports WHERE NOT module_name IS NULL AND module_name <> ''), import_counts AS (SELECT module_name AS LIBRARY_OR_MODULE, COUNT(*) AS TIMES_IMPORTED_OR_LOADED FROM all_imports GROUP BY module_name), ranked AS (SELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED, ROW_NUMBER() OVER (ORDER BY TIMES_IMPORTED_OR_LOADED DESC) AS rn FROM import_counts) SELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED FROM ranked WHERE rn = 2") t ~= (sql%([SAMPLE_CONTENTS_schema]) "WITH python_ipynb_imports AS (SELECT CAST(f.VALUE AS TEXT) AS lib FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS sc, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(sc.\"content\", 'import\\s+([a-zA-Z0-9_]+)', 1, 'ce', 1, 1)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE LOWER(sc.\"sample_path\") LIKE '%.py' OR LOWER(sc.\"sample_path\") LIKE '%.ipynb'), r_imports AS (SELECT CAST(f.VALUE AS TEXT) AS lib FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS sc, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(sc.\"content\", '(library|require)\\(([a-zA-Z0-9_]+)', 2, 'ce', 1, 1)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE LOWER(sc.\"sample_path\") LIKE '%.r' OR LOWER(sc.\"sample_path\") LIKE '%.rmd'), all_imports AS (SELECT lib FROM python_ipynb_imports UNION ALL SELECT lib FROM r_imports), ranked AS (SELECT lib AS LIBRARY_OR_MODULE, COUNT(*) AS TIMES_IMPORTED_OR_LOADED, ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn FROM all_imports GROUP BY lib) SELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED FROM ranked WHERE rn = 2") t := by
