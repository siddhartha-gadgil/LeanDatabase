RE REGEXP_LIKE(line, 'require\\\\([^)]+\\\\)')\n),\ntop_level AS (\n  SELECT TRIM(SPLIT_PART(raw_lib, '.', 1)) as library\n  FROM imports\n  WHERE raw_lib IS NOT NULL AND TRIM(raw_lib) != ''\n),\nranked AS (\n  SELECT library, COUNT(*) as num_imports,\n    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) as rn\n  FROM top_level\n  GROUP BY library\n)\nSELECT library as LIBRARY_OR_MODULE, num_imports as TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t := by
