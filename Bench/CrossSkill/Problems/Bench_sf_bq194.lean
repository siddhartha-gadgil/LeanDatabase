import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq194 — crossskill equivalence(s)

Question: Among all Python (*.py), R (*.r, *.R, *.Rmd, *.rmd), and IPython notebook (*.ipynb) files in the GitHub sample dataset, which library or module is identified as the second most frequently imported or loaded based on the extracted import statements?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq194

CREATE TABLE SAMPLE_CONTENTS («id» STRING, «size» INT, «content» STRING, «binary» BOOL, «copies» INT, «sample_repo_name» STRING, «sample_ref» STRING, «sample_path» STRING, «sample_mode» INT, «sample_symlink_target» STRING)

HYPOTHESIS hyp0_1_0 : SAMPLE_CONTENTS "\"binary\" = FALSE"
HYPOTHESIS hyp0_1_1 : SAMPLE_CONTENTS "(\n            \"sample_path\" LIKE '%.py'\n            OR \"sample_path\" LIKE '%.ipynb'\n        )"
HYPOTHESIS hyp0_1_2 : SAMPLE_CONTENTS "(\n            \"sample_path\" LIKE '%.r'\n            OR \"sample_path\" LIKE '%.R'\n            OR \"sample_path\" LIKE '%.Rmd'\n            OR \"sample_path\" LIKE '%.rmd'\n        )"
theorem eq_0_1 (t : TableRel SAMPLE_CONTENTS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) :
    (sql%([SAMPLE_CONTENTS_schema]) "WITH python_import_lines AS (\n    SELECT\n        TRIM(line.VALUE) AS line_content\n    FROM\n        GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc\n    , LATERAL SPLIT_TO_TABLE(sc.\"content\", '\\n') AS line\n    WHERE\n        sc.\"binary\" = FALSE\n        AND (\n            sc.\"sample_path\" LIKE '%.py'\n            OR sc.\"sample_path\" LIKE '%.ipynb'\n        )\n        AND (\n            TRIM(line.VALUE) LIKE 'import %'\n            OR TRIM(line.VALUE) LIKE 'from %import%'\n        )\n),\nparsed_python_imports AS (\n    SELECT\n        CASE\n            WHEN line_content LIKE 'import %' AND line_content NOT LIKE 'from %' THEN\n                TRIM(REGEXP_SUBSTR(line_content, 'import\\\\s+([a-zA-Z_][a-zA-Z0-9_.]*)', 1, 1, 'e', 1))\n            WHEN line_content LIKE 'from %import%' THEN\n                TRIM(SPLIT_PART(SPLIT_PART(line_content, 'from ', 2), ' import', 1))\n            ELSE NULL\n        END AS module_name\n    FROM python_import_lines\n),\n\nr_import_lines AS (\n    SELECT\n        TRIM(line.VALUE) AS line_content\n    FROM\n        GITHUB_REPOS.GITHUB_REPOS.SAMPLE_CONTENTS sc\n    , LATERAL SPLIT_TO_TABLE(sc.\"content\", '\\n') AS line\n    WHERE\n        sc.\"binary\" = FALSE\n        AND (\n            sc.\"sample_path\" LIKE '%.r'\n            OR sc.\"sample_path\" LIKE '%.R'\n            OR sc.\"sample_path\" LIKE '%.Rmd'\n            OR sc.\"sample_path\" LIKE '%.rmd'\n        )\n        AND (\n            TRIM(line.VALUE) LIKE '%library(%'\n            OR TRIM(line.VALUE) LIKE '%require(%'\n        )\n),\nparsed_r_imports AS (\n    SELECT\n        REGEXP_SUBSTR(line_content, '(library|require)\\\\s*\\\\(\\\\s*[\\\"'']*([a-zA-Z0-9._]+)', 1, 1, 'e', 2) AS module_name\n    FROM r_import_lines\n),\n\nall_imports AS (\n    SELECT module_name FROM parsed_python_imports\n    WHERE module_name IS NOT NULL AND module_name != ''\n    UNION ALL\n    SELECT module_name FROM parsed_r_imports\n    WHERE module_name IS NOT NULL AND module_name != ''\n),\n\nimport_counts AS (\n    SELECT\n        module_name AS LIBRARY_OR_MODULE,\n        COUNT(*) AS TIMES_IMPORTED_OR_LOADED\n    FROM all_imports\n    GROUP BY module_name\n),\n\nranked AS (\n    SELECT\n        LIBRARY_OR_MODULE,\n        TIMES_IMPORTED_OR_LOADED,\n        ROW_NUMBER() OVER (ORDER BY TIMES_IMPORTED_OR_LOADED DESC) AS rn\n    FROM import_counts\n)\n\nSELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t ~= (sql%([SAMPLE_CONTENTS_schema]) "WITH python_ipynb_imports AS (\n  SELECT f.VALUE::STRING AS lib\n  FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" sc,\n    LATERAL FLATTEN(input => REGEXP_SUBSTR_ALL(sc.\"content\", 'import\\\\s+([a-zA-Z0-9_]+)', 1, 1, 'ce', 1)) f\n  WHERE LOWER(sc.\"sample_path\") LIKE '%.py'\n     OR LOWER(sc.\"sample_path\") LIKE '%.ipynb'\n),\nr_imports AS (\n  SELECT f.VALUE::STRING AS lib\n  FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" sc,\n    LATERAL FLATTEN(input => REGEXP_SUBSTR_ALL(sc.\"content\", '(library|require)\\\\(([a-zA-Z0-9_]+)', 1, 1, 'ce', 2)) f\n  WHERE LOWER(sc.\"sample_path\") LIKE '%.r'\n     OR LOWER(sc.\"sample_path\") LIKE '%.rmd'\n),\nall_imports AS (\n  SELECT lib FROM python_ipynb_imports\n  UNION ALL\n  SELECT lib FROM r_imports\n),\nranked AS (\n  SELECT lib AS LIBRARY_OR_MODULE, COUNT(*) AS TIMES_IMPORTED_OR_LOADED,\n    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn\n  FROM all_imports\n  GROUP BY lib\n)\nSELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t := by
  first | sql_equiv | sorry

