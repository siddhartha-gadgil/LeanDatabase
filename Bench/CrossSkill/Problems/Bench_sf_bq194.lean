e IS NOT NULL AND module_name != ''\n),\n\nimport_counts AS (\n    SELECT\n        module_name AS LIBRARY_OR_MODULE,\n        COUNT(*) AS TIMES_IMPORTED_OR_LOADED\n    FROM all_imports\n    GROUP BY module_name\n),\n\nranked AS (\n    SELECT\n        LIBRARY_OR_MODULE,\n        TIMES_IMPORTED_OR_LOADED,\n        ROW_NUMBER() OVER (ORDER BY TIMES_IMPORTED_OR_LOADED DESC) AS rn\n    FROM import_counts\n)\n\nSELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t ~= (sql%([SAMPLE_CONTENTS_schema]) "WITH file_lines AS (\n  SELECT TRIM(f.value) AS line, c.\"sample_path\"\n  FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" c,\n  LATERAL FLATTEN(input => SPLIT(c.\"content\", '\\n')) f\n  WHERE (c.\"sample_path\" LIKE '%.py' \n     OR c.\"sample_path\" LIKE '%.ipynb'\n     OR LOWER(c.\"sample_path\") LIKE '%.r' \n     OR LOWER(c.\"sample_path\") LIKE '%.rmd')\n),\n-- Python/ipynb: 'import X' -> extract first module only (no comma expansion)\npy_import AS (\n  SELECT REGEXP_SUBSTR(line, '^import\\\\s+([A-Za-z_][A-Za-z0-9_]*)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE REGEXP_LIKE(line, 'import\\\\s+[A-Za-z_].*')\n  AND NOT REGEXP_LIKE(line, 'from\\\\s+.*')\n),\n-- Python/ipynb: 'from X.Y import Z' -> extract full dotted module path\npy_from AS (\n  SELECT REGEXP_SUBSTR(line, '^from\\\\s+([A-Za-z_][A-Za-z0-9_.]*)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE REGEXP_LIKE(line, 'from\\\\s+[A-Za-z_]\\\\S*\\\\s+import.*')\n),\n-- R: library(X)\nr_lib AS (\n  SELECT REGEXP_SUBSTR(line, 'library\\\\(\\\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd')\n  AND REGEXP_LIKE(line, '.*library\\\\(.*')\n),\n-- R: require(X)\nr_req AS (\n  SELECT REGEXP_SUBSTR(line, 'require\\\\(\\\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd')\n  AND REGEXP_LIKE(line, '.*require\\\\(.*')\n),\nall_imports AS (\n  SELECT lib FROM py_import UNION ALL\n  SELECT lib FROM py_from UNION ALL\n  SELECT lib FROM r_lib UNION ALL\n  SELECT lib FROM r_req\n),\nranked AS (\n  SELECT lib AS LIBRARY_OR_MODULE, \n         COUNT(*) AS TIMES_IMPORTED_OR_LOADED,\n         ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn\n  FROM all_imports\n  WHERE lib IS NOT NULL AND lib != ''\n  GROUP BY lib\n)\nSELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t := by
