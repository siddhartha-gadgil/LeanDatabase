theorem eq_2_3 : ∀ t,
    (sql%([SAMPLE_CONTENTS_schema]) "WITH file_lines AS (SELECT TRIM(f.value) AS line, c.\"sample_path\" FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS c, LATERAL UNNEST(input => SPLIT(c.\"content\", '\n')) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE (c.\"sample_path\" LIKE '%.py' OR c.\"sample_path\" LIKE '%.ipynb' OR LOWER(c.\"sample_path\") LIKE '%.r' OR LOWER(c.\"sample_path\") LIKE '%.rmd')), py_import /* Python/ipynb: 'import X' -> extract first module only (no comma expansion) */ AS (SELECT REGEXP_EXTRACT(line, '^import\\s+([A-Za-z_][A-Za-z0-9_]*)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE line ~ 'import\\s+[A-Za-z_].*' AND NOT line ~ 'from\\s+.*'), py_from /* Python/ipynb: 'from X.Y import Z' -> extract full dotted module path */ AS (SELECT REGEXP_EXTRACT(line, '^from\\s+([A-Za-z_][A-Za-z0-9_.]*)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE line ~ 'from\\s+[A-Za-z_]\\S*\\s+import.*'), r_lib /* R: library(X) */ AS (SELECT REGEXP_EXTRACT(line, 'library\\(\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd') AND line ~ '.*library\\(.*'), r_req /* R: require(X) */ AS (SELECT REGEXP_EXTRACT(line, 'require\\(\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd') AND line ~ '.*require\\(.*'), all_imports AS (SELECT lib FROM py_import UNION ALL SELECT lib FROM py_from UNION ALL SELECT lib FROM r_lib UNION ALL SELECT lib FROM r_req), ranked AS (SELECT lib AS LIBRARY_OR_MODULE, COUNT(*) AS TIMES_IMPORTED_OR_LOADED, ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn FROM all_imports WHERE NOT lib IS NULL AND lib <> '' GROUP BY lib) SELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED FROM ranked WHERE rn = 2") t ~= (sql%([SAMPLE_CONTENTS_schema]) "WITH raw_lines AS (SELECT \"sample_path\", \"sample_repo_name\", TRIM(CAST(f.value AS TEXT)) AS line FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\", LATERAL SPLIT_TO_TABLE(\"content\", '\n') AS f WHERE (\"sample_path\" LIKE '%.py' OR \"sample_path\" LIKE '%.ipynb' OR \"sample_path\" LIKE '%.r' OR \"sample_path\" LIKE '%.R' OR \"sample_path\" LIKE '%.Rmd' OR \"sample_path\" LIKE '%.rmd')), imports AS (/* Python: \"import X\" or \"import X, Y, Z\" - split by comma */ SELECT TRIM(SPLIT_PART(TRIM(CAST(s.value AS TEXT)), ' as ', 1)) AS raw_lib FROM raw_lines, LATERAL SPLIT_TO_TABLE(REGEXP_EXTRACT(line, '\\bimport\\s+(.+)$', 1, 1, 'e', 0), ',') AS s WHERE line ~ '\\bimport\\s+\\S+' AND NOT line ~ '\\bfrom\\s+\\S+\\s+import' UNION ALL /* Python: \"from X import Y\" */ SELECT REGEXP_EXTRACT(line, '\\bfrom\\s+(\\S+)\\s+import', 1, 1, 'e', 0) AS raw_lib FROM raw_lines WHERE line ~ '\\bfrom\\s+\\S+\\s+import' UNION ALL /* R: library(X) */ SELECT TRIM(REGEXP_EXTRACT(line, 'library\\(([^)]+)\\)', 1, 1, 'e', 0)) AS raw_lib FROM raw_lines WHERE line ~ 'library\\([^)]+\\)' UNION ALL /* R: require(X) */ SELECT TRIM(REGEXP_EXTRACT(line, 'require\\(([^)]+)\\)', 1, 1, 'e', 0)) AS raw_lib FROM raw_lines WHERE line ~ 'require\\([^)]+\\)'), top_level AS (SELECT TRIM(SPLIT_PART(raw_lib, '.', 1)) AS library FROM imports WHERE NOT raw_lib IS NULL AND TRIM(raw_lib) <> ''), ranked AS (SELECT library, COUNT(*) AS num_imports, ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn FROM top_level GROUP BY library) SELECT library AS LIBRARY_OR_MODULE, num_imports AS TIMES_IMPORTED_OR_LOADED FROM ranked WHERE rn = 2") t := by
  intro t; first | sql_equiv | sorry

end Bench_sf_bq194
