 \n  UNION ALL\n  \n  -- Python: \"from X import Y\"\n  SELECT \n    REGEXP_SUBSTR(line, '\\\\bfrom\\\\s+(\\\\S+)\\\\s+import', 1, 1, 'e') as raw_lib\n  FROM raw_lines\n  WHERE REGEXP_LIKE(line, '\\\\bfrom\\\\s+\\\\S+\\\\s+import')\n  \n  UNION ALL\n  \n  -- R: library(X)\n  SELECT \n    TRIM(REGEXP_SUBSTR(line, 'library\\\\(([^)]+)\\\\)', 1, 1, 'e')) as raw_lib\n  FROM raw_lines\n  WHERE REGEXP_LIKE(line, 'library\\\\([^)]+\\\\)')\n  \n  UNION ALL\n  \n  -- R: require(X)\n  SELECT \n    TRIM(REGEXP_SUBSTR(line, 'require\\\\(([^)]+)\\\\)', 1, 1, 'e')) as raw_lib\n  FROM raw_lines\n  WHERE REGEXP_LIKE(line, 'require\\\\([^)]+\\\\)')\n),\ntop_level AS (\n  SELECT TRIM(SPLIT_PART(raw_lib, '.', 1)) as library\n  FROM imports\n  WHERE raw_lib IS NOT NULL AND TRIM(raw_lib) != ''\n),\nranked AS (\n  SELECT library, COUNT(*) as num_imports,\n    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) as rn\n  FROM top_level\n  GROUP BY library\n)\nSELECT library as LIBRARY_OR_MODULE, num_imports as TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_2_3 : ∀ t,
    (sql%([SAMPLE_CONTENTS_schema]) "WITH file_lines AS (\n  SELECT TRIM(f.value) AS line, c.\"sample_path\"\n  FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" c,\n  LATERAL FLATTEN(input => SPLIT(c.\"content\", '\\n')) f\n  WHERE (c.\"sample_path\" LIKE '%.py' \n     OR c.\"sample_path\" LIKE '%.ipynb'\n     OR LOWER(c.\"sample_path\") LIKE '%.r' \n     OR LOWER(c.\"sample_path\") LIKE '%.rmd')\n),\n-- Python/ipynb: 'import X' -> extract first module only (no comma expansion)\npy_import AS (\n  SELECT REGEXP_SUBSTR(line, '^import\\\\s+([A-Za-z_][A-Za-z0-9_]*)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE REGEXP_LIKE(line, 'import\\\\s+[A-Za-z_].*')\n  AND NOT REGEXP_LIKE(line, 'from\\\\s+.*')\n),\n-- Python/ipynb: 'from X.Y import Z' -> extract full dotted module path\npy_from AS (\n  SELECT REGEXP_SUBSTR(line, '^from\\\\s+([A-Za-z_][A-Za-z0-9_.]*)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE REGEXP_LIKE(line, 'from\\\\s+[A-Za-z_]\\\\S*\\\\s+import.*')\n),\n-- R: library(X)\nr_lib AS (\n  SELECT REGEXP_SUBSTR(line, 'library\\\\(\\\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd')\n  AND REGEXP_LIKE(line, '.*library\\\\(.*')\n),\n-- R: require(X)\nr_req AS (\n  SELECT REGEXP_SUBSTR(line, 'require\\\\(\\\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e') AS lib\n  FROM file_lines\n  WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd')\n  AND REGEXP_LIKE(line, '.*require\\\\(.*')\n),\nall_imports AS (\n  SELECT lib FROM py_import UNION ALL\n  SELECT lib FROM py_from UNION ALL\n  SELECT lib FROM r_lib UNION ALL\n  SELECT lib FROM r_req\n),\nranked AS (\n  SELECT lib AS LIBRARY_OR_MODULE, \n         COUNT(*) AS TIMES_IMPORTED_OR_LOADED,\n         ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn\n  FROM all_imports\n  WHERE lib IS NOT NULL AND lib != ''\n  GROUP BY lib\n)\nSELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t ~= (sql%([SAMPLE_CONTENTS_schema]) "WITH raw_lines AS (\n  SELECT \n    \"sample_path\",\n    \"sample_repo_name\",\n    TRIM(f.value::STRING) as line\n  FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\",\n    LATERAL SPLIT_TO_TABLE(\"content\", '\\n') f\n  WHERE (\"sample_path\" LIKE '%.py' \n      OR \"sample_path\" LIKE '%.ipynb'\n      OR \"sample_path\" LIKE '%.r'\n      OR \"sample_path\" LIKE '%.R'\n      OR \"sample_path\" LIKE '%.Rmd'\n      OR \"sample_path\" LIKE '%.rmd')\n),\nimports AS (\n  -- Python: \"import X\" or \"import X, Y, Z\" - split by comma\n  SELECT \n    TRIM(SPLIT_PART(TRIM(s.value::STRING), ' as ', 1)) as raw_lib\n  FROM raw_lines,\n    LATERAL SPLIT_TO_TABLE(\n      REGEXP_SUBSTR(line, '\\\\bimport\\\\s+(.+)$', 1, 1, 'e'), \n      ','\n    ) s\n  WHERE REGEXP_LIKE(line, '\\\\bimport\\\\s+\\\\S+')\n  AND NOT REGEXP_LIKE(line, '\\\\bfrom\\\\s+\\\\S+\\\\s+import')\n  \n  UNION ALL\n  \n  -- Python: \"from X import Y\"\n  SELECT \n    REGEXP_SUBSTR(line, '\\\\bfrom\\\\s+(\\\\S+)\\\\s+import', 1, 1, 'e') as raw_lib\n  FROM raw_lines\n  WHERE REGEXP_LIKE(line, '\\\\bfrom\\\\s+\\\\S+\\\\s+import')\n  \n  UNION ALL\n  \n  -- R: library(X)\n  SELECT \n    TRIM(REGEXP_SUBSTR(line, 'library\\\\(([^)]+)\\\\)', 1, 1, 'e')) as raw_lib\n  FROM raw_lines\n  WHERE REGEXP_LIKE(line, 'library\\\\([^)]+\\\\)')\n  \n  UNION ALL\n  \n  -- R: require(X)\n  SELECT \n    TRIM(REGEXP_SUBSTR(line, 'require\\\\(([^)]+)\\\\)', 1, 1, 'e')) as raw_lib\n  FROM raw_lines\n  WHERE REGEXP_LIKE(line, 'require\\\\([^)]+\\\\)')\n),\ntop_level AS (\n  SELECT TRIM(SPLIT_PART(raw_lib, '.', 1)) as library\n  FROM imports\n  WHERE raw_lib IS NOT NULL AND TRIM(raw_lib) != ''\n),\nranked AS (\n  SELECT library, COUNT(*) as num_imports,\n    ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) as rn\n  FROM top_level\n  GROUP BY library\n)\nSELECT library as LIBRARY_OR_MODULE, num_imports as TIMES_IMPORTED_OR_LOADED\nFROM ranked\nWHERE rn = 2;") t := by
  intro t; first | sql_equiv | sorry

