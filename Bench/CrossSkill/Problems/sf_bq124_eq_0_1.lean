theorem eq (t0 : TableRel PATIENT_schema) (t1 : TableRel CONDITION_schema) (t2 : TableRel MEDICATION_REQUEST_schema) :
    (sql%([PATIENT_schema, CONDITION_schema, MEDICATION_REQUEST_schema]) "/* sf_bq124: Count alive patients with Diabetes or Hypertension diagnosis */ /* and at least 7 distinct active medications */ WITH alive_patients AS (SELECT \"id\" AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"PATIENT\" WHERE JSON_EXTRACT_PATH(\"deceased\", 'dateTime') IS NULL), diabetes_or_hypertension_patients AS (SELECT DISTINCT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"CONDITION\" WHERE CAST(JSON_EXTRACT_PATH(\"code\", 'coding', '0', 'display') AS TEXT) IN ('Diabetes', 'Hypertension')), patients_with_7_plus_active_meds AS (SELECT CAST(JSON_EXTRACT_PATH(\"subject\", 'patientId') AS TEXT) AS patient_id FROM \"FHIR_SYNTHEA\".\"FHIR_SYNTHEA\".\"MEDICATION_REQUEST\" WHERE \"status\" = 'active' GROUP BY patient_id HAVING COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(\"medication\", 'codeableConcept', 'coding', '0', 'code') AS TEXT)) >= 7) SELECT COUNT(*) AS OUTPUT FROM alive_patients AS a JOIN diabetes_or_hypertension_patients AS d ON a.patient_id = d.patient_id JOIN patients_with_7_plus_active_meds AS m ON a.patient_id = m.patient_id") t0 t1 t2
