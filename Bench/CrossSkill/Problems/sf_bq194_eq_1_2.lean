CREATE TABLE SAMPLE_CONTENTS («id» STRING, «size» INT, «content» STRING, «binary» BOOL, «copies» INT, «sample_repo_name» STRING, «sample_ref» STRING, «sample_path» STRING, «sample_mode» INT, «sample_symlink_target» STRING)

theorem eq (t0 : TableRel SAMPLE_CONTENTS_schema) :
    (sql%([SAMPLE_CONTENTS_schema]) "WITH python_ipynb_imports AS (SELECT CAST(f.VALUE AS TEXT) AS lib FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS sc, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(sc.\"content\", 'import\\s+([a-zA-Z0-9_]+)', 1, 'ce', 1, 1)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE LOWER(sc.\"sample_path\") LIKE '%.py' OR LOWER(sc.\"sample_path\") LIKE '%.ipynb'), r_imports AS (SELECT CAST(f.VALUE AS TEXT) AS lib FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS sc, LATERAL UNNEST(input => REGEXP_EXTRACT_ALL(sc.\"content\", '(library|require)\\(([a-zA-Z0-9_]+)', 2, 'ce', 1, 1)) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE LOWER(sc.\"sample_path\") LIKE '%.r' OR LOWER(sc.\"sample_path\") LIKE '%.rmd'), all_imports AS (SELECT lib FROM python_ipynb_imports UNION ALL SELECT lib FROM r_imports), ranked AS (SELECT lib AS LIBRARY_OR_MODULE, COUNT(*) AS TIMES_IMPORTED_OR_LOADED, ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn FROM all_imports GROUP BY lib) SELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED FROM ranked WHERE rn = 2") t0
  ~= (sql%([SAMPLE_CONTENTS_schema]) "WITH file_lines AS (SELECT TRIM(f.value) AS line, c.\"sample_path\" FROM \"GITHUB_REPOS\".\"GITHUB_REPOS\".\"SAMPLE_CONTENTS\" AS c, LATERAL UNNEST(input => SPLIT(c.\"content\", ' ')) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE (c.\"sample_path\" LIKE '%.py' OR c.\"sample_path\" LIKE '%.ipynb' OR LOWER(c.\"sample_path\") LIKE '%.r' OR LOWER(c.\"sample_path\") LIKE '%.rmd')), py_import /* Python/ipynb: 'import X' -> extract first module only (no comma expansion) */ AS (SELECT REGEXP_EXTRACT(line, '^import\\s+([A-Za-z_][A-Za-z0-9_]*)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE line ~ 'import\\s+[A-Za-z_].*' AND NOT line ~ 'from\\s+.*'), py_from /* Python/ipynb: 'from X.Y import Z' -> extract full dotted module path */ AS (SELECT REGEXP_EXTRACT(line, '^from\\s+([A-Za-z_][A-Za-z0-9_.]*)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE line ~ 'from\\s+[A-Za-z_]\\S*\\s+import.*'), r_lib /* R: library(X) */ AS (SELECT REGEXP_EXTRACT(line, 'library\\(\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd') AND line ~ '.*library\\(.*'), r_req /* R: require(X) */ AS (SELECT REGEXP_EXTRACT(line, 'require\\(\\s*[\\\"'']?([A-Za-z0-9_.]+)', 1, 1, 'e', 0) AS lib FROM file_lines WHERE (LOWER(\"sample_path\") LIKE '%.r' OR LOWER(\"sample_path\") LIKE '%.rmd') AND line ~ '.*require\\(.*'), all_imports AS (SELECT lib FROM py_import UNION ALL SELECT lib FROM py_from UNION ALL SELECT lib FROM r_lib UNION ALL SELECT lib FROM r_req), ranked AS (SELECT lib AS LIBRARY_OR_MODULE, COUNT(*) AS TIMES_IMPORTED_OR_LOADED, ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn FROM all_imports WHERE NOT lib IS NULL AND lib <> '' GROUP BY lib) SELECT LIBRARY_OR_MODULE, TIMES_IMPORTED_OR_LOADED FROM ranked WHERE rn = 2") t0
  := by first | sql_equiv | sorry

