theorem eq_0_1 : ∀ t,
    (sql%([HUD_PIT_BY_COC_schema]) "WITH state_totals AS (\n  SELECT\n    LEFT(\"CoC_Number\", 2) AS \"State_Abbr\",\n    SUM(CASE WHEN \"Count_Year\" = 2015 THEN COALESCE(\"Unsheltered_Homeless\", 0) ELSE 0 END) AS unsheltered_2015,\n    SUM(CASE WHEN \"Count_Year\" = 2018 THEN COALESCE(\"Unsheltered_Homeless\", 0) ELSE 0 END) AS unsheltered_2018\n  FROM \"SDOH\".\"SDOH_HUD_PIT_HOMELESSNESS\".\"HUD_PIT_BY_COC\"\n  WHERE \"Count_Year\" IN (2015, 2018)\n  GROUP BY LEFT(\"CoC_Number\", 2)\n  HAVING SUM(CASE WHEN \"Count_Year\" = 2015 THEN 1 ELSE 0 END) > 0\n     AND SUM(CASE WHEN \"Count_Year\" = 2018 THEN 1 ELSE 0 END) > 0\n),\npct_changes AS (\n  SELECT\n    \"State_Abbr\",\n    (unsheltered_2018 - unsheltered_2015) * 100.0 / unsheltered_2015 AS pct_change\n  FROM state_totals\n  WHERE unsheltered_2015 > 0\n),\nnational_avg AS (\n  SELECT AVG(pct_change) AS avg_pct_change\n  FROM pct_changes\n)\nSELECT p.\"State_Abbr\"\nFROM pct_changes p\nCROSS JOIN national_avg n\nORDER BY ABS(p.pct_change - n.avg_pct_change) ASC\nLIMIT 5;") t ~= (sql%([HUD_PIT_BY_COC_schema]) "WITH state_year AS (\n  SELECT\n    LEFT(\"CoC_Number\", 2) AS state,\n    \"Count_Year\",\n    SUM(\"Unsheltered_Homeless\") AS total_unsheltered\n  FROM \"SDOH\".\"SDOH_HUD_PIT_HOMELESSNESS\".\"HUD_PIT_BY_COC\"\n  WHERE \"Count_Year\" IN (2015, 2018)\n  GROUP BY LEFT(\"CoC_Number\", 2), \"Count_Year\"\n),\npivoted AS (\n  SELECT\n    state,\n    MAX(CASE WHEN \"Count_Year\" = 2015 THEN total_unsheltered END) AS unsheltered_2015,\n    MAX(CASE WHEN \"Count_Year\" = 2018 THEN total_unsheltered END) AS unsheltered_2018\n  FROM state_year\n  GROUP BY state\n),\npct_change AS (\n  SELECT\n    state,\n    (unsheltered_2018 - unsheltered_2015) * 100.0 / unsheltered_2015 AS pct_change\n  FROM pivoted\n  WHERE unsheltered_2015 > 0\n    AND unsheltered_2015 IS NOT NULL\n    AND unsheltered_2018 IS NOT NULL\n),\nnational_avg AS (\n  SELECT AVG(pct_change) AS avg_pct_change\n  FROM pct_change\n)\nSELECT\n  p.state AS \"State_Abbr\"\nFROM pct_change p\nCROSS JOIN national_avg n\nORDER BY ABS(p.pct_change - n.avg_pct_change) ASC\nLIMIT 5;") t := by
  intro t; first | sql_equiv | sorry

