uestion has tags directly) */ SELECT q.\"owner_user_id\" AS U_ID, q.\"tags\" AS TAGS FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q WHERE q.\"owner_user_id\" BETWEEN 16712208 AND 18712208 AND q.\"creation_date\" >= 1561939200000000 AND q.\"creation_date\" < 1577836800000000" := by
