theorem eq (t0 : TableRel LEAGUE_schema) (t1 : TableRel MATCH_schema) (t2 : TableRel TEAM_schema) :
    (sql%([LEAGUE_schema, MATCH_schema, TEAM_schema]) "WITH home_wins AS (SELECT \"league_id\", \"home_team_api_id\" AS team_id, COUNT(*) AS wins FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" WHERE \"home_team_goal\" > \"away_team_goal\" GROUP BY \"league_id\", \"home_team_api_id\"), away_wins AS (SELECT \"league_id\", \"away_team_api_id\" AS team_id, COUNT(*) AS wins FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" WHERE \"away_team_goal\" > \"home_team_goal\" GROUP BY \"league_id\", \"away_team_api_id\"), all_teams AS (SELECT DISTINCT \"league_id\", \"home_team_api_id\" AS team_id FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" UNION SELECT DISTINCT \"league_id\", \"away_team_api_id\" AS team_id FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"), total_wins AS (SELECT a.\"league_id\", a.team_id, COALESCE(hw.wins, 0) + COALESCE(aw.wins, 0) AS total_wins FROM all_teams AS a LEFT JOIN home_wins AS hw ON a.\"league_id\" = hw.\"league_id\" AND a.team_id = hw.team_id LEFT JOIN away_wins AS aw ON a.\"league_id\" = aw.\"league_id\" AND a.team_id = aw.team_id), ranked AS (SELECT tw.\"league_id\", tw.team_id, tw.total_wins, ROW_NUMBER() OVER (PARTITION BY tw.\"league_id\" ORDER BY tw.total_wins ASC, tw.team_id ASC) AS rn FROM total_wins AS tw) SELECT l.\"name\" AS LEAGUE_NAME, t.\"team_long_name\" AS TEAM_NAME, r.total_wins AS TOTAL_WINS FROM ranked AS r JOIN \"EU_SOCCER\".\"EU_SOCCER\".\"LEAGUE\" AS l ON r.\"league_id\" = l.\"id\" JOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" AS t ON r.team_id = t.\"team_api_id\" WHERE r.rn = 1 ORDER BY l.\"name\"") t0 t1 t2
  ~= (sql%([LEAGUE_schema, MATCH_schema, TEAM_schema]) "WITH all_teams_leagues AS (/* Get all distinct team/league combinations from MATCH (both home and away) */ SELECT DISTINCT \"league_id\", \"home_team_api_id\" AS \"team_api_id\" FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" UNION SELECT DISTINCT \"league_id\", \"away_team_api_id\" AS \"team_api_id\" FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\"), home_wins AS (SELECT \"league_id\", \"home_team_api_id\" AS \"team_api_id\", COUNT(*) AS \"wins\" FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" WHERE \"home_team_goal\" > \"away_team_goal\" GROUP BY \"league_id\", \"home_team_api_id\"), away_wins AS (SELECT \"league_id\", \"away_team_api_id\" AS \"team_api_id\", COUNT(*) AS \"wins\" FROM \"EU_SOCCER\".\"EU_SOCCER\".\"MATCH\" WHERE \"away_team_goal\" > \"home_team_goal\" GROUP BY \"league_id\", \"away_team_api_id\"), total_wins AS (SELECT atl.\"league_id\", atl.\"team_api_id\", COALESCE(hw.\"wins\", 0) + COALESCE(aw.\"wins\", 0) AS \"TOTAL_WINS\" FROM all_teams_leagues AS atl LEFT JOIN home_wins AS hw ON atl.\"league_id\" = hw.\"league_id\" AND atl.\"team_api_id\" = hw.\"team_api_id\" LEFT JOIN away_wins AS aw ON atl.\"league_id\" = aw.\"league_id\" AND atl.\"team_api_id\" = aw.\"team_api_id\"), ranked AS (SELECT tw.\"league_id\", tw.\"team_api_id\", tw.\"TOTAL_WINS\", ROW_NUMBER() OVER (PARTITION BY tw.\"league_id\" ORDER BY tw.\"TOTAL_WINS\" ASC, tw.\"team_api_id\" ASC) AS rn FROM total_wins AS tw) SELECT l.\"name\" AS \"LEAGUE_NAME\", t.\"team_long_name\" AS \"TEAM_NAME\", r.\"TOTAL_WINS\" FROM ranked AS r JOIN \"EU_SOCCER\".\"EU_SOCCER\".\"LEAGUE\" AS l ON r.\"league_id\" = l.\"id\" JOIN \"EU_SOCCER\".\"EU_SOCCER\".\"TEAM\" AS t ON r.\"team_api_id\" = t.\"team_api_id\" WHERE r.rn = 1 ORDER BY l.\"name\"") t0 t1 t2
