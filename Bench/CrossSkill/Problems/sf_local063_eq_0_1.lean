    (sql%([CUSTOMERS_schema, PRODUCTS_schema, TIMES_schema, SALES_schema]) "WITH growing_cities AS (/* Cities in the US with promo_id=999 that had >=20% sales increase Q4 2019 to Q4 2020 */ SELECT q4_19.\"cust_city\" FROM (SELECT cu.\"cust_city\", SUM(s.\"amount_sold\") AS sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS cu ON s.\"cust_id\" = cu.\"cust_id\" WHERE s.\"promo_id\" = 999 AND t.\"calendar_quarter_id\" = 1772 AND cu.\"country_id\" = 52790 GROUP BY cu.\"cust_city\") AS q4_19 JOIN (SELECT cu.\"cust_city\", SUM(s.\"amount_sold\") AS sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS cu ON s.\"cust_id\" = cu.\"cust_id\" WHERE s.\"promo_id\" = 999 AND t.\"calendar_quarter_id\" = 1776 AND cu.\"country_id\" = 52790 GROUP BY cu.\"cust_city\") AS q4_20 ON q4_19.\"cust_city\" = q4_20.\"cust_city\" WHERE CAST((q4_20.sales - q4_19.sales) AS DOUBLE PRECISION) / q4_19.sales >= 0.20), product_quarter_sales /* Product sales per quarter within qualifying cities */ AS (SELECT s.\"prod_id\", t.\"calendar_quarter_id\", SUM(s.\"amount_sold\") AS prod_sales FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" AS s JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" AS t ON s.\"time_id\" = t.\"time_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" AS cu ON s.\"cust_id\" = cu.\"cust_id\" WHERE s.\"promo_id\" = 999 AND t.\"calendar_quarter_id\" IN (1772, 1776) AND cu.\"country_id\" = 52790 AND cu.\"cust_city\" IN (SELECT \"cust_city\" FROM growing_cities) GROUP BY s.\"prod_id\", t.\"calendar_quarter_id\"), quarter_totals /* Total sales per quarter (denominator for share) */ AS (SELECT \"calendar_quarter_id\", SUM(prod_sales) AS total_sales FROM product_quarter_sales GROUP BY \"calendar_quarter_id\"), product_shares /* Product share in each quarter (as proportion 0-1) */ AS (SELECT pq.\"prod_id\", MAX(CASE WHEN pq.\"calendar_quarter_id\" = 1772 THEN CAST(pq.prod_sales AS DOUBLE PRECISION) / qt.total_sales END) AS SHARE_2019Q4, MAX(CASE WHEN pq.\"calendar_quarter_id\" = 1776 THEN CAST(pq.prod_sales AS DOUBLE PRECISION) / qt.total_sales END) AS SHARE_2020Q4 FROM product_quarter_sales AS pq JOIN quarter_totals AS qt ON pq.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\" GROUP BY pq.\"prod_id\"), product_ranked /* Product total sales for ranking (combined both quarters) */ AS (SELECT pq.\"prod_id\", SUM(pq.prod_sales) AS total_sales, NTILE(5) OVER (ORDER BY SUM(pq.prod_sales) DESC) AS ntile_rank FROM product_quarter_sales AS pq GROUP BY pq.\"prod_id\") SELECT pr.\"prod_id\", p.\"prod_name\", ABS(ps.SHARE_2020Q4 - ps.SHARE_2019Q4) AS PP_CHANGE, ps.SHARE_2019Q4, ps.SHARE_2020Q4 FROM product_ranked AS pr JOIN product_shares AS ps ON pr.\"prod_id\" = ps.\"prod_id\" JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON pr.\"prod_id\" = p.\"prod_id\" WHERE pr.ntile_rank = 1 AND NOT ps.SHARE_2019Q4 IS NULL AND NOT ps.SHARE_2020Q4 IS NULL ORDER BY PP_CHANGE ASC LIMIT 1") t0 t1 t2 t3
