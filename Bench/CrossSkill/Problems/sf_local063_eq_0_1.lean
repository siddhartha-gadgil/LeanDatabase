uarter_sales END) AS SHARE_2019Q4, MAX(CASE WHEN b.\"calendar_quarter_id\" = 1776 THEN CAST(b.prod_sales AS DOUBLE PRECISION) / qt.total_quarter_sales END) AS SHARE_2020Q4, SUM(b.prod_sales) AS total_sales FROM base_sales AS b JOIN quarter_totals AS qt ON b.\"calendar_quarter_id\" = qt.\"calendar_quarter_id\" GROUP BY b.\"prod_id\" HAVING NOT SHARE_2019Q4 IS NULL AND NOT SHARE_2020Q4 IS NULL), ranked AS (SELECT ps.\"prod_id\", p.\"prod_name\", ABS(ps.SHARE_2020Q4 - ps.SHARE_2019Q4) AS PP_CHANGE, ps.SHARE_2019Q4, ps.SHARE_2020Q4, PERCENT_RANK() OVER (ORDER BY ps.total_sales DESC) AS pct_rank FROM prod_shares AS ps JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PRODUCTS\" AS p ON ps.\"prod_id\" = p.\"prod_id\") SELECT \"prod_id\", \"prod_name\", PP_CHANGE, SHARE_2019Q4, SHARE_2020Q4 FROM ranked WHERE pct_rank < 0.20 ORDER BY PP_CHANGE ASC LIMIT 1") t0 t1 t2 t3
