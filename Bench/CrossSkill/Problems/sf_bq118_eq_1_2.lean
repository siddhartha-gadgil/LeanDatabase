theorem eq (t0 : TableRel DEATHRECORDS_schema) (t1 : TableRel AGERECODE12_schema) (t2 : TableRel RACE_schema) (t3 : TableRel ICD10CODE_schema) :
    (sql%([DEATHRECORDS_schema, AGERECODE12_schema, RACE_schema, ICD10CODE_schema]) "WITH discharge_by_age AS (SELECT d.\"AgeRecode12\" AS age_code, CAST(COUNT(*) AS DOUBLE PRECISION) / COUNT(DISTINCT d.\"Icd10Code\") AS avg_deaths FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS i ON d.\"Icd10Code\" = i.\"Code\" WHERE d.\"Race\" = 1 AND LOWER(i.\"Description\") LIKE '%discharge%' AND NOT LOWER(i.\"Description\") LIKE '%urethral discharge%' AND NOT LOWER(i.\"Description\") LIKE '%discharge of firework%' AND NOT LOWER(i.\"Description\") LIKE '%legal intervention involving firearm discharge%' GROUP BY d.\"AgeRecode12\"), vehicle_by_age AS (SELECT d.\"AgeRecode12\" AS age_code, CAST(COUNT(*) AS DOUBLE PRECISION) / COUNT(DISTINCT d.\"Icd10Code\") AS avg_deaths FROM \"DEATH\".\"DEATH\".\"DEATHRECORDS\" AS d JOIN \"DEATH\".\"DEATH\".\"ICD10CODE\" AS i ON d.\"Icd10Code\" = i.\"Code\" WHERE d.\"Race\" = 1 AND LOWER(i.\"Description\") LIKE '%vehicle%' GROUP BY d.\"AgeRecode12\") SELECT a.\"Description\" AS \"Age Group\", ROUND(dis.avg_deaths, 6) AS \"Avg Deaths - Discharge Codes\", ROUND(veh.avg_deaths, 6) AS \"Avg Deaths - Vehicle Codes\", ROUND(dis.avg_deaths - veh.avg_deaths, 6) AS \"Difference (Discharge - Vehicle)\" FROM discharge_by_age AS dis JOIN vehicle_by_age AS veh ON dis.age_code = veh.age_code JOIN \"DEATH\".\"DEATH\".\"AGERECODE12\" AS a ON dis.age_code = a.\"Code\" ORDER BY dis.age_code") t0 t1 t2 t3
