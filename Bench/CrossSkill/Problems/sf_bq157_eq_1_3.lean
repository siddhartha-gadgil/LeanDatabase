namespace N_sf_bq157_eq_1_3

CREATE TABLE EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED («ParticipantBarcode» STRING, «SampleBarcode» STRING, «AliquotBarcode» STRING, «SampleTypeLetterCode» STRING, «SampleType» STRING, «Study» STRING, «Symbol» STRING, «Entrez» STRING, «normalized_count» FLOAT)
CREATE TABLE MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE («ParticipantBarcode» STRING, «Tumor_SampleBarcode» STRING, «Tumor_AliquotBarcode» STRING, «Normal_SampleBarcode» STRING, «Normal_AliquotBarcode» STRING, «Normal_SampleTypeLetterCode» STRING, «Study» STRING, «Hugo_Symbol» STRING, «HGVSp_Short» STRING, «Variant_Classification» STRING, «HGVSc» STRING, «CENTERS» STRING, «FILTER» STRING)

theorem eq (t0 : TableRel EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema) (t1 : TableRel MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema) :
    (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "/* Welch's t-test for DRG2 gene expression between LGG patients with and without TP53 mutation */ /* Step 1: Get all MC3 LGG sample barcodes */ /* Step 2: Join to gene expression for DRG2 to get per-patient avg log10(normalized_count+1) */ /* Step 3: Split by TP53 mutation status */ /* Step 4: Compute Welch's t-test */ WITH mc3_samples AS (/* All distinct tumor sample barcodes for LGG patients in MC3 */ SELECT DISTINCT \"Tumor_SampleBarcode\", \"ParticipantBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG'), tp53_patients AS (/* LGG patients with TP53 mutation (FILTER='PASS') */ SELECT DISTINCT \"ParticipantBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG' AND \"Hugo_Symbol\" = 'TP53' AND \"FILTER\" = 'PASS'), drg2_expression AS (/* DRG2 gene expression for LGG samples that are present in MC3 */ SELECT g.\"ParticipantBarcode\", g.\"SampleBarcode\", LOG(10, g.\"normalized_count\" + 1) AS log_expr FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" AS g INNER JOIN mc3_samples AS m ON g.\"SampleBarcode\" = m.\"Tumor_SampleBarcode\" WHERE g.\"Study\" = 'LGG' AND g.\"Symbol\" = 'DRG2'), patient_avg_expr AS (/* Per-patient average DRG2 expression */ SELECT \"ParticipantBarcode\", AVG(log_expr) AS avg_log_expr FROM drg2_expression GROUP BY \"ParticipantBarcode\"), patient_groups AS (/* Tag each patient as Y (TP53 mutated) or N (not mutated) */ SELECT p.avg_log_expr, CASE WHEN NOT tp.\"ParticipantBarcode\" IS NULL THEN 'Y' ELSE 'N' END AS mutation_group FROM patient_avg_expr AS p LEFT JOIN tp53_patients AS tp ON p.\"ParticipantBarcode\" = tp.\"ParticipantBarcode\"), group_stats AS (/* Compute N, sum, sum of squares for each group */ SELECT mutation_group, COUNT(*) AS N, SUM(avg_log_expr) AS S, SUM(avg_log_expr * avg_log_expr) AS Q FROM patient_groups GROUP BY mutation_group), pivoted AS (/* Pivot to get Y and N stats side by side */ SELECT MAX(CASE WHEN mutation_group = 'Y' THEN N END) AS Ny, MAX(CASE WHEN mutation_group = 'N' THEN N END) AS Nn, MAX(CASE WHEN mutation_group = 'Y' THEN S END) AS Sy, MAX(CASE WHEN mutation_group = 'N' THEN S END) AS Sn, MAX(CASE WHEN mutation_group = 'Y' THEN Q END) AS Qy, MAX(CASE WHEN mutation_group = 'N' THEN Q END) AS Qn FROM group_stats) SELECT Ny AS NY, Nn AS NN, CAST(Sy AS DOUBLE PRECISION) / Ny AS AVG_Y, CAST(Sn AS DOUBLE PRECISION) / Nn AS AVG_N, CAST((CAST(Sy AS DOUBLE PRECISION) / Ny - CAST(Sn AS DOUBLE PRECISION) / Nn) /* Welch's t-test: t = (avg_y - avg_n) / sqrt(var_y/Ny + var_n/Nn) */ /* var = (Q - S^2/N) / (N - 1) */ AS DOUBLE PRECISION) / SQRT(CAST((CAST((Qy - (CAST(Sy * Sy AS DOUBLE PRECISION) / Ny)) AS DOUBLE PRECISION) / (Ny - 1)) AS DOUBLE PRECISION) / Ny + CAST((CAST((Qn - (CAST(Sn * Sn AS DOUBLE PRECISION) / Nn)) AS DOUBLE PRECISION) / (Nn - 1)) AS DOUBLE PRECISION) / Nn) AS TSCORE FROM pivoted") t0 t1
  ~= (sql%([EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED_schema, MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE_schema]) "/* Step 1: Get all distinct LGG patients from the MC3 mutation table */ /* Step 2: Get DRG2 expression for those patients, joining on ParticipantBarcode */ /* Step 3: For each patient, compute AVG(LOG10(normalized_count + 1)) */ /* Step 4: Identify TP53-mutated patients (Hugo_Symbol='TP53', FILTER='PASS', Study='LGG') */ /* Step 5: Split into two groups and compute Welch's T-test */ WITH lgg_patients /* All LGG patients present in MC3 table */ AS (SELECT DISTINCT \"ParticipantBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG'), tp53_mutated /* TP53-mutated LGG patients */ AS (SELECT DISTINCT \"ParticipantBarcode\" FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"MC3_MAF_V5_ONE_PER_TUMOR_SAMPLE\" WHERE \"Study\" = 'LGG' AND \"Hugo_Symbol\" = 'TP53' AND \"FILTER\" = 'PASS'), patient_expr /* DRG2 expression for LGG patients present in MC3, averaged per patient */ AS (SELECT e.\"ParticipantBarcode\", AVG(LOG(10, e.\"normalized_count\" + 1)) AS avg_log_expr FROM \"PANCANCER_ATLAS_1\".\"PANCANCER_ATLAS_FILTERED\".\"EBPP_ADJUSTPANCAN_ILLUMINAHISEQ_RNASEQV2_GENEXP_FILTERED\" AS e INNER JOIN lgg_patients AS lp ON e.\"ParticipantBarcode\" = lp.\"ParticipantBarcode\" WHERE e.\"Study\" = 'LGG' AND e.\"Symbol\" = 'DRG2' GROUP BY e.\"ParticipantBarcode\"), patient_tagged /* Tag each patient with TP53 mutation status */ AS (SELECT pe.\"ParticipantBarcode\", pe.avg_log_expr, CASE WHEN NOT tp.\"ParticipantBarcode\" IS NULL THEN 'Y' ELSE 'N' END AS has_tp53 FROM patient_expr AS pe LEFT JOIN tp53_mutated AS tp ON pe.\"ParticipantBarcode\" = tp.\"ParticipantBarcode\"), group_stats /* Compute group statistics */ AS (SELECT has_tp53, COUNT(*) AS n, AVG(avg_log_expr) AS mean_val, VAR_SAMP(avg_log_expr) AS var_val FROM patient_tagged GROUP BY has_tp53), stats_y /* Pivot to get Y and N stats side by side */ AS (SELECT n AS n_y, mean_val AS avg_y, var_val AS var_y FROM group_stats WHERE has_tp53 = 'Y'), stats_n AS (SELECT n AS n_n, mean_val AS avg_n, var_val AS var_n FROM group_stats WHERE has_tp53 = 'N') SELECT sy.n_y AS NY, sn.n_n AS NN, sy.avg_y AS AVG_Y, sn.avg_n AS AVG_N, CAST((sy.avg_y - sn.avg_n) AS DOUBLE PRECISION) / SQRT(CAST(sy.var_y AS DOUBLE PRECISION) / sy.n_y + CAST(sn.var_n AS DOUBLE PRECISION) / sn.n_n) AS TSCORE FROM stats_y AS sy, stats_n AS sn") t0 t1
