theorem eq (t0 : TableRel PIZZA_NAMES_schema) (t1 : TableRel PIZZA_RECIPES_schema) (t2 : TableRel PIZZA_CLEAN_CUSTOMER_ORDERS_schema) (t3 : TableRel PIZZA_TOPPINGS_schema) :
    (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (SELECT ROW_NUMBER() OVER (ORDER BY \"order_id\", \"pizza_id\", \"exclusions\", \"extras\") AS row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\", \"order_time\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"), recipe_flat /* Flatten the recipe toppings for each pizza */ AS (SELECT \"pizza_id\", TRIM(CAST(t.VALUE AS TEXT)) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\", LATERAL SPLIT_TO_TABLE(\"toppings\", ',') AS t), order_base_toppings /* For each order row, get base toppings from recipe */ AS (SELECT o.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", o.\"exclusions\", o.\"extras\", o.\"order_time\", CAST(r.topping_id AS DECIMAL(38, 0)) AS topping_id FROM numbered_orders AS o JOIN recipe_flat AS r ON o.\"pizza_id\" = r.\"pizza_id\"), exclusions_flat /* Parse exclusions per order row */ AS (SELECT o.row_id, CAST(TRIM(CAST(e.VALUE AS TEXT)) AS DECIMAL(38, 0)) AS excluded_topping_id FROM numbered_orders AS o, LATERAL SPLIT_TO_TABLE(CASE WHEN NOT o.\"exclusions\" IS NULL AND o.\"exclusions\" <> '' THEN o.\"exclusions\" ELSE NULL END, ',') AS e WHERE NOT o.\"exclusions\" IS NULL AND o.\"exclusions\" <> ''), extras_flat /* Parse extras per order row */ AS (SELECT o.row_id, CAST(TRIM(CAST(x.VALUE AS TEXT)) AS DECIMAL(38, 0)) AS extra_topping_id FROM numbered_orders AS o, LATERAL SPLIT_TO_TABLE(CASE WHEN NOT o.\"extras\" IS NULL AND o.\"extras\" <> '' THEN o.\"extras\" ELSE NULL END, ',') AS x WHERE NOT o.\"extras\" IS NULL AND o.\"extras\" <> ''), base_after_exclusions /* Remove excluded toppings from base */ AS (SELECT bt.row_id, bt.\"order_id\", bt.\"customer_id\", bt.\"pizza_id\", bt.\"order_time\", bt.topping_id FROM order_base_toppings AS bt LEFT JOIN exclusions_flat AS ef ON bt.row_id = ef.row_id AND bt.topping_id = ef.excluded_topping_id WHERE ef.excluded_topping_id IS NULL), all_toppings /* Combine base toppings (after exclusions) and extras */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", topping_id, 'base' AS source FROM base_after_exclusions UNION ALL SELECT ef.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", o.\"order_time\", ef.extra_topping_id AS topping_id, 'extra' AS source FROM extras_flat AS ef JOIN numbered_orders AS o ON ef.row_id = o.row_id), topping_counts /* Count occurrences per topping per order row */ AS (SELECT at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"order_time\", at2.topping_id, t.\"topping_name\", COUNT(*) AS cnt FROM all_toppings AS at2 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON at2.topping_id = t.\"topping_id\" GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.\"order_time\", at2.topping_id, t.\"topping_name\"), formatted_toppings /* Format each topping with 2x prefix if needed, and add sort keys */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", CASE WHEN cnt > 1 THEN cnt || 'x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name, cnt, \"topping_name\" FROM topping_counts), ordered_toppings /* Order toppings: 2x first (alphabetically), then single (alphabetically) */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", formatted_name, ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY CASE WHEN cnt > 1 THEN 0 ELSE 1 END, \"topping_name\") AS rn FROM formatted_toppings), aggregated /* Aggregate into comma-separated string */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\", STRING_AGG(formatted_name, ', ' ORDER BY CASE WHEN rn = rn THEN 0 END, rn) AS ingredients_list FROM ordered_toppings GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"order_time\") SELECT a.row_id AS \"ROW_ID\", a.\"order_id\" AS \"ORDER_ID\", a.\"customer_id\" AS \"CUSTOMER_ID\", CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END AS \"PIZZA_NAME\", CASE WHEN a.\"pizza_id\" = 1 THEN 'Meatlovers' ELSE 'Vegetarian' END || ': ' || a.ingredients_list AS \"FINAL_INGREDIENTS\" FROM aggregated AS a ORDER BY a.row_id") t0 t1 t2 t3
  ~= (sql%([PIZZA_NAMES_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH numbered_orders AS (SELECT ROW_NUMBER() OVER (ORDER BY \"order_id\", \"customer_id\", \"pizza_id\") AS row_id, ROW_NUMBER() OVER (PARTITION BY \"order_id\" ORDER BY \"customer_id\", \"pizza_id\") AS order_row_id, \"order_id\", \"customer_id\", \"pizza_id\", \"exclusions\", \"extras\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\"), recipe_toppings /* Split recipe toppings into individual rows */ AS (SELECT \"pizza_id\", CAST(TRIM(CAST(t.VALUE AS TEXT)) AS INT) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\", LATERAL SPLIT_TO_TABLE(\"toppings\", ',') AS t), order_exclusions /* Split exclusions from the customer orders into individual topping_ids */ AS (SELECT o.row_id, CAST(TRIM(CAST(e.VALUE AS TEXT)) AS INT) AS topping_id FROM numbered_orders AS o, LATERAL SPLIT_TO_TABLE(o.\"exclusions\", ',') AS e WHERE NOT o.\"exclusions\" IS NULL AND o.\"exclusions\" <> ''), order_extras /* Split extras from the customer orders into individual topping_ids */ AS (SELECT o.row_id, CAST(TRIM(CAST(x.VALUE AS TEXT)) AS INT) AS topping_id FROM numbered_orders AS o, LATERAL SPLIT_TO_TABLE(o.\"extras\", ',') AS x WHERE NOT o.\"extras\" IS NULL AND o.\"extras\" <> ''), order_base_toppings /* For each order, get the base recipe toppings */ AS (SELECT o.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", rt.topping_id FROM numbered_orders AS o JOIN recipe_toppings AS rt ON o.\"pizza_id\" = rt.\"pizza_id\"), after_exclusions /* Remove exclusions from base toppings */ AS (SELECT bt.row_id, bt.\"order_id\", bt.\"customer_id\", bt.\"pizza_id\", bt.topping_id FROM order_base_toppings AS bt WHERE NOT EXISTS(SELECT 1 FROM order_exclusions AS ex WHERE ex.row_id = bt.row_id AND ex.topping_id = bt.topping_id)), all_toppings /* Combine: base toppings (after exclusions) + extras */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", topping_id FROM after_exclusions UNION ALL SELECT oe.row_id, o.\"order_id\", o.\"customer_id\", o.\"pizza_id\", oe.topping_id FROM order_extras AS oe JOIN numbered_orders AS o ON oe.row_id = o.row_id), topping_counts /* Count toppings per order row */ AS (SELECT at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.topping_id, pt.\"topping_name\", COUNT(*) AS cnt FROM all_toppings AS at2 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS pt ON at2.topping_id = pt.\"topping_id\" GROUP BY at2.row_id, at2.\"order_id\", at2.\"customer_id\", at2.\"pizza_id\", at2.topping_id, pt.\"topping_name\"), formatted_toppings /* Format topping names with 2x prefix if needed, and sort: 2x first (alphabetically), then 1x (alphabetically) */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", CASE WHEN cnt > 1 THEN '2x ' || \"topping_name\" ELSE \"topping_name\" END AS formatted_name, CASE WHEN cnt > 1 THEN 0 ELSE 1 END AS sort_group, \"topping_name\" FROM topping_counts), agg_toppings /* Aggregate toppings into comma-separated string per order row */ AS (SELECT row_id, \"order_id\", \"customer_id\", \"pizza_id\", STRING_AGG(formatted_name, ', ' ORDER BY sort_group, \"topping_name\") AS ingredients_list FROM formatted_toppings GROUP BY row_id, \"order_id\", \"customer_id\", \"pizza_id\") SELECT at3.row_id AS \"ROW_ID\", at3.\"order_id\" AS \"ORDER_ID\", at3.\"customer_id\" AS \"CUSTOMER_ID\", pn.\"pizza_name\" AS \"PIZZA_NAME\", pn.\"pizza_name\" || ': ' || at3.ingredients_list AS \"FINAL_INGREDIENTS\" FROM agg_toppings AS at3 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_NAMES\" AS pn ON at3.\"pizza_id\" = pn.\"pizza_id\" ORDER BY at3.row_id") t0 t1 t2 t3
