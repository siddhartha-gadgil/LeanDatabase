/-!
# sf_bq131 — crossskill equivalence(s)

Question: What is the number of bus stops for the bus network with the most stops within the multipolygon boundary of Denmark (as defined by Wikidata ID 'Q35'), analyzed through planet features?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq131

CREATE TABLE PLANET_FEATURES («feature_type» STRING, «osm_id» INT, «osm_way_id» INT, «osm_version» INT, «osm_timestamp» INT, «all_tags» STRING, «geometry» STRING)
CREATE TABLE PLANET_FEATURES_POINTS («osm_id» INT, «osm_version» INT, «osm_way_id» INT, «osm_timestamp» INT, «geometry» STRING, «all_tags» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([PLANET_FEATURES_schema, PLANET_FEATURES_POINTS_schema]) "WITH denmark AS (SELECT ST_COLLECT(CAST(\"geometry\" AS GEOGRAPHY)) AS geom FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" AS pf, LATERAL UNNEST(input => pf.\"all_tags\") AS tag(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE pf.\"feature_type\" = 'multipolygons' AND CAST(JSON_EXTRACT_PATH(tag.value, 'key') AS TEXT) = 'wikidata' AND CAST(JSON_EXTRACT_PATH(tag.value, 'value') AS TEXT) = 'Q35'), bus_stops_in_denmark AS (SELECT pp.\"osm_id\", pp.\"all_tags\" FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES_POINTS\" AS pp, LATERAL UNNEST(input => pp.\"all_tags\") AS f_hw(SEQ, KEY, PATH, INDEX, VALUE, THIS), denmark AS d WHERE CAST(JSON_EXTRACT_PATH(f_hw.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(f_hw.value, 'value') AS TEXT) = 'bus_stop' AND ST_INTERSECTS(d.geom, CAST(pp.\"geometry\" AS GEOGRAPHY))), bus_stops_with_network AS (SELECT bs.\"osm_id\", CAST(JSON_EXTRACT_PATH(f_net.value, 'value') AS TEXT) AS network FROM bus_stops_in_denmark AS bs, LATERAL UNNEST(input => bs.\"all_tags\") AS f_net(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(f_net.value, 'key') AS TEXT) = 'network') SELECT network, COUNT(*) AS bus_stop_count FROM bus_stops_with_network GROUP BY network ORDER BY bus_stop_count DESC") t ~= (sql%([PLANET_FEATURES_schema, PLANET_FEATURES_POINTS_schema]) "WITH denmark AS (SELECT CAST(\"geometry\" AS GEOGRAPHY) AS geo FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" WHERE \"osm_id\" = 50046), bus_stops_with_network AS (SELECT bs.\"osm_id\", CAST(JSON_EXTRACT_PATH(nw.value, 'value') AS TEXT) AS network FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES_POINTS\" AS bs, denmark AS dk, LATERAL UNNEST(input => bs.\"all_tags\") AS nw(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(bs.\"all_tags\" AS VARCHAR) LIKE '%bus_stop%' AND CAST(bs.\"all_tags\" AS VARCHAR) LIKE '%highway%' AND CAST(bs.\"all_tags\" AS VARCHAR) LIKE '%\"network\"%' AND CAST(JSON_EXTRACT_PATH(nw.value, 'key') AS TEXT) = 'network' AND ST_DWITHIN(CAST(bs.\"geometry\" AS GEOGRAPHY), dk.geo, 0)) SELECT network, COUNT(DISTINCT \"osm_id\") AS bus_stop_count FROM bus_stops_with_network GROUP BY network ORDER BY bus_stop_count DESC") t := by
