/-!
# sf_bq131 — crossskill equivalence(s)

Question: What is the number of bus stops for the bus network with the most stops within the multipolygon boundary of Denmark (as defined by Wikidata ID 'Q35'), analyzed through planet features?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq131

CREATE TABLE PLANET_FEATURES («feature_type» STRING, «osm_id» INT, «osm_way_id» INT, «osm_version» INT, «osm_timestamp» INT, «all_tags» STRING, «geometry» STRING)
CREATE TABLE PLANET_FEATURES_POINTS («osm_id» INT, «osm_version» INT, «osm_way_id» INT, «osm_timestamp» INT, «geometry» STRING, «all_tags» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([PLANET_FEATURES_schema, PLANET_FEATURES_POINTS_schema]) "WITH denmark AS (\n  SELECT ST_COLLECT(TO_GEOGRAPHY(\"geometry\")) AS geom\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\" pf,\n  LATERAL FLATTEN(input => pf.\"all_tags\") tag\n  WHERE pf.\"feature_type\" = 'multipolygons'\n  AND tag.value:\"key\"::STRING = 'wikidata'\n  AND tag.value:\"value\"::STRING = 'Q35'\n),\nbus_stops_in_denmark AS (\n  SELECT pp.\"osm_id\", pp.\"all_tags\"\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES_POINTS\" pp,\n  LATERAL FLATTEN(input => pp.\"all_tags\") f_hw,\n  denmark d\n  WHERE f_hw.value:\"key\"::STRING = 'highway'\n  AND f_hw.value:\"value\"::STRING = 'bus_stop'\n  AND ST_INTERSECTS(d.geom, TO_GEOGRAPHY(pp.\"geometry\"))\n),\nbus_stops_with_network AS (\n  SELECT \n    bs.\"osm_id\",\n    f_net.value:\"value\"::STRING AS network\n  FROM bus_stops_in_denmark bs,\n  LATERAL FLATTEN(input => bs.\"all_tags\") f_net\n  WHERE f_net.value:\"key\"::STRING = 'network'\n)\nSELECT \n  network,\n  COUNT(*) AS bus_stop_count\nFROM bus_stops_with_network\nGROUP BY network\nORDER BY bus_stop_count DESC;") t ~= (sql%([PLANET_FEATURES_schema, PLANET_FEATURES_POINTS_schema]) "WITH denmark AS (\n  SELECT TO_GEOGRAPHY(\"geometry\") AS geo\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES\"\n  WHERE \"osm_id\" = 50046\n),\nbus_stops_with_network AS (\n  SELECT\n    bs.\"osm_id\",\n    nw.value:value::STRING AS network\n  FROM \"GEO_OPENSTREETMAP\".\"GEO_OPENSTREETMAP\".\"PLANET_FEATURES_POINTS\" bs,\n       denmark dk,\n       LATERAL FLATTEN(input => bs.\"all_tags\") nw\n  WHERE bs.\"all_tags\"::VARCHAR LIKE '%bus_stop%'\n    AND bs.\"all_tags\"::VARCHAR LIKE '%highway%'\n    AND bs.\"all_tags\"::VARCHAR LIKE '%\"network\"%'\n    AND nw.value:key::STRING = 'network'\n    AND ST_DWITHIN(TO_GEOGRAPHY(bs.\"geometry\"), dk.geo, 0)\n)\nSELECT\n  network,\n  COUNT(DISTINCT \"osm_id\") AS bus_stop_count\nFROM bus_stops_with_network\nGROUP BY network\nORDER BY bus_stop_count DESC;") t := by
  intro t; first | sql_equiv | sorry

