HYPOTHESIS hyp0_1_0 : HURRICANES "\"season\" = '2020'"
theorem eq_0_1 (t : TableRel HURRICANES_schema) (h0 : hyp0_1_0 t) :
    (sql%([HURRICANES_schema]) "WITH hurricane_sids AS (/* Identify storms that reached hurricane status (usa_status = 'HU') in 2020 North Atlantic */ SELECT DISTINCT \"sid\" FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" WHERE \"season\" = '2020' AND \"basin\" = 'NA' AND \"usa_status\" = 'HU'), track_with_segments AS (/* Get all track points for those hurricanes with segment distances */ SELECT h.\"sid\", h.\"iso_time\", h.\"latitude\", h.\"longitude\", h.\"usa_wind\", LAG(h.\"latitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lat, LAG(h.\"longitude\") OVER (PARTITION BY h.\"sid\" ORDER BY h.\"iso_time\") AS prev_lon FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" AS h INNER JOIN hurricane_sids AS hs ON h.\"sid\" = hs.\"sid\"), track_with_distance AS (SELECT \"sid\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\", CASE WHEN NOT prev_lat IS NULL THEN CAST(ST_DISTANCE(ST_POINT(\"longitude\", \"latitude\"), ST_POINT(prev_lon, prev_lat)) AS DOUBLE PRECISION) / 1000.0 ELSE NULL END AS segment_km FROM track_with_segments), total_distances AS (/* Total travel distance per storm */ SELECT \"sid\", SUM(COALESCE(segment_km, 0)) AS total_distance_km FROM track_with_distance GROUP BY \"sid\"), ranked AS (/* Rank storms by total distance descending */ SELECT \"sid\", total_distance_km, ROW_NUMBER() OVER (ORDER BY total_distance_km DESC) AS rn FROM total_distances), third_longest AS (/* Get the third longest */ SELECT \"sid\" FROM ranked WHERE rn = 3) /* Output the track with cumulative distance and wind for the third longest hurricane */ SELECT ST_ASTEXT(ST_POINT(td.\"longitude\", td.\"latitude\")) AS \"GEOM\", CASE WHEN td.segment_km IS NULL THEN NULL ELSE SUM(COALESCE(td.segment_km, 0)) OVER (PARTITION BY td.\"sid\" ORDER BY td.\"iso_time\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) END AS \"CUMULATIVE_DISTANCE\", td.\"usa_wind\" FROM track_with_distance AS td INNER JOIN third_longest AS tl ON td.\"sid\" = tl.\"sid\" ORDER BY td.\"iso_time\"") t ~= (sql%([HURRICANES_schema]) "WITH storm_distances AS (SELECT \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\", LAG(\"latitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lat, LAG(\"longitude\") OVER (PARTITION BY \"sid\" ORDER BY \"iso_time\") AS prev_lon FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" WHERE \"basin\" = 'NA' AND \"season\" = '2020'), storm_segments AS (SELECT \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\", CASE WHEN NOT prev_lat IS NULL THEN CAST(ST_DISTANCE(ST_POINT(\"longitude\", \"latitude\"), ST_POINT(prev_lon, prev_lat)) AS DOUBLE PRECISION) / 1000 ELSE 0 END AS segment_km FROM storm_distances), storm_totals AS (SELECT \"sid\", \"name\", SUM(segment_km) AS total_distance_km FROM storm_segments GROUP BY \"sid\", \"name\"), ranked AS (SELECT \"sid\", \"name\", total_distance_km, ROW_NUMBER() OVER (ORDER BY total_distance_km DESC) AS rnk FROM storm_totals), third_storm AS (SELECT \"sid\" FROM ranked WHERE rnk = 3), third_storm_data AS (SELECT \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\", LAG(\"latitude\") OVER (ORDER BY \"iso_time\") AS prev_lat, LAG(\"longitude\") OVER (ORDER BY \"iso_time\") AS prev_lon FROM \"NOAA_DATA\".\"NOAA_HURRICANES\".\"HURRICANES\" WHERE \"sid\" = (SELECT \"sid\" FROM third_storm)), third_storm_segments AS (SELECT \"sid\", \"name\", \"iso_time\", \"latitude\", \"longitude\", \"usa_wind\", CASE WHEN NOT prev_lat IS NULL THEN CAST(ST_DISTANCE(ST_POINT(\"longitude\", \"latitude\"), ST_POINT(prev_lon, prev_lat)) AS DOUBLE PRECISION) / 1000 ELSE NULL END AS segment_km FROM third_storm_data) SELECT ST_POINT(\"longitude\", \"latitude\") AS GEOM, SUM(segment_km) OVER (ORDER BY \"iso_time\" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CUMULATIVE_DISTANCE, \"usa_wind\" FROM third_storm_segments ORDER BY \"iso_time\"") t := by
