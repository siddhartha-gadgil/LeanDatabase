import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq302 — crossskill equivalence(s)

Question: What is the monthly proportion of Stack Overflow questions tagged with 'python' in the year 2022?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq302

CREATE TABLE TAGS («id» INT, «tag_name» STRING, «count» INT, «excerpt_post_id» INT, «wiki_post_id» INT)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

theorem eq_0_1 : ∀ t,
    (sql%([TAGS_schema, POSTS_QUESTIONS_schema]) "SELECT\n  CAST(EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) AS INT) * 100 \n    + CAST(EXTRACT(MONTH FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) AS INT) AS MONTH_INDEX,\n  ROUND(\n    SUM(\n      CASE \n        WHEN \"tags\" = 'python' \n          OR \"tags\" LIKE 'python|%' \n          OR \"tags\" LIKE '%|python|%' \n          OR \"tags\" LIKE '%|python' \n        THEN 1 \n        ELSE 0 \n      END\n    ) * 1.0 / COUNT(*),\n    6\n  ) AS PROPORTION\nFROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\"\nWHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) = 2022\nGROUP BY MONTH_INDEX\nORDER BY MONTH_INDEX;") t ~= (sql%([TAGS_schema, POSTS_QUESTIONS_schema]) "SELECT \n  EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) * 100 \n    + EXTRACT(MONTH FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) AS MONTH_INDEX,\n  ROUND(\n    SUM(\n      CASE \n        WHEN \"tags\" = 'python' \n          OR \"tags\" LIKE 'python|%' \n          OR \"tags\" LIKE '%|python' \n          OR \"tags\" LIKE '%|python|%' \n        THEN 1 \n        ELSE 0 \n      END\n    ) * 1.0 / COUNT(*), \n    6\n  ) AS PROPORTION\nFROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\"\nWHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) = 2022\nGROUP BY MONTH_INDEX\nORDER BY MONTH_INDEX;") t := by
  intro t; first | sql_equiv | sorry

