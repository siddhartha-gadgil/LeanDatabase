CREATE TABLE CLINICAL («program_name» STRING, «case_barcode» STRING, «case_gdc_id» STRING, «program_dbgap_accession_number» STRING, «project_short_name» STRING, «project_name» STRING, «disease_code» STRING, «gender» STRING, «vital_status» STRING, «race» STRING, «ethnicity» STRING, «age_at_diagnosis» INT, «days_to_birth» INT, «days_to_death» INT, «days_to_initial_pathologic_diagnosis» INT, «days_to_last_followup» INT, «days_to_last_known_alive» INT, «days_to_submitted_specimen_dx» INT, «clinical_stage» STRING, «clinical_T» STRING, «clinical_N» STRING, «clinical_M» STRING, «pathologic_stage» STRING, «pathologic_T» STRING, «pathologic_N» STRING, «pathologic_M» STRING, «year_of_initial_pathologic_diagnosis» INT, «tumor_tissue_site» STRING, «primary_neoplasm_melanoma_dx» STRING, «anatomic_neoplasm_subdivision» STRING, «country» STRING, «other_dx» STRING, «other_malignancy_anatomic_site» STRING, «other_malignancy_type» STRING, «other_malignancy_histological_type» STRING, «history_of_neoadjuvant_treatment» STRING, «primary_therapy_outcome_success» STRING, «histological_type» STRING, «neoplasm_histologic_grade» STRING, «icd_10» STRING, «icd_o_3_site» STRING, «icd_o_3_histology» STRING, «person_neoplasm_cancer_status» STRING, «residual_tumor» STRING, «tumor_type» STRING, «new_tumor_event_after_initial_treatment» STRING, «lymphnodes_examined» STRING, «number_of_lymphnodes_examined» INT, «number_of_lymphnodes_positive_by_he» INT, «lymphatic_invasion» STRING, «venous_invasion» STRING, «lymphovascular_invasion_present» STRING, «bcr» STRING, «batch_number» INT, «tss_code» STRING, «age_began_smoking_in_years» INT, «year_of_tobacco_smoking_onset» INT, «stopped_smoking_year» INT, «tobacco_smoking_history» INT, «number_pack_years_smoked» FLOAT, «height» FLOAT, «weight» FLOAT, «bmi» FLOAT, «mononucleotide_and_dinucleotide_marker_panel_analysis_status» STRING, «menopause_status» STRING, «pregnancies» STRING, «hpv_status» STRING, «hpv_calls» STRING, «h_pylori_infection» STRING, «gleason_score_combined» INT, «psa_value» FLOAT, «colorectal_cancer» STRING, «history_of_colon_polyps» STRING)
CREATE TABLE RNASEQ_GENE_EXPRESSION («project_short_name» STRING, «case_barcode» STRING, «sample_barcode» STRING, «aliquot_barcode» STRING, «gene_name» STRING, «gene_type» STRING, «Ensembl_gene_id» STRING, «Ensembl_gene_id_v» STRING, «HTSeq__Counts» INT, «HTSeq__FPKM» FLOAT, «HTSeq__FPKM_UQ» FLOAT, «case_gdc_id» STRING, «sample_gdc_id» STRING, «aliquot_gdc_id» STRING, «file_gdc_id» STRING, «platform» STRING)

theorem eq (t0 : TableRel CLINICAL_schema) (t1 : TableRel RNASEQ_GENE_EXPRESSION_schema) :
    (sql%([CLINICAL_schema, RNASEQ_GENE_EXPRESSION_schema]) "WITH kirp_cases AS (SELECT c.\"case_barcode\", c.\"clinical_stage\", ABS(HASH(c.\"case_barcode\") % 10) AS split_val FROM \"TCGA_HG38_DATA_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\" AS c WHERE c.\"disease_code\" = 'KIRP' AND NOT c.\"clinical_stage\" IS NULL), gene_expr AS (SELECT r.\"case_barcode\", MAX(CASE WHEN r.\"gene_name\" = 'MT-CO1' THEN r.\"HTSeq__FPKM_UQ\" END) AS co1, MAX(CASE WHEN r.\"gene_name\" = 'MT-CO2' THEN r.\"HTSeq__FPKM_UQ\" END) AS co2, MAX(CASE WHEN r.\"gene_name\" = 'MT-CO3' THEN r.\"HTSeq__FPKM_UQ\" END) AS co3 FROM \"TCGA_HG38_DATA_V0\".\"TCGA_HG38_DATA_V0\".\"RNASEQ_GENE_EXPRESSION\" AS r WHERE r.\"project_short_name\" = 'TCGA-KIRP' AND r.\"gene_name\" IN ('MT-CO1', 'MT-CO2', 'MT-CO3') GROUP BY r.\"case_barcode\"), all_cases AS (SELECT kc.\"case_barcode\", kc.\"clinical_stage\", kc.split_val, ge.co1, ge.co2, ge.co3 FROM kirp_cases AS kc INNER JOIN gene_expr AS ge ON kc.\"case_barcode\" = ge.\"case_barcode\"), train_set AS (SELECT * FROM all_cases WHERE split_val <> 9), test_set AS (SELECT * FROM all_cases WHERE split_val = 9), stage_centroids AS (SELECT \"clinical_stage\", AVG(co1) AS avg_co1, AVG(co2) AS avg_co2, AVG(co3) AS avg_co3 FROM train_set GROUP BY \"clinical_stage\"), distances AS (SELECT te.\"case_barcode\", sc.\"clinical_stage\" AS predicted_stage, SQRT(COALESCE(POWER(te.co1 - sc.avg_co1, 2), 0) + COALESCE(POWER(te.co2 - sc.avg_co2, 2), 0) + COALESCE(POWER(te.co3 - sc.avg_co3, 2), 0)) AS distance FROM test_set AS te CROSS JOIN stage_centroids AS sc), ranked AS (SELECT \"case_barcode\", predicted_stage, distance, ROW_NUMBER() OVER (PARTITION BY \"case_barcode\" ORDER BY distance) AS rn FROM distances) SELECT \"case_barcode\" AS case_barcode, predicted_stage AS predicted_stage FROM ranked WHERE rn = 1 ORDER BY case_barcode") t0 t1
  ~= (sql%([CLINICAL_schema, RNASEQ_GENE_EXPRESSION_schema]) "/* Step 1: Get training data (90%) - average HTSeq__FPKM_UQ per clinical_stage per gene */ WITH kirp_patients AS (SELECT \"case_barcode\", \"clinical_stage\" FROM \"TCGA_HG38_DATA_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\" WHERE \"disease_code\" = 'KIRP' AND NOT \"clinical_stage\" IS NULL), gene_expr AS (SELECT r.\"case_barcode\", r.\"gene_name\", r.\"HTSeq__FPKM_UQ\" FROM \"TCGA_HG38_DATA_V0\".\"TCGA_HG38_DATA_V0\".\"RNASEQ_GENE_EXPRESSION\" AS r WHERE r.\"gene_name\" IN ('MT-CO3', 'MT-CO1', 'MT-CO2') AND r.\"project_short_name\" = 'TCGA-KIRP'), combined AS (SELECT k.\"case_barcode\", k.\"clinical_stage\", g.\"gene_name\", g.\"HTSeq__FPKM_UQ\", ABS(HASH(k.\"case_barcode\") % 10) AS hash_mod FROM kirp_patients AS k JOIN gene_expr AS g ON k.\"case_barcode\" = g.\"case_barcode\"), train_avg /* Step 2: Compute training averages per stage per gene */ AS (SELECT \"clinical_stage\", \"gene_name\", AVG(\"HTSeq__FPKM_UQ\") AS avg_expr FROM combined WHERE hash_mod <> 9 GROUP BY \"clinical_stage\", \"gene_name\"), train_pivot /* Pivot training averages: one row per stage with avg for each gene */ AS (SELECT \"clinical_stage\", MAX(CASE WHEN \"gene_name\" = 'MT-CO1' THEN avg_expr END) AS avg_co1, MAX(CASE WHEN \"gene_name\" = 'MT-CO2' THEN avg_expr END) AS avg_co2, MAX(CASE WHEN \"gene_name\" = 'MT-CO3' THEN avg_expr END) AS avg_co3 FROM train_avg GROUP BY \"clinical_stage\"), test_patients /* Step 3: Get test set gene expression, pivoted */ AS (SELECT \"case_barcode\", MAX(CASE WHEN \"gene_name\" = 'MT-CO1' THEN \"HTSeq__FPKM_UQ\" END) AS co1, MAX(CASE WHEN \"gene_name\" = 'MT-CO2' THEN \"HTSeq__FPKM_UQ\" END) AS co2, MAX(CASE WHEN \"gene_name\" = 'MT-CO3' THEN \"HTSeq__FPKM_UQ\" END) AS co3 FROM combined WHERE hash_mod = 9 GROUP BY \"case_barcode\"), distances /* Step 4: Compute Euclidean distance from each test patient to each stage */ AS (SELECT t.\"case_barcode\", tr.\"clinical_stage\", SQRT(POWER(t.co1 - tr.avg_co1, 2) + POWER(t.co2 - tr.avg_co2, 2) + POWER(t.co3 - tr.avg_co3, 2)) AS distance FROM test_patients AS t CROSS JOIN train_pivot AS tr), ranked /* Step 5: Find the closest stage for each test patient */ AS (SELECT \"case_barcode\", \"clinical_stage\", distance, ROW_NUMBER() OVER (PARTITION BY \"case_barcode\" ORDER BY distance ASC) AS rn FROM distances) SELECT \"case_barcode\", \"clinical_stage\" AS predicted_stage FROM ranked WHERE rn = 1 ORDER BY \"case_barcode\"") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq141_eq_0_1
