\"complaint_type\" = qt.\"complaint_type\"), joined AS (SELECT dp.dt, dp.\"complaint_type\", dp.proportion, w.wdsp FROM daily_proportions AS dp JOIN weather AS w ON dp.dt = w.dt), correlations AS (SELECT \"complaint_type\", ROUND(CORR(proportion, wdsp), 4) AS \"CORRELATION\" FROM joined GROUP BY \"complaint_type\"), ranked AS (SELECT \"complaint_type\", \"CORRELATION\", ROW_NUMBER() OVER (ORDER BY \"CORRELATION\" DESC) AS pos_rank, ROW_NUMBER() OVER (ORDER BY \"CORRELATION\" ASC) AS neg_rank FROM correlations) SELECT \"complaint_type\", \"CORRELATION\" FROM ranked WHERE pos_rank = 1 OR neg_rank = 1 ORDER BY \"CORRELATION\" DESC" := by
