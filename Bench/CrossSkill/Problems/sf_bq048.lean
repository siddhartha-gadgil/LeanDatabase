|| '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2019\" WHERE \"stn\" = '744860' UNION ALL SELECT CAST(TO_TIMESTAMP(\"year\" || '-' || \"mo\" || '-' || \"da\", 'YYYY-MM-DD') AS DATE), CAST(\"wdsp\" AS DOUBLE PRECISION) FROM \"NEW_YORK_NOAA\".\"NOAA_GSOD\".\"GSOD2020\" WHERE \"stn\" = '744860'), complaints_raw AS (SELECT CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) AS dt, \"complaint_type\" FROM \"NEW_YORK_NOAA\".\"NEW_YORK\".\"_311_SERVICE_REQUESTS\" WHERE CAST(TO_TIMESTAMP(CAST(\"created_date\" AS DOUBLE PRECISION) / 1000000) AS DATE) BETWEEN '2011-01-01' AND '2020-12-31'), qualifying_types /* Filter to complaint types with > 3000 total requests */ AS (SELECT \"complaint_type\" FROM complaints_raw GROUP BY \"complaint_type\" HAVING COUNT(*) > 3000), daily_totals /* Daily total complaints */ AS (SELECT dt, COUNT(*) AS total_complaints FROM complaints_raw GROUP BY dt), daily_type_counts /* Daily complaint counts per qualifying type */ AS (SELECT c.dt, c.\"complaint_type\", COUNT(*) AS type_count FROM complaints_raw AS c INNER JOIN qualifying_types AS q ON c.\"complaint_type\" = q.\"complaint_type\" GROUP BY c.dt, c.\"complaint_type\"), daily_proportions /* Daily complaint proportions */ AS (SELECT dtc.dt, dtc.\"complaint_type\", CAST(dtc.type_count AS DOUBLE PRECISION) / CAST(dt.total_complaints AS DOUBLE PRECISION) AS proportion FROM daily_type_counts AS dtc INNER JOIN daily_totals AS dt ON dtc.dt = dt.dt), correlations /* Join with wind data and compute correlations */ AS (SELECT dp.\"complaint_type\", ROUND(CORR(dp.proportion, w.wdsp), 4) AS CORRELATION FROM daily_proportions AS dp INNER JOIN wind_data AS w ON dp.dt = w.dt GROUP BY dp.\"complaint_type\") /* Get the strongest positive and negative correlations */ SELECT \"complaint_type\", CORRELATION FROM (SELECT \"complaint_type\", CORRELATION FROM correlations ORDER BY CORRELATION DESC LIMIT 1) UNION ALL SE