theorem eq_0_2 : ∀ t,
    (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH position_changes AS (\n    SELECT curr.\"race_id\", curr.\"driver_id\", curr.\"lap\",\n        curr.\"position\" AS curr_position, prev.\"position\" AS prev_position\n    FROM \"F1\".\"F1\".\"LAP_POSITIONS\" curr\n    JOIN \"F1\".\"F1\".\"LAP_POSITIONS\" prev\n        ON curr.\"race_id\" = prev.\"race_id\" AND curr.\"driver_id\" = prev.\"driver_id\"\n        AND curr.\"lap\" = prev.\"lap\" + 1\n    WHERE curr.\"lap\" >= 2 \n      AND curr.\"lap_type\" = 'Race'\n      AND prev.\"lap_type\" = 'Race'\n),\novertake_pairs AS (\n    SELECT a.\"race_id\", a.\"lap\", a.\"driver_id\" AS overtaker_id, b.\"driver_id\" AS overtaken_id\n    FROM position_changes a\n    JOIN position_changes b\n        ON a.\"race_id\" = b.\"race_id\" AND a.\"lap\" = b.\"lap\" AND a.\"driver_id\" != b.\"driver_id\"\n    WHERE a.prev_position > b.prev_position AND a.curr_position < b.curr_position\n),\non_track_overtakes AS (\n    SELECT op.\"race_id\", op.\"lap\", op.overtaker_id, op.overtaken_id\n    FROM overtake_pairs op\n    WHERE NOT EXISTS (\n        SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps\n        WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaken_id\n          AND (ps.\"lap\" = op.\"lap\" OR ps.\"lap\" = op.\"lap\" - 1)\n    )\n    AND NOT EXISTS (\n        SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps\n        WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaker_id\n          AND ps.\"lap\" = op.\"lap\"\n    )\n    AND NOT EXISTS (\n        SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" r\n        WHERE r.\"race_id\" = op.\"race_id\" AND r.\"driver_id\" = op.overtaken_id AND r.\"lap\" = op.\"lap\"\n    )\n),\ndriver_stats AS (\n    SELECT\n        d.\"driver_id\",\n        d.\"forename\" || ' ' || d.\"surname\" AS \"full_name\",\n        COALESCE(p.cnt, 0) AS overtakes_performed,\n        COALESCE(r.cnt, 0) AS times_overtaken\n    FROM \"F1\".\"F1\".\"DRIVERS\" d\n    LEFT JOIN (SELECT overtaker_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaker_id) p ON d.\"driver_id\" = p.did\n    LEFT JOIN (SELECT overtaken_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaken_id) r ON d.\"driver_id\" = r.did\n    WHERE COALESCE(p.cnt, 0) > 0 OR COALESCE(r.cnt, 0) > 0\n)\nSELECT \"full_name\"\nFROM driver_stats\nWHERE times_overtaken > overtakes_performed\nORDER BY \"full_name\";") t ~= (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH race_laps AS (\n    SELECT \"race_id\", \"driver_id\", \"lap\", \"position\"\n    FROM \"F1\".\"F1\".\"LAP_POSITIONS\"\n    WHERE \"lap_type\" = 'Race'\n),\n-- Self-join to get all driver pairs on each lap\nlap_pairs AS (\n    SELECT \n        a.\"race_id\",\n        a.\"lap\",\n        a.\"driver_id\" AS driver_a,\n        b.\"driver_id\" AS driver_b,\n        a.\"position\" AS pos_a,\n        b.\"position\" AS pos_b\n    FROM race_laps a\n    JOIN race_laps b ON a.\"race_id\" = b.\"race_id\" \n        AND a.\"lap\" = b.\"lap\" \n        AND a.\"driver_id\" < b.\"driver_id\"\n),\n-- Detect position swaps between consecutive laps\novertakes AS (\n    SELECT \n        curr.\"race_id\",\n        curr.\"lap\",\n        curr.driver_a,\n        curr.driver_b,\n        -- Determine who overtook whom\n        CASE \n            WHEN prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b THEN curr.driver_a  -- A was behind, now ahead\n            WHEN prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b THEN curr.driver_b  -- B was behind, now ahead\n        END AS overtaker,\n        CASE \n            WHEN prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b THEN curr.driver_b\n            WHEN prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b THEN curr.driver_a\n        END AS overtaken_driver\n    FROM lap_pairs curr\n    JOIN lap_pairs prev ON curr.\"race_id\" = prev.\"race_id\" \n        AND curr.driver_a = prev.driver_a\n        AND curr.driver_b = prev.driver_b\n        AND curr.\"lap\" = prev.\"lap\" + 1\n    WHERE curr.\"lap\" > 1\n      -- Position swap occurred\n      AND ((prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b)\n        OR (prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b))\n      -- Neither driver pitted on current lap (pit entry)\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_a AND ps.\"lap\" = curr.\"lap\")\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_b AND ps.\"lap\" = curr.\"lap\")\n      -- Neither driver pitted on previous lap (pit exit)\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_a AND ps.\"lap\" = curr.\"lap\" - 1)\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_b AND ps.\"lap\" = curr.\"lap\" - 1)\n      -- Neither driver retired on current lap\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" ret \n          WHERE ret.\"race_id\" = curr.\"race_id\" AND ret.\"driver_id\" = curr.driver_a AND ret.\"lap\" = curr.\"lap\")\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" ret \n          WHERE ret.\"race_id\" = curr.\"race_id\" AND ret.\"driver_id\" = curr.driver_b AND ret.\"lap\" = curr.\"lap\")\n),\n-- Count overtakes performed and received per driver\ndriver_stats AS (\n    SELECT \n        d.\"driver_id\",\n        COALESCE(ot.times_overtaking, 0) AS times_overtaking,\n        COALESCE(od.times_overtaken, 0) AS times_overtaken\n    FROM \"F1\".\"F1\".\"DRIVERS\" d\n    LEFT JOIN (\n        SELECT overtaker AS \"driver_id\", COUNT(*) AS times_overtaking\n        FROM overtakes\n        GROUP BY overtaker\n    ) ot ON d.\"driver_id\" = ot.\"driver_id\"\n    LEFT JOIN (\n        SELECT overtaken_driver AS \"driver_id\", COUNT(*) AS times_overtaken\n        FROM overtakes\n        GROUP BY overtaken_driver\n    ) od ON d.\"driver_id\" = od.\"driver_id\"\n    WHERE COALESCE(ot.times_overtaking, 0) > 0 OR COALESCE(od.times_overtaken, 0) > 0\n)\nSELECT d.\"full_name\"\nFROM driver_stats ds\nJOIN \"F1\".\"F1\".\"DRIVERS\" d ON ds.\"driver_id\" = d.\"driver_id\"\nWHERE ds.times_overtaken > ds.times_overtaking\nORDER BY d.\"full_name\";") t := by
