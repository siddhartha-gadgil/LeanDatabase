her driver retired on lap N+1 */ LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" AS ret_a ON o.\"race_id\" = ret_a.\"race_id\" AND o.driver_a = ret_a.\"driver_id\" AND o.lap_n1 = ret_a.\"lap\" LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" AS ret_b ON o.\"race_id\" = ret_b.\"race_id\" AND o.driver_b = ret_b.\"driver_id\" AND o.lap_n1 = ret_b.\"lap\" WHERE ps_a1.\"lap\" IS NULL AND ps_a2.\"lap\" IS NULL AND ps_b1.\"lap\" IS NULL AND ps_b2.\"lap\" IS NULL AND ret_a.\"lap\" IS NULL AND ret_b.\"lap\" IS NULL), driver_overtaken AS (SELECT driver_a AS driver_id, COUNT(*) AS times_overtaken FROM filtered GROUP BY driver_a), driver_overtaking AS (SELECT driver_b AS driver_id, COUNT(*) AS times_overtaking FROM filtered GROUP BY driver_b), combined AS (SELECT COALESCE(d1.driver_id, d2.driver_id) AS driver_id, COALESCE(d1.times_overtaken, 0) AS times_overtaken, COALESCE(d2.times_overtaking, 0) AS times_overtaking FROM driver_overtaken AS d1 FULL OUTER JOIN driver_overtaking AS d2 ON d1.driver_id = d2.driver_id) SELECT d.\"full_name\" FROM combined AS c JOIN \"F1\".\"F1\".\"DRIVERS\" AS d ON c.driver_id = d.\"driver_id\" WHERE c.times_overtaken > c.times_overtaking ORDER BY d.\"full_name\"" = sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH race_laps AS (SELECT \"race_id\", \"driver_id\", \"lap\", \"position\" FROM \"F1\".\"F1\".\"LAP_POSITIONS\" WHERE \"lap_type\" = 'Race'), lap_pairs /* Self-join to get all driver pairs on each lap */ AS (SELECT a.\"race_id\", a.\"lap\", a.\"driver_id\" AS driver_a, b.\"driver_id\" AS driver_b, a.\"position\" AS pos_a, b.\"position\" AS pos_b FROM race_laps AS a JOIN race_laps AS b ON a.\"race_id\" = b.\"race_id\" AND a.\"lap\" = b.\"lap\" AND a.\"driver_id\" < b.\"driver_id\"), overtakes /* Detect position swaps between consecutive laps */ AS (SELECT curr.\"race_id\", curr.\"lap\", curr.driver_a, curr.driver_b, CASE WHEN prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b THEN curr.driver_a /* A was behind, now ahead