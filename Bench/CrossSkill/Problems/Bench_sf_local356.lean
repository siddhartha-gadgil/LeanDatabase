/-!
# sf_local356 — crossskill equivalence(s)

Question: Provide the full names of drivers who have been overtaken on track more times than they have overtaken others on track during race laps, excluding position changes due to pit stops (both at pit entry and exit), retirements, or position changes that occurred during the first lap of a race (considered as start movements).

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local356

CREATE TABLE PIT_STOPS («race_id» INT, «driver_id» INT, «stop» INT, «lap» INT, «time» STRING, «duration» STRING, «milliseconds» INT, «seconds» FLOAT)
CREATE TABLE LAP_POSITIONS («race_id» INT, «driver_id» INT, «lap» INT, «position» INT, «lap_type» STRING)
CREATE TABLE RETIREMENTS («race_id» INT, «driver_id» INT, «lap» INT, «position_order» INT, «status_id» INT, «retirement_type» STRING)
CREATE TABLE DRIVERS («driver_id» INT, «driver_ref» STRING, «number» FLOAT, «code» STRING, «forename» STRING, «surname» STRING, «full_name» STRING, «dob» STRING, «nationality» STRING, «url» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH position_changes AS (\n    SELECT curr.\"race_id\", curr.\"driver_id\", curr.\"lap\",\n        curr.\"position\" AS curr_position, prev.\"position\" AS prev_position\n    FROM \"F1\".\"F1\".\"LAP_POSITIONS\" curr\n    JOIN \"F1\".\"F1\".\"LAP_POSITIONS\" prev\n        ON curr.\"race_id\" = prev.\"race_id\" AND curr.\"driver_id\" = prev.\"driver_id\"\n        AND curr.\"lap\" = prev.\"lap\" + 1\n    WHERE curr.\"lap\" >= 2 \n      AND curr.\"lap_type\" = 'Race'\n      AND prev.\"lap_type\" = 'Race'\n),\novertake_pairs AS (\n    SELECT a.\"race_id\", a.\"lap\", a.\"driver_id\" AS overtaker_id, b.\"driver_id\" AS overtaken_id\n    FROM position_changes a\n    JOIN position_changes b\n        ON a.\"race_id\" = b.\"race_id\" AND a.\"lap\" = b.\"lap\" AND a.\"driver_id\" != b.\"driver_id\"\n    WHERE a.prev_position > b.prev_position AND a.curr_position < b.curr_position\n),\non_track_overtakes AS (\n    SELECT op.\"race_id\", op.\"lap\", op.overtaker_id, op.overtaken_id\n    FROM overtake_pairs op\n    WHERE NOT EXISTS (\n        SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps\n        WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaken_id\n          AND (ps.\"lap\" = op.\"lap\" OR ps.\"lap\" = op.\"lap\" - 1)\n    )\n    AND NOT EXISTS (\n        SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps\n        WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaker_id\n          AND ps.\"lap\" = op.\"lap\"\n    )\n    AND NOT EXISTS (\n        SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" r\n        WHERE r.\"race_id\" = op.\"race_id\" AND r.\"driver_id\" = op.overtaken_id AND r.\"lap\" = op.\"lap\"\n    )\n),\ndriver_stats AS (\n    SELECT\n        d.\"driver_id\",\n        d.\"forename\" || ' ' || d.\"surname\" AS \"full_name\",\n        COALESCE(p.cnt, 0) AS overtakes_performed,\n        COALESCE(r.cnt, 0) AS times_overtaken\n    FROM \"F1\".\"F1\".\"DRIVERS\" d\n    LEFT JOIN (SELECT overtaker_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaker_id) p ON d.\"driver_id\" = p.did\n    LEFT JOIN (SELECT overtaken_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaken_id) r ON d.\"driver_id\" = r.did\n    WHERE COALESCE(p.cnt, 0) > 0 OR COALESCE(r.cnt, 0) > 0\n)\nSELECT \"full_name\"\nFROM driver_stats\nWHERE times_overtaken > overtakes_performed\nORDER BY \"full_name\";") t ~= (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH race_laps AS (\n    SELECT \"race_id\", \"driver_id\", \"lap\", \"position\"\n    FROM \"F1\".\"F1\".\"LAP_POSITIONS\"\n    WHERE \"lap_type\" = 'Race' AND \"lap\" > 1\n),\novertakes AS (\n    -- Pairwise: driver A was ahead, then driver B overtook A\n    -- driver_a = the one who was overtaken, driver_b = the overtaker\n    SELECT \n        curr_a.\"race_id\",\n        curr_a.\"driver_id\" AS driver_a,\n        curr_b.\"driver_id\" AS driver_b,\n        curr_a.\"lap\" AS lap_n,\n        curr_a.\"lap\" + 1 AS lap_n1\n    FROM race_laps curr_a\n    JOIN race_laps curr_b \n        ON curr_a.\"race_id\" = curr_b.\"race_id\" \n        AND curr_a.\"lap\" = curr_b.\"lap\" \n        AND curr_a.\"driver_id\" != curr_b.\"driver_id\"\n    JOIN race_laps nxt_a \n        ON curr_a.\"race_id\" = nxt_a.\"race_id\" \n        AND curr_a.\"driver_id\" = nxt_a.\"driver_id\" \n        AND nxt_a.\"lap\" = curr_a.\"lap\" + 1\n    JOIN race_laps nxt_b \n        ON curr_b.\"race_id\" = nxt_b.\"race_id\" \n        AND curr_b.\"driver_id\" = nxt_b.\"driver_id\" \n        AND nxt_b.\"lap\" = curr_b.\"lap\" + 1\n    WHERE curr_a.\"position\" < curr_b.\"position\"  -- A ahead of B on lap N\n      AND nxt_a.\"position\" > nxt_b.\"position\"     -- B ahead of A on lap N+1 (B overtook A)\n),\nfiltered AS (\n    SELECT o.*\n    FROM overtakes o\n    -- Exclude if driver A pitted on lap N (pit entry) or lap N+1 (pit exit)\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_a1 \n        ON o.\"race_id\" = ps_a1.\"race_id\" AND o.driver_a = ps_a1.\"driver_id\" AND o.lap_n = ps_a1.\"lap\"\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_a2 \n        ON o.\"race_id\" = ps_a2.\"race_id\" AND o.driver_a = ps_a2.\"driver_id\" AND o.lap_n1 = ps_a2.\"lap\"\n    -- Exclude if driver B pitted on lap N (pit entry) or lap N+1 (pit exit)\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_b1 \n        ON o.\"race_id\" = ps_b1.\"race_id\" AND o.driver_b = ps_b1.\"driver_id\" AND o.lap_n = ps_b1.\"lap\"\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_b2 \n        ON o.\"race_id\" = ps_b2.\"race_id\" AND o.driver_b = ps_b2.\"driver_id\" AND o.lap_n1 = ps_b2.\"lap\"\n    -- Exclude if either driver retired on lap N+1\n    LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" ret_a \n        ON o.\"race_id\" = ret_a.\"race_id\" AND o.driver_a = ret_a.\"driver_id\" AND o.lap_n1 = ret_a.\"lap\"\n    LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" ret_b \n        ON o.\"race_id\" = ret_b.\"race_id\" AND o.driver_b = ret_b.\"driver_id\" AND o.lap_n1 = ret_b.\"lap\"\n    WHERE ps_a1.\"lap\" IS NULL AND ps_a2.\"lap\" IS NULL\n      AND ps_b1.\"lap\" IS NULL AND ps_b2.\"lap\" IS NULL\n      AND ret_a.\"lap\" IS NULL AND ret_b.\"lap\" IS NULL\n),\ndriver_overtaken AS (\n    SELECT driver_a AS driver_id, COUNT(*) AS times_overtaken\n    FROM filtered\n    GROUP BY driver_a\n),\ndriver_overtaking AS (\n    SELECT driver_b AS driver_id, COUNT(*) AS times_overtaking\n    FROM filtered\n    GROUP BY driver_b\n),\ncombined AS (\n    SELECT COALESCE(d1.driver_id, d2.driver_id) AS driver_id,\n           COALESCE(d1.times_overtaken, 0) AS times_overtaken,\n           COALESCE(d2.times_overtaking, 0) AS times_overtaking\n    FROM driver_overtaken d1\n    FULL OUTER JOIN driver_overtaking d2 ON d1.driver_id = d2.driver_id\n)\nSELECT d.\"full_name\"\nFROM combined c\nJOIN \"F1\".\"F1\".\"DRIVERS\" d ON c.driver_id = d.\"driver_id\"\nWHERE c.times_overtaken > c.times_overtaking\nORDER BY d.\"full_name\";") t := by
  intro t; first | sql_equiv | sorry

