theorem eq_0_1 : ∀ t,
    (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH position_changes AS (SELECT curr.\"race_id\", curr.\"driver_id\", curr.\"lap\", curr.\"position\" AS curr_position, prev.\"position\" AS prev_position FROM \"F1\".\"F1\".\"LAP_POSITIONS\" AS curr JOIN \"F1\".\"F1\".\"LAP_POSITIONS\" AS prev ON curr.\"race_id\" = prev.\"race_id\" AND curr.\"driver_id\" = prev.\"driver_id\" AND curr.\"lap\" = prev.\"lap\" + 1 WHERE curr.\"lap\" >= 2 AND curr.\"lap_type\" = 'Race' AND prev.\"lap_type\" = 'Race'), overtake_pairs AS (SELECT a.\"race_id\", a.\"lap\", a.\"driver_id\" AS overtaker_id, b.\"driver_id\" AS overtaken_id FROM position_changes AS a JOIN position_changes AS b ON a.\"race_id\" = b.\"race_id\" AND a.\"lap\" = b.\"lap\" AND a.\"driver_id\" <> b.\"driver_id\" WHERE a.prev_position > b.prev_position AND a.curr_position < b.curr_position), on_track_overtakes AS (SELECT op.\"race_id\", op.\"lap\", op.overtaker_id, op.overtaken_id FROM overtake_pairs AS op WHERE NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaken_id AND (ps.\"lap\" = op.\"lap\" OR ps.\"lap\" = op.\"lap\" - 1)) AND NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" AS ps WHERE ps.\"race_id\" = op.\"race_id\" AND ps.\"driver_id\" = op.overtaker_id AND ps.\"lap\" = op.\"lap\") AND NOT EXISTS(SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" AS r WHERE r.\"race_id\" = op.\"race_id\" AND r.\"driver_id\" = op.overtaken_id AND r.\"lap\" = op.\"lap\")), driver_stats AS (SELECT d.\"driver_id\", d.\"forename\" || ' ' || d.\"surname\" AS \"full_name\", COALESCE(p.cnt, 0) AS overtakes_performed, COALESCE(r.cnt, 0) AS times_overtaken FROM \"F1\".\"F1\".\"DRIVERS\" AS d LEFT JOIN (SELECT overtaker_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaker_id) AS p ON d.\"driver_id\" = p.did LEFT JOIN (SELECT overtaken_id AS did, COUNT(*) AS cnt FROM on_track_overtakes GROUP BY overtaken_id) AS r ON d.\"driver_id\" = r.did WHERE COALESCE(p.cnt, 0) > 0 OR COALESCE(r.cnt, 0) > 0) SELECT \"full_name\" FROM driver_stats WHERE times_overtaken > overtakes_performed ORDER BY \"full_name\"") t ~= (sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH race_laps AS (SELECT \"race_id\", \"driver_id\", \"lap\", \"position\" FROM \"F1\".\"F1\".\"LAP_POSITIONS\" WHERE \"lap_type\" = 'Race' AND \"lap\" > 1), overtakes AS (/* Pairwise: driver A was ahead, then driver B overtook A */ /* driver_a = the one who was overtaken, driver_b = the overtaker */ SELECT curr_a.\"race_id\", curr_a.\"driver_id\" AS driver_a, curr_b.\"driver_id\" AS driver_b, curr_a.\"lap\" AS lap_n, curr_a.\"lap\" + 1 AS lap_n1 FROM race_laps AS curr_a JOIN race_laps AS curr_b ON curr_a.\"race_id\" = curr_b.\"race_id\" AND curr_a.\"lap\" = curr_b.\"lap\" AND curr_a.\"driver_id\" <> curr_b.\"driver_id\" JOIN race_laps AS nxt_a ON curr_a.\"race_id\" = nxt_a.\"race_id\" AND curr_a.\"driver_id\" = nxt_a.\"driver_id\" AND nxt_a.\"lap\" = curr_a.\"lap\" + 1 JOIN race_laps AS nxt_b ON curr_b.\"race_id\" = nxt_b.\"race_id\" AND curr_b.\"driver_id\" = nxt_b.\"driver_id\" AND nxt_b.\"lap\" = curr_b.\"lap\" + 1 WHERE curr_a.\"position\" < curr_b.\"position\" /* A ahead of B on lap N */ AND nxt_a.\"position\" > nxt_b.\"position\" /* B ahead of A on lap N+1 (B overtook A) */), filtered AS (SELECT o.* FROM overtakes AS o /* Exclude if driver A pitted on lap N (pit entry) or lap N+1 (pit exit) */ LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" AS ps_a1 ON o.\"race_id\" = ps_a1.\"race_id\" AND o.driver_a = ps_a1.\"driver_id\" AND o.lap_n = ps_a1.\"lap\" LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" AS ps_a2 ON o.\"race_id\" = ps_a2.\"race_id\" AND o.driver_a = ps_a2.\"driver_id\" AND o.lap_n1 = ps_a2.\"lap\" /* Exclude if driver B pitted on lap N (pit entry) or lap N+1 (pit exit) */ LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" AS ps_b1 ON o.\"race_id\" = ps_b1.\"race_id\" AND o.driver_b = ps_b1.\"driver_id\" AND o.lap_n = ps_b1.\"lap\" LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" AS ps_b2 ON o.\"race_id\" = ps_b2.\"race_id\" AND o.driver_b = ps_b2.\"driver_id\" AND o.lap_n1 = ps_b2.\"lap\" /* Exclude if either driver retired on lap N+1 */ LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" AS ret_a ON o.\"race_id\" = ret_a.\"race_id\" AND o.driver_a = ret_a.\"driver_id\" AND o.lap_n1 = ret_a.\"lap\" LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" AS ret_b ON o.\"race_id\" = ret_b.\"race_id\" AND o.driver_b = ret_b.\"driver_id\" AND o.lap_n1 = ret_b.\"lap\" WHERE ps_a1.\"lap\" IS NULL AND ps_a2.\"lap\" IS NULL AND ps_b1.\"lap\" IS NULL AND ps_b2.\"lap\" IS NULL AND ret_a.\"lap\" IS NULL AND ret_b.\"lap\" IS NULL), driver_overtaken AS (SELECT driver_a AS driver_id, COUNT(*) AS times_overtaken FROM filtered GROUP BY driver_a), driver_overtaking AS (SELECT driver_b AS driver_id, COUNT(*) AS times_overtaking FROM filtered GROUP BY driver_b), combined AS (SELECT COALESCE(d1.driver_id, d2.driver_id) AS driver_id, COALESCE(d1.times_overtaken, 0) AS times_overtaken, COALESCE(d2.times_overtaking, 0) AS times_overtaking FROM driver_overtaken AS d1 FULL OUTER JOIN driver_overtaking AS d2 ON d1.driver_id = d2.driver_id) SELECT d.\"full_name\" FROM combined AS c JOIN \"F1\".\"F1\".\"DRIVERS\" AS d ON c.driver_id = d.\"driver_id\" WHERE c.times_overtaken > c.times_overtaking ORDER BY d.\"full_name\"") t := by
