theorem eq_1_2 :
    sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH race_laps AS (\n    SELECT \"race_id\", \"driver_id\", \"lap\", \"position\"\n    FROM \"F1\".\"F1\".\"LAP_POSITIONS\"\n    WHERE \"lap_type\" = 'Race' AND \"lap\" > 1\n),\novertakes AS (\n    -- Pairwise: driver A was ahead, then driver B overtook A\n    -- driver_a = the one who was overtaken, driver_b = the overtaker\n    SELECT \n        curr_a.\"race_id\",\n        curr_a.\"driver_id\" AS driver_a,\n        curr_b.\"driver_id\" AS driver_b,\n        curr_a.\"lap\" AS lap_n,\n        curr_a.\"lap\" + 1 AS lap_n1\n    FROM race_laps curr_a\n    JOIN race_laps curr_b \n        ON curr_a.\"race_id\" = curr_b.\"race_id\" \n        AND curr_a.\"lap\" = curr_b.\"lap\" \n        AND curr_a.\"driver_id\" != curr_b.\"driver_id\"\n    JOIN race_laps nxt_a \n        ON curr_a.\"race_id\" = nxt_a.\"race_id\" \n        AND curr_a.\"driver_id\" = nxt_a.\"driver_id\" \n        AND nxt_a.\"lap\" = curr_a.\"lap\" + 1\n    JOIN race_laps nxt_b \n        ON curr_b.\"race_id\" = nxt_b.\"race_id\" \n        AND curr_b.\"driver_id\" = nxt_b.\"driver_id\" \n        AND nxt_b.\"lap\" = curr_b.\"lap\" + 1\n    WHERE curr_a.\"position\" < curr_b.\"position\"  -- A ahead of B on lap N\n      AND nxt_a.\"position\" > nxt_b.\"position\"     -- B ahead of A on lap N+1 (B overtook A)\n),\nfiltered AS (\n    SELECT o.*\n    FROM overtakes o\n    -- Exclude if driver A pitted on lap N (pit entry) or lap N+1 (pit exit)\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_a1 \n        ON o.\"race_id\" = ps_a1.\"race_id\" AND o.driver_a = ps_a1.\"driver_id\" AND o.lap_n = ps_a1.\"lap\"\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_a2 \n        ON o.\"race_id\" = ps_a2.\"race_id\" AND o.driver_a = ps_a2.\"driver_id\" AND o.lap_n1 = ps_a2.\"lap\"\n    -- Exclude if driver B pitted on lap N (pit entry) or lap N+1 (pit exit)\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_b1 \n        ON o.\"race_id\" = ps_b1.\"race_id\" AND o.driver_b = ps_b1.\"driver_id\" AND o.lap_n = ps_b1.\"lap\"\n    LEFT JOIN \"F1\".\"F1\".\"PIT_STOPS\" ps_b2 \n        ON o.\"race_id\" = ps_b2.\"race_id\" AND o.driver_b = ps_b2.\"driver_id\" AND o.lap_n1 = ps_b2.\"lap\"\n    -- Exclude if either driver retired on lap N+1\n    LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" ret_a \n        ON o.\"race_id\" = ret_a.\"race_id\" AND o.driver_a = ret_a.\"driver_id\" AND o.lap_n1 = ret_a.\"lap\"\n    LEFT JOIN \"F1\".\"F1\".\"RETIREMENTS\" ret_b \n        ON o.\"race_id\" = ret_b.\"race_id\" AND o.driver_b = ret_b.\"driver_id\" AND o.lap_n1 = ret_b.\"lap\"\n    WHERE ps_a1.\"lap\" IS NULL AND ps_a2.\"lap\" IS NULL\n      AND ps_b1.\"lap\" IS NULL AND ps_b2.\"lap\" IS NULL\n      AND ret_a.\"lap\" IS NULL AND ret_b.\"lap\" IS NULL\n),\ndriver_overtaken AS (\n    SELECT driver_a AS driver_id, COUNT(*) AS times_overtaken\n    FROM filtered\n    GROUP BY driver_a\n),\ndriver_overtaking AS (\n    SELECT driver_b AS driver_id, COUNT(*) AS times_overtaking\n    FROM filtered\n    GROUP BY driver_b\n),\ncombined AS (\n    SELECT COALESCE(d1.driver_id, d2.driver_id) AS driver_id,\n           COALESCE(d1.times_overtaken, 0) AS times_overtaken,\n           COALESCE(d2.times_overtaking, 0) AS times_overtaking\n    FROM driver_overtaken d1\n    FULL OUTER JOIN driver_overtaking d2 ON d1.driver_id = d2.driver_id\n)\nSELECT d.\"full_name\"\nFROM combined c\nJOIN \"F1\".\"F1\".\"DRIVERS\" d ON c.driver_id = d.\"driver_id\"\nWHERE c.times_overtaken > c.times_overtaking\nORDER BY d.\"full_name\";" = sql%([PIT_STOPS_schema, LAP_POSITIONS_schema, RETIREMENTS_schema, DRIVERS_schema]) "WITH race_laps AS (\n    SELECT \"race_id\", \"driver_id\", \"lap\", \"position\"\n    FROM \"F1\".\"F1\".\"LAP_POSITIONS\"\n    WHERE \"lap_type\" = 'Race'\n),\n-- Self-join to get all driver pairs on each lap\nlap_pairs AS (\n    SELECT \n        a.\"race_id\",\n        a.\"lap\",\n        a.\"driver_id\" AS driver_a,\n        b.\"driver_id\" AS driver_b,\n        a.\"position\" AS pos_a,\n        b.\"position\" AS pos_b\n    FROM race_laps a\n    JOIN race_laps b ON a.\"race_id\" = b.\"race_id\" \n        AND a.\"lap\" = b.\"lap\" \n        AND a.\"driver_id\" < b.\"driver_id\"\n),\n-- Detect position swaps between consecutive laps\novertakes AS (\n    SELECT \n        curr.\"race_id\",\n        curr.\"lap\",\n        curr.driver_a,\n        curr.driver_b,\n        -- Determine who overtook whom\n        CASE \n            WHEN prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b THEN curr.driver_a  -- A was behind, now ahead\n            WHEN prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b THEN curr.driver_b  -- B was behind, now ahead\n        END AS overtaker,\n        CASE \n            WHEN prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b THEN curr.driver_b\n            WHEN prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b THEN curr.driver_a\n        END AS overtaken_driver\n    FROM lap_pairs curr\n    JOIN lap_pairs prev ON curr.\"race_id\" = prev.\"race_id\" \n        AND curr.driver_a = prev.driver_a\n        AND curr.driver_b = prev.driver_b\n        AND curr.\"lap\" = prev.\"lap\" + 1\n    WHERE curr.\"lap\" > 1\n      -- Position swap occurred\n      AND ((prev.pos_a < prev.pos_b AND curr.pos_a > curr.pos_b)\n        OR (prev.pos_a > prev.pos_b AND curr.pos_a < curr.pos_b))\n      -- Neither driver pitted on current lap (pit entry)\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_a AND ps.\"lap\" = curr.\"lap\")\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_b AND ps.\"lap\" = curr.\"lap\")\n      -- Neither driver pitted on previous lap (pit exit)\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_a AND ps.\"lap\" = curr.\"lap\" - 1)\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"PIT_STOPS\" ps \n          WHERE ps.\"race_id\" = curr.\"race_id\" AND ps.\"driver_id\" = curr.driver_b AND ps.\"lap\" = curr.\"lap\" - 1)\n      -- Neither driver retired on current lap\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" ret \n          WHERE ret.\"race_id\" = curr.\"race_id\" AND ret.\"driver_id\" = curr.driver_a AND ret.\"lap\" = curr.\"lap\")\n      AND NOT EXISTS (SELECT 1 FROM \"F1\".\"F1\".\"RETIREMENTS\" ret \n          WHERE ret.\"race_id\" = curr.\"race_id\" AND ret.\"driver_id\" = curr.driver_b AND ret.\"lap\" = curr.\"lap\")\n),\n-- Count overtakes performed and received per driver\ndriver_stats AS (\n    SELECT \n        d.\"driver_id\",\n        COALESCE(ot.times_overtaking, 0) AS times_overtaking,\n        COALESCE(od.times_overtaken, 0) AS times_overtaken\n    FROM \"F1\".\"F1\".\"DRIVERS\" d\n    LEFT JOIN (\n        SELECT overtaker AS \"driver_id\", COUNT(*) AS times_overtaking\n        FROM overtakes\n        GROUP BY overtaker\n    ) ot ON d.\"driver_id\" = ot.\"driver_id\"\n    LEFT JOIN (\n        SELECT overtaken_driver AS \"driver_id\", COUNT(*) AS times_overtaken\n        FROM overtakes\n        GROUP BY overtaken_driver\n    ) od ON d.\"driver_id\" = od.\"driver_id\"\n    WHERE COALESCE(ot.times_overtaking, 0) > 0 OR COALESCE(od.times_overtaken, 0) > 0\n)\nSELECT d.\"full_name\"\nFROM driver_stats ds\nJOIN \"F1\".\"F1\".\"DRIVERS\" d ON ds.\"driver_id\" = d.\"driver_id\"\nWHERE ds.times_overtaken > ds.times_overtaking\nORDER BY d.\"full_name\";" := by
