theorem eq (t0 : TableRel COUNTRIES_schema) (t1 : TableRel CURRENCY_schema) (t2 : TableRel CUSTOMERS_schema) (t3 : TableRel TIMES_schema) (t4 : TableRel CHANNELS_schema) (t5 : TableRel PROMOTIONS_schema) (t6 : TableRel SALES_schema) :
