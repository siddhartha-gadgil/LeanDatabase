M rev_2020 AS r20 JOIN rev_2019 AS r19 ON r20.\"prod_id\" = r19.\"prod_id\" AND r20.month_num = r19.month_num WHERE r19.revenue > 0), projected_usd AS (SELECT p.month_num, p.projected_revenue * cur.\"to_us\" AS projected_revenue_usd FROM projected AS p JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\" AS cur ON cur.\"country\" = 'France' AND cur.\"year\" = 2021 AND cur.\"month\" = p.month_num) SELECT month_num AS \"calendar_month_number\", AVG(projected_revenue_usd) AS \"AVG_PROJECTED_USD_SALES\" FROM projected_usd GROUP BY month_num ORDER BY month_num") t0 t1 t2 t3 t4 t5 t6
