.\"month\" = p.\"calendar_month_number\"\n)\nSELECT \n  \"calendar_month_number\",\n  AVG(projected_usd) AS \"AVG_PROJECTED_USD_SALES\"\nFROM with_currency\nGROUP BY \"calendar_month_number\"\nORDER BY \"calendar_month_number\";") t ~= (sql%([COUNTRIES_schema, CURRENCY_schema, CUSTOMERS_schema, TIMES_schema, CHANNELS_schema, PROMOTIONS_schema, SALES_schema]) "WITH rev_2019 AS (\n    SELECT \n        s.\"prod_id\",\n        t.\"calendar_month_number\" AS month_num,\n        SUM(s.\"amount_sold\") AS revenue\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t \n        ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu \n        ON s.\"cust_id\" = cu.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co \n        ON cu.\"country_id\" = co.\"country_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" ch \n        ON s.\"channel_id\" = ch.\"channel_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" p \n        ON s.\"promo_id\" = p.\"promo_id\"\n    WHERE co.\"country_name\" = 'France'\n      AND t.\"calendar_year\" = 2019\n      AND p.\"promo_total_id\" = 1\n      AND ch.\"channel_total_id\" = 1\n    GROUP BY s.\"prod_id\", t.\"calendar_month_number\"\n),\nrev_2020 AS (\n    SELECT \n        s.\"prod_id\",\n        t.\"calendar_month_number\" AS month_num,\n        SUM(s.\"amount_sold\") AS revenue\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t \n        ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu \n        ON s.\"cust_id\" = cu.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co \n        ON cu.\"country_id\" = co.\"country_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" ch \n        ON s.\"channel_id\" = ch.\"channel_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" p \n        ON s.\"promo_id\" = p.\"promo_id\"\n    WHERE co.\"country_name\" = 'France'\n      AND t.\"calendar_year\" = 2020\n      AND p.\"promo_total_id\" = 1\n      AND ch.\"channel_total_id\" = 1\n    GROUP BY s.\"prod_id\", t.\"calendar_month_number\"\n),\nprojected AS (\n    SELECT \n        r20.\"prod_id\",\n        r20.month_num,\n        (((r20.revenue - r19.revenue) / r19.revenue) * r20.revenue) + r20.revenue AS projected_revenue\n    FROM rev_2020 r20\n    JOIN rev_2019 r19 \n        ON r20.\"prod_id\" = r19.\"prod_id\" \n        AND r20.month_num = r19.month_num\n    WHERE r19.revenue > 0\n),\nprojected_usd AS (\n    SELECT \n        p.month_num,\n        p.projected_revenue * cur.\"to_us\" AS projected_revenue_usd\n    FROM projected p\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\" cur\n        ON cur.\"country\" = 'France'\n        AND cur.\"year\" = 2021\n        AND cur.\"month\" = p.month_num\n)\nSELECT \n    month_num AS \"calendar_month_number\",\n    AVG(projected_revenue_usd) AS \"AVG_PROJECTED_USD_SALES\"\nFROM projected_usd\nGROUP BY month_num\nORDER BY month_num;") t := by
