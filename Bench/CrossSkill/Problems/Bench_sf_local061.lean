annel_total_id\" = 1\n    GROUP BY s.\"prod_id\", t.\"calendar_month_number\"\n),\nprojected AS (\n    SELECT \n        r20.\"prod_id\",\n        r20.month_num,\n        (((r20.revenue - r19.revenue) / r19.revenue) * r20.revenue) + r20.revenue AS projected_revenue\n    FROM rev_2020 r20\n    JOIN rev_2019 r19 \n        ON r20.\"prod_id\" = r19.\"prod_id\" \n        AND r20.month_num = r19.month_num\n    WHERE r19.revenue > 0\n),\nprojected_usd AS (\n    SELECT \n        p.month_num,\n        p.projected_revenue * cur.\"to_us\" AS projected_revenue_usd\n    FROM projected p\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\" cur\n        ON cur.\"country\" = 'France'\n        AND cur.\"year\" = 2021\n        AND cur.\"month\" = p.month_num\n)\nSELECT \n    month_num AS \"calendar_month_number\",\n    AVG(projected_revenue_usd) AS \"AVG_PROJECTED_USD_SALES\"\nFROM projected_usd\nGROUP BY month_num\nORDER BY month_num;") t ~= (sql%([COUNTRIES_schema, CURRENCY_schema, CUSTOMERS_schema, TIMES_schema, CHANNELS_schema, PROMOTIONS_schema, SALES_schema]) "WITH sales_data AS (\n    SELECT\n        s.\"prod_id\",\n        t.\"calendar_month_number\",\n        t.\"calendar_year\",\n        SUM(s.\"amount_sold\") AS total_sales\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu ON s.\"cust_id\" = cu.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co ON cu.\"country_id\" = co.\"country_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" p ON s.\"promo_id\" = p.\"promo_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" ch ON s.\"channel_id\" = ch.\"channel_id\"\n    WHERE co.\"country_name\" = 'France'\n      AND p.\"promo_total_id\" = 1\n      AND ch.\"channel_total_id\" = 1\n      AND t.\"calendar_year\" IN (2019, 2020)\n    GROUP BY s.\"prod_id\", t.\"calendar_month_number\", t.\"calendar_year\"\n),\npivoted AS (\n    SELECT\n        \"prod_id\",\n        \"calendar_month_number\",\n        MAX(CASE WHEN \"calendar_year\" = 2019 THEN total_sales END) AS s2019,\n        MAX(CASE WHEN \"calendar_year\" = 2020 THEN total_sales END) AS s2020\n    FROM sales_data\n    GROUP BY \"prod_id\", \"calendar_month_number\"\n    HAVING s2019 IS NOT NULL AND s2020 IS NOT NULL AND s2019 != 0\n),\nprojected AS (\n    SELECT\n        \"prod_id\",\n        \"calendar_month_number\",\n        (((s2020 - s2019) / s2019) * s2020) + s2020 AS projected_sales\n    FROM pivoted\n),\ncurrency_rates AS (\n    SELECT \"month\", \"to_us\"\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\"\n    WHERE \"country\" = 'France' AND \"year\" = 2021\n)\nSELECT\n    p.\"calendar_month_number\",\n    AVG(p.projected_sales * COALESCE(cr.\"to_us\", 1)) AS \"AVG_PROJECTED_USD_SALES\"\nFROM projected p\nLEFT JOIN currency_rates cr ON p.\"calendar_month_number\" = cr.\"month\"\nGROUP BY p.\"calendar_month_number\"\nORDER BY p.\"calendar_month_number\";") t := by
