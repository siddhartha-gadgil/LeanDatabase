\"month\" = p.\"calendar_month_number\"\n)\nSELECT \n  \"calendar_month_number\",\n  AVG(projected_usd) AS \"AVG_PROJECTED_USD_SALES\"\nFROM with_currency\nGROUP BY \"calendar_month_number\"\nORDER BY \"calendar_month_number\";" = sql%([COUNTRIES_schema, CURRENCY_schema, CUSTOMERS_schema, TIMES_schema, CHANNELS_schema, PROMOTIONS_schema, SALES_schema]) "WITH france_sales AS (\n    SELECT\n        s.\"prod_id\",\n        t.\"calendar_year\",\n        t.\"calendar_month_number\",\n        SUM(s.\"amount_sold\") AS total_sales\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"SALES\" s\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"TIMES\" t\n        ON s.\"time_id\" = t.\"time_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CUSTOMERS\" cu\n        ON s.\"cust_id\" = cu.\"cust_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"COUNTRIES\" co\n        ON cu.\"country_id\" = co.\"country_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"PROMOTIONS\" p\n        ON s.\"promo_id\" = p.\"promo_id\"\n    JOIN \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CHANNELS\" ch\n        ON s.\"channel_id\" = ch.\"channel_id\"\n    WHERE co.\"country_name\" = 'France'\n      AND t.\"calendar_year\" IN (2019, 2020)\n      AND p.\"promo_total_id\" = 1\n      AND ch.\"channel_total_id\" = 1\n    GROUP BY s.\"prod_id\", t.\"calendar_year\", t.\"calendar_month_number\"\n),\nsales_2019 AS (\n    SELECT \"prod_id\", \"calendar_month_number\", total_sales AS sales_19\n    FROM france_sales\n    WHERE \"calendar_year\" = 2019\n),\nsales_2020 AS (\n    SELECT \"prod_id\", \"calendar_month_number\", total_sales AS sales_20\n    FROM france_sales\n    WHERE \"calendar_year\" = 2020\n),\nprojected AS (\n    SELECT\n        s20.\"prod_id\",\n        s20.\"calendar_month_number\",\n        s20.sales_20,\n        s19.sales_19,\n        ((s20.sales_20 - s19.sales_19) / s19.sales_19) AS growth_rate,\n        ((s20.sales_20 - s19.sales_19) / s19.sales_19) * s20.sales_20 + s20.sales_20 AS projected_2021\n    FROM sales_2020 s20\n    JOIN sales_2019 s19\n        ON s20.\"prod_id\" = s19.\"prod_id\"\n        AND s20.\"calendar_month_number\" = s19.\"calendar_month_number\"\n    WHERE s19.sales_19 > 0\n),\ncurrency_2021 AS (\n    SELECT \"month\", \"to_us\"\n    FROM \"COMPLEX_ORACLE\".\"COMPLEX_ORACLE\".\"CURRENCY\"\n    WHERE \"country\" = 'France'\n      AND \"year\" = 2021\n)\nSELECT\n    p.\"calendar_month_number\" AS \"MONTH\",\n    ROUND(AVG(p.projected_2021 * c.\"to_us\"), 2) AS \"PROJECTED_SALES_USD\"\nFROM projected p\nJOIN currency_2021 c\n    ON p.\"calendar_month_number\" = c.\"month\"\nGROUP BY p.\"calendar_month_number\"\nORDER BY p.\"calendar_month_number\";" := by
