urchase fp ON o.\"user_id\" = fp.\"user_id\"\n),\ncohort_sizes AS (\n  SELECT\n    cohort_month,\n    COUNT(DISTINCT \"user_id\") AS cohort_size\n  FROM first_purchase\n  GROUP BY cohort_month\n),\nretention AS (\n  SELECT\n    cohort_month,\n    month_offset,\n    COUNT(DISTINCT \"user_id\") AS active_users\n  FROM user_activity\n  WHERE month_offset BETWEEN 0 AND 3\n  GROUP BY cohort_month, month_offset\n)\nSELECT\n  TO_VARCHAR(cs.cohort_month, 'YYYY-MM') AS \"COHORT_MONTH\",\n  cs.cohort_size AS \"COHORT_SIZE\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 0 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_1\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 1 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_2\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 2 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_3\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 3 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_4\"\nFROM cohort_sizes cs\nLEFT JOIN retention r ON cs.cohort_month = r.cohort_month\nGROUP BY cs.cohort_month, cs.cohort_size\nORDER BY cs.cohort_month;") t := by
