import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq259 — crossskill equivalence(s)

Question: Using data up to the end of 2022 and organized by the month of each user's first purchase, can you provide the percentage of users who made a purchase in each of the first, second, third, and fourth months since their initial purchase, where the "first month" refers to the month of their initial purchase?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq259

CREATE TABLE ORDERS («order_id» INT, «user_id» INT, «status» STRING, «gender» STRING, «created_at» INT, «returned_at» INT, «shipped_at» INT, «delivered_at» INT, «num_of_item» INT)

theorem eq_0_1 : ∀ t,
    (sql%([ORDERS_schema]) "WITH orders_converted AS (\n  SELECT\n    \"user_id\",\n    TO_TIMESTAMP(\"created_at\" / 1000000) AS order_ts,\n    DATE_TRUNC('month', TO_TIMESTAMP(\"created_at\" / 1000000)) AS order_month\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDERS\"\n  WHERE TO_TIMESTAMP(\"created_at\" / 1000000) <= '2022-12-31 23:59:59'\n),\nfirst_purchase AS (\n  SELECT\n    \"user_id\",\n    MIN(order_month) AS first_month\n  FROM orders_converted\n  GROUP BY \"user_id\"\n),\nuser_order_months AS (\n  SELECT DISTINCT\n    o.\"user_id\",\n    o.order_month\n  FROM orders_converted o\n),\ncohort_data AS (\n  SELECT\n    fp.first_month AS cohort_month,\n    fp.\"user_id\",\n    DATEDIFF('month', fp.first_month, uom.order_month) AS months_since_first\n  FROM first_purchase fp\n  JOIN user_order_months uom ON fp.\"user_id\" = uom.\"user_id\"\n),\ncohort_sizes AS (\n  SELECT\n    cohort_month,\n    COUNT(DISTINCT \"user_id\") AS cohort_size\n  FROM cohort_data\n  GROUP BY cohort_month\n),\ncohort_activity AS (\n  SELECT\n    cohort_month,\n    months_since_first,\n    COUNT(DISTINCT \"user_id\") AS active_users\n  FROM cohort_data\n  WHERE months_since_first BETWEEN 0 AND 3\n  GROUP BY cohort_month, months_since_first\n)\nSELECT\n  TO_CHAR(cs.cohort_month, 'YYYY-MM') AS COHORT_MONTH,\n  cs.cohort_size AS COHORT_SIZE,\n  ROUND(100.0 * COALESCE(m0.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_1,\n  ROUND(100.0 * COALESCE(m1.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_2,\n  ROUND(100.0 * COALESCE(m2.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_3,\n  ROUND(100.0 * COALESCE(m3.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_4\nFROM cohort_sizes cs\nLEFT JOIN cohort_activity m0 ON cs.cohort_month = m0.cohort_month AND m0.months_since_first = 0\nLEFT JOIN cohort_activity m1 ON cs.cohort_month = m1.cohort_month AND m1.months_since_first = 1\nLEFT JOIN cohort_activity m2 ON cs.cohort_month = m2.cohort_month AND m2.months_since_first = 2\nLEFT JOIN cohort_activity m3 ON cs.cohort_month = m3.cohort_month AND m3.months_since_first = 3\nORDER BY cs.cohort_month;") t ~= (sql%([ORDERS_schema]) "WITH filtered_orders AS (\n  SELECT \n    \"user_id\",\n    DATE_TRUNC('month', TO_TIMESTAMP(\"created_at\" / 1000000)) AS order_month\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDERS\"\n  WHERE TO_TIMESTAMP(\"created_at\" / 1000000) < '2023-01-01'\n),\nfirst_purchase AS (\n  SELECT \n    \"user_id\",\n    MIN(order_month) AS first_month\n  FROM filtered_orders\n  GROUP BY \"user_id\"\n),\ncohort_activity AS (\n  SELECT \n    fp.first_month,\n    fp.\"user_id\",\n    DATEDIFF('month', fp.first_month, fo.order_month) AS month_number\n  FROM first_purchase fp\n  JOIN filtered_orders fo ON fp.\"user_id\" = fo.\"user_id\"\n)\nSELECT \n  TO_CHAR(first_month, 'YYYY-MM') AS COHORT_MONTH,\n  COUNT(DISTINCT \"user_id\") AS COHORT_SIZE,\n  100.0 * COUNT(DISTINCT CASE WHEN month_number = 0 THEN \"user_id\" END) / COUNT(DISTINCT \"user_id\") AS PCT_MONTH_1,\n  100.0 * COUNT(DISTINCT CASE WHEN month_number = 1 THEN \"user_id\" END) / COUNT(DISTINCT \"user_id\") AS PCT_MONTH_2,\n  100.0 * COUNT(DISTINCT CASE WHEN month_number = 2 THEN \"user_id\" END) / COUNT(DISTINCT \"user_id\") AS PCT_MONTH_3,\n  100.0 * COUNT(DISTINCT CASE WHEN month_number = 3 THEN \"user_id\" END) / COUNT(DISTINCT \"user_id\") AS PCT_MONTH_4\nFROM cohort_activity\nGROUP BY first_month\nORDER BY first_month;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([ORDERS_schema]) "WITH orders_converted AS (\n  SELECT\n    \"user_id\",\n    TO_TIMESTAMP(\"created_at\" / 1000000) AS order_ts,\n    DATE_TRUNC('month', TO_TIMESTAMP(\"created_at\" / 1000000)) AS order_month\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDERS\"\n  WHERE TO_TIMESTAMP(\"created_at\" / 1000000) <= '2022-12-31 23:59:59'\n),\nfirst_purchase AS (\n  SELECT\n    \"user_id\",\n    MIN(order_month) AS first_month\n  FROM orders_converted\n  GROUP BY \"user_id\"\n),\nuser_order_months AS (\n  SELECT DISTINCT\n    o.\"user_id\",\n    o.order_month\n  FROM orders_converted o\n),\ncohort_data AS (\n  SELECT\n    fp.first_month AS cohort_month,\n    fp.\"user_id\",\n    DATEDIFF('month', fp.first_month, uom.order_month) AS months_since_first\n  FROM first_purchase fp\n  JOIN user_order_months uom ON fp.\"user_id\" = uom.\"user_id\"\n),\ncohort_sizes AS (\n  SELECT\n    cohort_month,\n    COUNT(DISTINCT \"user_id\") AS cohort_size\n  FROM cohort_data\n  GROUP BY cohort_month\n),\ncohort_activity AS (\n  SELECT\n    cohort_month,\n    months_since_first,\n    COUNT(DISTINCT \"user_id\") AS active_users\n  FROM cohort_data\n  WHERE months_since_first BETWEEN 0 AND 3\n  GROUP BY cohort_month, months_since_first\n)\nSELECT\n  TO_CHAR(cs.cohort_month, 'YYYY-MM') AS COHORT_MONTH,\n  cs.cohort_size AS COHORT_SIZE,\n  ROUND(100.0 * COALESCE(m0.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_1,\n  ROUND(100.0 * COALESCE(m1.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_2,\n  ROUND(100.0 * COALESCE(m2.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_3,\n  ROUND(100.0 * COALESCE(m3.active_users, 0) / cs.cohort_size, 6) AS PCT_MONTH_4\nFROM cohort_sizes cs\nLEFT JOIN cohort_activity m0 ON cs.cohort_month = m0.cohort_month AND m0.months_since_first = 0\nLEFT JOIN cohort_activity m1 ON cs.cohort_month = m1.cohort_month AND m1.months_since_first = 1\nLEFT JOIN cohort_activity m2 ON cs.cohort_month = m2.cohort_month AND m2.months_since_first = 2\nLEFT JOIN cohort_activity m3 ON cs.cohort_month = m3.cohort_month AND m3.months_since_first = 3\nORDER BY cs.cohort_month;") t ~= (sql%([ORDERS_schema]) "WITH orders_with_ts AS (\n  SELECT\n    \"order_id\",\n    \"user_id\",\n    DATE_TRUNC('month', TO_TIMESTAMP(\"created_at\" / 1000000)) AS order_month\n  FROM \"THELOOK_ECOMMERCE\".\"THELOOK_ECOMMERCE\".\"ORDERS\"\n  WHERE TO_TIMESTAMP(\"created_at\" / 1000000) <= '2022-12-31 23:59:59'\n),\nfirst_purchase AS (\n  SELECT\n    \"user_id\",\n    MIN(order_month) AS cohort_month\n  FROM orders_with_ts\n  GROUP BY \"user_id\"\n),\nuser_activity AS (\n  SELECT DISTINCT\n    o.\"user_id\",\n    fp.cohort_month,\n    o.order_month,\n    DATEDIFF('month', fp.cohort_month, o.order_month) AS month_offset\n  FROM orders_with_ts o\n  JOIN first_purchase fp ON o.\"user_id\" = fp.\"user_id\"\n),\ncohort_sizes AS (\n  SELECT\n    cohort_month,\n    COUNT(DISTINCT \"user_id\") AS cohort_size\n  FROM first_purchase\n  GROUP BY cohort_month\n),\nretention AS (\n  SELECT\n    cohort_month,\n    month_offset,\n    COUNT(DISTINCT \"user_id\") AS active_users\n  FROM user_activity\n  WHERE month_offset BETWEEN 0 AND 3\n  GROUP BY cohort_month, month_offset\n)\nSELECT\n  TO_VARCHAR(cs.cohort_month, 'YYYY-MM') AS \"COHORT_MONTH\",\n  cs.cohort_size AS \"COHORT_SIZE\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 0 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_1\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 1 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_2\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 2 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_3\",\n  ROUND(100.0 * COALESCE(MAX(CASE WHEN r.month_offset = 3 THEN r.active_users END), 0) / cs.cohort_size, 2) AS \"PCT_MONTH_4\"\nFROM cohort_sizes cs\nLEFT JOIN retention r ON cs.cohort_month = r.cohort_month\nGROUP BY cs.cohort_month, cs.cohort_size\nORDER BY cs.cohort_month;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_1_2 : ∀ t,
