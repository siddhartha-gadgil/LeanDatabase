-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([ZIP_CODES_schema, HURRICANES_schema]) "SELECT\n    z.\"city\" AS \"city\",\n    z.\"zip_code\" AS \"zip_code\",\n    z.\"state_code\" AS \"STATE\",\n    COUNT(DISTINCT h.\"sid\") AS \"HURRICANE_COUNT\",\n    LISTAGG(DISTINCT h.\"name\", ', ') WITHIN GROUP (ORDER BY h.\"name\") AS \"HURRICANE_NAMES\"\nFROM \"NOAA_DATA_PLUS\".\"NOAA_HURRICANES\".\"HURRICANES\" h,\n     \"NOAA_DATA_PLUS\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" z\nWHERE h.\"name\" != 'NOT_NAMED'\n  AND h.\"longitude\" BETWEEN -180 AND 180\n  AND h.\"latitude\" BETWEEN -90 AND 90\n  AND ST_WITHIN(\n    ST_MAKEPOINT(h.\"longitude\", h.\"latitude\"),\n    TO_GEOGRAPHY(z.\"zip_code_geom\")\n  )\nGROUP BY z.\"city\", z.\"zip_code\", z.\"state_code\"\nORDER BY \"HURRICANE_COUNT\" DESC" = sql%([ZIP_CODES_schema, HURRICANES_schema]) "SELECT\n  z.\"city\" AS \"city\",\n  z.\"zip_code\" AS \"zip_code\",\n  z.\"state_code\" AS \"STATE\",\n  COUNT(DISTINCT h.\"sid\") AS \"HURRICANE_COUNT\",\n  LISTAGG(DISTINCT h.\"name\", ', ') WITHIN GROUP (ORDER BY h.\"name\") AS \"HURRICANE_NAMES\"\nFROM \"NOAA_DATA_PLUS\".\"NOAA_HURRICANES\".\"HURRICANES\" h\nJOIN \"NOAA_DATA_PLUS\".\"GEO_US_BOUNDARIES\".\"ZIP_CODES\" z\n  ON ST_WITHIN(\n       ST_MAKEPOINT(\n         CASE WHEN h.\"longitude\" > 180 THEN h.\"longitude\" - 360 ELSE h.\"longitude\" END,\n         h.\"latitude\"\n       ),\n       TO_GEOGRAPHY(z.\"zip_code_geom\")\n     )\nWHERE h.\"name\" != 'NOT_NAMED'\nGROUP BY z.\"city\", z.\"zip_code\", z.\"state_code\"\nORDER BY \"HURRICANE_COUNT\" DESC, z.\"zip_code\" ASC;" := by
  first | sql_equiv | sorry

