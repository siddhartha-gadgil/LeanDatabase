import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local114 — crossskill equivalence(s)

Question: Provide a detailed web sales report for each region, including the number of orders, total sales amount, and the name and sales amount of all sales representatives who achieved the highest total sales amount in that region (include all representatives in case of a tie).

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local114

CREATE TABLE WEB_ORDERS («id» INT, «account_id» INT, «occurred_at» STRING, «standard_qty» INT, «gloss_qty» INT, «poster_qty» INT, «total» INT, «standard_amt_usd» FLOAT, «gloss_amt_usd» FLOAT, «poster_amt_usd» FLOAT, «total_amt_usd» FLOAT)
CREATE TABLE WEB_SALES_REPS («id» INT, «name» STRING, «region_id» INT)
CREATE TABLE WEB_ACCOUNTS («id» INT, «name» STRING, «website» STRING, «lat» FLOAT, «long» FLOAT, «primary_poc» STRING, «sales_rep_id» INT)
CREATE TABLE WEB_REGION («id» INT, «name» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([WEB_ORDERS_schema, WEB_SALES_REPS_schema, WEB_ACCOUNTS_schema, WEB_REGION_schema]) "WITH region_stats AS (\n    SELECT \n        r.\"name\" AS REGION_NAME,\n        COUNT(o.\"id\") AS TOTAL_REGION_ORDERS,\n        SUM(o.\"total_amt_usd\") AS TOTAL_REGION_SALES\n    FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ORDERS\" o\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ACCOUNTS\" a ON o.\"account_id\" = a.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_SALES_REPS\" sr ON a.\"sales_rep_id\" = sr.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_REGION\" r ON sr.\"region_id\" = r.\"id\"\n    GROUP BY r.\"name\"\n),\nrep_sales AS (\n    SELECT \n        r.\"name\" AS REGION_NAME,\n        sr.\"name\" AS REP_NAME,\n        SUM(o.\"total_amt_usd\") AS REP_TOTAL_SALES\n    FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ORDERS\" o\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ACCOUNTS\" a ON o.\"account_id\" = a.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_SALES_REPS\" sr ON a.\"sales_rep_id\" = sr.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_REGION\" r ON sr.\"region_id\" = r.\"id\"\n    GROUP BY r.\"name\", sr.\"name\"\n),\nmax_rep_sales AS (\n    SELECT REGION_NAME, MAX(REP_TOTAL_SALES) AS MAX_SALES\n    FROM rep_sales\n    GROUP BY REGION_NAME\n),\ntop_reps AS (\n    SELECT rs.REGION_NAME, rs.REP_NAME AS TOP_SALES_REP_NAME, rs.REP_TOTAL_SALES AS TOP_SALES_REP_SALES\n    FROM rep_sales rs\n    JOIN max_rep_sales mrs ON rs.REGION_NAME = mrs.REGION_NAME AND rs.REP_TOTAL_SALES = mrs.MAX_SALES\n)\nSELECT \n    rs.REGION_NAME,\n    rs.TOTAL_REGION_ORDERS,\n    rs.TOTAL_REGION_SALES,\n    tr.TOP_SALES_REP_NAME,\n    tr.TOP_SALES_REP_SALES\nFROM region_stats rs\nJOIN top_reps tr ON rs.REGION_NAME = tr.REGION_NAME\nORDER BY rs.REGION_NAME;") t ~= (sql%([WEB_ORDERS_schema, WEB_SALES_REPS_schema, WEB_ACCOUNTS_schema, WEB_REGION_schema]) "WITH rep_sales AS (\n    SELECT\n        r.\"name\" AS region_name,\n        sr.\"name\" AS rep_name,\n        COUNT(o.\"id\") AS num_orders,\n        COALESCE(SUM(o.\"total_amt_usd\"), 0) AS total_sales\n    FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_REGION\" r\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_SALES_REPS\" sr\n        ON sr.\"region_id\" = r.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ACCOUNTS\" a\n        ON a.\"sales_rep_id\" = sr.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ORDERS\" o\n        ON o.\"account_id\" = a.\"id\"\n    GROUP BY r.\"name\", sr.\"name\"\n),\nregion_totals AS (\n    SELECT\n        region_name,\n        SUM(num_orders) AS region_orders,\n        SUM(total_sales) AS region_total_sales\n    FROM rep_sales\n    GROUP BY region_name\n),\nranked_reps AS (\n    SELECT\n        region_name,\n        rep_name,\n        total_sales AS rep_total_sales,\n        RANK() OVER (PARTITION BY region_name ORDER BY total_sales DESC) AS rnk\n    FROM rep_sales\n)\nSELECT\n    rt.region_name,\n    rt.region_orders,\n    rt.region_total_sales,\n    rr.rep_name AS top_rep_name,\n    rr.rep_total_sales AS top_rep_total_sales\nFROM region_totals rt\nJOIN ranked_reps rr\n    ON rt.region_name = rr.region_name\n    AND rr.rnk = 1\nORDER BY rt.region_name, rr.rep_name;") t := by
  intro t; first | sql_equiv | sorry

