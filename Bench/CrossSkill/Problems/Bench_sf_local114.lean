    sql%([WEB_ORDERS_schema, WEB_SALES_REPS_schema, WEB_ACCOUNTS_schema, WEB_REGION_schema]) "WITH region_orders AS (\n    SELECT\n        r.\"name\" AS REGION_NAME,\n        COUNT(o.\"id\") AS TOTAL_REGION_ORDERS,\n        SUM(o.\"total_amt_usd\") AS TOTAL_REGION_SALES\n    FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_REGION\" r\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_SALES_REPS\" sr ON sr.\"region_id\" = r.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ACCOUNTS\" a ON a.\"sales_rep_id\" = sr.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ORDERS\" o ON o.\"account_id\" = a.\"id\"\n    GROUP BY r.\"name\"\n),\nrep_sales AS (\n    SELECT\n        r.\"name\" AS REGION_NAME,\n        sr.\"name\" AS SALES_REP_NAME,\n        SUM(o.\"total_amt_usd\") AS REP_SALES\n    FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_REGION\" r\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_SALES_REPS\" sr ON sr.\"region_id\" = r.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ACCOUNTS\" a ON a.\"sales_rep_id\" = sr.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ORDERS\" o ON o.\"account_id\" = a.\"id\"\n    GROUP BY r.\"name\", sr.\"name\"\n),\ntop_rep AS (\n    SELECT\n        REGION_NAME,\n        SALES_REP_NAME AS TOP_SALES_REP_NAME,\n        REP_SALES AS TOP_SALES_REP_SALES,\n        ROW_NUMBER() OVER (PARTITION BY REGION_NAME ORDER BY REP_SALES DESC) AS rn\n    FROM rep_sales\n)\nSELECT\n    ro.REGION_NAME,\n    ro.TOTAL_REGION_ORDERS,\n    ro.TOTAL_REGION_SALES,\n    tr.TOP_SALES_REP_NAME,\n    tr.TOP_SALES_REP_SALES\nFROM region_orders ro\nJOIN top_rep tr ON ro.REGION_NAME = tr.REGION_NAME AND tr.rn = 1\nORDER BY ro.REGION_NAME;" = sql%([WEB_ORDERS_schema, WEB_SALES_REPS_schema, WEB_ACCOUNTS_schema, WEB_REGION_schema]) "WITH region_orders AS (\n    SELECT\n        r.\"name\" AS REGION_NAME,\n        COUNT(o.\"id\") AS TOTAL_REGION_ORDERS,\n        SUM(o.\"total_amt_usd\") AS TOTAL_REGION_SALES\n    FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ORDERS\" o\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ACCOUNTS\" a\n        ON o.\"account_id\" = a.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_SALES_REPS\" sr\n        ON a.\"sales_rep_id\" = sr.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_REGION\" r\n        ON sr.\"region_id\" = r.\"id\"\n    GROUP BY r.\"name\"\n),\nrep_sales AS (\n    SELECT\n        r.\"name\" AS REGION_NAME,\n        sr.\"name\" AS SALES_REP_NAME,\n        SUM(o.\"total_amt_usd\") AS SALES_REP_SALES\n    FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ORDERS\" o\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_ACCOUNTS\" a\n        ON o.\"account_id\" = a.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_SALES_REPS\" sr\n        ON a.\"sales_rep_id\" = sr.\"id\"\n    JOIN \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"WEB_REGION\" r\n        ON sr.\"region_id\" = r.\"id\"\n    GROUP BY r.\"name\", sr.\"name\"\n),\ntop_reps AS (\n    SELECT\n        REGION_NAME,\n        SALES_REP_NAME,\n        SALES_REP_SALES,\n        RANK() OVER (PARTITION BY REGION_NAME ORDER BY SALES_REP_SALES DESC) AS rnk\n    FROM rep_sales\n)\nSELECT\n    ro.REGION_NAME,\n    ro.TOTAL_REGION_ORDERS,\n    ro.TOTAL_REGION_SALES,\n    tr.SALES_REP_NAME AS TOP_SALES_REP_NAME,\n    tr.SALES_REP_SALES AS TOP_SALES_REP_SALES\nFROM region_orders ro\nJOIN top_reps tr\n    ON ro.REGION_NAME = tr.REGION_NAME\nWHERE tr.rnk = 1\nORDER BY ro.REGION_NAME;" := by
