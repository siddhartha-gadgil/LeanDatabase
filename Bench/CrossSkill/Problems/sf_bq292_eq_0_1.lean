CREATE TABLE TRANSACTIONS («block_height» INT, «block_timestamp» STRING, «block_timestamp_truncated» INT, «txhash» STRING, «transaction_type» STRING, «gas_wanted» INT, «gas_used» INT, «sender» STRING, «fee» STRING, «memo» STRING)
CREATE TABLE OUTPUTS («transaction_hash» STRING, «block_hash» STRING, «block_number» INT, «block_timestamp» INT, «index» INT, «script_asm» STRING, «script_hex» STRING, «required_signatures» INT, «type» STRING, «addresses» STRING, «value» INT)

theorem eq (t0 : TableRel TRANSACTIONS_schema) (t1 : TableRel OUTPUTS_schema) :
    (sql%([TRANSACTIONS_schema, OUTPUTS_schema]) "WITH coinjoin_txns AS (SELECT DISTINCT t.\"hash\", t.\"block_timestamp_month\", t.\"input_count\", t.\"output_count\", t.\"input_value\", t.\"output_value\" FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" AS t, LATERAL UNNEST(input => t.\"outputs\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE t.\"block_timestamp_month\" >= '2023-07-01' AND t.\"is_coinbase\" = FALSE AND t.\"output_count\" > 2 AND t.\"output_value\" <= t.\"input_value\" AND CAST(JSON_EXTRACT_PATH(f.value, 'value') AS DECIMAL(38, 0)) > 0 GROUP BY t.\"hash\", t.\"block_timestamp_month\", t.\"input_count\", t.\"output_count\", t.\"input_value\", t.\"output_value\", CAST(JSON_EXTRACT_PATH(f.value, 'value') AS DECIMAL(38, 0)) HAVING COUNT(*) >= 2), monthly_coinjoin AS (SELECT \"block_timestamp_month\", COUNT(DISTINCT \"hash\") AS coinjoin_tx_count, SUM(\"input_count\") AS coinjoin_input_count, SUM(\"output_count\") AS coinjoin_output_count, SUM(\"input_value\") AS coinjoin_input_value FROM coinjoin_txns GROUP BY \"block_timestamp_month\"), monthly_totals AS (SELECT \"block_timestamp_month\", COUNT(*) AS total_tx_count, SUM(\"input_count\") AS total_input_count, SUM(\"output_count\") AS total_output_count, SUM(\"input_value\") AS total_input_value FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" WHERE \"block_timestamp_month\" >= '2023-07-01' GROUP BY \"block_timestamp_month\") SELECT CAST(c.coinjoin_tx_count * 100.0 AS DOUBLE PRECISION) / t.total_tx_count AS \"tx_percent\", CAST((CAST(c.coinjoin_input_count * 1.0 AS DOUBLE PRECISION) / t.total_input_count + CAST(c.coinjoin_output_count * 1.0 AS DOUBLE PRECISION) / t.total_output_count) AS DOUBLE PRECISION) / 2 * 100 AS \"utxos_percent\", CAST(c.coinjoin_input_value * 100.0 AS DOUBLE PRECISION) / t.total_input_value AS \"value_percent\" FROM monthly_coinjoin AS c JOIN monthly_totals AS t ON c.\"block_timestamp_month\" = t.\"block_timestamp_month\" ORDER BY c.\"block_timestamp_month\" DESC") t0 t1
  ~= (sql%([TRANSACTIONS_schema, OUTPUTS_schema]) "WITH coinjoin_tx AS (SELECT t.\"hash\", t.\"block_timestamp_month\" FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" AS t, LATERAL UNNEST(input => t.\"outputs\") AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE t.\"block_timestamp_month\" >= '2023-07-01' AND t.\"output_count\" > 2 AND t.\"output_value\" <= t.\"input_value\" GROUP BY t.\"hash\", t.\"block_timestamp_month\" HAVING COUNT(*) > COUNT(DISTINCT CAST(JSON_EXTRACT_PATH(f.value, 'value') AS DECIMAL(38, 0)))) SELECT CAST(100.0 * COUNT(CASE WHEN NOT cj.\"hash\" IS NULL THEN 1 END) AS DOUBLE PRECISION) / COUNT(*) AS tx_percent, CAST(100.0 * (CAST(SUM(CASE WHEN NOT cj.\"hash\" IS NULL THEN t.\"input_count\" ELSE 0 END) * 1.0 AS DOUBLE PRECISION) / SUM(t.\"input_count\") + CAST(SUM(CASE WHEN NOT cj.\"hash\" IS NULL THEN t.\"output_count\" ELSE 0 END) * 1.0 AS DOUBLE PRECISION) / SUM(t.\"output_count\")) AS DOUBLE PRECISION) / 2 AS utxos_percent, CAST(100.0 * SUM(CASE WHEN NOT cj.\"hash\" IS NULL THEN t.\"input_value\" ELSE 0 END) AS DOUBLE PRECISION) / SUM(t.\"input_value\") AS value_percent FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"TRANSACTIONS\" AS t LEFT JOIN coinjoin_tx AS cj ON t.\"hash\" = cj.\"hash\" WHERE t.\"block_timestamp_month\" >= '2023-07-01' GROUP BY t.\"block_timestamp_month\" ORDER BY t.\"block_timestamp_month\" DESC") t0 t1
