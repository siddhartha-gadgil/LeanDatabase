import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq005 — crossskill equivalence(s)

Question: Calculate the daily average Bitcoin block interval (in seconds) for 2023 by joining consecutive blocks via row-numbered self-joins (including cross-day intervals), excluding the genesis block, and list the first 10 dates with their unadjusted averages.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq005

CREATE TABLE BLOCKS («block_height» INT, «block_timestamp» STRING, «block_timestamp_truncated» INT, «block_hash» STRING, «proposer_address» STRING, «last_commit_hash» STRING, «data_hash» STRING, «validators_hash» STRING, «next_validators_hash» STRING, «consensus_hash» STRING, «app_hash» STRING, «last_results_hash» STRING, «evidence_hash» STRING, «signatures» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([BLOCKS_schema]) "WITH numbered AS (\n  SELECT \n    \"number\",\n    \"timestamp\",\n    ROW_NUMBER() OVER (ORDER BY \"number\") AS rn\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"BLOCKS\"\n  WHERE \"number\" > 0\n),\nintervals AS (\n  SELECT \n    DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) AS DATE,\n    (a.\"timestamp\" - b.\"timestamp\") / 1000000.0 AS block_interval_seconds\n  FROM numbered a\n  JOIN numbered b ON a.rn = b.rn + 1\n  WHERE DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) >= '2023-01-01'\n    AND DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) < '2024-01-01'\n)\nSELECT \n  DATE,\n  AVG(block_interval_seconds) AS MEAN_BLOCK_INTERVAL\nFROM intervals\nGROUP BY DATE\nORDER BY DATE\nLIMIT 10;") t ~= (sql%([BLOCKS_schema]) "WITH numbered AS (\n  SELECT\n    \"number\",\n    \"timestamp\",\n    DATE(TO_TIMESTAMP(\"timestamp\" / 1000000)) AS block_date,\n    ROW_NUMBER() OVER (ORDER BY \"number\") AS rn\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"BLOCKS\"\n  WHERE \"number\" > 0  -- exclude genesis block\n)\nSELECT\n  b.block_date AS \"DATE\",\n  AVG((b.\"timestamp\" - a.\"timestamp\") / 1000000) AS \"MEAN_BLOCK_INTERVAL\"\nFROM numbered a\nJOIN numbered b ON b.rn = a.rn + 1\nWHERE YEAR(b.block_date) = 2023\nGROUP BY b.block_date\nORDER BY b.block_date\nLIMIT 10;") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 :
    sql%([BLOCKS_schema]) "WITH numbered AS (\n  SELECT \n    \"number\",\n    \"timestamp\",\n    ROW_NUMBER() OVER (ORDER BY \"number\") AS rn\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"BLOCKS\"\n  WHERE \"number\" > 0\n),\nintervals AS (\n  SELECT \n    DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) AS DATE,\n    (a.\"timestamp\" - b.\"timestamp\") / 1000000.0 AS block_interval_seconds\n  FROM numbered a\n  JOIN numbered b ON a.rn = b.rn + 1\n  WHERE DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) >= '2023-01-01'\n    AND DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) < '2024-01-01'\n)\nSELECT \n  DATE,\n  AVG(block_interval_seconds) AS MEAN_BLOCK_INTERVAL\nFROM intervals\nGROUP BY DATE\nORDER BY DATE\nLIMIT 10;" = sql%([BLOCKS_schema]) "WITH numbered_blocks AS (\n  SELECT\n    \"number\",\n    \"timestamp\",\n    ROW_NUMBER() OVER (ORDER BY \"number\") AS rn\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"BLOCKS\"\n  WHERE \"number\" > 0\n),\nblock_intervals AS (\n  SELECT\n    b2.\"number\",\n    b2.\"timestamp\",\n    (b2.\"timestamp\" - b1.\"timestamp\") / 1000000.0 AS interval_seconds\n  FROM numbered_blocks b1\n  JOIN numbered_blocks b2\n    ON b2.rn = b1.rn + 1\n),\ndaily_avg AS (\n  SELECT\n    DATE(TO_TIMESTAMP(bi.\"timestamp\" / 1000000)) AS \"DATE\",\n    AVG(bi.interval_seconds) AS \"MEAN_BLOCK_INTERVAL\"\n  FROM block_intervals bi\n  WHERE DATE(TO_TIMESTAMP(bi.\"timestamp\" / 1000000)) >= '2023-01-01'\n    AND DATE(TO_TIMESTAMP(bi.\"timestamp\" / 1000000)) < '2024-01-01'\n  GROUP BY DATE(TO_TIMESTAMP(bi.\"timestamp\" / 1000000))\n)\nSELECT \"DATE\", \"MEAN_BLOCK_INTERVAL\"\nFROM daily_avg\nORDER BY \"DATE\"\nLIMIT 10;" := by
  first | sql_equiv | sorry

theorem eq_0_3 :
    sql%([BLOCKS_schema]) "WITH numbered AS (\n  SELECT \n    \"number\",\n    \"timestamp\",\n    ROW_NUMBER() OVER (ORDER BY \"number\") AS rn\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"BLOCKS\"\n  WHERE \"number\" > 0\n),\nintervals AS (\n  SELECT \n    DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) AS DATE,\n    (a.\"timestamp\" - b.\"timestamp\") / 1000000.0 AS block_interval_seconds\n  FROM numbered a\n  JOIN numbered b ON a.rn = b.rn + 1\n  WHERE DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) >= '2023-01-01'\n    AND DATE(TO_TIMESTAMP_NTZ(a.\"timestamp\" / 1000000)) < '2024-01-01'\n)\nSELECT \n  DATE,\n  AVG(block_interval_seconds) AS MEAN_BLOCK_INTERVAL\nFROM intervals\nGROUP BY DATE\nORDER BY DATE\nLIMIT 10;" = sql%([BLOCKS_schema]) "WITH numbered_blocks AS (\n  SELECT\n    \"number\",\n    \"timestamp\",\n    ROW_NUMBER() OVER (ORDER BY \"number\") AS rn\n  FROM \"CRYPTO\".\"CRYPTO_BITCOIN\".\"BLOCKS\"\n  WHERE \"number\" > 0\n),\nblock_intervals AS (\n  SELECT\n    DATE(TO_TIMESTAMP(b.\"timestamp\" / 1000000)) AS \"DATE\",\n    (b.\"timestamp\" - a.\"timestamp\") / 1000000.0 AS interval_seconds\n  FROM numbered_blocks b\n  JOIN numbered_blocks a\n    ON b.rn = a.rn + 1\n)\nSELECT\n  \"DATE\",\n  AVG(interval_seconds) AS \"MEAN_BLOCK_INTERVAL\"\nFROM block_intervals\nWHERE \"DATE\" >= '2023-01-01'\n  AND \"DATE\" < '2024-01-01'\nGROUP BY \"DATE\"\nORDER BY \"DATE\"\nLIMIT 10;" := by
  first | sql_equiv | sorry

