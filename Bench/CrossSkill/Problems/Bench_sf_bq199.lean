/-!
# sf_bq199 — crossskill equivalence(s)

Question: Identify the top 10 liquor categories in Iowa in 2021 by calculating, for each category, the average of the per-liter retail prices across all sales transactions in that category during 2021. For these top categories, provide their average per-liter retail prices calculated in the same manner for the years 2019, 2020, and 2021.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq199

CREATE TABLE SALES («invoice_and_item_number» STRING, «date» STRING, «store_number» STRING, «store_name» STRING, «address» STRING, «city» STRING, «zip_code» STRING, «store_location» STRING, «county_number» STRING, «county» STRING, «category» STRING, «category_name» STRING, «vendor_number» STRING, «vendor_name» STRING, «item_number» STRING, «item_description» STRING, «pack» INT, «bottle_volume_ml» INT, «state_bottle_cost» FLOAT, «state_bottle_retail» FLOAT, «bottles_sold» INT, «sale_dollars» FLOAT, «volume_sold_liters» FLOAT, «volume_sold_gallons» FLOAT)

HYPOTHESIS hyp0_1_0 : SALES "EXTRACT(YEAR FROM \"date\") IN (2019, 2020, 2021)"
HYPOTHESIS hyp0_1_1 : SALES "\"category_name\" IS NOT NULL"
HYPOTHESIS hyp0_1_2 : SALES "EXTRACT(YEAR FROM \"date\") = 2021"
HYPOTHESIS hyp0_1_3 : SALES "\"bottle_volume_ml\" > 0"
theorem eq_0_1 (t : TableRel SALES_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) (h3 : hyp0_1_3 t) :
    (sql%([SALES_schema]) "WITH per_liter_prices AS (\n  SELECT\n    \"category_name\",\n    EXTRACT(YEAR FROM \"date\") AS sale_year,\n    \"state_bottle_retail\" / (\"bottle_volume_ml\" / 1000.0) AS per_liter_retail_price\n  FROM \"IOWA_LIQUOR_SALES\".\"IOWA_LIQUOR_SALES\".\"SALES\"\n  WHERE EXTRACT(YEAR FROM \"date\") IN (2019, 2020, 2021)\n    AND \"category_name\" IS NOT NULL\n    AND \"bottle_volume_ml\" > 0\n),\ntop10_2021 AS (\n  SELECT\n    \"category_name\",\n    AVG(per_liter_retail_price) AS avg_price_2021\n  FROM per_liter_prices\n  WHERE sale_year = 2021\n  GROUP BY \"category_name\"\n  ORDER BY avg_price_2021 DESC\n  LIMIT 10\n)\nSELECT\n  t.\"category_name\" AS category,\n  AVG(CASE WHEN p.sale_year = 2019 THEN p.per_liter_retail_price END) AS avg_price_liter_2019,\n  AVG(CASE WHEN p.sale_year = 2020 THEN p.per_liter_retail_price END) AS avg_price_liter_2020,\n  AVG(CASE WHEN p.sale_year = 2021 THEN p.per_liter_retail_price END) AS avg_price_liter_2021\nFROM top10_2021 t\nLEFT JOIN per_liter_prices p\n  ON t.\"category_name\" = p.\"category_name\"\nGROUP BY t.\"category_name\"\nORDER BY avg_price_liter_2021 DESC;") t ~= (sql%([SALES_schema]) "WITH top10_2021 AS (\n    SELECT\n        \"category_name\" AS category,\n        AVG(\"state_bottle_retail\" / (\"bottle_volume_ml\" / 1000.0)) AS avg_price_liter_2021\n    FROM \"IOWA_LIQUOR_SALES\".\"IOWA_LIQUOR_SALES\".\"SALES\"\n    WHERE EXTRACT(YEAR FROM \"date\") = 2021\n      AND \"bottle_volume_ml\" > 0\n    GROUP BY \"category_name\"\n    ORDER BY avg_price_liter_2021 DESC\n    LIMIT 10\n),\nall_years AS (\n    SELECT\n        \"category_name\" AS category,\n        EXTRACT(YEAR FROM \"date\") AS yr,\n        AVG(\"state_bottle_retail\" / (\"bottle_volume_ml\" / 1000.0)) AS avg_price_per_liter\n    FROM \"IOWA_LIQUOR_SALES\".\"IOWA_LIQUOR_SALES\".\"SALES\"\n    WHERE EXTRACT(YEAR FROM \"date\") IN (2019, 2020, 2021)\n      AND \"bottle_volume_ml\" > 0\n      AND \"category_name\" IN (SELECT category FROM top10_2021)\n    GROUP BY \"category_name\", yr\n)\nSELECT\n    t.category,\n    MAX(CASE WHEN a.yr = 2019 THEN a.avg_price_per_liter END) AS avg_price_liter_2019,\n    MAX(CASE WHEN a.yr = 2020 THEN a.avg_price_per_liter END) AS avg_price_liter_2020,\n    t.avg_price_liter_2021\nFROM top10_2021 t\nLEFT JOIN all_years a ON t.category = a.category\nGROUP BY t.category, t.avg_price_liter_2021\nORDER BY t.avg_price_liter_2021 DESC;") t := by
  first | sql_equiv | sorry

