TRACT(YEAR FROM s.\"date\") = 2021 THEN CAST(s.\"state_bottle_retail\" AS DOUBLE PRECISION) / s.\"bottle_volume_ml\" * 1000 END) AS DECIMAL), 2) AS \"avg_price_liter_2021\" FROM \"IOWA_LIQUOR_SALES\".\"IOWA_LIQUOR_SALES\".\"SALES\" AS s JOIN top_categories AS tc ON s.\"category_name\" = tc.\"category_name\" WHERE EXTRACT(YEAR FROM s.\"date\") IN (2019, 2020, 2021) AND s.\"bottle_volume_ml\" > 0 GROUP BY s.\"category_name\" ORDER BY \"avg_price_liter_2021\" DESC") t := by
