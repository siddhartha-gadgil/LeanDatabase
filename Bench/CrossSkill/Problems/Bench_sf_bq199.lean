    (sql%([SALES_schema]) "WITH per_liter_prices AS (\n  SELECT\n    \"category_name\",\n    EXTRACT(YEAR FROM \"date\") AS sale_year,\n    \"state_bottle_retail\" / (\"bottle_volume_ml\" / 1000.0) AS per_liter_retail_price\n  FROM \"IOWA_LIQUOR_SALES\".\"IOWA_LIQUOR_SALES\".\"SALES\"\n  WHERE EXTRACT(YEAR FROM \"date\") IN (2019, 2020, 2021)\n    AND \"category_name\" IS NOT NULL\n    AND \"bottle_volume_ml\" > 0\n),\ntop10_2021 AS (\n  SELECT\n    \"category_name\",\n    AVG(per_liter_retail_price) AS avg_price_2021\n  FROM per_liter_prices\n  WHERE sale_year = 2021\n  GROUP BY \"category_name\"\n  ORDER BY avg_price_2021 DESC\n  LIMIT 10\n)\nSELECT\n  t.\"category_name\" AS category,\n  AVG(CASE WHEN p.sale_year = 2019 THEN p.per_liter_retail_price END) AS avg_price_liter_2019,\n  AVG(CASE WHEN p.sale_year = 2020 THEN p.per_liter_retail_price END) AS avg_price_liter_2020,\n  AVG(CASE WHEN p.sale_year = 2021 THEN p.per_liter_retail_price END) AS avg_price_liter_2021\nFROM top10_2021 t\nLEFT JOIN per_liter_prices p\n  ON t.\"category_name\" = p.\"category_name\"\nGROUP BY t.\"category_name\"\nORDER BY avg_price_liter_2021 DESC;") t ~= (sql%([SALES_schema]) "WITH top_categories AS (\n    SELECT\n        \"category_name\",\n        AVG(\"state_bottle_retail\" / \"bottle_volume_ml\" * 1000) AS avg_price_2021\n    FROM \"IOWA_LIQUOR_SALES\".\"IOWA_LIQUOR_SALES\".\"SALES\"\n    WHERE EXTRACT(YEAR FROM \"date\") = 2021\n      AND \"bottle_volume_ml\" > 0\n      AND \"category_name\" IS NOT NULL\n    GROUP BY \"category_name\"\n    ORDER BY avg_price_2021 DESC\n    LIMIT 10\n)\nSELECT\n    s.\"category_name\" AS \"category\",\n    ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.\"date\") = 2019 THEN s.\"state_bottle_retail\" / s.\"bottle_volume_ml\" * 1000 END), 2) AS \"avg_price_liter_2019\",\n    ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.\"date\") = 2020 THEN s.\"state_bottle_retail\" / s.\"bottle_volume_ml\" * 1000 END), 2) AS \"avg_price_liter_2020\",\n    ROUND(AVG(CASE WHEN EXTRACT(YEAR FROM s.\"date\") = 2021 THEN s.\"state_bottle_retail\" / s.\"bottle_volume_ml\" * 1000 END), 2) AS \"avg_price_liter_2021\"\nFROM \"IOWA_LIQUOR_SALES\".\"IOWA_LIQUOR_SALES\".\"SALES\" s\nJOIN top_categories tc ON s.\"category_name\" = tc.\"category_name\"\nWHERE EXTRACT(YEAR FROM s.\"date\") IN (2019, 2020, 2021)\n  AND s.\"bottle_volume_ml\" > 0\nGROUP BY s.\"category_name\"\nORDER BY \"avg_price_liter_2021\" DESC;") t := by
