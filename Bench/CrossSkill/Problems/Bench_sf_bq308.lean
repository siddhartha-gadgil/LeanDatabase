import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq308 — crossskill equivalence(s)

Question: Show the number of Stack Overflow questions asked each day of the week in 2021, and find out how many and what percentage of those were answered within one hour.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq308

CREATE TABLE POSTS_ANSWERS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» STRING, «answer_count» STRING, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» STRING, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» INT, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» STRING)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 : ∀ t,
    (sql%([POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH questions_2021 AS (\n  SELECT\n    \"id\" AS question_id,\n    TO_TIMESTAMP(\"creation_date\" / 1000000) AS question_ts,\n    DAYOFWEEK(TO_TIMESTAMP(\"creation_date\" / 1000000)) + 1 AS day_of_week\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) = 2021\n),\nfirst_answers AS (\n  SELECT\n    \"parent_id\" AS question_id,\n    MIN(TO_TIMESTAMP(\"creation_date\" / 1000000)) AS first_answer_ts\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n  GROUP BY \"parent_id\"\n),\ncombined AS (\n  SELECT\n    q.day_of_week,\n    q.question_id,\n    CASE\n      WHEN fa.first_answer_ts <= DATEADD('hour', 1, q.question_ts)\n      THEN 1\n      ELSE 0\n    END AS answered_in_1h\n  FROM questions_2021 q\n  LEFT JOIN first_answers fa ON q.question_id = fa.question_id\n)\nSELECT\n  day_of_week AS \"Day_of_Week\",\n  COUNT(*) AS \"Num_Questions\",\n  SUM(answered_in_1h) AS \"Num_Answered_in_1H\",\n  ROUND(SUM(answered_in_1h) * 100.0 / COUNT(*), 6) AS \"Percent_Answered_in_1H\"\nFROM combined\nGROUP BY day_of_week\nORDER BY day_of_week;") t ~= (sql%([POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "SELECT\n  DAYOFWEEK(TO_TIMESTAMP(q.\"creation_date\" / 1000000)) + 1 AS \"Day_of_Week\",\n  COUNT(DISTINCT q.\"id\") AS \"Num_Questions\",\n  COUNT(DISTINCT CASE\n    WHEN (a.\"creation_date\" - q.\"creation_date\") / 1000000 <= 3600\n    THEN q.\"id\"\n  END) AS \"Num_Answered_in_1H\",\n  ROUND(\n    COUNT(DISTINCT CASE\n      WHEN (a.\"creation_date\" - q.\"creation_date\") / 1000000 <= 3600\n      THEN q.\"id\"\n    END) * 100.0 / COUNT(DISTINCT q.\"id\"),\n    6\n  ) AS \"Percent_Answered_in_1H\"\nFROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\nLEFT JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n  ON a.\"parent_id\" = q.\"id\"\n  AND (a.\"creation_date\" - q.\"creation_date\") / 1000000 <= 3600\nWHERE EXTRACT(YEAR FROM TO_TIMESTAMP(q.\"creation_date\" / 1000000)) = 2021\nGROUP BY \"Day_of_Week\"\nORDER BY \"Day_of_Week\";") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH questions_2021 AS (\n  SELECT\n    \"id\" AS question_id,\n    TO_TIMESTAMP(\"creation_date\" / 1000000) AS question_ts,\n    DAYOFWEEK(TO_TIMESTAMP(\"creation_date\" / 1000000)) + 1 AS day_of_week\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) = 2021\n),\nfirst_answers AS (\n  SELECT\n    \"parent_id\" AS question_id,\n    MIN(TO_TIMESTAMP(\"creation_date\" / 1000000)) AS first_answer_ts\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\"\n  GROUP BY \"parent_id\"\n),\ncombined AS (\n  SELECT\n    q.day_of_week,\n    q.question_id,\n    CASE\n      WHEN fa.first_answer_ts <= DATEADD('hour', 1, q.question_ts)\n      THEN 1\n      ELSE 0\n    END AS answered_in_1h\n  FROM questions_2021 q\n  LEFT JOIN first_answers fa ON q.question_id = fa.question_id\n)\nSELECT\n  day_of_week AS \"Day_of_Week\",\n  COUNT(*) AS \"Num_Questions\",\n  SUM(answered_in_1h) AS \"Num_Answered_in_1H\",\n  ROUND(SUM(answered_in_1h) * 100.0 / COUNT(*), 6) AS \"Percent_Answered_in_1H\"\nFROM combined\nGROUP BY day_of_week\nORDER BY day_of_week;") t ~= (sql%([POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH questions_2021 AS (\n    SELECT\n        \"id\" AS question_id,\n        \"creation_date\" AS q_creation_date,\n        DAYOFWEEK(TO_TIMESTAMP(\"creation_date\" / 1000000)) + 1 AS day_of_week\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\"\n    WHERE YEAR(TO_TIMESTAMP(\"creation_date\" / 1000000)) = 2021\n),\nanswered_within_hour AS (\n    SELECT DISTINCT q.question_id\n    FROM questions_2021 q\n    INNER JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n        ON a.\"parent_id\" = q.question_id\n    WHERE (a.\"creation_date\" - q.q_creation_date) <= 3600000000\n      AND (a.\"creation_date\" - q.q_creation_date) >= 0\n)\nSELECT\n    q.day_of_week AS Day_of_Week,\n    COUNT(*) AS Num_Questions,\n    COUNT(ah.question_id) AS Num_Questions_Answered_Within_1_Hour,\n    ROUND(COUNT(ah.question_id) * 100.0 / COUNT(*), 2) AS Percentage_Answered_Within_1_Hour\nFROM questions_2021 q\nLEFT JOIN answered_within_hour ah\n    ON q.question_id = ah.question_id\nGROUP BY q.day_of_week\nORDER BY q.day_of_week;") t := by
  intro t; first | sql_equiv | sorry

