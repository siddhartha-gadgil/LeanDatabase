/-!
# sf_local253 — crossskill equivalence(s)

Question: Using a Salary Dataset where the salary values need to be cleaned by removing non-numeric characters and converting them to a numeric type, write a detailed SQL query that identifies the top 5 companies by average salary in each of Mumbai, Pune, New Delhi, and Hyderabad, then compares each company’s average salary in those cities to the overall national average salary. The final result should display four columns: Location, Company Name, Average Salary in State, and Average Salary in Country, listing only the top 5 companies in each of the specified locations.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local253

CREATE TABLE SALARYDATASET («index» INT, «CompanyName» STRING, «JobTitle» STRING, «SalariesReported» FLOAT, «Location» STRING, «Salary» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([SALARYDATASET_schema]) "WITH cleaned AS (\n  SELECT \n    \"Location\",\n    \"CompanyName\",\n    CASE \n      WHEN \"Salary\" LIKE '%/yr%' THEN TRY_TO_NUMBER(REGEXP_REPLACE(\"Salary\", '[^0-9]', ''))\n      WHEN \"Salary\" LIKE '%/mo%' THEN TRY_TO_NUMBER(REGEXP_REPLACE(\"Salary\", '[^0-9]', '')) * 12\n      WHEN \"Salary\" LIKE '%/hr%' THEN TRY_TO_NUMBER(REGEXP_REPLACE(\"Salary\", '[^0-9]', '')) * 2080\n    END AS salary_num\n  FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"SALARYDATASET\"\n),\nnational_avg AS (\n  SELECT AVG(salary_num) AS avg_salary_country\n  FROM cleaned\n),\ncity_company_avg AS (\n  SELECT \n    \"Location\",\n    \"CompanyName\",\n    AVG(salary_num) AS avg_salary_state,\n    ROW_NUMBER() OVER (PARTITION BY \"Location\" ORDER BY AVG(salary_num) DESC) AS rn\n  FROM cleaned\n  WHERE \"Location\" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')\n  GROUP BY \"Location\", \"CompanyName\"\n)\nSELECT \n  c.\"Location\" AS \"Location\",\n  c.\"CompanyName\" AS \"Company Name\",\n  c.avg_salary_state AS \"Average Salary in State\",\n  n.avg_salary_country AS \"Average Salary in Country\"\nFROM city_company_avg c\nCROSS JOIN national_avg n\nWHERE c.rn <= 5\nORDER BY c.\"Location\" ASC, c.avg_salary_state DESC;") t ~= (sql%([SALARYDATASET_schema]) "WITH cleaned AS (\n  SELECT \n    \"Location\",\n    \"CompanyName\",\n    CASE \n      WHEN \"Salary\" LIKE '%/mo' THEN CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '') AS FLOAT) * 12\n      WHEN \"Salary\" LIKE '%/hr' THEN CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '') AS FLOAT) * 2080\n      ELSE CAST(REGEXP_REPLACE(\"Salary\", '[^0-9]', '') AS FLOAT)\n    END AS salary_numeric\n  FROM \"EDUCATION_BUSINESS\".\"EDUCATION_BUSINESS\".\"SALARYDATASET\"\n),\ncountry_avg AS (\n  SELECT AVG(salary_numeric) AS avg_country FROM cleaned\n),\ncompany_location_avg AS (\n  SELECT \n    \"Location\",\n    \"CompanyName\",\n    AVG(salary_numeric) AS avg_salary_state,\n    ROW_NUMBER() OVER (PARTITION BY \"Location\" ORDER BY AVG(salary_numeric) DESC, \"CompanyName\" ASC) AS rn\n  FROM cleaned\n  WHERE \"Location\" IN ('Mumbai', 'Pune', 'New Delhi', 'Hyderabad')\n  GROUP BY \"Location\", \"CompanyName\"\n)\nSELECT \n  c.\"Location\" AS \"Location\",\n  c.\"CompanyName\" AS \"Company Name\",\n  c.avg_salary_state AS \"Average Salary in State\",\n  ca.avg_country AS \"Average Salary in Country\"\nFROM company_location_avg c\nCROSS JOIN country_avg ca\nWHERE c.rn <= 5\nORDER BY c.\"Location\" ASC, c.avg_salary_state DESC, c.\"CompanyName\" ASC;") t := by
  intro t; first | sql_equiv | sorry

