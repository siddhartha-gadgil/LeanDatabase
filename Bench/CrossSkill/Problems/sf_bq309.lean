/-!
# sf_bq309 — crossskill equivalence(s)

Question: Retrieve the top 10 longest questions on Stack Overflow, measured by the length of their body text, where each question either has an accepted answer or has no accepted answer but has at least one answer with a score-to-view ratio exceeding 0.01. For each of these questions, include the reputation of the user who asked the question, the user's net votes (calculated as their total up_votes minus down_votes), and the total number of badges the user has earned.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq309

CREATE TABLE USERS («id» INT, «display_name» STRING, «about_me» STRING, «age» STRING, «creation_date» INT, «last_access_date» INT, «location» STRING, «reputation» INT, «up_votes» INT, «down_votes» INT, «views» INT, «profile_image_url» STRING, «website_url» STRING)
CREATE TABLE BADGES («id» INT, «name» STRING, «date» INT, «user_id» INT, «class» INT, «tag_based» BOOL)
CREATE TABLE POSTS_ANSWERS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» STRING, «answer_count» STRING, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» STRING, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» INT, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» STRING)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

theorem eq_0_1 : ∀ t,
    (sql%([USERS_schema, BADGES_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH qualified_questions AS (/* Questions with an accepted answer */ SELECT q.\"id\", LENGTH(q.\"body\") AS body_len, q.\"owner_user_id\" FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q WHERE NOT q.\"accepted_answer_id\" IS NULL UNION /* Questions without accepted answer but with at least one answer with score/view ratio > 0.01 */ SELECT DISTINCT q.\"id\", LENGTH(q.\"body\") AS body_len, q.\"owner_user_id\" FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" AS a ON a.\"parent_id\" = q.\"id\" WHERE q.\"accepted_answer_id\" IS NULL AND q.\"view_count\" > 0 AND CAST(a.\"score\" AS DOUBLE PRECISION) / q.\"view_count\" > 0.01), top10 AS (SELECT * FROM qualified_questions ORDER BY body_len DESC LIMIT 10), badge_counts AS (SELECT \"user_id\", COUNT(*) AS badge_number FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"BADGES\" GROUP BY \"user_id\") SELECT t.\"id\", u.\"reputation\", u.\"up_votes\" - u.\"down_votes\" AS net_votes, COALESCE(b.badge_number, 0) AS badge_number FROM top10 AS t LEFT JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" AS u ON t.\"owner_user_id\" = u.\"id\" LEFT JOIN badge_counts AS b ON t.\"owner_user_id\" = b.\"user_id\" ORDER BY t.body_len DESC") t ~= (sql%([USERS_schema, BADGES_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH qualifying_questions AS (/* Questions with accepted answer */ SELECT \"id\", \"body\", \"owner_user_id\" FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" WHERE NOT \"accepted_answer_id\" IS NULL UNION /* Questions without accepted answer but with at least one answer */ /* where answer.score / question.view_count > 0.01 */ SELECT DISTINCT q.\"id\", q.\"body\", q.\"owner_user_id\" FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" AS a ON a.\"parent_id\" = q.\"id\" WHERE q.\"accepted_answer_id\" IS NULL AND q.\"view_count\" > 0 AND CAST(a.\"score\" AS DOUBLE PRECISION) / q.\"view_count\" > 0.01), badge_counts AS (SELECT \"user_id\", COUNT(*) AS badge_number FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"BADGES\" GROUP BY \"user_id\") SELECT qq.\"id\" AS \"id\", u.\"reputation\" AS \"reputation\", u.\"up_votes\" - u.\"down_votes\" AS \"net_votes\", COALESCE(bc.badge_number, 0) AS \"badge_number\" FROM qualifying_questions AS qq JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" AS u ON u.\"id\" = qq.\"owner_user_id\" LEFT JOIN badge_counts AS bc ON bc.\"user_id\" = qq.\"owner_user_id\" ORDER BY LENGTH(qq.\"body\") DESC LIMIT 10") t := by
  intro t; first | sql_equiv | sorry

