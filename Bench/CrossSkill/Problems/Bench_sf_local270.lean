import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_local270 — crossskill equivalence(s)

Question: Which top-level packaging containers, meaning those not contained within any other packaging, have any item for which the total quantity accumulated across all nested levels in the hierarchy exceeds 500, and what are the names of both these containers and the corresponding items?

NOTE: uses WITH RECURSIVE / LATERAL / FLATTEN — may not elaborate yet.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local270

CREATE TABLE PACKAGING_RELATIONS («packaging_id» INT, «contains_id» INT, «qty» INT)
CREATE TABLE PACKAGING («id» INT, «name» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([PACKAGING_RELATIONS_schema, PACKAGING_schema]) "WITH RECURSIVE hierarchy AS (\n    -- Anchor: start from top-level containers (not contained by anything)\n    SELECT \n        p.\"id\" AS root_id,\n        p.\"name\" AS root_name,\n        pr.\"contains_id\" AS current_id,\n        pr.\"qty\" AS total_qty\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" p\n    JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" pr \n        ON p.\"id\" = pr.\"packaging_id\"\n    WHERE p.\"id\" NOT IN (\n        SELECT DISTINCT \"contains_id\" \n        FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\"\n    )\n    \n    UNION ALL\n    \n    -- Recursive: traverse down, multiply quantities at each level\n    SELECT\n        h.root_id,\n        h.root_name,\n        pr.\"contains_id\" AS current_id,\n        h.total_qty * pr.\"qty\" AS total_qty\n    FROM hierarchy h\n    JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" pr \n        ON h.current_id = pr.\"packaging_id\"\n),\n-- Aggregate: sum quantities across all paths from root to same leaf item\nitem_totals AS (\n    SELECT \n        h.root_name AS CONTAINER_NAME,\n        p.\"name\" AS ITEM_NAME,\n        SUM(h.total_qty) AS TOTAL_QUANTITY\n    FROM hierarchy h\n    JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" p \n        ON h.current_id = p.\"id\"\n    -- Items are leaf nodes: not a parent in any relation\n    WHERE h.current_id NOT IN (\n        SELECT DISTINCT \"packaging_id\" \n        FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\"\n    )\n    GROUP BY h.root_name, p.\"name\"\n)\nSELECT \n    CONTAINER_NAME,\n    ITEM_NAME,\n    TOTAL_QUANTITY\nFROM item_totals\nWHERE TOTAL_QUANTITY > 500\nORDER BY TOTAL_QUANTITY DESC;") t ~= (sql%([PACKAGING_RELATIONS_schema, PACKAGING_schema]) "WITH top_level AS (\n    -- Top-level containers: ids that never appear as contains_id\n    SELECT \"id\"\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\"\n    WHERE \"id\" NOT IN (\n        SELECT \"contains_id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\"\n    )\n),\nleaf_items AS (\n    -- Leaf items: ids that never appear as packaging_id\n    SELECT \"id\"\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\"\n    WHERE \"id\" NOT IN (\n        SELECT \"packaging_id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\"\n    )\n),\nrec AS (\n    -- Anchor: start from each top-level container, walking into its direct children\n    SELECT\n        t.\"id\" AS top_level_id,\n        r.\"contains_id\" AS current_id,\n        r.\"qty\" AS accumulated_qty\n    FROM top_level t\n    JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" r\n        ON r.\"packaging_id\" = t.\"id\"\n\n    UNION ALL\n\n    -- Recursive step: walk further down the hierarchy, multiplying quantities\n    SELECT\n        rec.top_level_id,\n        r.\"contains_id\" AS current_id,\n        rec.accumulated_qty * r.\"qty\" AS accumulated_qty\n    FROM rec\n    JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" r\n        ON r.\"packaging_id\" = rec.current_id\n)\nSELECT\n    p_top.\"name\" AS CONTAINER_NAME,\n    p_leaf.\"name\" AS ITEM_NAME,\n    SUM(rec.accumulated_qty) AS TOTAL_QUANTITY\nFROM rec\nJOIN leaf_items li ON rec.current_id = li.\"id\"\nJOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" p_top ON p_top.\"id\" = rec.top_level_id\nJOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" p_leaf ON p_leaf.\"id\" = rec.current_id\nGROUP BY p_top.\"name\", p_leaf.\"name\"\nHAVING SUM(rec.accumulated_qty) > 500\nORDER BY TOTAL_QUANTITY DESC;") t := by
  intro t; first | sql_equiv | sorry

