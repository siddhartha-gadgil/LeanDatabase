    (sql%([PACKAGING_RELATIONS_schema, PACKAGING_schema]) "WITH RECURSIVE\n-- Identify items (leaves): packaging ids that never appear as packaging_id in relations\nitems AS (\n    SELECT \"id\" AS item_id\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" p\n    WHERE NOT EXISTS (\n        SELECT 1 FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" r\n        WHERE r.\"packaging_id\" = p.\"id\"\n    )\n),\n-- Identify top-level containers: packaging ids that never appear as contains_id in relations\ntop_level AS (\n    SELECT \"id\" AS container_id\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" p\n    WHERE NOT EXISTS (\n        SELECT 1 FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" r\n        WHERE r.\"contains_id\" = p.\"id\"\n    )\n),\n-- Recursive traversal from top-level containers down to items\n-- Track: top-level container, current node, cumulative quantity\nhierarchy AS (\n    -- Base: top-level containers contain themselves with qty 1\n    SELECT\n        t.container_id AS top_container_id,\n        t.container_id AS current_id,\n        1 AS cumulative_qty\n    FROM top_level t\n\n    UNION ALL\n\n    -- Recurse: follow packaging_relations\n    SELECT\n        h.top_container_id,\n        r.\"contains_id\" AS current_id,\n        h.cumulative_qty * r.\"qty\" AS cumulative_qty\n    FROM hierarchy h\n    JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" r\n        ON r.\"packaging_id\" = h.current_id\n)\n-- Final: for each top-level container, sum up quantities of each item\nSELECT\n    pc.\"name\" AS \"CONTAINER_NAME\",\n    pi.\"name\" AS \"ITEM_NAME\",\n    SUM(h.cumulative_qty) AS \"TOTAL_QUANTITY\"\nFROM hierarchy h\nJOIN items i ON h.current_id = i.item_id\nJOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" pc ON pc.\"id\" = h.top_container_id\nJOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" pi ON pi.\"id\" = h.current_id\nGROUP BY pc.\"name\", pi.\"name\"\nHAVING SUM(h.cumulative_qty) > 500\nORDER BY SUM(h.cumulative_qty) DESC;") t ~= (sql%([PACKAGING_RELATIONS_schema, PACKAGING_schema]) "WITH RECURSIVE hierarchy AS (\n    -- Base case: top-level containers directly contain something\n    -- Top-level = packaging_id that never appears as contains_id\n    SELECT\n        pr.\"packaging_id\" AS top_level_id,\n        pr.\"contains_id\" AS current_id,\n        pr.\"qty\" AS total_qty\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" pr\n    WHERE pr.\"packaging_id\" NOT IN (\n        SELECT DISTINCT \"contains_id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\"\n    )\n\n    UNION ALL\n\n    -- Recursive case: follow the hierarchy down\n    SELECT\n        h.top_level_id,\n        pr.\"contains_id\" AS current_id,\n        h.total_qty * pr.\"qty\" AS total_qty\n    FROM hierarchy h\n    JOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\" pr\n        ON h.current_id = pr.\"packaging_id\"\n),\n-- Items are packaging entries that don't contain anything else (leaf nodes)\nitems AS (\n    SELECT \"id\"\n    FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\"\n    WHERE \"id\" NOT IN (\n        SELECT DISTINCT \"packaging_id\" FROM \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING_RELATIONS\"\n    )\n)\nSELECT\n    tp.\"name\" AS container_name,\n    ip.\"name\" AS item_name,\n    SUM(h.total_qty) AS total_quantity\nFROM hierarchy h\nJOIN items i ON h.current_id = i.\"id\"\nJOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" tp ON h.top_level_id = tp.\"id\"\nJOIN \"ORACLE_SQL\".\"ORACLE_SQL\".\"PACKAGING\" ip ON h.current_id = ip.\"id\"\nGROUP BY tp.\"name\", ip.\"name\"\nHAVING SUM(h.total_qty) > 500\nORDER BY total_quantity DESC;") t := by
  intro t; first | sql_equiv | sorry

end Bench_sf_local270
