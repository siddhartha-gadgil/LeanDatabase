CREATE TABLE LEGISLATORS («full_name» STRING, «first_name» STRING, «last_name» STRING, «middle_name» STRING, «nickname» STRING, «suffix» STRING, «other_names_end» STRING, «other_names_middle» STRING, «other_names_last» STRING, «birthday» STRING, «gender» STRING, «id_bioguide» STRING, «id_bioguide_previous_0» STRING, «id_govtrack» INT, «id_icpsr» FLOAT, «id_wikipedia» STRING, «id_wikidata» STRING, «id_google_entity_id» STRING, «id_house_history» FLOAT, «id_house_history_alternate» FLOAT, «id_thomas» FLOAT, «id_cspan» FLOAT, «id_votesmart» FLOAT, «id_lis» STRING, «id_ballotpedia» STRING, «id_opensecrets» STRING, «id_fec_0» STRING, «id_fec_1» STRING, «id_fec_2» STRING)
CREATE TABLE LEGISLATORS_TERMS («id_bioguide» STRING, «term_number» INT, «term_id» STRING, «term_type» STRING, «term_start» STRING, «term_end» STRING, «state» STRING, «district» FLOAT, «class» FLOAT, «party» STRING, «how» STRING, «url» STRING, «address» STRING, «phone» STRING, «fax» STRING, «contact_form» STRING, «office» STRING, «state_rank» STRING, «rss_url» STRING, «caucus» STRING)

theorem eq (t0 : TableRel LEGISLATORS_schema) (t1 : TableRel LEGISLATORS_TERMS_schema) :
    (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "/* Cohort retention analysis for legislators by state and gender */ /* A legislator's cohort is defined by their first term (term_number=0) state and gender. */ /* Check retention at 0, 2, 4, 6, 8, 10 years after first term start on Dec 31 of that year. */ /* Return states where BOTH male and female cohorts have non-zero retention at ALL 6 intervals. */ WITH first_terms AS (/* Get each legislator's first term info (cohort assignment) */ SELECT t.\"id_bioguide\", l.\"gender\", t.\"state\", CAST(t.\"term_start\" AS DATE) AS first_term_start, EXTRACT(YEAR FROM CAST(t.\"term_start\" AS DATE)) AS first_year FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON t.\"id_bioguide\" = l.\"id_bioguide\" WHERE t.\"term_number\" = 0), intervals /* Generate the 6 check intervals */ AS (SELECT column1 AS years_after FROM (VALUES (0), (2), (4), (6), (8), (10))), legislator_checks /* For each legislator, generate check dates at each interval */ AS (SELECT ft.\"id_bioguide\", ft.\"gender\", ft.\"state\", i.years_after, DATE_FROM_PARTS(ft.first_year + i.years_after, 12, 31) AS check_date FROM first_terms AS ft CROSS JOIN intervals AS i), retention /* Check if a legislator is retained (serving on the check date) */ /* A legislator is retained if ANY of their terms covers the check date */ AS (SELECT lc.\"id_bioguide\", lc.\"gender\", lc.\"state\", lc.years_after, MAX(CASE WHEN CAST(t.\"term_start\" AS DATE) <= lc.check_date AND CAST(t.\"term_end\" AS DATE) >= lc.check_date THEN 1 ELSE 0 END) AS is_retained FROM legislator_checks AS lc LEFT JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS t ON lc.\"id_bioguide\" = t.\"id_bioguide\" GROUP BY lc.\"id_bioguide\", lc.\"gender\", lc.\"state\", lc.years_after), state_gender_retention /* Aggregate retention rate per state, gender, and interval */ AS (SELECT \"state\", \"gender\", years_after, SUM(is_retained) AS retained_count, COUNT(*) AS cohort_size, CAST(SUM(is_retained) * 1.0 AS DOUBLE PRECISION) / COUNT(*) AS retention_rate FROM retention GROUP BY \"state\", \"gender\", years_after), qualifying_states /* Find states where BOTH genders have non-zero retention at ALL 6 intervals */ /* Each state needs 2 genders × 6 intervals = 12 rows with retention_rate > 0 */ AS (SELECT \"state\" FROM state_gender_retention WHERE retention_rate > 0 AND \"gender\" IN ('M', 'F') GROUP BY \"state\" HAVING COUNT(DISTINCT \"gender\" || '_' || years_after) = 12) SELECT \"state\" FROM qualifying_states ORDER BY \"state\"") t0 t1
  ~= (sql%([LEGISLATORS_schema, LEGISLATORS_TERMS_schema]) "WITH first_terms AS (/* Find each legislator's first term start date and state from that first term */ SELECT \"id_bioguide\", \"state\", first_term_start, \"gender\" FROM (/* Find each legislator's first term start date and state from that first term */ SELECT lt.\"id_bioguide\", lt.\"state\", CAST(lt.\"term_start\" AS DATE) AS first_term_start, l.\"gender\", ROW_NUMBER() OVER (PARTITION BY lt.\"id_bioguide\" ORDER BY CAST(lt.\"term_start\" AS DATE)) AS _w, lt.\"term_start\" FROM \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS lt JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS\" AS l ON lt.\"id_bioguide\" = l.\"id_bioguide\") AS _t WHERE _w = 1), intervals AS (SELECT 0 AS yr_interval UNION ALL SELECT 2 UNION ALL SELECT 4 UNION ALL SELECT 6 UNION ALL SELECT 8 UNION ALL SELECT 10), cohort_checks AS (/* For each legislator and interval, check if they are retained */ SELECT ft.\"id_bioguide\", ft.\"state\", ft.\"gender\", i.yr_interval, DATE_FROM_PARTS(EXTRACT(YEAR FROM ft.first_term_start) + i.yr_interval, 12, 31) AS check_date, MAX(CASE WHEN CAST(lt.\"term_start\" AS DATE) <= DATE_FROM_PARTS(EXTRACT(YEAR FROM ft.first_term_start) + i.yr_interval, 12, 31) AND CAST(lt.\"term_end\" AS DATE) >= DATE_FROM_PARTS(EXTRACT(YEAR FROM ft.first_term_start) + i.yr_interval, 12, 31) THEN 1 ELSE 0 END) AS is_retained FROM first_terms AS ft CROSS JOIN intervals AS i LEFT JOIN \"CITY_LEGISLATION\".\"CITY_LEGISLATION\".\"LEGISLATORS_TERMS\" AS lt ON ft.\"id_bioguide\" = lt.\"id_bioguide\" GROUP BY ft.\"id_bioguide\", ft.\"state\", ft.\"gender\", i.yr_interval, ft.first_term_start), retention_rates AS (/* Compute retention rate per state, gender, interval */ SELECT \"state\", \"gender\", yr_interval, CAST(SUM(is_retained) * 1.0 AS DOUBLE PRECISION) / COUNT(*) AS retention_rate FROM cohort_checks GROUP BY \"state\", \"gender\", yr_interval), states_with_both /* Find states where BOTH M and F have retention_rate > 0 at ALL 6 intervals */ AS (SELECT \"state\", \"gender\", COUNT(*) AS intervals_with_retention FROM retention_rates WHERE retention_rate > 0 GROUP BY \"state\", \"gender\" HAVING COUNT(*) = 6 /* all 6 intervals (0,2,4,6,8,10) */) SELECT \"state\" FROM states_with_both WHERE \"gender\" IN ('M', 'F') GROUP BY \"state\" HAVING COUNT(DISTINCT \"gender\") = 2 ORDER BY \"state\"") t0 t1
  := by first | sql_equiv | sorry

end N_sf_local170_eq_1_2
