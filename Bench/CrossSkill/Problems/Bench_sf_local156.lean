/-!
# sf_local156 — crossskill equivalence(s)

Question: Analyze the annual average purchase price per Bitcoin by region, computed as the total dollar amount spent divided by the total quantity purchased each year, excluding the first year's data for each region. Then, for each year, rank the regions based on these average purchase prices, and calculate the annual percentage change in cost for each region compared to the previous year.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local156

CREATE TABLE BITCOIN_PRICES («ticker» STRING, «market_date» STRING, «price» FLOAT, «open» FLOAT, «high» FLOAT, «low» FLOAT, «volume» STRING, «change» STRING)
CREATE TABLE BITCOIN_TRANSACTIONS («txn_id» INT, «member_id» STRING, «ticker» STRING, «txn_date» STRING, «txn_type» STRING, «quantity» FLOAT, «percentage_fee» FLOAT, «txn_time» STRING)
CREATE TABLE BITCOIN_MEMBERS («member_id» STRING, «first_name» STRING, «region» STRING)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([BITCOIN_PRICES_schema, BITCOIN_TRANSACTIONS_schema, BITCOIN_MEMBERS_schema]) "WITH buy_data AS (\n    SELECT\n        m.\"region\",\n        EXTRACT(YEAR FROM TO_DATE(t.\"txn_date\", 'DD-MM-YYYY')) AS year_val,\n        t.\"quantity\" * p.\"price\" AS dollar_amount,\n        t.\"quantity\"\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_TRANSACTIONS\" t\n    JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_MEMBERS\" m\n        ON t.\"member_id\" = m.\"member_id\"\n    JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_PRICES\" p\n        ON t.\"txn_date\" = p.\"market_date\"\n        AND t.\"ticker\" = p.\"ticker\"\n    WHERE t.\"txn_type\" = 'BUY'\n      AND t.\"ticker\" = 'BTC'\n),\nannual_avg AS (\n    SELECT\n        \"region\",\n        year_val,\n        SUM(dollar_amount) / SUM(\"quantity\") AS btc_dca\n    FROM buy_data\n    GROUP BY \"region\", year_val\n),\nfirst_year AS (\n    SELECT\n        \"region\",\n        MIN(year_val) AS min_year\n    FROM annual_avg\n    GROUP BY \"region\"\n),\nfiltered AS (\n    SELECT\n        a.\"region\",\n        a.year_val,\n        a.btc_dca\n    FROM annual_avg a\n    JOIN first_year f ON a.\"region\" = f.\"region\"\n    WHERE a.year_val > f.min_year\n),\nwith_lag AS (\n    SELECT\n        f.\"region\",\n        f.year_val,\n        f.btc_dca,\n        LAG(f.btc_dca) OVER (PARTITION BY f.\"region\" ORDER BY f.year_val) AS prev_btc_dca\n    FROM annual_avg f\n),\nfinal AS (\n    SELECT\n        fl.year_val AS \"YEAR_START\",\n        fl.\"region\" AS \"REGION\",\n        ROUND(fl.btc_dca, 2) AS \"BTC_DCA\",\n        RANK() OVER (PARTITION BY fl.year_val ORDER BY fl.btc_dca ASC) AS \"DCA_RANKING\",\n        ROUND(\n            (fl.btc_dca - wl.prev_btc_dca) / wl.prev_btc_dca * 100,\n            2\n        ) AS \"DCA_PERCENTAGE_CHANGE\"\n    FROM filtered fl\n    JOIN with_lag wl ON fl.\"region\" = wl.\"region\" AND fl.year_val = wl.year_val\n)\nSELECT\n    \"YEAR_START\",\n    \"REGION\",\n    \"BTC_DCA\",\n    \"DCA_RANKING\",\n    \"DCA_PERCENTAGE_CHANGE\"\nFROM final\nORDER BY \"REGION\", \"YEAR_START\";" = sql%([BITCOIN_PRICES_schema, BITCOIN_TRANSACTIONS_schema, BITCOIN_MEMBERS_schema]) "WITH avg_prices AS (\n    SELECT \n        m.\"region\" AS REGION,\n        EXTRACT(YEAR FROM TO_DATE(t.\"txn_date\", 'DD-MM-YYYY'))::INT AS YEAR_START,\n        ROUND(SUM(t.\"quantity\" * p.\"price\") / SUM(t.\"quantity\"), 2) AS BTC_DCA\n    FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_TRANSACTIONS\" t\n    JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_MEMBERS\" m \n        ON t.\"member_id\" = m.\"member_id\"\n    JOIN \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"BITCOIN_PRICES\" p \n        ON t.\"ticker\" = p.\"ticker\" \n        AND TO_DATE(t.\"txn_date\", 'DD-MM-YYYY') = TO_DATE(p.\"market_date\", 'DD-MM-YYYY')\n    WHERE t.\"txn_type\" = 'BUY'\n      AND t.\"ticker\" = 'BTC'\n    GROUP BY m.\"region\", YEAR_START\n),\nwith_lag AS (\n    SELECT \n        YEAR_START,\n        REGION,\n        BTC_DCA,\n        RANK() OVER (PARTITION BY YEAR_START ORDER BY BTC_DCA ASC) AS DCA_RANKING,\n        LAG(BTC_DCA) OVER (PARTITION BY REGION ORDER BY YEAR_START) AS prev_dca,\n        DENSE_RANK() OVER (PARTITION BY REGION ORDER BY YEAR_START) AS yr_rank\n    FROM avg_prices\n)\nSELECT \n    YEAR_START,\n    REGION,\n    BTC_DCA,\n    DCA_RANKING,\n    ROUND(((BTC_DCA - prev_dca) / prev_dca) * 100, 2) AS DCA_PERCENTAGE_CHANGE\nFROM with_lag\nWHERE yr_rank > 1\nORDER BY REGION, YEAR_START;" := by
  first | sql_equiv | sorry

