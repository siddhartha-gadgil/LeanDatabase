import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq362 — crossskill equivalence(s)

Question: Which three companies had the largest increase in trip numbers between two consecutive months in 2018?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq362

CREATE TABLE TAXI_TRIPS («unique_key» STRING, «taxi_id» STRING, «trip_start_timestamp» INT, «trip_end_timestamp» INT, «trip_seconds» INT, «trip_miles» FLOAT, «pickup_census_tract» INT, «dropoff_census_tract» INT, «pickup_community_area» INT, «dropoff_community_area» INT, «fare» FLOAT, «tips» FLOAT, «tolls» FLOAT, «extras» FLOAT, «trip_total» FLOAT, «payment_type» STRING, «company» STRING, «pickup_latitude» FLOAT, «pickup_longitude» FLOAT, «pickup_location» STRING, «dropoff_latitude» FLOAT, «dropoff_longitude» FLOAT, «dropoff_location» STRING)

theorem eq_0_1 :
    sql%([TAXI_TRIPS_schema]) "WITH monthly_counts AS (\n  SELECT \n    \"company\",\n    EXTRACT(MONTH FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) AS trip_month,\n    COUNT(*) AS trip_count\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) = 2018\n  GROUP BY \"company\", trip_month\n),\nmonth_over_month AS (\n  SELECT \n    curr.\"company\",\n    curr.trip_count - prev.trip_count AS trip_increase\n  FROM monthly_counts curr\n  JOIN monthly_counts prev \n    ON curr.\"company\" = prev.\"company\"\n    AND curr.trip_month = prev.trip_month + 1\n),\ncompany_max_increase AS (\n  SELECT \n    \"company\",\n    MAX(trip_increase) AS max_increase\n  FROM month_over_month\n  GROUP BY \"company\"\n)\nSELECT \"company\" AS \"COMPANY\"\nFROM company_max_increase\nORDER BY max_increase DESC\nLIMIT 3;" = sql%([TAXI_TRIPS_schema]) "WITH monthly_trips AS (\n  SELECT \n    \"company\",\n    EXTRACT(MONTH FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) AS month,\n    COUNT(*) AS trip_count\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) = 2018\n  GROUP BY \"company\", month\n),\nincreases AS (\n  SELECT \n    cur.\"company\",\n    cur.trip_count - prev.trip_count AS increase\n  FROM monthly_trips cur\n  JOIN monthly_trips prev\n    ON cur.\"company\" = prev.\"company\"\n    AND cur.month = prev.month + 1\n)\nSELECT \"company\" AS COMPANY\nFROM increases\nGROUP BY \"company\"\nORDER BY MAX(increase) DESC\nLIMIT 3;" := by
  first | sql_equiv | sorry

HYPOTHESIS hyp0_2_0 : TAXI_TRIPS "EXTRACT(YEAR FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) = 2018"
HYPOTHESIS hyp0_2_1 : TAXI_TRIPS "\"trip_start_timestamp\" >= 1514764800000000   -- 2018-01-01"
HYPOTHESIS hyp0_2_2 : TAXI_TRIPS "\"trip_start_timestamp\" < 1546300800000000     -- 2019-01-01"
HYPOTHESIS hyp0_2_3 : TAXI_TRIPS "\"company\" IS NOT NULL"
theorem eq_0_2 (t : TableRel TAXI_TRIPS_schema) (h0 : hyp0_2_0 t) (h1 : hyp0_2_1 t) (h2 : hyp0_2_2 t) (h3 : hyp0_2_3 t) :
    (sql%([TAXI_TRIPS_schema]) "WITH monthly_counts AS (\n  SELECT \n    \"company\",\n    EXTRACT(MONTH FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) AS trip_month,\n    COUNT(*) AS trip_count\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) = 2018\n  GROUP BY \"company\", trip_month\n),\nmonth_over_month AS (\n  SELECT \n    curr.\"company\",\n    curr.trip_count - prev.trip_count AS trip_increase\n  FROM monthly_counts curr\n  JOIN monthly_counts prev \n    ON curr.\"company\" = prev.\"company\"\n    AND curr.trip_month = prev.trip_month + 1\n),\ncompany_max_increase AS (\n  SELECT \n    \"company\",\n    MAX(trip_increase) AS max_increase\n  FROM month_over_month\n  GROUP BY \"company\"\n)\nSELECT \"company\" AS \"COMPANY\"\nFROM company_max_increase\nORDER BY max_increase DESC\nLIMIT 3;") t = (sql%([TAXI_TRIPS_schema]) "WITH monthly_trips AS (\n  SELECT\n    \"company\" AS COMPANY,\n    EXTRACT(MONTH FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000)) AS trip_month,\n    COUNT(*) AS trip_count\n  FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\"\n  WHERE \"trip_start_timestamp\" >= 1514764800000000   -- 2018-01-01\n    AND \"trip_start_timestamp\" < 1546300800000000     -- 2019-01-01\n    AND \"company\" IS NOT NULL\n  GROUP BY \"company\", EXTRACT(MONTH FROM TO_TIMESTAMP(\"trip_start_timestamp\" / 1000000))\n),\nconsecutive_increase AS (\n  SELECT\n    COMPANY,\n    trip_month,\n    trip_count,\n    trip_count - LAG(trip_count) OVER (PARTITION BY COMPANY ORDER BY trip_month) AS increase\n  FROM monthly_trips\n)\nSELECT COMPANY\nFROM consecutive_increase\nWHERE increase IS NOT NULL\nORDER BY increase DESC\nLIMIT 3;") t := by
  first | sql_equiv | sorry

