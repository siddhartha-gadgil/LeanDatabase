/-!
# sf_local031 — crossskill equivalence(s)

Question: What is the highest monthly delivered orders volume in the year with the lowest annual delivered orders volume among 2016, 2017, and 2018?

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local031

CREATE TABLE OLIST_ORDERS («order_id» STRING, «customer_id» STRING, «order_status» STRING, «order_purchase_timestamp» STRING, «order_approved_at» STRING, «order_delivered_carrier_date» STRING, «order_delivered_customer_date» STRING, «order_estimated_delivery_date» STRING)

HYPOTHESIS hyp0_1_0 : OLIST_ORDERS "EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) IN (2016, 2017, 2018)"
HYPOTHESIS hyp0_1_1 : OLIST_ORDERS "\"order_delivered_customer_date\" IS NOT NULL"
HYPOTHESIS hyp0_1_2 : OLIST_ORDERS "\"order_delivered_customer_date\" != ''"
theorem eq_0_1 (t : TableRel OLIST_ORDERS_schema) (h0 : hyp0_1_0 t) (h1 : hyp0_1_1 t) (h2 : hyp0_1_2 t) :
    (sql%([OLIST_ORDERS_schema]) "WITH yearly_volume AS (\n    SELECT\n        EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) AS yr,\n        COUNT(*) AS annual_orders\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDERS\"\n    WHERE \"order_status\" = 'delivered'\n      AND EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) IN (2016, 2017, 2018)\n    GROUP BY yr\n),\nlowest_year AS (\n    SELECT yr\n    FROM yearly_volume\n    ORDER BY annual_orders ASC\n    LIMIT 1\n),\nmonthly_volume AS (\n    SELECT\n        EXTRACT(MONTH FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) AS mo,\n        COUNT(*) AS monthly_orders\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDERS\"\n    WHERE \"order_status\" = 'delivered'\n      AND EXTRACT(YEAR FROM TRY_TO_TIMESTAMP(\"order_delivered_customer_date\")) = (SELECT yr FROM lowest_year)\n    GROUP BY mo\n)\nSELECT MAX(monthly_orders) AS OUTPUT\nFROM monthly_volume;") t = (sql%([OLIST_ORDERS_schema]) "WITH delivered AS (\n    SELECT\n        EXTRACT(YEAR FROM TO_TIMESTAMP(\"order_delivered_customer_date\")) AS yr,\n        EXTRACT(MONTH FROM TO_TIMESTAMP(\"order_delivered_customer_date\")) AS mo\n    FROM \"BRAZILIAN_E_COMMERCE\".\"BRAZILIAN_E_COMMERCE\".\"OLIST_ORDERS\"\n    WHERE \"order_status\" = 'delivered'\n      AND \"order_delivered_customer_date\" IS NOT NULL\n      AND \"order_delivered_customer_date\" != ''\n      AND EXTRACT(YEAR FROM TO_TIMESTAMP(\"order_delivered_customer_date\")) IN (2016, 2017, 2018)\n),\nannual_volume AS (\n    SELECT yr, COUNT(*) AS annual_cnt\n    FROM delivered\n    GROUP BY yr\n),\nlowest_year AS (\n    SELECT yr\n    FROM annual_volume\n    ORDER BY annual_cnt ASC\n    LIMIT 1\n),\nmonthly_volume AS (\n    SELECT mo, COUNT(*) AS monthly_cnt\n    FROM delivered\n    WHERE yr = (SELECT yr FROM lowest_year)\n    GROUP BY mo\n)\nSELECT MAX(monthly_cnt) AS OUTPUT\nFROM monthly_volume;") t := by
  first | sql_equiv | sorry

