import LeanDatabase.Hypothesis
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 8000
set_option sqlEquivLlm.provider "gemini"
set_option sqlEquivLlm.model "gemini-pro-latest"

/-!
# sf_bq039 — crossskill equivalence(s)

Question: Find the top 10 taxi trips in New York City between July 1 and July 7, 2016 (ensuring both pickup and dropoff times fall within these dates) where the passenger count is greater than five, the trip distance is at least ten miles, and there are no negative fare-related amounts (including tip, tolls, mta tax, fare, and total costs). Exclude any trips where the dropoff time is not strictly after the pickup time, then sort the results by total fare amount in descending order. Finally, display each trip’s pickup zone, dropoff zone, trip duration in seconds, driving speed in miles per hour, and tip rate as a percentage of the total fare amount.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq039

CREATE TABLE TRIPS («route_id» STRING, «service_id» STRING, «trip_id» STRING, «trip_headsign» STRING, «direction_id» STRING, «block_id» STRING, «shape_id» STRING)
CREATE TABLE TAXI_ZONE_GEOM («zone_id» STRING, «zone_name» STRING, «borough» STRING, «zone_geom» STRING)
CREATE TABLE TLC_YELLOW_TRIPS_2016 («vendor_id» STRING, «pickup_datetime» INT, «dropoff_datetime» INT, «passenger_count» INT, «trip_distance» INT, «rate_code» STRING, «store_and_fwd_flag» STRING, «payment_type» STRING, «fare_amount» INT, «extra» INT, «mta_tax» INT, «tip_amount» INT, «tolls_amount» INT, «imp_surcharge» INT, «airport_fee» INT, «total_amount» INT, «pickup_location_id» STRING, «dropoff_location_id» STRING, «data_file_year» INT, «data_file_month» INT)

theorem eq_0_1 : ∀ t,
    (sql%([TRIPS_schema, TAXI_ZONE_GEOM_schema, TLC_YELLOW_TRIPS_2016_schema]) "WITH trips AS (SELECT t.\"pickup_location_id\", t.\"dropoff_location_id\", TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) AS pickup_ts, TO_TIMESTAMP(CAST(t.\"dropoff_datetime\" AS DOUBLE PRECISION) / 1000000) AS dropoff_ts, t.\"trip_distance\", t.\"tip_amount\", t.\"total_amount\" FROM \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TLC_YELLOW_TRIPS_2016\" AS t WHERE TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) >= '2016-07-01' AND TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000) < '2016-07-08' AND TO_TIMESTAMP(CAST(t.\"dropoff_datetime\" AS DOUBLE PRECISION) / 1000000) >= '2016-07-01' AND TO_TIMESTAMP(CAST(t.\"dropoff_datetime\" AS DOUBLE PRECISION) / 1000000) < '2016-07-08' AND t.\"passenger_count\" > 5 AND t.\"trip_distance\" >= 10 AND t.\"tip_amount\" >= 0 AND t.\"tolls_amount\" >= 0 AND t.\"mta_tax\" >= 0 AND t.\"fare_amount\" >= 0 AND t.\"total_amount\" >= 0 AND TO_TIMESTAMP(CAST(t.\"dropoff_datetime\" AS DOUBLE PRECISION) / 1000000) > TO_TIMESTAMP(CAST(t.\"pickup_datetime\" AS DOUBLE PRECISION) / 1000000)) SELECT COALESCE(pz.\"zone_name\", 'Unknown') AS PICKUP_ZONE, COALESCE(dz.\"zone_name\", 'Unknown') AS DROPOFF_ZONE, CAST(EXTRACT(epoch FROM CAST(trips.dropoff_ts AS TIMESTAMP) - CAST(trips.pickup_ts AS TIMESTAMP)) AS BIGINT) AS DURATION_SECONDS, CAST(trips.\"trip_distance\" AS DOUBLE PRECISION) / (CAST(CAST(EXTRACT(epoch FROM CAST(trips.dropoff_ts AS TIMESTAMP) - CAST(trips.pickup_ts AS TIMESTAMP)) AS BIGINT) AS DOUBLE PRECISION) / 3600.0) AS SPEED_MPH, (CAST(trips.\"tip_amount\" AS DOUBLE PRECISION) / trips.\"total_amount\") * 100 AS TIP_RATE_PCT FROM trips LEFT JOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" AS pz ON trips.\"pickup_location_id\" = pz.\"zone_id\" LEFT JOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" AS dz ON trips.\"dropoff_location_id\" = dz.\"zone_id\" ORDER BY trips.\"total_amount\" DESC LIMIT 10") t ~= (sql%([TRIPS_schema, TAXI_ZONE_GEOM_schema, TLC_YELLOW_TRIPS_2016_schema]) "SELECT COALESCE(pz.\"zone_name\", 'Unknown') AS PICKUP_ZONE, COALESCE(dz.\"zone_name\", 'Unknown') AS DROPOFF_ZONE, CAST((t.\"dropoff_datetime\" - t.\"pickup_datetime\") AS DOUBLE PRECISION) / 1000000 AS DURATION_SECONDS, CAST(t.\"trip_distance\" AS DOUBLE PRECISION) / (CAST((t.\"dropoff_datetime\" - t.\"pickup_datetime\") AS DOUBLE PRECISION) / 1000000) * 3600 AS SPEED_MPH, CAST(t.\"tip_amount\" AS DOUBLE PRECISION) / t.\"total_amount\" * 100 AS TIP_RATE_PCT FROM \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TLC_YELLOW_TRIPS_2016\" AS t LEFT JOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" AS pz ON t.\"pickup_location_id\" = pz.\"zone_id\" LEFT JOIN \"NEW_YORK_PLUS\".\"NEW_YORK_TAXI_TRIPS\".\"TAXI_ZONE_GEOM\" AS dz ON t.\"dropoff_location_id\" = dz.\"zone_id\" WHERE t.\"pickup_datetime\" >= 1467331200000000 AND t.\"pickup_datetime\" < 1467936000000000 AND t.\"dropoff_datetime\" >= 1467331200000000 AND t.\"dropoff_datetime\" < 1467936000000000 AND t.\"passenger_count\" > 5 AND t.\"trip_distance\" >= 10 AND t.\"tip_amount\" >= 0 AND t.\"tolls_amount\" >= 0 AND t.\"mta_tax\" >= 0 AND t.\"fare_amount\" >= 0 AND t.\"total_amount\" >= 0 AND t.\"dropoff_datetime\" > t.\"pickup_datetime\" ORDER BY t.\"total_amount\" DESC LIMIT 10") t := by
  intro t; first | sql_equiv | sorry

