e\" = 'session_start'\n    UNION ALL\n    SELECT \"user_pseudo_id\", \"event_date\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180927\" WHERE \"event_name\" = 'session_start'\n    UNION ALL\n    SELECT \"user_pseudo_id\", \"event_date\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180928\" WHERE \"event_name\" = 'session_start'\n    UNION ALL\n    SELECT \"user_pseudo_id\", \"event_date\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180929\" WHERE \"event_name\" = 'session_start'\n    UNION ALL\n    SELECT \"user_pseudo_id\", \"event_date\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20180930\" WHERE \"event_name\" = 'session_start'\n    UNION ALL\n    SELECT \"user_pseudo_id\", \"event_date\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20181001\" WHERE \"event_name\" = 'session_start'\n    UNION ALL\n    SELECT \"user_pseudo_id\", \"event_date\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20181002\" WHERE \"event_name\" = 'session_start'\n    UNION ALL\n    SELECT \"user_pseudo_id\", \"event_date\" FROM \"FIREBASE\".\"ANALYTICS_153293282\".\"EVENTS_20181003\" WHERE \"event_name\" = 'session_start'\n),\n-- Users whose first session_start is in the week of July 2-8, 2018\nuser_first_session AS (\n    SELECT \"user_pseudo_id\", MIN(\"event_date\") as first_session_date\n    FROM all_sessions\n    GROUP BY \"user_pseudo_id\"\n),\ncohort_users AS (\n    SELECT \"user_pseudo_id\"\n    FROM user_first_session\n    WHERE first_session_date BETWEEN '20180702' AND '20180708'\n),\n-- Track retention using session_start events only\ncohort_sessions AS (\n    SELECT DISTINCT\n        s.\"user_pseudo_id\",\n        FLOOR(DATEDIFF('day', TO_DATE('20180702','YYYYMMDD'), TO_DATE(s.\"event_date\",'YYYYMMDD')) / 7) AS week_number\n    FROM all_sessions s\n    INNER JOIN cohort_users c ON s.\"user_pseudo_id\" = c.\"user_pseudo_id\"\n    WHERE s.\"event_date\" >= '20180702'\n),\nweekly_retention AS (\n    SELECT\n        week_number,\n        COUNT(DISTINCT \"user_pseudo_id\") AS user_count\n    FROM cohort_sessions\n    WHERE week_number BETWEEN 0 AND 4\n    GROUP BY week_number\n)\nSELECT\n    'Week ' || CAST(week_number AS VARCHAR) AS WEEK_LABEL,\n    user_count AS USER_COUNT\nFROM weekly_retention\nORDER BY week_number;") t := by
