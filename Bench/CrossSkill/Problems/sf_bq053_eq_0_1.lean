theorem eq (t0 : TableRel TREE_CENSUS_1995_schema) (t1 : TableRel TREE_CENSUS_2015_schema) (t2 : TableRel TREE_SPECIES_schema) :
    (sql%([TREE_CENSUS_1995_schema, TREE_CENSUS_2015_schema, TREE_SPECIES_schema]) "WITH sp_1995 AS (SELECT UPPER(\"spc_latin\") AS species_upper, COUNT(*) AS cnt_1995 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_1995\" WHERE \"status\" <> 'Dead' AND NOT \"spc_latin\" IS NULL AND \"spc_latin\" <> '' GROUP BY UPPER(\"spc_latin\")), sp_2015 AS (SELECT UPPER(\"spc_latin\") AS species_upper, COUNT(*) AS cnt_2015 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_2015\" WHERE \"status\" = 'Alive' AND NOT \"spc_latin\" IS NULL AND \"spc_latin\" <> '' GROUP BY UPPER(\"spc_latin\")), ts AS (SELECT UPPER(\"species_scientific_name\") AS species_upper, \"fall_color\" FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_SPECIES\") SELECT ts.\"fall_color\", SUM(COALESCE(sp_2015.cnt_2015, 0) - COALESCE(sp_1995.cnt_1995, 0)) AS change FROM ts LEFT JOIN sp_1995 ON ts.species_upper = sp_1995.species_upper LEFT JOIN sp_2015 ON ts.species_upper = sp_2015.species_upper WHERE NOT sp_1995.species_upper IS NULL OR NOT sp_2015.species_upper IS NULL GROUP BY ts.\"fall_color\" ORDER BY change DESC") t0 t1 t2
  = (sql%([TREE_CENSUS_1995_schema, TREE_CENSUS_2015_schema, TREE_SPECIES_schema]) "WITH species_1995 AS (SELECT UPPER(t95.\"spc_latin\") AS species_upper, COUNT(*) AS cnt_1995 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_1995\" AS t95 WHERE t95.\"status\" <> 'Dead' GROUP BY UPPER(t95.\"spc_latin\")), species_2015 AS (SELECT UPPER(t15.\"spc_latin\") AS species_upper, COUNT(*) AS cnt_2015 FROM \"NEW_YORK\".\"NEW_YORK\".\"TREE_CENSUS_2015\" AS t15 WHERE t15.\"status\" = 'Alive' GROUP BY UPPER(t15.\"spc_latin\")), species_diff AS (SELECT COALESCE(s15.species_upper, s95.species_upper) AS species_upper, COALESCE(s15.cnt_2015, 0) - COALESCE(s95.cnt_1995, 0) AS diff FROM species_2015 AS s15 FULL OUTER JOIN species_1995 AS s95 ON s15.species_upper = s95.species_upper) SELECT ts.\"fall_color\" AS fall_color, SUM(sd.diff) AS change FROM species_diff AS sd JOIN \"NEW_YORK\".\"NEW_YORK\".\"TREE_SPECIES\" AS ts ON sd.species_upper = UPPER(ts.\"species_scientific_name\") GROUP BY ts.\"fall_color\" HAVING SUM(sd.diff) > 0 ORDER BY change DESC") t0 t1 t2
  := by first | sql_equiv | sorry

end N_sf_bq053_eq_0_1
