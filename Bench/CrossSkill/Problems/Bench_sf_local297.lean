/-!
# sf_local297 — crossskill equivalence(s)

Question: For each customer, group all deposits and withdrawals by the first day of each month to obtain a monthly net amount, then calculate each month’s closing balance by cumulatively summing these monthly nets. Next, determine the most recent month’s growth rate by comparing its closing balance to the prior month’s balance, treating deposits as positive and withdrawals as negative, and if the previous month’s balance is zero, the growth rate should be the current month’s balance multiplied by 100. Finally, compute the percentage of customers whose most recent month shows a growth rate of more than 5%.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_local297

CREATE TABLE CUSTOMER_TRANSACTIONS («customer_id» INT, «txn_date» STRING, «txn_type» STRING, «txn_amount» INT)

theorem eq_0_1 :
    sql%([CUSTOMER_TRANSACTIONS_schema]) "WITH monthly_net AS (\n  SELECT \n    \"customer_id\",\n    DATE_TRUNC('month', TO_DATE(\"txn_date\", 'YYYY-MM-DD')) AS month_start,\n    SUM(CASE \n      WHEN \"txn_type\" = 'deposit' THEN \"txn_amount\"\n      WHEN \"txn_type\" = 'withdrawal' THEN -\"txn_amount\"\n      ELSE 0 \n    END) AS net_amount\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n  GROUP BY \"customer_id\", month_start\n),\nclosing_balance AS (\n  SELECT \n    \"customer_id\",\n    month_start,\n    SUM(net_amount) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS closing_bal\n  FROM monthly_net\n),\nwith_prev AS (\n  SELECT \n    \"customer_id\",\n    month_start,\n    closing_bal,\n    LAG(closing_bal) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS prev_closing_bal,\n    ROW_NUMBER() OVER (PARTITION BY \"customer_id\" ORDER BY month_start DESC) AS rn_desc\n  FROM closing_balance\n),\nmost_recent AS (\n  SELECT \n    \"customer_id\",\n    closing_bal,\n    prev_closing_bal,\n    CASE \n      WHEN prev_closing_bal = 0 THEN closing_bal * 100\n      ELSE (closing_bal - prev_closing_bal) / prev_closing_bal * 100\n    END AS growth_rate\n  FROM with_prev\n  WHERE rn_desc = 1\n    AND prev_closing_bal IS NOT NULL\n)\nSELECT \n  100.0 * SUM(CASE WHEN growth_rate > 5 THEN 1 ELSE 0 END) / COUNT(*) AS PCT_CUSTOMERS_GROWTH_GT_5\nFROM most_recent;" = sql%([CUSTOMER_TRANSACTIONS_schema]) "WITH monthly_net AS (\n  SELECT \n    \"customer_id\",\n    DATE_TRUNC('MONTH', TO_DATE(\"txn_date\"))::DATE AS month_start,\n    SUM(CASE \n      WHEN \"txn_type\" = 'deposit' THEN \"txn_amount\"\n      WHEN \"txn_type\" = 'withdrawal' THEN -\"txn_amount\"\n      ELSE 0 \n    END) AS net_amount\n  FROM \"BANK_SALES_TRADING\".\"BANK_SALES_TRADING\".\"CUSTOMER_TRANSACTIONS\"\n  GROUP BY \"customer_id\", month_start\n),\nclosing_balance AS (\n  SELECT \n    \"customer_id\",\n    month_start,\n    SUM(net_amount) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS closing_bal\n  FROM monthly_net\n),\nwith_lag AS (\n  SELECT \n    \"customer_id\",\n    month_start,\n    closing_bal,\n    LAG(closing_bal) OVER (PARTITION BY \"customer_id\" ORDER BY month_start) AS prev_bal,\n    ROW_NUMBER() OVER (PARTITION BY \"customer_id\" ORDER BY month_start DESC) AS rn\n  FROM closing_balance\n),\nmost_recent AS (\n  SELECT \n    \"customer_id\",\n    month_start,\n    closing_bal,\n    prev_bal,\n    CASE \n      WHEN prev_bal = 0 THEN closing_bal * 100\n      ELSE (closing_bal - prev_bal) / prev_bal * 100\n    END AS growth_rate\n  FROM with_lag\n  WHERE rn = 1\n    AND prev_bal IS NOT NULL\n)\nSELECT \n  ROUND(100.0 * SUM(CASE WHEN growth_rate > 5 THEN 1 ELSE 0 END) / COUNT(*), 2) AS \"PCT_CUSTOMERS_GROWTH_GT_5\"\nFROM most_recent;" := by
  first | sql_equiv | sorry

