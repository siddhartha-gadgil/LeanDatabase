theorem eq_0_1 :
    sql%([REL14_CASEDATA_schema, REL14_GDCFILEID_TO_GCSURL_NEW_schema, REL14_FILEDATA_CURRENT_schema, ANNOTATIONS_schema, CLINICAL_schema]) "WITH annotation_patients AS (\n  SELECT \n    \"case_barcode\",\n    \"category\" AS categoryName,\n    \"classification\" AS classificationName\n  FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"ANNOTATIONS\"\n  WHERE \"entity_type\" = 'Patient'\n    AND (\n      \"category\" = 'History of unacceptable prior treatment related to a prior/other malignancy'\n      OR \"classification\" = 'Redaction'\n    )\n),\n\nclinical_patients AS (\n  SELECT \"case_barcode\"\n  FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\"\n  WHERE \"disease_code\" = 'BRCA'\n    AND \"age_at_diagnosis\" <= 30\n    AND \"gender\" = 'FEMALE'\n),\n\njoined_patients AS (\n  SELECT \n    COALESCE(c.\"case_barcode\", a.\"case_barcode\") AS case_barcode,\n    a.categoryName,\n    a.classificationName\n  FROM clinical_patients c\n  FULL JOIN annotation_patients a\n    ON c.\"case_barcode\" = a.\"case_barcode\"\n),\n\nfiltered_patients AS (\n  SELECT case_barcode\n  FROM joined_patients\n  WHERE categoryName IS NULL\n    AND classificationName IS NULL\n)\n\nSELECT \n  fp.case_barcode,\n  g.\"file_gdc_url\"\nFROM filtered_patients fp\nJOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_CASEDATA\" cd\n  ON fp.case_barcode = cd.\"case_barcode\"\nJOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_FILEDATA_CURRENT\" fd\n  ON cd.\"case_gdc_id\" = fd.\"case_gdc_id\"\nJOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_GDCFILEID_TO_GCSURL_NEW\" g\n  ON fd.\"file_gdc_id\" = g.\"file_gdc_id\"\nORDER BY fp.case_barcode, g.\"file_gdc_url\";" = sql%([REL14_CASEDATA_schema, REL14_GDCFILEID_TO_GCSURL_NEW_schema, REL14_FILEDATA_CURRENT_schema, ANNOTATIONS_schema, CLINICAL_schema]) "WITH annot AS (\n  SELECT DISTINCT\n    \"case_barcode\",\n    \"category\" AS categoryName,\n    \"classification\" AS classificationName\n  FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"ANNOTATIONS\"\n  WHERE \"entity_type\" = 'Patient'\n    AND (\n      \"category\" = 'History of unacceptable prior treatment related to a prior/other malignancy'\n      OR \"classification\" = 'Redaction'\n    )\n),\n\nclin AS (\n  SELECT DISTINCT\n    \"case_barcode\",\n    \"case_gdc_id\"\n  FROM \"TCGA_BIOCLIN_V0\".\"TCGA_BIOCLIN_V0\".\"CLINICAL\"\n  WHERE \"disease_code\" = 'BRCA'\n    AND \"age_at_diagnosis\" <= 30\n    AND \"gender\" = 'FEMALE'\n),\n\nfiltered AS (\n  SELECT\n    clin.\"case_barcode\",\n    clin.\"case_gdc_id\"\n  FROM clin\n  FULL JOIN annot\n    ON clin.\"case_barcode\" = annot.\"case_barcode\"\n  WHERE annot.categoryName IS NULL\n    AND annot.classificationName IS NULL\n)\n\nSELECT\n  f.\"case_barcode\",\n  gu.\"file_gdc_url\"\nFROM filtered f\nJOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_CASEDATA\" cd\n  ON f.\"case_barcode\" = cd.\"case_barcode\"\nJOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_FILEDATA_CURRENT\" fd\n  ON cd.\"case_gdc_id\" = fd.\"case_gdc_id\"\nJOIN \"TCGA_BIOCLIN_V0\".\"GDC_METADATA\".\"REL14_GDCFILEID_TO_GCSURL_NEW\" gu\n  ON fd.\"file_gdc_id\" = gu.\"file_gdc_id\"\nORDER BY f.\"case_barcode\", gu.\"file_gdc_url\";" := by
  first | sql_equiv | sorry

