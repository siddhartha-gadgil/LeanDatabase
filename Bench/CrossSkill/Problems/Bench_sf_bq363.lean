/-!
# sf_bq363 — crossskill equivalence(s)

Question: Calculate the total number of trips and average fare (formatted to two decimal places) for ten equal-sized quantile groups. Create ten quantile groups by partitioning the trip duration dimension (from 1-50 minutes) into equal sets. Each group should represent a similar number of distinct minute values. Display each group's time range formatted as "XXm to XXm" (where the numbers are zero-padded to two digits), the total trips count, and the average fare. The time ranges should represent the minimum and maximum duration values within each quantile. Sort the results chronologically by time range. Use NTILE(10) to create the quantiles from the ordered trip durations.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq363

CREATE TABLE TAXI_TRIPS («unique_key» STRING, «taxi_id» STRING, «trip_start_timestamp» INT, «trip_end_timestamp» INT, «trip_seconds» INT, «trip_miles» FLOAT, «pickup_census_tract» INT, «dropoff_census_tract» INT, «pickup_community_area» INT, «dropoff_community_area» INT, «fare» FLOAT, «tips» FLOAT, «tolls» FLOAT, «extras» FLOAT, «trip_total» FLOAT, «payment_type» STRING, «company» STRING, «pickup_latitude» FLOAT, «pickup_longitude» FLOAT, «pickup_location» STRING, «dropoff_latitude» FLOAT, «dropoff_longitude» FLOAT, «dropoff_location» STRING)

theorem eq_0_1 : ∀ t,
    (sql%([TAXI_TRIPS_schema]) "WITH duration_minutes AS (SELECT DISTINCT FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) AS trip_min FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" WHERE FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN 1 AND 50), ntiled AS (SELECT trip_min, NTILE(10) OVER (ORDER BY trip_min) AS quantile_group FROM duration_minutes), groups AS (SELECT quantile_group, MIN(trip_min) AS min_min, MAX(trip_min) AS max_min FROM ntiled GROUP BY quantile_group) SELECT LPAD(CAST(CAST(g.min_min AS INT) AS VARCHAR), 2, '0') || 'm to ' || LPAD(CAST(CAST(g.max_min AS INT) AS VARCHAR), 2, '0') || 'm' AS TIME_RANGE, COUNT(*) AS TOTAL_TRIPS, ROUND(CAST(AVG(t.\"fare\") AS DECIMAL), 2) AS AVERAGE_FARE FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" AS t JOIN groups AS g ON FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN g.min_min AND g.max_min WHERE FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN 1 AND 50 GROUP BY g.quantile_group, g.min_min, g.max_min ORDER BY TIME_RANGE") t ~= (sql%([TAXI_TRIPS_schema]) "WITH minute_quantiles AS (SELECT trip_minutes, NTILE(10) OVER (ORDER BY trip_minutes) AS quantile FROM (SELECT DISTINCT CAST(FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) AS INT) AS trip_minutes FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" WHERE FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) BETWEEN 1 AND 50)) SELECT LPAD(CAST(MIN(q.trip_minutes) AS VARCHAR), 2, '0') || 'm to ' || LPAD(CAST(MAX(q.trip_minutes) AS VARCHAR), 2, '0') || 'm' AS TIME_RANGE, COUNT(*) AS TOTAL_TRIPS, ROUND(CAST(AVG(t.\"fare\") AS DECIMAL), 2) AS AVERAGE_FARE FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" AS t JOIN minute_quantiles AS q ON CAST(FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60) AS INT) = q.trip_minutes WHERE FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60) BETWEEN 1 AND 50 GROUP BY q.quantile ORDER BY MIN(q.trip_minutes)") t := by
  intro t; first | sql_equiv | sorry

theorem eq_0_2 : ∀ t,
    (sql%([TAXI_TRIPS_schema]) "WITH duration_minutes AS (SELECT DISTINCT FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) AS trip_min FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" WHERE FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN 1 AND 50), ntiled AS (SELECT trip_min, NTILE(10) OVER (ORDER BY trip_min) AS quantile_group FROM duration_minutes), groups AS (SELECT quantile_group, MIN(trip_min) AS min_min, MAX(trip_min) AS max_min FROM ntiled GROUP BY quantile_group) SELECT LPAD(CAST(CAST(g.min_min AS INT) AS VARCHAR), 2, '0') || 'm to ' || LPAD(CAST(CAST(g.max_min AS INT) AS VARCHAR), 2, '0') || 'm' AS TIME_RANGE, COUNT(*) AS TOTAL_TRIPS, ROUND(CAST(AVG(t.\"fare\") AS DECIMAL), 2) AS AVERAGE_FARE FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" AS t JOIN groups AS g ON FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN g.min_min AND g.max_min WHERE FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN 1 AND 50 GROUP BY g.quantile_group, g.min_min, g.max_min ORDER BY TIME_RANGE") t ~= (sql%([TAXI_TRIPS_schema]) "SELECT LPAD(CAST(MIN(trip_minutes) AS VARCHAR), 2, '0') || 'm to ' || LPAD(CAST(MAX(trip_minutes) AS VARCHAR), 2, '0') || 'm' AS \"TIME_RANGE\", COUNT(*) AS \"TOTAL_TRIPS\", ROUND(CAST(AVG(fare) AS DECIMAL), 2) AS \"AVERAGE_FARE\" FROM (SELECT FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) AS trip_minutes, \"fare\" AS fare, CEIL(CAST(FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) AS DOUBLE PRECISION) / 5) AS quantile FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" WHERE FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) BETWEEN 1 AND 50) GROUP BY quantile ORDER BY \"TIME_RANGE\"") t := by
  intro t; first | sql_equiv | sorry

HYPOTHESIS hyp0_3_0 : TAXI_TRIPS "NOT \"trip_seconds\" IS NULL"
HYPOTHESIS hyp0_3_1 : TAXI_TRIPS "FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) >= 1"
theorem eq_0_3 (t : TableRel TAXI_TRIPS_schema) (h0 : hyp0_3_0 t) (h1 : hyp0_3_1 t) :
    (sql%([TAXI_TRIPS_schema]) "WITH duration_minutes AS (SELECT DISTINCT FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) AS trip_min FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" WHERE FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN 1 AND 50), ntiled AS (SELECT trip_min, NTILE(10) OVER (ORDER BY trip_min) AS quantile_group FROM duration_minutes), groups AS (SELECT quantile_group, MIN(trip_min) AS min_min, MAX(trip_min) AS max_min FROM ntiled GROUP BY quantile_group) SELECT LPAD(CAST(CAST(g.min_min AS INT) AS VARCHAR), 2, '0') || 'm to ' || LPAD(CAST(CAST(g.max_min AS INT) AS VARCHAR), 2, '0') || 'm' AS TIME_RANGE, COUNT(*) AS TOTAL_TRIPS, ROUND(CAST(AVG(t.\"fare\") AS DECIMAL), 2) AS AVERAGE_FARE FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" AS t JOIN groups AS g ON FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN g.min_min AND g.max_min WHERE FLOOR(CAST(t.\"trip_seconds\" AS DOUBLE PRECISION) / 60.0) BETWEEN 1 AND 50 GROUP BY g.quantile_group, g.min_min, g.max_min ORDER BY TIME_RANGE") t ~= (sql%([TAXI_TRIPS_schema]) "WITH trip_data AS (SELECT FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) AS trip_minutes, \"fare\" FROM \"CHICAGO\".\"CHICAGO_TAXI_TRIPS\".\"TAXI_TRIPS\" WHERE NOT \"trip_seconds\" IS NULL AND FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) >= 1 AND FLOOR(CAST(\"trip_seconds\" AS DOUBLE PRECISION) / 60) <= 50), bucketed AS (SELECT CASE WHEN trip_minutes BETWEEN 1 AND 5 THEN '01m to 05m' WHEN trip_minutes BETWEEN 6 AND 10 THEN '06m to 10m' WHEN trip_minutes BETWEEN 11 AND 15 THEN '11m to 15m' WHEN trip_minutes BETWEEN 16 AND 20 THEN '16m to 20m' WHEN trip_minutes BETWEEN 21 AND 25 THEN '21m to 25m' WHEN trip_minutes BETWEEN 26 AND 30 THEN '26m to 30m' WHEN trip_minutes BETWEEN 31 AND 35 THEN '31m to 35m' WHEN trip_minutes BETWEEN 36 AND 40 THEN '36m to 40m' WHEN trip_minutes BETWEEN 41 AND 45 THEN '41m to 45m' WHEN trip_minutes BETWEEN 46 AND 50 THEN '46m to 50m' END AS TIME_RANGE, \"fare\" FROM trip_data) SELECT TIME_RANGE, COUNT(*) AS TOTAL_TRIPS, ROUND(CAST(AVG(\"fare\") AS DECIMAL), 2) AS AVERAGE_FARE FROM bucketed GROUP BY TIME_RANGE ORDER BY TIME_RANGE") t := by
  first | sql_equiv | sorry

