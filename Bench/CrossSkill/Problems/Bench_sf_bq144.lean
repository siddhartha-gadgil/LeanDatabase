/-!
# sf_bq144 — crossskill equivalence(s)

Question: Create a dataset by combining NCAA men's basketball tournament game outcomes from the 2014 season onwards, including both the historical tournament games and the 2018 tournament results, with the corresponding pace and efficiency performance metrics for each team and their opponents from the feature_engineering data. The dataset should include the season, game outcome labels (win or loss), team and opponent seeds, school names, pace and efficiency rankings, statistical values, and the differences between the team's and the opponent's metrics to enable a comprehensive analysis of team and opponent dynamics.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq144

CREATE TABLE FEATURE_ENGINEERING («season» INT, «team» STRING, «poss_40min» FLOAT, «pace_rating» FLOAT, «pace_rank» FLOAT, «pts_100poss» FLOAT, «efficiency_rating» FLOAT, «efficiency_rank» FLOAT)
CREATE TABLE MBB_HISTORICAL_TOURNAMENT_GAMES («season» INT, «round» INT, «days_from_epoch» INT, «game_date» STRING, «day» STRING, «win_seed» STRING, «win_region» STRING, «win_market» STRING, «win_name» STRING, «win_alias» STRING, «win_team_id» STRING, «win_school_ncaa» STRING, «win_code_ncaa» INT, «win_kaggle_team_id» INT, «win_pts» INT, «lose_seed» STRING, «lose_region» STRING, «lose_market» STRING, «lose_name» STRING, «lose_alias» STRING, «lose_team_id» STRING, «lose_school_ncaa» STRING, «lose_code_ncaa» INT, «lose_kaggle_team_id» INT, «lose_pts» INT, «num_ot» INT, «academic_year» INT)
CREATE TABLE _2018_TOURNAMENT_RESULTS («season» INT, «round» INT, «days_from_epoch» INT, «game_date» STRING, «day» STRING, «label» STRING, «seed» STRING, «market» STRING, «name» STRING, «alias» STRING, «school_ncaa» STRING, «points» INT, «opponent_seed» STRING, «opponent_market» STRING, «opponent_name» STRING, «opponent_alias» STRING, «opponent_school_ncaa» STRING, «opponent_points» INT)

theorem eq_0_1 :
    sql%([FEATURE_ENGINEERING_schema, MBB_HISTORICAL_TOURNAMENT_GAMES_schema, _2018_TOURNAMENT_RESULTS_schema]) "WITH combined AS (\n  -- Historical win rows (2014-2017)\n  SELECT\n    h.\"season\",\n    'win' AS \"label\",\n    h.\"win_seed\" AS \"seed\",\n    h.\"win_school_ncaa\" AS \"school_ncaa\",\n    h.\"lose_seed\" AS \"opponent_seed\",\n    h.\"lose_school_ncaa\" AS \"opponent_school_ncaa\"\n  FROM \"NCAA_INSIGHTS\".\"NCAA\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\" h\n  WHERE h.\"season\" >= 2014\n\n  UNION ALL\n\n  -- Historical loss rows (2014-2017)\n  SELECT\n    h.\"season\",\n    'loss' AS \"label\",\n    h.\"lose_seed\" AS \"seed\",\n    h.\"lose_school_ncaa\" AS \"school_ncaa\",\n    h.\"win_seed\" AS \"opponent_seed\",\n    h.\"win_school_ncaa\" AS \"opponent_school_ncaa\"\n  FROM \"NCAA_INSIGHTS\".\"NCAA\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\" h\n  WHERE h.\"season\" >= 2014\n\n  UNION ALL\n\n  -- 2018 tournament results (already has label, seed, school_ncaa, opponent_seed, opponent_school_ncaa)\n  SELECT\n    t.\"season\",\n    t.\"label\",\n    t.\"seed\",\n    t.\"school_ncaa\",\n    t.\"opponent_seed\",\n    t.\"opponent_school_ncaa\"\n  FROM \"NCAA_INSIGHTS\".\"NCAA\".\"_2018_TOURNAMENT_RESULTS\" t\n)\nSELECT\n  c.\"season\",\n  c.\"label\",\n  c.\"seed\",\n  c.\"school_ncaa\",\n  ft.\"pace_rank\",\n  ft.\"poss_40min\",\n  ft.\"pace_rating\",\n  ft.\"efficiency_rank\",\n  ft.\"pts_100poss\",\n  ft.\"efficiency_rating\",\n  c.\"opponent_seed\",\n  c.\"opponent_school_ncaa\",\n  fo.\"pace_rank\" AS \"opp_pace_rank\",\n  fo.\"poss_40min\" AS \"opp_poss_40min\",\n  fo.\"pace_rating\" AS \"opp_pace_rating\",\n  fo.\"efficiency_rank\" AS \"opp_efficiency_rank\",\n  fo.\"pts_100poss\" AS \"opp_pts_100poss\",\n  fo.\"efficiency_rating\" AS \"opp_efficiency_rating\",\n  fo.\"pace_rank\" - ft.\"pace_rank\" AS \"pace_rank_diff\",\n  fo.\"poss_40min\" - ft.\"poss_40min\" AS \"pace_stat_diff\",\n  fo.\"pace_rating\" - ft.\"pace_rating\" AS \"pace_rating_diff\",\n  fo.\"efficiency_rank\" - ft.\"efficiency_rank\" AS \"eff_rank_diff\",\n  fo.\"pts_100poss\" - ft.\"pts_100poss\" AS \"eff_stat_diff\",\n  fo.\"efficiency_rating\" - ft.\"efficiency_rating\" AS \"eff_rating_diff\"\nFROM combined c\nLEFT JOIN \"NCAA_INSIGHTS\".\"NCAA\".\"FEATURE_ENGINEERING\" ft\n  ON c.\"school_ncaa\" = ft.\"team\" AND c.\"season\" = ft.\"season\"\nLEFT JOIN \"NCAA_INSIGHTS\".\"NCAA\".\"FEATURE_ENGINEERING\" fo\n  ON c.\"opponent_school_ncaa\" = fo.\"team\" AND c.\"season\" = fo.\"season\"" = sql%([FEATURE_ENGINEERING_schema, MBB_HISTORICAL_TOURNAMENT_GAMES_schema, _2018_TOURNAMENT_RESULTS_schema]) "WITH games AS (\n  -- Win rows from historical tournament games (season >= 2014)\n  SELECT\n    \"season\",\n    'win' AS \"label\",\n    \"win_seed\" AS \"seed\",\n    \"win_school_ncaa\" AS \"school_ncaa\",\n    \"lose_seed\" AS \"opponent_seed\",\n    \"lose_school_ncaa\" AS \"opponent_school_ncaa\"\n  FROM \"NCAA_INSIGHTS\".\"NCAA\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\"\n  WHERE \"season\" >= 2014\n\n  UNION ALL\n\n  -- Loss rows from historical tournament games (season >= 2014)\n  SELECT\n    \"season\",\n    'loss' AS \"label\",\n    \"lose_seed\" AS \"seed\",\n    \"lose_school_ncaa\" AS \"school_ncaa\",\n    \"win_seed\" AS \"opponent_seed\",\n    \"win_school_ncaa\" AS \"opponent_school_ncaa\"\n  FROM \"NCAA_INSIGHTS\".\"NCAA\".\"MBB_HISTORICAL_TOURNAMENT_GAMES\"\n  WHERE \"season\" >= 2014\n\n  UNION ALL\n\n  -- 2018 tournament results\n  SELECT\n    \"season\",\n    \"label\",\n    \"seed\",\n    \"school_ncaa\",\n    \"opponent_seed\",\n    \"opponent_school_ncaa\"\n  FROM \"NCAA_INSIGHTS\".\"NCAA\".\"_2018_TOURNAMENT_RESULTS\"\n)\nSELECT\n  g.\"season\",\n  g.\"label\",\n  g.\"seed\",\n  g.\"school_ncaa\",\n  team.\"pace_rank\",\n  team.\"poss_40min\",\n  team.\"pace_rating\",\n  team.\"efficiency_rank\",\n  team.\"pts_100poss\",\n  team.\"efficiency_rating\",\n  g.\"opponent_seed\",\n  g.\"opponent_school_ncaa\",\n  opp.\"pace_rank\" AS \"opp_pace_rank\",\n  opp.\"poss_40min\" AS \"opp_poss_40min\",\n  opp.\"pace_rating\" AS \"opp_pace_rating\",\n  opp.\"efficiency_rank\" AS \"opp_efficiency_rank\",\n  opp.\"pts_100poss\" AS \"opp_pts_100poss\",\n  opp.\"efficiency_rating\" AS \"opp_efficiency_rating\",\n  opp.\"pace_rank\" - team.\"pace_rank\" AS \"pace_rank_diff\",\n  opp.\"poss_40min\" - team.\"poss_40min\" AS \"pace_stat_diff\",\n  opp.\"pace_rating\" - team.\"pace_rating\" AS \"pace_rating_diff\",\n  opp.\"efficiency_rank\" - team.\"efficiency_rank\" AS \"eff_rank_diff\",\n  opp.\"pts_100poss\" - team.\"pts_100poss\" AS \"eff_stat_diff\",\n  opp.\"efficiency_rating\" - team.\"efficiency_rating\" AS \"eff_rating_diff\"\nFROM games g\nLEFT JOIN \"NCAA_INSIGHTS\".\"NCAA\".\"FEATURE_ENGINEERING\" team\n  ON g.\"season\" = team.\"season\" AND g.\"school_ncaa\" = team.\"team\"\nLEFT JOIN \"NCAA_INSIGHTS\".\"NCAA\".\"FEATURE_ENGINEERING\" opp\n  ON g.\"season\" = opp.\"season\" AND g.\"opponent_school_ncaa\" = opp.\"team\"" := by
