import LeanDatabase.Parser
import LeanDatabase.SQLSyntax
open LeanDatabase Lean
set_option maxHeartbeats 1000000
set_option maxRecDepth 1000000

namespace N_sf_bq056_eq_1_2

CREATE TABLE PLANET_WAYS («id» INT, «version» INT, «username» STRING, «changeset» INT, «visible» BOOL, «osm_timestamp» INT, «geometry» STRING, «all_tags» STRING, «nodes» STRING)
CREATE TABLE STATES («geo_id» STRING, «region_code» STRING, «division_code» STRING, «state_fips_code» STRING, «state_gnis_code» STRING, «state» STRING, «state_name» STRING, «lsad_code» STRING, «mtfcc_feature_class_code» STRING, «functional_status» STRING, «area_land_meters» INT, «area_water_meters» INT, «int_point_lat» FLOAT, «int_point_lon» FLOAT, «int_point_geom» STRING, «state_geom» STRING)

theorem eq (t0 : TableRel PLANET_WAYS_schema) (t1 : TableRel STATES_schema) :
    (sql%([PLANET_WAYS_schema, STATES_schema]) "/* Find distinct pairs of highway ways in California that: */ /* 1. Are tagged as highway (motorway, trunk, primary, secondary, residential) */ /* 2. Geometrically overlap (ST_INTERSECTS) */ /* 3. Do NOT share any nodes (NOT ARRAYS_OVERLAP) */ /* 4. Neither way has a bridge tag */ WITH california_geom AS (SELECT TO_GEOGRAPHY(\"state_geom\", TRUE) AS geom FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\" WHERE \"state_name\" = 'California'), bridge_ways AS (SELECT DISTINCT w.\"id\" AS way_id FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS bt(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(bt.value, 'key') AS TEXT) = 'bridge'), california_highways AS (SELECT DISTINCT w.\"id\" AS way_id, w.\"geometry\", w.\"nodes\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS ht(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(ht.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(ht.value, 'value') AS TEXT) IN ('motorway', 'trunk', 'primary', 'secondary', 'residential') AND NOT w.\"geometry\" IS NULL AND ST_INTERSECTS(TO_GEOGRAPHY(w.\"geometry\", TRUE), (SELECT geom FROM california_geom)) AND w.\"id\" <> ALL (SELECT way_id FROM bridge_ways)) SELECT COUNT(*) AS NUM_OVERLAPPING_WAYS FROM california_highways AS a JOIN california_highways AS b ON a.way_id < b.way_id AND ST_INTERSECTS(TO_GEOGRAPHY(a.\"geometry\", TRUE), TO_GEOGRAPHY(b.\"geometry\", TRUE)) AND NOT a.\"nodes\" && b.\"nodes\"") t0 t1
  ~= (sql%([PLANET_WAYS_schema, STATES_schema]) "WITH highway_ways AS (SELECT DISTINCT w.\"id\", CAST(w.\"geometry\" AS GEOGRAPHY) AS geog, w.\"nodes\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(t.value, 'key') AS TEXT) = 'highway' AND CAST(JSON_EXTRACT_PATH(t.value, 'value') AS TEXT) IN ('motorway', 'trunk', 'primary', 'secondary', 'residential')), bridge_ways AS (SELECT DISTINCT w.\"id\" FROM \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_OPENSTREETMAP\".\"PLANET_WAYS\" AS w, LATERAL UNNEST(input => w.\"all_tags\") AS t(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE CAST(JSON_EXTRACT_PATH(t.value, 'key') AS TEXT) = 'bridge'), california_roads AS (SELECT h.\"id\", h.geog, h.\"nodes\" FROM highway_ways AS h JOIN \"GEO_OPENSTREETMAP_BOUNDARIES\".\"GEO_US_BOUNDARIES\".\"STATES\" AS s ON s.\"state_name\" = 'California' AND ST_INTERSECTS(h.geog, CAST(s.\"state_geom\" AS GEOGRAPHY)) WHERE h.\"id\" <> ALL (SELECT \"id\" FROM bridge_ways)), roads_with_node_ids AS (SELECT r.\"id\", ANY_VALUE(r.geog) AS geog, ARRAY_AGG(JSON_EXTRACT_PATH(n.value, 'id')) FILTER(WHERE JSON_EXTRACT_PATH(n.value, 'id') IS NOT NULL) AS node_id_arr FROM california_roads AS r, LATERAL UNNEST(input => r.\"nodes\") AS n(SEQ, KEY, PATH, INDEX, VALUE, THIS) GROUP BY r.\"id\") SELECT COUNT(*) AS NUM_OVERLAPPING_WAYS FROM roads_with_node_ids AS a JOIN roads_with_node_ids AS b ON a.\"id\" < b.\"id\" AND ST_INTERSECTS(a.geog, b.geog) WHERE NOT a.node_id_arr && b.node_id_arr") t0 t1
  := by first | sql_equiv | sorry

end N_sf_bq056_eq_1_2
