theorem eq_2_3 :
    sql%([SALES_ORDERLINES_schema, SALES_CUSTOMERCATEGORIES_schema, SALES_CUSTOMERS_schema, SALES_INVOICES_schema, SALES_ORDERS_schema]) "WITH lost_orders AS (\n    -- Orders that do not appear in the invoice table\n    SELECT o.\"OrderID\", o.\"CustomerID\"\n    FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" o\n    WHERE NOT EXISTS (\n        SELECT 1\n        FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n        WHERE i.\"OrderID\" = o.\"OrderID\"\n    )\n),\nlost_order_values AS (\n    -- Calculate the value for each lost order\n    SELECT lo.\"OrderID\", lo.\"CustomerID\",\n           SUM(ol.\"Quantity\" * ol.\"UnitPrice\") AS OrderValue\n    FROM lost_orders lo\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol\n        ON lo.\"OrderID\" = ol.\"OrderID\"\n    GROUP BY lo.\"OrderID\", lo.\"CustomerID\"\n),\ncategory_max AS (\n    -- For each customer category, find the maximum lost order value\n    SELECT cc.\"CustomerCategoryName\",\n           MAX(lov.OrderValue) AS MAXLOSTORDERVALUE\n    FROM lost_order_values lov\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_CUSTOMERS\" c\n        ON lov.\"CustomerID\" = c.\"CustomerID\"\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_CUSTOMERCATEGORIES\" cc\n        ON c.\"CustomerCategoryID\" = cc.\"CustomerCategoryID\"\n    GROUP BY cc.\"CustomerCategoryName\"\n),\navg_max AS (\n    -- Calculate the overall average of the max lost order values across categories\n    SELECT AVG(MAXLOSTORDERVALUE) AS AVGMAXLOSTORDERVALUE\n    FROM category_max\n)\nSELECT cm.\"CustomerCategoryName\",\n       cm.MAXLOSTORDERVALUE,\n       am.AVGMAXLOSTORDERVALUE,\n       ABS(cm.MAXLOSTORDERVALUE - am.AVGMAXLOSTORDERVALUE) AS DIFFERENCEFROMAVERAGE\nFROM category_max cm\nCROSS JOIN avg_max am\nORDER BY DIFFERENCEFROMAVERAGE ASC\nLIMIT 1;" = sql%([SALES_ORDERLINES_schema, SALES_CUSTOMERCATEGORIES_schema, SALES_CUSTOMERS_schema, SALES_INVOICES_schema, SALES_ORDERS_schema]) "WITH lost_orders AS (\n    -- Orders that have no corresponding invoice\n    SELECT o.\"OrderID\", o.\"CustomerID\"\n    FROM \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERS\" o\n    LEFT JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_INVOICES\" i\n        ON o.\"OrderID\" = i.\"OrderID\"\n    WHERE i.\"InvoiceID\" IS NULL\n),\nlost_order_values AS (\n    -- Calculate total value for each lost order\n    SELECT lo.\"OrderID\", lo.\"CustomerID\",\n           SUM(ol.\"Quantity\" * ol.\"UnitPrice\") AS order_value\n    FROM lost_orders lo\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_ORDERLINES\" ol\n        ON lo.\"OrderID\" = ol.\"OrderID\"\n    GROUP BY lo.\"OrderID\", lo.\"CustomerID\"\n),\nmax_per_category AS (\n    -- Max lost order value per customer category\n    SELECT cc.\"CustomerCategoryName\",\n           MAX(lov.order_value) AS MAXLOSTORDERVALUE\n    FROM lost_order_values lov\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_CUSTOMERS\" c\n        ON lov.\"CustomerID\" = c.\"CustomerID\"\n    JOIN \"WIDE_WORLD_IMPORTERS\".\"WIDE_WORLD_IMPORTERS\".\"SALES_CUSTOMERCATEGORIES\" cc\n        ON c.\"CustomerCategoryID\" = cc.\"CustomerCategoryID\"\n    GROUP BY cc.\"CustomerCategoryName\"\n),\navg_max AS (\n    -- Average of all max lost order values across categories\n    SELECT AVG(MAXLOSTORDERVALUE) AS AVGMAXLOSTORDERVALUE\n    FROM max_per_category\n)\nSELECT mpc.\"CustomerCategoryName\",\n       mpc.MAXLOSTORDERVALUE,\n       am.AVGMAXLOSTORDERVALUE,\n       mpc.MAXLOSTORDERVALUE - am.AVGMAXLOSTORDERVALUE AS DIFFERENCEFROMAVERAGE\nFROM max_per_category mpc\nCROSS JOIN avg_max am\nORDER BY ABS(mpc.MAXLOSTORDERVALUE - am.AVGMAXLOSTORDERVALUE) ASC\nLIMIT 1;" := by
