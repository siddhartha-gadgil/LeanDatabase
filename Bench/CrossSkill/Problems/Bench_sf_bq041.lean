/-!
# sf_bq041 — crossskill equivalence(s)

Question: Compute the monthly statistics for new StackOverflow users created in 2021. For each month, report the total number of new users, the percentage of these new users who asked at least one question within 30 days of signing up, and among those who asked a question within 30 days, the percentage who then answered at least one question after their first question and within 30 days following their first question.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq041

CREATE TABLE USERS («id» INT, «display_name» STRING, «about_me» STRING, «age» STRING, «creation_date» INT, «last_access_date» INT, «location» STRING, «reputation» INT, «up_votes» INT, «down_votes» INT, «views» INT, «profile_image_url» STRING, «website_url» STRING)
CREATE TABLE POSTS_ANSWERS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» STRING, «answer_count» STRING, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» STRING, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» INT, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» STRING)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH new_users AS (SELECT \"id\" AS user_id, TO_TIMESTAMP(CAST(\"creation_date\" AS DOUBLE PRECISION) / 1000000) AS signup_ts, DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(\"creation_date\" AS DOUBLE PRECISION) / 1000000)) AS signup_month FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(\"creation_date\" AS DOUBLE PRECISION) / 1000000)) = 2021), asked_within_30d /* Users who asked at least one question within 30 days of signing up */ AS (SELECT DISTINCT u.user_id, u.signup_ts, u.signup_month FROM new_users AS u JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q ON q.\"owner_user_id\" = u.user_id WHERE TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) >= u.signup_ts AND TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) <= u.signup_ts + INTERVAL '30 DAY'), first_question /* For users who asked within 30 days, find their first question */ AS (SELECT a.user_id, a.signup_ts, a.signup_month, MIN(TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000)) AS first_q_ts FROM asked_within_30d AS a JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q ON q.\"owner_user_id\" = a.user_id WHERE TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) >= a.signup_ts AND TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) <= a.signup_ts + INTERVAL '30 DAY' GROUP BY a.user_id, a.signup_ts, a.signup_month), answered_after_q /* Users who answered at least one question after their first question */ /* and within 30 days following their first question */ AS (SELECT DISTINCT fq.user_id, fq.signup_month FROM first_question AS fq JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" AS ans ON ans.\"owner_user_id\" = fq.user_id WHERE TO_TIMESTAMP(CAST(ans.\"creation_date\" AS DOUBLE PRECISION) / 1000000) > fq.first_q_ts AND TO_TIMESTAMP(CAST(ans.\"creation_date\" AS DOUBLE PRECISION) / 1000000) <= fq.first_q_ts + INTERVAL '30 DAY'), monthly_stats /* Monthly aggregation */ AS (SELECT u.signup_month, COUNT(*) AS new_users, COUNT(DISTINCT a.user_id) AS asked_within_30d, COUNT(DISTINCT aa.user_id) AS answered_after_question_within_30d FROM new_users AS u LEFT JOIN asked_within_30d AS a ON u.user_id = a.user_id LEFT JOIN answered_after_q AS aa ON u.user_id = aa.user_id GROUP BY u.signup_month) SELECT CAST(signup_month AS DATE) AS SIGNUP_MONTH, new_users AS NEW_USERS, asked_within_30d AS ASKED_WITHIN_30D, answered_after_question_within_30d AS ANSWERED_AFTER_QUESTION_WITHIN_30D, ROUND(CAST(asked_within_30d * 100.0 AS DOUBLE PRECISION) / new_users, 4) AS PCT_ASKED_WITHIN_30D, ROUND(CAST(answered_after_question_within_30d * 100.0 AS DOUBLE PRECISION) / asked_within_30d, 4) AS PCT_ANSWERED_AFTER_FIRST_Q_WITHIN_30D FROM monthly_stats ORDER BY signup_month" = sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH new_users AS (SELECT \"id\" AS user_id, TO_TIMESTAMP(CAST(\"creation_date\" AS DOUBLE PRECISION) / 1000000) AS signup_ts, CAST(DATE_TRUNC('MONTH', TO_TIMESTAMP(CAST(\"creation_date\" AS DOUBLE PRECISION) / 1000000)) AS DATE) AS signup_month FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\" WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(CAST(\"creation_date\" AS DOUBLE PRECISION) / 1000000)) = 2021), first_question AS (SELECT q.\"owner_user_id\" AS user_id, MIN(TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000)) AS first_q_ts FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" AS q INNER JOIN new_users AS u ON q.\"owner_user_id\" = u.user_id WHERE TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) >= u.signup_ts AND TO_TIMESTAMP(CAST(q.\"creation_date\" AS DOUBLE PRECISION) / 1000000) < u.signup_ts + INTERVAL '30 DAY' GROUP BY q.\"owner_user_id\"), answered_after_first_q AS (SELECT DISTINCT fq.user_id FROM first_question AS fq INNER JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" AS a ON fq.user_id = a.\"owner_user_id\" WHERE TO_TIMESTAMP(CAST(a.\"creation_date\" AS DOUBLE PRECISION) / 1000000) > fq.first_q_ts AND TO_TIMESTAMP(CAST(a.\"creation_date\" AS DOUBLE PRECISION) / 1000000) < fq.first_q_ts + INTERVAL '30 DAY') SELECT u.signup_month AS SIGNUP_MONTH, COUNT(DISTINCT u.user_id) AS NEW_USERS, COUNT(DISTINCT fq.user_id) AS ASKED_WITHIN_30D, COUNT(DISTINCT ans.user_id) AS ANSWERED_AFTER_QUESTION_WITHIN_30D, ROUND(CAST(CAST(100.0 * COUNT(DISTINCT fq.user_id) AS DOUBLE PRECISION) / COUNT(DISTINCT u.user_id) AS DECIMAL), 4) AS PCT_ASKED_WITHIN_30D, ROUND(CAST(CAST(100.0 * COUNT(DISTINCT ans.user_id) AS DOUBLE PRECISION) / NULLIF(COUNT(DISTINCT fq.user_id), 0) AS DECIMAL), 4) AS PCT_ANSWERED_AFTER_FIRST_Q_WITHIN_30D FROM new_users AS u LEFT JOIN first_question AS fq ON u.user_id = fq.user_id LEFT JOIN answered_after_first_q AS ans ON fq.user_id = ans.user_id GROUP BY u.signup_month ORDER BY u.signup_month" := by
  first | sql_equiv | sorry

