/-!
# sf_bq041 — crossskill equivalence(s)

Question: Compute the monthly statistics for new StackOverflow users created in 2021. For each month, report the total number of new users, the percentage of these new users who asked at least one question within 30 days of signing up, and among those who asked a question within 30 days, the percentage who then answered at least one question after their first question and within 30 days following their first question.

Each theorem: `first | sql_equiv | sorry` — proved by `sql_equiv` where it closes, else
`sorry`. Data-dependent differences are stated as explicit `HYPOTHESIS` antecedents (sound).
-/

namespace Bench_sf_bq041

CREATE TABLE USERS («id» INT, «display_name» STRING, «about_me» STRING, «age» STRING, «creation_date» INT, «last_access_date» INT, «location» STRING, «reputation» INT, «up_votes» INT, «down_votes» INT, «views» INT, «profile_image_url» STRING, «website_url» STRING)
CREATE TABLE POSTS_ANSWERS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» STRING, «answer_count» STRING, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» STRING, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» INT, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» STRING)
CREATE TABLE POSTS_QUESTIONS («id» INT, «title» STRING, «body» STRING, «accepted_answer_id» INT, «answer_count» INT, «comment_count» INT, «community_owned_date» INT, «creation_date» INT, «favorite_count» INT, «last_activity_date» INT, «last_edit_date» INT, «last_editor_display_name» STRING, «last_editor_user_id» INT, «owner_display_name» STRING, «owner_user_id» INT, «parent_id» STRING, «post_type_id» INT, «score» INT, «tags» STRING, «view_count» INT)

-- eq_0_1: needs a data hypothesis over multiple tables (not stated); likely `sorry`.
theorem eq_0_1 :
    sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH new_users AS (\n  SELECT \n    \"id\" AS user_id,\n    TO_TIMESTAMP(\"creation_date\"/1000000) AS signup_ts,\n    DATE_TRUNC('month', TO_TIMESTAMP(\"creation_date\"/1000000)) AS signup_month\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\"/1000000)) = 2021\n),\n\n-- Users who asked at least one question within 30 days of signing up\nasked_within_30d AS (\n  SELECT DISTINCT\n    u.user_id,\n    u.signup_ts,\n    u.signup_month\n  FROM new_users u\n  JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    ON q.\"owner_user_id\" = u.user_id\n  WHERE TO_TIMESTAMP(q.\"creation_date\"/1000000) >= u.signup_ts\n    AND TO_TIMESTAMP(q.\"creation_date\"/1000000) <= DATEADD('day', 30, u.signup_ts)\n),\n\n-- For users who asked within 30 days, find their first question\nfirst_question AS (\n  SELECT \n    a.user_id,\n    a.signup_ts,\n    a.signup_month,\n    MIN(TO_TIMESTAMP(q.\"creation_date\"/1000000)) AS first_q_ts\n  FROM asked_within_30d a\n  JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n    ON q.\"owner_user_id\" = a.user_id\n  WHERE TO_TIMESTAMP(q.\"creation_date\"/1000000) >= a.signup_ts\n    AND TO_TIMESTAMP(q.\"creation_date\"/1000000) <= DATEADD('day', 30, a.signup_ts)\n  GROUP BY a.user_id, a.signup_ts, a.signup_month\n),\n\n-- Users who answered at least one question after their first question \n-- and within 30 days following their first question\nanswered_after_q AS (\n  SELECT DISTINCT\n    fq.user_id,\n    fq.signup_month\n  FROM first_question fq\n  JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" ans\n    ON ans.\"owner_user_id\" = fq.user_id\n  WHERE TO_TIMESTAMP(ans.\"creation_date\"/1000000) > fq.first_q_ts\n    AND TO_TIMESTAMP(ans.\"creation_date\"/1000000) <= DATEADD('day', 30, fq.first_q_ts)\n),\n\n-- Monthly aggregation\nmonthly_stats AS (\n  SELECT \n    u.signup_month,\n    COUNT(*) AS new_users,\n    COUNT(DISTINCT a.user_id) AS asked_within_30d,\n    COUNT(DISTINCT aa.user_id) AS answered_after_question_within_30d\n  FROM new_users u\n  LEFT JOIN asked_within_30d a ON u.user_id = a.user_id\n  LEFT JOIN answered_after_q aa ON u.user_id = aa.user_id\n  GROUP BY u.signup_month\n)\n\nSELECT\n  signup_month::DATE AS SIGNUP_MONTH,\n  new_users AS NEW_USERS,\n  asked_within_30d AS ASKED_WITHIN_30D,\n  answered_after_question_within_30d AS ANSWERED_AFTER_QUESTION_WITHIN_30D,\n  ROUND(asked_within_30d * 100.0 / new_users, 4) AS PCT_ASKED_WITHIN_30D,\n  ROUND(answered_after_question_within_30d * 100.0 / asked_within_30d, 4) AS PCT_ANSWERED_AFTER_FIRST_Q_WITHIN_30D\nFROM monthly_stats\nORDER BY signup_month;" = sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH new_users AS (\n  SELECT \n    \"id\" AS user_id,\n    TO_TIMESTAMP(\"creation_date\" / 1000000) AS signup_ts,\n    DATE_TRUNC('MONTH', TO_TIMESTAMP(\"creation_date\" / 1000000))::DATE AS signup_month\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\"\n  WHERE EXTRACT(YEAR FROM TO_TIMESTAMP(\"creation_date\" / 1000000)) = 2021\n),\nfirst_question AS (\n  SELECT \n    q.\"owner_user_id\" AS user_id,\n    MIN(TO_TIMESTAMP(q.\"creation_date\" / 1000000)) AS first_q_ts\n  FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n  INNER JOIN new_users u ON q.\"owner_user_id\" = u.user_id\n  WHERE TO_TIMESTAMP(q.\"creation_date\" / 1000000) >= u.signup_ts\n    AND TO_TIMESTAMP(q.\"creation_date\" / 1000000) < DATEADD('day', 30, u.signup_ts)\n  GROUP BY q.\"owner_user_id\"\n),\nanswered_after_first_q AS (\n  SELECT DISTINCT fq.user_id\n  FROM first_question fq\n  INNER JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a \n    ON fq.user_id = a.\"owner_user_id\"\n  WHERE TO_TIMESTAMP(a.\"creation_date\" / 1000000) > fq.first_q_ts\n    AND TO_TIMESTAMP(a.\"creation_date\" / 1000000) < DATEADD('day', 30, fq.first_q_ts)\n)\nSELECT \n  u.signup_month AS SIGNUP_MONTH,\n  COUNT(DISTINCT u.user_id) AS NEW_USERS,\n  COUNT(DISTINCT fq.user_id) AS ASKED_WITHIN_30D,\n  COUNT(DISTINCT ans.user_id) AS ANSWERED_AFTER_QUESTION_WITHIN_30D,\n  ROUND(100.0 * COUNT(DISTINCT fq.user_id) / COUNT(DISTINCT u.user_id), 4) AS PCT_ASKED_WITHIN_30D,\n  ROUND(100.0 * COUNT(DISTINCT ans.user_id) / NULLIF(COUNT(DISTINCT fq.user_id), 0), 4) AS PCT_ANSWERED_AFTER_FIRST_Q_WITHIN_30D\nFROM new_users u\nLEFT JOIN first_question fq ON u.user_id = fq.user_id\nLEFT JOIN answered_after_first_q ans ON fq.user_id = ans.user_id\nGROUP BY u.signup_month\nORDER BY u.signup_month;" := by
  first | sql_equiv | sorry

