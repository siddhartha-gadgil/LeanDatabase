   COUNT(*) AS new_users,\n    COUNT(DISTINCT a.user_id) AS asked_within_30d,\n    COUNT(DISTINCT aa.user_id) AS answered_after_question_within_30d\n  FROM new_users u\n  LEFT JOIN asked_within_30d a ON u.user_id = a.user_id\n  LEFT JOIN answered_after_q aa ON u.user_id = aa.user_id\n  GROUP BY u.signup_month\n)\n\nSELECT\n  signup_month::DATE AS SIGNUP_MONTH,\n  new_users AS NEW_USERS,\n  asked_within_30d AS ASKED_WITHIN_30D,\n  answered_after_question_within_30d AS ANSWERED_AFTER_QUESTION_WITHIN_30D,\n  ROUND(asked_within_30d * 100.0 / new_users, 4) AS PCT_ASKED_WITHIN_30D,\n  ROUND(answered_after_question_within_30d * 100.0 / asked_within_30d, 4) AS PCT_ANSWERED_AFTER_FIRST_Q_WITHIN_30D\nFROM monthly_stats\nORDER BY signup_month;" = sql%([USERS_schema, POSTS_ANSWERS_schema, POSTS_QUESTIONS_schema]) "WITH users_2021 AS (\n    SELECT\n        \"id\" AS user_id,\n        TO_TIMESTAMP(\"creation_date\" / 1000000) AS signup_ts,\n        DATE_TRUNC('MONTH', TO_TIMESTAMP(\"creation_date\" / 1000000)) AS signup_month\n    FROM \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"USERS\"\n    WHERE YEAR(TO_TIMESTAMP(\"creation_date\" / 1000000)) = 2021\n),\n\n-- First question within 30 days of signup\nfirst_question AS (\n    SELECT\n        u.user_id,\n        u.signup_month,\n        MIN(TO_TIMESTAMP(q.\"creation_date\" / 1000000)) AS first_question_ts\n    FROM users_2021 u\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_QUESTIONS\" q\n        ON q.\"owner_user_id\" = u.user_id\n    WHERE TO_TIMESTAMP(q.\"creation_date\" / 1000000) >= u.signup_ts\n      AND TO_TIMESTAMP(q.\"creation_date\" / 1000000) <= DATEADD('DAY', 30, u.signup_ts)\n    GROUP BY u.user_id, u.signup_month\n),\n\n-- Users who answered at least one question after their first question and within 30 days of first question\nanswered_after AS (\n    SELECT DISTINCT\n        fq.user_id,\n        fq.signup_month\n    FROM first_question fq\n    JOIN \"STACKOVERFLOW\".\"STACKOVERFLOW\".\"POSTS_ANSWERS\" a\n        ON a.\"owner_user_id\" = fq.user_id\n    WHERE TO_TIMESTAMP(a.\"creation_date\" / 1000000) > fq.first_question_ts\n      AND TO_TIMESTAMP(a.\"creation_date\" / 1000000) <= DATEADD('DAY', 30, fq.first_question_ts)\n),\n\nmonthly_stats AS (\n    SELECT\n        u.signup_month,\n        COUNT(DISTINCT u.user_id) AS new_users,\n        COUNT(DISTINCT fq.user_id) AS asked_within_30d,\n        COUNT(DISTINCT aa.user_id) AS answered_after_question_within_30d\n    FROM users_2021 u\n    LEFT JOIN first_question fq ON u.user_id = fq.user_id\n    LEFT JOIN answered_after aa ON u.user_id = aa.user_id\n    GROUP BY u.signup_month\n)\n\nSELECT\n    signup_month AS \"SIGNUP_MONTH\",\n    new_users AS \"NEW_USERS\",\n    asked_within_30d AS \"ASKED_WITHIN_30D\",\n    answered_after_question_within_30d AS \"ANSWERED_AFTER_QUESTION_WITHIN_30D\",\n    ROUND(100.0 * asked_within_30d / new_users, 2) AS \"PCT_ASKED_WITHIN_30D\",\n    ROUND(100.0 * answered_after_question_within_30d / NULLIF(asked_within_30d, 0), 2) AS \"PCT_ANSWERED_AFTER_FIRST_Q_WITHIN_30D\"\nFROM monthly_stats\nORDER BY signup_month;" := by
