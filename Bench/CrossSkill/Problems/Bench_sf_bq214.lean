    sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "-- Step 1: Find US utility patents with B2 classification granted between 2010 and 2014\n-- Step 2: Count forward citations within a month of each patent's filing date\n-- Step 3: Find the patent with the most such forward citations\n-- Step 4: For that patent, find the most similar patent from the same filing year using dot product\n\nWITH target_patents AS (\n  SELECT \"publication_number\", \"filing_date\"\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\"\n  WHERE \"country_code\" = 'US' \n    AND \"kind_code\" = 'B2' \n    AND \"application_kind\" = 'A'\n    AND \"grant_date\" BETWEEN 20100101 AND 20141231\n),\n-- Forward citations: patents in PUBLICATIONS that cite target patents (via backward citation array)\n-- Within a month: citing patent's filing_date is within 30 days of cited patent's filing_date\nforward_citation_counts AS (\n  SELECT \n    tp.\"publication_number\",\n    tp.\"filing_date\",\n    COUNT(DISTINCT p_citing.\"publication_number\") AS citation_count\n  FROM target_patents tp\n  LEFT JOIN (\n    SELECT \n      p.\"publication_number\",\n      p.\"filing_date\" AS citing_filing_date,\n      c.value:\"publication_number\"::STRING AS cited_pub\n    FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" p,\n    LATERAL FLATTEN(input => p.\"citation\") c\n  ) p_citing\n    ON p_citing.cited_pub = tp.\"publication_number\"\n    AND ABS(\n      DATEDIFF('day', \n        TRY_TO_DATE(CAST(p_citing.citing_filing_date AS VARCHAR), 'YYYYMMDD'),\n        TRY_TO_DATE(CAST(tp.\"filing_date\" AS VARCHAR), 'YYYYMMDD')\n      )\n    ) <= 30\n  GROUP BY tp.\"publication_number\", tp.\"filing_date\"\n),\n-- Find the patent with the most forward citations within a month\nfocal_patent AS (\n  SELECT \"publication_number\" AS focal_pub, \n         \"filing_date\",\n         citation_count\n  FROM forward_citation_counts\n  ORDER BY citation_count DESC, \"publication_number\" ASC\n  LIMIT 1\n),\n-- Find the most similar patent from the same filing year using dot product of embeddings\nfocal_embedding AS (\n  SELECT a.\"embedding_v1\" AS emb, fp.focal_pub, fp.\"filing_date\", fp.citation_count\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" a\n  JOIN focal_patent fp ON a.\"publication_number\" = fp.focal_pub\n),\ncandidate_patents AS (\n  SELECT a.\"publication_number\", a.\"embedding_v1\" AS emb\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" a\n  JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" p\n    ON a.\"publication_number\" = p.\"publication_number\"\n  CROSS JOIN focal_patent fp\n  WHERE FLOOR(p.\"filing_date\" / 10000) = FLOOR(fp.\"filing_date\" / 10000)\n    AND a.\"publication_number\" != fp.focal_pub\n    AND a.\"embedding_v1\" IS NOT NULL\n)\nSELECT \n  t.focal_pub,\n  t.citation_count,\n  c.\"publication_number\" AS similar_patent\nFROM candidate_patents c\nCROSS JOIN focal_embedding t\nORDER BY (\n  t.emb[0]::FLOAT * c.emb[0]::FLOAT + t.emb[1]::FLOAT * c.emb[1]::FLOAT + t.emb[2]::FLOAT * c.emb[2]::FLOAT + t.emb[3]::FLOAT * c.emb[3]::FLOAT + t.emb[4]::FLOAT * c.emb[4]::FLOAT + t.emb[5]::FLOAT * c.emb[5]::FLOAT + t.emb[6]::FLOAT * c.emb[6]::FLOAT + t.emb[7]::FLOAT * c.emb[7]::FLOAT + t.emb[8]::FLOAT * c.emb[8]::FLOAT + t.emb[9]::FLOAT * c.emb[9]::FLOAT + t.emb[10]::FLOAT * c.emb[10]::FLOAT + t.emb[11]::FLOAT * c.emb[11]::FLOAT + t.emb[12]::FLOAT * c.emb[12]::FLOAT + t.emb[13]::FLOAT * c.emb[13]::FLOAT + t.emb[14]::FLOAT * c.emb[14]::FLOAT + t.emb[15]::FLOAT * c.emb[15]::FLOAT + t.emb[16]::FLOAT * c.emb[16]::FLOAT + t.emb[17]::FLOAT * c.emb[17]::FLOAT + t.emb[18]::FLOAT * c.emb[18]::FLOAT + t.emb[19]::FLOAT * c.emb[19]::FLOAT + t.emb[20]::FLOAT * c.emb[20]::FLOAT + t.emb[21]::FLOAT * c.emb[21]::FLOAT + t.emb[22]::FLOAT * c.emb[22]::FLOAT + t.emb[23]::FLOAT * c.emb[23]::FLOAT + t.emb[24]::FLOAT * c.emb[24]::FLOAT + t.emb[25]::FLOAT * c.emb[25]::FLOAT + t.emb[26]::FLOAT * c.emb[26]::FLOAT + t.emb[27]::FLOAT * c.emb[27]::FLOAT + t.emb[28]::FLOAT * c.emb[28]::FLOAT + t.emb[29]::FLOAT * c.emb[29]::FLOAT + t.emb[30]::FLOAT * c.emb[30]::FLOAT + t.emb[31]::FLOAT * c.emb[31]::FLOAT + t.emb[32]::FLOAT * c.emb[32]::FLOAT + t.emb[33]::FLOAT * c.emb[33]::FLOAT + t.emb[34]::FLOAT * c.emb[34]::FLOAT + t.emb[35]::FLOAT * c.emb[35]::FLOAT + t.emb[36]::FLOAT * c.emb[36]::FLOAT + t.emb[37]::FLOAT * c.emb[37]::FLOAT + t.emb[38]::FLOAT * c.emb[38]::FLOAT + t.emb[39]::FLOAT * c.emb[39]::FLOAT + t.emb[40]::FLOAT * c.emb[40]::FLOAT + t.emb[41]::FLOAT * c.emb[41]::FLOAT + t.emb[42]::FLOAT * c.emb[42]::FLOAT + t.emb[43]::FLOAT * c.emb[43]::FLOAT + t.emb[44]::FLOAT * c.emb[44]::FLOAT + t.emb[45]::FLOAT * c.emb[45]::FLOAT + t.emb[46]::FLOAT * c.emb[46]::FLOAT + t.emb[47]::FLOAT * c.emb[47]::FLOAT + t.emb[48]::FLOAT * c.emb[48]::FLOAT + t.emb[49]::FLOAT * c.emb[49]::FLOAT + t.emb[50]::FLOAT * c.emb[50]::FLOAT + t.emb[51]::FLOAT * c.emb[51]::FLOAT + t.emb[52]::FLOAT * c.emb[52]::FLOAT + t.emb[53]::FLOAT * c.emb[53]::FLOAT + t.emb[54]::FLOAT * c.emb[54]::FLOAT + t.emb[55]::FLOAT * c.emb[55]::FLOAT + t.emb[56]::FLOAT * c.emb[56]::FLOAT + t.emb[57]::FLOAT * c.emb[57]::FLOAT + t.emb[58]::FLOAT * c.emb[58]::FLOAT + t.emb[59]::FLOAT * c.emb[59]::FLOAT + t.emb[60]::FLOAT * c.emb[60]::FLOAT + t.emb[61]::FLOAT * c.emb[61]::FLOAT + t.emb[62]::FLOAT * c.emb[62]::FLOAT + t.emb[63]::FLOAT * c.emb[63]::FLOAT\n) DESC\nLIMIT 1;" = sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "-- Find US B2 patent granted 2010-2014 with most forward citations within a month of filing date\n-- Then find the most similar patent from the same filing year using embedding dot product\n\nWITH focal_patents AS (\n    -- US utility patents (B2) granted between 2010 and 2014\n    SELECT p.\"publication_number\", p.\"filing_date\"\n    FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" p\n    WHERE p.\"country_code\" = 'US'\n      AND p.\"kind_code\" = 'B2'\n      AND p.\"grant_date\" >= 20100101\n      AND p.\"grant_date\" <= 20141231\n      AND p.\"filing_date\" > 0\n),\nforward_citations AS (\n    -- Forward citations: other patents in PUBLICATIONS that cite the focal patent\n    -- Filter to those filed within 30 days of the focal patent's filing date\n    SELECT fp.\"publication_number\" AS focal_pub,\n           fp.\"filing_date\" AS focal_fd,\n           p2.\"publication_number\" AS citing_pub,\n           p2.\"filing_date\" AS citing_fd\n    FROM focal_patents fp\n    JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" p2\n      CROSS JOIN LATERAL FLATTEN(input => p2.\"citation\") c\n      ON c.value:\"publication_number\"::STRING = fp.\"publication_number\"\n    WHERE p2.\"filing_date\" > 0\n      AND ABS(DATEDIFF('day',\n               TO_DATE(fp.\"filing_date\"::STRING, 'YYYYMMDD'),\n               TO_DATE(p2.\"filing_date\"::STRING, 'YYYYMMDD')\n           )) <= 30\n),\ncitation_counts AS (\n    SELECT focal_pub, focal_fd, COUNT(*) AS citation_count\n    FROM forward_citations\n    GROUP BY focal_pub, focal_fd\n),\ntop_patent AS (\n    SELECT focal_pub, focal_fd, citation_count\n    FROM citation_counts\n    ORDER BY citation_count DESC\n    LIMIT 1\n),\n-- Find most similar patent from same filing year using embedding dot product\nfocal_embedding AS (\n    SELECT a.\"embedding_v1\" AS focal_emb\n    FROM top_patent tp\n    JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" a\n      ON tp.focal_pub = a.\"publication_number\"\n),\ncandidates AS (\n    -- All patents from the same filing year (regardless of type)\n    SELECT p.\"publication_number\", a.\"embedding_v1\"\n    FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" p\n    JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" a\n      ON p.\"publication_number\" = a.\"publication_number\"\n    JOIN top_patent tp ON 1=1\n    WHERE FLOOR(p.\"filing_date\" / 10000) = FLOOR(tp.focal_fd / 10000)\n      AND p.\"publication_number\" != tp.focal_pub\n      AND a.\"embedding_v1\" IS NOT NULL\n),\nsimilarity_scores AS (\n    SELECT c.\"publication_number\" AS similar_pub,\n           SUM(fe.value::FLOAT * ce.value::FLOAT) AS dot_product\n    FROM candidates c,\n         focal_embedding f,\n         LATERAL FLATTEN(input => f.focal_emb) fe,\n         LATERAL FLATTEN(input => c.\"embedding_v1\") ce\n    WHERE fe.index = ce.index\n    GROUP BY c.\"publication_number\"\n)\nSELECT tp.focal_pub AS \"FOCAL_PUB\",\n       tp.citation_count AS \"CITATION_COUNT\",\n       ss.similar_pub AS \"SIMILAR_PATENT\"\nFROM top_patent tp,\n     (SELECT similar_pub FROM similarity_scores ORDER BY dot_product DESC LIMIT 1) ss;" := by
