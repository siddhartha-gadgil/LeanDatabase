gardless of type) */ AS (SELECT a.\"publication_number\", a.\"embedding_v1\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p ON a.\"publication_number\" = p.\"publication_number\" JOIN top_patent AS tp ON 1 = 1 WHERE FLOOR(CAST(p.\"filing_date\" AS DOUBLE PRECISION) / 10000) = FLOOR(CAST(tp.focal_filing_date AS DOUBLE PRECISION) / 10000) AND a.\"publication_number\" <> tp.focal_pub AND ARRAY_LENGTH(a.\"embedding_v1\", 1) = 64), dot_products /* Step 6: Compute dot product similarity */ AS (SELECT c.\"publication_number\", SUM(CAST(te.value AS DOUBLE PRECISION) * CAST(ce.value AS DOUBLE PRECISION)) AS similarity FROM candidates AS c, target_emb AS t, LATERAL UNNEST(input => t.\"embedding_v1\") AS te(SEQ, KEY, PATH, INDEX, VALUE, THIS), LATERAL UNNEST(input => c.\"embedding_v1\") AS ce(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE te.index = ce.index GROUP BY c.\"publication_number\"), most_similar /* Step 7: Find the most similar patent */ AS (SELECT \"publication_number\" AS similar_patent, similarity FROM dot_products ORDER BY similarity DESC LIMIT 1) /* Final result */ SELECT tp.focal_pub, tp.citation_count, ms.similar_patent FROM top_patent AS tp CROSS JOIN most_similar AS ms") t ~= (sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "/* Step 1: Find US utility patents with B2 classification granted between 2010 and 2014 */ /* Step 2: Count forward citations within a month of each patent's filing date */ /* Step 3: Find the patent with the most such forward citations */ /* Step 4: For that patent, find the most similar patent from the same filing year using dot product */ WITH target_patents AS (SELECT \"publication_number\", \"filing_date\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" WHERE \"country_code\" = 'US' AND \"kind_code\" = 'B2' AND \"application_kind\" = 'A' AND \"grant_date\" BETWEEN 20100101 AND 20141231), forward_citation_counts /* Forward citations: patents in 