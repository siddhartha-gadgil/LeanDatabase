ing year using dot product of embeddings */ AS (SELECT a.\"embedding_v1\" AS emb, fp.focal_pub, fp.\"filing_date\", fp.citation_count FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a JOIN focal_patent AS fp ON a.\"publication_number\" = fp.focal_pub), candidate_patents AS (SELECT a.\"publication_number\", a.\"embedding_v1\" AS emb FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p ON a.\"publication_number\" = p.\"publication_number\" CROSS JOIN focal_patent AS fp WHERE FLOOR(CAST(p.\"filing_date\" AS DOUBLE PRECISION) / 10000) = FLOOR(CAST(fp.\"filing_date\" AS DOUBLE PRECISION) / 10000) AND a.\"publication_number\" <> fp.focal_pub AND NOT a.\"embedding_v1\" IS NULL) SELECT t.focal_pub, t.citation_count, c.\"publication_number\" AS similar_patent FROM candidate_patents AS c CROSS JOIN focal_embedding AS t ORDER BY (CAST(t.emb[1] AS DOUBLE PRECISION) * CAST(c.emb[1] AS DOUBLE PRECISION) + CAST(t.emb[2] AS DOUBLE PRECISION) * CAST(c.emb[2] AS DOUBLE PRECISION) + CAST(t.emb[3] AS DOUBLE PRECISION) * CAST(c.emb[3] AS DOUBLE PRECISION) + CAST(t.emb[4] AS DOUBLE PRECISION) * CAST(c.emb[4] AS DOUBLE PRECISION) + CAST(t.emb[5] AS DOUBLE PRECISION) * CAST(c.emb[5] AS DOUBLE PRECISION) + CAST(t.emb[6] AS DOUBLE PRECISION) * CAST(c.emb[6] AS DOUBLE PRECISION) + CAST(t.emb[7] AS DOUBLE PRECISION) * CAST(c.emb[7] AS DOUBLE PRECISION) + CAST(t.emb[8] AS DOUBLE PRECISION) * CAST(c.emb[8] AS DOUBLE PRECISION) + CAST(t.emb[9] AS DOUBLE PRECISION) * CAST(c.emb[9] AS DOUBLE PRECISION) + CAST(t.emb[10] AS DOUBLE PRECISION) * CAST(c.emb[10] AS DOUBLE PRECISION) + CAST(t.emb[11] AS DOUBLE PRECISION) * CAST(c.emb[11] AS DOUBLE PRECISION) + CAST(t.emb[12] AS DOUBLE PRECISION) * CAST(c.emb[12] AS DOUBLE PRECISION) + CAST(t.emb[13] AS DOUBLE PRECISION) * CAST(c.emb[13] AS DOUBLE PRECISION) + CAST(t.emb[14] AS DOUBLE PRECISION) * CAST(c.emb[14] AS DOUBLE PRECISION) + CAST(t.emb[15] AS DOUBLE PRECISION) * CAST(c.emb[15] AS DOUBLE PRECISION) + CAST(t.emb[16] AS DOUBLE PRECISION) * CAST(c.emb[16] AS DOUBLE PRECISION) + CAST(t.emb[17] AS DOUBLE PRECISION) * CAST(c.emb[17] AS DOUBLE PRECISION) + CAST(t.emb[18] AS DOUBLE PRECISION) * CAST(c.emb[18] AS DOUBLE PRECISION) + CAST(t.emb[19] AS DOUBLE PRECISION) * CAST(c.emb[19] AS DOUBLE PRECISION) + CAST(t.emb[20] AS DOUBLE PRECISION) * CAST(c.emb[20] AS DOUBLE PRECISION) + CAST(t.emb[21] AS DOUBLE PRECISION) * CAST(c.emb[21] AS DOUBLE PRECISION) + CAST(t.emb[22] AS DOUBLE PRECISION) * CAST(c.emb[22] AS DOUBLE PRECISION) + CAST(t.emb[23] AS DOUBLE PRECISION) * CAST(c.emb[23] AS DOUBLE PRECISION) + CAST(t.emb[24] AS DOUBLE PRECISION) * CAST(c.emb[24] AS DOUBLE PRECISION) + CAST(t.emb[25] AS DOUBLE PRECISION) * CAST(c.emb[25] AS DOUBLE PRECISION) + CAST(t.emb[26] AS DOUBLE PRECISION) * CAST(c.emb[26] AS DOUBLE PRECISION) + CAST(t.emb[27] AS DOUBLE PRECISION) * CAST(c.emb[27] AS DOUBLE PRECISION) + CAST(t.emb[28] AS DOUBLE PRECISION) * CAST(c.emb[28] AS DOUBLE PRECISION) + CAST(t.emb[29] AS DOUBLE PRECISION) * CAST(c.emb[29] AS DOUBLE PRECISION) + CAST(t.emb[30] AS DOUBLE PRECISION) * CAST(c.emb[30] AS DOUBLE PRECISION) + CAST(t.emb[31] AS DOUBLE PRECISION) * CAST(c.emb[31] AS DOUBLE PRECISION) + CAST(t.emb[32] AS DOUBLE PRECISION) * CAST(c.emb[32] AS DOUBLE PRECISION) + CAST(t.emb[33] AS DOUBLE PRECISION) * CAST(c.emb[33] AS DOUBLE PRECISION) + CAST(t.emb[34] AS DOUBLE PRECISION) * CAST(c.emb[34] AS DOUBLE PRECISION) + CAST(t.emb[35] AS DOUBLE PRECISION) * CAST(c.emb[35] AS DOUBLE PRECISION) + CAST(t.emb[36] AS DOUBLE PRECISION) * CAST(c.emb[36] AS DOUBLE PRECISION) + CAST(t.emb[37] AS DOUBLE PRECISION) * CAST(c.emb[37] AS DOUBLE PRECISION) + CAST(t.emb[38] AS DOUBLE PRECISION) * CAST(c.emb[38] AS DOUBLE PRECISION) + CAST(t.emb[39] AS DOUBLE PRECISION) * CAST(c.emb[39] AS DOUBLE PRECISION) + CAST(t.emb[40] AS DOUBLE PRECISION) * CAST(c.emb[40] AS DOUBLE PRECISION) + CAST(t.emb[41] AS DOUBLE PRECISION) * CAST(c.emb[41] AS DOUBLE PRECISION) + CAST(t.emb[42] AS DOUBLE PRECISION) * CAST(c.emb[42] AS DOUBLE PRECISION) + CAST(t.emb[43] AS DOUBLE PRECISION) * CAST(c.emb[43] AS DOUBLE PRECISION) + CAST(t.emb[44] AS DOUBLE PRECISION) * CAST(c.emb[44] AS DOUBLE PRECISION) + CAST(t.emb[45] AS DOUBLE PRECISION) * CAST(c.emb[45] AS DOUBLE PRECISION) + CAST(t.emb[46] AS DOUBLE PRECISION) * CAST(c.emb[46] AS DOUBLE PRECISION) + CAST(t.emb[47] AS DOUBLE PRECISION) * CAST(c.emb[47] AS DOUBLE PRECISION) + CAST(t.emb[48] AS DOUBLE PRECISION) * CAST(c.emb[48] AS DOUBLE PRECISION) + CAST(t.emb[49] AS DOUBLE PRECISION) * CAST(c.emb[49] AS DOUBLE PRECISION) + CAST(t.emb[50] AS DOUBLE PRECISION) * CAST(c.emb[50] AS DOUBLE PRECISION) + CAST(t.emb[51] AS DOUBLE PRECISION) * CAST(c.emb[51] AS DOUBLE PRECISION) + CAST(t.emb[52] AS DOUBLE PRECISION) * CAST(c.emb[52] AS DOUBLE PRECISION) + CAST(t.emb[53] AS DOUBLE PRECISION) * CAST(c.emb[53] AS DOUBLE PRECISION) + CAST(t.emb[54] AS DOUBLE PRECISION) * CAST(c.emb[54] AS DOUBLE PRECISION) + CAST(t.emb[55] AS DOUBLE PRECISION) * CAST(c.emb[55] AS DOUBLE PRECISION) + CAST(t.emb[56] AS DOUBLE PRECISION) * CAST(c.emb[56] AS DOUBLE PRECISION) + CAST(t.emb[57] AS DOUBLE PRECISION) * CAST(c.emb[57] AS DOUBLE PRECISION) + CAST(t.emb[58] AS DOUBLE PRECISION) * CAST(c.emb[58] AS DOUBLE PRECISION) + CAST(t.emb[59] AS DOUBLE PRECISION) * CAST(c.emb[59] AS DOUBLE PRECISION) + CAST(t.emb[60] AS DOUBLE PRECISION) * CAST(c.emb[60] AS DOUBLE PRECISION) + CAST(t.emb[61] AS DOUBLE PRECISION) * CAST(c.emb[61] AS DOUBLE PRECISION) + CAST(t.emb[62] AS DOUBLE PRECISION) * CAST(c.emb[62] AS DOUBLE PRECISION) + CAST(t.emb[63] AS DOUBLE PRECISION) * CAST(c.emb[63] AS DOUBLE PRECISION) + CAST(t.emb[64] AS DOUBLE PRECISION) * CAST(c.emb[64] AS DOUBLE PRECISION)) DESC LIMIT 1" = sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "/* Find US B2 patent granted 2010-2014 with most forward citations within a month of filing date */ /* Then find the most similar patent from the same filing year using embedding dot product */ WITH focal_patents AS (/* US utility patents (B2) granted between 2010 and 2014 */ SELECT p.\"publication_number\", p.\"filing_date\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p WHERE p.\"country_code\" = 'US' AND p.\"kind_code\" = 'B2' AND p.\"grant_date\" >= 20100101 AND p.\"grant_date\" <= 20141231 AND p.\"filing_date\" > 0), forward_citations AS (/* Forward citations: other patents in PUBLICATIONS that cite the focal patent */ /* Filter to those filed within 30 days of the focal patent's filing date */ SELECT fp.\"publication_number\" AS focal_pub, fp.\"filing_date\" AS focal_fd, p2.\"publication_number\" AS citing_pub, p2.\"filing_date\" AS citing_fd FROM focal_patents AS fp, \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p2 CROSS JOIN LATERAL UNNEST(input => p2.\"citation\") AS c(SEQ, KEY, PATH, INDEX, VALUE, THIS) ON CAST(JSON_EXTRACT_PATH(c.value, 'publication_number') AS TEXT) = fp.\"publication_number\" WHERE p2.\"filing_date\" > 0 AND ABS((CAST(CAST(TO_TIMESTAMP(CAST(p2.\"filing_date\" AS TEXT), 'YYYYMMDD') AS DATE) AS DATE) - CAST(CAST(TO_TIMESTAMP(CAST(fp.\"filing_date\" AS TEXT), 'YYYYMMDD') AS DATE) AS DATE))) <= 30), citation_counts AS (SELECT focal_pub, focal_fd, COUNT(*) AS citation_count FROM forward_citations GROUP BY focal_pub, focal_fd), top_patent AS (SELECT focal_pub, focal_fd, citation_count FROM citation_counts ORDER BY citation_count DESC LIMIT 1), focal_embedding /* Find most similar patent from same filing year using embedding dot product */ AS (SELECT a.\"embedding_v1\" AS focal_emb FROM top_patent AS tp JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a ON tp.focal_pub = a.\"publication_number\"), candidates AS (/* All patents from the same filing year (regardless of type) */ SELECT p.\"publication_number\", a.\"embedding_v1\" FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" AS p JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" AS a ON p.\"publication_number\" = a.\"publication_number\" JOIN top_patent AS tp ON 1 = 1 WHERE FLOOR(CAST(p.\"filing_date\" AS DOUBLE PRECISION) / 10000) = FLOOR(CAST(tp.focal_fd AS DOUBLE PRECISION) / 10000) AND p.\"publication_number\" <> tp.focal_pub AND NOT a.\"embedding_v1\" IS NULL), similarity_scores AS (SELECT c.\"publication_number\" AS similar_pub, SUM(CAST(fe.value AS DOUBLE PRECISION) * CAST(ce.value AS DOUBLE PRECISION)) AS dot_product FROM candidates AS c, focal_embedding AS f, LATERAL UNNEST(input => f.focal_emb) AS fe(SEQ, KEY, PATH, INDEX, VALUE, THIS), LATERAL UNNEST(input => c.\"embedding_v1\") AS ce(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE fe.index = ce.index GROUP BY c.\"publication_number\") SELECT tp.focal_pub AS \"FOCAL_PUB\", tp.citation_count AS \"CITATION_COUNT\", ss.similar_pub AS \"SIMILAR_PATENT\" FROM top_patent AS tp, (SELECT similar_pub FROM similarity_scores ORDER BY dot_product DESC LIMIT 1) AS ss" := by
  first | sql_equiv | sorry

end Bench_sf_bq214
