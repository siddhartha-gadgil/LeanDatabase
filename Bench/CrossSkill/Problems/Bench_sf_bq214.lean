    (sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "-- Step 1: Identify US B2 utility patents granted 2010-2014\nWITH target_patents AS (\n  SELECT p.\"publication_number\", p.\"filing_date\", p.\"grant_date\"\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" p\n  WHERE p.\"country_code\" = 'US' \n    AND p.\"kind_code\" = 'B2'\n    AND FLOOR(p.\"grant_date\" / 10000) BETWEEN 2010 AND 2014\n),\n\n-- Step 2: Count forward citations within a month of filing date\n-- Forward citations = other patents in PUBLICATIONS whose citation array references the target patent\n-- \"Within a month\" = citing patent's filing_date within 30 days of target patent's filing_date\nforward_citation_counts AS (\n  SELECT t.\"publication_number\" AS focal_pub,\n    t.\"filing_date\" AS focal_filing_date,\n    t.\"grant_date\" AS focal_grant_date,\n    COUNT(*) AS citation_count\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" citing,\n    LATERAL FLATTEN(input => citing.\"citation\") f\n  JOIN target_patents t\n    ON f.value:publication_number::STRING = t.\"publication_number\"\n  WHERE citing.\"filing_date\" > 0\n    AND ABS(\n      DATEDIFF('day',\n        TRY_TO_DATE(CAST(t.\"filing_date\" AS VARCHAR), 'YYYYMMDD'),\n        TRY_TO_DATE(CAST(citing.\"filing_date\" AS VARCHAR), 'YYYYMMDD')\n      )\n    ) <= 30\n  GROUP BY t.\"publication_number\", t.\"filing_date\", t.\"grant_date\"\n),\n\n-- Step 3: Find the patent with the most forward citations (tiebreak by grant_date ASC)\ntop_patent AS (\n  SELECT focal_pub, focal_filing_date, citation_count\n  FROM forward_citation_counts\n  ORDER BY citation_count DESC, focal_grant_date ASC\n  LIMIT 1\n),\n\n-- Step 4: Get the top patent's embedding\ntarget_emb AS (\n  SELECT a.\"embedding_v1\"\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" a\n  JOIN top_patent tp ON a.\"publication_number\" = tp.focal_pub\n),\n\n-- Step 5: Find all candidate patents from the same filing year (regardless of type)\ncandidates AS (\n  SELECT a.\"publication_number\", a.\"embedding_v1\"\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"ABS_AND_EMB\" a\n  JOIN \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\" p\n    ON a.\"publication_number\" = p.\"publication_number\"\n  JOIN top_patent tp ON 1=1\n  WHERE FLOOR(p.\"filing_date\" / 10000) = FLOOR(tp.focal_filing_date / 10000)\n    AND a.\"publication_number\" != tp.focal_pub\n    AND ARRAY_SIZE(a.\"embedding_v1\") = 64\n),\n\n-- Step 6: Compute dot product similarity\ndot_products AS (\n  SELECT c.\"publication_number\",\n    SUM(te.value::FLOAT * ce.value::FLOAT) AS similarity\n  FROM candidates c,\n    target_emb t,\n    LATERAL FLATTEN(input => t.\"embedding_v1\") te,\n    LATERAL FLATTEN(input => c.\"embedding_v1\") ce\n  WHERE te.index = ce.index\n  GROUP BY c.\"publication_number\"\n),\n\n-- Step 7: Find the most similar patent\nmost_similar AS (\n  SELECT \"publication_number\" AS similar_patent, similarity\n  FROM dot_products\n  ORDER BY similarity DESC\n  LIMIT 1\n)\n\n-- Final result\nSELECT tp.focal_pub,\n  tp.citation_count,\n  ms.similar_patent\nFROM top_patent tp\nCROSS JOIN most_similar ms;") t ~= (sql%([PUBLICATIONS_schema, ABS_AND_EMB_schema]) "-- Step 1: Find US utility patents with B2 classification granted between 2010 and 2014\n-- Step 2: Count forward citations within a month of each patent's filing date\n-- Step 3: Find the patent with the most such forward citations\n-- Step 4: For that patent, find the most similar patent from the same filing year using dot product\n\nWITH target_patents AS (\n  SELECT \"publication_number\", \"filing_date\"\n  FROM \"PATENTS_GOOGLE\".\"PATENTS_GOOGLE\".\"PUBLICATIONS\"\n  WHERE \"country_code\" = 'US' \n    AND \"kind_code\" = 'B2' \n    AND \"application_kind\" = 'A'\n    AND \"grant_date\" BETWEEN 20100101 AND 20141231\n),\n-- Forward citations: patents in PUBLICATIONS that cite target patents (via backward citation array)\n-- Within a month: citing patent's filing_dat