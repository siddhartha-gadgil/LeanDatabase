fe,\n         LATERAL FLATTEN(input => c.\"embedding_v1\") ce\n    WHERE fe.index = ce.index\n    GROUP BY c.\"publication_number\"\n)\nSELECT tp.focal_pub AS \"FOCAL_PUB\",\n       tp.citation_count AS \"CITATION_COUNT\",\n       ss.similar_pub AS \"SIMILAR_PATENT\"\nFROM top_patent tp,\n     (SELECT similar_pub FROM similarity_scores ORDER BY dot_product DESC LIMIT 1) ss;") t := by
