theorem eq (t0 : TableRel CENSUSTRACT_2017_5YR_schema) (t1 : TableRel CENSUSTRACT_2015_5YR_schema) (t2 : TableRel CENSUSTRACT_2018_5YR_schema) (t3 : TableRel STATE_FIPS_schema) (t4 : TableRel STATES_schema) :
    (sql%([CENSUSTRACT_2017_5YR_schema, CENSUSTRACT_2015_5YR_schema, CENSUSTRACT_2018_5YR_schema, STATE_FIPS_schema, STATES_schema]) "WITH tract_labor AS (SELECT \"geo_id\", \"total_pop\", \"unemployed_pop\", \"not_in_labor_force\", \"group_quarters\", GREATEST(\"unemployed_pop\" + \"not_in_labor_force\" - \"group_quarters\", 0) AS adjusted_non_labor FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2017_5YR\"), tract_proportion AS (SELECT \"geo_id\", adjusted_non_labor, CASE WHEN \"total_pop\" > 0 THEN CAST(adjusted_non_labor * 1.0 AS DOUBLE PRECISION) / \"total_pop\" ELSE 0 END AS proportion FROM tract_labor), income_change AS (SELECT t18.\"geo_id\", (t18.\"median_income\" - t15.\"median_income\") AS income_diff FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2018_5YR\" AS t18 JOIN \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2015_5YR\" AS t15 ON t18.\"geo_id\" = t15.\"geo_id\" WHERE NOT t18.\"median_income\" IS NULL AND NOT t15.\"median_income\" IS NULL), combined AS (SELECT tp.\"geo_id\", tp.adjusted_non_labor, tp.proportion, ic.income_diff, LEFT(tp.\"geo_id\", 2) AS state_fips FROM tract_proportion AS tp JOIN income_change AS ic ON tp.\"geo_id\" = ic.\"geo_id\") SELECT s.\"state\" AS state, SUM(c.income_diff) AS TOTAL_INCOME_CHANGE, SUM(c.adjusted_non_labor) AS TOTAL_ADJUSTED_NON_LABOR, AVG(c.proportion) AS AVG_PROPORTION FROM combined AS c JOIN \"CENSUS_BUREAU_ACS_2\".\"GEO_US_BOUNDARIES\".\"STATES\" AS s ON c.state_fips = s.\"state_fips_code\" GROUP BY s.\"state\" ORDER BY TOTAL_ADJUSTED_NON_LABOR ASC LIMIT 3") t0 t1 t2 t3 t4
  ~= (sql%([CENSUSTRACT_2017_5YR_schema, CENSUSTRACT_2015_5YR_schema, CENSUSTRACT_2018_5YR_schema, STATE_FIPS_schema, STATES_schema]) "WITH tract_2017 AS (SELECT \"geo_id\", SUBSTRING(\"geo_id\" FROM 1 FOR 2) AS state_fips, \"total_pop\", \"unemployed_pop\", \"not_in_labor_force\", \"group_quarters\", GREATEST(COALESCE(\"unemployed_pop\", 0) + COALESCE(\"not_in_labor_force\", 0) - COALESCE(\"group_quarters\", 0), 0) AS adjusted_non_labor, CASE WHEN \"total_pop\" > 0 THEN CAST(GREATEST(COALESCE(\"unemployed_pop\", 0) + COALESCE(\"not_in_labor_force\", 0) - COALESCE(\"group_quarters\", 0), 0) AS DOUBLE PRECISION) / \"total_pop\" ELSE 0 END AS proportion FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2017_5YR\"), income_2015 AS (SELECT \"geo_id\", \"median_income\" FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2015_5YR\"), income_2018 AS (SELECT \"geo_id\", \"median_income\" FROM \"CENSUS_BUREAU_ACS_2\".\"CENSUS_BUREAU_ACS\".\"CENSUSTRACT_2018_5YR\"), combined AS (SELECT t.\"geo_id\", t.state_fips, t.adjusted_non_labor, t.proportion, i18.\"median_income\" - i15.\"median_income\" AS income_diff FROM tract_2017 AS t JOIN income_2015 AS i15 ON t.\"geo_id\" = i15.\"geo_id\" JOIN income_2018 AS i18 ON t.\"geo_id\" = i18.\"geo_id\" WHERE NOT (i18.\"median_income\" - i15.\"median_income\") IS NULL), state_agg AS (SELECT s.\"state\" AS state, SUM(c.income_diff) AS TOTAL_INCOME_CHANGE, SUM(c.adjusted_non_labor) AS TOTAL_ADJUSTED_NON_LABOR, AVG(c.proportion) AS AVG_PROPORTION FROM combined AS c JOIN \"CENSUS_BUREAU_ACS_2\".\"GEO_US_BOUNDARIES\".\"STATES\" AS s ON c.state_fips = s.\"state_fips_code\" GROUP BY s.\"state\") SELECT state, TOTAL_INCOME_CHANGE, TOTAL_ADJUSTED_NON_LABOR, AVG_PROPORTION FROM state_agg ORDER BY TOTAL_ADJUSTED_NON_LABOR ASC LIMIT 3") t0 t1 t2 t3 t4
