    sql%([GENRE_schema, MOVIES_schema, DIRECTOR_MAPPING_schema, NAMES_schema, RATINGS_schema]) "-- Step 1: Find the top 3 genres with the most movies rated above 8\n-- Step 2: Among movies in those genres rated above 8, find top 4 directors by movie count\n\nWITH top_genres AS (\n    SELECT g.\"genre\"\n    FROM \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"GENRE\" g\n    JOIN \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"RATINGS\" r\n        ON g.\"movie_id\" = r.\"movie_id\"\n    WHERE r.\"avg_rating\" > 8\n    GROUP BY g.\"genre\"\n    ORDER BY COUNT(DISTINCT g.\"movie_id\") DESC\n    LIMIT 3\n)\nSELECT\n    n.\"name\" AS \"DIRECTOR\",\n    COUNT(DISTINCT g.\"movie_id\") AS \"MOVIE_COUNT\"\nFROM \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"GENRE\" g\nJOIN \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"RATINGS\" r\n    ON g.\"movie_id\" = r.\"movie_id\"\nJOIN \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"DIRECTOR_MAPPING\" dm\n    ON g.\"movie_id\" = dm.\"movie_id\"\nJOIN \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"NAMES\" n\n    ON dm.\"name_id\" = n.\"id\"\nWHERE r.\"avg_rating\" > 8\n  AND g.\"genre\" IN (SELECT \"genre\" FROM top_genres)\nGROUP BY n.\"name\"\nORDER BY \"MOVIE_COUNT\" DESC, n.\"name\" ASC\nLIMIT 4;" = sql%([GENRE_schema, MOVIES_schema, DIRECTOR_MAPPING_schema, NAMES_schema, RATINGS_schema]) "WITH top_genres AS (\n    SELECT g.\"genre\"\n    FROM \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"GENRE\" g\n    JOIN \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"RATINGS\" r\n        ON g.\"movie_id\" = r.\"movie_id\"\n    WHERE r.\"avg_rating\" > 8\n    GROUP BY g.\"genre\"\n    ORDER BY COUNT(*) DESC\n    LIMIT 3\n),\nmovies_in_top_genres AS (\n    SELECT DISTINCT g.\"movie_id\"\n    FROM \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"GENRE\" g\n    JOIN \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"RATINGS\" r\n        ON g.\"movie_id\" = r.\"movie_id\"\n    WHERE r.\"avg_rating\" > 8\n      AND g.\"genre\" IN (SELECT \"genre\" FROM top_genres)\n)\nSELECT n.\"name\" AS DIRECTOR,\n       COUNT(DISTINCT dm.\"movie_id\") AS MOVIE_COUNT\nFROM \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"DIRECTOR_MAPPING\" dm\nJOIN movies_in_top_genres m\n    ON dm.\"movie_id\" = m.\"movie_id\"\nJOIN \"IMDB_MOVIES\".\"IMDB_MOVIES\".\"NAMES\" n\n    ON dm.\"name_id\" = n.\"id\"\nGROUP BY n.\"name\"\nORDER BY MOVIE_COUNT DESC, n.\"name\" ASC\nLIMIT 4;" := by
