_name\" AS county,\n    (a18.avg_emp_2018 - a00.avg_emp_2000) / a00.avg_emp_2000 * 100 AS increase_rate\nFROM avg_2000 a00\nJOIN avg_2018 a18 ON a00.\"area_fips\" = a18.\"area_fips\"\nJOIN \"BLS\".\"GEO_US_BOUNDARIES\".\"COUNTIES\" c ON a00.\"area_fips\" = c.\"geo_id\"\nWHERE a00.avg_emp_2000 IS NOT NULL AND a00.avg_emp_2000 > 0\n  AND a18.avg_emp_2018 IS NOT NULL\nORDER BY increase_rate DESC\nLIMIT 1") t ~= (sql%([_2018_Q1_schema, _2000_Q2_schema, _2000_Q4_schema, _2018_Q3_schema, _2000_Q1_schema, _2018_Q4_schema, _2018_Q2_schema, _2000_Q3_schema, COUNTIES_schema]) "WITH year_2000 AS (\n    SELECT\n        q1.\"area_fips\",\n        (COALESCE(q1.\"month3_emplvl_23_construction\", 0)\n         + COALESCE(q2.\"month3_emplvl_23_construction\", 0)\n         + COALESCE(q3.\"month3_emplvl_23_construction\", 0)\n         + COALESCE(q4.\"month3_emplvl_23_construction\", 0)) / 4.0 AS avg_employment_2000\n    FROM \"BLS\".\"BLS_QCEW\".\"_2000_Q1\" q1\n    JOIN \"BLS\".\"BLS_QCEW\".\"_2000_Q2\" q2 ON q1.\"area_fips\" = q2.\"area_fips\"\n    JOIN \"BLS\".\"BLS_QCEW\".\"_2000_Q3\" q3 ON q1.\"area_fips\" = q3.\"area_fips\"\n    JOIN \"BLS\".\"BLS_QCEW\".\"_2000_Q4\" q4 ON q1.\"area_fips\" = q4.\"area_fips\"\n    WHERE q1.\"area_fips\" LIKE '49%'\n),\nyear_2018 AS (\n    SELECT\n        q1.\"area_fips\",\n        (COALESCE(q1.\"month3_emplvl_23_construction\", 0)\n         + COALESCE(q2.\"month3_emplvl_23_construction\", 0)\n         + COALESCE(q3.\"month3_emplvl_23_construction\", 0)\n         + COALESCE(q4.\"month3_emplvl_23_construction\", 0)) / 4.0 AS avg_employment_2018\n    FROM \"BLS\".\"BLS_QCEW\".\"_2018_Q1\" q1\n    JOIN \"BLS\".\"BLS_QCEW\".\"_2018_Q2\" q2 ON q1.\"area_fips\" = q2.\"area_fips\"\n    JOIN \"BLS\".\"BLS_QCEW\".\"_2018_Q3\" q3 ON q1.\"area_fips\" = q3.\"area_fips\"\n    JOIN \"BLS\".\"BLS_QCEW\".\"_2018_Q4\" q4 ON q1.\"area_fips\" = q4.\"area_fips\"\n    WHERE q1.\"area_fips\" LIKE '49%'\n)\nSELECT\n    c.\"county_name\" AS county,\n    ((y18.avg_employment_2018 - y00.avg_employment_2000) / y00.avg_employment_2000) * 100 AS increase_rate\nFROM year_2000 y00\nJOIN year_2018 y18 ON y00.\"area_fips\" = y18.\"area_fips\"\nJOIN \"BLS\".\"GEO_US_BOUNDARIES\".\"COUNTIES\" c ON y00.\"area_fips\" = c.\"geo_id\"\nWHERE c.\"state_fips_code\" = '49'\n  AND y00.avg_employment_2000 > 0\nORDER BY increase_rate DESC\nLIMIT 1;") t := by
