S \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\" FROM all_toppings AS at2 JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS pt ON at2.topping_id = pt.\"topping_id\" GROUP BY pt.\"topping_name\" ORDER BY pt.\"topping_name\"") t ~= (sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "/* For delivered pizzas, summarize total quantity of each ingredient used */ /* Using exclusions/extras columns from PIZZA_CLEAN_CUSTOMER_ORDERS directly */ WITH delivered_orders AS (SELECT \"order_id\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\" WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''), delivered_pizzas /* Customer orders for delivered pizzas with a unique row number */ AS (SELECT c.\"order_id\", c.\"pizza_id\", c.\"exclusions\", c.\"extras\", ROW_NUMBER() OVER (ORDER BY c.\"order_id\", c.\"pizza_id\") AS pizza_row FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" AS c INNER JOIN delivered_orders AS d ON c.\"order_id\" = d.\"order_id\"), base_toppings /* Expand base recipe toppings for each delivered pizza */ AS (SELECT dp.pizza_row, dp.\"order_id\", dp.\"exclusions\", CAST(TRIM(rt.VALUE) AS INT) AS topping_id FROM delivered_pizzas AS dp JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" AS r ON dp.\"pizza_id\" = r.\"pizza_id\", LATERAL SPLIT_TO_TABLE(r.\"toppings\", ',') AS rt), pizza_exclusions /* Expand exclusions per pizza (split comma-separated exclusions) */ AS (SELECT dp.pizza_row, CAST(TRIM(ex.VALUE) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL SPLIT_TO_TABLE(dp.\"exclusions\", ',') AS ex WHERE NOT dp.\"exclusions\" IS NULL AND dp.\"exclusions\" <> ''), pizza_extras /* Expand extras per pizza (split comma-separated extras) */ AS (SELECT dp.pizza_row, CAST(TRIM(ext.VALUE) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL SPLIT_TO_TABLE(dp.\"extras\", ',') AS ext WHERE NOT dp.\"extras\" IS NULL AND dp.\"extras\" <> ''