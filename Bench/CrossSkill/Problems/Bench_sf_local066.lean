theorem eq_1_3 :
    sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "-- For delivered pizzas, summarize total quantity of each ingredient used\n-- Using exclusions/extras columns from PIZZA_CLEAN_CUSTOMER_ORDERS directly\n\nWITH delivered_orders AS (\n    SELECT \"order_id\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\"\n    WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''\n),\n\n-- Customer orders for delivered pizzas with a unique row number\ndelivered_pizzas AS (\n    SELECT\n        c.\"order_id\",\n        c.\"pizza_id\",\n        c.\"exclusions\",\n        c.\"extras\",\n        ROW_NUMBER() OVER (ORDER BY c.\"order_id\", c.\"pizza_id\") AS pizza_row\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" c\n    INNER JOIN delivered_orders d ON c.\"order_id\" = d.\"order_id\"\n),\n\n-- Expand base recipe toppings for each delivered pizza\nbase_toppings AS (\n    SELECT\n        dp.pizza_row,\n        dp.\"order_id\",\n        dp.\"exclusions\",\n        TRIM(rt.VALUE)::INT AS topping_id\n    FROM delivered_pizzas dp\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r ON dp.\"pizza_id\" = r.\"pizza_id\"\n    , LATERAL SPLIT_TO_TABLE(r.\"toppings\", ',') rt\n),\n\n-- Expand exclusions per pizza (split comma-separated exclusions)\npizza_exclusions AS (\n    SELECT\n        dp.pizza_row,\n        TRIM(ex.VALUE)::INT AS topping_id\n    FROM delivered_pizzas dp\n    , LATERAL SPLIT_TO_TABLE(dp.\"exclusions\", ',') ex\n    WHERE dp.\"exclusions\" IS NOT NULL AND dp.\"exclusions\" != ''\n),\n\n-- Expand extras per pizza (split comma-separated extras)\npizza_extras AS (\n    SELECT\n        dp.pizza_row,\n        TRIM(ext.VALUE)::INT AS topping_id\n    FROM delivered_pizzas dp\n    , LATERAL SPLIT_TO_TABLE(dp.\"extras\", ',') ext\n    WHERE dp.\"extras\" IS NOT NULL AND dp.\"extras\" != ''\n),\n\n-- All toppings = base (minus exclusions) + extras\nall_toppings AS (\n    -- Base toppings minus exclusions\n    SELECT b.topping_id\n    FROM base_toppings b\n    WHERE NOT EXISTS (\n        SELECT 1\n        FROM pizza_exclusions pe\n        WHERE pe.pizza_row = b.pizza_row\n          AND pe.topping_id = b.topping_id\n    )\n    \n    UNION ALL\n    \n    -- Extra toppings\n    SELECT pe.topping_id\n    FROM pizza_extras pe\n)\n\n-- Final aggregation\nSELECT\n    t.\"topping_name\" AS \"TOPPING_NAME\",\n    COUNT(*) AS \"TOTAL_QUANTITY\"\nFROM all_toppings a\nJOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t ON a.topping_id = t.\"topping_id\"\nGROUP BY t.\"topping_name\"\nORDER BY t.\"topping_name\";" = sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "-- For each ingredient, count total times used on delivered pizzas\n-- considering base recipe toppings, extras added, and exclusions removed\n\nWITH delivered_orders AS (\n    SELECT \"order_id\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\"\n    WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''\n),\n\n-- Number the customer order rows within each order to get a unique identifier\ndelivered_pizzas AS (\n    SELECT \n        co.\"order_id\",\n        co.\"pizza_id\",\n        co.\"exclusions\",\n        co.\"extras\",\n        ROW_NUMBER() OVER (PARTITION BY co.\"order_id\" ORDER BY co.\"order_time\", co.\"pizza_id\") AS rn\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" co\n    INNER JOIN delivered_orders d ON co.\"order_id\" = d.\"order_id\"\n),\n\n-- Split comma-separated recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT \n        r.\"pizza_id\",\n        TRIM(f.value::STRING)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r,\n    LATERAL FLATTEN(input => SPLIT(r.\"toppings\", ',')) f\n),\n\n-- Base toppings for each delivered pizza\nbase_toppings AS (\n    SELECT \n        dp.\"order_id\",\n        dp.rn,\n        rt.topping_id\n    FROM delivered_pizzas dp\n    INNER JOIN recipe_toppings rt ON dp.\"pizza_id\" = rt.\"pizza_id\"\n),\n\n-- Parse exclusions per pizza from the customer orders\npizza_exclusions AS (\n    SELECT\n        dp.\"order_id\",\n        dp.rn,\n        TRIM(f.value::STRING)::INT AS topping_id\n    FROM delivered_pizzas dp,\n    LATERAL FLATTEN(input => SPLIT(dp.\"exclusions\", ','), OUTER => TRUE) f\n    WHERE dp.\"exclusions\" IS NOT NULL AND dp.\"exclusions\" != ''\n),\n\n-- Parse extras per pizza from the customer orders\npizza_extras AS (\n    SELECT\n        dp.\"order_id\",\n        dp.rn,\n        TRIM(f.value::STRING)::INT AS topping_id\n    FROM delivered_pizzas dp,\n    LATERAL FLATTEN(input => SPLIT(dp.\"extras\", ','), OUTER => TRUE) f\n    WHERE dp.\"extras\" IS NOT NULL AND dp.\"extras\" != ''\n),\n\n-- Remove exclusions from base toppings\nbase_minus_exclusions AS (\n    SELECT bt.\"order_id\", bt.rn, bt.topping_id\n    FROM base_toppings bt\n    LEFT JOIN pizza_exclusions exc \n        ON bt.\"order_id\" = exc.\"order_id\" \n        AND bt.rn = exc.rn \n        AND bt.topping_id = exc.topping_id\n    WHERE exc.topping_id IS NULL\n),\n\n-- Combine base (minus exclusions) with extras\nall_toppings AS (\n    SELECT topping_id FROM base_minus_exclusions\n    UNION ALL\n    SELECT topping_id FROM pizza_extras\n)\n\n-- Final aggregation: count per topping\nSELECT \n    t.\"topping_name\" AS \"TOPPING_NAME\",\n    COUNT(*) AS \"TOTAL_QUANTITY\"\nFROM all_toppings a\nINNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t \n    ON a.topping_id = t.\"topping_id\"\nGROUP BY t.\"topping_name\"\nORDER BY t.\"topping_name\";" := by
