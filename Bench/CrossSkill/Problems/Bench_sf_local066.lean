row AND pe.topping_id = b.topping_id) UNION ALL /* Extra toppings */ SELECT pe.topping_id FROM pizza_extras AS pe) /* Final aggregation */ SELECT t.\"topping_name\" AS \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\" FROM all_toppings AS a JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON a.topping_id = t.\"topping_id\" GROUP BY t.\"topping_name\" ORDER BY t.\"topping_name\"" = sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "/* For each ingredient, count total times used on delivered pizzas */ /* considering base recipe toppings, extras added, and exclusions removed */ WITH delivered_orders AS (SELECT \"order_id\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\" WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''), delivered_pizzas /* Number the customer order rows within each order to get a unique identifier */ AS (SELECT co.\"order_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\", ROW_NUMBER() OVER (PARTITION BY co.\"order_id\" ORDER BY co.\"order_time\", co.\"pizza_id\") AS rn FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" AS co INNER JOIN delivered_orders AS d ON co.\"order_id\" = d.\"order_id\"), recipe_toppings /* Split comma-separated recipe toppings into individual rows */ AS (SELECT r.\"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS INT) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" AS r, LATERAL UNNEST(input => SPLIT(r.\"toppings\", ',')) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS)), base_toppings /* Base toppings for each delivered pizza */ AS (SELECT dp.\"order_id\", dp.rn, rt.topping_id FROM delivered_pizzas AS dp INNER JOIN recipe_toppings AS rt ON dp.\"pizza_id\" = rt.\"pizza_id\"), pizza_exclusions /* Parse exclusions per pizza from the customer orders */ AS (SELECT dp.\"order_id\", dp.rn, CAST(TRIM(CAST(f.value AS TEXT)) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL UNNEST(input => SPLIT(dp.\"exclusions\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT dp.\"exclusions\" IS NULL AND dp.\"exclusions\" <> ''), pizza_extras /* Parse extras per pizza from the customer orders */ AS (SELECT dp.\"order_id\", dp.rn, CAST(TRIM(CAST(f.value AS TEXT)) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL UNNEST(input => SPLIT(dp.\"extras\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT dp.\"extras\" IS NULL AND dp.\"extras\" <> ''), base_minus_exclusions /* Remove exclusions from base toppings */ AS (SELECT bt.\"order_id\", bt.rn, bt.topping_id FROM base_toppings AS bt LEFT JOIN pizza_exclusions AS exc ON bt.\"order_id\" = exc.\"order_id\" AND bt.rn = exc.rn AND bt.topping_id = exc.topping_id WHERE exc.topping_id IS NULL), all_toppings /* Combine base (minus exclusions) with extras */ AS (SELECT topping_id FROM base_minus_exclusions UNION ALL SELECT topping_id FROM pizza_extras) /* Final aggregation: count per topping */ SELECT t.\"topping_name\" AS \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\" FROM all_toppings AS a INNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON a.topping_id = t.\"topping_id\" GROUP BY t.\"topping_name\" ORDER BY t.\"topping_name\"" := by
  first | sql_equiv | sorry

theorem eq_2_3 :
    sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "/* Total quantity of each ingredient used in delivered pizzas */ /* Base recipe toppings + extras - exclusions for non-cancelled orders */ WITH delivered_orders AS (/* Get only delivered orders (not cancelled) */ SELECT \"order_id\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\" WHERE \"cancellation\" IS NULL OR TRIM(\"cancellation\") = ''), customer_pizzas AS (/* Get customer orders that were delivered */ SELECT co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" AS co INNER JOIN delivered_orders AS d ON co.\"order_id\" = d.\"order_id\"), recipe_toppings /* Split recipe toppings for each pizza type */ AS (SELECT \"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS DECIMAL(38, 0)) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\", LATERAL UNNEST(input => SPLIT(\"toppings\", ',')) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS)), base_toppings /* Base toppings: one row per topping per delivered pizza */ AS (SELECT cp.\"order_id\", cp.\"pizza_id\", rt.topping_id, 1 AS qty FROM customer_pizzas AS cp INNER JOIN recipe_toppings AS rt ON cp.\"pizza_id\" = rt.\"pizza_id\"), exclusion_toppings /* Exclusions: parse from clean customer orders for delivered orders */ AS (SELECT cp.\"order_id\", cp.\"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS DECIMAL(38, 0)) AS topping_id, -1 AS qty FROM customer_pizzas AS cp, LATERAL UNNEST(input => SPLIT(cp.\"exclusions\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT cp.\"exclusions\" IS NULL AND TRIM(cp.\"exclusions\") <> ''), extra_toppings /* Extras: parse from clean customer orders for delivered orders */ AS (SELECT cp.\"order_id\", cp.\"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS DECIMAL(38, 0)) AS topping_id, 1 AS qty FROM customer_pizzas AS cp, LATERAL UNNEST(input => SPLIT(cp.\"extras\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT cp.\"extras\" IS NULL AND TRIM(cp.\"extras\") <> ''), all_toppings /* Combine all */ AS (SELECT topping_id, qty FROM base_toppings UNION ALL SELECT topping_id, qty FROM exclusion_toppings UNION ALL SELECT topping_id, qty FROM extra_toppings) SELECT t.\"topping_name\" AS \"TOPPING_NAME\", SUM(a.qty) AS \"TOTAL_QUANTITY\" FROM all_toppings AS a INNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON a.topping_id = t.\"topping_id\" GROUP BY t.\"topping_name\" ORDER BY \"TOPPING_NAME\"" = sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "/* For each ingredient, count total times used on delivered pizzas */ /* considering base recipe toppings, extras added, and exclusions removed */ WITH delivered_orders AS (SELECT \"order_id\" FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\" WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''), delivered_pizzas /* Number the customer order rows within each order to get a unique identifier */ AS (SELECT co.\"order_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\", ROW_NUMBER() OVER (PARTITION BY co.\"order_id\" ORDER BY co.\"order_time\", co.\"pizza_id\") AS rn FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" AS co INNER JOIN delivered_orders AS d ON co.\"order_id\" = d.\"order_id\"), recipe_toppings /* Split comma-separated recipe toppings into individual rows */ AS (SELECT r.\"pizza_id\", CAST(TRIM(CAST(f.value AS TEXT)) AS INT) AS topping_id FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" AS r, LATERAL UNNEST(input => SPLIT(r.\"toppings\", ',')) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS)), base_toppings /* Base toppings for each delivered pizza */ AS (SELECT dp.\"order_id\", dp.rn, rt.topping_id FROM delivered_pizzas AS dp INNER JOIN recipe_toppings AS rt ON dp.\"pizza_id\" = rt.\"pizza_id\"), pizza_exclusions /* Parse exclusions per pizza from the customer orders */ AS (SELECT dp.\"order_id\", dp.rn, CAST(TRIM(CAST(f.value AS TEXT)) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL UNNEST(input => SPLIT(dp.\"exclusions\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT dp.\"exclusions\" IS NULL AND dp.\"exclusions\" <> ''), pizza_extras /* Parse extras per pizza from the customer orders */ AS (SELECT dp.\"order_id\", dp.rn, CAST(TRIM(CAST(f.value AS TEXT)) AS INT) AS topping_id FROM delivered_pizzas AS dp, LATERAL UNNEST(input => SPLIT(dp.\"extras\", ','), OUTER => TRUE) AS f(SEQ, KEY, PATH, INDEX, VALUE, THIS) WHERE NOT dp.\"extras\" IS NULL AND dp.\"extras\" <> ''), base_minus_exclusions /* Remove exclusions from base toppings */ AS (SELECT bt.\"order_id\", bt.rn, bt.topping_id FROM base_toppings AS bt LEFT JOIN pizza_exclusions AS exc ON bt.\"order_id\" = exc.\"order_id\" AND bt.rn = exc.rn AND bt.topping_id = exc.topping_id WHERE exc.topping_id IS NULL), all_toppings /* Combine base (minus exclusions) with extras */ AS (SELECT topping_id FROM base_minus_exclusions UNION ALL SELECT topping_id FROM pizza_extras) /* Final aggregation: count per topping */ SELECT t.\"topping_name\" AS \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\" FROM all_toppings AS a INNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" AS t ON a.topping_id = t.\"topping_id\" GROUP BY t.\"topping_name\" ORDER BY t.\"topping_name\"" := by
