theorem eq_2_3 :
    sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "-- Total quantity of each ingredient used in delivered pizzas\n-- Base recipe toppings + extras - exclusions for non-cancelled orders\n\nWITH delivered_orders AS (\n    -- Get only delivered orders (not cancelled)\n    SELECT \"order_id\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\"\n    WHERE \"cancellation\" IS NULL OR TRIM(\"cancellation\") = ''\n),\ncustomer_pizzas AS (\n    -- Get customer orders that were delivered\n    SELECT co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" co\n    INNER JOIN delivered_orders d ON co.\"order_id\" = d.\"order_id\"\n),\n-- Split recipe toppings for each pizza type\nrecipe_toppings AS (\n    SELECT \"pizza_id\", TRIM(f.value::STRING)::NUMBER AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\",\n    LATERAL FLATTEN(input => SPLIT(\"toppings\", ',')) f\n),\n-- Base toppings: one row per topping per delivered pizza\nbase_toppings AS (\n    SELECT cp.\"order_id\", cp.\"pizza_id\", rt.topping_id, 1 AS qty\n    FROM customer_pizzas cp\n    INNER JOIN recipe_toppings rt ON cp.\"pizza_id\" = rt.\"pizza_id\"\n),\n-- Exclusions: parse from clean customer orders for delivered orders\nexclusion_toppings AS (\n    SELECT cp.\"order_id\", cp.\"pizza_id\", TRIM(f.value::STRING)::NUMBER AS topping_id, -1 AS qty\n    FROM customer_pizzas cp,\n    LATERAL FLATTEN(input => SPLIT(cp.\"exclusions\", ','), OUTER => TRUE) f\n    WHERE cp.\"exclusions\" IS NOT NULL AND TRIM(cp.\"exclusions\") != ''\n),\n-- Extras: parse from clean customer orders for delivered orders\nextra_toppings AS (\n    SELECT cp.\"order_id\", cp.\"pizza_id\", TRIM(f.value::STRING)::NUMBER AS topping_id, 1 AS qty\n    FROM customer_pizzas cp,\n    LATERAL FLATTEN(input => SPLIT(cp.\"extras\", ','), OUTER => TRUE) f\n    WHERE cp.\"extras\" IS NOT NULL AND TRIM(cp.\"extras\") != ''\n),\n-- Combine all\nall_toppings AS (\n    SELECT topping_id, qty FROM base_toppings\n    UNION ALL\n    SELECT topping_id, qty FROM exclusion_toppings\n    UNION ALL\n    SELECT topping_id, qty FROM extra_toppings\n)\nSELECT \n    t.\"topping_name\" AS \"TOPPING_NAME\",\n    SUM(a.qty) AS \"TOTAL_QUANTITY\"\nFROM all_toppings a\nINNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t ON a.topping_id = t.\"topping_id\"\nGROUP BY t.\"topping_name\"\nORDER BY \"TOPPING_NAME\";" = sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "-- For each ingredient, count total times used on delivered pizzas\n-- considering base recipe toppings, extras added, and exclusions removed\n\nWITH delivered_orders AS (\n    SELECT \"order_id\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\"\n    WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''\n),\n\n-- Number the customer order rows within each order to get a unique identifier\ndelivered_pizzas AS (\n    SELECT \n        co.\"order_id\",\n        co.\"pizza_id\",\n        co.\"exclusions\",\n        co.\"extras\",\n        ROW_NUMBER() OVER (PARTITION BY co.\"order_id\" ORDER BY co.\"order_time\", co.\"pizza_id\") AS rn\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" co\n    INNER JOIN delivered_orders d ON co.\"order_id\" = d.\"order_id\"\n),\n\n-- Split comma-separated recipe toppings into individual rows\nrecipe_toppings AS (\n    SELECT \n        r.\"pizza_id\",\n        TRIM(f.value::STRING)::INT AS topping_id\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r,\n    LATERAL FLATTEN(input => SPLIT(r.\"toppings\", ',')) f\n),\n\n-- Base toppings for each delivered pizza\nbase_toppings AS (\n    SELECT \n        dp.\"order_id\",\n        dp.rn,\n        rt.topping_id\n    FROM delivered_pizzas dp\n    INNER JOIN recipe_toppings rt ON dp.\"pizza_id\" = rt.\"pizza_id\"\n),\n\n-- Parse exclusions per pizza from the customer orders\npizza_exclusions AS (\n    SELECT\n        dp.\"order_id\",\n        dp.rn,\n        TRIM(f.value::STRING)::INT AS topping_id\n    FROM delivered_pizzas dp,\n    LATERAL FLATTEN(input => SPLIT(dp.\"exclusions\", ','), OUTER => TRUE) f\n    WHERE dp.\"exclusions\" IS NOT NULL AND dp.\"exclusions\" != ''\n),\n\n-- Parse extras per pizza from the customer orders\npizza_extras AS (\n    SELECT\n        dp.\"order_id\",\n        dp.rn,\n        TRIM(f.value::STRING)::INT AS topping_id\n    FROM delivered_pizzas dp,\n    LATERAL FLATTEN(input => SPLIT(dp.\"extras\", ','), OUTER => TRUE) f\n    WHERE dp.\"extras\" IS NOT NULL AND dp.\"extras\" != ''\n),\n\n-- Remove exclusions from base toppings\nbase_minus_exclusions AS (\n    SELECT bt.\"order_id\", bt.rn, bt.topping_id\n    FROM base_toppings bt\n    LEFT JOIN pizza_exclusions exc \n        ON bt.\"order_id\" = exc.\"order_id\" \n        AND bt.rn = exc.rn \n        AND bt.topping_id = exc.topping_id\n    WHERE exc.topping_id IS NULL\n),\n\n-- Combine base (minus exclusions) with extras\nall_toppings AS (\n    SELECT topping_id FROM base_minus_exclusions\n    UNION ALL\n    SELECT topping_id FROM pizza_extras\n)\n\n-- Final aggregation: count per topping\nSELECT \n    t.\"topping_name\" AS \"TOPPING_NAME\",\n    COUNT(*) AS \"TOTAL_QUANTITY\"\nFROM all_toppings a\nINNER JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t \n    ON a.topping_id = t.\"topping_id\"\nGROUP BY t.\"topping_name\"\nORDER BY t.\"topping_name\";" := by
