theorem eq_0_1 : ∀ t,
    (sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "WITH delivered_orders AS (\n    -- Get only delivered (non-cancelled) orders\n    SELECT co.\"order_id\", co.\"customer_id\", co.\"pizza_id\", co.\"exclusions\", co.\"extras\", co.\"order_time\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" co\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\" ro\n      ON co.\"order_id\" = ro.\"order_id\"\n    WHERE ro.\"cancellation\" IS NULL OR ro.\"cancellation\" = ''\n),\n-- Assign a unique row_id for each pizza item in an order\ndelivered_with_id AS (\n    SELECT *, ROW_NUMBER() OVER (ORDER BY \"order_id\", \"pizza_id\") AS rn\n    FROM delivered_orders\n),\n-- Get base recipe toppings for each delivered pizza (flatten comma-separated toppings)\nbase_toppings AS (\n    SELECT d.rn, TRIM(t.VALUE)::INTEGER AS topping_id\n    FROM delivered_with_id d\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r\n      ON d.\"pizza_id\" = r.\"pizza_id\"\n    , LATERAL SPLIT_TO_TABLE(r.\"toppings\", ',') t\n),\n-- Get exclusions for each delivered pizza\nexclusion_toppings AS (\n    SELECT d.rn, TRIM(e.VALUE)::INTEGER AS topping_id\n    FROM delivered_with_id d\n    , LATERAL SPLIT_TO_TABLE(d.\"exclusions\", ',') e\n    WHERE d.\"exclusions\" IS NOT NULL AND d.\"exclusions\" != ''\n),\n-- Get extras for each delivered pizza\nextra_toppings AS (\n    SELECT d.rn, TRIM(x.VALUE)::INTEGER AS topping_id\n    FROM delivered_with_id d\n    , LATERAL SPLIT_TO_TABLE(d.\"extras\", ',') x\n    WHERE d.\"extras\" IS NOT NULL AND d.\"extras\" != ''\n),\n-- Base toppings minus exclusions\nafter_exclusions AS (\n    SELECT b.rn, b.topping_id\n    FROM base_toppings b\n    LEFT JOIN exclusion_toppings ex\n      ON b.rn = ex.rn AND b.topping_id = ex.topping_id\n    WHERE ex.topping_id IS NULL\n),\n-- Combine: after_exclusions + extras\nall_toppings AS (\n    SELECT rn, topping_id FROM after_exclusions\n    UNION ALL\n    SELECT rn, topping_id FROM extra_toppings\n)\nSELECT pt.\"topping_name\" AS \"TOPPING_NAME\", COUNT(*) AS \"TOTAL_QUANTITY\"\nFROM all_toppings at2\nJOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" pt\n  ON at2.topping_id = pt.\"topping_id\"\nGROUP BY pt.\"topping_name\"\nORDER BY pt.\"topping_name\";") t ~= (sql%([PIZZA_CLEAN_RUNNER_ORDERS_schema, PIZZA_RECIPES_schema, PIZZA_CLEAN_CUSTOMER_ORDERS_schema, PIZZA_TOPPINGS_schema]) "-- For delivered pizzas, summarize total quantity of each ingredient used\n-- Using exclusions/extras columns from PIZZA_CLEAN_CUSTOMER_ORDERS directly\n\nWITH delivered_orders AS (\n    SELECT \"order_id\"\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_RUNNER_ORDERS\"\n    WHERE \"cancellation\" IS NULL OR \"cancellation\" = ''\n),\n\n-- Customer orders for delivered pizzas with a unique row number\ndelivered_pizzas AS (\n    SELECT\n        c.\"order_id\",\n        c.\"pizza_id\",\n        c.\"exclusions\",\n        c.\"extras\",\n        ROW_NUMBER() OVER (ORDER BY c.\"order_id\", c.\"pizza_id\") AS pizza_row\n    FROM \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_CLEAN_CUSTOMER_ORDERS\" c\n    INNER JOIN delivered_orders d ON c.\"order_id\" = d.\"order_id\"\n),\n\n-- Expand base recipe toppings for each delivered pizza\nbase_toppings AS (\n    SELECT\n        dp.pizza_row,\n        dp.\"order_id\",\n        dp.\"exclusions\",\n        TRIM(rt.VALUE)::INT AS topping_id\n    FROM delivered_pizzas dp\n    JOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_RECIPES\" r ON dp.\"pizza_id\" = r.\"pizza_id\"\n    , LATERAL SPLIT_TO_TABLE(r.\"toppings\", ',') rt\n),\n\n-- Expand exclusions per pizza (split comma-separated exclusions)\npizza_exclusions AS (\n    SELECT\n        dp.pizza_row,\n        TRIM(ex.VALUE)::INT AS topping_id\n    FROM delivered_pizzas dp\n    , LATERAL SPLIT_TO_TABLE(dp.\"exclusions\", ',') ex\n    WHERE dp.\"exclusions\" IS NOT NULL AND dp.\"exclusions\" != ''\n),\n\n-- Expand extras per pizza (split comma-separated extras)\npizza_extras AS (\n    SELECT\n        dp.pizza_row,\n        TRIM(ext.VALUE)::INT AS topping_id\n    FROM delivered_pizzas dp\n    , LATERAL SPLIT_TO_TABLE(dp.\"extras\", ',') ext\n    WHERE dp.\"extras\" IS NOT NULL AND dp.\"extras\" != ''\n),\n\n-- All toppings = base (minus exclusions) + extras\nall_toppings AS (\n    -- Base toppings minus exclusions\n    SELECT b.topping_id\n    FROM base_toppings b\n    WHERE NOT EXISTS (\n        SELECT 1\n        FROM pizza_exclusions pe\n        WHERE pe.pizza_row = b.pizza_row\n          AND pe.topping_id = b.topping_id\n    )\n    \n    UNION ALL\n    \n    -- Extra toppings\n    SELECT pe.topping_id\n    FROM pizza_extras pe\n)\n\n-- Final aggregation\nSELECT\n    t.\"topping_name\" AS \"TOPPING_NAME\",\n    COUNT(*) AS \"TOTAL_QUANTITY\"\nFROM all_toppings a\nJOIN \"MODERN_DATA\".\"MODERN_DATA\".\"PIZZA_TOPPINGS\" t ON a.topping_id = t.\"topping_id\"\nGROUP BY t.\"topping_name\"\nORDER BY t.\"topping_name\";") t := by
