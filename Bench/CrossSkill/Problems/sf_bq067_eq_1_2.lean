theorem eq (t0 : TableRel ACCIDENT_2016_schema) (t1 : TableRel PERSON_2016_schema) (t2 : TableRel VEHICLE_2016_schema) :
    (sql%([ACCIDENT_2016_schema, PERSON_2016_schema, VEHICLE_2016_schema]) "WITH multi_person_crashes AS (/* Crashes with more than one distinct person */ SELECT \"consecutive_number\" FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\" GROUP BY \"consecutive_number\" HAVING COUNT(DISTINCT \"person_number\") > 1), fatal_counts AS (/* Count persons with injury_severity = 4 per crash */ SELECT \"consecutive_number\", SUM(CASE WHEN \"injury_severity\" = 4 THEN 1 ELSE 0 END) AS fatal_count FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\" GROUP BY \"consecutive_number\"), vehicle_body AS (/* Get body_type from vehicle_number = 1 (first vehicle) */ SELECT \"consecutive_number\", \"body_type\" AS vehicle_body_type FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\" WHERE \"vehicle_number\" = 1), speed_diff AS (/* Average absolute difference between travel_speed and speed_limit per crash */ /* Only for vehicles where travel_speed <= 151 AND speed_limit <= 80 */ SELECT \"consecutive_number\", AVG(ABS(\"travel_speed\" - \"speed_limit\")) AS avg_abs_speed_diff FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\" WHERE \"travel_speed\" <= 151 AND \"speed_limit\" <= 80 GROUP BY \"consecutive_number\") SELECT a.\"state_number\", a.\"consecutive_number\", vb.vehicle_body_type, a.\"number_of_drunk_drivers\", a.\"day_of_week\", a.\"hour_of_crash\", CASE WHEN a.\"work_zone\" <> 'None' THEN 1 ELSE 0 END AS work_zone_indicator, sd.avg_abs_speed_diff, CASE WHEN sd.avg_abs_speed_diff IS NULL THEN NULL WHEN FLOOR(CAST(sd.avg_abs_speed_diff AS DOUBLE PRECISION) / 20) >= 4 THEN 4 ELSE FLOOR(CAST(sd.avg_abs_speed_diff AS DOUBLE PRECISION) / 20) END AS avg_speed_diff_bin, CASE WHEN fc.fatal_count > 1 THEN 1 ELSE 0 END AS label_more_than_one_fatality FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" AS a INNER JOIN multi_person_crashes AS mpc ON a.\"consecutive_number\" = mpc.\"consecutive_number\" INNER JOIN fatal_counts AS fc ON a.\"consecutive_number\" = fc.\"consecutive_number\" LEFT JOIN vehicle_body AS vb ON a.\"consecutive_number\" = vb.\"consecutive_number\" LEFT JOIN speed_diff AS sd ON a.\"consecutive_number\" = sd.\"consecutive_number\" ORDER BY a.\"state_number\", a.\"consecutive_number\"") t0 t1 t2
  = (sql%([ACCIDENT_2016_schema, PERSON_2016_schema, VEHICLE_2016_schema]) "WITH multi_person_accidents AS (SELECT \"consecutive_number\" FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\" GROUP BY \"consecutive_number\" HAVING COUNT(DISTINCT \"person_number\") > 1), fatality_labels AS (SELECT p.\"consecutive_number\", CASE WHEN SUM(CASE WHEN p.\"injury_severity\" = 4 THEN 1 ELSE 0 END) > 1 THEN 1 ELSE 0 END AS \"label_more_than_one_fatality\" FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"PERSON_2016\" AS p INNER JOIN multi_person_accidents AS mpa ON p.\"consecutive_number\" = mpa.\"consecutive_number\" GROUP BY p.\"consecutive_number\"), first_vehicle AS (SELECT \"consecutive_number\", \"vehicle_body_type\" FROM (SELECT v.\"consecutive_number\", v.\"body_type\" AS \"vehicle_body_type\", ROW_NUMBER() OVER (PARTITION BY v.\"consecutive_number\" ORDER BY v.\"vehicle_number\") AS _w, v.\"vehicle_number\" FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\" AS v INNER JOIN multi_person_accidents AS mpa ON v.\"consecutive_number\" = mpa.\"consecutive_number\") AS _t WHERE _w = 1), speed_diff AS (SELECT v.\"consecutive_number\", AVG(ABS(v.\"travel_speed\" - v.\"speed_limit\")) AS \"avg_abs_speed_diff\" FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"VEHICLE_2016\" AS v INNER JOIN multi_person_accidents AS mpa ON v.\"consecutive_number\" = mpa.\"consecutive_number\" WHERE v.\"travel_speed\" <= 151 AND v.\"speed_limit\" <= 80 GROUP BY v.\"consecutive_number\") SELECT a.\"state_number\", a.\"consecutive_number\", fv.\"vehicle_body_type\", a.\"number_of_drunk_drivers\", a.\"day_of_week\", a.\"hour_of_crash\", CASE WHEN a.\"work_zone\" <> 'None' THEN 1 ELSE 0 END AS \"work_zone_indicator\", COALESCE(sd.\"avg_abs_speed_diff\", 0) AS \"avg_abs_speed_diff\", CASE WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 80 THEN 4 WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 60 THEN 3 WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 40 THEN 2 WHEN COALESCE(sd.\"avg_abs_speed_diff\", 0) >= 20 THEN 1 ELSE 0 END AS \"avg_speed_diff_bin\", fl.\"label_more_than_one_fatality\" FROM \"NHTSA_TRAFFIC_FATALITIES\".\"NHTSA_TRAFFIC_FATALITIES\".\"ACCIDENT_2016\" AS a INNER JOIN multi_person_accidents AS mpa ON a.\"consecutive_number\" = mpa.\"consecutive_number\" INNER JOIN fatality_labels AS fl ON a.\"consecutive_number\" = fl.\"consecutive_number\" INNER JOIN first_vehicle AS fv ON a.\"consecutive_number\" = fv.\"consecutive_number\" LEFT JOIN speed_diff AS sd ON a.\"consecutive_number\" = sd.\"consecutive_number\" ORDER BY a.\"consecutive_number\"") t0 t1 t2
