 side by side */ AS (SELECT n AS n_y, mean_val AS avg_y, var_val AS var_y FROM group_stats WHERE has_tp53 = 'Y'), stats_n AS (SELECT n AS n_n, mean_val AS avg_n, var_val AS var_n FROM group_stats WHERE has_tp53 = 'N') SELECT sy.n_y AS NY, sn.n_n AS NN, sy.avg_y AS AVG_Y, sn.avg_n AS AVG_N, CAST((sy.avg_y - sn.avg_n) AS DOUBLE PRECISION) / SQRT(CAST(sy.var_y AS DOUBLE PRECISION) / sy.n_y + CAST(sn.var_n AS DOUBLE PRECISION) / sn.n_n) AS TSCORE FROM stats_y AS sy, stats_n AS sn") t0 t1) := by
